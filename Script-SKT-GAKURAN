            local DropBtn = Instance.new("TextButton")
            DropBtn.Size = UDim2.new(0, 150, 0, 30)
            DropBtn.Position = UDim2.new(1, -165, 0, 7)
            local initText = "None"
            if type(opts.CurrentOption) == "table" and opts.CurrentOption[1] then
                initText = tostring(opts.CurrentOption[1])
            elseif type(opts.CurrentOption) == "string" then
                initText = opts.CurrentOption
            end
            
            DropBtn.BackgroundColor3 = UI_Config.MainColor
            DropBtn.Text = initText
            DropBtn.TextColor3 = UI_Config.DimTextColor
            DropBtn.Font = UI_Config.Font
            DropBtn.TextSize = 13
            DropBtn.Parent = DropFrame
            CreateCorner(DropBtn, 4)

            local ScrollFrame = Instance.new("ScrollingFrame")
            ScrollFrame.Size = UDim2.new(1, -30, 0, 100)
            ScrollFrame.Position = UDim2.new(0, 15, 0, 50)
            ScrollFrame.BackgroundTransparency = 1
            ScrollFrame.ScrollBarThickness = 2
            ScrollFrame.Parent = DropFrame

            local ListLayout = Instance.new("UIListLayout")
            ListLayout.SortOrder = Enum.SortOrder.LayoutOrder
            ListLayout.Padding = UDim.new(0, 5)
            ListLayout.Parent = ScrollFrame

            local isOpen = false

            local function refreshOptions(options)
                for _, child in ipairs(ScrollFrame:GetChildren()) do
                    if child:IsA("TextButton") then child:Destroy() end
                end
                
                if type(opts.CurrentOption) ~= "table" then
                    opts.CurrentOption = opts.CurrentOption and {opts.CurrentOption} or {}
                end
                if opts.Flag and ConfigManager.Config[opts.Flag] ~= nil then
                    opts.CurrentOption = ConfigManager.Config[opts.Flag]
                    if type(opts.CurrentOption) ~= "table" then
                        opts.CurrentOption = {opts.CurrentOption}
                    end
                end
                
                local function updateBtnText()
                    if opts.MultipleOptions then
                        if #opts.CurrentOption == 0 then
                            DropBtn.Text = "None"
                        elseif #opts.CurrentOption == 1 then
                            DropBtn.Text = tostring(opts.CurrentOption[1])
                        else
                            DropBtn.Text = tostring(#opts.CurrentOption) .. " Selected"
                        end
                    else
                        DropBtn.Text = tostring(opts.CurrentOption[1] or "None")
                    end
                end
                updateBtnText()
                
                for i, opt in ipairs(options) do
                    local btn = Instance.new("TextButton")
                    btn.Size = UDim2.new(1, -10, 0, 25)
                    btn.BackgroundColor3 = UI_Config.MainColor
                    btn.Text = tostring(opt)
                    
                    local isSelected = false
                    for _, v in ipairs(opts.CurrentOption) do
                        if v == opt then isSelected = true break end
                    end
                    btn.TextColor3 = isSelected and UI_Config.AccentColor or UI_Config.TextColor
                    
                    btn.Font = UI_Config.Font
                    btn.TextSize = 13
                    btn.Parent = ScrollFrame
                    CreateCorner(btn, 4)

                    btn.MouseButton1Click:Connect(function()
                        if opts.MultipleOptions then
                            local foundIdx = nil
                            for idx, v in ipairs(opts.CurrentOption) do
                                if v == opt then foundIdx = idx break end
                            end
                            if foundIdx then
                                table.remove(opts.CurrentOption, foundIdx)
                                btn.TextColor3 = UI_Config.TextColor
                            else
                                table.insert(opts.CurrentOption, opt)
                                btn.TextColor3 = UI_Config.AccentColor
                            end
                            updateBtnText()
                            if opts.Flag then
                                ConfigManager.Config[opts.Flag] = opts.CurrentOption
                                ConfigManager:Save()
                            end
                            if opts.Callback then opts.Callback(opts.CurrentOption) end
                        else
                            opts.CurrentOption = {opt}
                            updateBtnText()
                            for _, child in ipairs(ScrollFrame:GetChildren()) do
                                if child:IsA("TextButton") then
                                    child.TextColor3 = (child.Text == tostring(opt)) and UI_Config.AccentColor or UI_Config.TextColor
                                end
                            end
                            isOpen = false
                            TweenService:Create(DropFrame, TweenInfo.new(0.2), {Size = UDim2.new(1, -10, 0, 45)}):Play()
                            if opts.Flag then
                                ConfigManager.Config[opts.Flag] = opts.CurrentOption
                                ConfigManager:Save()
                            end
                            if opts.Callback then opts.Callback(opts.CurrentOption) end
                        end
                    end)
                end
                ScrollFrame.CanvasSize = UDim2.new(0, 0, 0, ListLayout.AbsoluteContentSize.Y)
            end
            
            if opts.Options then
                refreshOptions(opts.Options)
            end
            
            if opts.Callback then
                task.spawn(function()
                    opts.Callback(opts.CurrentOption)
                end)
            end

            DropBtn.MouseButton1Click:Connect(function()
                isOpen = not isOpen
                if isOpen then
                    TweenService:Create(DropFrame, TweenInfo.new(0.2), {Size = UDim2.new(1, -10, 0, 160)}):Play()
                else
                    TweenService:Create(DropFrame, TweenInfo.new(0.2), {Size = UDim2.new(1, -10, 0, 45)}):Play()
                end
            end)
            
            return {
                Refresh = function(self, newOpts)
                    refreshOptions(newOpts)
                end,
                Set = function(self, newVals)
                    if type(newVals) == "table" then
                        DropBtn.Text = tostring(newVals[1] or "Select")
                    else
                        DropBtn.Text = tostring(newVals or "Select")
                    end
                end
            }
        end

