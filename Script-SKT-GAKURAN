table.insert(_G.GakuranHubConnections, RunService.RenderStepped:Connect(function()
    if not AutoParryEnabled and not AutoAttackEnabled then
        if isBlockingNow then releaseBlock() end
        STATE = "IDLE"
        StateL.Text = "Status: Idle (Toggles Off)"
        
        local char = LocalPlayer.Character
        if char and char:FindFirstChild("Humanoid") then
            char.Humanoid.AutoRotate = true
            char.Humanoid.WalkSpeed = 16
            pcall(function()
                char:SetAttribute("Running", false)
                char:SetAttribute("Sprinting", false)
            end)
        end
        return
    end
    
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") or not char:FindFirstChild("Humanoid") then return end
    
    -- Auto Equip Fists (Only if attacking is enabled, so we don't randomly equip if just parrying)
    if AutoAttackEnabled and char:GetAttribute("Equip") ~= true then
        pcall(function()
            if EquipModule and type(EquipModule.Equip) == "function" then
                EquipModule.Equip()
            end
        end)
    end
    
    local hum = char.Humanoid
    local myPos = char.HumanoidRootPart.Position
    local now = os.clock()
    
    local isDowned = char:GetAttribute("Downed") == true or char:GetAttribute("Knocked") == true or hum.Health <= 0
    
    local prevTarget = lockedTarget
    local target, dist = findTarget()
    
    -- TRACK KNOCKED TARGET (The one we just beat up)
    if prevTarget and prevTarget ~= target then
        if prevTarget:GetAttribute("Knocked") or prevTarget:GetAttribute("Downed") then
            _G.LastKnockedTarget = prevTarget
            _G.LastKnockedTime = os.clock()
        end
    end
    
    if not target then
        STATE = "IDLE"
        if isBlockingNow then releaseBlock() end
        StateL.Text = "Status: Scanning..."
        TargetL.Text = "Target: None"
        ActionL.Text = "Waiting for enemies..."
        pcall(function()
            char:SetAttribute("Running", false)
            char:SetAttribute("Sprinting", false)
        end)
        if hum.WalkSpeed > 16 then hum.WalkSpeed = 16 end
        
        -- Handle LocalPlayer Movement options (WalkSpeed, JumpPower, Fly)
        local char = LocalPlayer.Character
        if char then
            local hum = char:FindFirstChild("Humanoid")
            local hrp = char:FindFirstChild("HumanoidRootPart")
            
            if hum then
                if _G.WS_Enabled and _G.WS_Value then
                    hum.WalkSpeed = _G.WS_Value
                end
                if _G.JP_Enabled and _G.JP_Value then
                    hum.UseJumpPower = true
                    hum.JumpPower = _G.JP_Value
                end
            end
            
            if _G.Fly_Enabled and hrp and camera then
                if not _G.FlyBodyVelocity or not _G.FlyBodyVelocity.Parent then
                    local bv = Instance.new("BodyVelocity")
                    bv.MaxForce = Vector3.new(1e5, 1e5, 1e5)
                    bv.Velocity = Vector3.new(0, 0, 0)
                    bv.Parent = hrp
                    _G.FlyBodyVelocity = bv
                    
                    local bg = Instance.new("BodyGyro")
                    bg.MaxTorque = Vector3.new(1e5, 1e5, 1e5)
                    bg.CFrame = hrp.CFrame
                    bg.Parent = hrp
                    _G.FlyBodyGyro = bg
                end
                
                local speed = _G.Fly_Speed or 50
                local vel = Vector3.new(0, 0, 0)
                
                if UserInputService:IsKeyDown(Enum.KeyCode.W) then
                    vel = vel + camera.CFrame.LookVector
                end
                if UserInputService:IsKeyDown(Enum.KeyCode.S) then
                    vel = vel - camera.CFrame.LookVector
                end
                if UserInputService:IsKeyDown(Enum.KeyCode.A) then
                    vel = vel - camera.CFrame.RightVector
                end
                if UserInputService:IsKeyDown(Enum.KeyCode.D) then
                    vel = vel + camera.CFrame.RightVector
                end
                
                if vel.Magnitude > 0 then
                    _G.FlyBodyVelocity.Velocity = vel.Unit * speed
                else
                    _G.FlyBodyVelocity.Velocity = Vector3.new(0, 0, 0)
                end
                _G.FlyBodyGyro.CFrame = camera.CFrame
            end
        end
        return
    end
    
    local targetRoot = target:FindFirstChild("HumanoidRootPart")
    if not targetRoot then return end
    
    -- Ensure we are alive to fight!
    if isDowned then return end
    
    -- Ensure we are not currently executing or carrying someone!
    if _G.IsExecuting then return end
    
    -- FACE TARGET LOGIC
    if _G.FaceTargetEnabled and not isDowned then
        hum.AutoRotate = false -- Disable built-in rotation so it doesn't fight our CFrame update
        local lookDir = (targetRoot.Position - myPos)
        if lookDir.Magnitude > 0 then
            lookDir = lookDir.Unit
            char.HumanoidRootPart.CFrame = CFrame.new(myPos, myPos + Vector3.new(lookDir.X, 0, lookDir.Z))
        end
    else
        hum.AutoRotate = true
    end
    
    local e_attacking = enemyIsAttacking(target)
    local prev_attacking = enemyPrevAttacking[target] or false
    local temp_e_isHeavy = enemyIsHeavyAttacking(target)
    local temp_hitboxDelay = getHitboxDelay(target, temp_e_isHeavy)
    
    if e_attacking then
        enemyLastAttacked[target] = now
        -- Allow wireAnimator to handle combo timings if possible, 
        -- but if this is the very first strike, log it.
        if not prev_attacking and not enemyAttackStart[target] then
            enemyAttackStart[target] = now
            enemySkipped[target] = nil
        end
    else
        -- Do not immediately clear attack state! Attack attributes in this game often pulse briefly.
        -- We must keep the defense state alive until the parry window has fully passed.
        if enemyAttackStart[target] then
            if (now - enemyAttackStart[target]) > (temp_hitboxDelay + 0.3) then
                enemyAttackStart[target] = nil
                enemySkipped[target] = nil
            end
        end
    end
    enemyPrevAttacking[target] = e_attacking
    
    local e_skill = enemyIsUsingSkill(target)
    if e_skill then
        if not enemySkillStart[target] then
            enemySkillStart[target] = now
        end
    else
        enemySkillStart[target] = nil
    end
    
    local elapsed = enemyAttackStart[target] and (now - enemyAttackStart[target]) or 0
    local skillElapsed = enemySkillStart[target] and (now - enemySkillStart[target]) or 0
    
    local e_blocking = enemyIsBlocking(target)
    local e_stunned = enemyIsStunned(target)
    local e_isHeavy = enemyIsHeavyAttacking(target)
    local hitboxDelay = getHitboxDelay(target, e_isHeavy)
    
    -- // COMBAT LOGIC //
    
    -- PRIORITY 1: PUNISH (Stunned Enemy)
    if AutoAttackEnabled and e_stunned and dist <= M1_RANGE then
        STATE = "PUNISH"
        if isBlockingNow and now > parryEndTime then releaseBlock() end
        doM1()
        
        -- Clear defense states to commit to attacking
        enemyAttackStart[target] = nil
        enemySkipped[target] = nil
        
        StateL.Text = "Status: 💥 PUNISH COMBO"
        TargetL.Text = string.format("Target: %s [%.0fst]", target.Name, dist)
        ActionL.Text = string.format("Combo Hit #%d", myComboCount)
        
    -- PRIORITY 2: DEFENSE (DODGE / BLOCK)
    elseif AutoParryEnabled and ((enemyAttackStart[target] and dist <= PARRY_RANGE) or (e_skill and dist <= 30) or (e_isHeavy and dist <= 20)) then
        
        -- Stop attacking to ensure we can defend
        if weAreAttacking() then forceStopAttack() end
        
        local isGuardBroken = char:GetAttribute("GuardBroken") == true
        
        -- If it's a Heavy Attack (detected by color/highlight), always Dash Dodge!
        if e_isHeavy and doDodge(target) then
            STATE = "DODGE"
            StateL.Text = "Status: 💨 DODGED HEAVY"
            TargetL.Text = string.format("Target: %s [%.0fst]", target.Name, dist)
            ActionL.Text = "Evaded heavy attack (Color detected)!"
            parryEndTime = now + 0.5
        -- If guard is broken, we must dodge!
        elseif isGuardBroken and (enemyAttackStart[target] or e_skill) and doDodge(target) then
            STATE = "DODGE"
            StateL.Text = "Status: 💨 DODGED (GUARD BROKEN)"
            TargetL.Text = string.format("Target: %s [%.0fst]", target.Name, dist)
            ActionL.Text = "Guard broken, evading!"
            parryEndTime = now + 0.5
        elseif e_skill and skillElapsed < 1.2 then
            STATE = "PARRY"
            doBlock()
            parryEndTime = now + 0.5
            StateL.Text = "Status: 🎯 SKILL BLOCK"
            TargetL.Text = string.format("Target: %s [%.0fst]", target.Name, dist)
            ActionL.Text = "Blocking skill!"
        elseif e_skill and skillElapsed >= 1.2 then
            STATE = "WAIT_RESET"
            if isBlockingNow and now > parryEndTime then releaseBlock() end
            StateL.Text = "Status: ⏳ SKILL TIMEOUT"
        elseif enemySkipped[target] then
            STATE = "WAIT_RESET"
            -- Always release block if parry window expires to prevent "holding block"
            if isBlockingNow and now > parryEndTime then releaseBlock() end
            StateL.Text = "Status: ⏳ WAIT RESET"
        else
            -- SMART PARRY LOGIC (Ping Compensated, Distance Calculated & Multi-Hit Combo Support)
            local pingStr = "0"
            pcall(function() pingStr = game:GetService("Stats").Network.ServerStatsItem["Data Ping"]:GetValueString():match("%d+") end)
            local ping = (tonumber(pingStr) or 50) / 1000
            
            -- การชดเชยระยะทาง (Distance Compensation): 
            -- ถ้ายิ่งอยู่ใกล้ (dist ต่ำ) หมัดจะถึงตัวเร็วขึ้นมาก เราจึงต้อง Parry ให้ไวขึ้น (ลบเวลาออกสูงสุด 0.08 วิ)
            local distFactor = math.clamp(dist, 0, 15)
            local distComp = ((15 - distFactor) / 15) * 0.08
            
            -- Adjust window based on ping and distance. 
            local idealTime = math.max(0.01, hitboxDelay - 0.13 - (ping * 0.5) - distComp)
            
            if elapsed < idealTime then
                STATE = "WAIT_PARRY"
                if isBlockingNow and now > parryEndTime then releaseBlock() end
                StateL.Text = string.format("Status: ⏱️ TIMING (%.2fs)", idealTime - elapsed)
                
            elseif elapsed >= idealTime and elapsed < (hitboxDelay + 0.15) then
                -- Block! (Holding block through the impact window)
                STATE = "PARRY"
                if not isBlockingNow then doBlock() end
                parryEndTime = now + 0.25
                StateL.Text = "Status: ⚡ M1 PARRY"
                
            else
                -- If we missed or successfully parried, we reset but DO NOT skip the next hits of the combo!
                -- Setting enemyAttackStart to nil allows wireAnimator to register the next punch!
                enemyAttackStart[target] = nil 
                stats.skips = stats.skips + 1
                STATE = "WAIT_RESET"
                if isBlockingNow and now > parryEndTime then releaseBlock() end
                StateL.Text = "Status: ❌ PARRY DONE/MISSED"
            end
            
            TargetL.Text = string.format("Target: %s [%.0fst]", target.Name, dist)
            ActionL.Text = "Single Parry Logic"
        end
        
    -- PRIORITY 3: GUARD BREAK (HEAVY)
    elseif AutoAttackEnabled and e_blocking and dist <= M2_RANGE then
        STATE = "GUARD_BREAK"
        if isBlockingNow then releaseBlock() end
        
        if now - lastM2Time >= M2_COOLDOWN then
            doHeavyAttack()
            StateL.Text = "Status: 🔨 GUARD BREAK"
            TargetL.Text = string.format("Target: %s [%.0fst]", target.Name, dist)
            ActionL.Text = "Using Heavy (R)!"
        end
        
    -- PRIORITY 4: ATTACK (M1)
    elseif AutoAttackEnabled and dist <= M1_RANGE and not (e_attacking or e_skill) and not e_blocking then
        STATE = "ATTACK"
        if isBlockingNow then releaseBlock() end
        
        doM1()
        StateL.Text = "Status: 👊 ATTACKING"
        TargetL.Text = string.format("Target: %s [%.0fst]", target.Name, dist)
        ActionL.Text = "Enemy is open!"
        
    -- PRIORITY 5: CHASE
    elseif AutoAttackEnabled and dist > M1_RANGE and dist <= CHASE_RANGE then
        STATE = "CHASE"
        if isBlockingNow and dist > PARRY_RANGE then releaseBlock() end
        
        -- ทำให้ตัวละครวิ่ง (Sprint) จะได้ตามศัตรูทัน
        pcall(function()
            char:SetAttribute("Running", true)
            char:SetAttribute("Sprinting", true)
            hum.WalkSpeed = 24
        end)
        
        hum:MoveTo(targetRoot.Position)
        
        if dist > 25 and not (e_attacking or e_skill) and char:GetAttribute("EvasiveCooldown") ~= true then
            task.spawn(function()
                pcall(function()
                    local vim = game:GetService("VirtualInputManager")
                    vim:SendKeyEvent(true, Enum.KeyCode.W, false, game)
                    task.wait(0.02)
                    vim:SendKeyEvent(true, Enum.KeyCode.Q, false, game)
                    task.wait(0.05)
                    vim:SendKeyEvent(false, Enum.KeyCode.Q, false, game)
                    vim:SendKeyEvent(false, Enum.KeyCode.W, false, game)
                end)
            end)
        end
        
        StateL.Text = "Status: 🏃 CHASING"
        TargetL.Text = string.format("Target: %s [%.0fst]", target.Name, dist)
        ActionL.Text = "Closing distance to target"
        
    else
        STATE = "IDLE"
        if isBlockingNow then releaseBlock() end
        StateL.Text = "Status: 👁️ WATCHING"
        TargetL.Text = string.format("Target: %s [%s] [%.0fst]", target.Name, string.upper(target:GetAttribute("CombatStyle") or "DEFAULT"), dist)
        ActionL.Text = "In range, waiting for opening..."
    end
    
    local th = target:FindFirstChildOfClass("Humanoid")
    if th and th.Health <= 0 then
        lockedTarget = nil
        stats.kills = stats.kills + 1
    end
    
    StatsL.Text = string.format("Parry: %d  |  Hits: %d  |  Kills: %d", stats.parries, stats.hits, stats.kills)
end))

