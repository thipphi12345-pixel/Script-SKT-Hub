            pcall(function()
                char:SetAttribute("Running", false)
                char:SetAttribute("Sprinting", false)
            end)
        end
        return
    end
    
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") or not char:FindFirstChild("Humanoid") then return end
    
    -- Auto Equip Fists (Only if attacking is enabled, so we don't randomly equip if just parrying)
    if AutoAttackEnabled and char:GetAttribute("Equip") ~= true then
        pcall(function()
            if EquipModule and type(EquipModule.Equip) == "function" then
                EquipModule.Equip()
            end
        end)
    end
    
    local hum = char.Humanoid
    local myPos = char.HumanoidRootPart.Position
    local now = os.clock()
    
    local isDowned = char:GetAttribute("Downed") == true or char:GetAttribute("Knocked") == true or hum.Health <= 0
    
    local prevTarget = lockedTarget
    local target, dist = findTarget()
    
    -- TRACK KNOCKED TARGET (The one we just beat up)
    if prevTarget and prevTarget ~= target then
        if prevTarget:GetAttribute("Knocked") or prevTarget:GetAttribute("Downed") then
            _G.LastKnockedTarget = prevTarget
            _G.LastKnockedTime = os.clock()
        end
    end
    
    if not target then
        STATE = "IDLE"
        if isBlockingNow then releaseBlock() end
        StateL.Text = "Status: Scanning..."
        TargetL.Text = "Target: None"
        ActionL.Text = "Waiting for enemies..."
        pcall(function()
            char:SetAttribute("Running", false)
            char:SetAttribute("Sprinting", false)
        end)
        if hum.WalkSpeed > 16 then hum.WalkSpeed = 16 end
        
        -- Handle LocalPlayer Movement options (WalkSpeed, JumpPower, Fly)
        local char = LocalPlayer.Character
        if char then
            local hum = char:FindFirstChild("Humanoid")
            local hrp = char:FindFirstChild("HumanoidRootPart")
            
            if hum then
                if _G.WS_Enabled and _G.WS_Value then
                    hum.WalkSpeed = _G.WS_Value
                end
                if _G.JP_Enabled and _G.JP_Value then
                    hum.UseJumpPower = true
                    hum.JumpPower = _G.JP_Value
                end
            end
            
            if _G.Fly_Enabled and hrp and camera then
                if not _G.FlyBodyVelocity or not _G.FlyBodyVelocity.Parent then
                    local bv = Instance.new("BodyVelocity")
                    bv.MaxForce = Vector3.new(1e5, 1e5, 1e5)
                    bv.Velocity = Vector3.new(0, 0, 0)
                    bv.Parent = hrp
                    _G.FlyBodyVelocity = bv
                    
                    local bg = Instance.new("BodyGyro")
                    bg.MaxTorque = Vector3.new(1e5, 1e5, 1e5)
                    bg.CFrame = hrp.CFrame
                    bg.Parent = hrp
                    _G.FlyBodyGyro = bg
                end
                
                local speed = _G.Fly_Speed or 50
                local vel = Vector3.new(0, 0, 0)
                
                if UserInputService:IsKeyDown(Enum.KeyCode.W) then
                    vel = vel + camera.CFrame.LookVector
                end
                if UserInputService:IsKeyDown(Enum.KeyCode.S) then
                    vel = vel - camera.CFrame.LookVector
                end
                if UserInputService:IsKeyDown(Enum.KeyCode.A) then
                    vel = vel - camera.CFrame.RightVector
                end
                if UserInputService:IsKeyDown(Enum.KeyCode.D) then
                    vel = vel + camera.CFrame.RightVector
                end
                
                if vel.Magnitude > 0 then
                    _G.FlyBodyVelocity.Velocity = vel.Unit * speed
                else
                    _G.FlyBodyVelocity.Velocity = Vector3.new(0, 0, 0)
                end
                _G.FlyBodyGyro.CFrame = camera.CFrame
            end
        end
        return
    end
    
    local targetRoot = target:FindFirstChild("HumanoidRootPart")
    if not targetRoot then return end
    
    -- Ensure we are alive to fight!
    if isDowned then return end
    
    -- Ensure we are not currently executing or carrying someone!
    if _G.IsExecuting then return end
    

    
    local e_attacking = enemyIsAttacking(target)
    local prev_attacking = enemyPrevAttacking[target] or false
    local temp_e_isHeavy = enemyIsHeavyAttacking(target)
    local temp_hitboxDelay = getHitboxDelay(target, temp_e_isHeavy)
    
    if e_attacking then
        enemyLastAttacked[target] = now
        
        -- Start tracking the attack
        if not prev_attacking then
            enemyAttackStart[target] = now
        end
        
        -- Detect combo hits (M1Count increments)
        local curM1Count = target:GetAttribute("M1Count") or target:GetAttribute("ComboCount") or 0
        local prevM1Count = enemyPrevM1Count[target] or curM1Count
        if curM1Count ~= prevM1Count then
            enemyAttackStart[target] = now -- Reset timer for the new hit!
        end
        enemyPrevM1Count[target] = curM1Count
        
        -- Fallback detection
        if not enemyAttackStart[target] then
            enemyAttackStart[target] = now
        end
    else
        -- Keep attack state alive briefly for the hitbox to finish
        if enemyAttackStart[target] and (now - enemyAttackStart[target]) > (temp_hitboxDelay + 0.6) then
            enemyAttackStart[target] = nil
        end
    end
    enemyPrevAttacking[target] = e_attacking
    
    local e_skill = enemyIsUsingSkill(target)
    if e_skill then
        if not enemySkillStart[target] then enemySkillStart[target] = now end
    else
        enemySkillStart[target] = nil
    end
    
    local elapsed = enemyAttackStart[target] and (now - enemyAttackStart[target]) or 0
    
    local e_blocking = enemyIsBlocking(target)
    local e_stunned = enemyIsStunned(target)
    local e_isHeavy = enemyIsHeavyAttacking(target)
    local hitboxDelay = getHitboxDelay(target, e_isHeavy)
    
    -- // COMBAT LOGIC //
    
    local myLook = char.PrimaryPart and char.PrimaryPart.CFrame.LookVector
    local dirToEnemy = char.PrimaryPart and target.PrimaryPart and (target.PrimaryPart.Position - char.PrimaryPart.Position).Unit

    -- PRIORITY 1: PUNISH (Stunned Enemy)
    if AutoAttackEnabled and e_stunned and dist <= M1_RANGE then
        STATE = "PUNISH"
        if isBlockingNow then releaseBlock() end
        doM1()
        
        enemyAttackStart[target] = nil
        StateL.Text = "Status:  PUNISH COMBO"
        TargetL.Text = string.format("Target: %s [%.0fst]", target.Name, dist)
        ActionL.Text = string.format("Combo Hit #%d", myComboCount)
        
    -- PRIORITY 2: DEFENSE (DODGE / BLOCK)
    elseif AutoParryEnabled and enemyAttackStart[target] and dist <= (e_isHeavy and (_G.HeavyParryRange or 20) or (_G.ParryRange or 12)) then
        
        if weAreAttacking() then forceStopAttack() end
        
        -- AUTO DODGE HEAVY: Try to dash backwards instead of parrying!
        if e_isHeavy and _G.AutoDodgeHeavyEnabled and doDodge(target) then
            STATE = "DODGE"
            enemyAttackStart[target] = nil -- Stop tracking to prevent spamming dash
            StateL.Text = "Status: 🏃 DODGING HEAVY"
            TargetL.Text = string.format("Target: %s [%.0fst]", target.Name, dist)
            ActionL.Text = "Auto Dodge (Q)!"
        else
            -- Existing parry logic (Fallback to parry if not heavy or dash is on cooldown)
            local pingStr = "0"
            pcall(function() pingStr = game:GetService("Stats").Network.ServerStatsItem["Data Ping"]:GetValueString():match("%d+") end)
            local ping = (tonumber(pingStr) or 50) / 1000
            
            local idealTime = math.max(0.01, hitboxDelay - (ping * 0.5) + (_G.ParryTimingOffset or 0))
            local holdDuration = _G.ParryHoldDuration or 0.35
            
            -- NEW CLEAN LOGIC: 
            -- Before ideal time -> Wait (Drop guard if raised)
            -- At ideal time -> Block
            -- After hold duration -> Drop guard
            if elapsed < idealTime then
                STATE = "WAIT_PARRY"
                if isBlockingNow then releaseBlock() end
                StateL.Text = string.format("Status: ️ TIMING (%.2fs)", idealTime - elapsed)
                
            elseif elapsed >= idealTime and elapsed < (idealTime + holdDuration) then
                STATE = "PARRY"
                doBlock()
                StateL.Text = "Status:  PERFECT PARRY (TAP)"
                
            else
                STATE = "WAIT_RESET"
                if isBlockingNow then releaseBlock() end
                StateL.Text = "Status:  PARRY DONE/MISSED"
            end
            
            TargetL.Text = string.format("Target: %s [%.0fst]", target.Name, dist)
            ActionL.Text = "Ultimate Tap Parry"
        end
        
    -- PRIORITY 3: GUARD BREAK (HEAVY)
    elseif AutoAttackEnabled and e_blocking and dist <= M2_RANGE then
        STATE = "GUARD_BREAK"
        if isBlockingNow then releaseBlock() end
        
        if now - lastM2Time >= M2_COOLDOWN then
            doHeavyAttack()
            StateL.Text = "Status:  GUARD BREAK"
            TargetL.Text = string.format("Target: %s [%.0fst]", target.Name, dist)
            ActionL.Text = "Using Heavy (R)!"
        end
        
    -- PRIORITY 4: ATTACK (M1)
    elseif AutoAttackEnabled and dist <= M1_RANGE and not (e_attacking or e_skill) and not e_blocking then
        STATE = "ATTACK"
        if isBlockingNow then releaseBlock() end
        
        doM1()
        StateL.Text = "Status:  ATTACKING"
        TargetL.Text = string.format("Target: %s [%.0fst]", target.Name, dist)
        ActionL.Text = "Enemy is open!"
        
    -- PRIORITY 5: CHASE
    elseif AutoAttackEnabled and dist > M1_RANGE and dist <= CHASE_RANGE then
        STATE = "CHASE"
        if isBlockingNow and dist > PARRY_RANGE then releaseBlock() end
        
        -- ทำให้ตัวละครวิ่ง (Sprint) จะได้ตามศัตรูทัน
        pcall(function()
            char:SetAttribute("Running", true)
            char:SetAttribute("Sprinting", true)
            hum.WalkSpeed = 24
        end)
        
        hum:MoveTo(targetRoot.Position)
        
        StateL.Text = "Status:  CHASING"
        TargetL.Text = string.format("Target: %s [%.0fst]", target.Name, dist)
        ActionL.Text = "Closing distance to target"
        
    else
        STATE = "IDLE"
        if isBlockingNow then releaseBlock() end
        StateL.Text = "Status: ️ WATCHING"
        TargetL.Text = string.format("Target: %s [%s] [%.0fst]", target.Name, string.upper(target:GetAttribute("CombatStyle") or "DEFAULT"), dist)
        ActionL.Text = "In range, waiting for opening..."
    end
    
    local th = target:FindFirstChildOfClass("Humanoid")
    if th and th.Health <= 0 then
        lockedTarget = nil
        stats.kills = stats.kills + 1
    end
    
    StatsL.Text = string.format("Parry: %d  |  Hits: %d  |  Kills: %d", stats.parries, stats.hits, stats.kills)
end))

