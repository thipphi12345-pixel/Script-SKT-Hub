-- // COMBAT HELPERS //
local function getStyleData(c)
    local s = c and c:GetAttribute("CombatStyle")
    if type(s)=="string" then s=string.lower(s); if STYLE_DATA[s] then return STYLE_DATA[s],s end end
    return STYLE_DATA.default,"default"
end

local function getHitboxDelay(enemy, isM2)
    local d = getStyleData(enemy)
    return isM2 and d.m2 or d.m1
end

local function canBlock()
    local c = LocalPlayer.Character
    if not c then return false end
    return not c:GetAttribute("Ragdoll")
       and not c:GetAttribute("GuardBroken")
       and not c:GetAttribute("Downed")
       and not c:GetAttribute("BlockCooldown")
       and not c:GetAttribute("Grappling")
end

local function enemyIsAttacking(enemy)
    return enemy:GetAttribute("M1")==true
        or enemy:GetAttribute("M2")==true
        or enemy:GetAttribute("CombatAttacking")==true
end

local function enemyIsBlocking(enemy)
    return enemy:GetAttribute("Blocking")==true
end

local function enemyIsStunned(enemy)
    return enemy:GetAttribute("Stunned")==true
        or enemy:GetAttribute("Parried")==true
        or enemy:GetAttribute("Ragdoll")==true
        or enemy:GetAttribute("GuardBroken")==true
        or enemy:GetAttribute("Downed")==true
end

local function enemyIsUsingSkill(enemy)
    local cant = enemy:GetAttribute("CantAnything")==true
    return cant and not enemyIsAttacking(enemy) and not enemyIsStunned(enemy)
end

local function enemyIsHeavyAttacking(enemy)
    if enemy:GetAttribute("M2") == true or enemy:GetAttribute("Heavy") == true then return true end
    
    for _, child in ipairs(enemy:GetChildren()) do
        if child:IsA("Highlight") and child.Name ~= "TalkHighlight" and child.Name ~= "Hover_Highlight" then 
            return true 
        end
    end
    
    local model = enemy:FindFirstChild("Model")
    if model then
        for _, child in ipairs(model:GetChildren()) do
            if child:IsA("Highlight") and child.Name ~= "TalkHighlight" and child.Name ~= "Hover_Highlight" then 
                return true 
            end
        end
    end
    
    return false
end

local function weAreAttacking()
    local c = LocalPlayer.Character
    if not c then return false end
    return c:GetAttribute("M1")==true
        or c:GetAttribute("M2")==true
        or c:GetAttribute("CombatAttacking")==true
        or c:GetAttribute("M1Hold")==true
end

local function forceStopAttack()
    local c = LocalPlayer.Character
    if c then
        c:SetAttribute("M1", nil)
        c:SetAttribute("M2", nil)
        c:SetAttribute("CombatAttacking", nil)
        c:SetAttribute("M1Hold", nil)
        c:SetAttribute("CantAnything", nil)
    end
end

local function doBlock()
    if not BlockModule or type(BlockModule.Block)~="function" then return false end
    if isBlockingNow then return true end
    if not canBlock() then return false end
    local now = os.clock()
    if now - lastBlockTime < 0.06 then return false end
    
    forceStopAttack()
    isBlockingNow = true
    lastBlockTime = now
    pcall(function() BlockModule.Block() end)
    stats.parries = stats.parries + 1
    return true
end

local function releaseBlock()
    if not isBlockingNow then return end
    isBlockingNow = false
    pcall(function()
        if BlockModule and type(BlockModule.Unblock)=="function" then
            BlockModule.Unblock()
        end
    end)
end

local function doM1()
    if not M1Module or type(M1Module.OnM1Activated)~="function" then return false end
    if isBlockingNow then releaseBlock() end
    local now = os.clock()
    if now - lastAttackTime < 0.22 then return false end
    
    lastAttackTime = now
    
    local c = LocalPlayer.Character
    if c then
        local count = c:GetAttribute("M1Count") or 0
        myComboCount = count + 1
    end
    
    pcall(function() M1Module.OnM1Activated() end)
    stats.hits = stats.hits + 1
    return true
end

local function doHeavyAttack()
    if isBlockingNow then releaseBlock() end
    local now = os.clock()
    if now - lastM2Time < M2_COOLDOWN then return false end
    
    lastM2Time = now
    
    task.spawn(function()
        pcall(function()
            local vim = game:GetService("VirtualInputManager")
            vim:SendKeyEvent(true, Enum.KeyCode.R, false, game)
            task.wait(0.05)
            vim:SendKeyEvent(false, Enum.KeyCode.R, false, game)
        end)
    end)
    
    stats.m2s = stats.m2s + 1
    return true
end

local function doDodge(target)
    local char = LocalPlayer.Character
    if not char then return false end
    
    -- Check if dash is on cooldown
    if char:GetAttribute("EvasiveCooldownRemaining") or char:GetAttribute("IFRAMECD") or char:GetAttribute("EvasiveCooldown") == true then return false end
    
    if isBlockingNow then releaseBlock() end
    
    -- Face away from target to dash backwards
    if target and target:FindFirstChild("HumanoidRootPart") and char:FindFirstChild("HumanoidRootPart") then
        local awayVector = (char.HumanoidRootPart.Position - target.HumanoidRootPart.Position).Unit
        char.Humanoid:Move(awayVector, false)
    end
    
    task.spawn(function()
        pcall(function()
            local vim = game:GetService("VirtualInputManager")
            vim:SendKeyEvent(true, Enum.KeyCode.S, false, game)
            task.wait(0.02)
            vim:SendKeyEvent(true, Enum.KeyCode.Q, false, game)
            task.wait(0.05)
            vim:SendKeyEvent(false, Enum.KeyCode.Q, false, game)
            vim:SendKeyEvent(false, Enum.KeyCode.S, false, game)
        end)
    end)
    
    pcall(function()
        if EvasiveModule and type(EvasiveModule.Evasive) == "function" then
            EvasiveModule.Evasive()
        end
    end)
    
    return true
end

-- // TARGET SYSTEM (CLOSEST ENEMY OR SELECTED) //
local function findTarget()
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return nil, 999 end
    local myPos = char.HumanoidRootPart.Position
    
    if _G.TargetMode == "Selected Target" and _G.SelectedTargetName then
        local p = game.Players:FindFirstChild(_G.SelectedTargetName)
        if p and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            local h = p.Character:FindFirstChildOfClass("Humanoid")
            if h and h.Health > 0 and p.Character:GetAttribute("Downed") ~= true then
                local dist = (myPos - p.Character.HumanoidRootPart.Position).Magnitude
                return p.Character, dist
            end
        end
    end
    
    if _G.TargetMode == "Near Lock Target" then
        if _G.CurrentClosestTarget and _G.CurrentClosestTarget:FindFirstChild("HumanoidRootPart") then
            local c = _G.CurrentClosestTarget
            local h = c:FindFirstChildOfClass("Humanoid")
            if h and h.Health > 0 and c:GetAttribute("Downed") ~= true then
                local dist = (myPos - c.HumanoidRootPart.Position).Magnitude
                -- STICKY LOCK: Keep targeting the one we are fighting as long as they are within 40 studs!
                if dist < 40 then
                    return c, dist
                end
            end
        end
        
        local best, bestDist = nil, 200
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                local h = p.Character:FindFirstChildOfClass("Humanoid")
                if h and h.Health > 0 and p.Character:GetAttribute("Downed") ~= true then
                    local d = (p.Character.HumanoidRootPart.Position - myPos).Magnitude
                    if d < bestDist then
                        bestDist = d
                        best = p.Character
                    end
                end
            end
        end
        _G.CurrentClosestTarget = best
        return best, bestDist
    end
    
    if _G.TargetMode == "Nearest Target" then
        local best, bestDist = nil, 200
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                local h = p.Character:FindFirstChildOfClass("Humanoid")
                if h and h.Health > 0 and p.Character:GetAttribute("Downed") ~= true then
                    local d = (p.Character.HumanoidRootPart.Position - myPos).Magnitude
                    if d < bestDist then
                        bestDist = d
                        best = p.Character
                    end
                end
            end
        end
        _G.CurrentClosestTarget = best
        return best, bestDist
    end
    
    if _G.TargetMode == "Lowest Health Target" then
        local best, lowestHp = nil, math.huge
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                local h = p.Character:FindFirstChildOfClass("Humanoid")
                if h and h.Health > 0 and p.Character:GetAttribute("Downed") ~= true then
                    local d = (p.Character.HumanoidRootPart.Position - myPos).Magnitude
                    if h.Health < lowestHp and d < 300 then
                        lowestHp = h.Health
                        best = p.Character
                    end
                end
            end
        end
        return best, best and (best.HumanoidRootPart.Position - myPos).Magnitude or 999
    end
    
    return nil, 999
end

