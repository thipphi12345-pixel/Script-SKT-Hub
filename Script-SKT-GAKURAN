local IllIlllIllIlllIlll = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/'
local function IlIlIlIlIlIlIlIlIl(data)
    data = string.gsub(data, '[^'..IllIlllIllIlllIlll..'=]', '')
    return (data:gsub('.', function(x)
        if (x == '=') then return '' end
        local r,f='',(IllIlllIllIlllIlll:find(x)-1)
        for i=6,1,-1 do r=r..(f%2^i-f%2^(i-1)>0 and '1' or '0') end
