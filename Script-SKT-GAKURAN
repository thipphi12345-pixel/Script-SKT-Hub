            local BindFrame = Instance.new("Frame")
            BindFrame.Size = UDim2.new(1, -10, 0, 45)
            BindFrame.BackgroundColor3 = UI_Config.CardColor
            BindFrame.Parent = TabContent
            CreateCorner(BindFrame, 6)
            
