            BindBtn.Position = UDim2.new(1, -105, 0.5, -12.5)
            BindBtn.BackgroundColor3 = UI_Config.MainColor
            
            local initKey = opts.CurrentValue or Enum.KeyCode.RightShift
            if opts.Flag and ConfigManager.Config[opts.Flag] ~= nil then
                local savedStr = ConfigManager.Config[opts.Flag]
                pcall(function() initKey = Enum.KeyCode[savedStr] or initKey end)
            end
            
            BindBtn.Text = initKey.Name
            BindBtn.TextColor3 = UI_Config.AccentColor
            BindBtn.Font = UI_Config.Font
            BindBtn.TextSize = 13
            BindBtn.Parent = BindFrame
            CreateCorner(BindBtn, 4)
            CreateStroke(BindBtn, UI_Config.DimTextColor, 1)

            local currentKey = initKey
            local binding = false

            BindBtn.MouseButton1Click:Connect(function()
                if binding then return end
                binding = true
                BindBtn.Text = "..."
                BindBtn.TextColor3 = Color3.fromRGB(255, 255, 0)
            end)

            table.insert(_G.GakuranHubConnections, UserInputService.InputBegan:Connect(function(input, gameProcessed)
                if binding then
                    if input.UserInputType == Enum.UserInputType.Keyboard then
                        if input.KeyCode == Enum.KeyCode.Escape then
                            BindBtn.Text = currentKey.Name
                            BindBtn.TextColor3 = UI_Config.AccentColor
                            binding = false
                            return
                        end
                        currentKey = input.KeyCode
                        BindBtn.Text = currentKey.Name
                        BindBtn.TextColor3 = UI_Config.AccentColor
                        if opts.Flag then
                            ConfigManager.Config[opts.Flag] = currentKey.Name
                            ConfigManager:Save()
                        end
                        if opts.Callback then
                            opts.Callback(currentKey, false)
                        end
                        binding = false
                    end
                else
                    if not gameProcessed and input.KeyCode == currentKey then
                        if opts.Callback then
                            opts.Callback(currentKey, true) -- true indicates a fire event
                        end
                    end
                end
            end))
            
            if opts.Callback then
                task.spawn(function()
                    opts.Callback(currentKey, false)
                end)
            end
            
            return {
                Set = function(self, newKey)
                    currentKey = newKey
                    BindBtn.Text = currentKey.Name
                end
            }
        end

        return Tab
    end
