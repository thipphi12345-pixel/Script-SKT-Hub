local function updateTargetList(query)
    query = query and string.lower(query) or ""
    local list = {}
    
    -- Add names that match the query
    for _, p in ipairs(game.Players:GetPlayers()) do
        if p ~= LocalPlayer then
            local pName = string.lower(p.Name)
            local pDisplay = string.lower(p.DisplayName)
            if query == "" or string.find(pName, query, 1, true) or string.find(pDisplay, query, 1, true) then
                table.insert(list, p.Name)
            end
        end
    end
    
    -- Sort by shortest name to match closest
    if query ~= "" then
        table.sort(list, function(a, b) return #a < #b end)
    end
    
    if #list == 0 then
        table.insert(list, "None")
    end
    
    return list
end

