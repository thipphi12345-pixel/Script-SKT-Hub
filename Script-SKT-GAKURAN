        if player == LocalPlayer then return end
        local hum = character:WaitForChild("Humanoid", 5)
        if not hum then return end
        local anim = hum:FindFirstChildOfClass("Animator") or hum:WaitForChild("Animator", 3)
        if not anim then return end
        
        local _G_ParryDebounces = {} -- Track last parry trigger per enemy
        table.insert(_G.GakuranHubConnections, anim.AnimationPlayed:Connect(function(track)
            if not AutoParryEnabled and not _G.AssistParryEnabled then return end
            local n = string.lower(track.Name or "")
            local isIgnored = string.find(n,"dash") or string.find(n,"roll") or string.find(n,"step")
                or string.find(n,"walk") or string.find(n,"run") or string.find(n,"idle")
                or string.find(n,"jump") or string.find(n,"fall") or string.find(n,"move")
            
            local isAtk = false
            if not isIgnored then
                isAtk = string.find(n,"m1") or string.find(n,"m2") or string.find(n,"punch")
                    or string.find(n,"attack") or string.find(n,"heavy") or string.find(n,"kick")
                    or string.find(n,"swing") or string.find(n,"slam") or string.find(n,"strike")
                    
                -- Fallback: If the enemy is in an attacking state, any non-ignored animation is likely a combo hit
                if not isAtk and enemyIsAttacking(character) then
                    isAtk = true
                end
            end
            if isAtk then
                local mc = LocalPlayer.Character
                if mc and mc:FindFirstChild("HumanoidRootPart") and character:FindFirstChild("HumanoidRootPart") then
                    if (character.HumanoidRootPart.Position - mc.HumanoidRootPart.Position).Magnitude <= 30 then
                        local clk = os.clock()
                        -- Prevent double-firing from same animation frame
                        if not enemyAttackStart[character] or (clk - enemyAttackStart[character] > 0.05) then
                            enemyAttackStart[character] = clk
                            enemySkipped[character] = nil
                            enemyParryTriggered[character] = nil  -- Allow fresh parry
                        end
                    end
                end
            end
        end))
    end
    
    local function watch(p)
        if p == LocalPlayer then return end
        if p.Character then task.spawn(wireAnimator, p.Character, p) end
        table.insert(_G.GakuranHubConnections, p.CharacterAdded:Connect(function(c) task.spawn(wireAnimator, c, p) end))
    end
    for _, p in ipairs(Players:GetPlayers()) do watch(p) end
    table.insert(_G.GakuranHubConnections, Players.PlayerAdded:Connect(watch))
end)

