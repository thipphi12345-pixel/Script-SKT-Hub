    Suffix = "%",
    CurrentValue = 100,
    Flag = "Slider_UIScale",
    Callback = function(Value)
        pcall(function()
            local sg = getGui()
            if sg then
                local mainFrame = sg:FindFirstChild("MainFrame")
                if mainFrame then
                    local scaleObj = mainFrame:FindFirstChild("MainUIScale")
                    if scaleObj then
                        scaleObj.Scale = Value / 100
                    end
                end
            end
        end)
    end,
})

