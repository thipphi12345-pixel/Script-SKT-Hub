-- // AUTO FINISH / CARRY LOGIC //
local function isCarried(targetChar)
    if not targetChar then return false end
    if targetChar:GetAttribute("Carried") or targetChar:GetAttribute("Grabbed") or targetChar:GetAttribute("BeingCarried") then return true end
    
    local hrp = targetChar:FindFirstChild("HumanoidRootPart")
    if hrp then
        for _, v in ipairs(hrp:GetConnectedParts()) do
            if v.Parent and v.Parent ~= targetChar and v.Parent:FindFirstChild("Humanoid") then
                return true
            end
        end
    end
    return false
end

local function isLocalPlayerBusy()
    local char = LocalPlayer.Character
    if not char then return false end
    if char:GetAttribute("Carrying") or char:GetAttribute("Executing") or char:GetAttribute("Grabbed") then return true end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if hrp then
        for _, v in ipairs(hrp:GetConnectedParts()) do
            if v.Parent and v.Parent ~= char and v.Parent:FindFirstChild("Humanoid") then
                return true
            end
        end
    end
    return false
end

