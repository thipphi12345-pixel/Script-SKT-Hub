table.insert(_G.GakuranHubConnections, game:GetService("RunService").RenderStepped:Connect(function()
    if not _G.FaceTargetEnabled then
        local char = LocalPlayer.Character
        if char and char:FindFirstChild("Humanoid") then
            char.Humanoid.AutoRotate = true
            local align = char.HumanoidRootPart:FindFirstChild("FaceAttackerAlign")
            if align then align:Destroy() end
            local att = char.HumanoidRootPart:FindFirstChild("FaceAttackerAtt")
            if att then att:Destroy() end
        end
        return
    end

    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") or not char:FindFirstChild("Humanoid") then return end
    
    if char:GetAttribute("Downed") == true or char.Humanoid.Health <= 0 then
        char.Humanoid.AutoRotate = true
        return
    end

    local myPos = char.HumanoidRootPart.Position
    local bestTarget = nil
    
    -- Priority 1: Face the closest enemy who is CURRENTLY attacking us (From any direction!)
    local closestAttackerDist = math.huge
    for _, p in ipairs(game.Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            local ec = p.Character
            local dist = (ec.HumanoidRootPart.Position - myPos).Magnitude
            if dist <= 30 then
                -- Check EVERYTHING to guarantee real-time detection
                local e_atk = enemyAttackStart[ec] or enemyIsAttacking(ec) or enemyIsHeavyAttacking(ec)
                local e_skill = enemyIsUsingSkill(ec)
                if e_atk or e_skill then
                    if dist < closestAttackerDist then
                        closestAttackerDist = dist
                        bestTarget = ec.HumanoidRootPart
                    end
                end
            end
        end
    end
    
    -- Priority 2: If no one is attacking, just face our Locked Target
    if not bestTarget and lockedTarget and lockedTarget:FindFirstChild("HumanoidRootPart") then
        bestTarget = lockedTarget.HumanoidRootPart
    end
    
    -- Priority 3: Keep facing the last enemy we fought
    if not bestTarget and _G.LastFacedTarget and _G.LastFacedTarget.Parent and _G.LastFacedTarget.Parent:FindFirstChild("Humanoid") and _G.LastFacedTarget.Parent.Humanoid.Health > 0 then
        local dist = (_G.LastFacedTarget.Position - myPos).Magnitude
        if dist <= 30 then
            bestTarget = _G.LastFacedTarget
        else
            _G.LastFacedTarget = nil
        end
    end

    -- Execution: Apply Physics-Safe Rotation
    if bestTarget then
        _G.LastFacedTarget = bestTarget
        char.Humanoid.AutoRotate = false
        
        local lookDir = (bestTarget.Position - myPos)
        if lookDir.Magnitude > 0.1 then
            lookDir = Vector3.new(lookDir.X, 0, lookDir.Z).Unit
            
            -- Fallback instant CFrame snap for real-time responsiveness (before AlignOrientation catches up)
            char.HumanoidRootPart.CFrame = CFrame.lookAt(char.HumanoidRootPart.Position, char.HumanoidRootPart.Position + lookDir)
            
            -- Use AlignOrientation to hold the angle perfectly without physics stutter
            local align = char.HumanoidRootPart:FindFirstChild("FaceAttackerAlign")
            local att = char.HumanoidRootPart:FindFirstChild("FaceAttackerAtt")
            
            if not align or not att then
                if align then align:Destroy() end
                if att then att:Destroy() end
                
                att = Instance.new("Attachment")
                att.Name = "FaceAttackerAtt"
                att.Parent = char.HumanoidRootPart
                
                align = Instance.new("AlignOrientation")
                align.Name = "FaceAttackerAlign"
                align.Mode = Enum.OrientationAlignmentMode.OneAttachment
                align.Attachment0 = att
                align.RigidityEnabled = true
                align.MaxAngularVelocity = math.huge
                align.MaxTorque = math.huge
                align.Responsiveness = 200
                align.Parent = char.HumanoidRootPart
            end
            
            align.CFrame = CFrame.lookAt(Vector3.zero, lookDir)
        end
    else
        _G.LastFacedTarget = nil
        char.Humanoid.AutoRotate = true
        local align = char.HumanoidRootPart:FindFirstChild("FaceAttackerAlign")
        if align then align:Destroy() end
        local att = char.HumanoidRootPart:FindFirstChild("FaceAttackerAtt")
        if att then att:Destroy() end
    end
end))

