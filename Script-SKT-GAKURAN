-- // AUTO SAVE LOGIC (Replaces Auto Flee) //
task.spawn(function()
    local isFleeing = false
    local savedCFrame = nil
    local tween = nil
    local ts = game:GetService("TweenService")
    
    while _G.GakuranHubLoopId == currentLoopId do
        task.wait(0.2)
        local char = LocalPlayer.Character
        local hum = char and char:FindFirstChild("Humanoid")
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        
        if _G.AutoFleeEnabled and hum and hrp and hum.Health > 0 and char:GetAttribute("Downed") ~= true then
            local healthPct = hum.Health / hum.MaxHealth
            if healthPct < 0.4 and not isFleeing then
                isFleeing = true
                savedCFrame = hrp.CFrame -- Save current position
                
                -- Anchor parts for safe floating
                for _, v in ipairs(char:GetDescendants()) do
                    if v:IsA("BasePart") then v.Anchored = true end
                end
                
                local targetPos = Vector3.new(56.517852783203125, 50.103145599365234, -28.336639404296875)
                local dist = (hrp.Position - targetPos).Magnitude
                local tInfo = TweenInfo.new(dist / 150, Enum.EasingStyle.Linear)
                tween = ts:Create(hrp, tInfo, {CFrame = CFrame.new(targetPos)})
                tween:Play()
                
            elseif isFleeing and healthPct >= 0.95 then
                isFleeing = false
                if tween then tween:Cancel() end
                
                -- Float back to the original position
                if savedCFrame then
                    local dist = (hrp.Position - savedCFrame.Position).Magnitude
                    local tInfo = TweenInfo.new(dist / 150, Enum.EasingStyle.Linear)
                    local returnTween = ts:Create(hrp, tInfo, {CFrame = savedCFrame})
                    returnTween:Play()
                    returnTween.Completed:Wait()
                    savedCFrame = nil
                end
                
                -- Unanchor after reaching destination
                for _, v in ipairs(char:GetDescendants()) do
                    if v:IsA("BasePart") then v.Anchored = false end
                end
            end
        elseif not _G.AutoFleeEnabled and isFleeing then
            -- Failsafe: User disabled Auto Flee while fleeing
            isFleeing = false
            if tween then tween:Cancel() end
            if char then
                for _, v in ipairs(char:GetDescendants()) do
                    if v:IsA("BasePart") then v.Anchored = false end
                end
            end
            savedCFrame = nil
        end
    end
end)

