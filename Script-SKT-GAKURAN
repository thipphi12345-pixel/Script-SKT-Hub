            SliderValue.BackgroundTransparency = 1
            SliderValue.Text = tostring(opts.CurrentValue or opts.Range[1]) .. (opts.Suffix and (" " .. opts.Suffix) or "")
            SliderValue.TextColor3 = UI_Config.AccentColor
            SliderValue.Font = UI_Config.Font
            SliderValue.TextSize = 14
            SliderValue.TextXAlignment = Enum.TextXAlignment.Right
            SliderValue.Parent = SliderFrame

            local SliderBg = Instance.new("TextButton")
            SliderBg.Size = UDim2.new(1, -30, 0, 6)
            SliderBg.Position = UDim2.new(0, 15, 0, 35)
            SliderBg.BackgroundColor3 = UI_Config.MainColor
            SliderBg.Text = ""
            SliderBg.Parent = SliderFrame
            CreateCorner(SliderBg, 3)

            local SliderFill = Instance.new("Frame")
            SliderFill.Size = UDim2.new(0, 0, 1, 0)
            SliderFill.BackgroundColor3 = UI_Config.AccentColor
            SliderFill.Parent = SliderBg
            CreateCorner(SliderFill, 3)

            local min, max = opts.Range[1], opts.Range[2]
            local current = opts.CurrentValue or min
            if opts.Flag and ConfigManager.Config[opts.Flag] ~= nil then
                current = ConfigManager.Config[opts.Flag]
            end
            local increment = opts.Increment or 1

            local function updateSlider(val)
                current = math.clamp(math.round(val / increment) * increment, min, max)
                local percent = (current - min) / (max - min)
                SliderFill.Size = UDim2.new(percent, 0, 1, 0)
                SliderValue.Text = tostring(current) .. (opts.Suffix and (" " .. opts.Suffix) or "")
                if opts.Flag then
                    ConfigManager.Config[opts.Flag] = current
                    ConfigManager:Save()
                end
                if opts.Callback then
                    opts.Callback(current)
                end
            end
            
            -- Set UI without triggering save initially
            local percent = (current - min) / (max - min)
            SliderFill.Size = UDim2.new(percent, 0, 1, 0)
            SliderValue.Text = tostring(current) .. (opts.Suffix and (" " .. opts.Suffix) or "")
            if opts.Callback then
                task.spawn(function()
                    opts.Callback(current)
                end)
            end

            local sliding = false
            SliderBg.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    sliding = true
                    local percent = math.clamp((input.Position.X - SliderBg.AbsolutePosition.X) / SliderBg.AbsoluteSize.X, 0, 1)
                    updateSlider(min + (max - min) * percent)
                end
            end)
            
            UserInputService.InputChanged:Connect(function(input)
                if (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) and sliding then
                    local percent = math.clamp((input.Position.X - SliderBg.AbsolutePosition.X) / SliderBg.AbsoluteSize.X, 0, 1)
                    updateSlider(min + (max - min) * percent)
                end
            end)
            
            UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    sliding = false
                end
            end)
        end

        function Tab:CreateDropdown(opts)
            local DropFrame = Instance.new("Frame")
            DropFrame.Size = UDim2.new(1, -10, 0, 45)
