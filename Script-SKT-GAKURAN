                        if p ~= LocalPlayer and p.Character and (p.Character:GetAttribute("Knocked") or p.Character:GetAttribute("Downed")) then
                            if not isCarried(p.Character) then
                                local root = p.Character:FindFirstChild("HumanoidRootPart")
                                if root then
                                    local d = (root.Position - hrp.Position).Magnitude
                                    if d < bestDist then
                                        bestDist = d
                                        best = p
                                    end
                                end
                            end
                        end
                    end
                    targetPlayer = best
                    if best then _G.LockedExecuteTarget = best.Character end
                end
            end
            
            if targetPlayer and targetPlayer.Character then
                local targetChar = targetPlayer.Character
                if targetChar:GetAttribute("Knocked") or targetChar:GetAttribute("Downed") then
                    local hrp = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                    local targetHrp = targetChar:FindFirstChild("HumanoidRootPart")
                    if hrp and targetHrp then
                        _G.IsExecuting = true
                        
                        -- วาร์ปไปยืนบนศพ (ให้อยู่ในแนวตั้งตรง)
                        LocalPlayer.Character:PivotTo(CFrame.new(targetHrp.Position + Vector3.new(0, 3, 0)))
                        hrp.Velocity = Vector3.new(0, 0, 0)
                        hrp.Anchored = true -- ล็อคตัวให้อยู่นิ่งๆ ไม่ให้ล้มกลิ้ง
                        
                        -- กดปุ่ม V หรือ B เพื่อจับ/ซ้ำ
                        local VirtualInputManager = game:GetService("VirtualInputManager")
                        if _G.AutoExecuteEnabled then
                            VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.B, false, game)
                            task.wait(0.02)
                            VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.B, false, game)
                        elseif _G.AutoCarryEnabled then
                            VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.V, false, game)
                            task.wait(0.02)
                            VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.V, false, game)
                        end
                        
                        local remotes = game:GetService("ReplicatedStorage"):FindFirstChild("Remotes")
                        if remotes and remotes:FindFirstChild("Server") then
                            if _G.AutoExecuteEnabled then
                                pcall(function() remotes.Server:FireServer({Type = "KnockedGripRequest", Target = targetPlayer}) end)
                            elseif _G.AutoCarryEnabled then
                                pcall(function() remotes.Server:FireServer({Type = "KnockedCarryRequest", Target = targetPlayer}) end)
                            end
                        end
                        
                        -- แยกระยะเวลาแช่แข็งตัวละคร
                        -- ถ้าเป็น Execute ต้องรอนานหน่อยให้แอนิเมชันซ้ำจบ (ประมาณ 3 วิ)
                        -- ถ้าเป็น Carry อุ้มเสร็จแล้วปลดเลย (0.2 วิ)
                        if _G.AutoExecuteEnabled then
                            task.wait(3)
                        else
                            task.wait(0.2)
                        end
                        
                        if hrp then hrp.Anchored = false end
                        
                        -- Set Cooldown แยกกัน
                        if _G.AutoExecuteEnabled then
                            _G.LastFinishActionTime = os.clock() + 2 -- เพิ่มคูลดาวน์กันวาร์ปไปตัวอื่น
                        else
                            _G.LastFinishActionTime = os.clock()
                        end
                        
                        _G.IsExecuting = false
                    end
                end
            end
            end -- ปิดเงื่อนไข isLocalPlayerBusy
        end
    end
end)

-- // AUTO SAVE LOGIC (Replaces Auto Flee) //
task.spawn(function()
    local isFleeing = false
    local savedCFrame = nil
    while _G.GakuranHubLoopId == currentLoopId do
        task.wait(0.2)
        if _G.AutoFleeEnabled and LocalPlayer.Character then
            local char = LocalPlayer.Character
            local hum = char:FindFirstChild("Humanoid")
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if hum and hrp and hum.Health > 0 and char:GetAttribute("Downed") ~= true then
                local healthPct = hum.Health / hum.MaxHealth
                if healthPct < 0.4 and not isFleeing then
                    isFleeing = true
                    savedCFrame = hrp.CFrame -- Save current position
                    
                    -- เปลี่ยนจากวาร์ปขึ้น 100,000 เป็นแค่บินขึ้นไป 150 studs ให้พ้นระยะการโจมตีพอครับ
                    char:PivotTo(CFrame.new(hrp.Position.X, hrp.Position.Y + 150, hrp.Position.Z))
                    hrp.Velocity = Vector3.new(0,0,0)
                    
                    -- Anchor all parts to freeze safely in the sky
                    for _, v in ipairs(char:GetDescendants()) do
                        if v:IsA("BasePart") then v.Anchored = true end
                    end
                    
                elseif isFleeing and healthPct >= 0.95 then
                    isFleeing = false
                    
                    -- Unanchor first
                    for _, v in ipairs(char:GetDescendants()) do
                        if v:IsA("BasePart") then v.Anchored = false end
                    end
                    
                    -- Teleport back to where we were fighting
                    if savedCFrame then
                        char:PivotTo(savedCFrame)
                        savedCFrame = nil
                    end
                end
            end
        end
    end
end)

