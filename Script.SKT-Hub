}

-- จับคู่ชื่อที่แสดงใน UI กับ ID ในเกม
local BoostIDs = {
    ["Coins I"] = "CoinsI", ["Coins II"] = "CoinsII", ["Coins III"] = "CoinsIII",
    ["Damage I"] = "DamageI", ["Damage II"] = "DamageII", ["Damage III"] = "DamageIII",
    ["Exp I"] = "ExpI", ["Exp II"] = "ExpII", ["Exp III"] = "ExpIII",
    ["Luck"] = "Luck", ["Super Luck"] = "SuperLuck", ["Ultra Luck"] = "UltraLuck",
    ["Star Speed"] = "StarSpeed"
}

Tab_Player:CreateDropdown({
    Name = "Select Boosts to Auto Use",
    Options = BoostOptions,
    CurrentOption = {},
    MultipleOptions = true,
    Flag = "Dropdown_Boosts",
