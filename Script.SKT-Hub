-- Data from game dumps
local QuestData = {
    ["Pirate Island"] = {Module = "PirateIsland", Npc = "PirateQuest", Monsters = {"Kaku", "Shiriu", "Rob", "Figarlend", "Buggi"}},
    ["Blacksmiths Village"] = {Module = "BlacksmithsVillage", Npc = "BlacksmithsQuest", Monsters = {"Enmo", "Ruih", "Hantego", "Dhoma", "Kokoshibo"}},
    ["Planet Of Warriors"] = {Module = "PlanetOfWarriors", Npc = "WarriorsQuest", Monsters = {"Gran", "Boo", "GokoBlack", "Frieza", "Broli"}},
    ["Leveling City"] = {Module = "LevelingCity", Npc = "LevelingQuest", Monsters = {"MaceGuardian", "AxeGuardian", "SwordGuardian", "SingerGuardian", "BigGuardian"}},
    ["Tower City"] = {Module = "TowerCity", Npc = "TowerQuest", Monsters = {"Haribol", "Coyoti", "Yhwache", "Grimmjew", "Ichegi"}}
}

_G.SelectedQuestKey = "Pirate Island"
_G.SelectedMonster = "Buggi"

local MonsterDropdown = Tab_Autofarm:CreateDropdown({
    Name = "Select Monster (Target)",
    Options = {"Kaku", "Shiriu", "Rob", "Figarlend", "Buggi"},
    CurrentOption = {"Buggi"},
    MultipleOptions = false,
    Flag = "MonsterSelect", 
    Callback = function(Option)
        _G.SelectedMonster = type(Option) == "table" and Option[1] or Option
    end,
})

local MapDropdown = Tab_Autofarm:CreateDropdown({
    Name = "Select Quest Map",
    Options = {"Pirate Island", "Blacksmiths Village", "Planet Of Warriors", "Leveling City", "Tower City"},
    CurrentOption = {"Pirate Island"},
    MultipleOptions = false,
    Flag = "QuestSelect", 
    Callback = function(Option)
        _G.SelectedQuestKey = type(Option) == "table" and Option[1] or Option
        
        -- ทิ้งเควสเก่าทุกครั้งที่เปลี่ยนแมพ ป้องกันบัครับเควสซ้อน
        pcall(function()
            local Bridge = game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("Bridge")
            Bridge:FireServer("General", "Quest", "Abandon")
            
            -- วาร์ปไปยังแมพที่เลือกทันที! (ดึงชื่อ Module จาก QuestData)
            local targetKey = _G.SelectedQuestKey
            local qData = QuestData[targetKey]
            if qData and qData.Module then
                SafeUITeleport(qData.Module)
            end
        end)
        
        -- Build dropdown options
        local opts = {}
        local mapKey = _G.SelectedQuestKey
        if QuestData[mapKey] then
            for _, m in ipairs(QuestData[mapKey].Monsters) do
                table.insert(opts, m)
            end
        end
        
        -- เก็บค่าเดิมไว้ป้องกันปัญหาตอน Load Config
        local oldMonster = _G.SelectedMonster
        
        MonsterDropdown:Refresh(opts, {opts[1]})
        
        -- ถ้าค่าเดิมมีในตัวเลือกของแมพนี้ ให้ใช้ค่าเดิม
        local foundOld = false
        for _, o in ipairs(opts) do
            if o == oldMonster then
                foundOld = true
                break
            end
        end
        
        if foundOld then
            _G.SelectedMonster = oldMonster
            MonsterDropdown:Set({oldMonster})
        else
            _G.SelectedMonster = opts[1]
            MonsterDropdown:Set({opts[1]})
        end
    end,
})

local AutoQuestToggle = Tab_Autofarm:CreateToggle({
    Name = "Auto Quest & Farm",
    CurrentValue = false,
    Flag = "Toggle_AutoQuestFarm",
    Callback = function(Value)
        _G.AutoQuestFarm = Value
        
        local Bridge = game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("Bridge")
        
        while _G.AutoQuestFarm do
            task.wait(0.1) -- Fast loop for smooth farming
            
            -- Priority System: เช็คสถานะจริงๆ ว่ากำลังลง Trial หรือ Raid อยู่ไหม
            if _G.AutoTrial and _G.IsTrialActive then
                continue
            end
            
            local inRaidMode = false
            pcall(function()
                local ps = LocalPlayer:FindFirstChild("PlayerScripts")
                if ps and ps:FindFirstChild("Scripts") and ps.Scripts:FindFirstChild("Client") and ps.Scripts.Client:FindFirstChild("Main") then
                    local Main = require(ps.Scripts.Client.Main)
                    local mode = Main.Player:GetAttribute("Mode")
                    if mode and string.find(string.lower(mode), "towerraid") then
                        inRaidMode = true
                    end
                end
            end)
            
            if inRaidMode then
                continue
            end
            
            -- แก้ไขไม่ให้ฟาร์มตีกัน: ถ้าระบบอื่น (Trial / Raid) ทำงานอยู่ ให้หยุดฟาร์ม
            if _G.AutoTrial or _G.AutoRaid then
                task.wait(1)
                continue
            end
            
            local activeMapKey = _G.SelectedQuestKey
            
            local qData = QuestData[activeMapKey]
            if not qData then continue end
            
            local moduleName = qData.Module
            local npcName = qData.Npc
            
            -- ตรวจสอบว่าหลุดอยู่หน้า Lobby หรือเปล่า (เช่น เพิ่งออกมาจาก Trial)
            local inLobby = false
            pcall(function()
                local ps = LocalPlayer:FindFirstChild("PlayerScripts")
                if ps and ps:FindFirstChild("Scripts") and ps.Scripts:FindFirstChild("Client") and ps.Scripts.Client:FindFirstChild("Main") then
                    local Main = require(ps.Scripts.Client.Main)
                    if Main and Main.Player and Main.Player:GetAttribute("Mode") == "Lobby" then
                        inLobby = true
                    end
                end
            end)
            
            -- Fallback Lobby Check แบบปลอดภัย (แก้บัค Model Position)
            if not inLobby and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                pcall(function()
                    local trialDoor = workspace:FindFirstChild("Server") and workspace.Server:FindFirstChild("Misc_Teleports") and workspace.Server.Misc_Teleports:FindFirstChild("Trial_Join")
                    if trialDoor then
                        local tp
                        if trialDoor:IsA("Model") then
                            tp = trialDoor.PrimaryPart and trialDoor.PrimaryPart.Position or trialDoor:GetPivot().Position
                        else
                            tp = trialDoor.Position
                        end
                        if tp and (LocalPlayer.Character.HumanoidRootPart.Position - tp).Magnitude < 2000 then
                            inLobby = true
                        end
                    end
                end)
            end
            
            local wrongMap = false
            pcall(function()
                local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local cleanName = string.gsub(activeMapKey, " ", "")
                    local mapFolder = workspace:FindFirstChild(cleanName) or (workspace:FindFirstChild("Server") and workspace.Server:FindFirstChild(cleanName))
                    if mapFolder then
                        local part = mapFolder:IsA("BasePart") and mapFolder or mapFolder:FindFirstChildWhichIsA("BasePart", true)
                        if part then
                            if (hrp.Position - part.Position).Magnitude > 5000 then 
                                wrongMap = true
                            end
                        end
                    else
                        wrongMap = true
                    end
                end
            end)
            
            if inLobby or wrongMap then
                pcall(function()
                    SafeUITeleport(moduleName)
                end)
                task.wait(3) -- รอแมพโหลด
                continue
            end
            
            

            
            -- ดึงข้อมูล Main แบบปลอดภัย ป้องกันสคริปต์ค้าง (Yield)
            local Main = nil
            pcall(function()
                local ps = LocalPlayer:FindFirstChild("PlayerScripts")
                if ps then
                    local s = ps:FindFirstChild("Scripts")
                    if s then
                        local c = s:FindFirstChild("Client")
                        if c then
                            local m = c:FindFirstChild("Main")
                            if m then
                                Main = require(m)
                            end
                        end
                    end
                end
            end)
            
            local hasQuest = false
            
            -- พึ่งพาระบบเช็คจากหน้าจอเสริมเป็นหลัก (ป้องกันบัครับเควสซ้อน/ค้าง)
            pcall(function()
                if LocalPlayer and LocalPlayer:FindFirstChild("PlayerGui") then
                    for _, obj in ipairs(LocalPlayer.PlayerGui:GetDescendants()) do
                        if (obj:IsA("TextLabel") or obj:IsA("TextButton")) and obj.Text ~= "" then
                            local isVisible = true
                            local parent = obj
                            while parent and parent:IsA("GuiObject") do
                                if not parent.Visible then
                                    isVisible = false
                                    break
                                end
                                parent = parent.Parent
                            end
                            
                            if isVisible then
                                local cleanText = string.gsub(obj.Text, "<[^>]+>", "")
                                local m, curr, max = string.match(cleanText, "Defeat%s+%d+%s+(.-)%s*[%([](%d+)/(%d+)[%)%]]")
                                if m and curr and max then
                                    if tonumber(curr) < tonumber(max) then
                                        hasQuest = true
                                        break
                                    end
                                end
                            end
                        end
                    end
                end
            end)
            
            -- ถ้ายังไม่มีเควสต์ ให้ยิงรับเควสต์ของแมพนั้นทันที (ใช้ระบบดั้งเดิมที่เคยทำงานได้ 100%)
            if not hasQuest then
                pcall(function()
                    -- ระบบเดิมที่เคยรับเควสต์ Tower City ได้สำเร็จ
                    Bridge:FireServer("General", "Quest", "Accept", moduleName)
                end)
                
                task.wait(1.5) -- รอเซิร์ฟเวอร์อัปเดต Data
                
                local hasQuestAfter = false
                pcall(function()
                    if LocalPlayer and LocalPlayer:FindFirstChild("PlayerGui") then
                        for _, obj in ipairs(LocalPlayer.PlayerGui:GetDescendants()) do
                            if (obj:IsA("TextLabel") or obj:IsA("TextButton")) and obj.Text ~= "" then
                                local cleanText = string.gsub(obj.Text, "<[^>]+>", "")
                                local m, curr, max = string.match(cleanText, "Defeat%s+%d+%s+(.-)%s*[%([](%d+)/(%d+)[%)%]]")
                                if m and curr and max and tonumber(curr) < tonumber(max) then
                                    local isVisible = true
                                    local parent = obj
                                    while parent and parent:IsA("GuiObject") do
                                        if not parent.Visible then isVisible = false break end
                                        parent = parent.Parent
                                    end
                                    if isVisible then hasQuestAfter = true break end
                                end
                            end
                        end
                    end
                end)
                
                if _G.SelectedMonster == "Best ( Quest )" then
                    _G.IsCurrentMapFinished = not hasQuestAfter
                else
                    _G.IsCurrentMapFinished = false
                end
            else
                _G.IsCurrentMapFinished = false
            end
            
            -- 2. ค้นหามอนสเตอร์เป้าหมาย
            local targetMonsterName = _G.SelectedMonster
            
            -- 🌟 ระบบ Best ( Quest ) (หาตัวที่ยังตีไม่ครบ)
            if targetMonsterName == "Best ( Quest )" then
                local guiTarget = nil
                pcall(function()
                    if LocalPlayer and LocalPlayer:FindFirstChild("PlayerGui") then
                        local questObjectives = {}
                        for _, obj in ipairs(LocalPlayer.PlayerGui:GetDescendants()) do
                            if obj:IsA("TextLabel") or obj:IsA("TextButton") then
                                local text = obj.Text
                                -- ลบ RichText tags ออกก่อนเพื่อความชัวร์
                                local cleanText = string.gsub(text, "<[^>]+>", "")
                                -- Match: Defeat 30 Mace Guardian (30/30) หรือ [30/30]
                                local monsterName, currentStr, maxStr = string.match(cleanText, "Defeat%s+%d+%s+(.-)%s*[%([](%d+)/(%d+)[%)%]]")
                                
                                if monsterName and currentStr and maxStr then
                                    local current = tonumber(currentStr)
                                    local max = tonumber(maxStr)
                                    
                                    if current and max and current < max then
                                        local yPos = obj.AbsolutePosition and obj.AbsolutePosition.Y or 0
                                        table.insert(questObjectives, {
                                            Monster = string.gsub(monsterName, "^%s*(.-)%s*$", "%1"),
                                            Y = yPos,
                                            Obj = obj
                                        })
                                    end
                                end
                            end
                        end
                        
                        if #questObjectives > 0 then
                            -- กรองเอาเฉพาะอันที่ Visible จริงๆ
                            local visibleObjectives = {}
                            for _, q in ipairs(questObjectives) do
                                local isVisible = true
                                local parent = q.Obj
                                while parent and parent:IsA("GuiObject") do
                                    if not parent.Visible then
                                        isVisible = false
                                        break
                                    end
                                    parent = parent.Parent
                                end
                                if isVisible then
                                    table.insert(visibleObjectives, q)
                                end
                            end
                            
                            if #visibleObjectives == 0 then
                                visibleObjectives = questObjectives
                            end
                            
                            -- เรียงจากบนลงล่างตามตำแหน่ง Y
                            table.sort(visibleObjectives, function(a, b) return a.Y < b.Y end)
                            guiTarget = visibleObjectives[1].Monster
                        end
                    end
                end)
                
                if guiTarget then
                    targetMonsterName = guiTarget
                else
                    -- ถ้าหาจากหน้าจอ GUI ไม่เจอ ให้ใช้ระบบสำรอง (ดึงจาก Data)
                    if hasQuest then
                        targetMonsterName = nil
                        pcall(function()
                            local SharedQuest = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("Quests"):WaitForChild(moduleName))
                            local sortedList = {}
                            for key, val in pairs(SharedQuest.List) do
                                table.insert(sortedList, {key = key, data = val})
                            end
                            table.sort(sortedList, function(a, b) return a.key < b.key end)
                            
                            for _, item in ipairs(sortedList) do
                                local key = item.key
                                local v = item.data
                                local rawData = Main.Data.Quest.List[v.Target] or Main.Data.Quest.List[string.gsub(v.Target, " ", "")] or Main.Data.Quest.List[key]
                                local killed = 0
                                if type(rawData) == "number" then killed = rawData
                                elseif type(rawData) == "table" then killed = rawData.Amount or rawData.Progress or rawData.Value or 0 end
                                
                                if killed < v.Amount then
                                    targetMonsterName = v.Target
                                    break
                                end
                            end
                        end)
                    else
                        targetMonsterName = qData.Monsters[1]
                    end
                end
            end
            
            if targetMonsterName and targetMonsterName ~= "Auto Progress" then
                local targetMonster = nil
                local shortestDistance = math.huge
                
                -- ค้นหามอนสเตอร์ทั้งหมดใน Workspace
                for _, obj in ipairs(workspace:GetDescendants()) do
                    -- ตัดช่องว่างออกจากชื่อก่อนเทียบ ป้องกันปัญหาเช่น Target="AxeGuardian" แต่ Model="Axe Guardian"
                    local cleanObjName = string.lower(string.gsub(obj.Name, "[^%w]", ""))
                    local cleanTargetName = string.lower(string.gsub(targetMonsterName, "[^%w]", ""))
                    
                    local isNameMatch = (cleanObjName == cleanTargetName) or (string.find(cleanObjName, "^" .. cleanTargetName .. "lv%d+"))
                    if isNameMatch and obj:IsA("Model") and obj:FindFirstChild("HumanoidRootPart") and obj:FindFirstChild("Humanoid") then
                        -- ตรวจสอบว่ายังมีชีวิตอยู่จริงไหม
                        local isAlive = true
                        
                        -- เช็คระบบเลือดแยกจาก Attribute เป็นหลัก (บางเกมเลือด Humanoid = 0 แต่ยังไม่ตาย)
                        if obj:GetAttribute("Health") ~= nil then
                            if obj:GetAttribute("Health") <= 0 then
                                isAlive = false
                            end
                        else
                            if obj.Humanoid.Health <= 0 then
                                isAlive = false
                            end
                        end
                        
                        -- เช็คสถานะการตายจาก Attribute
                        if obj:GetAttribute("Dead") == true or obj:GetAttribute("Died") == true or obj:GetAttribute("IsDead") == true then
                            isAlive = false
                        end
                        -- เช็คสถานะจาก Humanoid โดยตรง
                        if obj.Humanoid:GetState() == Enum.HumanoidStateType.Dead then
                            isAlive = false
                        end
                        
                        if isAlive then
                            -- หามอนสเตอร์ที่ใกล้ที่สุด
                            if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                                local dist = (LocalPlayer.Character.HumanoidRootPart.Position - obj.HumanoidRootPart.Position).Magnitude
                                if dist < shortestDistance then
                                    shortestDistance = dist
                                    targetMonster = obj
                                end
                            else
                                targetMonster = obj
                                break
                            end
                        end
                    end
                end
                
                -- 3. ถ้าเจอมอนสเตอร์ ให้วาร์ปไปตี
                if targetMonster then
                    _G.NoMonsterTimer = 0
                    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                        local hrp = LocalPlayer.Character.HumanoidRootPart
                        local dist = (hrp.Position - targetMonster.HumanoidRootPart.Position).Magnitude
                        
                        if dist > 15000 then
                            -- แมพอยู่ไกลมาก ให้ใช้ระบบเทเลพอร์ตข้ามเกาะแทน
                            pcall(function()
                                SafeUITeleport(moduleName)
                            end)
                            task.wait(1.5)
                        else
                            -- อัปเดตวาร์ปเมื่อ 1) เปลี่ยนเป้าหมายมอนสเตอร์ (จาก Dropdown หรือเควสเลื่อน) 2) อยู่ไกลเกิน 15 Studs (โดนตีปลิวหรือเพิ่งกลับจาก Raid)
                            if _G.CurrentQuestTarget ~= targetMonster or (hrp.Position - targetMonster.HumanoidRootPart.Position).Magnitude > 15 then
                                _G.CurrentQuestTarget = targetMonster
                                hrp.CFrame = targetMonster.HumanoidRootPart.CFrame * CFrame.new(0, 3, 4)
                            end
                            
                            -- เซ็ตความเร็วเป็น 0 เพื่อป้องกันอาการตกหล่นหรือลื่น
                            hrp.Velocity = Vector3.new(0, 0, 0)
                            
                            -- ยิงคำสั่งโจมตีรัวๆ และสั่ง Fighters ให้เดินไปตี
                            pcall(function()
                                Bridge:FireServer("Fighters", "Click", "Damage")
                                Bridge:FireServer("Fighters", "Move", "Attack", targetMonster:GetAttribute("Location") or targetMonster.HumanoidRootPart.Position, targetMonster)
                                
                                -- สั่งตัวละครโจมตี (Attack)
                                local tool = LocalPlayer.Character:FindFirstChildOfClass("Tool") or LocalPlayer.Backpack:FindFirstChildOfClass("Tool")
                                if tool then
                                    LocalPlayer.Character.Humanoid:EquipTool(tool)
                                    tool:Activate()
                                end
                                
                                -- Removed VirtualUser clicking to prevent unwanted UI clicks
                                -- local vu = game:GetService("VirtualUser")
                                -- vu:CaptureController()
                                -- vu:Button1Down(Vector2.new(0,0), workspace.CurrentCamera.CFrame)
                                -- vu:Button1Up(Vector2.new(0,0), workspace.CurrentCamera.CFrame)
                            end)
                        end
                    end
                else
                    -- ถ้าหามอนไม่เจอเกิน 15 วินาที แปลว่าหลุดไปอยู่ด่านอื่น (เช่น Trade) ให้บังคับวาร์ปกลับ!
                    _G.NoMonsterTimer = (_G.NoMonsterTimer or 0) + 1
                    if _G.NoMonsterTimer > 15 and not _G.IsCurrentMapFinished then
                        _G.NoMonsterTimer = 0
                        pcall(function()
                            SafeUITeleport(moduleName)
                        end)
                        task.wait(3)
                    else
                        task.wait(1)
                    end
                end
            end
        end
    end,
})

local function parseCoins(val)
    if type(val) == "number" then return val end
    local str = tostring(val)
    str = string.gsub(str, ",", "")
    local numStr = string.match(str, "^[%d%.]+")
    if not numStr then return 0 end
    local num = tonumber(numStr) or 0
    local upperStr = string.upper(str)
    if string.match(upperStr, "K") then num = num * 1000 
    elseif string.match(upperStr, "M") then num = num * 1000000
    elseif string.match(upperStr, "B") then num = num * 1000000000 end
    return num
end

Tab_Autofarm:CreateToggle({
    Name = "Auto Next Map",
    CurrentValue = false,
    Flag = "Toggle_AutoNextMap",
    Callback = function(Value)
        _G.AutoNextMap = Value
        local Bridge = game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("Bridge")
        
        while _G.AutoNextMap do
            task.wait(1)
            
            pcall(function()
                -- ถ้าด่านปัจจุบันยังไม่เคลียร์ หรือไม่ได้เปิด AutoQuest อยู่ ก็ไม่ต้องทำอะไร
                if not _G.AutoQuestFarm or not _G.IsCurrentMapFinished then return end
                
                local activeMapKey = _G.SelectedQuestKey
                
                -- หา Index ของแมพปัจจุบัน
                local currentIndex = 0
                for i, mapName in ipairs(MapOrderList) do
                    if mapName == activeMapKey then
                        currentIndex = i
                        break
                    end
                end
                
                -- ถ้าไม่ใช่แมพสุดท้าย (ยังมีแมพถัดไป)
                if currentIndex > 0 and currentIndex < #MapOrderList then
                    local nextMapName = MapOrderList[currentIndex + 1]
                    local nextMapCost = MapUnlockCost[nextMapName] or math.huge
                    
                    -- เช็คเงิน (Coins) พร้อมระบบกรองตัวอักษรและลูกน้ำ
                    local myCoins = 0

                    if LocalPlayer:FindFirstChild("leaderstats") then
                        local c = LocalPlayer.leaderstats:FindFirstChild("Coins") or LocalPlayer.leaderstats:FindFirstChild("💰 Coins") or LocalPlayer.leaderstats:FindFirstChild("Yen")
                        if c then
                            myCoins = parseCoins(c.Value)
                        else
                            for _, stat in ipairs(LocalPlayer.leaderstats:GetChildren()) do
                                if string.match(stat.Name, "Coins") or string.match(stat.Name, "Yen") then
                                    myCoins = parseCoins(stat.Value)
                                    break
                                end
                            end
                        end
                    end
                    
                    if myCoins >= nextMapCost then
                        local moduleName = nextMapName
                        if QuestData and QuestData[nextMapName] and QuestData[nextMapName].Module then
                            moduleName = QuestData[nextMapName].Module
                        end
                        
                        -- ซื้อแมพถัดไป (ลองหลายๆ รูปแบบเพื่อความชัวร์ รวมถึงชื่อ Module)
                        Bridge:FireServer("General", "Portal", "Unlock", moduleName)
                        Bridge:FireServer("General", "Portal", "Buy", moduleName)
                        Bridge:FireServer("General", "Portal", "Unlock", nextMapName)
                        
                        -- ใช้ Remote ซื้อ/ปลดล็อคแมพถัดไป (เรายิง Remote ไปแล้วด้านบน)
                        
                        task.wait(1.5)
                        
                        -- เปลี่ยนตัวเลือกเป้าหมายไปแมพใหม่
                        _G.SelectedQuestKey = nextMapName
                        if MapDropdown then
                            MapDropdown:Set({nextMapName})
                        end
                        
                        -- รีเซ็ตสถานะว่าเคลียร์ด่านแล้ว เพื่อให้ AutoQuest ทำงานกับด่านใหม่
                        _G.IsCurrentMapFinished = false
                    end
                end
            end)
        end
    end,
})

local Section_Trial = Tab_Trial:CreateSection("Trial Settings")

Tab_Trial:CreateSlider({
    Name = "Max Trial Wave",
    Range = {0, 100},
    Increment = 1,
    Suffix = "Wave (0 = Unlimited)",
    CurrentValue = 0,
    Flag = "Slider_MaxTrialWave",
    Callback = function(Value)
        _G.MaxTrialWave = Value
    end,
})

local AutoTrialToggle = Tab_Trial:CreateToggle({
    Name = "Auto Farm Trial",
    CurrentValue = false,
    Flag = "Toggle_AutoTrial",
    Callback = function(Value)
        _G.AutoTrial = Value
        local Bridge = game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("Bridge")
        
        -- ตัวแปรเก็บประวัติการลง Trial เพื่อไม่ให้ลงซ้ำในรอบเวลาเดิม
        _G.LastTrialCompletedHour = _G.LastTrialCompletedHour or -1
        _G.LastTrialCompletedHalf = _G.LastTrialCompletedHalf or -1
        _G.HasJoinedTrialLobby = false
        
        while _G.AutoTrial do
            task.wait(1)
            
            if _G.AutoRaid then
                continue
            end
            
            local inTrialMode = false
            pcall(function()
                local ps = LocalPlayer:FindFirstChild("PlayerScripts")
                if ps and ps:FindFirstChild("Scripts") and ps.Scripts:FindFirstChild("Client") and ps.Scripts.Client:FindFirstChild("Main") then
                    local Main = require(ps.Scripts.Client.Main)
                    if Main and Main.Player then
                        local mode = Main.Player:GetAttribute("Mode")
                        if mode then
                            local modeLower = string.lower(mode)
                            if string.find(modeLower, "towerraid") or string.find(modeLower, "raid") then
                                inTrialMode = false
                            elseif string.find(modeLower, "trial") or string.find(modeLower, "gamemode") then
                                inTrialMode = true
                            end
                        end
                        -- ป้องกันการสับสนระหว่างด่าน
                        if workspace:FindFirstChild("Server") and workspace.Server:FindFirstChild("TowerRaid") then
                            inTrialMode = false
                        elseif workspace:FindFirstChild("Server") and workspace.Server:FindFirstChild("Trial") then
                            inTrialMode = true
                        end
                        if mode == "Lobby" or mode == "Town" then
                            _G.InTrialFlag = false
                        end
                    end
                end
            end)
            
            if _G.InTrialFlag then
                inTrialMode = true
                -- ตรวจสอบว่าถ้ากลับมาอยู่หน้าประตูแล้ว (ตาย/จบรอบ) ให้ยกเลิก Flag
                local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                if hrp then
                    pcall(function()
                        local trialDoor = workspace:FindFirstChild("Server") and workspace.Server:FindFirstChild("Misc_Teleports") and workspace.Server.Misc_Teleports:FindFirstChild("Trial_Join")
                        if not trialDoor then
                            trialDoor = workspace:FindFirstChild("Server") and workspace.Server:FindFirstChild("Trial") and workspace.Server.Trial:FindFirstChild("Lobby") and workspace.Server.Trial.Lobby:FindFirstChild("Door")
                        end
                        if trialDoor then
                            local targetPos
                            if trialDoor:IsA("Model") then
                                targetPos = trialDoor.PrimaryPart and trialDoor.PrimaryPart.Position or trialDoor:GetPivot().Position
                            else
                                targetPos = trialDoor.Position
                            end
                            
                            if targetPos and (hrp.Position - targetPos).Magnitude < 100 then
                                inTrialMode = false
                                _G.InTrialFlag = false
                            end
                        end
                    end)
                end
            end
            
            local currentTime = os.date("*t")
            local min = currentTime.min
            local hour = currentTime.hour
            
            -- ช่วงเวลาที่ดันเจี้ยนเปิดคือต้นชั่วโมง (XX:00) และครึ่งชั่วโมง (XX:30)
            -- เราจะดักรอช่วง XX:58 ถึง XX:03 และ XX:28 ถึง XX:33
            local isTrialWindow = false
            local currentHalf = 0
            
            if (min >= 1 and min <= 4) then
                isTrialWindow = true
                currentHalf = 0
            elseif min >= 31 and min <= 34 then
                isTrialWindow = true
                currentHalf = 1
            end
            
            local alreadyCompleted = (_G.LastTrialCompletedHour == hour and _G.LastTrialCompletedHalf == currentHalf)
            
            _G.IsTrialActive = inTrialMode or (isTrialWindow and not alreadyCompleted)
            
            if not inTrialMode then
                if isTrialWindow and not alreadyCompleted then
                    -- เช็คว่าติดอยู่ใน Raid หรือไม่
                    local isInRaid = false
                    pcall(function()
                        local mode = game:GetService("Players").LocalPlayer:GetAttribute("Mode")
                        if mode and string.find(string.lower(mode), "towerraid") then
                            isInRaid = true
                        end
                    end)
                    
                    if isInRaid then
                        -- ประนีประนอมกับระบบ Raid: ถ้าเพิ่งเข้า Trial Window ให้รอจนกว่า Raid จะจบ
                        -- แต่ถ้าใกล้จะหมดเวลา Trial (นาทีที่ 3-4 หรือ 33-34) ค่อยบังคับเตะออก
                        if not (min == 3 or min == 4 or min == 33 or min == 34) then
                            continue -- ปล่อยให้ฟาร์ม Raid ต่อไปก่อน
                        end
                    end
                    
                    -- ถ้าไม่ได้อยู่ใน Raid หรือถึงเวลาต้องบังคับออกแล้ว
                    pcall(function()
                        if isInRaid then
                            Bridge:FireServer("Gamemodes", "TowerRaid", "Leave")
                            Bridge:FireServer("Gamemodes", "TowerRaid", "Claim")
                            Bridge:FireServer("Gamemodes", "TowerRaid", "Exit")
                                
                                local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                                if hrp then
                                    local raidMap = workspace:FindFirstChild("Server") and workspace.Server:FindFirstChild("TowerRaid")
                                    if raidMap then
                                        for _, v in ipairs(raidMap:GetDescendants()) do
                                            if v:IsA("ProximityPrompt") or string.match(string.lower(v.Name), "exit") or string.match(string.lower(v.Name), "leave") then
                                                local target = v:IsA("ProximityPrompt") and v.Parent or v
                                                if target and (target:IsA("BasePart") or target:IsA("Model")) then
                                                    hrp.CFrame = target:IsA("Model") and target:GetPivot() or target.CFrame
                                                    task.wait(0.5)
                                                    if v:IsA("ProximityPrompt") and fireproximityprompt then
                                                        fireproximityprompt(v)
                                                    end
                                                    break
                                                end
                                            end
                                        end
                                    end
                                end
                                
                                SafeUITeleport("Lobby")
                                task.wait(2)
                        end
                    end)
                    
                    -- 1. ยังไม่ได้ลงรอบนี้ และถึงเวลาแล้ว -> วาร์ปไปเตรียมตัวที่ Lobby
                    local trialDoor = nil
                    pcall(function()
                        trialDoor = workspace.Server:FindFirstChild("Misc_Teleports") and workspace.Server.Misc_Teleports:FindFirstChild("Trial_Join")
                        if not trialDoor then
                            trialDoor = workspace.Server:FindFirstChild("Trial") and workspace.Server.Trial:FindFirstChild("Lobby") and workspace.Server.Trial.Lobby:FindFirstChild("Door")
                        end
                    end)
                    
                    if not trialDoor then
                        if not _G.HasJoinedTrialLobby then
                            local inLobby = false
                            pcall(function()
                                local ps = LocalPlayer:FindFirstChild("PlayerScripts")
                                if ps and ps:FindFirstChild("Scripts") and ps.Scripts:FindFirstChild("Client") and ps.Scripts.Client:FindFirstChild("Main") then
                                    local Main = require(ps.Scripts.Client.Main)
                                    if Main and Main.Player and Main.Player:GetAttribute("Mode") == "Lobby" then
                                        inLobby = true
                                    end
                                end
                            end)
                            
                            -- Fallback Lobby Check: If Trial_Join has loaded parts, we are in the Lobby
                            if not inLobby then
                                local td = workspace:FindFirstChild("Server") and workspace.Server:FindFirstChild("Misc_Teleports") and workspace.Server.Misc_Teleports:FindFirstChild("Trial_Join")
                                if td and td:FindFirstChildWhichIsA("BasePart", true) then
                                    inLobby = true
                                end
                            end
                            
                            if not inLobby then
                                pcall(function()
                                    SafeUITeleport("Lobby")
                                end)
                                task.wait(3)
                            else
                                -- Already in Lobby, just wait for the door to spawn at XX:00
                                task.wait(1)
                            end
                        end
                    else
                        -- เจอประตู Trial แล้ว (เวลา XX:00)
                        local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                        if hrp then
                            local part = trialDoor:FindFirstChildWhichIsA("BasePart", true)
                            if part then
                                local targetPos = part.Position
                                local targetCFrame = part.CFrame
                                
                                -- เทเลพอร์ตไปใกล้ๆ ประตูเฉพาะตอนที่อยู่ไกล
                                local dist = (hrp.Position - targetPos).Magnitude
                                if dist > 15 then
                                    hrp.CFrame = targetCFrame * CFrame.new(0, 5, 0)
                                    hrp.Velocity = Vector3.new(0,0,0)
                                    task.wait(0.5)
                                end
                            end
                            
                            -- ยิงคำสั่งเข้า Trial รัวๆ ทุก 2 วินาที จนกว่าจะโดนดึงเข้าห้อง (inTrialMode จะกลายเป็น true และหยุดลูปนี้เอง)
                            pcall(function()
                                local prompt = trialDoor:FindFirstChildWhichIsA("ProximityPrompt", true)
                                if prompt and fireproximityprompt then
                                    fireproximityprompt(prompt)
                                end
                                Bridge:FireServer("Gamemodes", "Trial", "Join")
                                _G.InTrialFlag = true -- ตั้งค่าว่าเข้าไปใน Trial แล้ว
                                
                                local confirmUI = LocalPlayer.PlayerGui:FindFirstChild("Confirmation")
                                if confirmUI and confirmUI.Enabled then
                                    confirmUI.Enabled = false
                                end
                            end)
                            
                            task.wait(2)
                        end
                    end
                else
                    if _G.WasInTrial then
                        local safeToWarp = false
                        local trialFolder = workspace:FindFirstChild("Server") and workspace.Server:FindFirstChild("Trial")
                        if not trialFolder then
                            safeToWarp = true
                        end
                        if safeToWarp then
                            _G.WasInTrial = false
                            _G.HasJoinedTrialLobby = false
                        end
                    end
                end
            else
                _G.WasInTrial = true
                _G.HasJoinedTrialLobby = false
                
                -- ประทับตราว่าลงสำเร็จแล้วตั้งแต่เริ่มเข้าเลย ป้องกันบัคเข้าซ้ำ
                _G.LastTrialCompletedHour = hour
                _G.LastTrialCompletedHalf = currentHalf
                
                local currentWave = 1
                pcall(function()
                    local rsTrial = game:GetService("ReplicatedStorage"):FindFirstChild("Gamemodes")
                    if rsTrial and rsTrial:FindFirstChild("Trial") and rsTrial.Trial:FindFirstChild("Wave") then
                        currentWave = tonumber(rsTrial.Trial.Wave.Value) or currentWave
                    end
                end)
                
                local maxWave = _G.MaxTrialWave or 999
                if maxWave <= 0 then maxWave = 999 end
                
                if currentWave >= maxWave then
                    local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                    if hrp then
                        -- 1. พยายามยิง Remote ออกจากดันเจี้ยน (ลองหลายชื่อเผื่อเกมเปลี่ยน)
                        pcall(function()
                            Bridge:FireServer("Gamemodes", "Trial", "Leave")
                            Bridge:FireServer("Gamemodes", "Trial", "Claim")
                            Bridge:FireServer("Gamemodes", "Trial", "Exit")
                        end)
                        
                        -- 2. พยายามกดปุ่ม UI เผื่อ Remote ไม่ทำงาน (ปัญหาที่คุณบอกว่ามันไม่ได้กด UI)
                        pcall(function()
                            if LocalPlayer and LocalPlayer:FindFirstChild("PlayerGui") then
                                for _, obj in ipairs(LocalPlayer.PlayerGui:GetDescendants()) do
                                    if obj:IsA("TextButton") and obj.Text ~= "" then
                                        local lowerText = string.lower(obj.Text)
                                        if string.find(lowerText, "leave") or string.find(lowerText, "claim") or string.find(lowerText, "exit") or string.find(lowerText, "continue") then
                                            -- เช็คว่า UI มองเห็นอยู่ไหม
                                            local isVisible = true
                                            local parent = obj
                                            while parent and parent:IsA("GuiObject") do
                                                if not parent.Visible then isVisible = false break end
                                                parent = parent.Parent
                                            end
                                            
                                            if isVisible and getconnections then
                                                for _, conn in ipairs(getconnections(obj.MouseButton1Click)) do
                                                    conn:Fire()
                                                end
                                            end
                                        end
                                    end
                                end
                            end
                        end)
                        
                        task.wait(1.5)
                        
                        -- สัมผัสประตู Exit เผื่อว่า Remote ไม่ทำงานและไม่ได้กด UI
                        pcall(function()
                            local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                            if hrp then
                                local trialMap = workspace:FindFirstChild("Server") and workspace.Server:FindFirstChild("Trial")
                                if trialMap then
                                    for _, v in ipairs(trialMap:GetDescendants()) do
                                        if v:IsA("ProximityPrompt") or string.match(string.lower(v.Name), "exit") or string.match(string.lower(v.Name), "leave") then
                                            local target = v:IsA("ProximityPrompt") and v.Parent or v
                                            if target and (target:IsA("BasePart") or target:IsA("Model")) then
                                                hrp.CFrame = target:IsA("Model") and target:GetPivot() or target.CFrame
                                                task.wait(0.5)
                                                if v:IsA("ProximityPrompt") and fireproximityprompt then
                                                    fireproximityprompt(v)
                                                end
                                                break
                                            end
                                        end
                                    end
                                end
                            end
                        end)
                        task.wait(1.5)
                        
                        pcall(function()
                            local targetMap = _G.SelectedQuestKey or "LevelingCity"
                            local qData = QuestData[targetMap]
                            if qData and qData.Module then
                                SafeUITeleport(qData.Module)
                            else
                                SafeUITeleport("LevelingCity")
                            end
                            task.delay(7, TeleportToSelectedMonster)
                        end)
                        
                        task.wait(2)
                        
                        -- เคลียร์สถานะดันเจี้ยน
                        _G.WasInTrial = true
                        _G.HasJoinedTrialLobby = false
                        -- ห้ามใช้ break ตรงนี้เด็ดขาด เพราะจะทำให้ระบบ Auto Trial พังและปิดตัวเองไปเลย
                    end
                    continue
                end
                
                local trialFolder = workspace:FindFirstChild("Server") and workspace.Server:FindFirstChild("Trial")
                local trialEnemiesFolder = trialFolder and trialFolder:FindFirstChild("Enemies")
                
                if trialEnemiesFolder then
                    local targetEnemy = nil
                    local targetHRP = nil
                    local shortestDistance = math.huge
                    local playerHRP = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                    
                    for _, v in ipairs(trialEnemiesFolder:GetChildren()) do
                        local eHRP = (v:IsA("Model") and v:FindFirstChild("HumanoidRootPart")) or (v:IsA("BasePart") and v)
                        
                        local isAlive = true
                        if v:IsA("Model") and v:FindFirstChild("Humanoid") then
                            isAlive = v.Humanoid.Health > 0
                            if v.Humanoid:GetState() == Enum.HumanoidStateType.Dead then isAlive = false end
                        end
                        if v:GetAttribute("Health") ~= nil and v:GetAttribute("Health") <= 0 then isAlive = false end
                        if v:GetAttribute("Dead") == true or v:GetAttribute("Died") == true or v:GetAttribute("IsDead") == true then isAlive = false end
                        
                        if eHRP and isAlive then
                            if playerHRP then
                                local dist = (playerHRP.Position - eHRP.Position).Magnitude
                                if dist < shortestDistance then
                                    shortestDistance = dist
                                    targetEnemy = v
                                    targetHRP = eHRP
                                end
                            else
                                targetEnemy = v
                                targetHRP = eHRP
                                break
                            end
                        end
                    end
                    
                    if targetEnemy and playerHRP then
                        -- กลับมาใช้วิธีล็อคพิกัดโลก (World Space) ป้องกันจมดิน
                        playerHRP.CFrame = CFrame.new(targetHRP.Position + Vector3.new(0, 3, 0), targetHRP.Position)
                        playerHRP.Velocity = Vector3.new(0, 0, 0)
                        
                        pcall(function()
                            Bridge:FireServer("Fighters", "Click", "Damage")
                            Bridge:FireServer("Fighters", "Move", "Attack", targetEnemy:GetAttribute("Location") or targetHRP.Position, targetEnemy)
                            
                            -- สั่งตัวละครโจมตี (Attack)
                            local tool = LocalPlayer.Character:FindFirstChildOfClass("Tool") or LocalPlayer.Backpack:FindFirstChildOfClass("Tool")
                            if tool then
                                LocalPlayer.Character.Humanoid:EquipTool(tool)
                                tool:Activate()
                            end
                            
                            -- Removed VirtualUser clicking to prevent unwanted UI clicks
                            -- local vu = game:GetService("VirtualUser")
                            -- vu:CaptureController()
                            -- vu:Button1Down(Vector2.new(0,0), workspace.CurrentCamera.CFrame)
                            -- vu:Button1Up(Vector2.new(0,0), workspace.CurrentCamera.CFrame)
                        end)
                    end
                end
            end
        end
    end,
})

