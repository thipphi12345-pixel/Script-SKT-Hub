local function SafeUITeleport(targetModuleOrName)
    local tpFound = false
    pcall(function()
        local LocalPlayer = game:GetService("Players").LocalPlayer
        if LocalPlayer and LocalPlayer:FindFirstChild("PlayerGui") then
            for _, obj in ipairs(LocalPlayer.PlayerGui:GetDescendants()) do
                if obj:IsA("TextLabel") and obj.Text ~= "" then
                    local textLower = string.lower(obj.Text)
                    local searchName = string.lower(targetModuleOrName)
                    if searchName == "lobby" then searchName = "starter town" end
                    if searchName == "levelingcity" then searchName = "leveling city" end
                    if searchName == "pirateisland" then searchName = "pirate island" end
                    if searchName == "blacksmithsvillage" then searchName = "blacksmiths village" end
                    if searchName == "planetofwarriors" then searchName = "planet of warriors" end
                    if searchName == "towercity" then searchName = "tower city" end
                    
                    local cleanObjText = string.gsub(textLower, " ", "")
                    local cleanSearchName = string.gsub(searchName, " ", "")
                    
                    if string.find(cleanObjText, cleanSearchName) then
                        local parent = obj.Parent
                        if parent then
                            for _, sibling in ipairs(parent:GetChildren()) do
                                if sibling:IsA("TextButton") and string.find(string.lower(sibling.Text), "teleport") then
                                    if getconnections then
                                        for _, conn in ipairs(getconnections(sibling.MouseButton1Click)) do
                                            conn:Fire()
                                        end
                                    end
                                    tpFound = true
                                    return
                                end
                            end
                            for _, desc in ipairs(parent:GetDescendants()) do
                                if desc:IsA("TextButton") and string.find(string.lower(desc.Text), "teleport") then
                                    if getconnections then
                                        for _, conn in ipairs(getconnections(desc.MouseButton1Click)) do
                                            conn:Fire()
                                        end
                                    end
                                    tpFound = true
                                    return
                                end
                            end
                        end
                    end
                end
            end
        end
    end)
    
    if not tpFound then
        local LocalPlayer = game:GetService("Players").LocalPlayer
        local hrp2 = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if hrp2 then hrp2.Anchored = true end
        
        local Bridge = game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("Bridge")
        pcall(function() Bridge:FireServer("General", "Portal", "Teleport", targetModuleOrName) end)
        
        task.delay(4, function()
            if hrp2 then hrp2.Anchored = false end
        end)
    end
end

local function TeleportToSelectedMonster()
    pcall(function()
        local targetMap = _G.SelectedQuestKey or ""
        local cleanName = string.gsub(targetMap, " ", "")
        local mapFolder = workspace:FindFirstChild(cleanName) or (workspace:FindFirstChild("Server") and workspace.Server:FindFirstChild(cleanName))
        if mapFolder then
            local mFolder = mapFolder:FindFirstChild("Monsters") or mapFolder:FindFirstChild("Enemies") or mapFolder
            for _, v in ipairs(mFolder:GetDescendants()) do
                if string.find(string.lower(v.Name), string.lower(_G.SelectedMonster or "")) then
                    local mHrp = (v:IsA("Model") and v:FindFirstChild("HumanoidRootPart")) or (v:IsA("BasePart") and v)
                    local playerHrp = game:GetService("Players").LocalPlayer.Character and game:GetService("Players").LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                    if mHrp and playerHrp then
                        playerHrp.CFrame = mHrp.CFrame + Vector3.new(0, 5, 0)
                        break
                    end
                end
            end
        end
    end)
end

