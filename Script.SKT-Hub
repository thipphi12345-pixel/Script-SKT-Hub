local RarityOptions = {"Common", "Uncommon", "Rare", "Epic", "Legendary", "Mythical", "Secret", "Exclusive"}

Tab_OpenStar:CreateDropdown({
    Name = "Select Rarities to Auto Lock",
    Options = RarityOptions,
    CurrentOption = {},
    MultipleOptions = true,
    Flag = "Dropdown_AutoLock",
    Callback = function(Options)
        _G.SelectedAutoLock = Options
    end,
})

Tab_OpenStar:CreateToggle({
    Name = "Enable Auto Lock",
    CurrentValue = false,
    Flag = "Toggle_AutoLockFighters",
    Callback = function(Value)
        _G.AutoLockFighters = Value
        local Bridge = game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("Bridge")
        
        if _G.AutoLockFighters then
            task.spawn(function()
                while _G.AutoLockFighters do
                    task.wait(5)
                    pcall(function()
                        local ps = LocalPlayer:FindFirstChild("PlayerScripts")
                        if ps and ps:FindFirstChild("Scripts") and ps.Scripts:FindFirstChild("Client") and ps.Scripts.Client:FindFirstChild("Main") then
                            local Main = require(ps.Scripts.Client.Main)
                            if Main and Main.Data and Main.Shared then
                                local fightersData = Main.Data.Fighters or {}
                                local sharedFighters = Main.Shared.Fighters or {}
                                
                                local toLock = {}
                                local lockRarities = {}
                                if _G.SelectedAutoLock then
                                    for k, v in pairs(_G.SelectedAutoLock) do
                                        if type(k) == "number" then 
                                            lockRarities[v] = true
                                        elseif type(k) == "string" and v == true then 
                                            lockRarities[k] = true 
                                        end
                                    end
                                end
                                
                                for uuid, fData in pairs(fightersData) do
                                    local sData = sharedFighters[fData.Name]
                                    if sData then
                                        local rarity = sData.Rarity
                                        local isLocked = fData.Locked
                                        local isShiny = fData.Shiny or fData:GetAttribute("Shiny") or false
                                        
                                        -- ให้ล็อคตัว Shiny อัตโนมัติ หรือล็อคตาม Rarity
                                        if (lockRarities[rarity] or isShiny) and not isLocked then
                                            table.insert(toLock, uuid)
                                        end
                                    end
                                end
                                
                                if #toLock > 0 then
                                    for _, uuid in ipairs(toLock) do
                                        Bridge:FireServer("Fighters", "Inventory", "Lock", uuid)
                                        task.wait(0.1)
                                    end
                                end
                            end
                        end
                    end)
                end
            end)
        end
    end,
})

Tab_OpenStar:CreateDropdown({
    Name = "Select Rarities to Auto Sell/Delete",
    Options = RarityOptions,
    CurrentOption = {},
    MultipleOptions = true,
    Flag = "Dropdown_AutoDelete",
    Callback = function(Options)
        _G.SelectedAutoDelete = Options
    end,
})

Tab_OpenStar:CreateToggle({
    Name = "Enable Auto Sell/Delete",
    CurrentValue = false,
    Flag = "Toggle_AutoDeleteFighters",
    Callback = function(Value)
        _G.AutoDeleteFighters = Value
        local Bridge = game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("Bridge")
        
        if _G.AutoDeleteFighters then
            task.spawn(function()
                while _G.AutoDeleteFighters do
                    task.wait(5)
                    pcall(function()
                        local ps = LocalPlayer:FindFirstChild("PlayerScripts")
                        if ps and ps:FindFirstChild("Scripts") and ps.Scripts:FindFirstChild("Client") and ps.Scripts.Client:FindFirstChild("Main") then
                            local Main = require(ps.Scripts.Client.Main)
                            if Main and Main.Data and Main.Shared then
                                local fightersData = Main.Data.Fighters or {}
                                local sharedFighters = Main.Shared.Fighters or {}
                                
                                local toDelete = {}
                                local deleteRarities = {}
                                if _G.SelectedAutoDelete then
                                    for k, v in pairs(_G.SelectedAutoDelete) do
                                        if type(k) == "number" then 
                                            deleteRarities[v] = true
                                        elseif type(k) == "string" and v == true then 
                                            deleteRarities[k] = true 
                                        end
                                    end
                                end
                                
                                -- Get locked rarities to prevent selling what we should lock
                                local lockRarities = {}
                                if _G.SelectedAutoLock then
                                    for k, v in pairs(_G.SelectedAutoLock) do
                                        if type(k) == "number" then 
                                            lockRarities[v] = true
                                        elseif type(k) == "string" and v == true then 
                                            lockRarities[k] = true 
                                        end
                                    end
                                end
                                
                                for uuid, fData in pairs(fightersData) do
                                    local sData = sharedFighters[fData.Name]
                                    if sData then
                                        local rarity = sData.Rarity
                                        local isLocked = fData.Locked
                                        local isEquipped = Main.Data.Fighters_Equipped and Main.Data.Fighters_Equipped[uuid]
                                        local isShiny = fData.Shiny or fData:GetAttribute("Shiny") or false
                                        
                                        -- ป้องกันการขายตัวที่อยู่ในคิวล็อก ตัวที่สมควรถูกล็อก และตัว Shiny (หายาก)
                                        if deleteRarities[rarity] and not isLocked and not isEquipped and not isShiny then
                                            if not lockRarities[rarity] then
                                                table.insert(toDelete, uuid)
                                            end
                                        end
                                    end
                                end
                                
                                if #toDelete > 0 then
                                    Bridge:FireServer("Fighters", "Inventory", "Delete", toDelete)
                                end
                            end
                        end
                    end)
                end
            end)
        end
    end,
})

