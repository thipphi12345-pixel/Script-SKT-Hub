local SKT_UI = {}
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local CoreGui = game:GetService("CoreGui") or game:GetService("Players").LocalPlayer:WaitForChild("PlayerGui")

local UI_Config = {
    MainColor = Color3.fromRGB(15, 15, 22),
    SidebarColor = Color3.fromRGB(10, 10, 15),
    CardColor = Color3.fromRGB(20, 20, 28),
    AccentColor = Color3.fromRGB(0, 255, 255), -- Sci-Fi Cyan Theme
    TextColor = Color3.fromRGB(255, 255, 255),
    DimTextColor = Color3.fromRGB(150, 150, 160),
    Font = Enum.Font.GothamMedium,
    LogoID = "rbxassetid://136267911004509",
}

local function CreateCorner(parent, radius)
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, radius or 6)
    corner.Parent = parent
    return corner
end

local function CreateStroke(parent, color, thickness)
    local stroke = Instance.new("UIStroke")
    stroke.Color = color
    stroke.Thickness = thickness or 1
    stroke.Parent = parent
    return stroke
end

local HttpService = game:GetService("HttpService")

local ConfigManager = {
    FolderName = "AnimeDuelistsHub",
    FileName = "SaveConfig.json",
    Config = {}
}

function ConfigManager:Init()
    pcall(function()
        if not isfolder(self.FolderName) then
            makefolder(self.FolderName)
        end
        if isfile(self.FolderName .. "/" .. self.FileName) then
            local data = readfile(self.FolderName .. "/" .. self.FileName)
            self.Config = HttpService:JSONDecode(data) or {}
        end
    end)
end

function ConfigManager:Save()
    pcall(function()
        if not isfolder(self.FolderName) then
            makefolder(self.FolderName)
        end
        writefile(self.FolderName .. "/" .. self.FileName, HttpService:JSONEncode(self.Config))
    end)
end

ConfigManager:Init()

function SKT_UI:CreateWindow(options)
    local Window = {}
    local Title = options.Name or "SKT Hub"
    
    if CoreGui:FindFirstChild("SKT_Hub_Custom") then
        CoreGui.SKT_Hub_Custom:Destroy()
    end
    
    local SG = Instance.new("ScreenGui")
