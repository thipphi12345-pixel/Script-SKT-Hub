        _G.SelectedBoosts = Options
    end,
})

Tab_Boost:CreateToggle({
    Name = "Auto Use Boost",
    CurrentValue = false,
    Flag = "Toggle_AutoBoosts",
    Callback = function(Value)
        _G.AutoBoosts = Value
        local Bridge = game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("Bridge")
        
        if _G.AutoBoosts then
            task.spawn(function()
                while _G.AutoBoosts do
                    pcall(function()
                        if _G.SelectedBoosts then
                            for k, v in pairs(_G.SelectedBoosts) do
                                local boostName
                                if type(k) == "number" then
                                    boostName = v
                                elseif type(k) == "string" and v == true then
                                    boostName = k
                                end
                                
                                if boostName then
                                    local boostId = BoostIDs[boostName]
                                    if boostId then
                                        -- เน€เธโฌเน€เธยเน€เธยเน€เธยเน€เธเธเน€เธยเน€เธเธ’เน€เธยเน€เธเธ‘เน€เธยเน€เธโ€”เน€เธเธ“เน€เธยเน€เธเธ’เน€เธยเน€เธเธเน€เธเธเน€เธเธเน€เธยเน€เธเธเน€เธเธเน€เธเธ—เน€เธเธเน€เธยเน€เธเธเน€เธยเน€เธยเน€เธเธ’เน€เธย UI เน€เธยเน€เธเธเน€เธยเน€เธโฌเน€เธยเน€เธเธ (เน€เธยเน€เธเธเน€เธยเน€เธยเน€เธเธเน€เธเธ“ 100%)
                                        local isActive = false
                                        pcall(function()
                                            local boostsUI = LocalPlayer.PlayerGui.UI.Frames.Stats.Frame.Boosts.Frame
                                            if boostsUI:FindFirstChild(boostId) then
                                                isActive = true
                                            end
                                        end)
                                        
                                        if not isActive then
                                            -- เน€เธโ€“เน€เธยเน€เธเธ’เน€เธยเน€เธเธ‘เน€เธยเน€เธเธเน€เธเธ‘เน€เธยเน€เธยเน€เธเธเน€เธย Active เน€เธยเน€เธเธเน€เธยเน€เธยเน€เธโ€เน€เธยเน€เธยเน€เธยเน€เธโฌเน€เธเธ…เน€เธเธ! (เน€เธโ€“เน€เธยเน€เธเธ’เน€เธยเน€เธเธเน€เธยเน€เธเธเน€เธเธ•เน€เธยเน€เธเธเน€เธยเน€เธยเน€เธยเน€เธโ€ขเน€เธเธ‘เน€เธเธ เน€เธโฌเน€เธยเน€เธเธ”เน€เธเธเน€เธยเน€เธยเน€เธโฌเน€เธเธเน€เธเธเน€เธเธเน€เธยเน€เธยเน€เธเธเน€เธยเน€เธเธ…เน€เธยเน€เธเธเน€เธยเน€เธโฌเน€เธเธเน€เธย)
                                            Bridge:FireServer("General", "Inventory", "UseBoost", boostId)
                                            task.wait(1) -- เน€เธเธเน€เธเธ 1 เน€เธเธเน€เธเธ”เน€เธยเน€เธเธ’เน€เธโ€”เน€เธเธ•เน€เธยเน€เธเธเน€เธย UI เน€เธเธเน€เธเธ‘เน€เธยเน€เธโฌเน€เธโ€เน€เธโ€ขเน€เธยเน€เธยเน€เธเธเน€เธยเน€เธโฌเน€เธยเน€เธยเน€เธยเน€เธโ€ขเน€เธเธ‘เน€เธเธเน€เธโ€“เน€เธเธ‘เน€เธโ€เน€เธยเน€เธย
                                        end
                                    end
                                end
                            end
                        end
                    end)
                    task.wait(3) -- เน€เธโฌเน€เธยเน€เธยเน€เธยเน€เธยเน€เธยเน€เธเธ“เน€เธโ€”เน€เธเธเน€เธยเน€เธย 3 เน€เธเธเน€เธเธ”เน€เธยเน€เธเธ’เน€เธโ€”เน€เธเธ•
                end
            end)
        end
    end,
})


