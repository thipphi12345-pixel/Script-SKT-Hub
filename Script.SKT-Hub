})

Tab_OpenStar:CreateToggle({
    Name = "Enable Auto Ascend",
    CurrentValue = false,
    Flag = "Toggle_AutoAscend",
    Callback = function(Value)
        _G.AutoAscend = Value
        local Bridge = game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("Bridge")
        task.spawn(function()
            while _G.AutoAscend do
                task.wait(5)
                pcall(function()
                    local ps = LocalPlayer:FindFirstChild("PlayerScripts")
                    if ps then
                        local Main = require(ps.Scripts.Client.Main)
                        local fightersData = Main.Data.Fighters or {}
                        local sharedFighters = Main.Shared.Fighters or {}
                        local ascendRarities = {}
                        if _G.SelectedAutoAscend then
                            for k, v in pairs(_G.SelectedAutoAscend) do
                                if type(k) == "number" then ascendRarities[v] = true
                                elseif type(k) == "string" and v == true then ascendRarities[k] = true end
                            end
                        end
                        for uuid, fData in pairs(fightersData) do
                            local sData = sharedFighters[fData.Name]
                            if sData and ascendRarities[sData.Rarity] then
                                Bridge:FireServer("Fighters", "Inventory", "Ascend", uuid)
                                task.wait(0.2)
                            end
                        end
                    end
                end)
            end
        end)
    end,
})
