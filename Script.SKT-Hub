local Section_Ascend = Tab_OpenStar:CreateSection("Ascend Fighter")
Tab_OpenStar:CreateToggle({
    Name = "Enable Auto Ascend (Equipped Only)",
    CurrentValue = false,
    Flag = "Toggle_AutoAscend",
    Callback = function(Value)
        _G.AutoAscend = Value
        local Bridge = game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("Bridge")
        task.spawn(function()
            while _G.AutoAscend do
                task.wait(3)
                pcall(function()
                    local ps = game:GetService("Players").LocalPlayer:FindFirstChild("PlayerScripts")
                    if ps then
                        local Main = require(ps.Scripts.Client.Main)
                        if Main.Data and Main.Data.Fighters_Equipped then
                            for uuid, _ in pairs(Main.Data.Fighters_Equipped) do
                                Bridge:FireServer("Fighters", "Inventory", "Ascend", uuid)
                            end
                        end
                    end
                end)
            end
        end)
