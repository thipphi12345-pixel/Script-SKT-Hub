Tab_Trial:CreateToggle({
    Name = "Auto Buy Trial Merchant",
    CurrentValue = false,
    Flag = "Toggle_AutoTrialMerchant",
    Callback = function(Value)
        _G.AutoTrialMerchant = Value
        local Bridge = game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("Bridge")
        
        if _G.AutoTrialMerchant then
            task.spawn(function()
                while _G.AutoTrialMerchant do
                    pcall(function()
                        if _G.SelectedTrialMerchantItems then
                            for k, v in pairs(_G.SelectedTrialMerchantItems) do
                                local itemName
                                if type(k) == "number" then
                                    itemName = v
                                elseif type(k) == "string" and v == true then
                                    itemName = k
                                end
                                
                                if itemName and TrialMerchantMapping[itemName] then
                                    Bridge:FireServer("General", "TrialMerchant", "Buy", TrialMerchantMapping[itemName])
                                    task.wait(0.05) -- เน€เธยเน€เธเธเน€เธเธ‘เน€เธยเน€เธยเน€เธเธเน€เธยเน€เธยเน€เธเธ—เน€เธยเน€เธเธเน€เธยเน€เธเธเน€เธยเน€เธเธ–เน€เธยเน€เธยเน€เธเธเน€เธเธ’เน€เธยเน€เธย (20 เน€เธยเน€เธเธ”เน€เธยเน€เธยเน€เธโ€ขเน€เธยเน€เธเธเน€เธเธเน€เธเธ”เน€เธยเน€เธเธ’เน€เธโ€”เน€เธเธ•)
                                end
                            end
                        end
                    end)
                    task.wait(1) -- เน€เธโฌเน€เธยเน€เธยเน€เธยเน€เธยเน€เธเธ—เน€เธยเน€เธเธเน€เธโ€”เน€เธเธเน€เธยเน€เธย 1 เน€เธเธเน€เธเธ”เน€เธยเน€เธเธ’เน€เธโ€”เน€เธเธ• (เน€เธโฌเน€เธเธเน€เธยเน€เธเธเน€เธยเน€เธเธ–เน€เธยเน€เธย 5 เน€เธโฌเน€เธโ€”เน€เธยเน€เธเธ’)
                end
            end)
        end
    end,
})



Tab_Misc:CreateToggle({
    Name = "Auto Claim Battlepass",
    CurrentValue = false,
    Flag = "Toggle_Battlepass",
    Callback = function(Value)
        _G.AutoBattlepass = Value
        local Bridge = game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("Bridge")
        task.spawn(function()
            while _G.AutoBattlepass do
                task.wait(10)
                pcall(function()
                    -- เน€เธเธเน€เธเธ”เน€เธย Claim All 
                    Bridge:FireServer("General", "Battlepass", "ClaimAll")
                    Bridge:FireServer("Rewards", "Battlepass", "ClaimAll")
                    
                    for i = 1, 100 do
                        Bridge:FireServer("General", "Battlepass", "Claim", i)
                        Bridge:FireServer("General", "Battlepass", "Claim", tostring(i))
                        Bridge:FireServer("Rewards", "Battlepass", "Claim", i)
                        
                        -- Move Awards claims into Battlepass logic
                        Bridge:FireServer("General", "Awards", "Claim", i)
                        Bridge:FireServer("General", "Awards", "Claim", tostring(i))
                        Bridge:FireServer("General", "Awards", "Claim", "Award_"..i)
                        Bridge:FireServer("Rewards", "Awards", "Claim", i)
                        
                        task.wait(0.05)
                    end
                    
                    for i = 1, 30 do
                        Bridge:FireServer("General", "DailyRewards", "Claim", i)
                        Bridge:FireServer("Rewards", "DailyRewards", "Claim", i)
                    end
                    
                    -- Fallback UI Clicker for Battlepass
                    if LocalPlayer and LocalPlayer:FindFirstChild("PlayerGui") then
                        for _, obj in ipairs(LocalPlayer.PlayerGui:GetDescendants()) do
                            if obj:IsA("TextButton") or obj:IsA("ImageButton") then
                                local txt = obj:IsA("TextButton") and string.lower(obj.Text) or ""
                                local name = string.lower(obj.Name)
                                if string.find(name, "claim") or string.find(txt, "claim") then
                                    local parent = obj.Parent
                                    local inBp = false
                                    for i=1, 6 do
                                        if parent and parent:IsA("GuiObject") then
                                            if string.find(string.lower(parent.Name), "battlepass") or string.find(string.lower(parent.Name), "pass") then 
                                                inBp = true 
                                                break 
                                            end
                                            parent = parent.Parent
                                        end
                                    end
                                    if inBp and getconnections then
                                        for _, conn in ipairs(getconnections(obj.MouseButton1Click)) do conn:Fire() end
                                    end
                                end
                            end
                        end
                    end
                end)
            end
        end)
    end,
})

Tab_Misc:CreateToggle({
    Name = "Auto Claim Free Gifts & Playtime",
    CurrentValue = false,
    Flag = "Toggle_AutoFreeGifts",
    Callback = function(Value)
        _G.AutoFreeGifts = Value
        local Bridge = game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("Bridge")
        if _G.AutoFreeGifts then
            task.spawn(function()
                while _G.AutoFreeGifts do
                    pcall(function()
                        Bridge:FireServer("General", "PlaytimeRewards", "ClaimAll")
                        for i = 1, 15 do
                            Bridge:FireServer("General", "PlaytimeRewards", "Claim", i)
                            Bridge:FireServer("Rewards", "PlaytimeRewards", "Claim", i)
                            Bridge:FireServer("General", "FreeGifts", "Claim", i)
                            Bridge:FireServer("Rewards", "FreeGifts", "Claim", i)
                        end
                    end)
                    task.wait(15)
                end
            end)
        end
    end,
})

Tab_Misc:CreateToggle({
    Name = "Auto Claim Achievements & Quests",
    CurrentValue = false,
    Flag = "Toggle_AutoAchievements",
    Callback = function(Value)
        _G.AutoAchievements = Value
        local Bridge = game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("Bridge")
        if _G.AutoAchievements then
            task.spawn(function()
                while _G.AutoAchievements do
                    pcall(function()
                        Bridge:FireServer("General", "Achievements", "ClaimAll")
                        for i = 1, 50 do
                            Bridge:FireServer("General", "Achievements", "Claim", i)
                            Bridge:FireServer("General", "Achievements", "Claim", tostring(i))
                            Bridge:FireServer("General", "Quests", "Claim", i)
                        end
                    end)
                    task.wait(20)
                end
            end)
        end
    end,
})

-- ==========================================
-- เนยโ€ย INFO TAB
-- ==========================================
local Tab_Info = Window:CreateTab("Info")
local Section_Info = Tab_Info:CreateSection("Player Info")

local function createGradient(c1, c2)
    return ColorSequence.new({
        ColorSequenceKeypoint.new(0, c1),
        ColorSequenceKeypoint.new(1, c2)
    })
end

local Lbl_Username = Tab_Info:CreateLabel({Name = "👤 Username: " .. game:GetService("Players").LocalPlayer.Name, Gradient = createGradient(Color3.fromRGB(0, 255, 255), Color3.fromRGB(0, 100, 255))})
local Lbl_Level = Tab_Info:CreateLabel({Name = "⭐ Level: ???", Gradient = createGradient(Color3.fromRGB(255, 215, 0), Color3.fromRGB(255, 140, 0))})
local Lbl_Coins = Tab_Info:CreateLabel({Name = "💰 Coins: ???", Gradient = createGradient(Color3.fromRGB(255, 255, 0), Color3.fromRGB(200, 200, 0))})
local Lbl_Gems = Tab_Info:CreateLabel({Name = "💎 Gems: ???", Gradient = createGradient(Color3.fromRGB(0, 255, 255), Color3.fromRGB(255, 0, 255))})
local Lbl_TraitRerolls = Tab_Info:CreateLabel({Name = "🎲 Trait Rerolls: ???", Gradient = createGradient(Color3.fromRGB(50, 255, 50), Color3.fromRGB(0, 150, 0))})
local Lbl_StarOpen = Tab_Info:CreateLabel({Name = "🌟 Stars Opened: ???", Gradient = createGradient(Color3.fromRGB(255, 105, 180), Color3.fromRGB(255, 20, 147))})
local Lbl_Playtime = Tab_Info:CreateLabel({Name = "⏱ Playtime: ???", Gradient = createGradient(Color3.fromRGB(135, 206, 235), Color3.fromRGB(70, 130, 180))})
local Lbl_Strength = Tab_Info:CreateLabel({Name = "⚔ Strength: ???", Gradient = createGradient(Color3.fromRGB(255, 69, 0), Color3.fromRGB(139, 0, 0))})

-- Auto Refresh Info Loop
task.spawn(function()
    while task.wait(0.5) do -- เน€เธเธเน€เธเธ‘เน€เธยเน€เธโฌเน€เธโ€เน€เธโ€”เน€เธยเน€เธเธเน€เธยเน€เธเธ–เน€เธยเน€เธยเน€เธโฌเน€เธยเน€เธยเน€เธยเน€เธโ€”เน€เธเธเน€เธยเน€เธย 0.5 เน€เธเธเน€เธเธ”เน€เธยเน€เธเธ’เน€เธโ€”เน€เธเธ• (Realtime)
        pcall(function()
            local lp = game:GetService("Players").LocalPlayer
            local ls = lp:FindFirstChild("leaderstats")
            
            local function getStat(names)
                -- 1. เน€เธเธเน€เธเธ’เน€เธยเน€เธเธ’เน€เธย leaderstats
                if ls then
                    for _, child in ipairs(ls:GetChildren()) do
                        local cName = string.lower(child.Name)
                        for _, n in ipairs(names) do
                            if string.find(cName, n) then return child.Value end
                        end
                    end
                end
                -- 2. เน€เธเธเน€เธเธ’เน€เธยเน€เธเธ’เน€เธย Attributes
                for attr, val in pairs(lp:GetAttributes()) do
                    local aName = string.lower(attr)
                    for _, n in ipairs(names) do
                        if string.find(aName, n) then return val end
                    end
                end
                return 0
            end

            local level = getStat({"level", "lvl"})
            local coins = getStat({"coin", "yen", "money", "cash"})
            local gems = getStat({"gem", "diamond", "crystal"})
            local trait = getStat({"trait", "reroll"})
            local stars = getStat({"star", "open"})
            local playtime = getStat({"time", "play"})
            local strength = getStat({"strength", "power"})

            -- Fallback เน€เธเธเน€เธเธ’เน€เธยเน€เธเธ’เน€เธย Main.Data เน€เธโ€“เน€เธยเน€เธเธ’เน€เธเธเน€เธเธ‘เน€เธยเน€เธโฌเน€เธยเน€เธยเน€เธย 0
            pcall(function()
                local ps = lp:FindFirstChild("PlayerScripts")
                if ps then
                    local mainMod = ps:FindFirstChild("Client") and ps.Client:FindFirstChild("Main")
                    if mainMod then
                        local Main = require(mainMod)
                        if Main and Main.Data then
                            if level == 0 then level = Main.Data.Level or 0 end
                            if coins == 0 then coins = Main.Data.Coins or Main.Data.Yen or 0 end
                            if gems == 0 then gems = Main.Data.Gems or Main.Data.Diamonds or 0 end
                            if trait == 0 then trait = Main.Data.TraitRerolls or Main.Data.Rerolls or 0 end
                            if stars == 0 then stars = Main.Data.StarsOpened or Main.Data.StarOpen or Main.Data.TotalStars or Main.Data.Stars or 0 end
                            if playtime == 0 then playtime = Main.Data.Playtime or Main.Data.TimePlayed or 0 end
                            if strength == 0 then strength = Main.Data.Strength or Main.Data.Power or 0 end
                        end
                    end
                end
            end)

            -- Fallback เน€เธเธเน€เธเธ’ Strength เน€เธยเน€เธเธ’เน€เธย Damage Package
            if strength == 0 then
                pcall(function()
                    local Damage = require(game:GetService("ReplicatedStorage"):WaitForChild("Packages"):WaitForChild("Damage"))
                    local pStrength = Damage:GetPlayerStrength(lp)
                    if pStrength then strength = pStrength end
                end)
            end

            local function formatNum(n)
                if type(n) ~= "number" then return tostring(n) end
                if n >= 1e9 then return string.format("%.2fB", n/1e9)
                elseif n >= 1e6 then return string.format("%.2fM", n/1e6)
                elseif n >= 1e3 then return string.format("%.2fK", n/1e3)
                else return tostring(math.floor(n)) end
            end
            
            local function formatTime(s)
                if type(s) ~= "number" then return tostring(s) end
                local h = math.floor(s / 3600)
                local m = math.floor((s % 3600) / 60)
                local sec = math.floor(s % 60)
                if h > 0 then return string.format("%dh %dm %ds", h, m, sec)
                else return string.format("%dm %ds", m, sec) end
            end
            
            Lbl_Username:Set("👤 Username: " .. lp.Name)
            Lbl_Level:Set("⭐ Level: " .. formatNum(level))
            Lbl_Coins:Set("💰 Coins: " .. formatNum(coins))
            Lbl_Gems:Set("💎 Gems: " .. formatNum(gems))
            Lbl_TraitRerolls:Set("🎲 Trait Rerolls: " .. formatNum(trait))
            Lbl_StarOpen:Set("🌟 Stars Opened: " .. formatNum(stars))
            Lbl_Playtime:Set("⏱ Playtime: " .. formatTime(playtime))
            Lbl_Strength:Set("⚔ Strength: " .. formatNum(strength))
        end)
    end
end)

-- ==========================================
-- เนยยเนเธย SETTINGS TAB
-- ==========================================
local Tab_Settings = Window:CreateTab("Settings")
local Section_Settings = Tab_Settings:CreateSection("UI Settings")

Tab_Settings:CreateDropdown({
    Name = "Theme Color",
    Options = {"Sci-Fi Cyan", "Neon Green", "Cyber Purple", "Ruby Red", "Solar Yellow", "Pure White"},
    CurrentOption = {"Sci-Fi Cyan"},
    MultipleOptions = false,
    Flag = "Dropdown_ThemeColor",
    Callback = function(Value)
        local color = Color3.fromRGB(0, 255, 255)
        local opt = type(Value) == "table" and Value[1] or Value
        if opt == "Sci-Fi Cyan" then color = Color3.fromRGB(0, 255, 255)
        elseif opt == "Neon Green" then color = Color3.fromRGB(57, 255, 20)
        elseif opt == "Cyber Purple" then color = Color3.fromRGB(191, 0, 255)
        elseif opt == "Ruby Red" then color = Color3.fromRGB(255, 36, 0)
        elseif opt == "Solar Yellow" then color = Color3.fromRGB(255, 204, 0)
        elseif opt == "Pure White" then color = Color3.fromRGB(255, 255, 255)
        end
        
        UI_Config.AccentColor = color
        
        pcall(function()
            local sg = game:GetService("CoreGui"):FindFirstChild("SKT_Hub_Custom") or (LocalPlayer and LocalPlayer:FindFirstChild("PlayerGui") and LocalPlayer.PlayerGui:FindFirstChild("SKT_Hub_Custom"))
            if sg then
                local mainFrame = sg:FindFirstChild("MainFrame")
                if mainFrame then
                    local stroke = mainFrame:FindFirstChildOfClass("UIStroke")
                    if stroke then stroke.Color = color end
                end
                
                for _, obj in ipairs(sg:GetDescendants()) do
                    if obj.Name == "HeaderText" or obj.Name == "ResizeBtn" or obj.Name == "LogoText" then
                        obj.TextColor3 = color
                    elseif obj:IsA("TextLabel") and string.sub(obj.Text, 1, 3) == ">> " then
                        obj.TextColor3 = color
                    end
                end
                
                local miniBtn = sg:FindFirstChild("MiniBtn")
                if miniBtn then
                    local mstroke = miniBtn:FindFirstChildOfClass("UIStroke")
                    if mstroke then mstroke.Color = color end
                end
            end
            
            if Tabs then
                for _, t in ipairs(Tabs) do
                    if t.Indicator then t.Indicator.BackgroundColor3 = color end
                    if t.Content and t.Content.Visible and t.Btn then
                        t.Btn.TextColor3 = color
                    end
                end
            end
        end)
    end
})

Tab_Settings:CreateSlider({
    Name = "UI Transparency",
    Range = {0, 100},
    Increment = 5,
    Suffix = "%",
    CurrentValue = 15,
    Flag = "Slider_UITransparency",
    Callback = function(Value)
        pcall(function()
            local sg = game:GetService("CoreGui"):FindFirstChild("SKT_Hub_Custom") or (LocalPlayer and LocalPlayer:FindFirstChild("PlayerGui") and LocalPlayer.PlayerGui:FindFirstChild("SKT_Hub_Custom"))
            if sg then
                local mainFrame = sg:FindFirstChild("MainFrame")
                if mainFrame then
                    mainFrame.BackgroundTransparency = Value / 100
                    local sidebar = mainFrame:FindFirstChild("Sidebar")
                    if sidebar then
                        sidebar.BackgroundTransparency = math.min(1, (Value / 100) + 0.05)
                    end
                end
            end
        end)
    end,
})

Tab_Settings:CreateSlider({
    Name = "UI Border Thickness",
    Range = {0, 5},
    Increment = 1,
    Suffix = " px",
    CurrentValue = 1,
    Flag = "Slider_UIBorder",
    Callback = function(Value)
        pcall(function()
            local sg = game:GetService("CoreGui"):FindFirstChild("SKT_Hub_Custom") or (LocalPlayer and LocalPlayer:FindFirstChild("PlayerGui") and LocalPlayer.PlayerGui:FindFirstChild("SKT_Hub_Custom"))
            if sg then
                local mainFrame = sg:FindFirstChild("MainFrame")
                if mainFrame then
                    local stroke = mainFrame:FindFirstChildOfClass("UIStroke")
                    if stroke then stroke.Thickness = Value end
                end
            end
        end)
    end,
})
