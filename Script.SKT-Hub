-- เน€เธโ€เน€เธเธ–เน€เธยเน€เธเธเน€เธเธ’เน€เธเธเน€เธยเน€เธเธ—เน€เธยเน€เธเธเน€เธโ€เน€เธยเน€เธเธ’เน€เธยเน€เธโ€”เน€เธเธ‘เน€เธยเน€เธยเน€เธเธเน€เธเธเน€เธโ€เน€เธเธเน€เธเธ’เน€เธยเน€เธเธเน€เธยเน€เธยเน€เธเธเน€เธยเน€เธโฌเน€เธเธ…เน€เธเธ—เน€เธเธเน€เธยเน€เธเธเน€เธเธเน€เธยเน€เธเธเน€เธโ€เน€เธเธ’เน€เธเธ
local StarMapList = {}
for mapName, _ in pairs(QuestData) do
    table.insert(StarMapList, mapName)
end

Tab_OpenStar:CreateDropdown({
    Name = "Select Star Map",
    Options = StarMapList,
    CurrentOption = {"Pirate Island"},
    MultipleOptions = false,
    Flag = "Dropdown_StarMap",
    Callback = function(Option)
        _G.SelectedStarMap = type(Option) == "table" and Option[1] or Option
        
        -- เน€เธโ€“เน€เธยเน€เธเธ’เน€เธยเน€เธเธเน€เธยเน€เธยเน€เธโ€เน€เธยเน€เธเธ…เน€เธย Trial เน€เธยเน€เธเธ…เน€เธเธเน€เธยเน€เธเธเน€เธยเน€เธยเน€เธโ€เน€เธยเน€เธเธ…เน€เธย Raid เน€เธยเน€เธเธเน€เธยเน€เธเธเน€เธเธ’เน€เธเธเน€เธยเน€เธยเน€เธยเน€เธยเน€เธโ€เน€เธยเน€เธเธ’เน€เธยเน€เธเธเน€เธเธเน€เธยเน€เธเธเน€เธยเน€เธยเน€เธยเน€เธโ€”เน€เธเธ•เน€เธยเน€เธโฌเน€เธเธ…เน€เธเธ—เน€เธเธเน€เธยเน€เธโ€”เน€เธเธ‘เน€เธยเน€เธโ€”เน€เธเธ•
        task.spawn(function()
            local inRaidMode = false
            pcall(function()
                local ps = game:GetService("Players").LocalPlayer:FindFirstChild("PlayerScripts")
                if ps then
                    local Main = require(ps.Scripts.Client.Main)
                    local mode = Main.Player:GetAttribute("Mode")
                    if mode and string.find(string.lower(mode), "towerraid") then
                        inRaidMode = true
                    end
                end
            end)
            
            local inTrial = (_G.IsTrialActive == true)
            
            if not inRaidMode and not inTrial then
                local mapKey = _G.SelectedStarMap or "Pirate Island"
                local qData = QuestData[mapKey]
                if qData and qData.Module then
                    local Bridge = game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("Bridge")
                    pcall(function()
                        -- เน€เธเธเน€เธเธเน€เธเธเน€เธโ€เน€เธเธเน€เธเธเน€เธยเน€เธเธเน€เธยเน€เธยเน€เธเธเน€เธยเน€เธเธเน€เธเธ’เน€เธย
                        Bridge:FireServer("General", "Star", "Auto", false)
                        task.wait(0.5)
                        
                        SafeUITeleport(qData.Module)
                        task.wait(2)
                        
                        -- เน€เธโฌเน€เธเธเน€เธเธ”เน€เธยเน€เธเธเน€เธเธเน€เธเธเน€เธยเน€เธเธเน€เธยเน€เธเธเน€เธเธเน€เธย (เน€เธโ€“เน€เธยเน€เธเธ’เน€เธยเน€เธเธเน€เธยเน€เธเธ Auto เน€เธโฌเน€เธยเน€เธเธ”เน€เธโ€เน€เธเธเน€เธเธเน€เธเธเน€เธย)
                        if _G.FastAutoStar then
                            Bridge:FireServer("General", "Star", "Auto", true)
                        end
                    end)
                end
            end
        end)
    end,
})

Tab_OpenStar:CreateToggle({
