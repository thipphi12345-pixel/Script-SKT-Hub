-- ==========================================
-- ⚙️ TOWER RAID TAB
-- ==========================================
local Section_TowerRaid = Tab_Raid:CreateSection("Tower Raid Settings")

Tab_Raid:CreateSlider({
    Name = "Leave at Wave (Tower Raid)",
    Range = {1, 100},
    Increment = 1,
    Suffix = "Wave",
    CurrentValue = 15,
    Flag = "Slider_RaidMaxWave",
    Callback = function(Value)
        _G.RaidMaxWave = Value
    end,
})

Tab_Raid:CreateToggle({
    Name = "Auto Leave at Max Wave",
    CurrentValue = false,
    Flag = "Toggle_AutoLeaveRaid",
    Callback = function(Value)
        _G.AutoLeaveRaid = Value
    end,
})

Tab_Raid:CreateToggle({
    Name = "Auto Farm Tower Raid",
    CurrentValue = false,
    Flag = "Toggle_AutoTowerRaid",
    Callback = function(Value)
        _G.AutoTowerRaid = Value
        local Bridge = game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("Bridge")
        
        task.spawn(function()
            while _G.AutoTowerRaid do
                task.wait(1)
                
                -- Priority System: ถ้า Trial เปิดและถึงเวลาแล้ว ให้หยุด Raid
                if _G.AutoTrial and _G.IsTrialActive then
                    continue 
                end
                local inRaidMode = false
                pcall(function()
                    local mode = game:GetService("Players").LocalPlayer:GetAttribute("Mode")
                    if mode and string.find(string.lower(mode), "towerraid") then
                        inRaidMode = true
                    end
                end)
                _G.IsRaidActive = inRaidMode
                
                if not inRaidMode then continue end
                
                local hrp = game:GetService("Players").LocalPlayer.Character and game:GetService("Players").LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                if not hrp then continue end
                
                local currentWave = 1
                pcall(function()
                    local rsMode = game:GetService("ReplicatedStorage"):FindFirstChild("Gamemodes")
                    if rsMode and rsMode:FindFirstChild("TowerRaid") and rsMode.TowerRaid:FindFirstChild("Wave") then
                        currentWave = tonumber(rsMode.TowerRaid.Wave.Value) or currentWave
                    end
                    
                    if currentWave == 1 then
                        local raidUI = game:GetService("Players").LocalPlayer.PlayerGui:FindFirstChild("TowerRaid")
                        if not raidUI then raidUI = game:GetService("Players").LocalPlayer.PlayerGui:FindFirstChild("Trial") end
                        if raidUI and raidUI:FindFirstChild("Frame") and raidUI.Frame:FindFirstChild("Wave") then
                            local w = string.match(raidUI.Frame.Wave.Text, "%d+")
                            if w then currentWave = tonumber(w) end
                        else
                            for _, obj in ipairs(game:GetService("Players").LocalPlayer.PlayerGui:GetDescendants()) do
                                if obj:IsA("TextLabel") and obj.Visible then
                                    local lowerText = string.lower(obj.Text)
                                    -- Check if it contains "wave" but NOT "next wave" or "in" to avoid catching countdown timers
                                    if string.find(lowerText, "wave") and not string.find(lowerText, "next") and not string.find(lowerText, "in") then
                                        -- Match "Wave 5" or "Wave: 5" specifically
                                        local w = string.match(lowerText, "wave%s*:?%s*(%d+)")
                                        if not w then
                                            -- Fallback if format is different but definitely not a timer
                                            w = string.match(obj.Text, "%d+")
                                        end
                                        if w then currentWave = tonumber(w) break end
                                    end
                                end
                            end
                        end
                    end
                end)
                
                if _G.AutoLeaveRaid and _G.RaidMaxWave and currentWave >= _G.RaidMaxWave then
                    pcall(function()
                        local Bridge = game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("Bridge")
                        Bridge:FireServer("Gamemodes", "TowerRaid", "Leave")
                        Bridge:FireServer("Gamemodes", "TowerRaid", "Claim")
                        Bridge:FireServer("Gamemodes", "TowerRaid", "Exit")
                        
                        if game:GetService("Players").LocalPlayer:FindFirstChild("PlayerGui") then
                            for _, obj in ipairs(game:GetService("Players").LocalPlayer.PlayerGui:GetDescendants()) do
                                if obj:IsA("TextButton") and obj.Text ~= "" then
                                    local lowerText = string.lower(obj.Text)
                                    if string.find(lowerText, "leave") or string.find(lowerText, "claim") or string.find(lowerText, "exit") or string.find(lowerText, "continue") then
                                        if getconnections then
                                            for _, conn in ipairs(getconnections(obj.MouseButton1Click)) do
                                                conn:Fire()
                                            end
                                        end
                                    end
                                end
                            end
                        end
                        
                        -- สัมผัสประตู Exit และกด ProximityPrompt ป้องกันบัคไม่ออกจากห้อง
                        local hrp = game:GetService("Players").LocalPlayer.Character and game:GetService("Players").LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                        if hrp then
                            pcall(function()
                                local raidMap = workspace:FindFirstChild("Server") and workspace.Server:FindFirstChild("TowerRaid")
                                if raidMap then
                                    for _, v in ipairs(raidMap:GetDescendants()) do
                                        if v:IsA("ProximityPrompt") or string.match(string.lower(v.Name), "exit") or string.match(string.lower(v.Name), "leave") then
                                            local target = v:IsA("ProximityPrompt") and v.Parent or v
                                            if target and (target:IsA("BasePart") or target:IsA("Model")) then
                                                hrp.CFrame = target:IsA("Model") and target:GetPivot() or target.CFrame
                                                task.wait(0.5)
                                                if v:IsA("ProximityPrompt") and fireproximityprompt then
                                                    fireproximityprompt(v)
                                                end
                                                break
                                            end
                                        end
                                    end
                                end
                            end)
                        end
                        
                    end)
                    task.wait(3)
                    
                    -- Teleport back to selected map before creating a new one
                    if _G.SelectMap and _G.SelectMap ~= "" then
                        pcall(function()
                            SafeUITeleport(_G.SelectMap)
                        end)
                        task.wait(2.5)
                    end
                    
                    continue
                end
                
                local targetEnemy = nil
                local shortestDistance = math.huge
                
                local towerMonsters = {"Haribol", "Coyoti", "Yhwache", "Grimmjew", "Ichegi"}
                if QuestData and QuestData["Tower City"] and QuestData["Tower City"].Monsters then
                    towerMonsters = QuestData["Tower City"].Monsters
                end
                local targetHRP = nil
                
                for _, obj in ipairs(workspace:GetDescendants()) do
                    if table.find(towerMonsters, obj.Name) then
                        local eHRP = (obj:IsA("Model") and obj:FindFirstChild("HumanoidRootPart")) or (obj:IsA("BasePart") and obj)
                        
                        if eHRP then
                            local isAlive = true
                            if obj:FindFirstChild("Humanoid") and obj.Humanoid.Health <= 0 then isAlive = false end
                            if obj:GetAttribute("Health") ~= nil and obj:GetAttribute("Health") <= 0 then isAlive = false end
                            if obj:GetAttribute("Dead") == true or obj:GetAttribute("Died") == true or obj:GetAttribute("IsDead") == true then isAlive = false end
                            if obj:IsA("Model") and obj:FindFirstChild("Humanoid") and obj.Humanoid:GetState() == Enum.HumanoidStateType.Dead then isAlive = false end
                            
                            if isAlive then
                                local dist = (hrp.Position - eHRP.Position).Magnitude
                                if dist < shortestDistance then
                                    shortestDistance = dist
                                    targetEnemy = obj
                                    targetHRP = eHRP
                                end
                            end
                        end
                    end
                end
                
                if targetEnemy and targetHRP then
                    -- มีมอนสเตอร์ให้ตี แปลว่าอยู่ในด่านแล้ว
                    local tpDist = 2
                    hrp.CFrame = targetHRP.CFrame * CFrame.new(0, 0, tpDist)
                    hrp.Velocity = Vector3.new(0, 0, 0)
                    
                    local Bridge = game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("Bridge")
                    Bridge:FireServer("Fighters", "Click", "Damage")
                    Bridge:FireServer("Fighters", "Move", "Attack", targetEnemy:GetAttribute("Location") or targetHRP.Position, targetEnemy)
                    
                    -- สั่งตัวละครโจมตี (Attack)
                    pcall(function()
                        local tool = LocalPlayer.Character:FindFirstChildOfClass("Tool") or LocalPlayer.Backpack:FindFirstChildOfClass("Tool")
                        if tool then
                            LocalPlayer.Character.Humanoid:EquipTool(tool)
                            tool:Activate()
                        end
                        
                        -- Removed VirtualUser clicking to prevent unwanted UI clicks
                        -- local vu = game:GetService("VirtualUser")
                        -- vu:CaptureController()
                        -- vu:Button1Down(Vector2.new(0,0), workspace.CurrentCamera.CFrame)
                        -- vu:Button1Up(Vector2.new(0,0), workspace.CurrentCamera.CFrame)
                    end)
                else
                    -- ไม่มีมอนสเตอร์ ให้รอ หรือปล่อยให้ Auto Create/Join ทำงาน
                    task.wait(1)
                end
            end
        end)
    end,
})

Tab_Raid:CreateToggle({
    Name = "Auto Create Tower Raid",
    CurrentValue = false,
    Flag = "Toggle_AutoCreateRaid",
    Callback = function(Value)
        _G.AutoCreateRaid = Value
        task.spawn(function()
            while _G.AutoCreateRaid do
                task.wait(10)
                if _G.AutoTrial and _G.IsTrialActive then continue end
                
                local inRaidMode = false
                pcall(function()
                    local mode = game:GetService("Players").LocalPlayer:GetAttribute("Mode")
                    if mode and string.find(string.lower(mode), "towerraid") then
                        inRaidMode = true
                    end
                end)
                
                if not inRaidMode then
                    if _G.RaidCooldown and os.time() < _G.RaidCooldown then
                        continue
                    end
                    
                    pcall(function()
                        local Bridge = game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("Bridge")
                        Bridge:FireServer("Gamemodes", "TowerRaid", "Create")
                    end)
                    task.wait(0.5)
                    pcall(function()
                        for _, obj in ipairs(game:GetService("Players").LocalPlayer.PlayerGui:GetDescendants()) do
                            if obj:IsA("TextLabel") and obj.Visible and string.find(string.lower(obj.Text), "not open at the moment") then
                                _G.RaidCooldown = os.time() + 60 -- Cooldown for 60 seconds if Raid is closed
                                break
                            end
                        end
                    end)
                end
            end
        end)
    end,
})

Tab_Raid:CreateToggle({
    Name = "Auto Join Tower Raid",
    CurrentValue = false,
    Flag = "Toggle_AutoJoinRaid",
    Callback = function(Value)
        _G.AutoJoinRaid = Value
        task.spawn(function()
            while _G.AutoJoinRaid do
                task.wait(10)
                if _G.AutoTrial and _G.IsTrialActive then continue end
                
                local inRaidMode = false
                pcall(function()
                    local mode = game:GetService("Players").LocalPlayer:GetAttribute("Mode")
                    if mode and string.find(string.lower(mode), "towerraid") then
                        inRaidMode = true
                    end
                end)
                
                if not inRaidMode then
                    if _G.RaidCooldown and os.time() < _G.RaidCooldown then
                        continue
                    end
                    
                    pcall(function()
                        local Bridge = game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("Bridge")
                        Bridge:FireServer("Gamemodes", "TowerRaid", "Join")
                    end)
                    task.wait(0.5)
                    pcall(function()
                        for _, obj in ipairs(game:GetService("Players").LocalPlayer.PlayerGui:GetDescendants()) do
                            if obj:IsA("TextLabel") and obj.Visible and string.find(string.lower(obj.Text), "not open at the moment") then
                                _G.RaidCooldown = os.time() + 60 -- Cooldown for 60 seconds if Raid is closed
                                break
                            end
                        end
                    end)
                end
            end
        end)
    end,
})

local Section_Misc = Tab_Misc:CreateSection("Misc")

Tab_Misc:CreateToggle({
    Name = "Anti-AFK",
    CurrentValue = false,
    Flag = "Toggle_AntiAFK",
    Callback = function(Value)
        _G.AntiAFK = Value
        if _G.AntiAFK then
            LocalPlayer.Idled:Connect(function()
                if _G.AntiAFK then
                    VirtualUser:CaptureController()
                    VirtualUser:ClickButton2(Vector2.new())
                end
            end)
            SKT_UI:Notify({
                Title = "Anti-AFK Activated",
                Content = "You will no longer be kicked for idling.",
                Duration = 3,
                Image = 4483362458,
            })
        end
    end,
})

-- ==========================================
local Section_TrialMerchant = Tab_Trial:CreateSection("Trial Merchant Auto Buy")

local TrialMerchantItems = {
    "Coins I", "Drops I", "Stats Reroll", "Trait Reroll", 
    "Star Speed", "Exp I", "Damage I", "Luck"
}

local TrialMerchantMapping = {
    ["Trait Reroll"] = "Slot1",
    ["Stats Reroll"] = "Slot2",
    ["Coins I"] = "Slot3",
    ["Damage I"] = "Slot4",
    ["Exp I"] = "Slot5",
    ["Luck"] = "Slot6",
    ["Star Speed"] = "Slot7",
    ["Drops I"] = "Slot8"
}

Tab_Trial:CreateDropdown({
    Name = "Select Trial Merchant Items",
    Options = TrialMerchantItems,
    CurrentOption = {},
    MultipleOptions = true,
    Flag = "Dropdown_TrialMerchant",
    Callback = function(Options)
        _G.SelectedTrialMerchantItems = Options
    end,
})

Tab_Trial:CreateToggle({
    Name = "Auto Buy Trial Merchant",
    CurrentValue = false,
    Flag = "Toggle_AutoTrialMerchant",
    Callback = function(Value)
        _G.AutoTrialMerchant = Value
        local Bridge = game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("Bridge")
        
        if _G.AutoTrialMerchant then
            task.spawn(function()
                while _G.AutoTrialMerchant do
                    pcall(function()
                        if _G.SelectedTrialMerchantItems then
                            for k, v in pairs(_G.SelectedTrialMerchantItems) do
                                local itemName
                                if type(k) == "number" then
                                    itemName = v
                                elseif type(k) == "string" and v == true then
                                    itemName = k
                                end
                                
                                if itemName and TrialMerchantMapping[itemName] then
                                    Bridge:FireServer("General", "TrialMerchant", "Buy", TrialMerchantMapping[itemName])
                                    task.wait(0.05) -- ปรับให้ซื้อไวขึ้นมากๆ (20 ชิ้นต่อวินาที)
                                end
                            end
                        end
                    end)
                    task.wait(1) -- เช็คซื้อทุกๆ 1 วินาที (เร็วขึ้น 5 เท่า)
                end
            end)
        end
    end,
})



Tab_Misc:CreateToggle({
    Name = "Auto Claim Battlepass",
    CurrentValue = false,
    Flag = "Toggle_Battlepass",
    Callback = function(Value)
        _G.AutoBattlepass = Value
        local Bridge = game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("Bridge")
        task.spawn(function()
            while _G.AutoBattlepass do
                task.wait(10)
                pcall(function()
                    -- ยิง Claim All 
                    Bridge:FireServer("General", "Battlepass", "ClaimAll")
                    Bridge:FireServer("Rewards", "Battlepass", "ClaimAll")
                    
                    for i = 1, 100 do
                        Bridge:FireServer("General", "Battlepass", "Claim", i)
                        Bridge:FireServer("General", "Battlepass", "Claim", tostring(i))
                        Bridge:FireServer("Rewards", "Battlepass", "Claim", i)
                        
                        -- Move Awards claims into Battlepass logic
                        Bridge:FireServer("General", "Awards", "Claim", i)
                        Bridge:FireServer("General", "Awards", "Claim", tostring(i))
                        Bridge:FireServer("General", "Awards", "Claim", "Award_"..i)
                        Bridge:FireServer("Rewards", "Awards", "Claim", i)
                        
                        task.wait(0.05)
                    end
                    
                    for i = 1, 30 do
                        Bridge:FireServer("General", "DailyRewards", "Claim", i)
                        Bridge:FireServer("Rewards", "DailyRewards", "Claim", i)
                    end
                    
                    -- Fallback UI Clicker for Battlepass
                    if LocalPlayer and LocalPlayer:FindFirstChild("PlayerGui") then
                        for _, obj in ipairs(LocalPlayer.PlayerGui:GetDescendants()) do
                            if obj:IsA("TextButton") or obj:IsA("ImageButton") then
                                local txt = obj:IsA("TextButton") and string.lower(obj.Text) or ""
                                local name = string.lower(obj.Name)
                                if string.find(name, "claim") or string.find(txt, "claim") then
                                    local parent = obj.Parent
                                    local inBp = false
                                    for i=1, 6 do
                                        if parent and parent:IsA("GuiObject") then
                                            if string.find(string.lower(parent.Name), "battlepass") or string.find(string.lower(parent.Name), "pass") then 
                                                inBp = true 
                                                break 
                                            end
                                            parent = parent.Parent
                                        end
                                    end
                                    if inBp and getconnections then
                                        for _, conn in ipairs(getconnections(obj.MouseButton1Click)) do conn:Fire() end
                                    end
                                end
                            end
                        end
                    end
                end)
            end
        end)
    end,
})

