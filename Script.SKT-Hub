local SKT_UI = {}
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local CoreGui = game:GetService("CoreGui") or game:GetService("Players").LocalPlayer:WaitForChild("PlayerGui")

local UI_Config = {
    MainColor = Color3.fromRGB(18, 18, 24),
    SidebarColor = Color3.fromRGB(12, 12, 16),
    CardColor = Color3.fromRGB(24, 24, 32),
    AccentColor = Color3.fromRGB(255, 204, 0), -- Yellow Theme
    TextColor = Color3.fromRGB(255, 255, 255),
    DimTextColor = Color3.fromRGB(150, 150, 160),
    Font = Enum.Font.GothamMedium,
    LogoID = "rbxassetid://136267911004509",
}

local function CreateCorner(parent, radius)
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, radius or 6)
    corner.Parent = parent
    return corner
end

local function CreateStroke(parent, color, thickness)
    local stroke = Instance.new("UIStroke")
    stroke.Color = color
    stroke.Thickness = thickness or 1
    stroke.Parent = parent
    return stroke
end

function SKT_UI:CreateWindow(options)
    local Window = {}
    local Title = options.Name or "SKT Hub"
    
    if CoreGui:FindFirstChild("SKT_Hub_Custom") then
        CoreGui.SKT_Hub_Custom:Destroy()
    end
    
    local SG = Instance.new("ScreenGui")
    SG.Name = "SKT_Hub_Custom"
    SG.ResetOnSpawn = false
    SG.Parent = CoreGui
    
    local MiniBtn = Instance.new("ImageButton")
    MiniBtn.Name = "MiniBtn"
    MiniBtn.Size = UDim2.new(0, 50, 0, 50)
    MiniBtn.Position = UDim2.new(0.5, -25, 0, 20)
    MiniBtn.BackgroundColor3 = UI_Config.SidebarColor
    MiniBtn.Image = UI_Config.LogoID
    MiniBtn.Parent = SG
    MiniBtn.Visible = false
    CreateCorner(MiniBtn, 25)
    CreateStroke(MiniBtn, UI_Config.AccentColor, 2)
    
    local miniDragging, miniDragInput, miniDragStart, miniStartPos
    MiniBtn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            miniDragging = true
            miniDragStart = input.Position
            miniStartPos = MiniBtn.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    miniDragging = false
                end
            end)
        end
    end)
    MiniBtn.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            miniDragInput = input
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if input == miniDragInput and miniDragging then
            local delta = input.Position - miniDragStart
            MiniBtn.Position = UDim2.new(miniStartPos.X.Scale, miniStartPos.X.Offset + delta.X, miniStartPos.Y.Scale, miniStartPos.Y.Offset + delta.Y)
        end
    end)

    local MainFrame = Instance.new("Frame")
    MainFrame.Name = "MainFrame"
    MainFrame.Size = UDim2.new(0, 750, 0, 480)
    MainFrame.AnchorPoint = Vector2.new(0.5, 0.5)
    MainFrame.Position = UDim2.new(0.5, 0, 0.5, 0)
    MainFrame.BackgroundColor3 = UI_Config.MainColor
    MainFrame.BorderSizePixel = 0
    MainFrame.ClipsDescendants = true
    MainFrame.Parent = SG
    CreateCorner(MainFrame, 8)
    CreateStroke(MainFrame, UI_Config.SidebarColor, 2)
    
    local MinimizeBtn = Instance.new("TextButton")
    MinimizeBtn.Size = UDim2.new(0, 30, 0, 30)
    MinimizeBtn.Position = UDim2.new(1, -75, 0, 10)
    MinimizeBtn.BackgroundTransparency = 1
    MinimizeBtn.Text = "-"
    MinimizeBtn.TextColor3 = UI_Config.DimTextColor
    MinimizeBtn.Font = Enum.Font.GothamBold
    MinimizeBtn.TextSize = 24
    MinimizeBtn.ZIndex = 10
    MinimizeBtn.Parent = MainFrame
    
    local CloseBtn = Instance.new("TextButton")
    CloseBtn.Size = UDim2.new(0, 30, 0, 30)
    CloseBtn.Position = UDim2.new(1, -40, 0, 10)
    CloseBtn.BackgroundTransparency = 1
    CloseBtn.Text = "X"
    CloseBtn.TextColor3 = Color3.fromRGB(255, 100, 100)
    CloseBtn.Font = Enum.Font.GothamBold
    CloseBtn.TextSize = 20
    CloseBtn.ZIndex = 10
    CloseBtn.Parent = MainFrame

    local isAnimating = false
    local function ToggleUI(state)
        if isAnimating then return end
        isAnimating = true
        if state then
            MiniBtn.Visible = false
            MainFrame.Visible = true
            MainFrame.Size = UDim2.new(0, 0, 0, 0)
            local tween = TweenService:Create(MainFrame, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Size = UDim2.new(0, 750, 0, 480)})
            tween:Play()
            tween.Completed:Wait()
        else
            local tween = TweenService:Create(MainFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {Size = UDim2.new(0, 0, 0, 0)})
            tween:Play()
            tween.Completed:Wait()
            MainFrame.Visible = false
            MiniBtn.Visible = true
        end
        isAnimating = false
    end

    MinimizeBtn.MouseButton1Click:Connect(function()
        ToggleUI(false)
    end)
    
    CloseBtn.MouseButton1Click:Connect(function()
        if type(getgenv) == "function" then
            local genv = getgenv()
            if type(genv.SKT_Toggles) == "table" then
                for k, v in pairs(genv.SKT_Toggles) do
                    if type(v) == "boolean" then genv.SKT_Toggles[k] = false end
                end
            end
        end
        local tween = TweenService:Create(MainFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {Size = UDim2.new(0, 0, 0, 0)})
        tween:Play()
        tween.Completed:Wait()
        SG:Destroy()
    end)

    MiniBtn.MouseButton1Click:Connect(function()
        ToggleUI(true)
    end)
    
    UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if not gameProcessed and input.KeyCode == Enum.KeyCode.RightControl then
            ToggleUI(not MainFrame.Visible)
        end
    end)
    
    -- Draggable
    local dragging, dragInput, dragStart, startPos
    MainFrame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            dragStart = input.Position
            startPos = MainFrame.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)
    MainFrame.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement then
            dragInput = input
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)

    local Sidebar = Instance.new("Frame")
    Sidebar.Name = "Sidebar"
    Sidebar.Size = UDim2.new(0, 180, 1, 0)
    Sidebar.BackgroundColor3 = UI_Config.SidebarColor
    Sidebar.BorderSizePixel = 0
    Sidebar.Parent = MainFrame

    local TopLogo = Instance.new("Frame")
    TopLogo.Name = "TopLogo"
    TopLogo.Size = UDim2.new(1, 0, 0, 60)
    TopLogo.BackgroundTransparency = 1
    TopLogo.Parent = Sidebar

    local LogoImg = Instance.new("ImageLabel")
    LogoImg.Size = UDim2.new(0, 30, 0, 30)
    LogoImg.Position = UDim2.new(0, 15, 0.5, -15)
    LogoImg.BackgroundTransparency = 1
    LogoImg.Image = UI_Config.LogoID
    LogoImg.Parent = TopLogo

    local LogoText = Instance.new("TextLabel")
    LogoText.Size = UDim2.new(1, -55, 1, 0)
    LogoText.Position = UDim2.new(0, 55, 0, 0)
    LogoText.BackgroundTransparency = 1
    LogoText.Text = Title
    LogoText.TextColor3 = UI_Config.AccentColor
    LogoText.Font = Enum.Font.GothamBold
    LogoText.TextSize = 18
    LogoText.TextXAlignment = Enum.TextXAlignment.Left
    LogoText.Parent = TopLogo

    local TabContainer = Instance.new("ScrollingFrame")
    TabContainer.Name = "TabContainer"
    TabContainer.Size = UDim2.new(1, 0, 1, -70)
    TabContainer.Position = UDim2.new(0, 0, 0, 70)
    TabContainer.BackgroundTransparency = 1
    TabContainer.ScrollBarThickness = 0
    TabContainer.Parent = Sidebar

    local TabListLayout = Instance.new("UIListLayout")
    TabListLayout.SortOrder = Enum.SortOrder.LayoutOrder
    TabListLayout.Padding = UDim.new(0, 5)
    TabListLayout.Parent = TabContainer

    local ContentContainer = Instance.new("Frame")
    ContentContainer.Name = "ContentContainer"
    ContentContainer.Size = UDim2.new(1, -180, 1, 0)
    ContentContainer.Position = UDim2.new(0, 180, 0, 0)
    ContentContainer.BackgroundTransparency = 1
    ContentContainer.Parent = MainFrame

    local TopHeader = Instance.new("Frame")
    TopHeader.Size = UDim2.new(1, -20, 0, 35)
    TopHeader.Position = UDim2.new(0, 10, 0, 10)
    TopHeader.BackgroundColor3 = UI_Config.CardColor
    TopHeader.BorderSizePixel = 0
    TopHeader.Parent = ContentContainer
    CreateCorner(TopHeader, 6)
    CreateStroke(TopHeader, UI_Config.SidebarColor, 1)

    local HeaderText = Instance.new("TextLabel")
    HeaderText.Size = UDim2.new(0, 200, 1, 0)
    HeaderText.Position = UDim2.new(0, 15, 0, 0)
    HeaderText.BackgroundTransparency = 1
    HeaderText.Text = "🎮 Map: Anime Duelists"
    HeaderText.TextColor3 = UI_Config.AccentColor
    HeaderText.Font = Enum.Font.GothamBold
    HeaderText.TextSize = 14
    HeaderText.TextXAlignment = Enum.TextXAlignment.Left
    HeaderText.Parent = TopHeader

    local DiscordLabel = Instance.new("TextLabel")
    DiscordLabel.Size = UDim2.new(0, 100, 1, 0)
    DiscordLabel.Position = UDim2.new(1, -300, 0, 0)
    DiscordLabel.BackgroundTransparency = 1
    DiscordLabel.Text = "Discord Script"
    DiscordLabel.TextColor3 = UI_Config.DimTextColor
    DiscordLabel.Font = Enum.Font.GothamBold
    DiscordLabel.TextSize = 12
    DiscordLabel.TextXAlignment = Enum.TextXAlignment.Right
    DiscordLabel.Parent = TopHeader

    local DiscordBtn = Instance.new("TextButton")
    DiscordBtn.Size = UDim2.new(0, 100, 0, 25)
    DiscordBtn.Position = UDim2.new(1, -190, 0.5, -12.5)
    DiscordBtn.BackgroundColor3 = Color3.fromRGB(88, 101, 242)
    DiscordBtn.Text = "Copy Link"
    DiscordBtn.TextColor3 = Color3.new(1,1,1)
    DiscordBtn.Font = Enum.Font.GothamBold
    DiscordBtn.TextSize = 12
    DiscordBtn.Parent = TopHeader
    CreateCorner(DiscordBtn, 4)
    DiscordBtn.MouseButton1Click:Connect(function()
        if setclipboard then
            setclipboard("https://discord.gg/XgcETfpJJ")
        end
        pcall(function()
            game:GetService("StarterGui"):SetCore("SendNotification", {
                Title = "Discord Script",
                Text = "Copy Success!",
                Duration = 3
            })
        end)
    end)


    local Tabs = {}
    local FirstTab = true

    function Window:CreateTab(name, iconId)
        local Tab = {}
        
        local TabBtn = Instance.new("TextButton")
        TabBtn.Name = name.."_Tab"
        TabBtn.Size = UDim2.new(1, -20, 0, 35)
        TabBtn.Position = UDim2.new(0, 10, 0, 0)
        TabBtn.BackgroundColor3 = UI_Config.CardColor
        TabBtn.BackgroundTransparency = 1
        TabBtn.Text = "  " .. name
        TabBtn.TextColor3 = UI_Config.DimTextColor
        TabBtn.Font = UI_Config.Font
        TabBtn.TextSize = 14
        TabBtn.TextXAlignment = Enum.TextXAlignment.Left
        TabBtn.Parent = TabContainer
        CreateCorner(TabBtn, 6)
        
        local TabGradient = Instance.new("UIGradient")
        TabGradient.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 255, 255)),
            ColorSequenceKeypoint.new(1, Color3.fromRGB(150, 150, 150))
        })
        TabGradient.Rotation = 90
        TabGradient.Parent = TabBtn
        
        local TabStroke = Instance.new("UIStroke")
        TabStroke.Color = Color3.fromRGB(60, 60, 70)
        TabStroke.Transparency = 1
        TabStroke.Thickness = 1
        TabStroke.Parent = TabBtn
        
        local TabIndicator = Instance.new("Frame")
        TabIndicator.Size = UDim2.new(0, 3, 0, 20)
        TabIndicator.Position = UDim2.new(0, 0, 0.5, -10)
        TabIndicator.BackgroundColor3 = UI_Config.AccentColor
        TabIndicator.BorderSizePixel = 0
        TabIndicator.BackgroundTransparency = 1
        TabIndicator.Parent = TabBtn
        CreateCorner(TabIndicator, 2)

        local TabContent = Instance.new("ScrollingFrame")
        TabContent.Name = name.."_Content"
        TabContent.Size = UDim2.new(1, -20, 1, -60)
        TabContent.Position = UDim2.new(0, 10, 0, 55)
        TabContent.BackgroundTransparency = 1
        TabContent.ScrollBarThickness = 2
        TabContent.ScrollBarImageColor3 = UI_Config.AccentColor
        TabContent.Visible = false
        TabContent.Parent = ContentContainer

        local ContentLayout = Instance.new("UIListLayout")
        ContentLayout.SortOrder = Enum.SortOrder.LayoutOrder
        ContentLayout.Padding = UDim.new(0, 10)
        ContentLayout.Parent = TabContent

        ContentLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
            TabContent.CanvasSize = UDim2.new(0, 0, 0, ContentLayout.AbsoluteContentSize.Y + 20)
        end)

        table.insert(Tabs, {Btn = TabBtn, Content = TabContent, Indicator = TabIndicator, Stroke = TabStroke})

        TabBtn.MouseButton1Click:Connect(function()
            for _, t in ipairs(Tabs) do
                t.Content.Visible = false
                t.Btn.TextColor3 = UI_Config.DimTextColor
                t.Btn.BackgroundTransparency = 1
                t.Indicator.BackgroundTransparency = 1
                t.Stroke.Transparency = 1
            end
            TabContent.Visible = true
            TabBtn.TextColor3 = UI_Config.TextColor
            TabBtn.BackgroundTransparency = 0.5
            TabIndicator.BackgroundTransparency = 0
            TabStroke.Transparency = 0
        end)

        if FirstTab then
            FirstTab = false
            TabContent.Visible = true
            TabBtn.TextColor3 = UI_Config.TextColor
            TabBtn.BackgroundTransparency = 0.5
            TabIndicator.BackgroundTransparency = 0
            TabStroke.Transparency = 0
        end

        function Tab:CreateSection(secName)
            local SecFrame = Instance.new("Frame")
            SecFrame.Size = UDim2.new(1, -10, 0, 30)
            SecFrame.BackgroundTransparency = 1
            SecFrame.Parent = TabContent
            
            local SecText = Instance.new("TextLabel")
            SecText.Size = UDim2.new(1, 0, 1, 0)
            SecText.BackgroundTransparency = 1
            SecText.Text = ">> " .. secName
            SecText.TextColor3 = UI_Config.TextColor
            SecText.Font = Enum.Font.GothamBold
            SecText.TextSize = 15
            SecText.TextXAlignment = Enum.TextXAlignment.Left
            SecText.Parent = SecFrame
        end

        function Tab:CreateToggle(opts)
            local ToggleFrame = Instance.new("Frame")
            ToggleFrame.Size = UDim2.new(1, -10, 0, 45)
            ToggleFrame.BackgroundColor3 = UI_Config.CardColor
            ToggleFrame.Parent = TabContent
            CreateCorner(ToggleFrame, 6)

            local ToggleTitle = Instance.new("TextLabel")
            ToggleTitle.Size = UDim2.new(0.7, 0, 1, 0)
            ToggleTitle.Position = UDim2.new(0, 15, 0, 0)
            ToggleTitle.BackgroundTransparency = 1
            ToggleTitle.Text = opts.Name
            ToggleTitle.TextColor3 = UI_Config.TextColor
            ToggleTitle.Font = UI_Config.Font
            ToggleTitle.TextSize = 14
            ToggleTitle.TextXAlignment = Enum.TextXAlignment.Left
            ToggleTitle.Parent = ToggleFrame

            local ToggleBtn = Instance.new("TextButton")
            ToggleBtn.Size = UDim2.new(0, 40, 0, 20)
            ToggleBtn.Position = UDim2.new(1, -55, 0.5, -10)
            ToggleBtn.BackgroundColor3 = UI_Config.MainColor
            ToggleBtn.Text = ""
            ToggleBtn.Parent = ToggleFrame
            CreateCorner(ToggleBtn, 10)
            CreateStroke(ToggleBtn, UI_Config.DimTextColor, 1)

            local ToggleCircle = Instance.new("Frame")
            ToggleCircle.Size = UDim2.new(0, 14, 0, 14)
            ToggleCircle.Position = UDim2.new(0, 3, 0.5, -7)
            ToggleCircle.BackgroundColor3 = UI_Config.DimTextColor
            ToggleCircle.Parent = ToggleBtn
            CreateCorner(ToggleCircle, 7)

            local toggled = opts.CurrentValue or false
            
            local function updateToggle(anim)
                if toggled then
                    if anim then
                        TweenService:Create(ToggleCircle, TweenInfo.new(0.2), {Position = UDim2.new(1, -17, 0.5, -7), BackgroundColor3 = UI_Config.AccentColor}):Play()
                        TweenService:Create(ToggleBtn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(UI_Config.AccentColor.R*255*0.2, UI_Config.AccentColor.G*255*0.2, UI_Config.AccentColor.B*255*0.2)}):Play()
                    else
                        ToggleCircle.Position = UDim2.new(1, -17, 0.5, -7)
                        ToggleCircle.BackgroundColor3 = UI_Config.AccentColor
                        ToggleBtn.BackgroundColor3 = Color3.fromRGB(UI_Config.AccentColor.R*255*0.2, UI_Config.AccentColor.G*255*0.2, UI_Config.AccentColor.B*255*0.2)
                    end
                else
                    if anim then
                        TweenService:Create(ToggleCircle, TweenInfo.new(0.2), {Position = UDim2.new(0, 3, 0.5, -7), BackgroundColor3 = UI_Config.DimTextColor}):Play()
                        TweenService:Create(ToggleBtn, TweenInfo.new(0.2), {BackgroundColor3 = UI_Config.MainColor}):Play()
                    else
                        ToggleCircle.Position = UDim2.new(0, 3, 0.5, -7)
                        ToggleCircle.BackgroundColor3 = UI_Config.DimTextColor
                        ToggleBtn.BackgroundColor3 = UI_Config.MainColor
                    end
                end
                if opts.Callback then
                    opts.Callback(toggled)
                end
            end
            
            updateToggle(false)

            ToggleBtn.MouseButton1Click:Connect(function()
                toggled = not toggled
                updateToggle(true)
            end)
        end

        function Tab:CreateSlider(opts)
            local SliderFrame = Instance.new("Frame")
            SliderFrame.Size = UDim2.new(1, -10, 0, 55)
            SliderFrame.BackgroundColor3 = UI_Config.CardColor
            SliderFrame.Parent = TabContent
            CreateCorner(SliderFrame, 6)

            local SliderTitle = Instance.new("TextLabel")
            SliderTitle.Size = UDim2.new(1, -30, 0, 25)
            SliderTitle.Position = UDim2.new(0, 15, 0, 5)
            SliderTitle.BackgroundTransparency = 1
            SliderTitle.Text = opts.Name
            SliderTitle.TextColor3 = UI_Config.TextColor
            SliderTitle.Font = UI_Config.Font
            SliderTitle.TextSize = 14
            SliderTitle.TextXAlignment = Enum.TextXAlignment.Left
            SliderTitle.Parent = SliderFrame

            local SliderValue = Instance.new("TextLabel")
            SliderValue.Size = UDim2.new(0, 50, 0, 25)
            SliderValue.Position = UDim2.new(1, -65, 0, 5)
            SliderValue.BackgroundTransparency = 1
            SliderValue.Text = tostring(opts.CurrentValue or opts.Range[1]) .. (opts.Suffix and (" " .. opts.Suffix) or "")
            SliderValue.TextColor3 = UI_Config.AccentColor
            SliderValue.Font = UI_Config.Font
            SliderValue.TextSize = 14
            SliderValue.TextXAlignment = Enum.TextXAlignment.Right
            SliderValue.Parent = SliderFrame

            local SliderBg = Instance.new("TextButton")
            SliderBg.Size = UDim2.new(1, -30, 0, 6)
            SliderBg.Position = UDim2.new(0, 15, 0, 35)
            SliderBg.BackgroundColor3 = UI_Config.MainColor
            SliderBg.Text = ""
            SliderBg.Parent = SliderFrame
            CreateCorner(SliderBg, 3)

            local SliderFill = Instance.new("Frame")
            SliderFill.Size = UDim2.new(0, 0, 1, 0)
            SliderFill.BackgroundColor3 = UI_Config.AccentColor
            SliderFill.Parent = SliderBg
            CreateCorner(SliderFill, 3)

            local min, max = opts.Range[1], opts.Range[2]
            local current = opts.CurrentValue or min
            local increment = opts.Increment or 1

            local function updateSlider(val)
                current = math.clamp(math.round(val / increment) * increment, min, max)
                local percent = (current - min) / (max - min)
                SliderFill.Size = UDim2.new(percent, 0, 1, 0)
                SliderValue.Text = tostring(current) .. (opts.Suffix and (" " .. opts.Suffix) or "")
                if opts.Callback then
                    opts.Callback(current)
                end
            end
            
            updateSlider(current)

            local sliding = false
            SliderBg.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then
                    sliding = true
                    local percent = math.clamp((input.Position.X - SliderBg.AbsolutePosition.X) / SliderBg.AbsoluteSize.X, 0, 1)
                    updateSlider(min + (max - min) * percent)
                end
            end)
            
            UserInputService.InputChanged:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseMovement and sliding then
                    local percent = math.clamp((input.Position.X - SliderBg.AbsolutePosition.X) / SliderBg.AbsoluteSize.X, 0, 1)
                    updateSlider(min + (max - min) * percent)
                end
            end)
            
            UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then
                    sliding = false
                end
            end)
        end

        function Tab:CreateDropdown(opts)
            local DropFrame = Instance.new("Frame")
            DropFrame.Size = UDim2.new(1, -10, 0, 45)
            DropFrame.BackgroundColor3 = UI_Config.CardColor
            DropFrame.ClipsDescendants = true
            DropFrame.Parent = TabContent
            CreateCorner(DropFrame, 6)

            local DropTitle = Instance.new("TextLabel")
            DropTitle.Size = UDim2.new(0.5, 0, 0, 45)
            DropTitle.Position = UDim2.new(0, 15, 0, 0)
            DropTitle.BackgroundTransparency = 1
            DropTitle.Text = opts.Name
            DropTitle.TextColor3 = UI_Config.TextColor
            DropTitle.Font = UI_Config.Font
            DropTitle.TextSize = 14
            DropTitle.TextXAlignment = Enum.TextXAlignment.Left
            DropTitle.Parent = DropFrame

            local DropBtn = Instance.new("TextButton")
            DropBtn.Size = UDim2.new(0, 150, 0, 30)
            DropBtn.Position = UDim2.new(1, -165, 0, 7)
            local initText = "None"
            if type(opts.CurrentOption) == "table" and opts.CurrentOption[1] then
                initText = tostring(opts.CurrentOption[1])
            elseif type(opts.CurrentOption) == "string" then
                initText = opts.CurrentOption
            end
            
            DropBtn.BackgroundColor3 = UI_Config.MainColor
            DropBtn.Text = initText
            DropBtn.TextColor3 = UI_Config.DimTextColor
            DropBtn.Font = UI_Config.Font
            DropBtn.TextSize = 13
            DropBtn.Parent = DropFrame
            CreateCorner(DropBtn, 4)

            local ScrollFrame = Instance.new("ScrollingFrame")
            ScrollFrame.Size = UDim2.new(1, -30, 0, 100)
            ScrollFrame.Position = UDim2.new(0, 15, 0, 50)
            ScrollFrame.BackgroundTransparency = 1
            ScrollFrame.ScrollBarThickness = 2
            ScrollFrame.Parent = DropFrame

            local ListLayout = Instance.new("UIListLayout")
            ListLayout.SortOrder = Enum.SortOrder.LayoutOrder
            ListLayout.Padding = UDim.new(0, 5)
            ListLayout.Parent = ScrollFrame

            local isOpen = false

            local function refreshOptions(options)
                for _, child in ipairs(ScrollFrame:GetChildren()) do
                    if child:IsA("TextButton") then child:Destroy() end
                end
                
                for i, opt in ipairs(options) do
                    local btn = Instance.new("TextButton")
                    btn.Size = UDim2.new(1, -10, 0, 25)
                    btn.BackgroundColor3 = UI_Config.MainColor
                    btn.Text = tostring(opt)
                    btn.TextColor3 = UI_Config.TextColor
                    btn.Font = UI_Config.Font
                    btn.TextSize = 13
                    btn.Parent = ScrollFrame
                    CreateCorner(btn, 4)

                    btn.MouseButton1Click:Connect(function()
                        DropBtn.Text = tostring(opt)
                        isOpen = false
                        TweenService:Create(DropFrame, TweenInfo.new(0.2), {Size = UDim2.new(1, -10, 0, 45)}):Play()
                        if opts.Callback then opts.Callback(opt) end
                    end)
                end
                ScrollFrame.CanvasSize = UDim2.new(0, 0, 0, ListLayout.AbsoluteContentSize.Y)
            end
            
            if opts.Options then
                refreshOptions(opts.Options)
            end

            DropBtn.MouseButton1Click:Connect(function()
                isOpen = not isOpen
                if isOpen then
                    TweenService:Create(DropFrame, TweenInfo.new(0.2), {Size = UDim2.new(1, -10, 0, 160)}):Play()
                else
                    TweenService:Create(DropFrame, TweenInfo.new(0.2), {Size = UDim2.new(1, -10, 0, 45)}):Play()
                end
            end)
            
            return {
                Refresh = function(self, newOpts)
                    -- In original script, it calls MonsterDropdown:Refresh(opts, {"Best ( Quest )"})
                    -- So we need to handle newOpts correctly.
                    refreshOptions(newOpts)
                end,
                Set = function(self, newVals)
                    if type(newVals) == "table" then
                        DropBtn.Text = tostring(newVals[1] or "Select")
                    else
                        DropBtn.Text = tostring(newVals or "Select")
                    end
                end
            }
        end

        function Tab:CreateButton(opts)
            local BtnFrame = Instance.new("Frame")
            BtnFrame.Size = UDim2.new(1, -10, 0, 45)
            BtnFrame.BackgroundColor3 = UI_Config.CardColor
            BtnFrame.Parent = TabContent
            CreateCorner(BtnFrame, 6)

            local ActionBtn = Instance.new("TextButton")
            ActionBtn.Size = UDim2.new(1, -30, 0, 30)
            ActionBtn.Position = UDim2.new(0, 15, 0, 7)
            ActionBtn.BackgroundColor3 = UI_Config.AccentColor
            ActionBtn.Text = opts.Name
            ActionBtn.TextColor3 = Color3.fromRGB(20, 20, 20)
            ActionBtn.Font = Enum.Font.GothamBold
            ActionBtn.TextSize = 14
            ActionBtn.Parent = BtnFrame
            CreateCorner(ActionBtn, 4)

            ActionBtn.MouseButton1Click:Connect(function()
                TweenService:Create(ActionBtn, TweenInfo.new(0.1), {BackgroundColor3 = Color3.fromRGB(255, 255, 255)}):Play()
                task.wait(0.1)
                TweenService:Create(ActionBtn, TweenInfo.new(0.1), {BackgroundColor3 = UI_Config.AccentColor}):Play()
                if opts.Callback then
                    opts.Callback()
                end
            end)
        end

        return Tab
    end
    
    function SKT_UI:Notify(opts)
        -- Notification system stub to keep compatibility
        print("[SKT_UI Notify]", opts.Title, opts.Content)
    end
    
    return Window
end
local Window = SKT_UI:CreateWindow({Name="SKT Hub"})

