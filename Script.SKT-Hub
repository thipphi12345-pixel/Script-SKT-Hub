        -- เน€เธโ€”เน€เธเธ”เน€เธยเน€เธยเน€เธโฌเน€เธยเน€เธเธเน€เธเธเน€เธโฌเน€เธยเน€เธยเน€เธเธ’เน€เธโ€”เน€เธเธเน€เธยเน€เธยเน€เธเธเน€เธเธ‘เน€เธยเน€เธยเน€เธโ€”เน€เธเธ•เน€เธยเน€เธโฌเน€เธยเน€เธเธ…เน€เธเธ•เน€เธยเน€เธเธเน€เธยเน€เธยเน€เธเธเน€เธย เน€เธยเน€เธยเน€เธเธเน€เธยเน€เธยเน€เธเธ‘เน€เธยเน€เธยเน€เธเธ‘เน€เธยเน€เธเธเน€เธเธ‘เน€เธยเน€เธโฌเน€เธยเน€เธเธเน€เธเธเน€เธยเน€เธยเน€เธเธเน€เธย
        task.spawn(function()
            pcall(function()
                local Bridge = game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("Bridge")
                Bridge:FireServer("General", "Quest", "Abandon")
                
                -- เน€เธเธเน€เธเธ’เน€เธเธเน€เธยเน€เธยเน€เธยเน€เธยเน€เธเธเน€เธเธ‘เน€เธยเน€เธยเน€เธเธเน€เธยเน€เธโ€”เน€เธเธ•เน€เธยเน€เธโฌเน€เธเธ…เน€เธเธ—เน€เธเธเน€เธยเน€เธโ€”เน€เธเธ‘เน€เธยเน€เธโ€”เน€เธเธ•! (เน€เธโ€เน€เธเธ–เน€เธยเน€เธยเน€เธเธ—เน€เธยเน€เธเธ Module เน€เธยเน€เธเธ’เน€เธย QuestData)
                local targetKey = _G.SelectedQuestKey
                local qData = QuestData[targetKey]
                if qData and qData.Module then
                    SafeUITeleport(qData.Module)
                    task.wait(1.5) -- เน€เธเธเน€เธเธเน€เธโฌเน€เธยเน€เธเธ”เน€เธเธเน€เธยเน€เธยเน€เธโฌเน€เธเธเน€เธเธเน€เธเธเน€เธยเน€เธโ€ขเน€เธเธเน€เธยเน€เธเธเน€เธยเน€เธเธเน€เธยเน€เธยเน€เธเธ…เน€เธเธเน€เธยเน€เธเธเน€เธเธ…เน€เธโ€เน€เธเธเน€เธยเน€เธเธ’เน€เธเธเน€เธยเน€เธเธเน€เธย
                    -- เน€เธเธเน€เธเธ”เน€เธย Remote เน€เธเธเน€เธเธ‘เน€เธยเน€เธโฌเน€เธยเน€เธเธเน€เธเธเน€เธยเน€เธเธเน€เธยเน€เธโ€เน€เธยเน€เธเธ’เน€เธยเน€เธยเน€เธเธ‘เน€เธยเน€เธยเน€เธโ€”เน€เธเธ‘เน€เธยเน€เธโ€”เน€เธเธ•
                    Bridge:FireServer("General", "Quest", "Accept", qData.Module)
                end
            end)
        end)
        
        -- Build dropdown options
        local opts = {}
        local mapKey = _G.SelectedQuestKey
        if QuestData[mapKey] then
            for _, m in ipairs(QuestData[mapKey].Monsters) do
                table.insert(opts, m)
            end
        end
        
        -- เน€เธโฌเน€เธยเน€เธยเน€เธยเน€เธยเน€เธยเน€เธเธ’เน€เธโฌเน€เธโ€เน€เธเธ”เน€เธเธเน€เธยเน€เธเธเน€เธยเน€เธยเน€เธยเน€เธเธเน€เธยเน€เธยเน€เธเธ‘เน€เธยเน€เธยเน€เธเธ‘เน€เธยเน€เธเธเน€เธเธ’เน€เธโ€ขเน€เธเธเน€เธย Load Config
        local oldMonster = _G.SelectedMonster
        
        MonsterDropdown:Refresh(opts, {opts[1]})
        
        -- เน€เธโ€“เน€เธยเน€เธเธ’เน€เธยเน€เธยเน€เธเธ’เน€เธโฌเน€เธโ€เน€เธเธ”เน€เธเธเน€เธเธเน€เธเธ•เน€เธยเน€เธยเน€เธโ€ขเน€เธเธ‘เน€เธเธเน€เธโฌเน€เธเธ…เน€เธเธ—เน€เธเธเน€เธยเน€เธยเน€เธเธเน€เธยเน€เธยเน€เธเธเน€เธยเน€เธยเน€เธเธ•เน€เธย เน€เธยเน€เธเธเน€เธยเน€เธยเน€เธยเน€เธยเน€เธยเน€เธยเน€เธเธ’เน€เธโฌเน€เธโ€เน€เธเธ”เน€เธเธ
        local foundOld = false
        for _, o in ipairs(opts) do
            if o == oldMonster then
                foundOld = true
                break
            end
        end
        
        if foundOld then
            _G.SelectedMonster = oldMonster
            MonsterDropdown:Set({oldMonster})
        else
            _G.SelectedMonster = opts[1]
            MonsterDropdown:Set({opts[1]})
        end
    end,
})

local AutoQuestToggle = Tab_Autofarm:CreateToggle({
    Name = "Auto Quest",
    CurrentValue = false,
    Flag = "Toggle_AutoQuest",
    Callback = function(Value)
        _G.AutoQuest = Value
        
        while _G.AutoQuest do
            task.wait(1)
            
            -- เน€เธยเน€เธยเน€เธเธเน€เธยเน€เธยเน€เธเธ‘เน€เธยเน€เธโ€ขเน€เธเธ•เน€เธยเน€เธเธ‘เน€เธยเน€เธยเน€เธเธ‘เน€เธย Trial/Raid
            local isRaidBusy = _G.IsRaidActive
            if not isRaidBusy then
                if _G.AutoCreateRaid or _G.AutoJoinRaid then
                    if not _G.RaidCooldown or os.time() >= _G.RaidCooldown then
                        isRaidBusy = true
                    end
                end
            end
            
            if (_G.AutoTrial and _G.IsTrialActive) or isRaidBusy then continue end
            
            local activeMapKey = _G.SelectedQuestKey
            local qData = QuestData[activeMapKey]
            if not qData then continue end
            
            local hasQuest = false
            pcall(function()
                local LocalPlayer = game:GetService("Players").LocalPlayer
                if LocalPlayer and LocalPlayer:FindFirstChild("PlayerGui") then
                    for _, obj in ipairs(LocalPlayer.PlayerGui:GetDescendants()) do
                        if (obj:IsA("TextLabel") or obj:IsA("TextButton")) and obj.Text ~= "" then
                            local isVisible = true
                            local parent = obj
                            while parent and parent:IsA("GuiObject") do
                                if not parent.Visible then isVisible = false break end
                                parent = parent.Parent
                            end
                            
                            if isVisible then
                                local cleanText = string.gsub(obj.Text, "<[^>]+>", "")
                                local m, curr, max = string.match(cleanText, "Defeat%s+%d+%s+(.-)%s*[%([](%d+)/(%d+)[%)%]]")
                                if m and curr and max then
                                    if tonumber(curr) < tonumber(max) then
                                        hasQuest = true
                                        break
                                    end
                                end
                            end
                        end
                    end
                end
            end)
            
            -- เน€เธโ€“เน€เธยเน€เธเธ’เน€เธเธเน€เธเธเน€เธโฌเน€เธยเน€เธเธเน€เธเธเน€เธเธเน€เธเธ‘เน€เธยเน€เธยเน€เธเธเน€เธยเน€เธยเน€เธเธเน€เธย เน€เธเธเน€เธเธเน€เธเธ—เน€เธเธเน€เธยเน€เธเธเน€เธยเน€เธเธเน€เธเธ•เน€เธโฌเน€เธยเน€เธเธเน€เธเธ เน€เธยเน€เธเธเน€เธยเน€เธเธเน€เธเธ”เน€เธยเน€เธเธเน€เธเธ‘เน€เธยเน€เธโฌเน€เธยเน€เธเธเน€เธเธเน€เธยเน€เธเธเน€เธเธเน€เธย
            if not hasQuest then
                pcall(function()
                    local Bridge = game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("Bridge")
                    Bridge:FireServer("General", "Quest", "Accept", qData.Module)
                end)
                task.wait(2) -- เน€เธเธเน€เธเธเน€เธโฌเน€เธยเน€เธเธ”เน€เธเธเน€เธยเน€เธยเน€เธโฌเน€เธเธเน€เธเธเน€เธเธเน€เธยเน€เธเธเน€เธเธ‘เน€เธยเน€เธโฌเน€เธโ€เน€เธโ€ข Quest GUI
            end
        end
    end,
})

local AutoTeleportToggle = Tab_Autofarm:CreateToggle({
    Name = "Auto Farm Monster",
    CurrentValue = false,
    Flag = "Toggle_AutoTeleport",
    Callback = function(Value)
        _G.AutoTeleport = Value
        
        while _G.AutoTeleport do
            task.wait(0.1)
            
            -- เน€เธยเน€เธยเน€เธเธเน€เธยเน€เธยเน€เธเธ‘เน€เธยเน€เธโ€ขเน€เธเธ•เน€เธยเน€เธเธ‘เน€เธยเน€เธยเน€เธเธ‘เน€เธยเน€เธเธเน€เธเธเน€เธยเน€เธยเน€เธเธเน€เธเธ—เน€เธยเน€เธย
            if _G.AutoTrial and _G.IsTrialActive then continue end
            
            local isRaidBusy = _G.IsRaidActive
            if not isRaidBusy then
                if _G.AutoCreateRaid or _G.AutoJoinRaid then
                    if not _G.RaidCooldown or os.time() >= _G.RaidCooldown then
                        isRaidBusy = true
                    end
                end
            end
            
            if (_G.AutoTowerRaid and _G.IsRaidActive) or isRaidBusy then continue end
            
            local targetMonsterName = _G.SelectedMonster
            
            -- เน€เธยเน€เธเธ‘เน€เธยเน€เธยเน€เธยเน€เธยเน€เธเธ‘เน€เธยเน€เธยเน€เธยเน€เธเธ•เน€เธยเน€เธเธเน€เธเธ•เน€เธยเน€เธเธเน€เธยเน€เธเธเน€เธเธ“เน€เธเธเน€เธเธเน€เธเธ‘เน€เธยเน€เธเธเน€เธเธ’เน€เธเธเน€เธยเน€เธยเน€เธยเน€เธยเน€เธเธเน€เธเธ’เน€เธเธเน€เธเธเน€เธยเน€เธโ€”เน€เธเธ•เน€เธยเน€เธโฌเน€เธเธ…เน€เธเธ—เน€เธเธเน€เธยเน€เธยเน€เธเธ’เน€เธย Dropdown เน€เธโฌเน€เธโ€”เน€เธยเน€เธเธ’เน€เธยเน€เธเธ‘เน€เธยเน€เธย
            if targetMonsterName and targetMonsterName ~= "Best ( Quest )" and targetMonsterName ~= "Auto Progress" then
                local targetMonster = nil
                local shortestDistance = math.huge
                
                -- เน€เธเธเน€เธเธ’เน€เธยเน€เธยเน€เธเธ…เน€เธโฌเน€เธโ€เน€เธเธเน€เธเธเน€เธยเน€เธเธเน€เธเธเน€เธยเน€เธเธเน€เธโฌเน€เธโ€ขเน€เธเธเน€เธเธเน€เธยเน€เธยเน€เธเธเน€เธยเน€เธยเน€เธเธเน€เธยเน€เธยเน€เธเธ‘เน€เธยเน€เธยเน€เธเธเน€เธยเน€เธเธ‘เน€เธย
                local searchFolder = workspace
                pcall(function()
                    local activeMapKey = _G.SelectedQuestKey or ""
                    local cleanName = string.gsub(activeMapKey, " ", "")
                    local mapFolder = workspace:FindFirstChild(cleanName) or (workspace:FindFirstChild("Server") and workspace.Server:FindFirstChild(cleanName))
                    if mapFolder then
                        searchFolder = mapFolder:FindFirstChild("Monsters") or mapFolder:FindFirstChild("Enemies") or mapFolder
                    end
                end)
                
                -- เน€เธยเน€เธยเน€เธยเน€เธเธเน€เธเธ’เน€เธเธเน€เธเธเน€เธยเน€เธเธเน€เธโฌเน€เธโ€ขเน€เธเธเน€เธเธเน€เธย
                for _, obj in ipairs(searchFolder:GetDescendants()) do
                    if obj:IsA("Model") and obj:FindFirstChild("HumanoidRootPart") and obj:FindFirstChild("Humanoid") then
                        local cleanObjName = string.lower(string.gsub(obj.Name, "[^%w]", ""))
                        local cleanTargetName = string.lower(string.gsub(targetMonsterName, "[^%w]", ""))
                        
                        local isNameMatch = (cleanObjName == cleanTargetName) or (string.find(cleanObjName, cleanTargetName) ~= nil)
                        
                        if isNameMatch then
                            local isAlive = true
                            
                            if obj:GetAttribute("Health") ~= nil then
                                if obj:GetAttribute("Health") <= 0 then isAlive = false end
                            else
                                if obj.Humanoid.Health <= 0 then isAlive = false end
                            end
                            if obj:GetAttribute("Dead") == true or obj:GetAttribute("Died") == true or obj:GetAttribute("IsDead") == true then isAlive = false end
                            if obj.Humanoid:GetState() == Enum.HumanoidStateType.Dead then isAlive = false end
                            
                            if isAlive then
                                if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                                    local dist = (LocalPlayer.Character.HumanoidRootPart.Position - obj.HumanoidRootPart.Position).Magnitude
                                    if dist < shortestDistance then
                                        shortestDistance = dist
                                        targetMonster = obj
                                    end
                                else
                                    targetMonster = obj
                                    break
                                end
                            end
                        end
                    end
                end
                
                -- เน€เธเธเน€เธเธ’เน€เธเธเน€เธยเน€เธยเน€เธยเน€เธยเน€เธเธเน€เธเธ’เน€เธเธเน€เธเธเน€เธยเน€เธเธเน€เธโฌเน€เธโ€ขเน€เธเธเน€เธเธเน€เธยเน€เธโ€”เน€เธเธ•เน€เธยเน€เธยเน€เธย
                if targetMonster and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                    local hrp = LocalPlayer.Character.HumanoidRootPart
                    local dist = (hrp.Position - targetMonster.HumanoidRootPart.Position).Magnitude
                    
                    if dist > 15000 then
                        -- เน€เธยเน€เธเธเน€เธยเน€เธเธเน€เธเธเน€เธเธเน€เธยเน€เธยเน€เธยเน€เธเธ…เน€เธโฌเน€เธยเน€เธเธ”เน€เธย เน€เธยเน€เธเธเน€เธยเน€เธเธเน€เธเธ’เน€เธเธเน€เธยเน€เธยเน€เธยเน€เธยเน€เธเธ’เน€เธเธเน€เธโฌเน€เธยเน€เธเธ’เน€เธเธ
                        local activeMapKey = _G.SelectedQuestKey
                        local qData = QuestData[activeMapKey]
                        if qData and qData.Module then
                            pcall(function()
                                SafeUITeleport(qData.Module)
                            end)
                            task.wait(1.5)
                        end
                    else
                        -- เน€เธเธเน€เธเธ’เน€เธเธเน€เธยเน€เธยเน€เธยเน€เธยเน€เธโ€”เน€เธเธ•เน€เธยเน€เธเธเน€เธเธ…เน€เธเธ‘เน€เธยเน€เธโ€ขเน€เธเธ‘เน€เธเธเน€เธเธเน€เธเธเน€เธยเน€เธเธเน€เธโฌเน€เธโ€ขเน€เธเธเน€เธเธเน€เธย
                        if (hrp.Position - targetMonster.HumanoidRootPart.Position).Magnitude > 15 then
                            local mCFrame = targetMonster.HumanoidRootPart.CFrame
                            local mPos = targetMonster.HumanoidRootPart.Position
                            
                            -- เน€เธยเน€เธเธ“เน€เธยเน€เธเธเน€เธโ€เน€เธโฌเน€เธเธเน€เธยเน€เธโฌเน€เธโ€ขเน€เธเธเน€เธเธเน€เธยเน€เธยเน€เธเธ’เน€เธเธเน€เธเธเน€เธเธเน€เธย (เน€เธโ€ขเน€เธเธ‘เน€เธโ€เน€เธยเน€เธยเน€เธย Y เน€เธเธเน€เธเธเน€เธยเน€เธโฌเน€เธยเน€เธเธ—เน€เธยเน€เธเธเน€เธยเน€เธเธเน€เธยเน€เธยเน€เธเธเน€เธยเน€เธยเน€เธเธเน€เธโ€เน€เธเธ”เน€เธยเน€เธโ€ขเน€เธเธ’เน€เธเธเน€เธเธเน€เธเธเน€เธเธเน€เธยเน€เธยเน€เธเธเน€เธโฌเน€เธยเน€เธเธเน€เธยเน€เธเธเน€เธยเน€เธเธเน€เธเธเน€เธย)
                            local flatLook = Vector3.new(mCFrame.LookVector.X, 0, mCFrame.LookVector.Z)
                            if flatLook.Magnitude > 0.001 then
                                flatLook = flatLook.Unit
                            else
                                flatLook = Vector3.new(0, 0, -1)
                            end
                            
                            -- เน€เธยเน€เธยเน€เธเธเน€เธเธเน€เธเธเน€เธยเน€เธโ€เน€เธยเน€เธเธ’เน€เธยเน€เธเธเน€เธเธ…เน€เธเธ‘เน€เธยเน€เธเธเน€เธเธเน€เธยเน€เธเธเน€เธโฌเน€เธโ€ขเน€เธเธเน€เธเธเน€เธย 5 Studs เน€เธยเน€เธเธ…เน€เธเธเน€เธเธเน€เธเธ‘เน€เธยเน€เธเธเน€เธยเน€เธยเน€เธเธ’เน€เธโฌเน€เธยเน€เธยเน€เธเธ’เน€เธเธเน€เธเธ’เน€เธเธเน€เธเธเน€เธย
                            local behindPos = mPos - (flatLook * 5)
                            
                            -- เน€เธเธเน€เธเธ‘เน€เธยเน€เธโฌเน€เธโ€เน€เธโ€ข CFrame (เน€เธเธเน€เธเธเน€เธเธเน€เธยเน€เธเธเน€เธเธเน€เธโ€เน€เธเธ‘เน€เธยเน€เธโฌเน€เธโ€เน€เธเธ•เน€เธเธเน€เธเธเน€เธยเน€เธเธ‘เน€เธยเน€เธเธเน€เธเธเน€เธยเน€เธเธเน€เธโฌเน€เธโ€ขเน€เธเธเน€เธเธเน€เธย เน€เธยเน€เธโ€ขเน€เธยเน€เธโ€“เน€เธเธเน€เธเธเน€เธเธเน€เธเธ…เน€เธเธ‘เน€เธยเน€เธยเน€เธย 5 Studs)
                            hrp.CFrame = CFrame.new(behindPos, mPos)
                        end
                        hrp.Velocity = Vector3.new(0, 0, 0)
                    end
                elseif not targetMonster then
                    -- เน€เธเธเน€เธเธ’เน€เธยเน€เธเธเน€เธยเน€เธโฌเน€เธยเน€เธเธเน€เธเธเน€เธเธเน€เธยเน€เธเธเน€เธโฌเน€เธโ€ขเน€เธเธเน€เธเธเน€เธย เน€เธเธเน€เธเธ’เน€เธยเน€เธโฌเน€เธยเน€เธยเน€เธยเน€เธโฌเน€เธยเน€เธเธเน€เธเธ’เน€เธเธเน€เธเธเน€เธเธเน€เธเธเน€เธยเน€เธยเน€เธยเน€เธเธ…เน€เธเธเน€เธยเน€เธเธเน€เธย (เน€เธโฌเน€เธยเน€เธยเน€เธย เน€เธโฌเน€เธยเน€เธเธ”เน€เธยเน€เธยเน€เธเธเน€เธเธเน€เธยเน€เธยเน€เธเธ’เน€เธย Trial/Raid)
                    local activeMapKey = _G.SelectedQuestKey
                    local qData = QuestData[activeMapKey]
                    if qData and qData.Module then
                        local mode = ""
                        pcall(function()
                            mode = game:GetService("Players").LocalPlayer:GetAttribute("Mode") or ""
                        end)
                        if mode ~= qData.Module then
                            if mode == "Trade" or mode == "TowerCity" then
                                -- เน€เธเธ…เน€เธเธเน€เธยเน€เธยเน€เธยเน€เธยเน€เธเธเน€เธเธเน€เธยเน€เธโ€”เน€เธเธ‘เน€เธเธ…เน€เธโฌเน€เธยเน€เธเธ—เน€เธยเน€เธเธเน€เธยเน€เธเธ…เน€เธเธ‘เน€เธยเน€เธเธเน€เธยเน€เธยเน€เธเธ’ Lobby เน€เธยเน€เธยเน€เธเธเน€เธย
                                pcall(function()
                                    local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                                    if hrp then
                                        local mapFolder = workspace:FindFirstChild("Server") and workspace.Server:FindFirstChild(mode)
                                        if mapFolder then
                                            for _, v in ipairs(mapFolder:GetDescendants()) do
                                                if v:IsA("BasePart") and (string.match(string.lower(v.Name), "portal") or string.match(string.lower(v.Name), "exit") or string.match(string.lower(v.Name), "leave")) then
                                                    hrp.CFrame = v.CFrame
                                                    task.wait(0.5)
                                                end
                                            end
                                        end
                                    end
                                    SafeUITeleport("StarterTown")
                                end)
                                task.wait(3)
                            else
                                pcall(function()
                                    SafeUITeleport(qData.Module)
                                end)
                                task.wait(2.5)
                            end
                        end
                    end
                end
            end
        end
    end,
})

local function parseCoins(val)
    if type(val) == "number" then return val end
    local str = tostring(val)
    str = string.gsub(str, ",", "")
    local numStr = string.match(str, "^[%d%.]+")
    if not numStr then return 0 end
    local num = tonumber(numStr) or 0
    local upperStr = string.upper(str)
    if string.match(upperStr, "K") then num = num * 1000 
    elseif string.match(upperStr, "M") then num = num * 1000000
    elseif string.match(upperStr, "B") then num = num * 1000000000 end
    return num
end

Tab_Autofarm:CreateToggle({
    Name = "Auto Next Map",
    CurrentValue = false,
    Flag = "Toggle_AutoNextMap",
    Callback = function(Value)
        _G.AutoNextMap = Value
        local Bridge = game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("Bridge")
        
        while _G.AutoNextMap do
            task.wait(1)
            
            pcall(function()
                -- เน€เธโ€“เน€เธยเน€เธเธ’เน€เธยเน€เธเธเน€เธยเน€เธยเน€เธโ€เน€เธยเน€เธโฌเน€เธยเน€เธเธ”เน€เธโ€ AutoQuest เน€เธเธเน€เธเธเน€เธเธเน€เธย เน€เธยเน€เธยเน€เธยเน€เธเธเน€เธยเน€เธโ€ขเน€เธยเน€เธเธเน€เธยเน€เธโ€”เน€เธเธ“เน€เธเธเน€เธเธเน€เธยเน€เธเธ
                if not _G.AutoQuestFarm then return end
                
                local activeMapKey = _G.SelectedQuestKey
                
                -- เน€เธเธเน€เธเธ’ Index เน€เธยเน€เธเธเน€เธยเน€เธยเน€เธเธเน€เธยเน€เธยเน€เธเธ‘เน€เธยเน€เธยเน€เธเธเน€เธยเน€เธเธ‘เน€เธย
                local currentIndex = 0
                for i, mapName in ipairs(MapOrderList) do
                    if mapName == activeMapKey then
                        currentIndex = i
                        break
                    end
                end
                
                -- เน€เธโ€“เน€เธยเน€เธเธ’เน€เธยเน€เธเธเน€เธยเน€เธยเน€เธยเน€เธยเน€เธยเน€เธเธเน€เธยเน€เธเธเน€เธเธเน€เธโ€เน€เธโ€”เน€เธยเน€เธเธ’เน€เธเธ (เน€เธเธเน€เธเธ‘เน€เธยเน€เธเธเน€เธเธ•เน€เธยเน€เธเธเน€เธยเน€เธโ€“เน€เธเธ‘เน€เธโ€เน€เธยเน€เธย)
                if currentIndex > 0 and currentIndex < #MapOrderList then
                    local nextMapName = MapOrderList[currentIndex + 1]
                    local nextMapCost = MapUnlockCost[nextMapName] or math.huge
                    
                    -- เน€เธโฌเน€เธยเน€เธยเน€เธยเน€เธโฌเน€เธยเน€เธเธ”เน€เธย (Coins) เน€เธยเน€เธเธเน€เธยเน€เธเธเน€เธเธเน€เธเธเน€เธเธเน€เธยเน€เธยเน€เธยเน€เธเธเน€เธเธเน€เธยเน€เธโ€ขเน€เธเธ‘เน€เธเธเน€เธเธเน€เธเธ‘เน€เธยเน€เธเธเน€เธเธเน€เธยเน€เธเธ…เน€เธเธเน€เธเธ…เน€เธเธเน€เธยเน€เธยเน€เธยเน€เธเธ“
                    local myCoins = 0

                    if LocalPlayer:FindFirstChild("leaderstats") then
                        local c = LocalPlayer.leaderstats:FindFirstChild("Coins") or LocalPlayer.leaderstats:FindFirstChild("เนยโ€เธ Coins") or LocalPlayer.leaderstats:FindFirstChild("Yen")
                        if c then
                            myCoins = parseCoins(c.Value)
                        else
                            for _, stat in ipairs(LocalPlayer.leaderstats:GetChildren()) do
                                if string.match(stat.Name, "Coins") or string.match(stat.Name, "Yen") then
                                    myCoins = parseCoins(stat.Value)
                                    break
                                end
                            end
                        end
                    end
                    
                    if myCoins >= nextMapCost then
                        local moduleName = nextMapName
                        if QuestData and QuestData[nextMapName] and QuestData[nextMapName].Module then
                            moduleName = QuestData[nextMapName].Module
                        end
                        
                        -- เน€เธเธ…เน€เธเธเน€เธยเน€เธเธเน€เธเธ”เน€เธย Remote เน€เธยเน€เธเธ—เน€เธยเน€เธเธเน€เธโ€เน€เธยเน€เธเธ’เน€เธยเน€เธโ€”เน€เธเธเน€เธยเน€เธเธเน€เธเธเน€เธยเน€เธยเน€เธยเน€เธยเน€เธโ€”เน€เธเธ•เน€เธยเน€เธโฌเน€เธยเน€เธยเน€เธยเน€เธยเน€เธยเน€เธยเน€เธโ€เน€เธย
                        local remotesToTry = {moduleName, nextMapName, string.upper(moduleName), string.lower(moduleName)}
                        for _, name in ipairs(remotesToTry) do
                            pcall(function() Bridge:FireServer("General", "Portal", "Buy", name) end)
                            pcall(function() Bridge:FireServer("General", "Portal", "Unlock", name) end)
                            pcall(function() Bridge:FireServer("Portal", "Buy", name) end)
                        end
                        
                        -- เน€เธยเน€เธเธ‘เน€เธยเน€เธยเน€เธเธ‘เน€เธยเน€เธเธเน€เธเธ’เน€เธเธเน€เธยเน€เธยเน€เธยเน€เธเธ…เน€เธเธ‘เน€เธยเน€เธยเน€เธย Lobby เน€เธโฌเน€เธยเน€เธเธ—เน€เธยเน€เธเธเน€เธโฌเน€เธโ€เน€เธเธ”เน€เธยเน€เธยเน€เธยเน€เธยเน€เธเธ—เน€เธยเน€เธเธเน€เธโ€”เน€เธเธ•เน€เธยเน€เธเธเน€เธยเน€เธยเน€เธเธ’ Portal เน€เธยเน€เธยเน€เธเธเน€เธยเน€เธยเน€เธเธ‘เน€เธยเน€เธยเน€เธเธ‘เน€เธย
                        pcall(function() SafeUITeleport("Lobby") end)
                        task.wait(3.5)
                        
                        -- เน€เธโ€เน€เธเธ‘เน€เธยเน€เธเธเน€เธเธเน€เธยเน€เธเธ…เน€เธเธ”เน€เธยเน€เธยเน€เธเธเน€เธยเน€เธเธ Buy / Unlock เน€เธยเน€เธยเน€เธเธเน€เธยเน€เธยเน€เธเธ’เน€เธยเน€เธเธ (เน€เธโฌเน€เธยเน€เธเธ—เน€เธยเน€เธเธเน€เธโฌเน€เธยเน€เธเธเน€เธโฌเน€เธโ€เน€เธยเน€เธยเน€เธเธเน€เธยเน€เธยเน€เธเธ’เน€เธโ€ขเน€เธยเน€เธเธ’เน€เธยเน€เธเธเน€เธเธ—เน€เธยเน€เธเธเน€เธเธ‘เน€เธยเน€เธยเน€เธเธ’เน€เธเธเน€เธยเน€เธเธ—เน€เธยเน€เธเธเน€เธยเน€เธเธ–เน€เธยเน€เธยเน€เธเธเน€เธเธ’)
                        task.spawn(function()
                            for i = 1, 15 do
                                pcall(function()
                                    if LocalPlayer and LocalPlayer:FindFirstChild("PlayerGui") then
                                        for _, obj in ipairs(LocalPlayer.PlayerGui:GetDescendants()) do
                                            if obj:IsA("TextButton") and obj.Text ~= "" then
                                                local txt = string.lower(obj.Text)
                                                if string.find(txt, "buy") or string.find(txt, "unlock") or string.find(txt, "purchase") or string.find(txt, "yes") then
                                                    if getconnections then
                                                        for _, conn in ipairs(getconnections(obj.MouseButton1Click)) do
                                                            conn:Fire()
                                                        end
                                                    end
                                                end
                                            end
                                        end
                                    end
                                end)
                                task.wait(0.5)
                            end
                        end)
                        
                        -- เน€เธโฌเน€เธยเน€เธเธ…เน€เธเธ•เน€เธยเน€เธเธเน€เธยเน€เธโ€ขเน€เธเธ‘เน€เธเธเน€เธโฌเน€เธเธ…เน€เธเธ—เน€เธเธเน€เธยเน€เธโฌเน€เธยเน€เธยเน€เธเธ’เน€เธเธเน€เธเธเน€เธเธ’เน€เธเธเน€เธยเน€เธยเน€เธยเน€เธเธเน€เธยเน€เธยเน€เธเธเน€เธเธเน€เธย
                        _G.SelectedQuestKey = nextMapName
                        if MapDropdown then
                            MapDropdown:Set({nextMapName})
                        end
                        
                        -- เน€เธเธเน€เธเธ•เน€เธโฌเน€เธยเน€เธยเน€เธโ€ขเน€เธเธเน€เธโ€“เน€เธเธ’เน€เธยเน€เธเธเน€เธเธเน€เธยเน€เธเธ’เน€เธโฌเน€เธยเน€เธเธ…เน€เธเธ•เน€เธเธเน€เธเธเน€เธยเน€เธโ€เน€เธยเน€เธเธ’เน€เธยเน€เธยเน€เธเธ…เน€เธยเน€เธเธ เน€เธโฌเน€เธยเน€เธเธ—เน€เธยเน€เธเธเน€เธยเน€เธเธเน€เธย AutoQuest เน€เธโ€”เน€เธเธ“เน€เธยเน€เธเธ’เน€เธยเน€เธยเน€เธเธ‘เน€เธยเน€เธโ€เน€เธยเน€เธเธ’เน€เธยเน€เธยเน€เธเธเน€เธเธเน€เธย
                        _G.IsCurrentMapFinished = false
                    end
                end
            end)
        end
    end,
})

local Section_Trial = Tab_Trial:CreateSection("Trial Settings")

Tab_Trial:CreateSlider({
    Name = "Max Trial Wave",
    Range = {0, 100},
    Increment = 1,
    Suffix = "Wave (0 = Unlimited)",
    CurrentValue = 0,
    Flag = "Slider_MaxTrialWave",
    Callback = function(Value)
        _G.MaxTrialWave = Value
    end,
})

Tab_Trial:CreateToggle({
    Name = "Auto Leave at Max Wave",
    CurrentValue = false,
    Flag = "Toggle_AutoLeaveTrial",
    Callback = function(Value)
        _G.AutoLeaveTrial = Value
        if Value then
            task.spawn(function()
                while _G.AutoLeaveTrial do
                    task.wait(1)
                    
                    local inTrialMode = false
                    pcall(function()
                        local mode = game:GetService("Players").LocalPlayer:GetAttribute("Mode")
                        if mode and string.find(string.lower(mode), "trial") then
                            inTrialMode = true
                        end
                    end)
                    
                    if inTrialMode then
                        local currentWave = 1
                        pcall(function()
                            local rsTrial = game:GetService("ReplicatedStorage"):FindFirstChild("Gamemodes")
                            if rsTrial and rsTrial:FindFirstChild("Trial") and rsTrial.Trial:FindFirstChild("Wave") then
                                currentWave = tonumber(rsTrial.Trial.Wave.Value) or currentWave
                            end
                            if currentWave == 1 then
                                local trialUI = game:GetService("Players").LocalPlayer.PlayerGui:FindFirstChild("Trial")
                                if trialUI and trialUI:FindFirstChild("Frame") and trialUI.Frame:FindFirstChild("Wave") then
                                    local w = string.match(trialUI.Frame.Wave.Text, "%d+")
                                    if w then currentWave = tonumber(w) end
                                else
                                    for _, obj in ipairs(game:GetService("Players").LocalPlayer.PlayerGui:GetDescendants()) do
                                        if obj:IsA("TextLabel") and obj.Visible then
                                            local lowerText = string.lower(obj.Text)
                                            if string.find(lowerText, "wave") and not string.find(lowerText, "next") and not string.find(lowerText, "in") then
                                                local w = string.match(lowerText, "wave%s*:?%s*(%d+)")
                                                if not w then w = string.match(obj.Text, "%d+") end
                                                if w then currentWave = tonumber(w) break end
                                            end
                                        end
                                    end
                                end
                            end
                        end)
                        
                        local maxWave = _G.MaxTrialWave or 999
                        if maxWave <= 0 then maxWave = 999 end
                        
                        if currentWave >= maxWave then
                            local hrp = game:GetService("Players").LocalPlayer.Character and game:GetService("Players").LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                            if hrp then
                                pcall(function()
                                    local Bridge = game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("Bridge")
                                    Bridge:FireServer("Gamemodes", "Trial", "Leave")
                                    Bridge:FireServer("Gamemodes", "Trial", "Claim")
                                    Bridge:FireServer("Gamemodes", "Trial", "Exit")
                                end)
                                
                                pcall(function()
                                    local lp = game:GetService("Players").LocalPlayer
                                    if lp and lp:FindFirstChild("PlayerGui") then
                                        for _, obj in ipairs(lp.PlayerGui:GetDescendants()) do
                                            if obj:IsA("TextButton") and obj.Text ~= "" then
                                                local lowerText = string.lower(obj.Text)
                                                local cleanText = string.gsub(lowerText, "^%s*(.-)%s*$", "%1")
                                                if cleanText == "leave" or cleanText == "claim" or cleanText == "exit" or cleanText == "continue" or cleanText == "claim rewards" then
                                                    local isVisible = true
                                                    local parent = obj
                                                    while parent and parent:IsA("GuiObject") do
                                                        if not parent.Visible then isVisible = false break end
                                                        parent = parent.Parent
                                                    end
                                                    if isVisible and getconnections then
                                                        for _, conn in ipairs(getconnections(obj.MouseButton1Click)) do
                                                            conn:Fire()
                                                        end
                                                    end
                                                end
                                            end
                                        end
                                    end
                                end)
                                
                                task.wait(1.5)
                                
                                pcall(function()
                                    local hrp2 = game:GetService("Players").LocalPlayer.Character and game:GetService("Players").LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                                    if hrp2 then
                                        local trialMap = workspace:FindFirstChild("Server") and workspace.Server:FindFirstChild("Trial")
                                        if trialMap then
                                            for _, v in ipairs(trialMap:GetDescendants()) do
                                                local vName = string.lower(v.Name)
                                                if v:IsA("ProximityPrompt") or ((string.match(vName, "exit") or string.match(vName, "leave")) and not string.match(vName, "trade")) then
                                                    local target = v:IsA("ProximityPrompt") and v.Parent or v
                                                    if target and (target:IsA("BasePart") or target:IsA("Model")) then
                                                        hrp2.CFrame = target:IsA("Model") and target:GetPivot() or target.CFrame
                                                        task.wait(0.5)
                                                        if v:IsA("ProximityPrompt") and fireproximityprompt then
                                                            fireproximityprompt(v)
                                                        end
                                                        break
                                                    end
                                                end
                                            end
                                        end
                                    end
                                end)
                                
                                -- เน€เธเธเน€เธเธเน€เธยเน€เธเธเน€เธยเน€เธโฌเน€เธยเน€เธเธ”เน€เธเธเน€เธยเน€เธยเน€เธโฌเน€เธเธเน€เธเธเน€เธเธเน€เธยเน€เธยเน€เธเธเน€เธเธ…เน€เธโ€เน€เธโ€ขเน€เธเธ‘เน€เธเธเน€เธเธ…เน€เธเธเน€เธยเน€เธเธเน€เธยเน€เธเธ…เน€เธเธ‘เน€เธยเน€เธยเน€เธยเน€เธโ€”เน€เธเธ•เน€เธย Lobby เน€เธยเน€เธยเน€เธเธเน€เธยเน€เธเธเน€เธเธ’เน€เธเธเน€เธยเน€เธยเน€เธยเน€เธเธ…เน€เธเธ‘เน€เธย Quest Map เน€เธยเน€เธยเน€เธเธเน€เธยเน€เธยเน€เธเธ‘เน€เธยเน€เธยเน€เธเธ‘เน€เธยเน€เธโ€เน€เธเธ–เน€เธยเน€เธยเน€เธเธ…เน€เธเธ‘เน€เธยเน€เธยเน€เธยเน€เธยเน€เธเธ…เน€เธเธ‘เน€เธยเน€เธเธเน€เธเธ’
                                local waitCount = 0
                                while _G.AutoLeaveTrial and waitCount < 30 do
                                    task.wait(1)
                                    waitCount = waitCount + 1
                                    local currentMode = ""
                                    pcall(function()
                                        currentMode = game:GetService("Players").LocalPlayer:GetAttribute("Mode")
                                    end)
                                    
                                    local isTrial = false
                                    if currentMode and currentMode ~= "" and string.find(string.lower(tostring(currentMode)), "trial") then
                                        isTrial = true
                                    end
                                    
                                    if currentMode and currentMode ~= "" and not isTrial then
                                        local targetMap = _G.SelectedQuestKey or "LevelingCity"
                                        local qData = QuestData[targetMap]
                                        
                                        local TeleportFunc = function(dest)
                                            pcall(function() game:GetService("ReplicatedStorage").Gamemodes.WorldTeleport.Teleport:FireServer(dest) end)
                                        end
                                        
                                        if qData and qData.Module then
                                            TeleportFunc(qData.Module)
                                        else
                                            TeleportFunc("LevelingCity")
                                        end
                                        break
                                    end
                                end
                            end
                        end
                    end
                end
            end)
        end
    end,
})

local AutoTrialToggle = Tab_Trial:CreateToggle({
    Name = "Auto Farm Trial",
    CurrentValue = false,
    Flag = "Toggle_AutoTrial",
    Callback = function(Value)
        _G.AutoTrial = Value
        local Bridge = game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("Bridge")
        
        -- เน€เธโ€ขเน€เธเธ‘เน€เธเธเน€เธยเน€เธยเน€เธเธเน€เธโฌเน€เธยเน€เธยเน€เธยเน€เธยเน€เธเธเน€เธเธเน€เธเธเน€เธเธ‘เน€เธโ€ขเน€เธเธ”เน€เธยเน€เธเธ’เน€เธเธเน€เธเธ…เน€เธย Trial เน€เธโฌเน€เธยเน€เธเธ—เน€เธยเน€เธเธเน€เธยเน€เธเธเน€เธยเน€เธยเน€เธเธเน€เธยเน€เธเธ…เน€เธยเน€เธยเน€เธยเน€เธเธ“เน€เธยเน€เธยเน€เธเธเน€เธเธเน€เธยเน€เธโฌเน€เธเธเน€เธเธ…เน€เธเธ’เน€เธโฌเน€เธโ€เน€เธเธ”เน€เธเธ
        _G.LastTrialCompletedHour = _G.LastTrialCompletedHour or -1
        _G.LastTrialCompletedHalf = _G.LastTrialCompletedHalf or -1
        _G.HasJoinedTrialLobby = false
        
        while _G.AutoTrial do
            task.wait(1)
            
            
            local inTrialMode = false
            pcall(function()
                local ps = LocalPlayer:FindFirstChild("PlayerScripts")
                if ps and ps:FindFirstChild("Scripts") and ps.Scripts:FindFirstChild("Client") and ps.Scripts.Client:FindFirstChild("Main") then
                    local Main = require(ps.Scripts.Client.Main)
                    if Main and Main.Player then
                        local mode = Main.Player:GetAttribute("Mode")
                        if mode then
                            local modeLower = string.lower(mode)
                            if string.find(modeLower, "towerraid") or string.find(modeLower, "raid") then
                                inTrialMode = false
                            elseif string.find(modeLower, "trial") or string.find(modeLower, "gamemode") then
                                inTrialMode = true
                            end
                        end
                        -- เน€เธยเน€เธยเน€เธเธเน€เธยเน€เธยเน€เธเธ‘เน€เธยเน€เธยเน€เธเธ’เน€เธเธเน€เธเธเน€เธเธ‘เน€เธยเน€เธเธเน€เธยเน€เธเธเน€เธเธเน€เธเธเน€เธเธเน€เธยเน€เธเธ’เน€เธยเน€เธโ€เน€เธยเน€เธเธ’เน€เธย
                        if workspace:FindFirstChild("Server") and workspace.Server:FindFirstChild("TowerRaid") then
                            inTrialMode = false
                        elseif workspace:FindFirstChild("Server") and workspace.Server:FindFirstChild("Trial") then
                            inTrialMode = true
                        end
                        if mode == "Lobby" or mode == "Town" or mode == "Trade" then
                            _G.InTrialFlag = false
                            inTrialMode = false
                        end
                    end
                end
            end)
            
            if _G.InTrialFlag then
                inTrialMode = true
                -- เน€เธโ€ขเน€เธเธเน€เธเธเน€เธยเน€เธเธเน€เธเธเน€เธยเน€เธเธเน€เธยเน€เธเธ’เน€เธโ€“เน€เธยเน€เธเธ’เน€เธยเน€เธเธ…เน€เธเธ‘เน€เธยเน€เธเธเน€เธเธ’เน€เธเธเน€เธเธเน€เธเธเน€เธยเน€เธเธเน€เธยเน€เธยเน€เธเธ’เน€เธยเน€เธเธเน€เธเธเน€เธโ€ขเน€เธเธเน€เธยเน€เธเธ…เน€เธยเน€เธเธ (เน€เธโ€ขเน€เธเธ’เน€เธเธ/เน€เธยเน€เธยเน€เธเธเน€เธเธเน€เธย) เน€เธยเน€เธเธเน€เธยเน€เธเธเน€เธยเน€เธโฌเน€เธเธ…เน€เธเธ”เน€เธย Flag
                local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                if hrp then
                    pcall(function()
                        local trialDoor = workspace:FindFirstChild("Server") and workspace.Server:FindFirstChild("Misc_Teleports") and workspace.Server.Misc_Teleports:FindFirstChild("Trial_Join")
                        if not trialDoor then
                            trialDoor = workspace:FindFirstChild("Server") and workspace.Server:FindFirstChild("Trial") and workspace.Server.Trial:FindFirstChild("Lobby") and workspace.Server.Trial.Lobby:FindFirstChild("Door")
                        end
                        if trialDoor then
                            local targetPos
                            if trialDoor:IsA("Model") then
                                targetPos = trialDoor.PrimaryPart and trialDoor.PrimaryPart.Position or trialDoor:GetPivot().Position
                            else
                                targetPos = trialDoor.Position
                            end
                            
                            if targetPos and (hrp.Position - targetPos).Magnitude < 100 then
                                inTrialMode = false
                                _G.InTrialFlag = false
                            end
                        end
                    end)
                end
            end
            
            local currentTime = os.date("*t")
            local min = currentTime.min
            local hour = currentTime.hour
            
            -- เน€เธยเน€เธยเน€เธเธเน€เธยเน€เธโฌเน€เธเธเน€เธเธ…เน€เธเธ’เน€เธโ€”เน€เธเธ•เน€เธยเน€เธโ€เน€เธเธ‘เน€เธยเน€เธโฌเน€เธยเน€เธเธ•เน€เธยเน€เธเธเน€เธยเน€เธโฌเน€เธยเน€เธเธ”เน€เธโ€เน€เธยเน€เธเธ—เน€เธเธเน€เธโ€ขเน€เธยเน€เธยเน€เธยเน€เธเธ‘เน€เธยเน€เธเธเน€เธยเน€เธเธเน€เธย (XX:00) เน€เธยเน€เธเธ…เน€เธเธเน€เธยเน€เธเธเน€เธเธ–เน€เธยเน€เธยเน€เธยเน€เธเธ‘เน€เธยเน€เธเธเน€เธยเน€เธเธเน€เธย (XX:30)
            -- เน€เธโฌเน€เธเธเน€เธเธ’เน€เธยเน€เธเธเน€เธโ€เน€เธเธ‘เน€เธยเน€เธเธเน€เธเธเน€เธยเน€เธยเน€เธเธเน€เธย XX:58 เน€เธโ€“เน€เธเธ–เน€เธย XX:03 เน€เธยเน€เธเธ…เน€เธเธ XX:28 เน€เธโ€“เน€เธเธ–เน€เธย XX:33
            local isTrialWindow = false
            local currentHalf = 0
            
            if (min >= 59 or min <= 1) then
                isTrialWindow = true
                currentHalf = 0
            elseif (min >= 29 and min <= 31) then
                isTrialWindow = true
                currentHalf = 1
            end
            
            local trackHour = hour
            if min >= 59 then
                trackHour = (hour + 1) % 24
            end
            
            local alreadyCompleted = (_G.LastTrialCompletedHour == trackHour and _G.LastTrialCompletedHalf == currentHalf)
            
            _G.IsTrialActive = inTrialMode or (isTrialWindow and not alreadyCompleted)
            
            if not inTrialMode then
                if isTrialWindow and not alreadyCompleted then
                    -- เน€เธโฌเน€เธยเน€เธยเน€เธยเน€เธเธเน€เธยเน€เธเธ’เน€เธโ€ขเน€เธเธ”เน€เธโ€เน€เธเธเน€เธเธเน€เธเธเน€เธยเน€เธยเน€เธย Raid เน€เธเธเน€เธเธเน€เธเธ—เน€เธเธเน€เธยเน€เธเธเน€เธย
                    local isInRaid = false
                    pcall(function()
                        local mode = game:GetService("Players").LocalPlayer:GetAttribute("Mode")
                        if mode and string.find(string.lower(mode), "towerraid") then
                            isInRaid = true
                        end
                    end)
                    
                    
                    -- เน€เธโ€“เน€เธยเน€เธเธ’เน€เธยเน€เธเธเน€เธยเน€เธยเน€เธโ€เน€เธยเน€เธเธเน€เธเธเน€เธเธเน€เธยเน€เธยเน€เธย Raid เน€เธเธเน€เธเธเน€เธเธ—เน€เธเธเน€เธโ€“เน€เธเธ–เน€เธยเน€เธโฌเน€เธเธเน€เธเธ…เน€เธเธ’เน€เธโ€ขเน€เธยเน€เธเธเน€เธยเน€เธยเน€เธเธ‘เน€เธยเน€เธยเน€เธเธ‘เน€เธยเน€เธเธเน€เธเธเน€เธยเน€เธยเน€เธเธ…เน€เธยเน€เธเธ
                    pcall(function()
                        if isInRaid then
                            Bridge:FireServer("Gamemodes", "TowerRaid", "Leave")
                            Bridge:FireServer("Gamemodes", "TowerRaid", "Claim")
                            Bridge:FireServer("Gamemodes", "TowerRaid", "Exit")
                                
                                local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                                if hrp then
                                    local raidMap = workspace:FindFirstChild("Server") and workspace.Server:FindFirstChild("TowerRaid")
                                    if raidMap then
                                        for _, v in ipairs(raidMap:GetDescendants()) do
                                            if v:IsA("ProximityPrompt") or string.match(string.lower(v.Name), "exit") or string.match(string.lower(v.Name), "leave") then
                                                local target = v:IsA("ProximityPrompt") and v.Parent or v
                                                if target and (target:IsA("BasePart") or target:IsA("Model")) then
                                                    hrp.CFrame = target:IsA("Model") and target:GetPivot() or target.CFrame
                                                    task.wait(0.5)
                                                    if v:IsA("ProximityPrompt") and fireproximityprompt then
                                                        fireproximityprompt(v)
                                                    end
                                                    break
                                                end
                                            end
                                        end
                                    end
                                end
                                
                                SafeUITeleport("Lobby")
                                task.wait(2)
                        end
                    end)
                    
                    -- 1. เน€เธเธเน€เธเธ‘เน€เธยเน€เธยเน€เธเธเน€เธยเน€เธยเน€เธโ€เน€เธยเน€เธเธ…เน€เธยเน€เธเธเน€เธเธเน€เธยเน€เธยเน€เธเธ•เน€เธย เน€เธยเน€เธเธ…เน€เธเธเน€เธโ€“เน€เธเธ–เน€เธยเน€เธโฌเน€เธเธเน€เธเธ…เน€เธเธ’เน€เธยเน€เธเธ…เน€เธยเน€เธเธ -> เน€เธเธเน€เธเธ’เน€เธเธเน€เธยเน€เธยเน€เธยเน€เธยเน€เธโฌเน€เธโ€ขเน€เธเธเน€เธเธ•เน€เธเธเน€เธเธเน€เธโ€ขเน€เธเธ‘เน€เธเธเน€เธโ€”เน€เธเธ•เน€เธย Lobby
                    local trialDoor = nil
                    pcall(function()
                        trialDoor = workspace.Server:FindFirstChild("Misc_Teleports") and workspace.Server.Misc_Teleports:FindFirstChild("Trial_Join")
                        if not trialDoor then
                            trialDoor = workspace.Server:FindFirstChild("Trial") and workspace.Server.Trial:FindFirstChild("Lobby") and workspace.Server.Trial.Lobby:FindFirstChild("Door")
                        end
                    end)
                    
                    if not trialDoor then
                        if not _G.HasJoinedTrialLobby then
                            local inLobby = false
                            pcall(function()
                                local ps = LocalPlayer:FindFirstChild("PlayerScripts")
                                if ps and ps:FindFirstChild("Scripts") and ps.Scripts:FindFirstChild("Client") and ps.Scripts.Client:FindFirstChild("Main") then
                                    local Main = require(ps.Scripts.Client.Main)
                                    if Main and Main.Player and Main.Player:GetAttribute("Mode") == "Lobby" then
                                        inLobby = true
                                    end
                                end
                            end)
                            
                            -- Fallback Lobby Check: If Trial_Join has loaded parts, we are in the Lobby
                            if not inLobby then
                                local td = workspace:FindFirstChild("Server") and workspace.Server:FindFirstChild("Misc_Teleports") and workspace.Server.Misc_Teleports:FindFirstChild("Trial_Join")
                                if td and td:FindFirstChildWhichIsA("BasePart", true) then
                                    inLobby = true
                                end
                            end
                            
                            if not inLobby then
                                pcall(function()
                                    SafeUITeleport("Lobby")
                                end)
                                task.wait(3)
                            else
                                -- Already in Lobby, just wait for the door to spawn at XX:00
                                task.wait(1)
                            end
                        end
                    else
                        -- เน€เธโฌเน€เธยเน€เธเธเน€เธยเน€เธเธเน€เธเธเน€เธโ€ขเน€เธเธ Trial เน€เธยเน€เธเธ…เน€เธยเน€เธเธ (เน€เธโฌเน€เธเธเน€เธเธ…เน€เธเธ’ XX:00)
                        local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                        if hrp then
                            local part = trialDoor:FindFirstChildWhichIsA("BasePart", true)
                            if part then
                                local dist = (hrp.Position - part.Position).Magnitude
                                if dist > 10 then
                                    hrp.CFrame = part.CFrame
                                    hrp.Velocity = Vector3.new(0,0,0)
                                    task.wait(0.5)
                                end
                            end
                            
                            -- เน€เธเธเน€เธเธ”เน€เธยเน€เธยเน€เธเธ“เน€เธเธเน€เธเธ‘เน€เธยเน€เธยเน€เธโฌเน€เธยเน€เธยเน€เธเธ’ Trial เน€เธเธเน€เธเธ‘เน€เธเธเน€เธย เน€เธโ€”เน€เธเธเน€เธย 2 เน€เธเธเน€เธเธ”เน€เธยเน€เธเธ’เน€เธโ€”เน€เธเธ• เน€เธยเน€เธยเน€เธยเน€เธเธเน€เธยเน€เธเธ’เน€เธยเน€เธเธเน€เธยเน€เธโ€เน€เธยเน€เธโ€เน€เธเธ–เน€เธยเน€เธโฌเน€เธยเน€เธยเน€เธเธ’เน€เธเธเน€เธยเน€เธเธเน€เธย (inTrialMode เน€เธยเน€เธเธเน€เธยเน€เธเธ…เน€เธเธ’เน€เธเธเน€เธโฌเน€เธยเน€เธยเน€เธย true เน€เธยเน€เธเธ…เน€เธเธเน€เธเธเน€เธเธเน€เธเธเน€เธโ€เน€เธเธ…เน€เธเธเน€เธยเน€เธยเน€เธเธ•เน€เธยเน€เธโฌเน€เธเธเน€เธย)
                            pcall(function()
                                local prompt = trialDoor:FindFirstChildWhichIsA("ProximityPrompt", true)
                                if prompt and fireproximityprompt then
                                    fireproximityprompt(prompt)
                                end
                                Bridge:FireServer("Gamemodes", "Trial", "Join")
                                _G.InTrialFlag = true -- เน€เธโ€ขเน€เธเธ‘เน€เธยเน€เธยเน€เธยเน€เธยเน€เธเธ’เน€เธเธเน€เธยเน€เธเธ’เน€เธโฌเน€เธยเน€เธยเน€เธเธ’เน€เธยเน€เธยเน€เธยเน€เธย Trial เน€เธยเน€เธเธ…เน€เธยเน€เธเธ
                                
                                local confirmUI = LocalPlayer.PlayerGui:FindFirstChild("Confirmation")
                                if confirmUI and confirmUI.Enabled then
                                    confirmUI.Enabled = false
                                end
                            end)
                            
                            task.wait(2)
                        end
                    end
                else
                    if _G.WasInTrial then
                        local safeToWarp = false
                        local mode = ""
                        pcall(function()
                            mode = game:GetService("Players").LocalPlayer:GetAttribute("Mode")
                        end)
                        if mode == "Lobby" or mode == "Town" or mode == "Trade" or mode == "TowerCity" then
                            safeToWarp = true
                        end
                        
                        -- Fallback just in case Mode isn't set
                        if not safeToWarp then
                            local trialMap = workspace:FindFirstChild("Server") and workspace.Server:FindFirstChild("Trial") and workspace.Server.Trial:FindFirstChild("Map")
                            if not trialMap then
                                safeToWarp = true
                            end
                        end
                        
                        if safeToWarp then
                            _G.WasInTrial = false
                            _G.HasJoinedTrialLobby = false
                            
                            -- Teleport back to selected map when exiting Trial
                            if _G.SelectedQuestKey then
                                local activeMapKey = _G.SelectedQuestKey
                                local qData = QuestData[activeMapKey]
                                if qData and qData.Module then
                                    pcall(function()
                                        SafeUITeleport(qData.Module)
                                    end)
                                    task.wait(2.5)
                                end
                            end
                        end
                    end
                end
            else
                _G.WasInTrial = true
                _G.HasJoinedTrialLobby = false
                
                -- เน€เธยเน€เธเธเน€เธเธเน€เธโ€”เน€เธเธ‘เน€เธยเน€เธโ€ขเน€เธเธเน€เธเธ’เน€เธเธเน€เธยเน€เธเธ’เน€เธเธ…เน€เธยเน€เธเธเน€เธเธ“เน€เธโฌเน€เธเธเน€เธยเน€เธยเน€เธยเน€เธเธ…เน€เธยเน€เธเธเน€เธโ€ขเน€เธเธ‘เน€เธยเน€เธยเน€เธยเน€เธโ€ขเน€เธยเน€เธโฌเน€เธเธเน€เธเธ”เน€เธยเน€เธเธเน€เธโฌเน€เธยเน€เธยเน€เธเธ’เน€เธโฌเน€เธเธ…เน€เธเธ เน€เธยเน€เธยเน€เธเธเน€เธยเน€เธยเน€เธเธ‘เน€เธยเน€เธยเน€เธเธ‘เน€เธยเน€เธโฌเน€เธยเน€เธยเน€เธเธ’เน€เธยเน€เธยเน€เธเธ“
                _G.LastTrialCompletedHour = trackHour
                _G.LastTrialCompletedHalf = currentHalf
                
                local currentWave = 1
                pcall(function()
                    local rsTrial = game:GetService("ReplicatedStorage"):FindFirstChild("Gamemodes")
                    if rsTrial and rsTrial:FindFirstChild("Trial") and rsTrial.Trial:FindFirstChild("Wave") then
                        currentWave = tonumber(rsTrial.Trial.Wave.Value) or currentWave
                    end
                    
                    if currentWave == 1 then
                        local trialUI = game:GetService("Players").LocalPlayer.PlayerGui:FindFirstChild("Trial")
                        if trialUI and trialUI:FindFirstChild("Frame") and trialUI.Frame:FindFirstChild("Wave") then
                            local w = string.match(trialUI.Frame.Wave.Text, "%d+")
                            if w then currentWave = tonumber(w) end
                        else
                            for _, obj in ipairs(game:GetService("Players").LocalPlayer.PlayerGui:GetDescendants()) do
                                if obj:IsA("TextLabel") and obj.Visible then
                                    local lowerText = string.lower(obj.Text)
                                    if string.find(lowerText, "wave") and not string.find(lowerText, "next") and not string.find(lowerText, "in") then
                                        local w = string.match(lowerText, "wave%s*:?%s*(%d+)")
                                        if not w then
                                            w = string.match(obj.Text, "%d+")
                                        end
                                        if w then currentWave = tonumber(w) break end
                                    end
                                end
                            end
                        end
                    end
                end)

                local trialFolder = workspace:FindFirstChild("Server") and workspace.Server:FindFirstChild("Trial")
                local trialEnemiesFolder = trialFolder and trialFolder:FindFirstChild("Enemies")
                
                if trialEnemiesFolder then
                    local targetEnemy = nil
                    local targetHRP = nil
                    local shortestDistance = math.huge
                    local playerHRP = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                    
                    for _, v in ipairs(trialEnemiesFolder:GetChildren()) do
                        local eHRP = (v:IsA("Model") and v:FindFirstChild("HumanoidRootPart")) or (v:IsA("BasePart") and v)
                        
                        local isAlive = true
                        if v:IsA("Model") and v:FindFirstChild("Humanoid") then
                            isAlive = v.Humanoid.Health > 0
                            if v.Humanoid:GetState() == Enum.HumanoidStateType.Dead then isAlive = false end
                        end
                        if v:GetAttribute("Health") ~= nil and v:GetAttribute("Health") <= 0 then isAlive = false end
                        if v:GetAttribute("Dead") == true or v:GetAttribute("Died") == true or v:GetAttribute("IsDead") == true then isAlive = false end
                        
                        if eHRP and isAlive then
                            if playerHRP then
                                local dist = (playerHRP.Position - eHRP.Position).Magnitude
                                if dist < shortestDistance then
                                    shortestDistance = dist
                                    targetEnemy = v
                                    targetHRP = eHRP
                                end
                            else
                                targetEnemy = v
                                targetHRP = eHRP
                                break
                            end
                        end
                    end
                    
                    if targetEnemy and playerHRP then
                        local mCFrame = targetHRP.CFrame
                        local mPos = targetHRP.Position
                        
                        -- เน€เธยเน€เธเธ“เน€เธยเน€เธเธเน€เธโ€เน€เธโฌเน€เธเธเน€เธยเน€เธโฌเน€เธโ€ขเน€เธเธเน€เธเธเน€เธยเน€เธยเน€เธเธ’เน€เธเธเน€เธเธเน€เธเธเน€เธย (เน€เธโ€ขเน€เธเธ‘เน€เธโ€เน€เธยเน€เธยเน€เธย Y เน€เธเธเน€เธเธเน€เธยเน€เธโฌเน€เธยเน€เธเธ—เน€เธยเน€เธเธเน€เธยเน€เธเธเน€เธยเน€เธยเน€เธเธเน€เธยเน€เธยเน€เธเธเน€เธโ€เน€เธเธ”เน€เธยเน€เธโ€ขเน€เธเธ’เน€เธเธเน€เธเธเน€เธเธเน€เธเธเน€เธยเน€เธยเน€เธเธเน€เธโฌเน€เธยเน€เธเธเน€เธยเน€เธเธเน€เธยเน€เธเธเน€เธเธเน€เธย)
                        local flatLook = Vector3.new(mCFrame.LookVector.X, 0, mCFrame.LookVector.Z)
                        if flatLook.Magnitude > 0.001 then
                            flatLook = flatLook.Unit
                        else
                            flatLook = Vector3.new(0, 0, -1)
                        end
                        
                        -- เน€เธยเน€เธยเน€เธเธเน€เธเธเน€เธเธเน€เธยเน€เธโ€เน€เธยเน€เธเธ’เน€เธยเน€เธเธเน€เธเธ…เน€เธเธ‘เน€เธยเน€เธเธเน€เธเธเน€เธยเน€เธเธเน€เธโฌเน€เธโ€ขเน€เธเธเน€เธเธเน€เธย 5 Studs เน€เธยเน€เธเธ…เน€เธเธเน€เธเธเน€เธเธ‘เน€เธยเน€เธเธเน€เธยเน€เธยเน€เธเธ’เน€เธโฌเน€เธยเน€เธยเน€เธเธ’เน€เธเธเน€เธเธ’เน€เธเธเน€เธเธเน€เธย
                        local behindPos = mPos - (flatLook * 5)
                        playerHRP.CFrame = CFrame.new(behindPos, mPos)
                        playerHRP.Velocity = Vector3.new(0, 0, 0)
                        
                        pcall(function()
                            Bridge:FireServer("Fighters", "Click", "Damage")
                            Bridge:FireServer("Fighters", "Move", "Attack", targetEnemy:GetAttribute("Location") or targetHRP.Position, targetEnemy)
                            
                            -- เน€เธเธเน€เธเธ‘เน€เธยเน€เธยเน€เธโ€ขเน€เธเธ‘เน€เธเธเน€เธเธ…เน€เธเธเน€เธยเน€เธเธเน€เธยเน€เธยเน€เธเธเน€เธโ€ขเน€เธเธ• (Attack)
                            local tool = LocalPlayer.Character:FindFirstChildOfClass("Tool") or LocalPlayer.Backpack:FindFirstChildOfClass("Tool")
                            if tool then
                                LocalPlayer.Character.Humanoid:EquipTool(tool)
                                tool:Activate()
                            end
                            
                            -- Removed VirtualUser clicking to prevent unwanted UI clicks
                            -- local vu = game:GetService("VirtualUser")
                            -- vu:CaptureController()
                            -- vu:Button1Down(Vector2.new(0,0), workspace.CurrentCamera.CFrame)
                            -- vu:Button1Up(Vector2.new(0,0), workspace.CurrentCamera.CFrame)
                        end)
                    end
                end
            end
        end
    end,
})

