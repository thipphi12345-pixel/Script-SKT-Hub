local Section_TrialMerchant = Tab_Trial:CreateSection("Trial Merchant Auto Buy")

local TrialMerchantItems = {
    "Coins I", "Stats Reroll", "Trait Reroll", 
    "Star Speed", "Exp I", "Damage I", "Luck"
}

local TrialMerchantMapping = {
    ["Trait Reroll"] = "Slot1",
    ["Stats Reroll"] = "Slot2",
    ["Coins I"] = "Slot3",
    ["Damage I"] = "Slot4",
    ["Exp I"] = "Slot5",
    ["Luck"] = "Slot6",
    ["Star Speed"] = "Slot7"
}

Tab_Trial:CreateDropdown({
    Name = "Select Trial Merchant Items",
    Options = TrialMerchantItems,
    CurrentOption = {},
    MultipleOptions = true,
    Flag = "Dropdown_TrialMerchant",
