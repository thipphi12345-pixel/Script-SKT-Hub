    DiscordBtn.Font = Enum.Font.GothamBold
    DiscordBtn.TextSize = 12
    DiscordBtn.Parent = TopHeader
    CreateCorner(DiscordBtn, 4)
    DiscordBtn.MouseButton1Click:Connect(function()
        if setclipboard then
            setclipboard("https://discord.gg/34Cfs6tRk")
        end
        pcall(function()
            game:GetService("StarterGui"):SetCore("SendNotification", {
                Title = "Discord Script",
                Text = "Copy Success!",
                Duration = 3
            })
        end)
    end)


    local Tabs = {}
    local FirstTab = true

    function Window:CreateTab(name, iconId)
        local Tab = {}
        
        local TabBtn = Instance.new("TextButton")
        TabBtn.Name = name.."_Tab"
        TabBtn.Size = UDim2.new(1, -20, 0, 35)
        TabBtn.Position = UDim2.new(0, 10, 0, 0)
        TabBtn.BackgroundColor3 = UI_Config.CardColor
        TabBtn.BackgroundTransparency = 1
        TabBtn.Text = "  " .. name
        TabBtn.TextColor3 = UI_Config.DimTextColor
        TabBtn.Font = Enum.Font.GothamBold
        TabBtn.TextSize = 14
        TabBtn.TextXAlignment = Enum.TextXAlignment.Left
        TabBtn.Parent = TabContainer
        
        -- Intro animation moved to the end of CreateTab
        CreateCorner(TabBtn, 6)
        
        local TabGradient = Instance.new("UIGradient")
        TabGradient.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 255, 255)),
            ColorSequenceKeypoint.new(1, Color3.fromRGB(150, 150, 150))
        })
        TabGradient.Rotation = 90
        TabGradient.Parent = TabBtn
        
        local TabStroke = Instance.new("UIStroke")
        TabStroke.Color = Color3.fromRGB(60, 60, 70)
        TabStroke.Transparency = 1
        TabStroke.Thickness = 1
        TabStroke.Parent = TabBtn
        
        local TabIndicator = Instance.new("Frame")
        TabIndicator.Size = UDim2.new(0, 3, 0, 20)
        TabIndicator.Position = UDim2.new(0, 0, 0.5, -10)
        TabIndicator.BackgroundColor3 = UI_Config.AccentColor
        TabIndicator.BorderSizePixel = 0
        TabIndicator.BackgroundTransparency = 1
        TabIndicator.Parent = TabBtn
        CreateCorner(TabIndicator, 2)

        local TabContent = Instance.new("ScrollingFrame")
        TabContent.Name = name.."_Content"
        TabContent.Size = UDim2.new(1, -20, 1, -60)
        TabContent.Position = UDim2.new(0, 10, 0, 55)
        TabContent.BackgroundTransparency = 1
        TabContent.ScrollBarThickness = 2
        TabContent.ScrollBarImageColor3 = UI_Config.AccentColor
        TabContent.Visible = false
        TabContent.Parent = ContentContainer

        local ContentLayout = Instance.new("UIListLayout")
        ContentLayout.SortOrder = Enum.SortOrder.LayoutOrder
        ContentLayout.Padding = UDim.new(0, 10)
        ContentLayout.Parent = TabContent

        ContentLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
            TabContent.CanvasSize = UDim2.new(0, 0, 0, ContentLayout.AbsoluteContentSize.Y + 20)
        end)

        table.insert(Tabs, {Btn = TabBtn, Content = TabContent, Indicator = TabIndicator, Stroke = TabStroke})

        TabBtn.MouseButton1Click:Connect(function()
            for _, t in ipairs(Tabs) do
                t.Content.Visible = false
                TweenService:Create(t.Btn, TweenInfo.new(0.3), {TextColor3 = UI_Config.DimTextColor, BackgroundTransparency = 1}):Play()
                TweenService:Create(t.Indicator, TweenInfo.new(0.3, Enum.EasingStyle.Quint), {Size = UDim2.new(0, 3, 0, 0), BackgroundTransparency = 1}):Play()
                TweenService:Create(t.Stroke, TweenInfo.new(0.3), {Transparency = 1}):Play()
            end
            TabContent.Visible = true
            TabContent.Position = UDim2.new(0, 30, 0, 55)
            TabContent.ScrollBarImageTransparency = 1
            TweenService:Create(TabContent, TweenInfo.new(0.4, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {Position = UDim2.new(0, 10, 0, 55), ScrollBarImageTransparency = 0}):Play()
            
            TweenService:Create(TabBtn, TweenInfo.new(0.3), {TextColor3 = UI_Config.AccentColor, BackgroundTransparency = 0.5}):Play()
            TweenService:Create(TabIndicator, TweenInfo.new(0.4, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {Size = UDim2.new(0, 3, 0, 20), BackgroundTransparency = 0}):Play()
            TweenService:Create(TabStroke, TweenInfo.new(0.3), {Transparency = 0}):Play()
        end)

        if FirstTab then
            FirstTab = false
            TabContent.Visible = true
            TabBtn.TextColor3 = UI_Config.AccentColor
            TabBtn.BackgroundTransparency = 0.5
            TabIndicator.BackgroundTransparency = 0
            TabStroke.Transparency = 0
            
            task.spawn(function()
                local ts = game:GetService("TweenService")
                ts:Create(IntroBg, TweenInfo.new(0.5), {BackgroundTransparency = 0.2}):Play()
                ts:Create(IntroLogo, TweenInfo.new(0.5), {ImageTransparency = 0}):Play()
                ts:Create(IntroText, TweenInfo.new(0.5), {TextTransparency = 0}):Play()
                task.wait(1.5)
                IntroText.Text = "ARE YOU READY FOR SKT HUB?"
                task.wait(1.5)
                
                local outTween = ts:Create(IntroText, TweenInfo.new(0.8, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {TextTransparency = 1, TextSize = 60})
                ts:Create(IntroLogo, TweenInfo.new(0.8, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {ImageTransparency = 1, Size = UDim2.new(0, 200, 0, 200)}):Play()
                ts:Create(IntroBg, TweenInfo.new(0.8), {BackgroundTransparency = 1}):Play()
                outTween:Play()
                task.wait(0.8)
                IntroGui:Destroy()
                
                MainFrame.Visible = true
                ts:Create(MainFrame, TweenInfo.new(0.6, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Size = UDim2.new(0, 750, 0, 480)}):Play()
            end)
        end

        function Tab:CreateSection(secName)
            local SecFrame = Instance.new("Frame")
            SecFrame.Size = UDim2.new(1, -10, 0, 30)
            SecFrame.BackgroundTransparency = 1
            SecFrame.Parent = TabContent
            
            local SecText = Instance.new("TextLabel")
            SecText.Size = UDim2.new(1, 0, 1, 0)
            SecText.BackgroundTransparency = 1
            SecText.Text = ">> " .. secName
            SecText.TextColor3 = UI_Config.AccentColor
            SecText.Font = Enum.Font.GothamBold
            SecText.TextSize = 15
            SecText.TextXAlignment = Enum.TextXAlignment.Left
            SecText.Parent = SecFrame
        end

        function Tab:CreateToggle(opts)
            local ToggleFrame = Instance.new("Frame")
            ToggleFrame.Size = UDim2.new(1, -10, 0, 45)
            ToggleFrame.BackgroundColor3 = UI_Config.CardColor
            ToggleFrame.Parent = TabContent
            CreateCorner(ToggleFrame, 6)

            local ToggleTitle = Instance.new("TextLabel")
            ToggleTitle.Size = UDim2.new(0.7, 0, 1, 0)
            ToggleTitle.Position = UDim2.new(0, 15, 0, 0)
            ToggleTitle.BackgroundTransparency = 1
            ToggleTitle.Text = opts.Name
            ToggleTitle.TextColor3 = UI_Config.TextColor
            ToggleTitle.Font = UI_Config.Font
            ToggleTitle.TextSize = 14
            ToggleTitle.TextXAlignment = Enum.TextXAlignment.Left
            ToggleTitle.Parent = ToggleFrame

            local ToggleBtn = Instance.new("TextButton")
            ToggleBtn.Size = UDim2.new(0, 40, 0, 20)
            ToggleBtn.Position = UDim2.new(1, -55, 0.5, -10)
            ToggleBtn.BackgroundColor3 = UI_Config.MainColor
            ToggleBtn.Text = ""
            ToggleBtn.Parent = ToggleFrame
            CreateCorner(ToggleBtn, 10)
            CreateStroke(ToggleBtn, UI_Config.DimTextColor, 1)

            local ToggleCircle = Instance.new("Frame")
            ToggleCircle.Size = UDim2.new(0, 14, 0, 14)
            ToggleCircle.Position = UDim2.new(0, 3, 0.5, -7)
            ToggleCircle.BackgroundColor3 = UI_Config.DimTextColor
            ToggleCircle.Parent = ToggleBtn
            CreateCorner(ToggleCircle, 7)

            local toggled = opts.CurrentValue or false
            if opts.Flag and ConfigManager.Config[opts.Flag] ~= nil then
                toggled = ConfigManager.Config[opts.Flag]
            end
            
            local function updateToggle(anim)
                if toggled then
                    if anim then
                        TweenService:Create(ToggleCircle, TweenInfo.new(0.2), {Position = UDim2.new(1, -17, 0.5, -7), BackgroundColor3 = UI_Config.AccentColor}):Play()
                        TweenService:Create(ToggleBtn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(UI_Config.AccentColor.R*255*0.2, UI_Config.AccentColor.G*255*0.2, UI_Config.AccentColor.B*255*0.2)}):Play()
                    else
                        ToggleCircle.Position = UDim2.new(1, -17, 0.5, -7)
                        ToggleCircle.BackgroundColor3 = UI_Config.AccentColor
                        ToggleBtn.BackgroundColor3 = Color3.fromRGB(UI_Config.AccentColor.R*255*0.2, UI_Config.AccentColor.G*255*0.2, UI_Config.AccentColor.B*255*0.2)
                    end
                else
                    if anim then
                        TweenService:Create(ToggleCircle, TweenInfo.new(0.2), {Position = UDim2.new(0, 3, 0.5, -7), BackgroundColor3 = UI_Config.DimTextColor}):Play()
                        TweenService:Create(ToggleBtn, TweenInfo.new(0.2), {BackgroundColor3 = UI_Config.MainColor}):Play()
                    else
                        ToggleCircle.Position = UDim2.new(0, 3, 0.5, -7)
                        ToggleCircle.BackgroundColor3 = UI_Config.DimTextColor
                        ToggleBtn.BackgroundColor3 = UI_Config.MainColor
                    end
                end
            end
            
            updateToggle(false)

            ToggleBtn.MouseButton1Click:Connect(function()
                toggled = not toggled
                if opts.Flag then
                    ConfigManager.Config[opts.Flag] = toggled
                    ConfigManager:Save()
                end
                updateToggle(true)
                if opts.Callback then
                    task.spawn(function()
                        opts.Callback(toggled)
                    end)
                end
            end)
            
            if opts.Callback then
                task.spawn(function()
                    opts.Callback(toggled)
                end)
            end
        end

        function Tab:CreateSlider(opts)
            local SliderFrame = Instance.new("Frame")
            SliderFrame.Size = UDim2.new(1, -10, 0, 55)
            SliderFrame.BackgroundColor3 = UI_Config.CardColor
            SliderFrame.Parent = TabContent
            CreateCorner(SliderFrame, 6)

            local SliderTitle = Instance.new("TextLabel")
            SliderTitle.Size = UDim2.new(1, -30, 0, 25)
            SliderTitle.Position = UDim2.new(0, 15, 0, 5)
            SliderTitle.BackgroundTransparency = 1
            SliderTitle.Text = opts.Name
            SliderTitle.TextColor3 = UI_Config.TextColor
            SliderTitle.Font = UI_Config.Font
            SliderTitle.TextSize = 14
            SliderTitle.TextXAlignment = Enum.TextXAlignment.Left
            SliderTitle.Parent = SliderFrame

            local SliderValue = Instance.new("TextLabel")
            SliderValue.Size = UDim2.new(0, 50, 0, 25)
            SliderValue.Position = UDim2.new(1, -65, 0, 5)
            SliderValue.BackgroundTransparency = 1
            SliderValue.Text = tostring(opts.CurrentValue or opts.Range[1]) .. (opts.Suffix and (" " .. opts.Suffix) or "")
            SliderValue.TextColor3 = UI_Config.AccentColor
            SliderValue.Font = UI_Config.Font
            SliderValue.TextSize = 14
            SliderValue.TextXAlignment = Enum.TextXAlignment.Right
            SliderValue.Parent = SliderFrame

            local SliderBg = Instance.new("TextButton")
            SliderBg.Size = UDim2.new(1, -30, 0, 6)
            SliderBg.Position = UDim2.new(0, 15, 0, 35)
            SliderBg.BackgroundColor3 = UI_Config.MainColor
            SliderBg.Text = ""
            SliderBg.Parent = SliderFrame
            CreateCorner(SliderBg, 3)

            local SliderFill = Instance.new("Frame")
            SliderFill.Size = UDim2.new(0, 0, 1, 0)
            SliderFill.BackgroundColor3 = UI_Config.AccentColor
            SliderFill.Parent = SliderBg
            CreateCorner(SliderFill, 3)

            local min, max = opts.Range[1], opts.Range[2]
            local current = opts.CurrentValue or min
            if opts.Flag and ConfigManager.Config[opts.Flag] ~= nil then
                current = ConfigManager.Config[opts.Flag]
            end
            local increment = opts.Increment or 1

            local function updateSlider(val)
                current = math.clamp(math.round(val / increment) * increment, min, max)
                local percent = (current - min) / (max - min)
                SliderFill.Size = UDim2.new(percent, 0, 1, 0)
                SliderValue.Text = tostring(current) .. (opts.Suffix and (" " .. opts.Suffix) or "")
                if opts.Flag then
                    ConfigManager.Config[opts.Flag] = current
                    ConfigManager:Save()
                end
                if opts.Callback then
                    opts.Callback(current)
                end
            end
            
            -- Set UI without triggering save initially
            local percent = (current - min) / (max - min)
            SliderFill.Size = UDim2.new(percent, 0, 1, 0)
            SliderValue.Text = tostring(current) .. (opts.Suffix and (" " .. opts.Suffix) or "")
            if opts.Callback then
                task.spawn(function()
                    opts.Callback(current)
                end)
            end

            local sliding = false
            SliderBg.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then
                    sliding = true
                    local percent = math.clamp((input.Position.X - SliderBg.AbsolutePosition.X) / SliderBg.AbsoluteSize.X, 0, 1)
                    updateSlider(min + (max - min) * percent)
                end
            end)
            
            UserInputService.InputChanged:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseMovement and sliding then
                    local percent = math.clamp((input.Position.X - SliderBg.AbsolutePosition.X) / SliderBg.AbsoluteSize.X, 0, 1)
                    updateSlider(min + (max - min) * percent)
                end
            end)
            
            UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then
                    sliding = false
                end
            end)
        end

        function Tab:CreateDropdown(opts)
            local DropFrame = Instance.new("Frame")
            DropFrame.Size = UDim2.new(1, -10, 0, 45)
            DropFrame.BackgroundColor3 = UI_Config.CardColor
            DropFrame.ClipsDescendants = true
            DropFrame.Parent = TabContent
            CreateCorner(DropFrame, 6)

            local DropTitle = Instance.new("TextLabel")
            DropTitle.Size = UDim2.new(0.5, 0, 0, 45)
            DropTitle.Position = UDim2.new(0, 15, 0, 0)
            DropTitle.BackgroundTransparency = 1
            DropTitle.Text = opts.Name
            DropTitle.TextColor3 = UI_Config.TextColor
            DropTitle.Font = UI_Config.Font
            DropTitle.TextSize = 14
            DropTitle.TextXAlignment = Enum.TextXAlignment.Left
            DropTitle.Parent = DropFrame

            local DropBtn = Instance.new("TextButton")
            DropBtn.Size = UDim2.new(0, 150, 0, 30)
            DropBtn.Position = UDim2.new(1, -165, 0, 7)
            local initText = "None"
            if type(opts.CurrentOption) == "table" and opts.CurrentOption[1] then
                initText = tostring(opts.CurrentOption[1])
            elseif type(opts.CurrentOption) == "string" then
                initText = opts.CurrentOption
            end
            
            DropBtn.BackgroundColor3 = UI_Config.MainColor
            DropBtn.Text = initText
            DropBtn.TextColor3 = UI_Config.DimTextColor
            DropBtn.Font = UI_Config.Font
            DropBtn.TextSize = 13
            DropBtn.Parent = DropFrame
            CreateCorner(DropBtn, 4)

            local ScrollFrame = Instance.new("ScrollingFrame")
            ScrollFrame.Size = UDim2.new(1, -30, 0, 100)
            ScrollFrame.Position = UDim2.new(0, 15, 0, 50)
            ScrollFrame.BackgroundTransparency = 1
            ScrollFrame.ScrollBarThickness = 2
            ScrollFrame.Parent = DropFrame

            local ListLayout = Instance.new("UIListLayout")
            ListLayout.SortOrder = Enum.SortOrder.LayoutOrder
            ListLayout.Padding = UDim.new(0, 5)
            ListLayout.Parent = ScrollFrame

            local isOpen = false

            local function refreshOptions(options)
                for _, child in ipairs(ScrollFrame:GetChildren()) do
                    if child:IsA("TextButton") then child:Destroy() end
                end
                
                if type(opts.CurrentOption) ~= "table" then
                    opts.CurrentOption = opts.CurrentOption and {opts.CurrentOption} or {}
                end
                if opts.Flag and ConfigManager.Config[opts.Flag] ~= nil then
                    opts.CurrentOption = ConfigManager.Config[opts.Flag]
                    if type(opts.CurrentOption) ~= "table" then
                        opts.CurrentOption = {opts.CurrentOption}
                    end
                end
                
                local function updateBtnText()
                    if opts.MultipleOptions then
                        if #opts.CurrentOption == 0 then
                            DropBtn.Text = "None"
                        elseif #opts.CurrentOption == 1 then
                            DropBtn.Text = tostring(opts.CurrentOption[1])
                        else
                            DropBtn.Text = tostring(#opts.CurrentOption) .. " Selected"
                        end
                    else
                        DropBtn.Text = tostring(opts.CurrentOption[1] or "None")
                    end
                end
                updateBtnText()
                
                for i, opt in ipairs(options) do
                    local btn = Instance.new("TextButton")
                    btn.Size = UDim2.new(1, -10, 0, 25)
                    btn.BackgroundColor3 = UI_Config.MainColor
                    btn.Text = tostring(opt)
                    
                    local isSelected = false
                    for _, v in ipairs(opts.CurrentOption) do
                        if v == opt then isSelected = true break end
                    end
                    btn.TextColor3 = isSelected and UI_Config.AccentColor or UI_Config.TextColor
                    
                    btn.Font = UI_Config.Font
                    btn.TextSize = 13
                    btn.Parent = ScrollFrame
                    CreateCorner(btn, 4)

                    btn.MouseButton1Click:Connect(function()
                        if opts.MultipleOptions then
                            local foundIdx = nil
                            for idx, v in ipairs(opts.CurrentOption) do
                                if v == opt then foundIdx = idx break end
                            end
                            if foundIdx then
                                table.remove(opts.CurrentOption, foundIdx)
                                btn.TextColor3 = UI_Config.TextColor
                            else
                                table.insert(opts.CurrentOption, opt)
                                btn.TextColor3 = UI_Config.AccentColor
                            end
                            updateBtnText()
                            if opts.Flag then
                                ConfigManager.Config[opts.Flag] = opts.CurrentOption
                                ConfigManager:Save()
                            end
                            if opts.Callback then opts.Callback(opts.CurrentOption) end
                        else
                            opts.CurrentOption = {opt}
                            updateBtnText()
                            for _, child in ipairs(ScrollFrame:GetChildren()) do
                                if child:IsA("TextButton") then
                                    child.TextColor3 = (child.Text == tostring(opt)) and UI_Config.AccentColor or UI_Config.TextColor
                                end
                            end
                            isOpen = false
                            TweenService:Create(DropFrame, TweenInfo.new(0.2), {Size = UDim2.new(1, -10, 0, 45)}):Play()
                            if opts.Flag then
                                ConfigManager.Config[opts.Flag] = opts.CurrentOption
                                ConfigManager:Save()
                            end
                            if opts.Callback then opts.Callback(opts.CurrentOption) end
                        end
                    end)
                end
                ScrollFrame.CanvasSize = UDim2.new(0, 0, 0, ListLayout.AbsoluteContentSize.Y)
            end
            
            if opts.Options then
                refreshOptions(opts.Options)
            end
            
            if opts.Callback then
                task.spawn(function()
                    opts.Callback(opts.CurrentOption)
                end)
            end

            DropBtn.MouseButton1Click:Connect(function()
                isOpen = not isOpen
                if isOpen then
                    TweenService:Create(DropFrame, TweenInfo.new(0.2), {Size = UDim2.new(1, -10, 0, 160)}):Play()
                else
                    TweenService:Create(DropFrame, TweenInfo.new(0.2), {Size = UDim2.new(1, -10, 0, 45)}):Play()
                end
            end)
            
            return {
                Refresh = function(self, newOpts)
                    -- In original script, it calls MonsterDropdown:Refresh(opts, {"Best ( Quest )"})
                    -- So we need to handle newOpts correctly.
                    refreshOptions(newOpts)
                end,
                Set = function(self, newVals)
                    if type(newVals) == "table" then
                        DropBtn.Text = tostring(newVals[1] or "Select")
                    else
                        DropBtn.Text = tostring(newVals or "Select")
                    end
                end
            }
        end

        function Tab:CreateButton(opts)
            local BtnFrame = Instance.new("Frame")
            BtnFrame.Size = UDim2.new(1, -10, 0, 45)
            BtnFrame.BackgroundColor3 = UI_Config.CardColor
            BtnFrame.Parent = TabContent
            CreateCorner(BtnFrame, 6)

            local ActionBtn = Instance.new("TextButton")
            ActionBtn.Size = UDim2.new(1, -30, 0, 30)
            ActionBtn.Position = UDim2.new(0, 15, 0, 7)
            ActionBtn.BackgroundColor3 = UI_Config.AccentColor
            ActionBtn.Text = opts.Name
            ActionBtn.TextColor3 = Color3.fromRGB(20, 20, 20)
            ActionBtn.Font = Enum.Font.GothamBold
            ActionBtn.TextSize = 14
            ActionBtn.Parent = BtnFrame
            CreateCorner(ActionBtn, 4)

            ActionBtn.MouseButton1Click:Connect(function()
                TweenService:Create(ActionBtn, TweenInfo.new(0.1), {BackgroundColor3 = Color3.fromRGB(255, 255, 255)}):Play()
                task.wait(0.1)
                TweenService:Create(ActionBtn, TweenInfo.new(0.1), {BackgroundColor3 = UI_Config.AccentColor}):Play()
                if opts.Callback then
                    opts.Callback()
                end
            end)
        end

        function Tab:CreateLabel(opts)
            local LblFrame = Instance.new("Frame")
            LblFrame.Size = UDim2.new(1, -10, 0, 35)
            LblFrame.BackgroundColor3 = opts.Color or UI_Config.CardColor
            LblFrame.Parent = TabContent
            CreateCorner(LblFrame, 6)
            
            if opts.Gradient then
                local gradient = Instance.new("UIGradient")
                gradient.Color = opts.Gradient
                gradient.Parent = LblFrame
            end

            local LblText = Instance.new("TextLabel")
            LblText.Size = UDim2.new(1, -30, 1, 0)
            LblText.Position = UDim2.new(0, 15, 0, 0)
            LblText.BackgroundTransparency = 1
            LblText.Text = opts.Name
            LblText.TextColor3 = opts.TextColor or UI_Config.TextColor
            LblText.Font = opts.Font or UI_Config.Font
            LblText.TextSize = 14
            LblText.TextXAlignment = (opts.Alignment == "Center") and Enum.TextXAlignment.Center or Enum.TextXAlignment.Left
            LblText.Parent = LblFrame
            
            return {
                Set = function(self, newText)
                    LblText.Text = newText
                end
            }
        end

        return Tab
    end
    
    function SKT_UI:Notify(opts)
        -- Notification system stub to keep compatibility
        print("[SKT_UI Notify]", opts.Title, opts.Content)
    end
    
    return Window
end
local Window = SKT_UI:CreateWindow({Name="SKT Hub"})

