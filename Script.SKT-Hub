-- ==========================================
-- ⚙️ BOOST TAB
-- ==========================================
local Section_Boost = Tab_Boost:CreateSection("Boost Settings")

local BoostOptions = {
    "Coins I", "Coins II", "Coins III",
    "Damage I", "Damage II", "Damage III",
    "Exp I", "Exp II", "Exp III",
    "Luck", "Super Luck", "Ultra Luck",
    "Star Speed"
}

-- จับคู่ชื่อที่แสดงใน UI กับ ID ในเกม
local BoostIDs = {
    ["Coins I"] = "CoinsI", ["Coins II"] = "CoinsII", ["Coins III"] = "CoinsIII",
    ["Damage I"] = "DamageI", ["Damage II"] = "DamageII", ["Damage III"] = "DamageIII",
    ["Exp I"] = "ExpI", ["Exp II"] = "ExpII", ["Exp III"] = "ExpIII",
    ["Luck"] = "Luck", ["Super Luck"] = "SuperLuck", ["Ultra Luck"] = "UltraLuck",
    ["Star Speed"] = "StarSpeed"
}

Tab_Boost:CreateDropdown({
    Name = "Select Boosts to Auto Use",
    Options = BoostOptions,
    CurrentOption = {},
    MultipleOptions = true,
    Flag = "Dropdown_Boosts",
    Callback = function(Options)
        _G.SelectedBoosts = Options
    end,
})

Tab_Boost:CreateToggle({
    Name = "Auto Use Boost",
    CurrentValue = false,
    Flag = "Toggle_AutoBoosts",
    Callback = function(Value)
        _G.AutoBoosts = Value
        local Bridge = game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("Bridge")
        
        if _G.AutoBoosts then
            task.spawn(function()
                while _G.AutoBoosts do
                    pcall(function()
                        if _G.SelectedBoosts then
                            for k, v in pairs(_G.SelectedBoosts) do
                                local boostName
                                if type(k) == "number" then
                                    boostName = v
                                elseif type(k) == "string" and v == true then
                                    boostName = k
                                end
                                
                                if boostName then
                                    local boostId = BoostIDs[boostName]
                                    if boostId then
                                        -- เช็คว่าบัฟทำงานอยู่หรือไม่จาก UI ของเกม (แม่นยำ 100%)
                                        local isActive = false
                                        pcall(function()
                                            local boostsUI = LocalPlayer.PlayerGui.UI.Frames.Stats.Frame.Boosts.Frame
                                            if boostsUI:FindFirstChild(boostId) then
                                                isActive = true
                                            end
                                        end)
                                        
                                        if not isActive then
                                            -- ถ้าบัฟยังไม่ Active ให้กดใช้เลย! (ถ้าไม่มีของในตัว เซิร์ฟเวอร์จะบล็อกเอง)
                                            Bridge:FireServer("General", "Inventory", "UseBoost", boostId)
                                            task.wait(1) -- รอ 1 วินาทีให้ UI อัปเดตก่อนเช็คตัวถัดไป
                                        end
                                    end
                                end
                            end
                        end
                    end)
                    task.wait(3) -- เช็คซ้ำทุกๆ 3 วินาที
                end
            end)
        end
    end,
})

Tab_Misc:CreateToggle({
    Name = "Auto Redeem Codes",
    CurrentValue = false,
    Flag = "Toggle_AutoCodes",
    Callback = function(Value)
        _G.AutoCodes = Value
        local Bridge = game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("Bridge")
        
        -- โค้ดทั้งหมดที่ใช้งานได้อัปเดตล่าสุด
        local CodesList = {
            "SHUTDOWN5", "UPDATE1", "3KPLAYERS", "500KVISITS", 
            "MINIUPDATE", "2KLIKES", "2KPLAYERS", "RELEASE"
        }
        
        if _G.AutoCodes then
            task.spawn(function()
                while _G.AutoCodes do
                    pcall(function()
                        for _, code in ipairs(CodesList) do
                            Bridge:FireServer("General", "Codes", "Redeem", code)
                            task.wait(0.5)
                        end
                    end)
                    task.wait(60) -- เช็คซ้ำทุกๆ 1 นาที
                end
            end)
        end
    end,
})

Tab_Misc:CreateToggle({
    Name = "Auto Claim Awards",
    CurrentValue = false,
    Flag = "Toggle_AutoAwards",
    Callback = function(Value)
        _G.AutoAwards = Value
        local Bridge = game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("Bridge")
        
        if _G.AutoAwards then
            task.spawn(function()
                while _G.AutoAwards do
                    pcall(function()
                        local ps = LocalPlayer:FindFirstChild("PlayerScripts")
                        if ps and ps:FindFirstChild("Scripts") and ps.Scripts:FindFirstChild("Client") and ps.Scripts.Client:FindFirstChild("Main") then
                            local Main = require(ps.Scripts.Client.Main)
                            if Main and Main.Shared and Main.Shared.Awards and Main.Data and Main.Data.Awards then
                                local AwardsModule = require(game:GetService("ReplicatedStorage"):WaitForChild("Packages"):WaitForChild("Awards"))
                                for i, v in pairs(Main.Shared.Awards) do
                                    local isClaimed = Main.Data.Awards[i]
                                    if not isClaimed then
                                        local _, _, prog = AwardsModule:GetProgress(Main.Data, v)
                                        if prog and prog >= 1 then
                                            Bridge:FireServer("General", "Awards", "Claim", i)
                                            task.wait(0.2)
                                        end
                                    end
                                end
                            end
                        end
                    end)
                    task.wait(5)
                end
            end)
        end
    end,
})

Tab_Misc:CreateToggle({
    Name = "Auto Claim Inbox",
    CurrentValue = false,
    Flag = "Toggle_AutoInbox",
    Callback = function(Value)
        _G.AutoInbox = Value
        local Bridge = game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("Bridge")
        
        if _G.AutoInbox then
            task.spawn(function()
                while _G.AutoInbox do
                    pcall(function()
                        local ps = LocalPlayer:FindFirstChild("PlayerScripts")
                        if ps and ps:FindFirstChild("Scripts") and ps.Scripts:FindFirstChild("Client") and ps.Scripts.Client:FindFirstChild("Main") then
                            local Main = require(ps.Scripts.Client.Main)
                            if Main and Main.Data and Main.Data.Inbox then
                                for i, _ in pairs(Main.Data.Inbox) do
                                    Bridge:FireServer("General", "Inbox", "Claim", i)
                                    task.wait(0.2)
                                end
                            end
                        end
                    end)
                    task.wait(5)
                end
            end)
        end
    end,
})

