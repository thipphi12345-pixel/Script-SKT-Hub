})

Tab_Misc:CreateToggle({
    Name = "Auto Claim Inbox",
    CurrentValue = false,
    Flag = "Toggle_AutoInbox",
    Callback = function(Value)
        _G.AutoInbox = Value
        local Bridge = game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("Bridge")
        if _G.AutoInbox then
            task.spawn(function()
                while _G.AutoInbox do
                    pcall(function()
                        -- เน€เธเธเน€เธเธ”เน€เธย Claim All เน€เธโ€ขเน€เธเธเน€เธยเน€เธย
                        Bridge:FireServer("General", "Inbox", "ClaimAll")
                        Bridge:FireServer("Rewards", "Inbox", "ClaimAll")
                        
                        -- เน€เธยเน€เธโ€เน€เธยเน€เธเธเน€เธยเน€เธเธ Claim เน€เธยเน€เธยเน€เธยเน€เธเธเน€เธโ€“เน€เธยเน€เธเธ’เน€เธโฌเน€เธยเน€เธเธ”เน€เธโ€ UI เน€เธยเน€เธเธเน€เธย
                        if LocalPlayer and LocalPlayer:FindFirstChild("PlayerGui") then
                            for _, obj in ipairs(LocalPlayer.PlayerGui:GetDescendants()) do
                                if obj:IsA("TextButton") or obj:IsA("ImageButton") then
                                    local txt = obj:IsA("TextButton") and string.lower(obj.Text) or ""
                                    local name = string.lower(obj.Name)
                                    if string.find(name, "claim") or string.find(txt, "claim") then
                                        local parent = obj.Parent
                                        local inInbox = false
                                        for i=1, 5 do
                                            if parent and parent:IsA("GuiObject") then
                                                if string.find(string.lower(parent.Name), "inbox") then inInbox = true break end
                                                parent = parent.Parent
                                            end
                                        end
                                        if inInbox and getconnections then
                                            for _, conn in ipairs(getconnections(obj.MouseButton1Click)) do conn:Fire() end
                                        end
                                    end
                                end
                            end
                        end
                    end)
                    task.wait(10)
                end
            end)
        end
    end,
})

