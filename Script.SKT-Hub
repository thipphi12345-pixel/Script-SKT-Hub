        if _G.FastAutoStar then
            while _G.FastAutoStar do
                task.wait(1)
                pcall(function()
                    -- ย้ำคำสั่งเปิด Auto ทุกๆ 1 วินาที เพื่อให้ทำงานต่อหลังจากที่กระเป๋าเต็มแล้วขายทิ้ง
                    Bridge:FireServer("General", "Star", "Auto", true)
                end)
            end
        else
            -- ยกเลิกการเปิดออโต้
            pcall(function()
                Bridge:FireServer("General", "Star", "Auto", false)
            end)
        end
    end,
})



