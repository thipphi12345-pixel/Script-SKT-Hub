local function sellSelectedEggs()
    local selection = State.SellEggRarities
    if type(selection) ~= "table" or #selection == 0 then
        selection = { "All Common - Rare" }
    end
    local data = nil
    pcall(function() data = ReplicaController:GetPlayerData() end)
    if not data or not data.Inventory then return 0 end

    local soldCount = 0

    for id, it in pairs(data.Inventory) do
        if it.itemType == "Egg" and it.innerEntity and it.innerEntity.eggType then
            local eggType = it.innerEntity.eggType
            local eggRarity = EggToRarity[eggType] or "Common"
            local eggRank = EggRarityRanks[eggRarity] or 1
            local shouldSell = false

            for _, opt in ipairs(selection) do
                local hi = opt:match("^All Common %- (%w+)$")
                if hi then
                    if eggRank <= (EggRarityRanks[hi] or 3) then
                        shouldSell = true
                        break
                    end
                else
                    local rname = opt:match("^(%w+)")
                    if rname and rname:upper() == eggRarity:upper() then
                        shouldSell = true
                        break
                    end
                end
            end

            if shouldSell then
                local ok = pcall(function()
                    InventoryService.RF.SellEgg:InvokeServer(id)
                end)
                if ok then
                    soldCount = soldCount + 1
                end
                task.wait(0.05)
            end
        end
    end
    return soldCount
end

local function handleEggsAndAnimals()
    local data = nil
    pcall(function()
