-- ── 10. FLOATING TOGGLE BUTTON (drag + tap to toggle) ────────────────────────────
local function createFloatingToggle()
    if _G.SKTMobileToggleBtn then pcall(function() _G.SKTMobileToggleBtn:Destroy() end) end

    local sg = Instance.new("ScreenGui")
    _G.SKTMobileToggleBtn = sg
    sg.Name = "SKTHub_FloatingToggle"
    sg.DisplayOrder = 2147483647
    sg.ResetOnSpawn = false
    sg.IgnoreGuiInset = true

    local parented = false
    local touchOnly = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
    local playerGui = LP and LP:FindFirstChildOfClass("PlayerGui")
    if touchOnly and playerGui then
        parented = pcall(function() sg.Parent = playerGui end) and sg.Parent == playerGui
    end
    if not parented then
        pcall(function() sg.Parent = (typeof(gethui) == "function" and gethui()) or CoreGui; parented = true end)
    end
    if not parented and playerGui then
        pcall(function() sg.Parent = playerGui end)
    end

    local toggleBtn = Instance.new("TextButton", sg)
    toggleBtn.Name = "ShieldToggle"
    toggleBtn.Size = UDim2.fromOffset(50, 50)
    toggleBtn.Position = UDim2.new(0.5, -25, 0, 14)
    toggleBtn.BackgroundColor3 = Color3.fromRGB(14, 14, 18)
    toggleBtn.Text = ""
    toggleBtn.AutoButtonColor = false
    toggleBtn.ClipsDescendants = true
    toggleBtn.ZIndex = 100
    Instance.new("UICorner", toggleBtn).CornerRadius = UDim.new(0, 12)

    local btnStroke = Instance.new("UIStroke", toggleBtn)
    btnStroke.Thickness = 1.8
    btnStroke.Color = Color3.fromRGB(255, 255, 255)
    btnStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border

    local strokeGrad = Instance.new("UIGradient", btnStroke)
    strokeGrad.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 255, 255)),
        ColorSequenceKeypoint.new(0.35, Color3.fromRGB(180, 185, 195)),
        ColorSequenceKeypoint.new(0.7, Color3.fromRGB(60, 60, 70)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 255, 255))
    })

    local btnGrad = Instance.new("UIGradient", toggleBtn)
    btnGrad.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(28, 28, 36)),
        ColorSequenceKeypoint.new(0.5, Color3.fromRGB(16, 16, 22)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(8, 8, 12))
    })
    btnGrad.Rotation = 45

    local logo = Instance.new("ImageLabel", toggleBtn)
    logo.Name = "BrandLogo"
    logo.Size = UDim2.fromOffset(32, 32)
    logo.AnchorPoint = Vector2.new(0.5, 0.5)
    logo.Position = UDim2.fromScale(0.5, 0.5)
    logo.BackgroundTransparency = 1
    logo.Image = "rbxassetid://111753595811895"
    logo.ScaleType = Enum.ScaleType.Crop
    logo.ZIndex = 102
    Instance.new("UICorner", logo).CornerRadius = UDim.new(0, 8)

    local logoStroke = Instance.new("UIStroke", logo)
    logoStroke.Thickness = 1
    logoStroke.Color = Color3.fromRGB(255, 255, 255)
    logoStroke.Transparency = 0.45

    task.spawn(function()
        local rot = 0
        while task.wait(0.033) do
            if not sg.Parent then break end
            rot = (rot + 5) % 360
            strokeGrad.Rotation = rot
        end
    end)

    local ts = TweenService
    toggleBtn.MouseEnter:Connect(function()
        ts:Create(toggleBtn, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            BackgroundColor3 = Color3.fromRGB(24, 24, 32)
        }):Play()
    end)
    toggleBtn.MouseLeave:Connect(function()
        ts:Create(toggleBtn, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            BackgroundColor3 = Color3.fromRGB(14, 14, 18)
        }):Play()
    end)

    local function executeToggle()
        pcall(function() Library:Toggle() end)
    end

    local dragToggle = false
    local dragStart, startPos
    local dragged = false
    local movedConn

    toggleBtn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragToggle = true
            dragged = false
            dragStart = input.Position
            startPos = toggleBtn.Position
            ts:Create(toggleBtn, TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                Size = UDim2.fromOffset(44, 44)
            }):Play()

            if movedConn then movedConn:Disconnect() end
            movedConn = input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.Change then
                    if (input.Position - dragStart).Magnitude > 4 then
                        dragged = true
                    end
                elseif input.UserInputState == Enum.UserInputState.End then
                    dragToggle = false
                    if movedConn then movedConn:Disconnect() end
                    ts:Create(toggleBtn, TweenInfo.new(0.18, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
                        Size = UDim2.fromOffset(50, 50)
                    }):Play()
                    if not dragged then
                        executeToggle()
                    end
                end
            end)
        end
    end)

    local dragInput
    toggleBtn.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)

    local uisConn = UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragToggle and dragStart then
            local delta = input.Position - dragStart
            toggleBtn.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)

    sg.Destroying:Connect(function()
        if movedConn then movedConn:Disconnect() end
        if uisConn then uisConn:Disconnect() end
    end)
end

