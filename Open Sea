-- Server Hop Helper (rejoin / random / smallest via Roblox public API)
local function serverHop(mode)
    if mode == "rejoin" then
        Notify({ Title = "Rejoining", Content = "Rejoining the same server...", Duration = 3 })
        pcall(function() TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, LP) end)
        return
    end
    Notify({ Title = "Server Hop", Content = "Searching for a new server...", Duration = 3 })
    task.spawn(function()
        local servers = nil
        if httpRequest then
            local ok, res = pcall(function()
                return httpRequest({
                    Url = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100",
                    Method = "GET",
                })
            end)
            if ok and res and res.Body then
                local ok2, decoded = pcall(function() return HttpService:JSONDecode(res.Body) end)
                if ok2 and decoded and decoded.data then servers = decoded.data end
            end
        end
        if servers and #servers > 0 then
            local candidates = {}
            for _, s in ipairs(servers) do
                if s.id ~= game.JobId and (s.playing or 0) < (s.maxPlayers or 1) then
                    table.insert(candidates, s)
                end
            end
            local pick = nil
            if mode == "smallest" then
                for _, s in ipairs(candidates) do
                    if not pick or (s.playing or 0) < (pick.playing or 0) then pick = s end
                end
            elseif #candidates > 0 then
                pick = candidates[math.random(1, #candidates)]
            end
            if pick then
                pcall(function() TeleportService:TeleportToPlaceInstance(game.PlaceId, pick.id, LP) end)
                return
            end
        end
        pcall(function() TeleportService:Teleport(game.PlaceId, LP) end)
    end)
end

