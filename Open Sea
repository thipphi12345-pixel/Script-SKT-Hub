-- FPS Boost Mode (disable shadows, post FX, particles, terrain water)
local fpsBoostBackup = { shadows = nil, terrain = nil, quality = nil }
local fpsBoostEffects = {}
local fpsBoostConn = nil

local function isVisualEffect(d)
    return d:IsA("ParticleEmitter") or d:IsA("Trail") or d:IsA("Beam")
        or d:IsA("Smoke") or d:IsA("Fire") or d:IsA("Sparkles")
end

local function disableWorkspaceEffects()
    for _, d in ipairs(workspace:GetDescendants()) do
        if isVisualEffect(d) and d.Enabled then
            fpsBoostEffects[d] = true
            pcall(function() d.Enabled = false end)
        end
    end
end

local function setFpsBoost(on)
    if on then
        pcall(function()
            fpsBoostBackup.shadows = Lighting.GlobalShadows
            Lighting.GlobalShadows = false
        end)
        for _, e in ipairs(Lighting:GetChildren()) do
            if e:IsA("PostEffect") then
                fpsBoostEffects[e] = e.Enabled
                pcall(function() e.Enabled = false end)
            elseif e:IsA("Atmosphere") then
                fpsBoostEffects[e] = e.Parent
                pcall(function() e.Parent = nil end)
            end
        end
        pcall(function()
            local t = workspace.Terrain
            fpsBoostBackup.terrain = { t.WaterWaveSize, t.WaterWaveSpeed, t.WaterReflectance }
            t.WaterWaveSize = 0
            t.WaterWaveSpeed = 0
            t.WaterReflectance = 0
        end)
        pcall(function()
            local gs = UserSettings():GetService("UserGameSettings")
            fpsBoostBackup.quality = gs.SavedQualityLevel
            gs.SavedQualityLevel = Enum.SavedQualitySetting.QualityLevel1
        end)
        disableWorkspaceEffects()
        if fpsBoostConn then fpsBoostConn:Disconnect() end
        fpsBoostConn = workspace.DescendantAdded:Connect(function(d)
            if State.FPSBoost and isVisualEffect(d) then
                fpsBoostEffects[d] = true
                pcall(function() d.Enabled = false end)
            end
        end)
        table.insert(_conns, fpsBoostConn)
    else
        if fpsBoostConn then fpsBoostConn:Disconnect() fpsBoostConn = nil end
        for d, orig in pairs(fpsBoostEffects) do
            pcall(function()
                if d:IsA("Atmosphere") then
                    if not d.Parent then d.Parent = orig end
                else
                    d.Enabled = (orig ~= false)
                end
            end)
        end
        table.clear(fpsBoostEffects)
        if fpsBoostBackup.shadows ~= nil then
            pcall(function() Lighting.GlobalShadows = fpsBoostBackup.shadows end)
            fpsBoostBackup.shadows = nil
        end
        if fpsBoostBackup.terrain then
            pcall(function()
                local t = workspace.Terrain
                t.WaterWaveSize, t.WaterWaveSpeed, t.WaterReflectance =
                    fpsBoostBackup.terrain[1], fpsBoostBackup.terrain[2], fpsBoostBackup.terrain[3]
            end)
            fpsBoostBackup.terrain = nil
        end
        if fpsBoostBackup.quality then
            pcall(function()
                UserSettings():GetService("UserGameSettings").SavedQualityLevel = fpsBoostBackup.quality
            end)
            fpsBoostBackup.quality = nil
        end
    end
end
