            local farmText = State.AutoWave and "ONLINE (ACTIVE)" or "STANDBY (IDLE)"
            local targetEgg = "All"
            if type(State.SpecificEggs) == "table" and #State.SpecificEggs > 0 then
                targetEgg = #State.SpecificEggs == 1 and State.SpecificEggs[1] or (#State.SpecificEggs .. " types")
            end
            local minRarity = "All"
            if type(State.MinEggRarity) == "table" and #State.MinEggRarity > 0 then
                minRarity = #State.MinEggRarity == 1 and State.MinEggRarity[1] or (#State.MinEggRarity .. " rarities")
            elseif type(State.MinEggRarity) == "string" then
                minRarity = State.MinEggRarity
            end

            local activeEvents = RS:FindFirstChild("ActiveEvents")
            local activeEvText = "None (Normal)"
            if activeEvents and #activeEvents:GetChildren() > 0 then
                local evNames = {}
                for _, ev in ipairs(activeEvents:GetChildren()) do
                    table.insert(evNames, ev.Name)
                end
                activeEvText = table.concat(evNames, ", ") .. " (ACTIVE!)"
            end

            local nwt = RS:FindFirstChild("NextWeatherTime")
            local nextEvTimer = (nwt and nwt.Value and nwt.Value > 0) and formatSeconds(nwt.Value) or "N/A"

            local descText = string.format(
                "[Player] %s  |  [Bot Status] %s\n" ..
                "[Cash] $%s  |  [Power] %s  |  [Speed] %s\n" ..
                "[Sea Hunting] %s  |  [Mode] Packet Sniping\n" ..
                "[Target Eggs] %s  |  [Min Rarity] %s\n" ..
                "[Event Boss] %s  |  [Next Event] in %s\n" ..
                "[Mutations] %s  |  [Anti-AFK 24h] Running",
                LP.DisplayName or LP.Name, farmText,
                formatNum(cash), formatNum(power), tostring(speed),
                State.AutoWave and "Enabled" or "Disabled",
                tostring(targetEgg), tostring(minRarity),
                tostring(activeEvText), tostring(nextEvTimer),
                State.PrioritizeMutations and "Top Priority" or "Normal"
            )

            if statusLabel then
                pcall(function() statusLabel:SetText(descText) end)
            end
        end)
        task.wait(1)
    end
end)

