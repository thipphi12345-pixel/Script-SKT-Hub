local function migrateValue(v)
    if type(v) ~= "string" then return v end
    if LEGACY_VALUE_MAP[v] then return LEGACY_VALUE_MAP[v] end
    local nv = v:gsub("%s*ขึ้นไป", "+")          -- "Cosmic ขึ้นไป (Snake+)" -> "Cosmic+ (Snake+)"
    nv = nv:gsub("^ทั้งหมด%s*", "All ")           -- "ทั้งหมด Common - Rare" -> "All Common - Rare"
    nv = nv:gsub("^ทุกระดับ%s*", "All ")
    return nv
end
local function migrateLegacyValues()
    for _, key in ipairs({ "WebhookMinRarity", "TargetRebirth", "TradeFilterAnimal" }) do
        local opt = Options[key]
        local cur = opt and opt.Value or State[key]
        local nv = migrateValue(cur)
        if nv ~= cur then
            if opt and opt.SetValue then
                pcall(function() opt:SetValue(nv) end)
            else
                State[key] = nv
            end
        end
    end
    -- multi-select egg filters: normalize each entry and drop unknown values
    local sellSet = {}
    for _, o in ipairs(SellEggRarityOptions) do sellSet[o] = true end
    local function validSell(e)
        return sellSet[e] == true
    end
    local POTION_KINDS = { Train = true, Cash = true, Luck = true }
    for _, key in ipairs({ "SpecificEggs", "SellEggRarities", "MinEggRarity", "AutoPotions" }) do
        local opt = Options[key]
        local cur = opt and opt.Value or State[key]
        -- legacy scalar values (e.g. old "Secret+ (Ostrich+)" threshold) only survive
        -- in the raw config blob once the option became a multi-dropdown
        local raw = Library._LastLoadedConfig and Library._LastLoadedConfig.options
            and Library._LastLoadedConfig.options[key]
        if type(raw) == "string" and raw ~= "" then
            cur = raw
        end
        -- legacy per-potion toggles -> multi-select array
        if key == "AutoPotions" and (type(cur) ~= "table" or #cur == 0) then
            local lt = Library._LastLoadedConfig and Library._LastLoadedConfig.toggles or {}
            if lt.AutoUsePotions == true then
                local legacy = {}
                if lt.AutoUseTrainPotion then table.insert(legacy, "Train") end
                if lt.AutoUseCashPotion then table.insert(legacy, "Cash") end
                if lt.AutoUseLuckPotion then table.insert(legacy, "Luck") end
                if #legacy > 0 then cur = legacy end
            end
        end
        local arr = {}
        if type(cur) == "table" then
            for _, e in ipairs(cur) do table.insert(arr, migrateValue(e)) end
        elseif type(cur) == "string" and cur ~= "" then
            local mv = migrateValue(cur)
            if key == "MinEggRarity" and MinRarityThresholds[mv] then
                -- legacy threshold string (e.g. "Secret+ (Ostrich+)") -> array of rarities at or above it
                local minRank = MinRarityThresholds[mv]
                for _, rn in ipairs(ALL_RARITY_NAMES) do
                    if EggRarityRanks[rn] >= minRank then table.insert(arr, rn) end
                end
            else
                table.insert(arr, mv)
            end
        end
        local cleaned = {}
        for _, e in ipairs(arr) do
            local okEntry = (key == "SpecificEggs" and EggNameMapping[e] ~= nil)
                or (key == "SellEggRarities" and validSell(e))
                or (key == "MinEggRarity" and EggRarityRanks[e] ~= nil)
                or (key == "AutoPotions" and POTION_KINDS[e] == true)
            if okEntry then table.insert(cleaned, e) end
        end
        State[key] = cleaned
        if opt and opt.SetValue then
            pcall(function() opt:SetValue(cleaned) end)
        end
    end
end

