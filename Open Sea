-- 1. Wave Egg Sniping & Teleport Collector
local isSnipingWave = false
local function runWaveSniping()
    if not State.AutoWave or isSnipingWave then return end
    if not WaveService then return end
    if LP:GetAttribute("IsWaveActive") then return end

    local char = LP.Character
    if not char or not char.PrimaryPart then return end

    isSnipingWave = true
    task.spawn(function()
        pcall(function()
            -- Pure Silent Packet Sniping Mode
            local ok, res = pcall(function()
                return WaveService.RF.Start:InvokeServer(5)
            end)
            if ok and res and res.spawns then
                local spawns = res.spawns
                local picks = {}
                local acceptedRanks = nil
                if type(State.MinEggRarity) == "table" and #State.MinEggRarity > 0 then
                    acceptedRanks = {}
                    for _, rn in ipairs(State.MinEggRarity) do
                        local r = EggRarityRanks[rn]
                        if r then acceptedRanks[r] = true end
                    end
                elseif type(State.MinEggRarity) == "string" then
                    local minRank = MinRarityThresholds[State.MinEggRarity] or 1
                    acceptedRanks = {}
                    for rn, r in pairs(EggRarityRanks) do
                        if r >= minRank then acceptedRanks[r] = true end
                    end
                end
                local specificSet = nil
                if type(State.SpecificEggs) == "table" then
                    for _, nm in ipairs(State.SpecificEggs) do
                        local eid = EggNameMapping[nm]
                        if eid then
                            specificSet = specificSet or {}
                            specificSet[eid] = true
                        end
                    end
                end

                for id, sData in pairs(spawns) do
                    local entity = sData.entity or {}
                    local eggType = entity.eggType
                    if eggType then
                        local rarityName = EggToRarity[eggType] or "Common"
                        local rank = EggRarityRanks[rarityName] or 1
                        local mutation = entity.mutation
                        local size = entity.size
                        local isBoss = (sData.bossId ~= nil) or (eggType == "dragon_egg" or eggType == "polarbear_egg" or eggType == "mouse_egg")

                        local matchSpecific = (specificSet == nil or specificSet[eggType] == true)
                        local matchRarity = (acceptedRanks == nil or acceptedRanks[rank] == true)

                        if matchSpecific and matchRarity then
                            local score = rank * 10000
                            if isBoss then
                                score = score + (State.AutoHuntEventBoss and 200000 or 50000)
                            end
                            if mutation and mutation ~= "NORMAL" then
                                score = score + (State.PrioritizeMutations and 30000 or 5000)
                            end
                            if size == "huge" then score = score + 20000
                            elseif size == "big" then score = score + 10000 end

                            table.insert(picks, { id = id, score = score })
                        end
                    elseif State.VacuumEggs and (sData.bossId ~= nil or entity.brainrotType ~= nil) then
                        -- vacuum also grabs boss drops and animal spawns, not just eggs
                        table.insert(picks, { id = id, score = sData.bossId ~= nil and 250000 or 0 })
                    end
                end

                if #picks > 0 then
                    table.sort(picks, function(a, b) return a.score > b.score end)
                    local ids = {}
                    local limit = State.VacuumEggs and 30 or 1
                    for i = 1, math.min(limit, #picks) do
                        ids[i] = picks[i].id
                    end
                    task.wait(0.08)
                    pcall(function()
                        WaveService.RF.Finished:InvokeServer(ids)
                    end)
                else
                    pcall(function()
                        WaveService.RF.Finished:InvokeServer({})
                    end)
                end
            end
        end)

        task.wait(State.WaveDelay or 2)
        isSnipingWave = false
    end)
end

