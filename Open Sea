-- Auto Save Engine: silently persist every change to the active config
local lastConfigLoad = 0
local autosaveScheduled = false

local function autosaveNow()
    pcall(function()
        if not SaveManager:_EnsureFolders() then return end
        local raw = SaveManager.Controls.Name and SaveManager.Controls.Name.Value or ""
        local name = tostring(raw):match("^%s*(.-)%s*$"):gsub("[^%w%-%_ ]", ""):gsub("%s+", "_"):sub(1, 48)
        if name == "" or name == "(none)" or name == "none" then name = "Default" end
        writefile(SaveManager:_ConfigPath(name), HttpService:JSONEncode(SaveManager:_Capture()))
        writefile(SaveManager.Folder .. "/autoload.txt", name)
    end)
end

local function scheduleAutosave()
    if not State.CfgAutosave then return end
    if Library._ConfigLoading then return end
    if (os.clock() - lastConfigLoad) < 3 then return end
    if autosaveScheduled then return end
    autosaveScheduled = true
    task.delay(2.5, function()
        autosaveScheduled = false
        if State.CfgAutosave and not Library._ConfigLoading then
            autosaveNow()
        end
    end)
end

