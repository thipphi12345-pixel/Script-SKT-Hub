-- ── Auto promo-code engine ──────────────────────────────────────────────────────
-- The game keeps its code list server-side, so we try every known code plus a
-- predicted list built from the patterns this game uses (UPDATE#, like/visit
-- milestones, event names). When the devs release a code matching a pattern,
-- it redeems itself — no typing needed.
local CODE_SEED = {
    "RELEASE", "OPENSEA", "SEA", "ANIMALS", "TRAIN", "POWER", "LIKE", "DISCORD",
    "WELCOME", "THANKYOU", "SORRY", "FREE", "FREECASH", "FREEPOTION", "LUCKY",
    "BOOST", "X2", "EVENT", "BOSS", "DRAGON", "ZEUS", "DEVIL", "OCEAN", "SEAHUNT",
    "HUNT", "EGGS", "EGG", "REBIRTH", "GROUP", "SECRET", "LEGENDARY", "FOLLOWERS",
    "FANS", "MILLION", "SUMMER", "WINTER", "NEWYEAR",
}
local codeCandidates = nil
local codeStatus = {}   -- code -> "done" | "fail"
local codeFailAt = {}   -- code -> os.clock() of last failed attempt
local codeScanAt = 0

local function buildCodeCandidates()
    if codeCandidates then return codeCandidates end
    local list, seen = {}, {}
    local function add(c)
        if not seen[c] then seen[c] = true; list[#list + 1] = c end
    end
    for _, c in ipairs(CODE_SEED) do add(c) end
    for i = 1, 30 do add("UPDATE" .. i) end
    for _, m in ipairs({ "1K", "5K", "10K", "15K", "20K", "25K", "50K", "75K", "100K",
        "150K", "200K", "250K", "300K", "400K", "500K", "750K", "1M" }) do
        add(m); add(m .. "LIKES"); add(m .. "VISITS")
    end
    codeCandidates = list
    return list
end

task.spawn(function()
    while _G.OpenSeaRunning and _G.OpenSeaRunId == thisRunId do
        if State.AutoRedeemCodes and (os.clock() - codeScanAt) >= 30 then
            codeScanAt = os.clock()
            pcall(function()
                local data = nil
                pcall(function() data = ReplicaController:GetPlayerData() end)
                local redeemed = {}
                if type(data) == "table" and type(data.RedeemedCodes) == "table" then
                    for k, v in pairs(data.RedeemedCodes) do
                        if type(k) == "string" then redeemed[k] = true end
                        if type(v) == "string" then redeemed[v] = true end
                    end
                end
                for _, c in ipairs(buildCodeCandidates()) do
                    if not State.AutoRedeemCodes then break end
                    local st = codeStatus[c]
                    local eligible = st == nil
                        or (st == "fail" and (os.clock() - (codeFailAt[c] or 0)) >= 600)
                    if eligible and not redeemed[c] then
                        local ok, res = pcall(function()
                            return CodesService.RF.RedeemCode:InvokeServer(c)
                        end)
                        if ok and res == true then
                            codeStatus[c] = "done"
                            Notify({
                                Title = "New Code Redeemed",
                                Content = "Auto-redeemed code: " .. c,
                                Duration = 5
                            })
                        else
                            codeStatus[c] = "fail"
                            codeFailAt[c] = os.clock()
                        end
                        task.wait(0.4)
                    end
                end
            end)
        end
        task.wait(5)
    end
end)

