    local pretty = tostring(eggType or bossId):gsub("_", " ")
    local mut = m:GetAttribute("Mutation")
    local size = m:GetAttribute("Size")
    local extras = ""
    if mut and mut ~= "NORMAL" then extras = extras .. " [" .. tostring(mut) .. "]" end
    if size and size ~= "baby" then extras = extras .. " (" .. tostring(size) .. ")" end
    return pretty .. extras
end

local function scanRareSpawns()
    if not State.WebhookAlerts or not State.WebhookRareEggs then return end
    local folder = workspace:FindFirstChild("SpawnedItems")
    if not folder then return end
    local minRank = MinRarityThresholds[State.WebhookMinRarity] or 8
    for _, m in ipairs(folder:GetChildren()) do
        if m:IsA("Model") then
            local eggType = m:GetAttribute("EggType")
            local bossId = m:GetAttribute("BossId")
            if eggType or bossId then
                local rarity = bossId and "SPECIAL" or (EggToRarity[eggType] or "Common")
                local rank = bossId and 11 or (EggRarityRanks[rarity] or 1)
                if rank >= minRank then
                    local eid = m:GetAttribute("EntityId") or m:GetDebugId()
                    if not alertedEntities[eid] then
                        alertedEntities[eid] = true
                        alertedCount = alertedCount + 1
                        if alertedCount > 400 then
                            table.clear(alertedEntities)
                            alertedCount = 0
                        end
                        local label = rarity .. " • " .. describeSpawnedItem(m, eggType, bossId)
                        sendWebhookAlert(
                            bossId and "Boss Item Detected" or "Rare Egg Detected",
                            "**" .. label .. "** spawned in the sea\nPlayer: " .. tostring(LP.DisplayName),
                            RARITY_COLORS[rarity] or 10181046
                        )
                    end
                end
            end
        end
    end
end

