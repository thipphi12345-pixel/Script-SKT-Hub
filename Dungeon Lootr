        local KEYBIND_UNBOUND = "Unbound"

        function Group:AddKeybind(key, config)
            config = config or {}
            local default = tostring(config.Default or KEYBIND_UNBOUND)
            if default == "None" or default == "Unknown" then
                default = KEYBIND_UNBOUND
            end
            local controlDefault = default == KEYBIND_UNBOUND and "Unknown" or default
            local option = CreateBoundOption(self.Library, self.Library.Options, key, default, config.Callback)
            local setBoundValue = option.SetValue
            local function SyncMenuKey(value)
                if config.SyncMenu ~= true then return end
                local enumValue = Enum.KeyCode[tostring(value)]
                if enumValue and enumValue ~= Enum.KeyCode.Unknown and option.Library.Window then
                    option.Library.Window.ToggleKey = enumValue
                end
            end
            option.Control = self.Tab:AddKeybind({
                Name = config.Text or key,
                Default = controlDefault,
                Callback = function(value)
                    option.Library._KeybindReboundAt = os.clock()
                    local name = tostring(value)
                    option:_Changed((name == "None" or name == "Unknown") and KEYBIND_UNBOUND or name)
                    SyncMenuKey(value)
                end,
            })
            function option:SetValue(value)
                local name = tostring(value)
                if name == "None" or name == "Unknown" or name == KEYBIND_UNBOUND or value == Enum.KeyCode.Unknown then
                    if self.Value ~= KEYBIND_UNBOUND then self:_Changed(KEYBIND_UNBOUND) end
                    local button = self.Control and self.Control.Instance
                        and self.Control.Instance:FindFirstChild("BindButton")
                    if button then button.Text = "UNBOUND" end
                    return
                end
                setBoundValue(self, name)
            end
            option:SetValue(default)
            SyncMenuKey(controlDefault)
            return option
        end
        
