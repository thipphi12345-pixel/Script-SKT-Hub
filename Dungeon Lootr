    -- Auto Class Movement: resolve height based on active class
    -- Returns: height (studs) according to class type
    -- Melee  (Physical, Range < 15)  -> 12
    -- Mid    (Physical, Range 15-20) -> 16
    -- Long   (Range >= 21 or Ranged/Magic) -> 20
    S._classHeightCache = nil
    S.resolveClassHeight = function()
        -- Cache for 5 seconds (avoid re-reading Class_Data every frame)
        if S._classHeightCache and (tick() - (S._classHeightCache.t or 0)) < 5 then
            return S._classHeightCache.h
        end
        local className = H.getActiveClassName()
        local data = H.getClassData(className)
        local h = 8  -- default: melee (lowered from 12 to avoid VerticalReachCamp flag)
        if data then
            local range = data.Range or 8
            local dmgType = data.DamageType or "Physical"
            local useProj = data.UseProjectile or false
            if useProj or dmgType == "Ranged" or dmgType == "Magic" or range >= 21 then
                h = 12  -- Long (lowered from 20 to avoid anti-cheat flag at 20+ studs)
            elseif range >= 15 then
                h = 10  -- Mid (lowered from 16)
            else
                h = 8   -- Melee (lowered from 12)
            end
        end
        S._classHeightCache = { t = tick(), h = h }
        return h
    end

