    -- Whitelist of known Challenge enemy names (from DungeonData Double Dungeon EnemyPool + ChallengeData bosses)
    -- WHITELIST: only models with these names (or ItemId attribute matching) will be targeted.
    local isChallengeEnemyName
    do
    local CH_ENEMY_NAMES = {
        -- Regular enemies (Double Dungeon EnemyPool)
        "Fallen Knight", "Bone Soldier", "Wraith", "Dark Acolyte", "Dark Revenant",
        -- Challenge bosses (BOSS_PREVIEW_ORDER)
        "Scarlet Knight", "Imperator", "Shadow Knight", "Unrestricted EX",
        "Awakened Devil", "Frigid Monarch",
        -- Other possible dungeon enemies (from Enemy_Data)
        "Bandit Enforcer", "Goblin Warchief", "Knight Champion", "Frost Warden",
        "Verath", "Monkedeus",
    }

    isChallengeEnemyName = function(name)
        if not name or #name == 0 then return false end
        for _, known in ipairs(CH_ENEMY_NAMES) do
            if name == known then return true end
            -- Also match substring (boss names may have suffixes like "Scarlet Knight, The Crimson Revenant")
            if name:find(known, 1, true) then return true end
        end
        return false
    end
    end

    -- Find nearest alive enemy in Challenge_NPCs (STRICT - no workspace fallback)
    -- Challenge enemies may NOT have a Humanoid — filter by excluding non-enemy names instead.
    H.findChallengeEnemy = function()
        local r = hrp()
        if not r then return nil end
        local myPos = r.Position

        local best = nil
        local bestDist = math.huge

        local function tryCandidate(m)
            if not (m and m:IsA("Model") and m.Parent) then return end
            if Players:GetPlayerFromCharacter(m) then return end
            if m:GetAttribute("Dead") == true then return end
            -- Exclude non-enemy names (chests, items, decorations) by substring match
            local itemId = m:GetAttribute("ItemId")
            if not isChallengeEnemyName(m.Name) and not (itemId and isChallengeEnemyName(itemId)) then
                return
            end
            -- If has Humanoid, must be alive
            local h = m:FindFirstChildOfClass("Humanoid")
            if h and h.Health <= 0 then return end
            -- Find root part
            local root = m:FindFirstChild("HumanoidRootPart") or m.PrimaryPart
            if not root then
                for _, c in ipairs(m:GetDescendants()) do
                    if c:IsA("BasePart") then root = c; break end
                end
            end
            if not root then return end
            local dist = (root.Position - myPos).Magnitude
            if dist < bestDist then
                bestDist = dist
                best = { Model = m, Root = root, Humanoid = h, Dist = dist }
            end
        end

        -- 1. Challenge_NPCs (PRIMARY - enemies live here) - scan children AND descendants
        local cnpcs = workspace:FindFirstChild("Challenge_NPCs")
        if cnpcs then
            for _, m in ipairs(cnpcs:GetChildren()) do
                tryCandidate(m)
                for _, d in ipairs(m:GetDescendants()) do
                    if d:IsA("Model") then tryCandidate(d) end
                end
            end
        end

        -- 2. Challenge_Dungeons descendants (fallback - arena geometry)
        if not best then
            local cf = H.challengeFolder()
            if cf then
                for _, d in ipairs(cf:GetDescendants()) do
                    if d:IsA("Model") then tryCandidate(d) end
                end
            end
        end

        -- NO workspace top-level fallback - that would target lobby NPCs like Galan

        return best
    end

    -- Auto Collect Chest: warp ไปเก็บ chest ใน Challenge แล้วกลับมาฟาร์มต่อ
    -- ใช้ S.ChestBusy flag เพื่อหยุด combat ขณะเก็บ chest
    H.collectChallengeChests = function()
        if not (S.Running and CFG.AutoChallenge) then return end
        if S.ChestBusy then return end  -- กำลังเก็บอยู่แล้ว

        local chests = {}
        local seen = {}

        local function tryAddChest(d)
            if not (d and d:IsA("Model") and d.Parent) then return end
            if seen[d] then return end
            if S.LootedChests[d] then return end  -- เก็บแล้ว
            if not d.Name:find("Chest") or d.Name:find("Selection") then return end
            local prompt = d:FindFirstChild("ChestPrompt", true) or d:FindFirstChildOfClass("ProximityPrompt")
            if not prompt or not prompt.Enabled then return end
            local at = (prompt.ActionText or ""):lower()
            local ot = (prompt.ObjectText or ""):lower()
            if at:find("lock") or at:find("key") or ot:find("lock") or ot:find("key") then return end
            -- ChestZoneWarp safety (no-op if no room data in this mode)
            if not H.chestSafeToOpen(d:GetPivot().Position) then return end
            seen[d] = true
            table.insert(chests, d)
        end

        -- สแกน Challenge_Dungeons
        local cf = H.challengeFolder()
        if cf then
            for _, d in ipairs(cf:GetDescendants()) do tryAddChest(d) end
        end
        -- สแกน Challenge_NPCs (chest อาจอยู่ในนี้)
        local cnpcs = workspace:FindFirstChild("Challenge_NPCs")
        if cnpcs then
            for _, d in ipairs(cnpcs:GetDescendants()) do tryAddChest(d) end
        end

        if #chests == 0 then return end

        -- บันทึกตำแหน่งเดิมเพื่อ warp กลับ
        local myRoot = hrp()
        local returnPos = myRoot and myRoot.Position or nil

        -- ตั้ง flag หยุด combat
        S.ChestBusy = true
        S.Target = nil
        S.LockedTarget = nil
        S.WarpedTarget = nil
        if stopHoverLock then stopHoverLock() end
        log(("Challenge: found %d chest(s) - pausing combat to collect"):format(#chests))

        local opened = 0
        for _, ch in ipairs(chests) do
            if not S.Running or not CFG.AutoChallenge then break end
            if ch and ch.Parent and not S.LootedChests[ch] then
                local prompt = ch:FindFirstChild("ChestPrompt", true) or ch:FindFirstChildOfClass("ProximityPrompt")
                if prompt then
                    local p = ch:GetPivot().Position
                    log(("Challenge: warping to chest '%s'"):format(ch.Name))
                    -- วาร์ปไปที่ตำแหน่ง chest ตรงๆ (ไม่ +3 เพราะต้องอยู่ใกล้ prompt ให้แสดง)
                    pcall(function() H.warpTo(p) end)
                    task.wait(0.25)
                    -- รอให้ prompt แสดง (DungeonChestController จะ auto InputHoldBegin เมื่อ prompt โชว์)
                    -- ลอง fire หลายครั้ง รอนานขึ้น
                    for attempt = 1, 3 do
                        if not ch.Parent then break end
                        pcall(function()
                            prompt:InputHoldBegin()
                            task.wait((prompt.HoldDuration or 1) + 0.25)
                            prompt:InputHoldEnd()
                        end)
                        task.wait(0.25)
                    end
                    if not ch.Parent then
                        S.LootedChests[ch] = true
                        opened = opened + 1
                        log(("Challenge: chest '%s' collected"):format(ch.Name))
                    else
                        log(("Challenge: chest '%s' failed after 3 attempts - skipping"):format(ch.Name))
                    end
                end
            end
        end

        if opened > 0 then
            log(("Challenge: looted %d chest(s)"):format(opened))
        end

        -- Warp กลับจุดเดิมเพื่อฟาร์มต่อ
        if returnPos then
            task.wait(0.3)
            H.warpTo(returnPos + Vector3.new(0, 3, 0))
            log("Challenge: returned to farm position")
        end

        -- ปล่อย flag ให้ combat ทำงานต่อ
        S.ChestBusy = false
    end

    -- Debug logger for Challenge (use CH table field to avoid file-level local register limit)
    CH._logDebug = function()
        local cnpcs = workspace:FindFirstChild("Challenge_NPCs")
        local names = {}
        local aliveCount, withHum, withoutHum = 0, 0, 0
        if cnpcs then
            for _, m in ipairs(cnpcs:GetChildren()) do
                local h = m:FindFirstChildOfClass("Humanoid")
                local root = m:FindFirstChild("HumanoidRootPart") or m.PrimaryPart
                if not root then
                    for _, c in ipairs(m:GetDescendants()) do
                        if c:IsA("BasePart") then root = c; break end
                    end
                end
                local excluded = not isChallengeEnemyName(m.Name) and not (m:GetAttribute("ItemId") and isChallengeEnemyName(m:GetAttribute("ItemId")))
                local dead = m:GetAttribute("Dead") == true
                local info = m.Name .. "(" .. m.ClassName .. ")"
                if h then info = info .. "[H:" .. h.Health .. "]" else info = info .. "[noH]" end
                if root then info = info .. "[R]" else info = info .. "[noR]" end
                if excluded then info = info .. "[EX]" end
                if dead then info = info .. "[DEAD]" end
                table.insert(names, info)
                if m:IsA("Model") and not Players:GetPlayerFromCharacter(m)
                    and not dead and not excluded and root then
                    if h then
                        if h.Health > 0 then
                            aliveCount = aliveCount + 1
                            withHum = withHum + 1
                        end
                    else
                        aliveCount = aliveCount + 1
                        withoutHum = withoutHum + 1
                    end
                end
            end
        end
        log(("Challenge: no target - candidates=%d (withHum=%d noHum=%d)"):format(
            aliveCount, withHum, withoutHum))
        log("Challenge: Challenge_NPCs children: " .. table.concat(names, ", "))
    end

    CH._loop = function()
        log("Challenge: combat loop started")
        H.startPotionWatcher()
        H.startParryWatcher()

        -- Boss Dodge Scanner: start if enabled
        if CFG.AutoBossDodge then startBossDodgeScanner() end
        startTelegraphDodgeScanner()

        local lastAttackTick = 0
        local lastSkillTick = 0
        local debugTick = 0
        local lastTargetTick = tick()
        local lastWarpTick = 0
        local chestTick = 0

        while S.Running and CFG.AutoChallenge and inChallengeRun() and not S.UserStopped do
            if CH.RunComplete then
                log("Challenge: run complete - " .. tostring(CH.RunComplete.Status))
                break
            end

            -- Wait for respawn (prevent warp-to-mob bug after death)
            if S.Respawning then
                task.wait(0.5)
            end
            if not S.Respawning then

            local now = tick()
            H.resetStuckFlags()

            -- Auto Collect Chest: check every 5s
            if (now - chestTick) >= 5 then
                chestTick = now
                pcall(H.collectChallengeChests)
            end

            -- Scan every iteration (no caching - enemies die fast in Challenge)
            local target = nil
            pcall(function() target = H.findChallengeEnemy() end)

            -- Debug log every 2s (extracted to reduce local register count)
            if (now - debugTick) >= 2 then
                debugTick = now
                if target then
                    local hp = target.Humanoid and target.Humanoid.Health or -1
                    log(("Challenge: target=%s HP=%.0f dist=%.1f"):format(
                        target.Model.Name, hp, target.Dist))
                else
                    CH._logDebug()
                end
            end

            -- Attack (skip if collecting chest or dodging telegraph)
            if target and not S.ChestBusy and not S.TelegraphDodgeActive then
                attack(target)
                lastAttackTick = now
                lastTargetTick = now
            else
                -- If no target for 5s, move toward Challenge_NPCs center (but only once per 5s)
                if (now - lastTargetTick) >= 5 and (now - lastWarpTick) >= 5 then
                    lastWarpTick = now
                    local cnpcs = workspace:FindFirstChild("Challenge_NPCs")
                    if cnpcs then
                        local sumPos = Vector3.zero
                        local count = 0
                        for _, m in ipairs(cnpcs:GetChildren()) do
                            if m:IsA("Model") then
                                local root = m:FindFirstChild("HumanoidRootPart") or m.PrimaryPart
                                if root then
                                    sumPos = sumPos + root.Position
                                    count = count + 1
                                end
                            end
                        end
                        if count > 0 then
                            local center = sumPos / count
                            log(("Challenge: no target 5s - moving toward NPC center (count=%d)"):format(count))
                            H.warpTo(center + Vector3.new(0, 5, 0))
                        end
                    end
                end
            end

            -- Skill
            if target and not S.ChestBusy and (now - lastSkillTick) >= (CFG.SkillInterval or 1.0) then
                local ePos = target.Root.Position
                local myPos = hrp() and hrp().Position or Vector3.zero
                local dir = (ePos - myPos).Unit
                pcall(function() H.trySkill(dir) end)
                lastSkillTick = now
            end

            task.wait(H.combatJitter(CFG.AttackInterval or 0.15))
            end -- end if not S.Respawning
        end

        log("Challenge: combat loop ended")
    end

    CH._mainLoop = function()
        S.ChallengeMode = true
        H.enableNoClip()
        H.hookChallengeEvents()
        H.hookPartySignals()
        if CFG.PartyEnabled and CFG.PartyAutoAccept then H.refreshFriends() end
        log("Challenge: Started")

        while S.Running and CFG.AutoChallenge and not S.UserStopped do
            local inC = inChallengeRun()
            local inR = inRun()

            if inC then
                -- Already in challenge - wait for arena to load
                log("Challenge: in run - waiting for NPCs to spawn...")
                -- Wait for Challenge_NPCs folder to appear
                local npcsLoaded = false
                for _ = 1, 30 do
                    if not S.Running or not CFG.AutoChallenge then break end
                    if workspace:FindFirstChild("Challenge_NPCs") then
                        npcsLoaded = true
                        break
                    end
                    task.wait(0.5)
                end
                if npcsLoaded then
                    log("Challenge: NPCs found - starting combat")
                    task.wait(1)
                else
                    log("Challenge: NPC load timeout - starting combat anyway")
                end
                CH._loop()

                -- Run ended
                if not S.Running or not CFG.AutoChallenge then break end
                task.wait(2)

                local status = CH.RunComplete and CH.RunComplete.Status
                CH.RunComplete = nil

                if CFG.AutoReplay and status ~= "Failed" then
                    log("Challenge: run ended (status=" .. tostring(status) .. ") - replaying")
                    pcall(function() call("DungeonRunService", "RequestReplay") end)
                elseif CFG.AutoReturnLobby then
                    log("Challenge: run ended (status=" .. tostring(status) .. ") - returning to lobby")
                    pcall(function() call("DungeonRunService", "RequestReturn") end)
                end
                -- Wait for exit
                for _ = 1, 40 do
                    if not S.Running or not CFG.AutoChallenge then break end
                    if not inChallengeRun() then break end
                    task.wait(0.5)
                end
                task.wait(2)
            elseif not inR then
                -- In lobby - enter challenge
                log("Challenge: in lobby - entering...")
                CH.RunComplete = nil
                local ok = H.enterChallenge()
                if not ok then
                    log("Challenge: failed to enter - retrying in 3s")
                    task.wait(3)
                end
            else
                -- In regular dungeon - try to enter challenge
                log("Challenge: in regular dungeon - returning to lobby first...")
                pcall(function() call("DungeonRunService", "RequestReturn") end)
                task.wait(3)
            end
            task.wait(0.3)
        end

        H.unhookChallengeEvents()
        S.ChallengeMode = false
        S.LoopActive = false
        H.disableNoClip()
        H.unanchorPlayer()
        log("Challenge: Stopped")
    end
    -- ============================================================
    --  PAYLOAD MODE (UPDATE 2): boat escort - board, ready, defend checkpoints
    -- ============================================================
    H.inPayload = function()
        if workspace:FindFirstChild("Payload_Maps") then return true end
        for _, c in ipairs(workspace:GetChildren()) do
            if c.Name:find("^PayloadCombat") or c.Name:find("^PayloadAllies") then return true end
        end
        return workspace:FindFirstChild("PayloadEnemies", true) ~= nil
    end

    -- runtime payload container: map folder under Payload_Maps, or PayloadCombat itself
    H.payloadMapFolder = function()
        local pm = workspace:FindFirstChild("Payload_Maps")
        if pm then
            for _, c in ipairs(pm:GetChildren()) do
                if c:IsA("Model") or c:IsA("Folder") then return c end
            end
        end
        for _, c in ipairs(workspace:GetChildren()) do
            if c.Name:find("^PayloadCombat") then return c end
        end
        return workspace:FindFirstChild("Payload_Map")
            or workspace:FindFirstChild("Floating_Aisles", true)
    end

    H.payloadBoat = function()
        local map = H.payloadMapFolder()
        local boat = map and map:FindFirstChild("Wooden Boat", true)
        if not boat and map then
            for _, d in ipairs(map:GetDescendants()) do
                if d:IsA("Model") and d.Name:lower():find("boat") then boat = d break end
            end
        end
        if not boat then boat = workspace:FindFirstChild("Wooden Boat", true) end
        return boat
    end

    H.payloadBoatPos = function()
        local boat = H.payloadBoat()
        if not boat then return nil end
        local root = boat:FindFirstChild("ROOT", true) or boat.PrimaryPart or boat:FindFirstChildWhichIsA("BasePart", true)
        return root and root.Position
    end

    -- OnBoat is client-computed (server state does not include it): raycast down onto boat
    H.payloadOnBoat = function()
        local r = hrp()
        local boat = H.payloadBoat()
        if not (r and boat) then return false end
        local rp = RaycastParams.new()
        rp.FilterType = Enum.RaycastFilterType.Include
        rp.FilterDescendantsInstances = { boat }
        rp.RespectCanCollide = true
        return workspace:Raycast(r.Position, Vector3.new(0, -8, 0), rp) ~= nil
    end


    local payloadEnemyCache = { list = {}, tick = 0 }
    H.payloadEnemies = function()
        local now = tick()
        if (now - payloadEnemyCache.tick) < 0.3 then return payloadEnemyCache.list end
        payloadEnemyCache.tick = now
        local out, seen = {}, {}
        local function add(m)
            if not (m:IsA("Model") and not seen[m]) then return end
            local named = ValidEnemyNames[m.Name] or (EnemyData and EnemyData[m.Name]) or m:GetAttribute("IsBoss") == true
            if not named then return end
            if S.PayloadCorpses and S.PayloadCorpses[m] then return end
            -- dead flags on custom rigs (no Humanoid -> dead attribute or Health<=0)
            if m:GetAttribute("Dead") == true or m:GetAttribute("IsDead") == true or m:GetAttribute("Alive") == false then return end
            local hpA = m:GetAttribute("Health") or m:GetAttribute("HP")
            if type(hpA) == "number" and hpA <= 0 then return end
            -- alive: normal humanoid check; custom-rig enemies (e.g. Torus has no Humanoid) count as alive while model exists
            if not (isAlive(m) or m:FindFirstChildOfClass("Humanoid") == nil) then return end
            local root = m:FindFirstChild("HumanoidRootPart") or m:FindFirstChild("RootPart") or m.PrimaryPart or m:FindFirstChildWhichIsA("BasePart", true)
            if root then
                seen[m] = true
                table.insert(out, { Model = m, Root = root, IsBoss = (m:GetAttribute("IsBoss") == true) })
            end
        end
        -- real runtime layout: workspace.PayloadCombat_<guid> holds enemies (PayloadAllies_<guid> = friendly, skip)
        for _, c in ipairs(workspace:GetChildren()) do
            if c.Name:find("^PayloadCombat") then
                for _, d in ipairs(c:GetDescendants()) do add(d) end end
            end
        local pe = workspace:FindFirstChild("PayloadEnemies", true)
        if pe then for _, d in ipairs(pe:GetDescendants()) do add(d) end end
        local mf2 = H.payloadMapFolder()
        if mf2 then for _, d in ipairs(mf2:GetDescendants()) do add(d) end end
        local pm = workspace:FindFirstChild("Payload_Maps")
        if pm then for _, d in ipairs(pm:GetDescendants()) do add(d) end end
        local he = workspace:FindFirstChild("Humanoid_Enemies")
        if he then for _, d in ipairs(he:GetChildren()) do add(d) end end
        -- enemies may spawn loose under workspace (not inside Payload_Maps)
        for _, d in ipairs(workspace:GetChildren()) do add(d) end
        payloadEnemyCache.list = out
        return out
    end

    -- excludePos: skip pods within 8 studs of it (previous pod had people)
    H.findPayloadPodPosition = function(excludePos)
        local pods = {}
        local r = hrp()
        local myPos = r and r.Position
        for _, d in ipairs(workspace:GetDescendants()) do
            if d:IsA("Model") and d.Name:match("^Payload_Pod") then
                -- prefer the actual Touch zone part, then WarpIn, then any part
                local p = d:FindFirstChild("Touch", true)
                    or d:FindFirstChild("WarpIn", true)
                    or d:FindFirstChildWhichIsA("BasePart", true)
                local pos = (p and p:IsA("BasePart")) and p.Position or nil
                if pos and not (excludePos and (pos - excludePos).Magnitude < 8) then
                    table.insert(pods, pos)
                end
            end
        end
        local function pick(onlyEmpty)
            local best, bestD = nil, math.huge
            for _, pos in ipairs(pods) do
                if not onlyEmpty or H.countPlayersNear(pos, 12) == 0 then
                    local dist = myPos and (pos - myPos).Magnitude or 0
                    if dist < bestD then bestD, best = dist, pos end
                end
            end
            return best
        end
        -- solo play: prefer an empty pod so we do not join strangers' queue
        if not CFG.PartyEnabled then
            local empty = pick(true)
            if empty then return empty end
        end
        return pick(false)
    end

    H.hookPayloadSignals = function()
        if S.PayloadHooked then return end
        S.PayloadHooked = true
        connect(evt("PayloadRunService", "StateChanged"), function(st)
            if type(st) == "table" then S.PayloadState = st end
        end)
        connect(evt("PayloadRunService", "ChestSelection"), function(cands, extra, offerId)
            -- Payload chest event args: (candidates, ownsExtraLoot, offerId, deadline)
            if not offerId then return end
            task.wait(0.2)
            local n = (extra and 3 or 2)
            local picks = {}
            for i = 1, n do picks[i] = i end
            for _, i in ipairs(picks) do
                pcall(function() call("PayloadRunService", "PickCheckpointChest", offerId, i) end)
                task.wait(0.08)
            end
            pcall(function() call("PayloadRunService", "SelectCheckpointChests", offerId, picks) end)
            print("[AutoFarm] Payload| auto-picked " .. n .. " chests")
        end)
        connect(evt("PayloadRunService", "DungeonComplete"), function()
            S.PayloadDone = true
            print("[AutoFarm] Payload| DungeonComplete")
        end)
    end

    -- Select payload difficulty AND verify via RequestPartyData (same flow the
    -- real lobby uses). Retries until the server reports the wanted difficulty.
    local function ensurePayloadDifficulty(diff)
        for _ = 1, 4 do
            local ok, res = call("DungeonQueueService", "RequestSelectPayload", diff)
            task.wait(0.2)
            local okP, pd = call("DungeonQueueService", "RequestPartyData")
            if okP and type(pd) == "table" then
                print(("[AutoFarm] Payload|: server mode=%s difficulty=%s (want %s)"):format(
                    tostring(pd.SelectedMode), tostring(pd.SelectedDifficulty), diff))
                if pd.SelectedMode == "Payload" and pd.SelectedDifficulty == diff then
                    return true
                end
            elseif ok and res ~= false then
                return true  -- no party data to verify against; request was accepted
            end
            task.wait(0.15)
        end
        print(("[AutoFarm] Payload|: WARNING could not confirm difficulty %s"):format(diff))
        return false
    end

    H.enterPayload = function()
        local diff = CFG.PayloadDifficulty or "Easy"
        print("[AutoFarm] Payload| RequestSelectPayload " .. diff)
        local confirmed = ensurePayloadDifficulty(diff)
        local podPos = H.findPayloadPodPosition()
        if podPos then
            H.warpToPod(podPos)
            -- solo: if someone is already on this pod, hop to an empty one
            if not CFG.PartyEnabled and H.countPlayersNear(podPos, 12) > 0 then
                print("[AutoFarm] Payload|: pod occupied - moving to empty pod")
                local alt = H.findPayloadPodPosition(podPos)
                if alt then podPos = alt H.warpToPod(alt) end
            end
        else
            print("[AutoFarm] Payload|: no Payload_Pod found - queueing anyway")
        end
        if not confirmed then ensurePayloadDifficulty(diff) end  -- only re-confirm if first pass failed
        local ok, res = call("DungeonQueueService", "RequestStartPodQueue")
        print("[AutoFarm] Payload|: PodQueue ->", ok, res)
        -- Press Enter + Start right away (same sequence as challenge/dungeon UI)
        task.wait(0.15)
        if not H.inPayload() then
            call("DungeonQueueService", "RequestEnter")
        end
        task.wait(0.2)
        if not H.inPayload() then
            local ok2, res2 = call("DungeonQueueService", "RequestStartNow")
            print("[AutoFarm] Payload|: StartNow ->", ok2, res2)
        end
        -- pod zone can miss the teleport: re-warp and retry once if still not entering
        for _ = 1, 8 do
            if not S.Running or H.inPayload() then return end
            task.wait(0.4)
        end
        if not H.inPayload() then
            print("[AutoFarm] Payload|: not in map yet - re-warping pod + retry")
            local podPos2 = H.findPayloadPodPosition()
            if podPos2 then H.warpToPod(podPos2) end
            call("DungeonQueueService", "RequestStartPodQueue")
            task.wait(0.3)
            call("DungeonQueueService", "RequestEnter")
            task.wait(0.5)
            if not H.inPayload() then
                call("DungeonQueueService", "RequestStartNow")
            end
        end
    end

    H.payloadLoop = function()
        log("Payload: in map - starting run loop")
        H.hookPayloadSignals()
        S.PayloadDone = false
        local ok, st = call("PayloadRunService", "GetSessionState")
        if ok and type(st) == "table" then
            S.PayloadState = st
            if st.RunId then call("PayloadRunService", "FinishLoading", st.RunId) end
        end
        local stateTick = 0
        local shipTick = 0
        local dbgTick = 0
        while S.Running and CFG.AutoPayload and H.inPayload() do
            if S.Respawning then task.wait(0.5) end
            if not S.Respawning then
            local stt0 = S.PayloadState
            local ph0 = stt0 and stt0.Phase
            local pollInt = (ph0 == "BoardingAtStart" or ph0 == "AwaitingBoarding" or ph0 == "Departing") and 0.3 or 1
            if (tick() - stateTick) >= pollInt then
                stateTick = tick()
                local ok2, st2 = call("PayloadRunService", "GetSessionState")
                if ok2 and type(st2) == "table" then S.PayloadState = st2 end
            end
            local stt = S.PayloadState
            local phase = stt and stt.Phase or nil
            if (tick() - dbgTick) >= 2 then
                dbgTick = tick()
                local mf = H.payloadMapFolder()
                print(("[AutoFarm] Payload|: phase=%s active=%s canReady=%s isReady=%s onBoat=%s boat=%s map=%s enemies=%d"):format(
                    tostring(phase), tostring(stt and stt.Active), tostring(stt and stt.CanReady),
                    tostring(stt and stt.IsReady), tostring(H.payloadOnBoat()),
                    tostring(H.payloadBoat() ~= nil), tostring(mf and mf.Name),
                    #H.payloadEnemies()))
                do
                    local en = H.payloadEnemies()
                    if #en > 0 then
                        local nn = {}
                        for _, e in ipairs(en) do nn[#nn+1] = e.Model.Name end
                        print("[AutoFarm] Payload| enemy names:", table.concat(nn, ", "))
                    end
                    -- boss check: scan only payload containers (not whole workspace - too heavy)
                    local found = {}
                    local function scanBoss(parent)
                        if not parent then return end
                        for _, d in ipairs(parent:GetDescendants()) do
                            if #found >= 5 then return end
                            if d:IsA("Model") and (d.Name:lower():find("torus") or d:GetAttribute("IsBoss") == true) then
                                found[#found+1] = d:GetFullName()
                            end
                        end
                    end
                    scanBoss(mf)
                    for _, c in ipairs(workspace:GetChildren()) do
                        if c.Name:find("^Payload") and c ~= mf then scanBoss(c) end
                    end
                    if #found > 0 then
                        print("[AutoFarm] Payload| boss models:", table.concat(found, ", "))
                    end
                end
                if phase == "Defending" and #H.payloadEnemies() == 0 then
                    -- dump structure: direct children of map + any model whose name looks like an enemy
                    local names = {}
                    if mf then
                        for _, d in ipairs(mf:GetChildren()) do
                            names[#names+1] = mf.Name .. "." .. d.Name .. "(" .. d.ClassName .. ")"
                            if #names >= 12 then break end
                        end
                    end
                    print("[AutoFarm] Payload| map children:", table.concat(names, ", "))
                    local foes = {}
                    local function scan(parent)
                        if not parent then return end
                        for _, d in ipairs(parent:GetDescendants()) do
                            if #foes >= 10 then return end
                            local n = d.Name:lower()
                            if d:IsA("Model") and (n:find("orc") or n:find("enemy") or n:find("enemies") or n:find("npc") or n:find("mob") or n:find("torus") or n:find("skeleton")) then
                                foes[#foes+1] = d:GetFullName()
                            end
                        end
                    end
                    scan(mf)
                    if #foes == 0 then
                        for _, d in ipairs(workspace:GetChildren()) do
                            local n = d.Name:lower()
                            if n:find("payload") or n:find("combat") or n:find("enem") or n:find("npc") then
                                foes[#foes+1] = d:GetFullName() .. "(" .. d.ClassName .. ")"
                                if #foes >= 10 then break end
                            end
                        end
                    end
                    print("[AutoFarm] Payload| enemy-like models:", table.concat(foes, ", "))
                end
            end
            if S.PayloadDone or phase == "PrototypeComplete" or phase == "Complete" then
                task.wait(2)
                call("PayloadRunService", "RequestReturn")
                task.wait(2)
                break
            end
            if phase == "Failed" then
                print("[AutoFarm] Payload| run FAILED - returning")
                call("PayloadRunService", "RequestReturn")
                task.wait(2)
                break
            end
            if phase == "BoardingAtStart" or phase == "AwaitingBoarding" or phase == "Departing" then
                -- OnBoat is computed client-side; server never sends it -> check via raycast
                if not H.payloadOnBoat() and (tick() - shipTick) >= 1 then
                    shipTick = tick()
                    local okR, resR = call("PayloadRunService", "ReturnToShip")
                    print("[AutoFarm] Payload|: ReturnToShip ->", okR, resR)
                end
                if stt and stt.CanReady and not stt.IsReady and stt.RunId then
                    local okS, resS = call("PayloadRunService", "SetReady", stt.RunId, stt.Generation, true)
                    print("[AutoFarm] Payload|: SetReady ->", okS, resS)
                    task.wait(0.15)
                end
                
                -- UPDATE: Check Blessing Altars while on boat or waiting
                local bPos = H.payloadBoatPos() or (hrp() and hrp().Position)
                if bPos then
                    pcall(function() H.useAltarsNear(bPos, 250, "payload-wait") end)
                end

                task.wait(0.15)
            else
                -- fell too far behind the moving boat -> teleport back before fighting
                -- (skip while a boss is up - boss arena can be far from the boat)
                local boatP = H.payloadBoatPos()
                local myR = hrp()
                local bossUp = false
                for _, e in ipairs(H.payloadEnemies()) do
                    if e.IsBoss or e.Model.Name:lower():find("torus") then bossUp = true break end
                end
                if boatP and myR and not H.payloadOnBoat() and not bossUp
                    and (myR.Position - boatP).Magnitude > 150
                    and (tick() - shipTick) >= 4 then
                    shipTick = tick()
                    print("[AutoFarm] Payload| too far from boat - ReturnToShip")
                    call("PayloadRunService", "ReturnToShip")
                    task.wait(0.5)
                end
                local enemies = H.payloadEnemies()
                if #enemies > 0 then
                    local anchor = boatP or (myR and myR.Position)
                    local best, bestD = nil, math.huge
                    local boss = nil
                    for _, e in ipairs(enemies) do
                        if e.IsBoss or e.Model.Name:lower():find("torus") then boss = e break end
                        local d = anchor and (e.Root.Position - anchor).Magnitude or 0
                        if d < bestD then bestD, best = d, e end
                    end
                    if boss then best = boss end
                    if best then
                        -- corpse-watch: same NON-BOSS target unmoving for >4s -> treat as dead, pick next
                        -- (bosses like Torus can stand still - never mark them)
                        local bestIsBoss = best.IsBoss or best.Model.Name:lower():find("torus") ~= nil
                        if S.PayloadLastTarget == best.Model then
                            local moved = S.PayloadLastPos and (best.Root.Position - S.PayloadLastPos).Magnitude or 999
                            if not bestIsBoss and (tick() - S.PayloadLastTick) > 4 and moved < 1 then
                                S.PayloadCorpses = S.PayloadCorpses or {}
                                S.PayloadCorpses[best.Model] = true
                                S.PayloadLastTarget = nil
                                print("[AutoFarm] Payload| target unmoving - marked dead:", best.Model.Name)
                            end
                        else
                            S.PayloadLastTarget = best.Model
                            S.PayloadLastTick = tick()
                            S.PayloadLastPos = best.Root.Position
                        end
                        S.Target = best
                        if not S.ChestBusy and not S.TelegraphDodgeActive then
                            attack(best)
                        end
                    end
                    
                    -- UPDATE: Check Blessing Altars while fighting in payload
                    local bPosF = H.payloadBoatPos() or (hrp() and hrp().Position)
                    if bPosF then
                        pcall(function() H.useAltarsNear(bPosF, 250, "payload-combat") end)
                    end

                    task.wait(H.combatJitter(CFG.AttackInterval or 0.1))
                else
                    -- no enemies left -> drop the float so the game can carry us back to the boat
                    stopHoverLock()
                    H.unanchorPlayer()
                    if not H.payloadOnBoat() and (tick() - shipTick) >= 1.5 then
                        shipTick = tick()
                        call("PayloadRunService", "ReturnToShip")
                    end
                    task.wait(0.5)
                end
            end
            end
        end
        stopHoverLock()
        S.Target = nil
        print("[AutoFarm] Payload| loop ended")
    end


    S._mainLoop = function()
        -- Increment generation to invalidate any stale loop
        S.LoopGen = (S.LoopGen or 0) + 1
        local myGen = S.LoopGen
        -- Wait for any previous loop to finish before starting new one
        local waited = 0
        while S.LoopActive and waited < 10 do
            task.wait(0.2)
            waited = waited + 0.2
            -- If generation changed, a newer loop was started - abort
            if S.LoopGen ~= myGen then return end
        end
        if S.LoopActive then
            log("mainLoop: previous loop still active after 10s - forcing start")
            S.LoopActive = false
        end
        S.LoopActive = true
        H.enableNoClip()
        H.hookRunEvents()
        H.startMagnetWatcher()
        H.startStuckWatchdog()
        -- Hook party signals (invite accept, party update, invite result)
        H.hookPartySignals()
        -- Refresh friend list for auto-accept
        if CFG.PartyEnabled and CFG.PartyAutoAccept then
            H.refreshFriends()
        end
        -- Refresh party data on start
        if CFG.PartyEnabled then
            task.spawn(function()
                task.wait(1)
                H.getPartyData()
            end)
        end
        -- เธ–เนเธฒเน€เธฃเธดเนเธกเธ•เธญเธเธ—เธตเนเธญเธขเธนเนเนเธเธ”เธฑเธเน€เธเธตเนเธขเธเธญเธขเธนเนเนเธฅเนเธง เนเธซเนเน€เธเนเธ progress เธซเนเธญเธเนเธงเน เนเธกเนเธฃเธตเน€เธเนเธ•เนเธเธซเนเธญเธเนเธฃเธ
        -- + sync เธเธฒเธ persistent state (เธเนเธฒเธก toggle)
        H.resetRunState(inRun())
        if inRun() then
            log("Resuming in-run: BlessingDone=" .. tostring(S.BlessingDone)
                .. " Cleared=" .. tostring(next(S.Cleared) ~= nil))
        end

        -- Boss Rush mode: route to separate loop
            if CFG.BossRushEnabled then
                H.bossRushMainLoop()
                return
            end
            -- Raid mode: route to separate loop
            if CFG.RaidEnabled then
                RD.raidMainLoop()
                return
            end

            -- Challenge mode: route to separate loop
            if CFG.AutoChallenge then
                CH._mainLoop()
                return
            end

        while S.Running and not S.UserStopped do
            -- If generation changed, a newer loop was started - abort this one
            if S.LoopGen ~= myGen then
                log("mainLoop: newer generation detected - aborting stale loop")
                return
            end
            -- Wait for respawn (prevent warp-to-mob bug after death)
            if S.Respawning then
                task.wait(0.5)
            end
            if not S.Respawning then
            S.CurrentLoopGen = myGen  -- for farmLoop to check
            -- Party: refresh player dropdown + party data periodically
            if CFG.PartyEnabled then
                H.refreshPlayerList()
                H.refreshPartyData()
                -- Update party status label
                if S.PartyStatusLabel and S.PartyStatusLabel.SetText then
                    S.PartyStatusLabel:SetText(H.getPartyStatus())
                end
            end
            if CFG.AutoPayload then
                if H.inPayload() then
                    H.payloadLoop()
                else
                    print("[AutoFarm] Payload| Lobby: entering...")
                    H.enterPayload()
                    task.wait(2)
                end
            elseif inRun() or LP:GetAttribute("InDungeon") then
                log("Waiting for map to load...")
                -- Update status: in dungeon
                if CFG.AutoFarmLVL and S.AutoFarmLVL_LastDungeon and S.AutoFarmLVL_CurrentDifficulty then
                    if S.StatusLabel then
                        S.StatusLabel:SetText(("Status: %s / %s"):format(
                            S.AutoFarmLVL_LastDungeon, S.AutoFarmLVL_CurrentDifficulty))
                    end
                    if S.updateRealtimeStatus then S.updateRealtimeStatus(S.AutoFarmLVL_LastDungeon .. " / " .. S.AutoFarmLVL_CurrentDifficulty) end
                end
                if not H.waitForMapLoad(30) then
                    log("Map load timeout - retrying")
                    task.wait(2)
                else
                    log("Map loaded - starting farm")
                    local why = H.farmLoop()
                    if S.Running and why == "complete" then
                        H.finishRun()
                    elseif S.Running and why ~= "aborted" and why ~= nil then
                        -- Run ended without DungeonComplete (died/kicked/left) -> count as fail
                        if not S.Complete or S.Complete.Status == "Failed" then
                            H.noteLVLFail(why or "run-ended")
                        end
                    end
                end
            elseif CFG.AutoJoin or CFG.AutoFarmEndless or CFG.AutoFarmLVL then
                -- Update status: in lobby, entering dungeon
                if CFG.AutoFarmLVL and S.StatusLabel then
                    if S.AutoFarmLVL_LastDungeon and S.AutoFarmLVL_CurrentDifficulty then
                        S.StatusLabel:SetText(("Status: Lobby -> %s / %s"):format(
                            S.AutoFarmLVL_LastDungeon, S.AutoFarmLVL_CurrentDifficulty))
                        if S.updateRealtimeStatus then S.updateRealtimeStatus("Lobby -> " .. S.AutoFarmLVL_LastDungeon .. " / " .. S.AutoFarmLVL_CurrentDifficulty) end
                    else
                        S.StatusLabel:SetText("Status: Lobby (selecting dungeon...)")
                        if S.updateRealtimeStatus then S.updateRealtimeStatus("Lobby (selecting dungeon...)") end
                    end
                end
                -- Wait 6 seconds in lobby before entering (prevent load bugs)
                log("Lobby: waiting 6s before entering dungeon...")
                for _ = 1, 12 do
                    if not S.Running then break end
                    task.wait(0.5)
                end
                if not S.Running then return end
                H.enterDungeon()
                -- Wait for dungeon to load before checking again (prevent re-calling enterDungeon)
                for _ = 1, 20 do
                    if not S.Running then break end
                    if inRun() or LP:GetAttribute("InDungeon") then break end
                    task.wait(0.5)
                end
                task.wait(1)
            else
                log("lobby - AutoJoin off")
                task.wait(2)
            end
            task.wait(0.3)
            end -- end if not S.Respawning
        end
        syncToPersistent()
        H.disableNoClip()
        H.unanchorPlayer()
        H.unhookAll()
        H.hideCircle()
        S.LoopActive = false
        log("stopped")
    end


