    -- Filter entries ตาม category
    -- Filter entries ตาม category & rarity
    H.filterEntries = function(entries, category)
        local filtered = {}
        local selectedRarities = type(CFG.AutoBuyRarity) == "table" and CFG.AutoBuyRarity or {}
        local filterByRarity = next(selectedRarities) ~= nil

        for _, e in ipairs(entries) do
            -- 1. Check Slot Category
            if not category or category == "All" or e.slot == category then
                -- 2. Check Rarity Overlap
                local rarityMatch = false
                if filterByRarity then
                    local itemMinIdx = H.RarityIndex[e.minR] or 0
                    local itemMaxIdx = H.RarityIndex[e.maxR] or 99
                    for selR, enabled in pairs(selectedRarities) do
                        if enabled then
                            local selIdx = H.RarityIndex[selR] or -1
                            if selIdx >= itemMinIdx and selIdx <= itemMaxIdx then
                                rarityMatch = true
                                break
                            end
                        end
                    end
                else
                    rarityMatch = true -- No rarity filter selected, show all
                end

                if rarityMatch then
                    table.insert(filtered, e)
                end
            end
        end
        return filtered
    end

