    H.collectFloorDrops = function(center, radius)
        if not (CFG.AutoDrops and center) then return end
        local maxDist = radius or 55

        -- เธ”เธถเธเน€เธเธเธฒเธฐ Drop เนเธ—เนเธ—เธตเนเธกเธต Attribute DropId เธซเธฃเธทเธญ DropType เน€เธ—เนเธฒเธเธฑเนเธ
        -- เนเธฅเธฐเธ•เนเธญเธเธญเธขเธนเนเธ เธฒเธขเนเธเธเธญเธเน€เธเธ•เธซเนเธญเธเธเธฑเธเธเธธเธเธฑเธ
        local pool = {}
        local deb = workspace:FindFirstChild("Debris")
        if deb then
            for _, c in ipairs(deb:GetChildren()) do
                if c:GetAttribute("DropId") or c:GetAttribute("DropType") then
                    table.insert(pool, c)
                end
            end
        end
        for _, c in ipairs(workspace:GetChildren()) do
            if c:GetAttribute("DropId") or c:GetAttribute("DropType") then
                table.insert(pool, c)
            end
        end

        local count = 0
        for _, obj in ipairs(pool) do
            if not S.Running then break end
            if obj and obj.Parent then
                local p = obj:IsA("BasePart") and obj.Position or (obj:IsA("Model") and obj:GetPivot().Position)
                if p and p.Y > -100 then
                    local flatDist = Vector3.new(p.X - center.X, 0, p.Z - center.Z).Magnitude
                    local vertDist = math.abs(p.Y - center.Y)
                    if flatDist <= maxDist and vertDist <= 20 then
                        local did = obj:GetAttribute("DropId")
                        local dtype = obj:GetAttribute("DropType") or "Coin"
                        local dval = obj:GetAttribute("Value") or 1
                        local src = obj:GetAttribute("SourceId")
                        local mat = obj:GetAttribute("MaterialId")

                        -- เน€เธฃเธตเธขเธ RF CollectDrop เธเธ server เนเธ”เธขเธ•เธฃเธ (เนเธกเนเธงเธฒเธฃเนเธเธ•เธฑเธงเน€เธฃเธฒเน€เธ”เนเธ”เธเธฒเธ” เธเนเธญเธเธเธฑเธเธเธฒเธฃเธซเธฅเธธเธ”เธญเธญเธเธเธญเธเนเธกเธ/เธ•เธ void)
                        if did then
                            pcall(function() call("DropService", "CollectDrop", did, dtype, dval, src, mat) end)
                            count = count + 1
                        end
                    end
                end
            end
        end

        if count > 0 then
            log(("collected %d drop(s) remotely"):format(count))
        end
    end

