    -- Find pod position (Pod_Zone tagged with CollectionService) — must stand on pod before RequestStartPodQueue
    -- ChallengePod color: RGB(255, 177, 82) = orange
    -- Pod color: RGB(143, 255, 255) = cyan
    H.findPodPosition = function(mode)
        local pods = CollectionService:GetTagged("Pod_Zone")
        print("[AutoFarm][DEBUG] findPodPosition: found", #pods, "Pod_Zone tagged parts (mode=", tostring(mode), ")")
        local bestPod = nil
        local bestDist = math.huge
        local bestEmptyPod = nil
        local bestEmptyDist = math.huge
        local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
        local myPos = hrp and hrp.Position
        -- ChallengePod Idle color (orange)
        local challengeColor = Color3.fromRGB(255, 177, 82)
        -- Pod Idle color (cyan)
        local dungeonColor = Color3.fromRGB(143, 255, 255)
        for _, pod in ipairs(pods) do
            local touch = pod:FindFirstChild("Touch", true)
            if not touch or not touch:IsA("BasePart") then
                if pod:IsA("BasePart") then touch = pod else touch = nil end
            end
            if touch and touch:IsA("BasePart") then
                -- Build full path for debug
                local path = {}
                local node = pod
                while node and node ~= workspace do
                    table.insert(path, 1, node.Name)
                    node = node.Parent
                end
                local fullPath = table.concat(path, "/")
                local podName = pod.Name or ""
                local podMode = pod:GetAttribute("Mode") or pod:GetAttribute("SelectedMode")
                local podParent = pod.Parent and pod.Parent.Name or ""
                -- Check pod color (ChallengePod = orange, Pod = cyan)
                -- Color might be on the pod model itself or on a child part
                local podColor = nil
                if pod:IsA("BasePart") then
                    podColor = pod.Color
                else
                    -- Check children for colored parts
                    for _, child in ipairs(pod:GetDescendants()) do
                        if child:IsA("BasePart") and child.Name ~= "Touch" then
                            local c = child.Color
                            -- Check if color matches ChallengePod (orange) or Pod (cyan)
                            if math.abs(c.R - challengeColor.R) < 0.05 and math.abs(c.G - challengeColor.G) < 0.05 and math.abs(c.B - challengeColor.B) < 0.05 then
                                podColor = c
                                break
                            elseif math.abs(c.R - dungeonColor.R) < 0.05 and math.abs(c.G - dungeonColor.G) < 0.05 and math.abs(c.B - dungeonColor.B) < 0.05 then
                                podColor = c
                                break
                            end
                        end
                    end
                end
                -- Determine pod type from color
                local isChallengePod = false
                local isDungeonPod = false
                if podColor then
                    if math.abs(podColor.R - challengeColor.R) < 0.05 and math.abs(podColor.G - challengeColor.G) < 0.05 and math.abs(podColor.B - challengeColor.B) < 0.05 then
                        isChallengePod = true
                    elseif math.abs(podColor.R - dungeonColor.R) < 0.05 and math.abs(podColor.G - dungeonColor.G) < 0.05 and math.abs(podColor.B - dungeonColor.B) < 0.05 then
                        isDungeonPod = true
                    end
                end
                                -- Also check name/path for Challenge/Dungeon
                local lowerPath = fullPath:lower()
                local lowerName = podName:lower()
                local lowerParent = podParent:lower()
                
                if lowerPath:find("challenge") or lowerName:find("challenge") or lowerParent:find("challenge") then
                    isChallengePod = true
                elseif lowerPath:find("dungeon") or lowerName:find("dungeon") or lowerParent:find("dungeon") or lowerParent == "pods" then
                    isDungeonPod = true
                end
                -- Print ALL details for debugging
                print("[AutoFarm][DEBUG] findPodPosition: pod=", podName, "parent=", podParent, "path=", fullPath, "mode=", tostring(podMode), "isChallenge=", tostring(isChallengePod), "isDungeon=", tostring(isDungeonPod), "pos=", tostring(touch.Position))
                -- Check all attributes
                local attrs = pod:GetAttributes()
                for k, v in pairs(attrs) do
                    print("[AutoFarm][DEBUG] findPodPosition:   attr:", k, "=", tostring(v))
                end
                -- Match logic:
                                local matches = false
                if mode == "Challenge" then
                    matches = isChallengePod
                elseif mode == "Dungeon" then
                    if isDungeonPod then
                        matches = true
                    elseif not isChallengePod and not (podName:lower():find("payload") or fullPath:lower():find("payload")) then
                        matches = true
                    end
                else
                    matches = true
                end
                if matches then
                    if myPos then
                        local dist = (touch.Position - myPos).Magnitude
                        if dist < bestDist then
                            bestDist = dist
                            bestPod = touch
                        end
                        if dist < bestEmptyDist and H.countPlayersNear(touch.Position, 12) == 0 then
                            bestEmptyDist = dist
                            bestEmptyPod = touch
                        end
                    else
                        bestPod = touch
                        break
                    end
                end
            end
        end
        -- solo play: prefer an empty pod so we do not queue with strangers
        if not CFG.PartyEnabled and bestEmptyPod then
            print("[AutoFarm][DEBUG] findPodPosition: selected EMPTY pod at", tostring(bestEmptyPod.Position))
            return bestEmptyPod.Position
        end
        if bestPod then
            print("[AutoFarm][DEBUG] findPodPosition: selected pod at", tostring(bestPod.Position))
        else
            print("[AutoFarm][DEBUG] findPodPosition: no matching pod found!")
        end
        return bestPod and bestPod.Position
    end

