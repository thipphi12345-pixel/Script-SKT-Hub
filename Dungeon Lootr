    -- State Flag Timeout System: auto-reset stuck flags to prevent bot lockup
    -- If a flag is stuck true for > 5 seconds, force reset to false
    local stateFlagTimestamps = {}
    H.trackStateFlag = function(flagName, value)
        if value then
            if not stateFlagTimestamps[flagName] then
                stateFlagTimestamps[flagName] = tick()
            end
        else
            stateFlagTimestamps[flagName] = nil
        end
    end

    -- Check and reset stuck flags (call every loop iteration)
    H.resetStuckFlags = function()
        local now = tick()
        local TIMEOUT = 5  -- 5 seconds max for any flag to stay true
        -- S.KeyCollectBusy
        if S.KeyCollectBusy and stateFlagTimestamps["KeyCollectBusy"] then
            if (now - stateFlagTimestamps["KeyCollectBusy"]) > TIMEOUT then
                log("State Timeout: forcing S.KeyCollectBusy = false (stuck for >5s)")
                S.KeyCollectBusy = false
                stateFlagTimestamps["KeyCollectBusy"] = nil
            end
        elseif S.KeyCollectBusy and not stateFlagTimestamps["KeyCollectBusy"] then
            stateFlagTimestamps["KeyCollectBusy"] = now
        end
        -- S.AltarBusy
        if S.AltarBusy and stateFlagTimestamps["AltarBusy"] then
            if (now - stateFlagTimestamps["AltarBusy"]) > TIMEOUT then
                log("State Timeout: forcing S.AltarBusy = false (stuck for >5s)")
                S.AltarBusy = false
                stateFlagTimestamps["AltarBusy"] = nil
            end
        elseif S.AltarBusy and not stateFlagTimestamps["AltarBusy"] then
            stateFlagTimestamps["AltarBusy"] = now
        end
        -- dodgeState.active
        if dodgeState.active and stateFlagTimestamps["dodgeActive"] then
            if (now - stateFlagTimestamps["dodgeActive"]) > TIMEOUT then
                log("State Timeout: forcing dodgeState.active = false (stuck for >5s)")
                dodgeState.active = false
                dodgeState.savedPos = nil
                dodgeState.targetEnemy = nil
                stateFlagTimestamps["dodgeActive"] = nil
            end
        elseif dodgeState.active and not stateFlagTimestamps["dodgeActive"] then
            stateFlagTimestamps["dodgeActive"] = now
        end
    end

    -- Boss Rush combat loop: find boss, attack, wait for floor clear
    -- Optimized: state-based polling — fast in combat, slow when idle
    H.bossRushLoop = function()
        log("Boss Rush: combat loop started")
        H.startPotionWatcher()
        H.startParryWatcher()

        -- Boss Dodge Scanner: start if enabled
        log(("Boss Rush: AutoBossDodge=%s BossRushMode=%s"):format(
            tostring(CFG.AutoBossDodge), tostring(S.BossRushMode)))
        if CFG.AutoBossDodge then startBossDodgeScanner() end
        startTelegraphDodgeScanner()

        local lastAttackTick = 0
        local lastSkillTick = 0
        local debugTick = 0
        local noBossWait = 0
        local lastTargetName = nil
        local graceUntil = 0
        local lastScanTick = 0
        local cachedBoss = nil  -- cache scan result between iterations
        local lastFloorBossName = nil  -- track BR.BossName changes separately

        while S.Running and (inBossRush() or (inRun() and S.BossRushMode) or tick() < graceUntil) do
            local now = tick()

            -- Wait for respawn (prevent warp-to-mob bug after death)
            if S.Respawning then
                task.wait(0.5)
            end
            if not S.Respawning then

            -- Early exit: run complete
            if BR.RunComplete then
                log("Boss Rush: run complete - " .. tostring(BR.RunComplete.Status))
                break
            end

            -- Floor limit: stop if current floor exceeds limit
            if CFG.BossRushFloorLimit and CFG.BossRushFloorLimit > 0 and BR.Floor >= CFG.BossRushFloorLimit then
                log(("Boss Rush: reached floor limit %d (current=%d) - returning to lobby"):format(
                    CFG.BossRushFloorLimit, BR.Floor))
                -- Request return to lobby immediately
                pcall(function() call("BossRushService", "RequestReturn") end)
                -- Wait for exit
                for _ = 1, 40 do
                    if not S.Running or not CFG.BossRushEnabled then break end
                    if not inBossRush() then break end
                    task.wait(0.5)
                end
                -- Disable Boss Rush mode
                S.BossRushMode = false
                CFG.BossRushEnabled = false
                pcall(function()
                    local toggle = Toggles and Toggles.AF_BossRushEnabled
                    if toggle then toggle:SetValue(false) end
                end)
                log("Boss Rush: returned to lobby - floor limit reached")
                break
            end

            -- Auto potion: use potion when HP below threshold
            if CFG.AutoPotion then
                local h = hum()
                if h and h.Health > 0 and h.MaxHealth > 0 then
                    local hpRatio = h.Health / h.MaxHealth
                    if hpRatio < (CFG.PotionThreshold or 0.5) then
                        if (now - (lastPotionUse or 0)) >= 1.0 then
                            lastPotionUse = now
                            log(("Boss Rush Auto Potion: HP %.0f/%.0f (%.0f%%) < %d%% - using potion"):format(
                                h.Health, h.MaxHealth, hpRatio * 100,
                                math.floor((CFG.PotionThreshold or 0.5) * 100)))
                            pcall(function() call("PotionService", "UsePotion", 1) end)
                        end
                    end
                end
            end

            H.resetStuckFlags()

            -- Detect BR.BossName change from FloorStart event
            local currentFloorBoss = BR.BossName and BR.BossName ~= "?" and BR.BossName or nil
            local floorBossChanged = false
            if currentFloorBoss and currentFloorBoss ~= lastFloorBossName then
                floorBossChanged = true
                lastFloorBossName = currentFloorBoss
                -- Force clear cache when floor boss changes
                cachedBoss = nil
                lastTargetName = nil
                S.WarpedTarget = nil
                hoverTarget = nil
                local r = hrp()
                if r then hoverHoldPos = r.CFrame ; hoverHoldTime = tick() end
                log(("Boss Rush: Floor boss changed to %s - clearing cache"):format(currentFloorBoss))
            end

            -- State-based scan interval:
            -- - In combat (have target): scan every 0.3s to track boss movement
            -- - No target (waiting spawn): scan every 0.8s to reduce CPU
            -- - Floor boss name changed: force immediate rescan (already triggered above)
            local scanInterval = 0.3
            if not cachedBoss or not (cachedBoss.Model and cachedBoss.Model.Parent) then
                scanInterval = 0.8
            end

            local boss = cachedBoss
            if floorBossChanged or (now - lastScanTick) >= scanInterval then
                lastScanTick = now
                boss = nil
                pcall(function() boss = findBossRushBoss() end)
                cachedBoss = boss
            end

            -- Validate cached boss is still alive AND matches current floor boss
            if boss and boss.Model and boss.Model.Parent then
                local alive = false
                pcall(function() alive = H.isBossRushAlive(boss.Model) end)
                if not alive then
                    boss = nil
                    cachedBoss = nil
                end
            else
                boss = nil
                cachedBoss = nil
            end

            -- Debug log every 2s (reduced from 1s)
            if (now - debugTick) >= 2 then
                debugTick = now
                if boss then
                    local _, bpos = H.getModelPos(boss.Model)
                    local myPos = hrp() and hrp().Position or Vector3.zero
                    local hpStr = "?"
                    pcall(function()
                        local hum = boss.Model:FindFirstChildOfClass("Humanoid")
                        if hum then hpStr = tostring(hum.Health) end
                    end)
                    local dist = bpos and (bpos - myPos).Magnitude or 0
                    log(("Boss Rush: target=%s dist=%.1f hp=%s floor=%s"):format(
                        boss.Model.Name, dist, hpStr, tostring(BR.BossName)))
                else
                    log(("Boss Rush: no target (floor=%s noBossWait=%.1f)"):format(
                        tostring(BR.BossName), noBossWait))
                end
            end

            if boss then
                noBossWait = 0
                -- Log when target changes
                if lastTargetName ~= boss.Model.Name then
                    log(("Boss Rush: NEW target - %s (was %s, floor=%s)"):format(
                        boss.Model.Name, lastTargetName or "none", tostring(BR.BossName)))
                    S.WarpedTarget = nil
                    hoverTarget = nil
                    local r = hrp()
                    if r then hoverHoldPos = r.CFrame ; hoverHoldTime = tick() end
                    lastTargetName = boss.Model.Name
                end
                -- Attack
                if not S.ChestBusy and not S.TelegraphDodgeActive and (now - lastAttackTick) >= (CFG.AttackInterval or 0.10) then
                    lastAttackTick = now - (CFG.AttackInterval or 0.10) + H.combatJitter(CFG.AttackInterval or 0.10)
                    pcall(attack, boss)
                end
                -- Skills
                if (now - lastSkillTick) >= (CFG.SkillInterval or 0.25) then
                    lastSkillTick = now
                    local _, bpos = H.getModelPos(boss.Model)
                    if bpos then
                        local myPos = hrp() and hrp().Position or Vector3.zero
                        local dir = (bpos - myPos).Unit
                        pcall(H.trySkill, dir)
                    end
                end
                task.wait(0.05)  -- fast loop in combat
            else
                -- No boss — slow polling
                noBossWait = noBossWait + 0.5
                if noBossWait > 3 and noBossWait < 3.5 then
                    log("Boss Rush: no boss for 3s - warping to arena...")
                    pcall(H.warpToBossArena)
                end
                if noBossWait > 8 and noBossWait < 8.5 then
                    log("Boss Rush: no boss for 8s - force resetting state...")
                    S.KeyCollectBusy = false
                    S.AltarBusy = false
                    dodgeState.active = false
                    stateFlagTimestamps = {}
                    S.WarpedTarget = nil
                    hoverTarget = nil
                    local r = hrp()
                    if r then hoverHoldPos = r.CFrame ; hoverHoldTime = tick() end
                    lastTargetName = nil
                    cachedBoss = nil
                    graceUntil = tick() + 10
                end
                -- Clear target name if boss died
                if lastTargetName and noBossWait > 0.5 and noBossWait < 1.0 then
                    log("Boss Rush: boss " .. lastTargetName .. " dead - scanning for next...")
                    lastTargetName = nil
                    S.WarpedTarget = nil
                    hoverTarget = nil
                    local r = hrp()
                    if r then hoverHoldPos = r.CFrame ; hoverHoldTime = tick() end
                    cachedBoss = nil
                    graceUntil = tick() + 10
                end
                task.wait(0.5)  -- slow loop when idle
            end

            -- Collect drops (only in combat, not when idle)
            if boss and CFG.AutoDrops then
                local r = hrp()
                if r then pcall(H.collectFloorDrops, r.Position, 60) end
            end
            end -- end if not S.Respawning
        end

        H.stopParryWatcher()
        H.stopPotionWatcher()
        stopHoverLock()
        cleanupBossTracking()
        log(("Boss Rush: combat loop ended (Running=%s grace=%d)"):format(
            tostring(S.Running), math.max(0, math.floor(graceUntil - tick()))))
    end

    -- Boss Rush top-level loop: enter -> fight -> replay/return -> repeat
    H.bossRushMainLoop = function()
        S.BossRushMode = true
        H.enableNoClip()
        H.hookBossRushEvents()
        H.hookPartySignals()
        if CFG.PartyEnabled and CFG.PartyAutoAccept then H.refreshFriends() end
        log("Boss Rush: Started")

        while S.Running and CFG.BossRushEnabled and not S.UserStopped do
            local inBR = inBossRush()
            local inR = inRun()
            log(("Boss Rush main: inBossRush=%s inRun=%s BossRushMode=%s"):format(
                tostring(inBR), tostring(inR), tostring(S.BossRushMode)))
            
            if inBR then
                -- Already in boss rush - wait for arena to FULLY load before starting combat
                log("Boss Rush: in run - waiting for arena to load...")
                
                -- Phase 1: Wait for BossRush_NPCs folder to appear
                local arenaLoaded = false
                for _ = 1, 30 do
                    if not S.Running or not CFG.BossRushEnabled then break end
                    local found = false
                    pcall(function()
                        for _, child in ipairs(workspace:GetDescendants()) do
                            if child:IsA("Folder") and child.Name:lower():find("npc") then
                                found = true
                                break
                            end
                        end
                    end)
                    if found then
                        arenaLoaded = true
                        break
                    end
                    task.wait(0.5)
                end
                
                -- Phase 2: Wait for player position to stabilize (game warps player during loading)
                if arenaLoaded then
                    log("Boss Rush: NPC folder found - waiting for player to stabilize...")
                    local lastPos = nil
                    local stableCount = 0
                    for _ = 1, 40 do
                        if not S.Running or not CFG.BossRushEnabled then break end
                        local r = hrp()
                        if r then
                            local curPos = r.Position
                            if lastPos then
                                local dist = (curPos - lastPos).Magnitude
                                if dist < 1 then
                                    stableCount = stableCount + 1
                                else
                                    stableCount = 0
                                end
                            end
                            lastPos = curPos
                            -- Player hasn't moved for 2 seconds → arena loaded
                            if stableCount >= 4 then
                                break
                            end
                        end
                        task.wait(0.5)
                    end
                    log("Boss Rush: player stabilized - waiting extra 2s for boss spawn...")
                    task.wait(2)
                    H.warpToBossArena()
                else
                    log("Boss Rush: arena load timeout - starting combat anyway")
                end
                H.bossRushLoop()

                -- Run ended - decide replay or return
                if not S.Running or not CFG.BossRushEnabled then break end
                task.wait(2)
                H.eclipseMaintenance()

                local status = BR.RunComplete and BR.RunComplete.Status
                
                if CFG.AutoReplay and status ~= "Failed" then
                    log("Boss Rush: Replay...")
                    call("BossRushService", "RequestReplay")
                    BR.RunComplete = nil
                    -- Wait for re-entry
                    for _ = 1, 60 do
                        if not S.Running or not CFG.BossRushEnabled then break end
                        if inBossRush() and not BR.RunComplete then break end
                        task.wait(0.5)
                    end
                else
                    log("Boss Rush: Return to lobby...")
                    call("BossRushService", "RequestReturn")
                    BR.RunComplete = nil
                    -- Wait for exit
                    for _ = 1, 40 do
                        if not S.Running or not CFG.BossRushEnabled then break end
                        if not inBossRush() then break end
                        task.wait(0.5)
                    end
                    break  -- Stop after returning to lobby
                end
            elseif not inR then
                -- In lobby - enter boss rush
                log("Boss Rush: in lobby - entering boss rush...")
                BR.RunComplete = nil
                H.eclipseMaintenance()
                local ok = H.enterBossRush()
                if not ok then
                    log("Boss Rush: failed to enter - retrying in 3s")
                    task.wait(3)
                end
            else
                -- In regular dungeon (not boss rush) - could be loading or stuck
                -- Try to enter boss rush anyway (the Generated_* folder might be from Boss Rush loading)
                log("Boss Rush: in dungeon folder but not InBossRush - trying to start combat anyway...")
                -- Don't wait - try combat loop directly in case the boss is already there
                H.bossRushLoop()
                task.wait(1)
            end
            task.wait(0.3)
        end

        H.unhookBossRushEvents()
        S.BossRushMode = false
        S.LoopActive = false
        H.disableNoClip()
        H.unanchorPlayer()
        log("Boss Rush: Stopped")
    end

    -- ============================================================
    -- Auto Farm RAID (single-boss timed fight: The First Test, Dark Professor)
    -- ============================================================
    local RD = {
        RunComplete = nil,
        BossName = nil,
        BossHP = 0,
        BossMaxHP = 0,
        Phase = 0,
        Lives = 3,
        TimeLeft = 1200,
        Conns = {},
    }
    -- Debug flag for raid target discovery (set true to log candidates)
    RD_DEBUG = false

    -- Raid-specific movement config (auto-applied during Raid, ignores UI settings)
    -- Boss: Behind mode (safe, no dodge needed)
    -- Mob: Orbit mode (fast clearing)
    RAID_MOVEMENT = {
        boss = {
            AttackPosition = "Behind",
            AboveHeight = 12,
            FrontOffset = 8,
            OrbitRadius = 0,    -- not used for boss
            OrbitSpeed = 0,     -- not used for boss
        },
        mob = {
            AttackPosition = "Orbit",
            AboveHeight = 12,
            FrontOffset = 8,
            OrbitRadius = 8.2,
            OrbitSpeed = 1.5,
        },
    }
    -- Current raid target type: "boss" or "mob" (set by raid loop)
    S.RaidTargetType = nil

    -- Check if currently in a Raid
    RD.inRaid = function()
        -- Primary: player attribute
        if LP:GetAttribute("InRaid") == true then return true end
        -- Fallback: DungeonQueueService SelectedMode == "Raids"
        local dq = H.svc("DungeonQueueService")
        if dq then
            local ok, mode = pcall(function() return dq:GetAttribute("SelectedMode") end)
            if ok and mode == "Raids" then
                -- Also check if we're actually in a run (not just selected)
                if LP:GetAttribute("CurrentDungeon") then return true end
            end
        end
        return false
    end

    -- Find raid targets — Boss Rush-style scan: entities live ONLY in workspace.Raid_NPCs
    -- Scanning all of workspace picked up decorative junk Models and made targeting buggy
    -- Returns: { mob, boss, target } — Priority: mob → boss
    -- (raid mobs must die before boss is vulnerable; every non-Dead model in Raid_NPCs is a target)
    RD.findRaidTargets = function()
        local r = hrp()
        local myPos = r and r.Position or Vector3.zero
        local floorBossName = RD.BossName and RD.BossName ~= "?" and RD.BossName or nil

        local bestMob, bestMobDist = nil, math.huge
        local bestBoss, bestBossDist = nil, math.huge

        local candidates = {}
        pcall(function()
            local folder = workspace:FindFirstChild("Raid_NPCs")
            if folder then
                for _, obj in ipairs(folder:GetDescendants()) do
                    if obj:IsA("Model") and obj.Parent then
                        table.insert(candidates, obj)
                    end
                end
            end
            -- Fallback: raid boss may spawn outside Raid_NPCs — shallow scan of
            -- workspace children, accepting only models flagged IsBoss or matching
            -- the raid boss name (keeps decorative junk out)
            for _, obj in ipairs(workspace:GetChildren()) do
                if obj:IsA("Model") and obj.Parent then
                    local isBoss = false
                    pcall(function() isBoss = obj:GetAttribute("IsBoss") == true end)
                    if not isBoss and floorBossName then
                        local ln, lf = obj.Name:lower(), floorBossName:lower()
                        isBoss = ln == lf or ln:sub(1, #lf) == lf or ln:sub(-#lf) == lf
                    end
                    if isBoss then table.insert(candidates, obj) end
                end
            end
        end)

        for _, obj in ipairs(candidates) do
            local isPlayer = false
            pcall(function() isPlayer = Players:GetPlayerFromCharacter(obj) ~= nil end)
            if not isPlayer and not BR_EXCLUDE_NAMES[obj.Name] then
                local root, pos = nil, nil
                pcall(function() root, pos = H.getModelPos(obj) end)
                if root and pos and typeof(root) == "Instance" and root:IsA("BasePart") then
                    -- Dead attribute is the only kill signal we trust — raid entities may
                    -- use custom health with a fake 0-HP Humanoid
                    local isDead = false
                    pcall(function() isDead = obj:GetAttribute("Dead") == true end)
                    if not isDead then
                        local isBoss = false
                        pcall(function() isBoss = obj:GetAttribute("IsBoss") == true end)
                        local lowerName = obj.Name:lower()
                        if not isBoss and floorBossName then
                            local lowerFloor = floorBossName:lower()
                            if lowerName == lowerFloor
                                or lowerName:sub(1, #lowerFloor) == lowerFloor
                                or lowerName:sub(-#lowerFloor) == lowerFloor then
                                isBoss = true
                            end
                        end
                        local d = (pos - myPos).Magnitude
                        if isBoss then
                            if d < bestBossDist then
                                bestBossDist = d
                                bestBoss = { Model = obj, Root = root, IsBoss = true, Type = "boss" }
                            end
                        elseif d < bestMobDist then
                            bestMobDist = d
                            bestMob = { Model = obj, Root = root, IsBoss = false, Type = "mob" }
                        end
                    end
                end
            end
        end

        local target = bestMob or bestBoss
        -- Print only when the scan result changes (runs every ~0.3s — full spam otherwise)
        local scanStr = ("boss=%s mob=%s target=%s"):format(
            bestBoss and bestBoss.Model.Name or "nil",
            bestMob and bestMob.Model.Name or "nil",
            target and target.Model.Name or "nil")
        if scanStr ~= RD._lastScanStr then
            RD._lastScanStr = scanStr
            print("[AutoFarm] Raid SCAN: " .. scanStr)
        end
        return { mob = bestMob, boss = bestBoss, target = target }
    end

    -- Keep old name as alias (for compatibility with scanner)
    RD.findRaidBoss = function()
        local result = RD.findRaidTargets()
        return result.target
    end

    -- Find raid arena position (spawn point in the map)
    RD.findRaidArenaPos = function()
        -- Raid uses Boss_Rush map root
        local mapRoot = workspace:FindFirstChild("Boss_Rush")
        if mapRoot then
            local spawn = mapRoot:FindFirstChild("BossSpawn", true)
                or mapRoot:FindFirstChild("Boss_Spawn", true)
                or mapRoot:FindFirstChild("Spawn", true)
                or mapRoot:FindFirstChild("Arena", true)
            if spawn then
                local _, pos = H.getModelPos(spawn)
                if pos then return pos end
            end
            -- Fallback: use map root position
            local _, pos = H.getModelPos(mapRoot)
            if pos then return pos end
        end
        -- Fallback: Generated_* folder
        for _, c in ipairs(workspace:GetChildren()) do
            if (c:IsA("Folder") or c:IsA("Model")) and c.Name:sub(1, 10) == "Generated_" then
                local spawn = c:FindFirstChild("BossSpawn", true)
                    or c:FindFirstChild("Spawn", true)
                if spawn then
                    local _, pos = H.getModelPos(spawn)
                    if pos then return pos end
                end
            end
        end
        -- Last resort: find the boss itself
        local boss = RD.findRaidBoss()
        if boss and boss.Root then
            return boss.Root.Position
        end
        return nil
    end

    -- Enter Raid from lobby
    RD.enterRaid = function()
        log("[DEBUG Raid] enterRaid called | RaidEnabled=" .. tostring(CFG.RaidEnabled) .. " PartyEnabled=" .. tostring(CFG.PartyEnabled) .. " Role=" .. tostring(CFG.PartyRole))
        if not CFG.RaidEnabled then return false end
        -- Party Member mode: just wait for leader to start
        if CFG.PartyEnabled and CFG.PartyRole == "Member" then
            log("[DEBUG Raid] Member mode - waiting for leader to start raid...")
            -- Wait up to 180s for leader to start (3 minutes)
            for i = 1, 360 do
                if not S.Running or not CFG.RaidEnabled then return false end
                if RD.inRaid() then
                    log("[DEBUG Raid] Member: entered raid via leader!")
                    task.wait(2)
                    return true
                end
                -- Also check if we got teleported (InDungeon attribute)
                if LP:GetAttribute("InDungeon") then
                    log("[DEBUG Raid] Member: InDungeon=true - entered via leader!")
                    task.wait(2)
                    return true
                end
                -- Log every 10s
                if i > 1 and i % 20 == 0 then
                    log("[DEBUG Raid] Member: still waiting... (" .. math.floor(i * 0.5) .. "s) InRaid=" .. tostring(LP:GetAttribute("InRaid")) .. " InDungeon=" .. tostring(LP:GetAttribute("InDungeon")))
                end
                task.wait(0.5)
            end
            log("[DEBUG Raid] Member: timed out waiting for leader (180s)")
            return false
        end
        -- Party Leader: wait for members before entering
        if CFG.PartyEnabled and CFG.PartyRole == "Leader" then
            log("[DEBUG Raid] Leader mode - calling waitForPartyMembers...")
            local waitOk = H.waitForPartyMembers()
            log("[DEBUG Raid] waitForPartyMembers returned: " .. tostring(waitOk))
            log("[DEBUG Raid] PartyData type: " .. type(S.PartyData))
            if S.PartyData and type(S.PartyData) == "table" then
                log("[DEBUG Raid] PartyData.Members count: " .. tostring(S.PartyData.Members and #S.PartyData.Members or "nil"))
            end
        end
        log("[DEBUG Raid] selecting mode Raids...")
        local ok1, res1 = call("DungeonQueueService", "RequestSelectMode", "Raids")
        log("[DEBUG Raid] RequestSelectMode -> " .. tostring(ok1) .. " " .. tostring(res1))
        task.wait(0.3)
        local raidName = S.WistoriaRaidName or CFG.RaidName or "The First Test"
        log("[DEBUG Raid] selecting raid: " .. raidName)
        local ok2, res2 = call("DungeonQueueService", "RequestSelectRaid", raidName)
        log("[DEBUG Raid] RequestSelectRaid -> " .. tostring(ok2) .. " " .. tostring(res2))
        task.wait(0.3)
        local diff = CFG.RaidDifficulty or "Impossible"
        log("[DEBUG Raid] selecting difficulty: " .. diff)
        local ok3, res3 = call("DungeonQueueService", "RequestSelectRaidDifficulty", diff)
        log("[DEBUG Raid] RequestSelectRaidDifficulty -> " .. tostring(ok3) .. " " .. tostring(res3))
        task.wait(0.3)
        -- Raid uses RequestEnter (NOT RequestStartSoloRun)
        -- UPDATE 2: stand at the Raid prompt/NPC first (server may require proximity)
        local raidPrompt = H.findPromptPos("Raid")
        if raidPrompt then
            stopHoverLock()
            H.warpTo(raidPrompt)
            task.wait(0.8)
        end
        log("[DEBUG Raid] calling RequestEnter...")
        local ok, res = call("DungeonQueueService", "RequestEnter")
        log("[DEBUG Raid] RequestEnter -> ok=" .. tostring(ok) .. " res=" .. tostring(res))
        -- Wait for InRaid attribute
        for _ = 1, 60 do
            if not S.Running or not CFG.RaidEnabled then return false end
            if RD.inRaid() then break end
            task.wait(0.5)
        end
        if not RD.inRaid() then return false end
        log("Raid: entered - waiting for arena to load...")
        task.wait(2)
        -- Warp to arena
        local arenaPos = RD.findRaidArenaPos()
        if arenaPos then
            log(("Raid: warping to arena at %.1f, %.1f, %.1f"):format(arenaPos.X, arenaPos.Y, arenaPos.Z))
            H.warpTo(arenaPos)
        end
        return true
    end

    -- Hook RaidRunService events
    RD.hookRaidEvents = function()
        for _, c in ipairs(RD.Conns) do pcall(function() c:Disconnect() end) end
        RD.Conns = {}

        local rrs = H.svc("RaidRunService")
        if not rrs then return end

        -- BossHealthUpdate(currentHP, maxHP, bossName)
        if rrs.BossHealthUpdate then
            local c = rrs.BossHealthUpdate:Connect(function(currentHP, maxHP, bossName)
                RD.BossHP = currentHP or 0
                RD.BossMaxHP = maxHP or 0
                RD.BossName = bossName or RD.BossName
            end)
            table.insert(RD.Conns, c)
        end

        -- RaidPhaseUpdate(phase, ?)
        if rrs.RaidPhaseUpdate then
            local c = rrs.RaidPhaseUpdate:Connect(function(phase, data)
                RD.Phase = phase or 0
                log(("Raid: Phase %d"):format(phase or 0))
            end)
            table.insert(RD.Conns, c)
        end

        -- LivesUpdate(lives)
        if rrs.LivesUpdate then
            local c = rrs.LivesUpdate:Connect(function(lives)
                RD.Lives = lives or 0
                log(("Raid: Lives = %d"):format(lives or 0))
            end)
            table.insert(RD.Conns, c)
        end

        -- TimerUpdate(timeLeft, timeMax)
        if rrs.TimerUpdate then
            local c = rrs.TimerUpdate:Connect(function(timeLeft, timeMax)
                RD.TimeLeft = timeLeft or 0
            end)
            table.insert(RD.Conns, c)
        end

        -- PhaseChange(status, data)
        if rrs.PhaseChange then
            local c = rrs.PhaseChange:Connect(function(status, data)
                log(("Raid: PhaseChange - %s"):format(tostring(status)))
            end)
            table.insert(RD.Conns, c)
        end

        -- DungeonComplete (raid completion)
        if rrs.DungeonComplete then
            local c = rrs.DungeonComplete:Connect(function(info)
                RD.RunComplete = type(info) == "table" and info or { Status = "Cleared" }
                log("Raid: DungeonComplete - " .. tostring(RD.RunComplete.Status))
            end)
            table.insert(RD.Conns, c)
        end
    end

    RD.unhookRaidEvents = function()
        for _, c in ipairs(RD.Conns) do pcall(function() c:Disconnect() end) end
        RD.Conns = {}
    end

    -- Raid combat loop: find boss, attack, wait for completion
    RD.raidLoop = function()
        log("Raid: combat loop started")
        S.RaidMode = true
        H.startPotionWatcher()
        H.startParryWatcher()

        -- Telegraph Dodge Scanner: start if enabled (boss dodge disabled in Raid)
        startTelegraphDodgeScanner()

        local lastAttackTick = 0
        local lastSkillTick = 0
        local debugTick = 0
        local noTargetWait = 0
        local lastTargetName = nil
        local lastTargetModel = nil
        local lastBossAnim = ""  -- tracks boss animation changes for debug log
        local graceUntil = 0
        local lastScanTick = 0
        local cachedResult = nil  -- cached findRaidTargets result
        local mobClearLock = false  -- true while mobs remain (prevents boss targeting)

        while S.Running and (RD.inRaid() or tick() < graceUntil) do
            local now = tick()

            -- Wait for respawn (prevent warp-to-mob bug after death)
            if S.Respawning then
                task.wait(0.5)
            end
            if not S.Respawning then

            -- Early exit: run complete
            if RD.RunComplete then
                log("Raid: run complete - " .. tostring(RD.RunComplete.Status))
                break
            end

            -- Auto potion
            if CFG.AutoPotion then
                local h = hum()
                if h and h.Health > 0 and h.MaxHealth > 0 then
                    local hpRatio = h.Health / h.MaxHealth
                    if hpRatio < (CFG.PotionThreshold or 0.5) then
                        if (now - (lastPotionUse or 0)) >= 1.0 then
                            lastPotionUse = now
                            log(("Raid Auto Potion: HP %.0f/%.0f (%.0f%%) < %d%%"):format(
                                h.Health, h.MaxHealth, hpRatio * 100,
                                math.floor((CFG.PotionThreshold or 0.5) * 100)))
                            pcall(function() call("PotionService", "UsePotion", 1) end)
                        end
                    end
                end
            end

            H.resetStuckFlags()

            -- State-based scan interval
            local scanInterval = 0.3
            if not cachedResult or not (cachedResult.target and cachedResult.target.Model and cachedResult.target.Model.Parent) then
                scanInterval = 0.8
            end

            local result = cachedResult
            local freshScan = false
            if (now - lastScanTick) >= scanInterval then
                lastScanTick = now
                result = nil
                pcall(function() result = RD.findRaidTargets() end)
                cachedResult = result
                freshScan = true
            end

            -- Validate cached result
            if result and result.target and result.target.Model and result.target.Model.Parent then
                local alive = false
                pcall(function() alive = H.isBossRushAlive(result.target.Model) end)
                if not alive then
                    result.target = nil
                    cachedResult = nil
                end
            else
                if result then result.target = nil end
                cachedResult = nil
            end

            -- Mob-clear lock: after a fresh scan, clear lock if no mobs found
            if freshScan then
                if result and result.mob and result.mob.Model and result.mob.Model.Parent then
                    mobClearLock = false  -- mobs exist, will target them
                else
                    -- Check if mob in result is dead
                    local mobDead = false
                    if result and result.mob and result.mob.Model then
                        pcall(function() mobDead = result.mob.Model:GetAttribute("Dead") == true end)
                    end
                    if not mobDead then
                        mobClearLock = false  -- no mobs at all, clear lock
                    end
                end
            end

            -- Priority: mob → boss
            -- Per gameplay: kill adds first (boss heals if not), then boss
            local target = nil
            local targetType = "none"
            -- 1. Mob (highest priority — adds must die or boss heals)
            if result and result.mob and result.mob.Model and result.mob.Model.Parent then
                -- Check Dead attribute (server sets this when enemy dies)
                local mobDead = false
                pcall(function() mobDead = result.mob.Model:GetAttribute("Dead") == true end)
                if not mobDead then
                    target = result.mob
                    targetType = "mob"
                    mobClearLock = false  -- got a valid mob, clear lock
                else
                    -- Mob died — lock to mob phase, force rescan to find remaining mobs
                    mobClearLock = true
                    lastScanTick = 0  -- force immediate rescan next tick
                    cachedResult = nil
                end
            end
            -- 2. Boss (lowest priority — only if no mobs remain)
            if not target and not mobClearLock and result and result.boss and result.boss.Model and result.boss.Model.Parent then
                local bossAlive = false
                pcall(function() bossAlive = H.isBossRushAlive(result.boss.Model) end)
                if bossAlive then
                    target = result.boss
                    targetType = "boss"
                end
            end

            -- Set raid target type for RAID_MOVEMENT config (boss=Behind, mob=Orbit)
            S.RaidTargetType = targetType

            -- Debug: log boss animation track changes immediately (see what skill boss is using)
            if RD_DEBUG and targetType == "boss" and target and target.Model then
                local animStr = ""
                pcall(function()
                    -- Boss uses AnimationController (not Humanoid+Animator)
                    local ac = target.Model:FindFirstChildOfClass("AnimationController")
                    if ac then
                        local tracks = ac:GetPlayingAnimationTracks()
                        local names = {}
                        for _, t in ipairs(tracks) do
                            if t.IsPlaying then
                                local anim = t.Animation
                                local aName = anim and anim.Name or (t.Name or "?")
                                local aId = anim and anim.AnimationId or ""
                                -- Include ID if available (helps identify Ultimate track)
                                if aId and aId ~= "" then
                                    table.insert(names, ("%s[%s]"):format(aName, aId:match("%d+") or aId))
                                else
                                    table.insert(names, aName)
                                end
                            end
                        end
                        animStr = table.concat(names, ",")
                    end
                end)
                -- Also track State attribute + Telegraph_Root children + CanAttack + position (skill signals)
                local stateStr = ""
                local telegraphCount = 0
                local canAttackStr = ""
                local posStr = ""
                pcall(function()
                    local st = target.Model:GetAttribute("State")
                    if st then stateStr = tostring(st) end
                    local tg = target.Model:FindFirstChild("Telegraph_Root")
                    if tg then telegraphCount = #tg:GetChildren() end
                    local ca = target.Model:GetAttribute("CanAttack")
                    if ca ~= nil then canAttackStr = tostring(ca) end
                    local hrp3 = target.Model:FindFirstChild("HumanoidRootPart")
                    if hrp3 then
                        posStr = ("%.0f,%.0f,%.0f"):format(hrp3.Position.X, hrp3.Position.Y, hrp3.Position.Z)
                    end
                end)
                local debugStr = ("anim=[%s] state=%s telegraph=%d canAttack=%s pos=%s"):format(animStr, stateStr, telegraphCount, canAttackStr, posStr)
                if debugStr ~= lastBossAnim then
                    lastBossAnim = debugStr
                    print(("[AutoFarm] Raid BOSS: %s %s"):format(target.Model.Name, debugStr))
                end
                -- Track ALL attribute changes (find hidden Ultimate signal)
                pcall(function()
                    local allAttrs = target.Model:GetAttributes()
                    local attrStrs = {}
                    for k, v in pairs(allAttrs) do
                        table.insert(attrStrs, ("%s=%s"):format(k, tostring(v)))
                    end
                    table.sort(attrStrs)
                    local attrDump = table.concat(attrStrs, ",")
                    if attrDump ~= RD._lastBossAttrDump then
                        RD._lastBossAttrDump = attrDump
                        print(("[AutoFarm] Raid BOSS ATTRS: %s"):format(attrDump))
                    end
                end)
                -- One-time boss inspection: dump attributes, children, tags (find detection signal)
                if not RD._bossInspected then
                    RD._bossInspected = true
                    pcall(function()
                        log(("Raid BOSS INSPECT: %s"):format(target.Model.Name))
                        -- Attributes
                        local attrs = target.Model:GetAttributes()
                        local attrStrs = {}
                        for k, v in pairs(attrs) do
                            table.insert(attrStrs, ("%s=%s"):format(k, tostring(v)))
                        end
                        table.sort(attrStrs)
                        log(("  ATTRIBUTES: %s"):format(table.concat(attrStrs, ", ")))
                        -- Children names + classes
                        local childStrs = {}
                        for _, c in ipairs(target.Model:GetChildren()) do
                            table.insert(childStrs, ("%s[%s]"):format(c.Name, c.ClassName))
                        end
                        log(("  CHILDREN: %s"):format(table.concat(childStrs, ", ")))
                        -- Tags
                        local tagStrs = {}
                        for _, t in ipairs(target.Model:GetTags()) do
                            table.insert(tagStrs, tostring(t))
                        end
                        log(("  TAGS: %s"):format(table.concat(tagStrs, ", ")))
                        -- HumanoidRootPart attributes
                        local hrp2 = target.Model:FindFirstChild("HumanoidRootPart")
                        if hrp2 then
                            local hrpAttrs = hrp2:GetAttributes()
                            local hrpAttrStrs = {}
                            for k, v in pairs(hrpAttrs) do
                                table.insert(hrpAttrStrs, ("%s=%s"):format(k, tostring(v)))
                            end
                            table.sort(hrpAttrStrs)
                            log(("  HRP ATTRIBUTES: %s"):format(table.concat(hrpAttrStrs, ", ")))
                        end
                    end)
                end
            else
                lastBossAnim = ""
                RD._bossInspected = false  -- reset so next boss gets inspected
            end

            -- Periodic "Raid: target=" status log removed — keep only the cand scan lines

            local actualTarget = target

            if actualTarget then
                noTargetWait = 0
                local isNewTarget = (lastTargetName ~= actualTarget.Model.Name) or (lastTargetModel ~= actualTarget.Model)
                if isNewTarget then
                    print(("[AutoFarm] Raid: NEW target - %s [%s]"):format(actualTarget.Model.Name, targetType))
                    stopHoverLock()
                    S.WarpedTarget = nil
                    hoverHoldPos = nil
                    hoverHoldTime = 0
                    hoverTarget = actualTarget
                    H.startHoverLock()
                    lastTargetName = actualTarget.Model.Name
                    lastTargetModel = actualTarget.Model
                end
                -- Attack
                if not S.ChestBusy and not S.TelegraphDodgeActive and (now - lastAttackTick) >= (CFG.AttackInterval or 0.10) then
                    lastAttackTick = now - (CFG.AttackInterval or 0.10) + H.combatJitter(CFG.AttackInterval or 0.10)
                    pcall(attack, actualTarget)
                end
                -- Skills
                if not S.TelegraphDodgeActive and (now - lastSkillTick) >= (CFG.SkillInterval or 0.25) then
                    lastSkillTick = now
                    local _, bpos = H.getModelPos(actualTarget.Model)
                    if bpos then
                        local myPos = hrp() and hrp().Position or Vector3.zero
                        local dir = (bpos - myPos).Unit
                        pcall(H.trySkill, dir)
                    end
                end
                task.wait(0.05)
            else
                noTargetWait = noTargetWait + 0.5
                if noTargetWait > 3 and noTargetWait < 3.5 then
                    print("[AutoFarm] Raid: no target for 3s - warping to arena...")
                    local arenaPos = RD.findRaidArenaPos()
                    if arenaPos then H.warpTo(arenaPos) end
                end
                if noTargetWait > 8 and noTargetWait < 8.5 then
                    print("[AutoFarm] Raid: no target for 8s - force resetting state...")
                    S.KeyCollectBusy = false
                    S.AltarBusy = false
                    dodgeState.active = false
                    stateFlagTimestamps = {}
                    S.WarpedTarget = nil
                    hoverTarget = nil
                    hoverHoldPos = nil
                    hoverHoldTime = 0
                    lastTargetName = nil
                    cachedResult = nil
                    graceUntil = tick() + 10
                end
                if lastTargetName and noTargetWait > 0.5 and noTargetWait < 1.0 then
                    print("[AutoFarm] Raid: target " .. lastTargetName .. " dead - scanning for next...")
                    lastTargetName = nil
                    S.WarpedTarget = nil
                    hoverTarget = nil
                    hoverHoldPos = nil
                    hoverHoldTime = 0
                    cachedResult = nil
                    graceUntil = tick() + 10
                end
                task.wait(0.5)
            end

            -- Collect drops
            if target and CFG.AutoDrops then
                local r = hrp()
                if r then pcall(H.collectFloorDrops, r.Position, 60) end
            end
            end -- end if not S.Respawning
        end

        H.stopParryWatcher()
        H.stopPotionWatcher()
        stopHoverLock()
        cleanupBossTracking()
        log(("Raid: combat loop ended (Running=%s grace=%d)"):format(
            tostring(S.Running), math.max(0, math.floor(graceUntil - tick()))))
    end

    -- Raid top-level loop: enter -> fight -> replay/return -> repeat
    RD.raidMainLoop = function()
        S.RaidMode = true
        S.RaidTargetType = nil
        S.TelegraphDodgeActive = false  -- clear stale dodge flag from previous run
        S.ChestBusy = false
        S.KeyCollectBusy = false
        RD._bossTelegraphBaseline = nil  -- reset telegraph baseline
        RD._lastBossAttrDump = nil       -- reset attribute tracking
        H.enableNoClip()
        RD.hookRaidEvents()
        H.hookPartySignals()
        if CFG.PartyEnabled and CFG.PartyAutoAccept then H.refreshFriends() end
        log("Raid: Started")

        while S.Running and CFG.RaidEnabled and not S.UserStopped do
            local inRD = RD.inRaid()
            log(("Raid main: inRaid=%s RaidMode=%s"):format(tostring(inRD), tostring(S.RaidMode)))

            if inRD then
                -- Already in raid - wait for arena to load
                log("Raid: in run - waiting for arena to load...")

                -- Wait for NPC folder or boss to appear
                local arenaLoaded = false
                for _ = 1, 30 do
                    if not S.Running or not CFG.RaidEnabled then break end
                    local found = false
                    pcall(function()
                        for _, child in ipairs(workspace:GetDescendants()) do
                            if child:IsA("Folder") and child.Name:lower():find("npc") then
                                found = true
                                break
                            end
                        end
                        -- Also check for boss model with IsBoss attribute
                        if not found then
                            for _, child in ipairs(workspace:GetDescendants()) do
                                if child:IsA("Model") and child:GetAttribute("IsBoss") == true then
                                    found = true
                                    break
                                end
                            end
                        end
                    end)
                    if found then
                        arenaLoaded = true
                        break
                    end
                    task.wait(0.5)
                end

                -- Wait for player position to stabilize
                if arenaLoaded then
                    log("Raid: NPC/boss found - waiting for player to stabilize...")
                    local lastPos = nil
                    local stableCount = 0
                    for _ = 1, 40 do
                        if not S.Running or not CFG.RaidEnabled then break end
                        local r = hrp()
                        if r then
                            local curPos = r.Position
                            if lastPos then
                                local dist = (curPos - lastPos).Magnitude
                                if dist < 1 then
                                    stableCount = stableCount + 1
                                else
                                    stableCount = 0
                                end
                            end
                            lastPos = curPos
                            if stableCount >= 4 then break end
                        end
                        task.wait(0.5)
                    end
                    log("Raid: player stabilized - waiting extra 2s for boss spawn...")
                    task.wait(2)
                    local arenaPos = RD.findRaidArenaPos()
                    if arenaPos then H.warpTo(arenaPos) end
                else
                    log("Raid: arena load timeout - starting combat anyway")
                end
                RD.raidLoop()

                -- Run ended - decide replay or return
                if not S.Running or not CFG.RaidEnabled then break end
                task.wait(2)

                local status = RD.RunComplete and RD.RunComplete.Status
                
                if CFG.AutoReplay and status ~= "Failed" then
                    -- Both Leader and Member can replay
                    log("Raid: Replay... (role=" .. tostring(CFG.PartyRole or "solo") .. ")")
                    pcall(function() call("RaidRunService", "RequestReplay") end)
                    RD.RunComplete = nil
                    for _ = 1, 60 do
                        if not S.Running or not CFG.RaidEnabled then break end
                        if RD.inRaid() and not RD.RunComplete then break end
                        task.wait(0.5)
                    end
                else
                    log("Raid: Return to lobby...")
                    pcall(function() call("RaidRunService", "RequestReturn") end)
                    RD.RunComplete = nil
                    for _ = 1, 40 do
                        if not S.Running or not CFG.RaidEnabled then break end
                        if not RD.inRaid() then break end
                        task.wait(0.5)
                    end
                    break
                end
            elseif not inRun() then
                -- In lobby - enter raid
                log("[DEBUG Raid] in lobby - entering raid...")
                RD.RunComplete = nil
                local ok = RD.enterRaid()
                log("[DEBUG Raid] enterRaid returned: " .. tostring(ok))
                if not ok then
                    log("[DEBUG Raid] failed to enter - retrying in 3s")
                    task.wait(3)
                end
            else
                -- In regular dungeon (not raid) - try combat anyway
                log("Raid: in dungeon but not InRaid - trying combat anyway...")
                RD.raidLoop()
                task.wait(1)
            end
            task.wait(0.3)
        end

        H.cleanupRaidState()
        S.LoopActive = false
        log("Raid: Stopped")
    end

    -- ============================================================
    -- Auto Farm Challenge (rebuilt simple: scan Challenge_NPCs, attack nearest)
    -- ============================================================
    local CH = {
        RunComplete = nil,  -- table from DungeonComplete
        Conns = {},
    }

    local function inChallengeRun()
        -- Primary: Challenge_Dungeons folder exists in workspace
        if H.challengeFolder() then return true end
        -- Fallback: Challenge_NPCs folder exists
        if workspace:FindFirstChild("Challenge_NPCs") then return true end
        -- Fallback: DungeonQueueService SelectedMode == "Challenge"
        local dq = H.svc("DungeonQueueService")
        if dq then
            local ok, mode = pcall(function() return dq:GetAttribute("SelectedMode") end)
            if ok and mode == "Challenge" then return true end
        end
        return false
    end

    H.enterChallenge = function()
        if not CFG.AutoChallenge then return false end
        print("[AutoFarm][DEBUG] Challenge: enterChallenge called | Party=", tostring(CFG.PartyEnabled), "Role=", tostring(CFG.PartyRole))
        -- Party Member mode: wait for leader to start
        if CFG.PartyEnabled and CFG.PartyRole == "Member" then
            print("[AutoFarm][DEBUG] Challenge: Member mode - waiting for leader...")
            for i = 1, 360 do
                if not S.Running or not CFG.AutoChallenge then return false end
                if inChallengeRun() then break end
                if i > 1 and i % 20 == 0 then
                    print("[AutoFarm][DEBUG] Challenge: Member still waiting...", math.floor(i * 0.5), "s")
                end
                task.wait(0.5)
            end
            if not inChallengeRun() then
                print("[AutoFarm][DEBUG] Challenge: Member timed out!")
                return false
            end
            print("[AutoFarm][DEBUG] Challenge: Member entered via leader!")
            task.wait(1)
            -- Warp to challenge start (Member too)
            local startPos = H.findDungeonStartPos()
            print("[AutoFarm][DEBUG] Challenge: Member findDungeonStartPos ->", tostring(startPos))
            if startPos then
                print("[AutoFarm][DEBUG] Challenge: Member warping to", startPos.X, startPos.Y, startPos.Z)
                H.warpTo(startPos)
            else
                print("[AutoFarm][DEBUG] Challenge: Member start position not found!")
            end
            return true
        end
        -- Party Leader: wait for members before entering
        if CFG.PartyEnabled and CFG.PartyRole == "Leader" then
            print("[AutoFarm][DEBUG] Challenge: Leader waiting for members...")
            local ready = H.waitForPartyMembers()
            if not ready then
                print("[AutoFarm][DEBUG] Challenge: members not ready - aborting")
                return false
            end
            -- Give member time to fully accept and sync
            print("[AutoFarm][DEBUG] Challenge: waiting 3s for member to sync...")
            task.wait(3)
            -- Remember party members before entering Challenge (for re-invite after run)
            S._lastPartyMembers = {}
            if S.PartyData and S.PartyData.Members then
                for _, m in pairs(S.PartyData.Members) do
                    if m.UserId ~= LP.UserId then
                        local name = m.DisplayName or m.Name
                        if name then table.insert(S._lastPartyMembers, name) end
                    end
                end
            end
            S._reinvitedAfterDungeon = false  -- reset flag for next run
            print("[AutoFarm][DEBUG] Challenge: remembered party members: " .. table.concat(S._lastPartyMembers, ", "))
        end
        print("[AutoFarm][DEBUG] Challenge: selecting mode...")
        local sm_ok, sm_res = call("DungeonQueueService", "RequestSelectMode", "Challenge")
        print("[AutoFarm][DEBUG] Challenge: RequestSelectMode -> ok=", tostring(sm_ok), "res=", tostring(sm_res))
        task.wait(1)
        local dung = H.resolveDungeonKey(CFG.ChallengeKey or "Double Dungeon")
        print("[AutoFarm][DEBUG] Challenge: selecting dungeon:", dung)
        local sd_ok, sd_res = call("DungeonQueueService", "RequestSelectDungeon", dung)
        print("[AutoFarm][DEBUG] Challenge: RequestSelectDungeon -> ok=", tostring(sd_ok), "res=", tostring(sd_res))
        task.wait(0.5)
        -- Refresh party data (matching Challenge controller's OnOpen flow)
        local pd_ok, pd_res = call("DungeonQueueService", "RequestPartyData")
        print("[AutoFarm][DEBUG] Challenge: RequestPartyData -> ok=", tostring(pd_ok), "res=", tostring(pd_res))
        task.wait(0.5)
        -- Warp to pod before calling RequestStartPodQueue (server requires standing on a pod)
        print("[AutoFarm][DEBUG] Challenge: finding pod to stand on...")
        local podPos = H.findPodPosition("Challenge")
        if podPos then
            print("[AutoFarm][DEBUG] Challenge: warping to pod at", podPos.X, podPos.Y, podPos.Z)
            H.warpToPod(podPos)
        else
            print("[AutoFarm][DEBUG] Challenge: no pod found - trying anyway")
        end
        -- Challenge always uses RequestStartPodQueue (no SoloRun)
        print("[AutoFarm][DEBUG] Challenge: RequestStartPodQueue...")
        -- Print party state right before calling
        local pd = H.getPartyData()
        if pd then
            print("[AutoFarm][DEBUG] Challenge: party before PodQueue -> LeaderId=", tostring(pd.LeaderId), "MemberCount=", tostring(pd.MemberCount), "SelectedMode=", tostring(pd.SelectedMode), "LocalUid=", tostring(LP.UserId))
        else
            print("[AutoFarm][DEBUG] Challenge: party before PodQueue -> nil")
        end
        -- Call directly to capture all 3 return values (pOk, pData, pErr)
        local s = H.svc("DungeonQueueService")
        local pOk, pData, pErr
        if s and s.RequestStartPodQueue then
            local cOk = pcall(function()
                local r = s:RequestStartPodQueue()
                if type(r) == "table" and r.await then
                    pOk, pData, pErr = r:await()
                else
                    pOk = r
                end
            end)
            if not cOk then print("[AutoFarm][DEBUG] Challenge: PodQueue pcall failed!") end
        else
            print("[AutoFarm][DEBUG] Challenge: DungeonQueueService.RequestStartPodQueue not found!")
            pOk = false
        end
        print("[AutoFarm][DEBUG] Challenge: PodQueue -> pOk=", tostring(pOk), "pData=", tostring(pData), "pErr=", tostring(pErr))
        -- Wait for Challenge_Dungeons or Challenge_NPCs to appear
        for i = 1, 40 do
            if not S.Running then break end
            if inChallengeRun() then break end
            if i % 10 == 0 then
                print("[AutoFarm][DEBUG] Challenge: waiting...", i, "inChallengeRun=", tostring(inChallengeRun()))
            end
            task.wait(0.5)
        end
        if not inChallengeRun() then
            -- PodQueue failed: re-warp onto the Challenge pod's Pod_Zone and
            -- press Enter (RequestEnter) — same manual-enter flow as dungeons
            print("[AutoFarm][DEBUG] Challenge: PodQueue failed - warping to pod + RequestEnter...")
            local podPos2 = H.findPodPosition("Challenge")
            if podPos2 then
                print("[AutoFarm][DEBUG] Challenge: re-warping to pod at", tostring(podPos2))
                H.warpToPod(podPos2)
                task.wait(0.5)
            end
            local ok3, res3 = call("DungeonQueueService", "RequestEnter")
            print("[AutoFarm][DEBUG] Challenge: RequestEnter -> ok=", tostring(ok3), "res=", tostring(res3))
            -- After Enter, the pod still needs Start pressed (same as dungeon UI)
            task.wait(0.4)
            if not inChallengeRun() then
                print("[AutoFarm][DEBUG] Challenge: pressing Start (PodQueue + StartNow)...")
                call("DungeonQueueService", "RequestStartPodQueue")
                task.wait(0.2)
                call("DungeonQueueService", "RequestStartNow")
            end
            for i = 1, 40 do
                if not S.Running then break end
                if inChallengeRun() then break end
                if i % 10 == 0 then
                    print("[AutoFarm][DEBUG] Challenge: RequestEnter waiting...", i)
                end
                task.wait(0.5)
            end
        end
        if not inChallengeRun() then
            print("[AutoFarm][DEBUG] Challenge: RequestEnter failed - trying fallback...")
            -- Fallback: try RequestStartSoloRun (only if not in party mode)
            if not CFG.PartyEnabled then
                print("[AutoFarm][DEBUG] Challenge: trying RequestStartSoloRun...")
                local ok2, res2 = call("DungeonQueueService", "RequestStartSoloRun")
                print("[AutoFarm][DEBUG] Challenge: RequestStartSoloRun -> ok=", tostring(ok2), "res=", tostring(res2))
                for i = 1, 40 do
                    if not S.Running then break end
                    if inChallengeRun() then break end
                    if i % 10 == 0 then
                        print("[AutoFarm][DEBUG] Challenge: SoloRun waiting...", i)
                    end
                    task.wait(0.5)
                end
            else
                print("[AutoFarm][DEBUG] Challenge: PodQueue failed (party mode - no solo fallback)")
            end
        end
        if not inChallengeRun() then
            print("[AutoFarm][DEBUG] Challenge: FAILED to enter!")
            return false
        end
        print("[AutoFarm][DEBUG] Challenge: entered! waiting for arena to load...")
        task.wait(1)
        -- Warp to challenge start
        local startPos = H.findDungeonStartPos()
        print("[AutoFarm][DEBUG] Challenge: findDungeonStartPos ->", tostring(startPos))
        if startPos then
            print("[AutoFarm][DEBUG] Challenge: warping to", startPos.X, startPos.Y, startPos.Z)
            H.warpTo(startPos)
        else
            print("[AutoFarm][DEBUG] Challenge: start position not found!")
        end
        return true
    end

