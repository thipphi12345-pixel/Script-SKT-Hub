    -- เธเธณเธเธงเธ“ offset เธ—เธตเนเน€เธซเธกเธฒเธฐเธชเธกเธ•เธฒเธก Class
    -- เนเธเน Range เนเธฅเธฐ HitboxSize เธเธฒเธ Class_Data เน€เธเนเธเธซเธฅเธฑเธ
    -- เธเธฃเธฑเธ AboveHeight (เธชเธนเธ) เนเธฅเธฐ HeadOffset (เนเธเธงเธเธญเธ) เธ•เธฒเธกเธเธฃเธฐเน€เธ เธ—เธเธฒเธฃเนเธเธกเธ•เธต
    H.getOptimalOffset = function(className)
        local data = H.getClassData(className)
        if not data then
            -- default: เนเธเนเธเนเธฒเธเธฒเธ CFG
            return CFG.AboveHeight or 8.0, CFG.HeadOffset or 12.0
        end

        local range = data.Range or 8
        local hitbox = data.HitboxSize or Vector3.new(5, 5, 8)
        local dmgType = data.DamageType or "Physical"
        local useProj = data.UseProjectile or false

        -- hitbox เนเธเธงเธเธญเธ (X/Z) = เธฃเธฐเธขเธฐเธ—เธตเนเธ•เธตเนเธ”เธเธเธฃเธดเธ
        local hbH = math.max(hitbox.X, hitbox.Z) / 2  -- เธเธฃเธถเนเธเธซเธเธถเนเธเธเธญเธ hitbox = เธฃเธฐเธขเธฐเธเธฒเธเธจเธนเธเธขเนเธเธฅเธฒเธ

        -- AboveHeight: เธชเธนเธเน€เธซเธเธทเธญเธซเธฑเธงเธกเธญเธ
        -- - เธเธฅเธฒเธชเธเธฃเธฐเธเธดเธ” (Melee/Physical): เธชเธนเธเธเนเธญเธข = เธ•เธตเนเธ”เธเธเนเธฒเธข (เธเธฃเธฐเธกเธฒเธ“ 8-12)
        -- - เธเธฅเธฒเธชเธฃเธฐเธขเธฐเนเธเธฅ (Ranged/Magic/Projectile): เธชเธนเธเธกเธฒเธ = เธเธฅเธญเธ”เธ เธฑเธข (เธเธฃเธฐเธกเธฒเธ“ 18-25)
        -- - เธเธฅเธฒเธช hitbox เธเธงเนเธฒเธ: เธชเธนเธเนเธ”เนเธกเธฒเธเธเธถเนเธเน€เธเธฃเธฒเธฐเธ•เธตเนเธ”เธเน€เธเนเธเธงเธเธเธงเนเธฒเธ

        local aboveH
        local horizO

        if useProj or dmgType == "Ranged" or dmgType == "Magic" then
            -- เธเธฅเธฒเธชเธฃเธฐเธขเธฐเนเธเธฅ: เธชเธนเธเธเธฒเธเธเธฅเธฒเธ + เนเธเธงเธเธญเธเธเนเธญเธข (เธขเธดเธเนเธเธฅเนเธเธถเนเธ)
            aboveH = math.max(range * 0.5, 12)
            horizO = math.max(hbH * 0.3, 2)
        elseif range >= 20 or hbH >= 12 then
            -- เธเธฅเธฒเธช hitbox เธเธงเนเธฒเธเธกเธฒเธ: เธชเธนเธเธเธฒเธเธเธฅเธฒเธ
            aboveH = math.max(range * 0.4, 10)
            horizO = math.max(hbH * 0.4, 5)
        elseif range >= 12 or hbH >= 7 then
            -- เธเธฅเธฒเธช hitbox เธเธงเนเธฒเธเธเธฒเธเธเธฅเธฒเธ: เธชเธนเธเธเนเธญเธขเธฅเธ
            aboveH = math.max(range * 0.35, 8)
            horizO = math.max(hbH * 0.5, 4)
        else
            -- เธเธฅเธฒเธชเธเธฃเธฐเธเธดเธ” (Melee): เธชเธนเธเธเนเธญเธข + เนเธเธงเธเธญเธเธเนเธญเธข = เธ•เธดเธ”เน
            aboveH = math.max(range * 0.5, 5)
            horizO = math.max(hbH * 0.3, 2)
        end

        -- เธเธฃเธฑเธเธ•เธฒเธกเธเธเธฒเธ”เธกเธญเธ (เน€เธเธทเนเธญเนเธงเน) โ€” เนเธเนเธเนเธฒเธเธฒเธ CFG เน€เธเนเธ baseline เธ–เนเธฒเธ•เนเธณเธเธงเนเธฒ
        aboveH = math.max(aboveH, 4)
        horizO = math.max(horizO, 1)

        return aboveH, horizO
    end

