        function Library:Notify(config)
            config = config or {}
            if self.Window then
                return self.Window:Notify({
                    Title = config.Title or "SKT HUB X",
                    Message = config.Description or config.Message or config.Text or "Notification",
                    Duration = config.Time or config.Duration or 4,
                    Type = config.Type or "Info",
                })
            end
        end
        
        function Library:OnUnload(callback)
            if type(callback) == "function" then
                table.insert(self.UnloadCallbacks, callback)
            end
        end
        
        function Library:Toggle()
            if self.Window then
                self.Window:Toggle()
            end
        end
        
        function Library:Unload()
            if self.Unloaded then
                return
            end
            self.Unloaded = true
            for _, callback in ipairs(self.UnloadCallbacks) do
                pcall(callback)
            end
            if self.Window then
                self.Window:Destroy()
            end
        end
        
        return Compat
        end)()

    local __INT3_ConfigManager = (function()
        local HttpService = game:GetService("HttpService")
        local UserInputService = game:GetService("UserInputService")
        
        local ConfigManager = {}
        ConfigManager.__index = ConfigManager
        
        local INTERNAL_KEYS = {
            __ConfigName = true,
            __ConfigList = true,
        }
        
        local function TrimWhitespace(value)
            return tostring(value or ""):match("^%s*(.-)%s*$")
        end
        
        local function SanitizeConfigName(value)
            local name = TrimWhitespace(value):gsub("[^%w%-%_ ]", ""):gsub("%s+", "_")
            return name:sub(1, 48)
        end
        
        local function SerializeConfigValue(value)
            if typeof(value) == "Color3" then
                return {
                    __type = "Color3",
                    r = math.floor(value.R * 255 + 0.5),
                    g = math.floor(value.G * 255 + 0.5),
                    b = math.floor(value.B * 255 + 0.5),
                }
            end
            local kind = type(value)
            if kind == "boolean" or kind == "number" or kind == "string" then
                return value
            end
            return nil
        end
        
        local function DeserializeConfigValue(value)
            if type(value) == "table" and value.__type == "Color3" then
                return Color3.fromRGB(
                    math.clamp(tonumber(value.r) or 255, 0, 255),
                    math.clamp(tonumber(value.g) or 255, 0, 255),
                    math.clamp(tonumber(value.b) or 255, 0, 255)
                )
            end
            return value
        end
        
        function ConfigManager.New()
            return setmetatable({
                Library = nil,
                Folder = "DungeonLootr/configs",
                Ignore = {},
                Controls = {},
                Ready = typeof(writefile) == "function"
                    and typeof(readfile) == "function"
                    and typeof(isfile) == "function",
            }, ConfigManager)
        end
        
        function ConfigManager:SetLibrary(library)
            self.Library = library
        end
        
        function ConfigManager:IgnoreThemeSettings() end
        
        function ConfigManager:SetIgnoreIndexes(indexes)
            table.clear(self.Ignore)
            for _, key in ipairs(indexes or {}) do
                self.Ignore[tostring(key)] = true
            end
        end
        
        function ConfigManager:SetFolder(folder)
            self.Folder = TrimWhitespace(folder):gsub("\\", "/"):gsub("/+$", "")
        end
        
        function ConfigManager:_Notify(title, message, kind)
            if self.Library then
                self.Library:Notify({
                    Title = title,
                    Description = message,
                    Type = kind or "Info",
                    Time = 3,
                })
            end
        end
        
        function ConfigManager:_EnsureFolders()
            if not self.Ready or typeof(makefolder) ~= "function" then
                return false
            end
            local current = ""
            for part in self.Folder:gmatch("[^/]+") do
                current = current == "" and part or (current .. "/" .. part)
                if typeof(isfolder) ~= "function" or not isfolder(current) then
                    pcall(makefolder, current)
                end
            end
            local configFolder = self.Folder .. "/configs"
            if typeof(isfolder) ~= "function" or not isfolder(configFolder) then
                pcall(makefolder, configFolder)
            end
            return typeof(isfolder) ~= "function" or isfolder(configFolder)
        end
        
        function ConfigManager:_ConfigPath(name)
            return self.Folder .. "/configs/" .. SanitizeConfigName(name) .. ".json"
        end
        
        function ConfigManager:_SelectedName(preferInput)
            local input = self.Controls.Name and SanitizeConfigName(self.Controls.Name.Value) or ""
            local selected = self.Controls.List and SanitizeConfigName(self.Controls.List.Value) or ""
            if preferInput and input ~= "" then
                return input
            end
            if selected ~= "" and selected ~= "none" then
                return selected
            end
            return input
        end
        
        function ConfigManager:GetConfigs()
            if not self:_EnsureFolders() or typeof(listfiles) ~= "function" then
                return {}
            end
            local ok, files = pcall(listfiles, self.Folder .. "/configs")
            if not ok or type(files) ~= "table" then
                return {}
            end
            local names = {}
            for _, path in ipairs(files) do
                local name = tostring(path):match("([^/\\]+)%.json$")
                if name then
                    table.insert(names, name)
                end
            end
            table.sort(names, function(a, b)
                return string.lower(a) < string.lower(b)
            end)
            return names
        end
        
        function ConfigManager:Refresh(selectedName)
            local values = self:GetConfigs()
            if #values == 0 then
                values = { "(none)" }
            end
            if self.Controls.List then
                self.Controls.List:SetValues(values)
                local wanted = SanitizeConfigName(selectedName or "")
                if wanted ~= "" and table.find(values, wanted) then
                    self.Controls.List:SetValue(wanted)
                end
            end
            return values
        end
        
        function ConfigManager:_Capture()
            local output = {
                version = 2,
                toggles = {},
                options = {},
            }
            for key, option in pairs(self.Library.Toggles or {}) do
                if not self.Ignore[key] and not INTERNAL_KEYS[key] and option.Control then
                    local value = SerializeConfigValue(option.Value)
                    if value ~= nil then
                        output.toggles[key] = value
                    end
                end
            end
            for key, option in pairs(self.Library.Options or {}) do
                if not self.Ignore[key] and not INTERNAL_KEYS[key] and option.Control then
                    local value = SerializeConfigValue(option.Value)
                    if value ~= nil then
                        output.options[key] = value
                    end
                end
            end
            return output
        end
        
        function ConfigManager:Save(name)
            name = SanitizeConfigName(name or self:_SelectedName(true))
            if name == "" then
                self:_Notify("Config", "Enter a config name first.", "Warning")
                return false
            end
            if not self:_EnsureFolders() then
                self:_Notify("Config", "File functions are not available in this executor.", "Error")
                return false
            end
            local ok, message = pcall(function()
                writefile(self:_ConfigPath(name), HttpService:JSONEncode(self:_Capture()))
            end)
            if not ok then
                self:_Notify("Config", "Save failed: " .. tostring(message), "Error")
                return false
            end
            self:Refresh(name)
            self:_Notify("Config Saved", name, "Success")
            return true
        end
        
        function ConfigManager:Load(name, silent)
            name = SanitizeConfigName(name or self:_SelectedName(false))
            if name == "" or name == "none" then
                if not silent then self:_Notify("Config", "Select a config first.", "Warning") end
                return false
            end
            local path = self:_ConfigPath(name)
            if not self.Ready or not isfile(path) then
                if not silent then self:_Notify("Config", "Config not found: " .. name, "Error") end
                return false
            end
            local ok, data = pcall(function()
                return HttpService:JSONDecode(readfile(path))
            end)
            if not ok or type(data) ~= "table" then
                if not silent then self:_Notify("Config", "Invalid config file: " .. name, "Error") end
                return false
            end
            local runtime = self.Library and self.Library._ParryRuntime
            if runtime and runtime.BeginConfigLoad then runtime:BeginConfigLoad() end
            self.Library._ConfigLoading = true
            self.Library._ConfigChangedOptions = {}
            data.options = type(data.options) == "table" and data.options or {}
            data.toggles = type(data.toggles) == "table" and data.toggles or {}
            if data.options.AttackCoverage == nil and data.toggles.AutoAll ~= nil then
                data.options.AttackCoverage = data.toggles.AutoAll == false and "Builder Only" or "All Known"
            end
            if data.options.ParryEngine == nil and data.options.LearnerMode ~= nil then
                data.options.ParryEngine = data.options.LearnerMode == "Perfect" and "Perfect" or "Adaptive"
            end
            if data.options.ParryEngine == "Reactive" then
                data.options.ParryEngine = "Fusion"
            end
            if data.toggles.PerfectAutoParry == true then
                data.options.ParryEngine = "Perfect"
                data.toggles.AutoParry = true
            end
            data.options.LearnerMode = nil
            data.options.PerfectJitterMax = nil
            data.toggles.AutoAll = nil
            data.toggles.PerfectAutoParry = nil
            data.toggles.PerfectJitterGuard = nil
            for key, value in pairs(data.options) do
                local option = self.Library.Options[key]
                if option and option.Control and not self.Ignore[key] and not INTERNAL_KEYS[key] then
                    pcall(function() option:SetValue(DeserializeConfigValue(value)) end)
                end
            end
            for key, value in pairs(data.toggles) do
                if key ~= "AutoParry" then
                    local option = self.Library.Toggles[key]
                    if option and option.Control and not self.Ignore[key] and not INTERNAL_KEYS[key] then
                        pcall(function() option:SetValue(DeserializeConfigValue(value)) end)
                    end
                end
            end

            if data.toggles.AutoParry ~= nil then
                local option = self.Library.Toggles.AutoParry
                if option and option.Control and not self.Ignore.AutoParry then
                    pcall(function() option:SetValue(DeserializeConfigValue(data.toggles.AutoParry)) end)
                end
            end
            self.Library._ConfigLoading = false
            local changed = self.Library._ConfigChangedOptions
            self.Library._ConfigChangedOptions = nil
            for option in pairs(changed or {}) do
                pcall(function() option:_Notify(option.Value) end)
            end
            if runtime and runtime.EndConfigLoad then runtime:EndConfigLoad() end
            local focused = UserInputService:GetFocusedTextBox()
            if focused then pcall(focused.ReleaseFocus, focused, false) end
            if type(self.AfterLoad) == "function" then
                pcall(self.AfterLoad, self, name)
            end
            self:Refresh(name)
            if not silent then self:_Notify("Config Loaded", name, "Success") end
            return true
        end
        
        function ConfigManager:Delete(name)
            name = SanitizeConfigName(name or self:_SelectedName(false))
            local path = self:_ConfigPath(name)
            if name == "" or name == "none" or not self.Ready or not isfile(path) then
                self:_Notify("Config", "Select an existing config first.", "Warning")
                return false
            end
            if typeof(delfile) ~= "function" then
                self:_Notify("Config", "Delete is not supported by this executor.", "Error")
                return false
            end
            local ok, message = pcall(delfile, path)
            if not ok then
                self:_Notify("Config", "Delete failed: " .. tostring(message), "Error")
                return false
            end
            self:Refresh()
            self:_Notify("Config Deleted", name, "Success")
            return true
        end
        
        function ConfigManager:SetAutoload(name)
            name = SanitizeConfigName(name or self:_SelectedName(false))
            if not self.Ready or name == "" or name == "none" or not isfile(self:_ConfigPath(name)) then
                self:_Notify("Autoload", "Select an existing config first.", "Warning")
                return false
            end
            if not self:_EnsureFolders() then return false end
            writefile(self.Folder .. "/autoload.txt", name)
            self:_Notify("Autoload Set", name, "Success")
            return true
        end
        
        function ConfigManager:ClearAutoload()
            local path = self.Folder .. "/autoload.txt"
            if self.Ready and typeof(delfile) == "function" and isfile(path) then
                pcall(delfile, path)
            end
            self:_Notify("Autoload", "Disabled", "Info")
        end
        
        function ConfigManager:LoadAutoloadConfig()
            local path = self.Folder .. "/autoload.txt"
            if not self.Ready or not isfile(path) then return false end
            local ok, name = pcall(readfile, path)
            if not ok then return false end
            name = SanitizeConfigName(name)
            if name == "" then return false end
            local loaded = self:Load(name, true)
            if loaded then self:_Notify("Autoloaded Config", name, "Success") end
            return loaded
        end
        
        function ConfigManager:BuildConfigSection(tab)
