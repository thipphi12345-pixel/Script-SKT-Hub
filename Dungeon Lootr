    local function firstInstance(element)
        local items = element and element.Items
        if type(items) == "table" then
            for _, item in pairs(items) do
                if type(item) == "table" and typeof(item.Instance) == "Instance" then
                    return item.Instance
                end
            end
        end
        -- Neverlose elements keep their Items table private, but each element
        -- is appended to its section's Content at creation time, so the last
        -- GuiObject child is this element's root right after construction.
        local content = sectionContent(element and element.Section)
        if content then
            local last
            for _, child in ipairs(content:GetChildren()) do
                if child:IsA("GuiObject") then last = child end
            end
            return last
        end
        return nil
    end

    local function bindControl(element, callback, coerce, read)
        local control = { Element = element }
        control.Instance = firstInstance(element) or create("Frame", {})
        local function current()
            if read then return read(element) end
            return element and element.Value
        end
        function control:Set(value, fire)
            local v = coerce and coerce(value) or value
            if v == nil then return false end
            local ok = pcall(function()
                local setter = element and element.Flag and NL.SetFlags[element.Flag]
                if setter then
                    setter(v)
                elseif element and element.Set then
                    element:Set(v)
                end
            end)
            if ok and fire ~= false and callback then
                invokeCallback(callback, current())
            end
            return ok
        end
        function control:Get()
            return current()
        end
        function control._fire(...)
            if callback then invokeCallback(callback, ...) end
        end
        return control
    end

