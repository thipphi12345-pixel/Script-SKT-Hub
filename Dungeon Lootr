    -- =====================================================================
    -- Auto Parry & Air-Dodge (Smart Boss Skill Detection)
    -- =====================================================================
    -- Detection signals:
    --   1. AOE ring/effect around boss or on ground  (triggers Air-Dodge)
    --   2. "Parry" text/UI on boss head              (triggers Perfect Parry)
    -- Response modes (selected via CFG.ParryMode):
    --   "warp"  = Air-Dodge: warp up into the air to evade AOE 100%, return after skill ends
    --   "parry" = Perfect Parry: wait for "Parry" text + attack animation, press at exact timing
    -- =====================================================================
    local parryWatchThread = nil
    local lastParryUse = 0
    local lastWarpDodge = 0

    local dodgeState = {
        active = false,
        savedPos = nil,
        savedTime = 0,
        maxDodgeTime = 2.5,
        targetEnemy = nil,
    }

    -- Detect AOE ring/effect around boss (only check boss descendants, not entire workspace)
    H.detectAOE = function(enemyModel, enemyRoot)
        if not enemyModel then return false end
        -- Only check boss descendants for AOE/telegraph/ring/warning parts
        -- (removed workspace:GetDescendants() scan - too heavy for 0.08s loop)
        for _, child in ipairs(enemyModel:GetDescendants()) do
            if child:IsA("BasePart") then
                local n = (child.Name or ""):lower()
                if n:find("aoe") or n:find("ring") or n:find("telegraph")
                or n:find("warning") or n:find("indicator") or n:find("circle") then
                    if child.Transparency < 0.9 then
                        return true
                    end
                end
            end
        end
        return false
    end

    -- Detect "Parry" text on boss head (BillboardGui/SurfaceGui)
    H.detectParryText = function(enemyModel)
        if not enemyModel then return false end
        for _, child in ipairs(enemyModel:GetDescendants()) do
            if child:IsA("BillboardGui") or child:IsA("SurfaceGui") then
                for _, desc in ipairs(child:GetDescendants()) do
                    if desc:IsA("TextLabel") or desc:IsA("TextButton") then
                        local txt = (desc.Text or ""):lower()
                        if txt:find("parry") then
                            return true
                        end
                    end
                end
            end
        end
        return false
    end

    -- Multi-signal skill detection
    -- Returns: isCasting, skillType, confidence, hasAOE, hasParryText
    H.detectEnemySkill = function(enemyModel, enemyRoot)
        if not enemyModel or not enemyModel.Parent then return false, nil, 0, false, false end
        local confidence = 0
        local skillType = nil

        -- Signal 1: BodyVelocity on HRP (BossSkillDash, SkillDash)
        -- From dump: boss skills create BodyVelocity named "BossSkillDash" or "SkillDash" on HRP
        if enemyRoot then
            if enemyRoot:FindFirstChild("BossSkillDash") then
                confidence = confidence + 3
                skillType = "skill"
            end
            if enemyRoot:FindFirstChild("SkillDash") then
                confidence = confidence + 3
                skillType = skillType or "skill"
            end
        end

        -- Signal 2: Attribute Is_Using_Skill / Is_Attacking (check all possible locations)
        -- From dump: these are set on controller table, but some skills also set them as attributes
        local function checkAttr(obj, name)
            if not obj then return false end
            local ok, val = pcall(function() return obj:GetAttribute(name) end)
            return ok and val == true
        end
        local hum = enemyModel:FindFirstChildOfClass("Humanoid")
        local usingSkill = checkAttr(enemyModel, "Is_Using_Skill")
            or checkAttr(hum, "Is_Using_Skill")
            or checkAttr(enemyRoot, "Is_Using_Skill")
        local attacking = checkAttr(enemyModel, "Is_Attacking")
            or checkAttr(hum, "Is_Attacking")
            or checkAttr(enemyRoot, "Is_Attacking")
            or checkAttr(enemyModel, "Attacking")
            or checkAttr(hum, "Attacking")
        if usingSkill then
            confidence = confidence + 2
            skillType = skillType or "skill"
        end
        if attacking then
            confidence = confidence + 1
            skillType = skillType or "attack"
        end

        -- Signal 3: Animator playing attack/skill/ability/ultimate/windup animation
        -- From dump: AnimationName = "Ultimate", "Ability_1", "Attack_1", etc.
        -- Check both track.Name and track.Animation.Name (animation asset name)
        local animator = enemyModel:FindFirstChildOfClass("Animator")
        if not animator then
            animator = hum and hum:FindFirstChildOfClass("Animator")
        end
        if animator then
            for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
                if track.IsPlaying then
                    local trackName = (track.Name or ""):lower()
                    local animAssetName = (track.Animation and track.Animation.Name or ""):lower()
                    local animName = trackName
                    if #animAssetName > 0 and #trackName == 0 then
                        animName = animAssetName
                    end
                    if animName:find("ability") or animName:find("skill") or animName:find("windup")
                    or animName:find("cast") or animName:find("ultimate") then
                        confidence = confidence + 2
                        skillType = skillType or "skill"
                    elseif animName:find("attack") or animName:find("swing") or animName:find("slash") then
                        confidence = confidence + 1
                        skillType = skillType or "attack"
                    end
                end
            end
        end

        -- Signal 4: AOE ring/effect on ground or around boss
        local hasAOE = H.detectAOE(enemyModel, enemyRoot)
        if hasAOE then
            confidence = confidence + 2
            skillType = skillType or "skill"
        end

        -- Signal 5: "Parry" text on boss head
        local hasParryText = H.detectParryText(enemyModel)
        if hasParryText then
            confidence = confidence + 3
            skillType = skillType or "attack"
        end

        -- Signal 6: "Parry" attribute on enemy model (from dump: boss sets Character:SetAttribute("Parry", true))
        -- This is the MOST RELIABLE signal — the game itself sets this when boss can be parried
        local parryAttr = enemyModel:GetAttribute("Parry") == true
        if parryAttr then
            confidence = confidence + 5
            skillType = skillType or "attack"
        end

        return confidence > 0, skillType, confidence, hasAOE, hasParryText
    end

    -- Estimate time until hit from animation track progress (for Perfect Parry timing)
    H.estimateTimeUntilHit = function(enemyModel, enemyRoot)
        if not enemyModel or not enemyModel.Parent then return nil end
        local animator = enemyModel:FindFirstChildOfClass("Animator")
        if not animator then
            local humanoid = enemyModel:FindFirstChildOfClass("Humanoid")
            animator = humanoid and humanoid:FindFirstChildOfClass("Animator")
        end
        if animator then
            for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
                if track.IsPlaying then
                    local animName = (track.Name or (track.Animation and track.Animation.Name) or ""):lower()
                    if animName:find("attack") or animName:find("swing") or animName:find("slash")
                    or animName:find("ability") or animName:find("skill") or animName:find("windup") then
                        local length = track.Length
                        local pos = track.TimePosition
                        if length and length > 0 and pos then
                            local hitPercent = 0.5
                            if animName:find("windup") then hitPercent = 0.7 end
                            if animName:find("cast") then hitPercent = 0.8 end
                            local hitTime = length * hitPercent
                            if pos < hitTime then
                                return hitTime - pos
                            else
                                return 0.05
                            end
                        end
                    end
                end
            end
        end
        if enemyRoot and enemyRoot:FindFirstChild("BossSkillDash") then
            return 0.1
        end
        return nil
    end

    H.isEnemyFacingUs = function(enemyRoot, myPos)
        if not enemyRoot then return true end
        local toMe = (myPos - enemyRoot.Position)
        if toMe.Magnitude < 0.1 then return true end
        local facing = enemyRoot.CFrame.LookVector
        local dot = facing:Dot(toMe.Unit)
        return dot > -0.3
    end

    -- Air-Dodge: move sideways to evade AOE (safer than flying up)
    -- Based on dump: AoE HitboxSize.Y ranges 8-55, most ground AoE Y=10-20
    -- Flying up risks VerticalReach flag + falling out of map
    -- Strategy: dodge horizontally away from AoE center, stay at same Y
    -- IMPORTANT: check existing telegraphs before choosing dodge position
    -- (don't dodge INTO another bomb!)
    H.airDodgeWarp = function(r, enemyRoot)
        if dodgeState.active then return end
        dodgeState.savedPos = r.Position
        dodgeState.savedTime = tick()
        dodgeState.active = true
        dodgeState.targetEnemy = enemyRoot
        -- Keep same Y (no flying up) — just move sideways
        local startPos = r.Position
        -- Direction: away from enemy (horizontal only)
        local dir = startPos - enemyRoot.Position
        dir = Vector3.new(dir.X, 0, dir.Z)
        if dir.Magnitude < 0.1 then
            -- If on top of enemy, pick random direction
            dir = Vector3.new(1, 0, 0)
        end
        dir = dir.Unit
        -- Move sideways (outside most AoE radius 25-28) but NEVER into a wall:
        -- raycast each candidate direction horizontally - dodging into an
        -- obstacle used to pop the character on TOP of it instead.
        local DODGE_DIST = 30
        local telegraphs = H.findNearbyTelegraphs()
        local function isSafeFromTelegraphs(pos)
            for _, tg in ipairs(telegraphs) do
                local d = Vector3.new(pos.X - tg.Pos.X, 0, pos.Z - tg.Pos.Z).Magnitude
                if d < tg.Radius + 20 then return false end
            end
            return true
        end
        local function clearDist(from, dirV)
            local free = DODGE_DIST
            pcall(function()
                local rayParams = RaycastParams.new()
                rayParams.FilterType = Enum.RaycastFilterType.Exclude
                rayParams.FilterDescendantsInstances = getDodgeIgnoreList()
                local origin = from + Vector3.new(0, 2, 0)
                local ray = workspace:Raycast(origin, dirV * DODGE_DIST, rayParams)
                if ray then free = (ray.Position - origin).Magnitude end
            end)
            return free
        end
        -- candidates: primary away-dir first, then 8 compass directions
        local cands = { dir }
        for ang = 0, 315, 45 do
            local rad = math.rad(ang)
            cands[#cands+1] = Vector3.new(math.cos(rad), 0, math.sin(rad))
        end
        local bestDir, bestScore = dir, -1
        for _, cd in ipairs(cands) do
            local c = clearDist(startPos, cd)
            local tryPos = startPos + cd * math.min(DODGE_DIST, c)
            local score = c
            if isSafeFromTelegraphs(tryPos) then score = score + 1000 end
            if cd == dir then score = score + 0.5 end -- prefer the away-direction on ties
            if score > bestScore then
                bestScore = score
                bestDir = cd
            end
        end
        local dist = math.max(6, math.min(DODGE_DIST, clearDist(startPos, bestDir) - 3))
        local targetPos = startPos + bestDir * dist

        -- Float sideways in small steps (no instant CFrame jump)
        task.spawn(function()
            local steps = 5
            for i = 1, steps do
                if not S.Running or not dodgeState.active then break end
                local t = i / steps
                local pos = startPos:Lerp(targetPos, t)
                pcall(function()
                    r.CFrame = CFrame.new(pos)
                    r.AssemblyLinearVelocity = Vector3.zero
                    r.AssemblyAngularVelocity = Vector3.zero
                end)
                task.wait(0.03)
            end
        end)
    end

    -- Return to farm position after air-dodge (gradual, with floor check)
    -- Cast ray down to find floor — if no floor found, stay at current Y (don't fall out of map)
    H.returnFromDodge = function(r)
        if not dodgeState.active then return end
        local target = dodgeState.savedPos
        if target then
            local startPos = r.Position
            local endPos = target + Vector3.new(0, 3, 0)
            -- Floor check: raycast down from endPos to find ground
            local safeY = endPos.Y
            pcall(function()
                local rayParams = RaycastParams.new()
                rayParams.FilterType = Enum.RaycastFilterType.Exclude
                rayParams.FilterDescendantsInstances = { LP.Character }
                local ray = workspace:Raycast(endPos, Vector3.new(0, -100, 0), rayParams)
                if ray then
                    -- Floor found — use 3 studs above floor
                    safeY = ray.Position.Y + 3
                else
                    -- No floor found — keep current Y (don't fall)
                    safeY = startPos.Y
                end
            end)
            endPos = Vector3.new(endPos.X, safeY, endPos.Z)
            -- Descend in small steps (safer than instant warp)
            local steps = 5
            for i = 1, steps do
                if not S.Running then break end
                local t = i / steps
                local pos = startPos:Lerp(endPos, t)
                pcall(function()
                    r.CFrame = CFrame.new(pos)
                    r.AssemblyLinearVelocity = Vector3.zero
                    r.AssemblyAngularVelocity = Vector3.zero
                end)
                task.wait(0.03)
            end
            log("Air-Dodge: RETURN to farm position")
        end
        dodgeState.active = false
        dodgeState.savedPos = nil
        dodgeState.targetEnemy = nil
    end

    H.startParryWatcher = function()
        if parryWatchThread then return end
        log(("Parry Watcher started - mode: %s (range: %d studs)"):format(
            CFG.ParryMode or "parry", CFG.ParryRange or 25))
        parryWatchThread = task.spawn(function()
            while S.Running and inRun() do
                -- Toggle safety: if AutoParry off, loop idles (no action, no background work)
                if (CFG.AutoParry or CFG.AutoFarmLVL) and not S.KeyCollectBusy then
                    local r = hrp()
                    if r then
                        local myPos = r.Position
                        local now = tick()

                        -- If currently air-dodging: check if skill ended or timeout
                        if dodgeState.active then
                            local elapsed = now - dodgeState.savedTime
                            local stillCasting = false
                            if dodgeState.targetEnemy and dodgeState.targetEnemy.Parent then
                                local casting = H.detectEnemySkill(dodgeState.targetEnemy, dodgeState.targetEnemy:FindFirstChild("HumanoidRootPart"))
                                stillCasting = casting
                            end
                            if (not stillCasting and elapsed >= 1.0) or elapsed >= (CFG.AirDodgeMaxTime or dodgeState.maxDodgeTime) then
                                H.returnFromDodge(r)
                            end
                            task.wait(0.1)
                        else
                            -- Scan nearby enemies for skill signals
                            local range = CFG.ParryRange or 25
                            local rooms = H.orderedRooms()
                            local parriedThisFrame = false
                            for _, e in ipairs(H.liveEnemies(rooms)) do
                                if not S.Running or not inRun() then break end
                                if e.Root and e.Root.Parent and isAlive(e.Model) then
                                    local dist = (e.Root.Position - myPos).Magnitude
                                    if dist <= range then
                                        local casting, skillType, confidence, hasAOE, hasParryText = H.detectEnemySkill(e.Model, e.Root)
                                        local isFacing = H.isEnemyFacingUs(e.Root, myPos) or (dist <= 12) or (e.Model:GetAttribute("Parry") == true)
                                        if (casting or e.Model:GetAttribute("Parry") == true) and isFacing then
                                            local mode = CFG.ParryMode or "parry"

                                            if mode == "warp" then
                                                -- Air-Dodge mode: warp up when AOE or high-threat skill detected
                                                if hasAOE or confidence >= 3 then
                                                    if (now - lastWarpDodge) >= 0.8 then
                                                        lastWarpDodge = now
                                                        local dodgeRoot = e.Root
                                                        task.spawn(function()
                                                            task.wait(0.08 + math.random() * 0.12)
                                                            local rr = hrp()
                                                            if rr and dodgeRoot and dodgeRoot.Parent then
                                                                pcall(H.airDodgeWarp, rr, dodgeRoot)
                                                            end
                                                        end)
                                                        parriedThisFrame = true
                                                    end
                                                end
                                            else
                                                -- Parry mode: press Parry immediately when skill detected or boss Parry attribute active
                                                -- threshold = 1 or explicit Parry attribute
                                                if (confidence >= 1 or e.Model:GetAttribute("Parry") == true) and (now - lastParryUse) >= 0.25 then
                                                    -- refresh rParry ก่อน (ป้องกัน remote หาย)
                                                    if not rParry or not rParry.Parent then
                                                        H.ensureParryRemote()
                                                    end
                                                    local parryCD = LP:GetAttribute("Parry_Cooldown_Active") == true
                                                    if not parryCD and rParry then
                                                        lastParryUse = now
                                                        -- Human reaction delay (50-150ms) — zero-latency parry
                                                        -- on every skill telegraph is a flag signature
                                                        local parryRemote = rParry
                                                        task.spawn(function()
                                                            task.wait(0.05 + math.random() * 0.1)
                                                            pcall(function() parryRemote:FireServer() end)
                                                        end)
                                                        parriedThisFrame = true
                                                    end
                                                end
                                                -- AOE fallback: air-dodge if AOE detected
                                                if hasAOE and confidence >= 3 and (now - lastWarpDodge) >= 0.8 then
                                                    lastWarpDodge = now
                                                    local dodgeRoot = e.Root
                                                    task.spawn(function()
                                                        task.wait(0.08 + math.random() * 0.12)
                                                        local rr = hrp()
                                                        if rr and dodgeRoot and dodgeRoot.Parent then
                                                            pcall(H.airDodgeWarp, rr, dodgeRoot)
                                                        end
                                                    end)
                                                    parriedThisFrame = true
                                                end
                                            end
                                            -- Don't break - keep scanning other enemies for simultaneous attacks
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
                task.wait(0.1)  -- parry watcher interval (0.06 spammed detectEnemySkill)
            end
            -- Cleanup on exit
            if dodgeState.active then
                local r = hrp()
                if r then H.returnFromDodge(r) end
            end
            -- Reset thread reference so H.startParryWatcher() can restart next time
            parryWatchThread = nil
        end)
    end

