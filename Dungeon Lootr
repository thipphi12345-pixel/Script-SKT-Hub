    -- Check if a UserId/name is in the selected target users list
    function H.isAllowedInviter(userId, inviterName)
        if not userId then return false end
        -- Build list of target names (from multi-select or single)
        local users = {}
        if type(CFG.PartyTargetUsers) == "table" then
            for _, n in ipairs(CFG.PartyTargetUsers) do table.insert(users, n) end
        elseif type(CFG.PartyTargetUsers) == "string" and CFG.PartyTargetUsers ~= "" then
            table.insert(users, CFG.PartyTargetUsers)
        end
        if #users == 0 then
            local targetName = CFG.PartyTargetUser or ""
            if targetName ~= "" then table.insert(users, targetName) end
        end
        -- If no target selected, check saved targets (persists across reloads)
        if #users == 0 and CFG.PartySavedTargets then
            for _, n in ipairs(CFG.PartySavedTargets) do
                if type(n) == "string" then table.insert(users, n) end
            end
        end
        -- If still no target, don't accept (prevent random invites)
        if #users == 0 then
            print("[AutoFarm][DEBUG] isAllowedInviter: no target users selected - rejecting")
            return false
        end
        -- Check by UserId (if we can find the player)
        for _, p in ipairs(Players:GetPlayers()) do
            if p.UserId == userId then
                for _, targetName in ipairs(users) do
                    local displayName = targetName:match("^([^%(]+)")
                    if displayName then displayName = displayName:gsub("%s+$", "") end
                    if p.Name == targetName or p.DisplayName == targetName
                        or p.Name == displayName or p.DisplayName == displayName then
                        print("[AutoFarm][DEBUG] isAllowedInviter: matched", p.Name, "to", targetName)
                        return true
                    end
                end
            end
        end
        -- Also check by name if provided
        if inviterName then
            for _, targetName in ipairs(users) do
                local displayName = targetName:match("^([^%(]+)")
                if displayName then displayName = displayName:gsub("%s+$", "") end
                if inviterName == targetName or inviterName == displayName then
                    print("[AutoFarm][DEBUG] isAllowedInviter: matched by name", inviterName)
                    return true
                end
            end
        end
        print("[AutoFarm][DEBUG] isAllowedInviter: no match for userId=", tostring(userId), "name=", tostring(inviterName))
        return false
    end

    -- Refresh friend list (async — caches to CFG.PartyFriends)
    H._friendRefreshRunning = false
    function H.refreshFriends()
        if H._friendRefreshRunning then return end
        H._friendRefreshRunning = true
        log("Party: refreshing friend list...")
        task.spawn(function()
            local ok, err = pcall(function()
                local friends = {}
                -- Try GetFriendsAsync (may not work in all executors)
                local getFriends = LP.GetFriendsAsync
                if type(getFriends) ~= "function" then
                    log("Party: GetFriendsAsync not available - accepting all invites")
                    CFG.PartyFriends = {}
                    return
                end
                local pages
                local pfOk, pfErr = pcall(function() pages = getFriends(LP) end)
                if not pfOk or not pages then
                    log("Party: GetFriendsAsync failed: " .. tostring(pfErr) .. " - accepting all invites")
                    CFG.PartyFriends = {}
                    return
                end
                if pages then
                    for _, item in ipairs(pages:GetCurrentPage()) do
                        if item.Id then
                            table.insert(friends, item.Id)
                        end
                    end
                    while not pages.IsFinished do
                        pages:AdvanceToNextPage()
                        for _, item in ipairs(pages:GetCurrentPage()) do
                            if item.Id then
                                table.insert(friends, item.Id)
                            end
                        end
                    end
                end
                CFG.PartyFriends = friends
                log(("Party: cached %d friends"):format(#friends))
            end)
            if not ok then
                log("Party: refreshFriends failed: " .. tostring(err))
                -- Set to empty so isFriend accepts all
                CFG.PartyFriends = CFG.PartyFriends or {}
            end
            H._friendRefreshRunning = false
        end)
    end

