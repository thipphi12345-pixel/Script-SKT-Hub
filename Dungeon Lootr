    local svcCache = {}
    local svcRetryTime = {}  -- track when to retry failed services
    H.svc = function(name)
        -- Return cached service if available
        if svcCache[name] ~= nil then return svcCache[name] or nil end
        -- Don't retry too often if service not found (retry every 2 seconds)
        local now = tick()
        if svcRetryTime[name] and (now - svcRetryTime[name]) < 2 then
            return nil
        end
        svcRetryTime[name] = now
        -- Make sure Knit is loaded
        if not Knit then H.tryLoadKnit() end
        -- Try to get service
        local ok, s = pcall(function()
            if not Knit then return nil end
            if typeof(Knit.GetService) == "function" then
                return Knit.GetService(name)
            end
            return nil
        end)
        if ok and s then
            svcCache[name] = s
            return s
        end
        -- Don't cache failure - allow retry next time
        return nil
    end

