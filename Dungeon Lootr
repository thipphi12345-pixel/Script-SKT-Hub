    -- Auto-invite selected players (Leader mode)
    H._lastInviteTick = 0
    function H.autoInvite()
        if not CFG.PartyEnabled then return end
        if CFG.PartyRole ~= "Leader" then return end
        local now = tick()
        if (now - H._lastInviteTick) < 3 then return end  -- cooldown 3s
        H._lastInviteTick = now
        -- Build list of names to invite
        local names = {}
        local users = CFG.PartyTargetUsers
        if type(users) == "table" then
            for _, n in ipairs(users) do table.insert(names, n) end
        elseif type(users) == "string" and users ~= "" then
            table.insert(names, users)
        end
        -- Fallback to single target
        if #names == 0 then
            local name = CFG.PartyTargetUser or ""
            if name ~= "" then table.insert(names, name) end
        end
        -- Fallback to saved targets (persists even when player leaves server)
        if #names == 0 and CFG.PartySavedTargets then
            for _, n in ipairs(CFG.PartySavedTargets) do
                table.insert(names, n)
            end
        end
        if #names == 0 then return end
        for _, name in ipairs(names) do
            local displayName = name:match("^([^%(]+)")
            if displayName then displayName = displayName:gsub("%s+$", "") end
            log("Party: auto-inviting " .. tostring(displayName or name))
            H.invitePlayerByName(displayName or name)
            task.wait(0.2)
        end
    end

