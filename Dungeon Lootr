            self.Controls.Name = group:AddInput("__ConfigName", {
                Text = "Config Name",
                Default = "default",
                Placeholder = "Enter name...",
            })
            self.Controls.List = group:AddDropdown("__ConfigList", {
                Text = "Saved Configs",
                Values = { "(none)" },
