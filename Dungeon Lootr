    -- == Auto Save / Load Config ==
    local H = {}
    H.HttpService = game:GetService("HttpService")
    local CONFIG_FOLDER = "AutoFarmConfigs"

    H.getConfigPath = function()
        -- Save per-UserId so each account has its own config
        local uid = ""
        pcall(function() uid = tostring(Players.LocalPlayer.UserId) end)
        local fname = (CFG.ConfigFileName or "AutoFarm_config")
        -- Strip .json if present, then add _<uid>.json
        fname = fname:gsub("%.json$", "")
        if uid and uid ~= "" then
            fname = fname .. "_" .. uid
        end
        return CONFIG_FOLDER .. "/" .. fname .. ".json"
    end

    -- Legacy config path (for migration from old single-file format)
    H.getLegacyConfigPath = function()
        return CONFIG_FOLDER .. "/" .. (CFG.ConfigFileName or "AutoFarm_config.json")
    end

    -- serialize only boolean/number/string/table values
    H.serializeConfig = function()
        local out = {}
        for k, v in pairs(CFG) do
            local t = type(v)
            if t == "boolean" or t == "number" or t == "string" then
                out[k] = v
            elseif t == "table" then
                local ok, encoded = pcall(function() return H.HttpService:JSONEncode(v) end)
                if ok then
                    local ok2, decoded = pcall(function() return H.HttpService:JSONDecode(encoded) end)
                    if ok2 then out[k] = decoded end
                end
            end
        end
        return out
    end

    H.applyConfig = function(data)
        if type(data) ~= "table" then return end
        -- Keys that should NOT be loaded from saved config (always use defaults)
        local protectedKeys = {
            AutoStart = true,  -- one-time auto-start, don't persist
        }
        for k, v in pairs(data) do
            if CFG[k] ~= nil and not protectedKeys[k] then
                local oldType = type(CFG[k])
                local newType = type(v)
                if oldType == newType then
                    CFG[k] = v
                elseif oldType == "table" and newType == "table" then
                    CFG[k] = v
                end
            end
        end
        -- Migration: SellRarities จาก string → table (อัปเดท multi-rarity)
        if type(CFG.SellRarities) == "string" then
            CFG.SellRarities = { CFG.SellRarities }
        elseif type(CFG.SellRarities) ~= "table" then
            CFG.SellRarities = { "Common" }
        end
        -- Migration: AutoFarmLVL_History
        if type(CFG.AutoFarmLVL_History) ~= "table" then
            CFG.AutoFarmLVL_History = { Failed = {}, Wins = {} }
        else
            if type(CFG.AutoFarmLVL_History.Failed) ~= "table" then CFG.AutoFarmLVL_History.Failed = {} end
            if type(CFG.AutoFarmLVL_History.Wins) ~= "table" then CFG.AutoFarmLVL_History.Wins = {} end
        end
        if Library.Window and not Library.Unloaded then Library:ApplyAppearance(CFG) end
    end

    H.saveConfig = function()
        if type(writefile) ~= "function" then return end
        pcall(function()
            if type(makefolder) == "function" then
                pcall(function() makefolder(CONFIG_FOLDER) end)
            end
            local data = H.serializeConfig()
            local json = H.HttpService:JSONEncode(data)
            writefile(H.getConfigPath(), json)
            log("config saved -> " .. H.getConfigPath())
        end)
    end

    H.loadConfig = function()
        if type(readfile) ~= "function" then return end
        pcall(function()
            local path = H.getConfigPath()
            local json
            if isfile(path) then
                json = readfile(path)
            else
                -- Migration: try legacy path (old single-file format)
                local legacyPath = H.getLegacyConfigPath()
                if isfile(legacyPath) then
                    log("config: migrating from legacy -> " .. legacyPath)
                    json = readfile(legacyPath)
                    -- Save to new per-UserId path immediately
                    if json and json ~= "" and type(writefile) == "function" then
                        pcall(function() makefolder(CONFIG_FOLDER) end)
                        pcall(function() writefile(path, json) end)
                        log("config: migrated to " .. path)
                    end
                end
            end
            if not json or json == "" then return end
            local data = H.HttpService:JSONDecode(json)
            H.applyConfig(data)
            log("config loaded <- " .. path)
        end)
    end

