        pcall(function()
            -- Primary: Knit.Registry:Get (เกมใช้วิธีนี้)
            if Knit and Knit.Registry and Knit.Registry.Get then
                playerDataRegistry = Knit.Registry:Get("PlayerData")
            end
        end)
        -- fallback: Knit.GetController
        if not playerDataRegistry then
            pcall(function()
                if Knit and Knit.GetController then
                    playerDataRegistry = Knit.GetController("PlayerData")
                end
            end)
        end
        -- fallback: require Registry module
        if not playerDataRegistry then
            pcall(function()
                local controllersFolder = ReplicatedStorage:FindFirstChild("Controllers")
                if controllersFolder then
                    local reg = controllersFolder:FindFirstChild("Registry")
                    if reg then
                        local Registry = require(reg)
                        playerDataRegistry = Registry:Get("PlayerData")
                    end
                end
            end)
        end
        return playerDataRegistry
    end

