    -- Get current party data (async)
    function H.getPartyData()
        -- RequestPartyData returns a Promise; the actual data comes via PartyUpdate signal
        -- Just fire the request to trigger the signal, then return cached S.PartyData
        local ok, data = call("DungeonQueueService", "RequestPartyData")
        log("[DEBUG getPartyData] call returned ok=" .. tostring(ok) .. " data=" .. tostring(data) .. " type=" .. type(data))
        -- S.PartyData is updated by PartyUpdate signal handler
        if S.PartyData and type(S.PartyData) == "table" then
            return S.PartyData
