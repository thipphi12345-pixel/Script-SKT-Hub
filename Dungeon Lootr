    -- auto-farm loop: first incomplete task first; boss-rush drive covers
    -- Demon Eyes + Demon Essence + Ronin mastery + Coins simultaneously
    H._wistoriaThread = nil
    H.startAutoWisteriaQuest = function()
        if H._wistoriaThread then return end
        log("Auto Wisteria Quest started")
        H._wistoriaThread = task.spawn(function()
            -- accept once (server ignores duplicates)
            pcall(function()
                local _, id = H.findDialogueNPC({ "wisteria", "wistoria", "mentor", "crescent" })
                if id then
                    H.dialogueFire(id, "LoneCrescent", { Action = "Accept" })
                    task.wait(1)
                    H.dialogueFire(id, "LoneCrescent", { Action = "AcceptTitle" })
                end
            end)
            while CFG.AutoWisteriaQuest and not S.PartyUnloaded do
                local pd = H.getPlayerData()
                local data = pd and pd.Data
                if data then
                    -- pick the first incomplete NON-craft task; Demonic Metal
                    -- is deferred until eyes/essence/mastery/coins are done so
                    -- a single boss-rush session covers them all
                    local first, craftPending
                    for _, t in ipairs(H.WISTERIA_EVENT_TASKS) do
                        local p = H.wisteriaTaskProgress(t, data)
                        if not p.ok then
                            if t.kind == "craft" then
                                craftPending = craftPending or { task = t, prog = p }
                            else
                                first = { task = t, prog = p }
                                break
                            end
                        end
                    end
                    first = first or craftPending
                    -- re-accept periodically: the mentor NPC may not have
                    -- existed when the thread started (e.g. player was in a run)
                    S._wistoriaAcceptTick = (S._wistoriaAcceptTick or 0) + 1
                    if S._wistoriaAcceptTick >= 20 then -- ~60s
                        S._wistoriaAcceptTick = 0
                        pcall(function()
                            local _, id = H.findDialogueNPC({ "wisteria", "wistoria", "mentor", "crescent" })
                            if id then
                                H.dialogueFire(id, "LoneCrescent", { Action = "Accept" })
                                task.wait(0.5)
                                H.dialogueFire(id, "LoneCrescent", { Action = "AcceptTitle" })
                            end
                        end)
                    end
                    if not first then
                        H.wistoriaStopFarm()
                        S.WistoriaStatus = "all tasks done - claiming"
                        -- claim up to 5 times; verify a claimed/completed flag
                        -- appears in the data before declaring done
                        local claimed = false
                        for _ = 1, 5 do
                            H.wistoriaClaimEvent()
                            task.wait(2)
                            local pd2 = H.getPlayerData()
                            local ev2 = H.scanWisteriaProgress(pd2 and pd2.Data or {})
                            for pth, v in pairs(ev2) do
                                local pl = pth:lower()
                                if v == true and (pl:find("claim") or pl:find("complet") or pl:find("reward")) then
                                    claimed = true
                                    break
                                end
                            end
                            if claimed then break end
                            task.wait(6)
                        end
                        S.WistoriaStatus = claimed and "done"
                            or "done (claim sent - check reward in-game)"
                        CFG.AutoWisteriaQuest = false
                        pcall(function()
                            local t = Toggles and Toggles.AF_AutoWisteriaQuest
                            if t and t.Control and t.Control.Set then
                                t.Control:Set(false, false)
                            end
                        end)
                        break
                    elseif first.task.kind == "craft" then
                        -- plan which ingredient is missing and how to get it;
                        -- materials are farmed automatically instead of retrying forever
                        local metalsLeft = math.max((first.prog.need or 30) - (first.prog.have or 0), 0)
                        local plan = H.wistoriaMetalPlan(data, metalsLeft)
                        local act = plan.action
                        local msrc = act == "farm" and H.WISTERIA_MAT_SOURCES[plan.item] or nil
                        local inRunNow = inRun() or LP:GetAttribute("InDungeon")
                        -- stop any drive that no longer matches the plan.
                        -- boss-rush drive: all its tasks are already done once we
                        -- reach the craft branch (craft runs last), and with
                        -- AutoReplay the run never "finishes" -> stop it now.
                        if S._wistoriaBRDrive then
                            H.wistoriaStopFarm()
                        end
                        local driveOk = (not S._wistoriaBRDrive)
                            and (not S._wistoriaRaidDrive or act == "essence")
                            and (not S._wistoriaDungeonDrive or (msrc and S._wistoriaDungeonDrive.key == msrc.key))
                        if not driveOk then
                            if inRunNow then
                                S.WistoriaStatus = "finishing current run before switching..."
                            else
                                H.wistoriaStopFarm()
                            end
                        elseif act == "farm" then
                            -- raw material missing -> enter its dungeon and farm the special boss
                            local keys = H.getKeyCount(msrc.keyTier)
                            if keys < msrc.keyCost then
                                H.wistoriaStopFarm()
                                S.WistoriaStatus = ("need %s - not enough T%d keys (%d/%d)"):format(
                                    plan.item, msrc.keyTier, keys, msrc.keyCost)
                            else
                                local r = H.wistoriaDriveDungeon(msrc.key, msrc.diff)
                                S.WistoriaStatus = (r == "busy" and "waiting: another farm is running")
                                    or (r == "stopped" and "stopped by user")
                                    or (("farming %s (%s/%s) - %s %s"):format(
                                        plan.item, tostring(plan.have), tostring(plan.need), msrc.key, msrc.diff))
                            end
                        elseif act == "essence" then
                            -- Exotic Essence: buy from The First Test raid shop (30 MageCoins);
                            -- short on coins -> drive the raid itself
                            local want = plan.need - plan.have
                            local _, shopInfo = call("RaidShopService", "GetRaidShopInfo", "The First Test")
                            local bal = (type(shopInfo) == "table" and tonumber(shopInfo.Balance)) or 0
                            if bal >= 30 then
                                if S._wistoriaRaidDrive then H.wistoriaStopFarm() end
                                local bought = 0
                                for _ = 1, math.min(want, math.floor(bal / 30)) do
                                    local okB = call("RaidShopService", "BuyRaidShopItem", "The First Test", "ExoticEssence")
                                    if not okB then break end
                                    bought = bought + 1
                                    task.wait(0.4)
                                end
                                S.WistoriaStatus = ("buying Exotic Essence (%s/%s)"):format(
                                    tostring(plan.have + bought), tostring(plan.need))
                                log(("Wistoria: bought Exotic Essence x%d"):format(bought))
                            else
                                local r = H.wistoriaDriveRaid("The First Test")
                                S.WistoriaStatus = (r == "busy" and "waiting: another farm is running")
                                    or (r == "stopped" and "stopped by user")
                                    or (("farming raid for MageCoins (%d/%d)"):format(bal, want * 30))
                            end
                        elseif act == "craftmat" then
                            -- have enough Exotic Ore -> craft the missing ingots at the forge
                            H.wistoriaStopFarm()
                            H.wistoriaWarpForge()
                            S.WistoriaStatus = ("crafting Exotic Ingot (%s/%s)"):format(
                                tostring(plan.have), tostring(plan.need))
                            local okI, resI = call("CraftingService", "Craft", "Exotic Ingot", plan.count)
                            if okI then
                                log(("Wistoria: craft Exotic Ingot x%d -> %s"):format(plan.count, tostring(resI)))
                            else
                                S._wistoriaAtForge = false
                                task.wait(8)
                            end
                        else
                            -- all materials ready -> craft Demonic Metal
                            H.wistoriaStopFarm()
                            S.WistoriaStatus = ("crafting %s (%s/%s)"):format(
                                first.task.item, tostring(first.prog.have), tostring(first.prog.need))
                            H.wistoriaWarpForge()
                            local ok, res = call("CraftingService", "Craft", first.task.item, first.prog.need)
                            if ok then
                                S._wistoriaCrafted = (S._wistoriaCrafted or 0) + (first.prog.need - first.prog.have)
                                log(("Wistoria: craft %s -> %s"):format(first.task.item, tostring(res)))
                            else
                                S._wistoriaAtForge = false -- maybe wrong spot; re-find next retry
                                task.wait(10) -- missing mats or forge busy; retry later
                            end
                        end
                    else
                        -- brrun / mastery / currency: all progress via the same
                        -- solo-Ronin boss rush drive
                        local r = H.wistoriaDriveBossRush()
                        local st = (r == "busy" and "waiting: another farm is running")
                            or (r == "stopped" and "stopped by user")
                            or (("farming %s (%s/%s)"):format(
                                first.task.name, tostring(first.prog.have), tostring(first.prog.need)))
                        if r == "farming" then
                            -- Demon Essence requires a SOLO Ronin kill; keep
                            -- enforcing both so the farm can't silently stall
                            local cls = H.getActiveClassName and H.getActiveClassName()
                            if cls ~= "Ronin" then
                                pcall(function()
                                    local re = H.rawRemote("PlayerActionService", "RE", "ChangeClass")
                                    if re then re:FireServer("Ronin") end
                                end)
                                st = st .. " - need Ronin class!"
                            end
                            S._wistoriaPartyTick = (S._wistoriaPartyTick or 0) + 1
                            if S._wistoriaPartyTick >= 10 then -- ~30s
                                S._wistoriaPartyTick = 0
                                pcall(function() call("DungeonQueueService", "RequestLeaveParty") end)
                            end
                        end
                        S.WistoriaStatus = st
                    end
                else
                    S.WistoriaStatus = "player data not loaded"
                end
                task.wait(3)
            end
            H.wistoriaStopFarm()
            S.WistoriaStatus = nil
            H._wistoriaThread = nil
        end)
    end

