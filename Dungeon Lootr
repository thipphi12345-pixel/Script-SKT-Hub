    -- deep-scan PlayerData for event progress fields (Demon Eye/Essence/Metal
    -- are event items that may not exist in the dumped data modules)
    H._wisteriaDataPaths = nil
    H.scanWisteriaProgress = function(data)
        if type(data) ~= "table" then return {} end
        local found = {}
        -- narrow patterns: require the event item's own name (never match
        -- generic fields like "Exotic Essence" which polluted the count)
        local pats = { "demon", "demonic", "crescent", "wisteria", "wistoria", "lone" }
        local function scan(tbl, path, depth, inside)
            if depth > 3 or type(tbl) ~= "table" then return end
            for k, v in pairs(tbl) do
                local ks = tostring(k):lower()
                if ks:find("exotic") then continue end -- Exotic Essence etc. are NOT quest items
                local hit = inside -- once inside an event table, keep everything
                if not hit then
                    for _, p in ipairs(pats) do if ks:find(p) then hit = true break end end
                end
                if hit then
                    if type(v) == "number" or type(v) == "boolean" then
                        found[path .. "." .. tostring(k)] = v
                    elseif type(v) == "table" then
                        scan(v, path .. "." .. tostring(k), depth + 1, true)
                    end
                end
            end
        end
        for k, v in pairs(data) do
            if type(v) == "table" then scan(v, tostring(k), 1, false) end
        end
        if next(found) and not H._wisteriaDataDumped then
            H._wisteriaDataDumped = true
            for p, v in pairs(found) do
                print(("[AutoFarm] Wisteria data: %s = %s"):format(p, tostring(v)))
            end
        end
        return found
    end

    -- per-task progress: reads server fields when discoverable, local counters otherwise
    H.wisteriaTaskProgress = function(task, data)
        data = data or {}
        local function res(have, need, src)
            return { have = have or 0, need = need or task.need or 1, ok = (have or 0) >= (need or task.need or 1), src = src }
        end
        local ev = H.scanWisteriaProgress(data)
        if task.kind == "currency" then
            return res(data.Currency or 0, task.need, "data.Currency")
        elseif task.kind == "mastery" then
            local cm = data.ClassMastery and data.ClassMastery[task.class or "Ronin"]
            return res(cm and cm.Level or 0, task.need, "ClassMastery")
        elseif task.kind == "craft" then
            local item = task.item or task.id
            local have = (data.CraftingMaterials or {})[item] or (data.QuestItems or {})[item]
            if not have then
                for p, v in pairs(ev) do if p:lower():find(item:lower():gsub(" ", "")) or p:lower():find("demonic") then have = v break end end
            end
            return res(have or (S._wistoriaCrafted or 0), task.need, item)
        elseif task.kind == "brrun" then
            -- server field if found (e.g. QuestItems["Demon Eye"]), else our win counter
            local itemName = task.id == "DemonEssence" and "essence" or "eye"
            local have
            for p, v in pairs(ev) do
                local pl = p:lower()
                if type(v) == "number" and (pl:find(itemName) or pl:find(task.id:lower())) then have = v break end
            end
            if not have then
                local qi = data.QuestItems or {}
                if task.id == "DemonEssence" then
                    have = qi["Demon Essence"] or qi["Demonic Essence"]
                else
                    have = qi["Demon Eye"] or qi["Demon Eyes"]
                end
            end
            if not have then
                -- the wins counter can't prove the solo-Ronin condition;
                -- only trust it for Demon Eyes, never for Demon Essence
                have = (task.id ~= "DemonEssence") and (S._wistoriaWins or 0) or 0
            end
            return res(have, task.need, "boss rush wins")
        end
        return res(0, task.need, "?")
    end

