    local ConfigTransferGroup = Tabs.Config:AddLeftGroupbox("Config Import / Export")

    -- Export: copy config as JSON string to clipboard
    ConfigTransferGroup:AddButton({
        Text = "Export Config (Copy to Clipboard)",
        Func = function()
            local data = H.serializeConfig()
            local ok, json = pcall(function() return H.HttpService:JSONEncode(data) end)
            if ok and json then
                if typeof(setclipboard) == "function" then
                    pcall(setclipboard, json)
                    log("Config exported to clipboard (" .. #json .. " bytes)")
                    pcall(function()
                        Library:Notify({Title = "Config Exported", Description = "Config copied to clipboard. Paste it in another account.", Duration = 4})
                    end)
                else
                    log("Config export: setclipboard not available")
                    pcall(function()
                        Library:Notify({Title = "Export Failed", Description = "Clipboard not supported on this executor.", Duration = 4})
                    end)
                end
            else
                log("Config export: JSON encode failed")
            end
        end,
    })

    -- Import: paste config JSON string, then load it
    local configImportCtrl = ConfigTransferGroup:AddInput("AF_ConfigImport", {
        Text = "Paste Config JSON Here",
        Default = "",
        Placeholder = "Paste exported config JSON here...",
        ClearTextOnFocus = false,
        Callback = function(val) end,
    })

    ConfigTransferGroup:AddButton({
        Text = "Import Config (Load from Text)",
        Func = function()
            local json = ""
            -- Get value from input control
            if configImportCtrl then
                if configImportCtrl.Control and configImportCtrl.Control.Get then
                    json = configImportCtrl.Control:Get() or ""
                end
            end
            if not json or json == "" then
                log("Config import: empty input")
                pcall(function()
                    Library:Notify({Title = "Import Failed", Description = "Paste config JSON first.", Duration = 3})
                end)
                return
            end
            json = json:match("^%s*(.-)%s*$")  -- trim whitespace
            if json == "" then
                log("Config import: empty after trim")
                return
            end
            local ok, data = pcall(function() return H.HttpService:JSONDecode(json) end)
            if not ok or type(data) ~= "table" then
                log("Config import: JSON decode failed")
                pcall(function()
                    Library:Notify({Title = "Import Failed", Description = "Invalid config JSON.", Duration = 3})
                end)
                return
            end
            H.applyConfig(data)
            H.saveConfig()
            log("Config imported and applied successfully")
            pcall(function()
                Library:Notify({Title = "Config Imported", Description = "Config loaded and applied. Reloading UI values...", Duration = 4})
            end)
            -- Update UI toggles/options to reflect new CFG values
            if Library and Library.Toggles then
                for key, option in pairs(Library.Toggles) do
                    if option.SetValue then
                        local cfgKey = key:gsub("^AF_", "")
                        if CFG[cfgKey] ~= nil then
                            pcall(function() option:SetValue(CFG[cfgKey]) end)
                        end
                    end
                end
            end
            if Library and Library.Options then
                for key, option in pairs(Library.Options) do
                    if option.SetValue then
                        local cfgKey = key:gsub("^AF_", "")
                        if CFG[cfgKey] ~= nil then
                            pcall(function() option:SetValue(CFG[cfgKey]) end)
                        end
                    end
                end
            end
        end,
    })

    ConfigTransferGroup:AddButton({
