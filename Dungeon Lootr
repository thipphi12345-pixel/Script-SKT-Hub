        -- เธเธฃเธญเธเธเธดเนเธเธชเนเธงเธเธ—เธตเนเนเธกเนเนเธเนเธซเนเธญเธเธญเธญเธเน€เธ”เนเธ”เธเธฒเธ” (เธซเนเธฒเธกเธงเธฒเธฃเนเธเนเธ WallCap, เธ—เธฒเธเน€เธ”เธดเธเน€เธเธทเนเธญเธก, เน€เธชเธฒ, เธซเธฃเธทเธญเนเธกเน€เธ”เธฅเธ•เธเนเธ•เนเธ)
        if name == "NPCs" or name == "Important" or name:find("Chest") or name:find("Potion") then return false end
        if name:find("WallCap") or name:find("Wall_Cap") or name:find("Side") then return false end
        if name:find("Connector") or name:find("Hallway") or name:find("Turn") then return false end
        if name:find("Pillar") or name:find("Props") or name:find("Door") or name:find("Gate") then return false end
        if name:find("DO_NOT_REMOVE") or name:find("SpawnEffectPool") or name:find("Cosmetics") then return false end

        -- เธเนเธฒเธกเธซเนเธญเธเธ—เธตเนเธฅเนเธญเธ (Locked Room) เธ•เธฒเธกเธเธณเธชเธฑเนเธเธเธนเนเนเธเน
        local lower = name:lower()
        if lower:find("lock") then return false end

        -- เธ•เนเธญเธเธกเธต Zone part, TileAnchor, เธซเธฃเธทเธญ Spawns เธเธญเธเธซเนเธญเธ
        local z = c:FindFirstChild("Zone", true) or c:FindFirstChild("TileAnchor", true) or c:FindFirstChild("Spawns", true)
        if not z then return false end

        if lower:find("^room") or lower:find("^boss") or lower:find("^stage") or lower:find("^arena") or lower:find("^loot") then
            return true
        end

        -- เน€เธเธทเนเธญเธ”เธฑเธเน€เธเธตเนเธขเธเธญเธทเนเธเนเธเนเธเธทเนเธญเนเธเธเธญเธทเนเธ เนเธ•เนเธกเธตเนเธเธฅเน€เธ”เธญเธฃเน Spawns เธ—เธตเนเธกเธต Enemy_Spawn เธซเธฃเธทเธญ Boss_Spawn เธญเธขเธนเนเธเธฃเธดเธ
        local spawns = c:FindFirstChild("Spawns", true)
        if spawns and (spawns:FindFirstChild("Enemy_Spawn") or spawns:FindFirstChild("Boss_Spawn") or spawns:FindFirstChild("Chest_Spawn")) then
            return true
