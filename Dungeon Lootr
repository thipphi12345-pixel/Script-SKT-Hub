    -- Trigger every altar near pos that has not been used yet
    H.useAltarsNear = function(pos, maxDist, tag)
        if not S.Running then return 0 end
        S.UsedAltars = S.UsedAltars or {}
        local count = 0
        for _, altar in ipairs(H.findBlessingAltarsNear(pos, maxDist)) do
            if not S.UsedAltars[altar] then
                S.UsedAltars[altar] = true
                S.AltarBusy = true
                log(("Blessing_Altar found (%s) - activating..."):format(tag or "nearby"))
                if H.warpAndTrigger(altar) then
                    task.wait(1.0) -- let BuffSelection arrive; the watcher picks the card
                    S.BlessingDone = true
                    syncToPersistent()
                    log("Blessing_Altar done")
                else
                    S.UsedAltars[altar] = nil -- trigger failed -> allow retry later
                end
                S.AltarBusy = false
                count = count + 1
            end
        end
        return count
    end


