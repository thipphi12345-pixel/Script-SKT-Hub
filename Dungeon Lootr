    -- Check if any saved target is in current server
    function H.isTargetInServer()
        if not CFG.PartySavedTargets or #CFG.PartySavedTargets == 0 then return false end
        for _, savedName in ipairs(CFG.PartySavedTargets) do
            local savedDisplay = savedName:match("^([^%(]+)")
            if savedDisplay then savedDisplay = savedDisplay:gsub("%s+$", "") end
            for _, p in ipairs(Players:GetPlayers()) do
                if p.UserId ~= LP.UserId then
                    if p.Name == savedDisplay or p.DisplayName == savedDisplay
                        or p.Name == savedName or p.DisplayName == savedName then
                        -- Found target in server — store UserId for follow feature
                        S._lastTargetUserId = p.UserId
                        S._lastTargetName = p.DisplayName or p.Name
                        CFG.PartyLastTargetSeen = tick()
                        return true, p
                    end
                end
            end
        end
        return false
    end

    -- Auto-follow: if target not in server for PartyFollowTimeout seconds, join their server
    function H.checkFollowTarget()
        if not CFG.PartyEnabled then return end
        if not CFG.PartyFollowEnabled then return end
        -- Only follow when in lobby (not in dungeon)
        if LP:GetAttribute("InDungeon") or LP:GetAttribute("InRaid") then return end
        -- Only Leader follows (Member waits for leader)
        if CFG.PartyRole ~= "Leader" then return end
        if not CFG.PartySavedTargets or #CFG.PartySavedTargets == 0 then return end

        local found, targetPlayer = H.isTargetInServer()
        if found then
            -- Target is in server — no need to follow
            return
        end

        -- Target not in server — check timeout
        local now = tick()
        local lastSeen = CFG.PartyLastTargetSeen or now
        local elapsed = now - lastSeen
        local timeout = CFG.PartyFollowTimeout or 40

        if elapsed < timeout then
            -- Haven't waited long enough yet
            return
        end

        -- Cooldown between follow attempts (10s)
        if (now - H._followCooldown) < 10 then return end
        H._followCooldown = now

        log("Party: target not in server for " .. math.floor(elapsed) .. "s — finding their server...")

        -- Find target's UserId from saved targets
        local targetUserId = nil
        for _, savedName in ipairs(CFG.PartySavedTargets) do
            local savedDisplay = savedName:match("^([^%(]+)")
            if savedDisplay then savedDisplay = savedDisplay:gsub("%s+$", "") end
            local cleanName = savedName:match("@([%w_]+)") or savedDisplay or savedName
            cleanName = cleanName:gsub("%s+$", ""):gsub("^%s+", "")
            if not S._lastTargetUserId and cleanName ~= "" then
                pcall(function()
                    local uid = Players:GetUserIdFromNameAsync(cleanName)
                    if uid then S._lastTargetUserId = uid end
                end)
            end
        end

        -- Use stored target UserId if available
        if S._lastTargetUserId then
            local placeId, jobId = H.findFriendServer(S._lastTargetUserId)
            if placeId and jobId then
                log("Party: found target at place=" .. tostring(placeId) .. " job=" .. tostring(jobId))
                H.joinServer(placeId, jobId)
            else
                log("Party: could not find target's server")
            end
        else
            log("Party: could not resolve target UserId — cannot find server")
        end
    end

    -- Get party status string for UI
    function H.getPartyStatus()
        if not CFG.PartyEnabled then return "Party OFF" end
        local required = CFG.PartyRequiredMembers or 1
        local count = H.getPartyMemberCount() + 1  -- +1 for self
        -- Build saved targets string
        local savedStr = ""
        if CFG.PartySavedTargets and #CFG.PartySavedTargets > 0 then
            savedStr = " | Waiting: " .. table.concat(CFG.PartySavedTargets, ", ")
        end
        if CFG.PartyRole == "Member" then
            if count >= 2 then
                return "Member: " .. count .. "/" .. required .. " (in party)" .. savedStr
            end
            return "Member: solo (waiting for leader...)" .. savedStr
        end
        -- Leader
        if count >= required then
            return "Leader: " .. count .. "/" .. required .. " (ready!)" .. savedStr
        end
        return "Leader: " .. count .. "/" .. required .. " (waiting...)" .. savedStr
    end

    -- Count current party members (excluding self)
    function H.getPartyMemberCount()
        if not S.PartyData then return 0 end
        if type(S.PartyData) ~= "table" then
            print("[AutoFarm][DEBUG] getPartyMemberCount: S.PartyData is", type(S.PartyData))
            return 0
        end
        -- Use MemberCount from PartyUpdate if available (more reliable than counting Members table)
        if S.PartyData.MemberCount and type(S.PartyData.MemberCount) == "number" then
            -- MemberCount includes self, so subtract 1
            local count = math.max(0, S.PartyData.MemberCount - 1)
            if count > 0 then
                -- Build member info for debug
                local memberInfo = {}
                if S.PartyData.Members then
                    for _, m in pairs(S.PartyData.Members) do
                        if m.UserId ~= LP.UserId then
                            table.insert(memberInfo, string.format("%s(uid=%s,status=%s)", tostring(m.DisplayName or m.Name), tostring(m.UserId), tostring(m.Status or "unknown")))
                        end
                    end
                end
                print("[AutoFarm][DEBUG] getPartyMemberCount: MemberCount=", S.PartyData.MemberCount, "found", count, "members:", table.concat(memberInfo, ", "))
            end
            return count
        end
        -- Fallback: count Members table
        if not S.PartyData.Members then return 0 end
        local count = 0
        local memberInfo = {}
        for _, m in pairs(S.PartyData.Members) do
            if m.UserId ~= LP.UserId then
                count = count + 1
                table.insert(memberInfo, string.format("%s(uid=%s,status=%s)", tostring(m.DisplayName or m.Name), tostring(m.UserId), tostring(m.Status or "unknown")))
            end
        end
        if count > 0 then
            print("[AutoFarm][DEBUG] getPartyMemberCount: found", count, "members:", table.concat(memberInfo, ", "))
        end
        return count
    end

    -- Wait for party members to join (Leader mode)
    -- Returns true if enough members, false if timeout
    -- When Party is ON and required > 1: MUST wait, never enter solo
    function H.waitForPartyMembers()
        log("[DEBUG waitParty] called | PartyEnabled=" .. tostring(CFG.PartyEnabled) .. " Role=" .. tostring(CFG.PartyRole))
        if not CFG.PartyEnabled then return true end
        if CFG.PartyRole ~= "Leader" then return true end
        local required = CFG.PartyRequiredMembers or 1
        log("[DEBUG waitParty] required=" .. tostring(required))
        if required <= 1 then return true end  -- no wait needed
        -- Build list of target names (from multi-select or single)
        local users = {}
        if type(CFG.PartyTargetUsers) == "table" then
            for _, n in ipairs(CFG.PartyTargetUsers) do table.insert(users, n) end
        elseif type(CFG.PartyTargetUsers) == "string" and CFG.PartyTargetUsers ~= "" then
            table.insert(users, CFG.PartyTargetUsers)
        end
        if #users == 0 then
            local targetName = CFG.PartyTargetUser or ""
            if targetName ~= "" then table.insert(users, targetName) end
        end
        log("[DEBUG waitParty] hasTarget=" .. tostring(#users > 0) .. " count=" .. #users)
        if #users == 0 then
            log("[DEBUG waitParty] no target user - skipping wait")
            return true
        end
        -- Check if any target user is actually in server
        local anyInServer = false
        for _, targetName in ipairs(users) do
            local displayName = targetName:match("^([^%(]+)")
            if displayName then displayName = displayName:gsub("%s+$", "") end
            for _, p in ipairs(Players:GetPlayers()) do
                if p.Name == displayName or p.DisplayName == displayName
                    or p.Name == targetName or p.DisplayName == targetName then
                    anyInServer = true
                    log("[DEBUG waitParty] found target in server: " .. p.Name)
                    break
                end
            end
            if anyInServer then break end
        end
        if not anyInServer then
            log("[DEBUG waitParty] no target users in server - skipping wait")
            return true
        end
        -- Invite immediately
        log("[DEBUG waitParty] sending invite...")
        S._inviteAccepted = {}  -- clear before inviting
        H.autoInvite()
        local timeout = CFG.PartyWaitTimeout or 60
        local waited = 0
        local memberSeenTime = 0  -- when MemberCount first reached required
        log("[DEBUG waitParty] waiting for " .. tostring(required - 1) .. " members (timeout " .. timeout .. "s)")
        while waited < timeout do
            if not S.Running then return false end
            local count = H.getPartyMemberCount() + 1  -- +1 for self
            -- Update status label
            if S.PartyStatusLabel and S.PartyStatusLabel.SetText then
                S.PartyStatusLabel:SetText("Party: " .. count .. "/" .. required .. " (waiting...)")
            end
            -- Check if all required members have ACTUALLY accepted (via InviteResult signal)
            local acceptedCount = 0
            if S.PartyData and S.PartyData.Members then
                for _, m in pairs(S.PartyData.Members) do
                    if m.UserId ~= LP.UserId then
                        if S._inviteAccepted and S._inviteAccepted[m.UserId] == true then
                            acceptedCount = acceptedCount + 1
                        end
                    end
                end
            end
            local totalReady = acceptedCount + 1  -- +1 for self
            -- Method 1: InviteResult says accepted (most reliable)
            if totalReady >= required then
                log("[DEBUG waitParty] ready! " .. totalReady .. "/" .. required .. " members (InviteResult accepted)")
                if S.PartyStatusLabel and S.PartyStatusLabel.SetText then
                    S.PartyStatusLabel:SetText("Party: " .. totalReady .. "/" .. required .. " (ready!)")
                end
                return true
            end
            -- Method 2: MemberCount reached required + wait 3s for server to confirm
            -- (InviteResult may not fire on some executors, so use MemberCount as fallback)
            if count >= required then
                if memberSeenTime == 0 then
                    memberSeenTime = waited
                    log("[DEBUG waitParty] MemberCount reached " .. count .. "/" .. required .. " - waiting 3s for server confirm...")
                end
                if (waited - memberSeenTime) >= 3 then
                    log("[DEBUG waitParty] ready! " .. count .. "/" .. required .. " members (MemberCount confirmed after 3s)")
                    if S.PartyStatusLabel and S.PartyStatusLabel.SetText then
                        S.PartyStatusLabel:SetText("Party: " .. count .. "/" .. required .. " (ready!)")
                    end
                    return true
                end
            end
            -- Re-invite every 3s (was 10s) — more aggressive
            if waited > 0 and waited % 3 == 0 then
                log("[DEBUG waitParty] still waiting... " .. count .. "/" .. required .. " members (accepted: " .. acceptedCount .. ")")
                H.autoInvite()
            end
            task.wait(1)
            waited = waited + 1
        end
        log("[DEBUG waitParty] timeout - members did not accept in time")
        -- Party mode: do NOT enter if members haven't accepted (would cause PodQueue to fail)
        return false
    end

    -- Start a party run (uses PodQueue instead of SoloRun when party is enabled)
    function H.startRun(mode)
        print("[AutoFarm][DEBUG] startRun: mode=", tostring(mode), "PartyEnabled=", tostring(CFG.PartyEnabled), "Role=", tostring(CFG.PartyRole))
        -- When Party is OFF: always use RequestStartSoloRun (same as original)
        if not CFG.PartyEnabled then
            print("[AutoFarm][DEBUG] startRun: Party OFF - warping to pod first (UPDATE 2 requires pod)")
            -- UPDATE 2: solo runs now also require standing on a pod zone
            local podPos = H.findPodPosition(mode)
            if podPos then
                print("[AutoFarm][DEBUG] startRun: warping to pod at", podPos.X, podPos.Y, podPos.Z)
                H.warpToPod(podPos)
            else
                print("[AutoFarm][DEBUG] startRun: no pod found - trying anyway")
            end
            local ok, res = call("DungeonQueueService", "RequestStartSoloRun")
            print("[AutoFarm][DEBUG] startRun: SoloRun -> ok=", tostring(ok), "res=", tostring(res))
            return ok, res
        end
        -- Party is ON
        if CFG.PartyRole == "Member" then
            -- Member: wait for leader to start (don't start own run)
            print("[AutoFarm][DEBUG] startRun: Member mode - not starting own run")
            return true, nil
        end
        -- Leader mode: when Party is ON, always use PodQueue (never solo)
        -- Dungeon/Challenge: use PodQueue
        print("[AutoFarm][DEBUG] startRun: Leader using PodQueue for", tostring(mode))
        -- Warp to pod before calling RequestStartPodQueue (server requires standing on a pod)
        print("[AutoFarm][DEBUG] startRun: finding pod to stand on...")
        local podPos = H.findPodPosition(mode)
        if podPos then
            print("[AutoFarm][DEBUG] startRun: warping to pod at", podPos.X, podPos.Y, podPos.Z)
            H.warpToPod(podPos)
        else
            print("[AutoFarm][DEBUG] startRun: no pod found - trying anyway")
        end
        -- Call directly to see full error message from server
        local s = H.svc("DungeonQueueService")
        if not s or not s.RequestStartPodQueue then
            print("[AutoFarm][DEBUG] startRun: DungeonQueueService or RequestStartPodQueue not found!")
            return false, "service not found"
        end
        local pOk, pData, pErr
        local pcallOk = pcall(function()
            local r = s:RequestStartPodQueue()
            if type(r) == "table" and r.await then
                pOk, pData, pErr = r:await()
            else
                pOk = r
            end
        end)
        print("[AutoFarm][DEBUG] startRun: PodQueue -> pOk=", tostring(pOk), "pData=", tostring(pData), "pErr=", tostring(pErr))
        -- Check if PodQueue actually succeeded
        if not pOk or pData == false then
            -- Fallback: try RequestEnter (like Raid/BossRush)
            print("[AutoFarm][DEBUG] startRun: PodQueue failed - trying RequestEnter...")
            task.wait(0.3)
            local ok2, res2 = call("DungeonQueueService", "RequestEnter")
            print("[AutoFarm][DEBUG] startRun: RequestEnter -> ok=", tostring(ok2), "res=", tostring(res2))
            if not ok2 or res2 == false then
                -- Party mode: do NOT fall back to SoloRun (would bypass party / join random queue)
                if CFG.PartyEnabled then
                    print("[AutoFarm][DEBUG] startRun: Party mode - NOT falling back to SoloRun (would bypass party)")
                    return false, "party start failed"
                end
                -- Solo mode: SoloRun is the last resort
                print("[AutoFarm][DEBUG] startRun: RequestEnter failed - trying SoloRun...")
                task.wait(0.3)
                local ok3, res3 = call("DungeonQueueService", "RequestStartSoloRun")
                print("[AutoFarm][DEBUG] startRun: SoloRun fallback -> ok=", tostring(ok3), "res=", tostring(res3))
                return ok3, res3
            end
            return ok2, res2
        end
        return pOk, pData
    end

    -- Hook party signals (InviteReceived, PartyUpdate, InviteResult)
    function H.hookPartySignals()
        if S.PartyHooked then return end
        S.PartyHooked = true
        -- Hide in-game invite UI when Party auto-accept is on
        H.hideInviteUI()
        -- InviteReceived: someone invited us
        local inviteSignal = evt("DungeonQueueService", "InviteReceived")
        log("Party: InviteReceived signal = " .. tostring(inviteSignal))
        connect(inviteSignal, function(data)
            print("[AutoFarm][DEBUG] InviteReceived: data=", tostring(data))
            if not data or not data.UserId then return end
            if not CFG.PartyEnabled then return end
            if not CFG.PartyAutoAccept then return end
            -- Hide invite UI again (in case game re-shows it)
            H.hideInviteUI()
            -- Check if inviter is in our target list (NOT just any friend)
            local inviterName = data.DisplayName or data.Name or "User"
            local allowed = H.isAllowedInviter(data.UserId, inviterName)
            print("[AutoFarm][DEBUG] InviteReceived: from", inviterName, "userId=", data.UserId, "allowed=", tostring(allowed))
            if not allowed then
                print("[AutoFarm][DEBUG] InviteReceived: REJECTED (not in target list)")
                return
            end
            -- Store as pending invite (for background loop fallback)
            S._pendingInvites = S._pendingInvites or {}
            S._pendingInvites[data.UserId] = true
            print("[AutoFarm][DEBUG] InviteReceived: ACCEPTING...")
            task.spawn(function()
                task.wait(0.3)  -- small delay to ensure invite is valid
                H.acceptInvite(data.UserId)
                -- Retry after 1s if still not in party
                task.wait(1)
                local count = H.getPartyMemberCount()
                if count == 0 then
                    print("[AutoFarm][DEBUG] InviteReceived: retrying accept (not in party yet)")
                    H.acceptInvite(data.UserId)
                end
            end)
        end)
        -- PartyUpdate: party data changed
        local partySignal = evt("DungeonQueueService", "PartyUpdate")
        log("Party: PartyUpdate signal = " .. tostring(partySignal))
        connect(partySignal, function(data)
            print("[AutoFarm][DEBUG] PartyUpdate: data type=", type(data))
            if data and type(data) == "table" then
                S.PartyData = data
                local names = {}
                if data.Members then
                    for k, m in pairs(data.Members) do
                        local info = string.format("key=%s uid=%s name=%s status=%s", tostring(k), tostring(m.UserId), tostring(m.DisplayName or m.Name), tostring(m.Status or m.Accepted or "nil"))
                        print("[AutoFarm][DEBUG] PartyUpdate: member:", info)
                        if m.UserId ~= LP.UserId then
                            table.insert(names, m.DisplayName or m.Name or "?")
                        end
                    end
                    print("[AutoFarm][DEBUG] PartyUpdate: members:", #names > 0 and table.concat(names, ", ") or "solo")
                end
                print("[AutoFarm][DEBUG] PartyUpdate: MemberCount=", tostring(data.MemberCount), "LeaderId=", tostring(data.LeaderId), "SelectedMode=", tostring(data.SelectedMode))
                -- Update status labels
                if S.PartyStatusLabel and S.PartyStatusLabel.SetText then
                    S.PartyStatusLabel:SetText(H.getPartyStatus())
                end
                if S.PartyInfoLabel and S.PartyInfoLabel.SetText then
                    S.PartyInfoLabel:SetText("Members: " .. (#names > 0 and table.concat(names, ", ") or "solo"))
                end
            end
        end)
        -- SessionMemberUpdate: in-dungeon session members changed
        local sessionSignal = evt("DungeonRunService", "SessionMemberUpdate")
        log("Party: SessionMemberUpdate signal = " .. tostring(sessionSignal))
        connect(sessionSignal, function(members)
            log("[DEBUG SessionMemberUpdate] members type=" .. type(members))
            if members and type(members) == "table" then
                S.PartyData = { Members = members }
                local names = {}
                for _, m in pairs(members) do
                    if m.UserId ~= LP.UserId then
                        table.insert(names, m.DisplayName or m.Name or "?")
                    end
                end
                log("Party: session updated - members: " .. (#names > 0 and table.concat(names, ", ") or "solo"))
                if S.PartyStatusLabel and S.PartyStatusLabel.SetText then
                    S.PartyStatusLabel:SetText(H.getPartyStatus())
                end
                if S.PartyInfoLabel and S.PartyInfoLabel.SetText then
                    S.PartyInfoLabel:SetText("Members: " .. (#names > 0 and table.concat(names, ", ") or "solo"))
                end
            end
        end)
        -- InviteResult: result of our invite
        local resultSignal = evt("DungeonQueueService", "InviteResult")
        log("Party: InviteResult signal = " .. tostring(resultSignal))
        connect(resultSignal, function(userId, accepted)
            local p = Players:GetPlayerByUserId(userId)
            local name = p and (p.DisplayName or p.Name) or "User " .. tostring(userId)
            S._inviteAccepted = S._inviteAccepted or {}
            if accepted then
                S._inviteAccepted[userId] = true
                log("Party: " .. name .. " joined! (InviteResult accepted)")
            else
                S._inviteAccepted[userId] = false
                log("Party: " .. name .. " declined")
            end
        end)
    end

    -- Refresh party data periodically (called from main loop + background loop)
    H._partyRefreshTick = 0
    H._partyFirstRefresh = true  -- force immediate refresh on first call
    function H.refreshPartyData()
        if not CFG.PartyEnabled then return end
        local now = tick()
        -- Force immediate refresh on first call (when script just loaded)
        if not H._partyFirstRefresh then
            if (now - H._partyRefreshTick) < 2 then return end  -- 2s cooldown
        end
        H._partyFirstRefresh = false
        H._partyRefreshTick = now
        -- If in dungeon, use GetSessionMembers; otherwise use RequestPartyData
        if LP:GetAttribute("InDungeon") or LP:GetAttribute("InRaid") then
            local ok, members = call("DungeonRunService", "GetSessionMembers")
            if ok and type(members) == "table" then
                -- GetSessionMembers returns a list of members (not a party data table)
                -- Build S.PartyData with MemberCount so getPartyMemberCount works
                local memberCount = 0
                for _ in pairs(members) do memberCount = memberCount + 1 end
                -- members might be array or dict; count properly
                if #members > 0 then memberCount = #members end
                S.PartyData = { Members = members, MemberCount = memberCount }
                log("[DEBUG refreshPartyData] GetSessionMembers -> " .. memberCount .. " members")
                -- Update status label
                if S.PartyStatusLabel and S.PartyStatusLabel.SetText then
                    S.PartyStatusLabel:SetText(H.getPartyStatus())
                end
            end
        else
            H.getPartyData()
            -- Also update status label immediately after refresh
            if S.PartyStatusLabel and S.PartyStatusLabel.SetText then
                S.PartyStatusLabel:SetText(H.getPartyStatus())
            end
            -- If we just left dungeon and have remembered party members, auto-invite them
            if S._lastPartyMembers and #S._lastPartyMembers > 0 and CFG.PartyEnabled and CFG.PartyRole == "Leader" then
                if not S._reinvitedAfterDungeon then
                    S._reinvitedAfterDungeon = true
                    log("Party: re-inviting party members after dungeon: " .. table.concat(S._lastPartyMembers, ", "))
                    for _, name in ipairs(S._lastPartyMembers) do
                        H.invitePlayerByName(name)
                        task.wait(0.3)
                    end
                end
            end
        end
    end

    -- Refresh player dropdown periodically (called from main loop)
    H._playerListTick = 0
    H._playerListCache = {}
    function H.refreshPlayerList()
        local now = tick()
        if (now - H._playerListTick) < 1 then return end  -- 1s (was 3s) for realtime
        H._playerListTick = now
        local new = H.getServerPlayers()
        -- Check if list changed
        local changed = #new ~= #H._playerListCache
        if not changed then
            for i, v in ipairs(new) do
                if v ~= H._playerListCache[i] then changed = true break end
            end
        end
        if changed then
            H._playerListCache = new
            -- Update dropdowns if they exist
            pcall(function()
                local dd = Options and Options.AF_PartyTargetUsers
                if dd and dd.SetValues then
                    dd:SetValues(new)
                end
            end)
            pcall(function()
                local dd = Options and Options.AF_PartyTargetUser
                if dd and dd.SetValues then
                    dd:SetValues(new)
                end
            end)
            -- Auto-select saved targets that are now in server
            if CFG.PartySavedTargets and #CFG.PartySavedTargets > 0 then
                local toSelect = {}
                for _, savedName in ipairs(CFG.PartySavedTargets) do
                    local savedDisplay = savedName:match("^([^%(]+)")
                    if savedDisplay then savedDisplay = savedDisplay:gsub("%s+$", "") end
                    for _, serverName in ipairs(new) do
                        local serverDisplay = serverName:match("^([^%(]+)")
                        if serverDisplay then serverDisplay = serverDisplay:gsub("%s+$", "") end
                        if savedDisplay == serverDisplay or savedName == serverName then
                            table.insert(toSelect, serverName)
                            break
                        end
                    end
                end
                if #toSelect > 0 then
                    CFG.PartyTargetUsers = toSelect
                    pcall(function()
                        local dd = Options and Options.AF_PartyTargetUsers
                        if dd and dd.Control and dd.Control.Set then
                            dd.Control:Set(toSelect, false)
                        end
                    end)
                    log("Party: auto-selected " .. #toSelect .. " saved target(s) now in server")
                end
            end
            log("Party: player list updated (" .. #new .. " players)")
            -- Update saved targets label
            pcall(function()
                local lbl = S.PartySavedLabel
                if lbl and lbl.SetText then
                    local savedStr = "None"
                    if CFG.PartySavedTargets and #CFG.PartySavedTargets > 0 then
                        -- Show which saved targets are in server vs waiting
                        local inServer = {}
                        local waiting = {}
                        for _, savedName in ipairs(CFG.PartySavedTargets) do
                            local savedDisplay = savedName:match("^([^%(]+)")
                            if savedDisplay then savedDisplay = savedDisplay:gsub("%s+$", "") end
                            local found = false
                            for _, serverName in ipairs(new) do
                                local serverDisplay = serverName:match("^([^%(]+)")
                                if serverDisplay then serverDisplay = serverDisplay:gsub("%s+$", "") end
                                if savedDisplay == serverDisplay or savedName == serverName then
                                    found = true
                                    break
                                end
                            end
                            if found then
                                table.insert(inServer, savedName)
                            else
                                table.insert(waiting, savedName)
                            end
                        end
                        local parts = {}
                        if #inServer > 0 then
                            table.insert(parts, "Online: " .. table.concat(inServer, ", "))
                        end
                        if #waiting > 0 then
                            table.insert(parts, "Waiting: " .. table.concat(waiting, ", "))
                        end
                        savedStr = table.concat(parts, " | ")
                    end
                    lbl:SetText("Saved: " .. savedStr)
                end
            end)
        end
    end

    -- Auto-refresh player list when someone joins/leaves (realtime)
    Players.PlayerAdded:Connect(function(p)
        H._playerListTick = 0  -- force refresh on next cycle
        -- When a saved target joins, invite them immediately (don't wait for refresh cycle)
        task.wait(2)  -- wait for player to fully load
        H.autoSelectPlayers()
        -- If Party is enabled and we're Leader, check if this player is a saved target
        if CFG.PartyEnabled and CFG.PartyRole == "Leader" and CFG.PartySavedTargets then
            local playerName = p.DisplayName or p.Name
            local playerDisplay = playerName
            local isSavedTarget = false
            for _, savedName in ipairs(CFG.PartySavedTargets) do
                local savedDisplay = savedName:match("^([^%(]+)")
                if savedDisplay then savedDisplay = savedDisplay:gsub("%s+$", "") end
                if savedDisplay == playerName or savedDisplay == p.Name or savedName == playerName then
                    isSavedTarget = true
                    break
                end
            end
            if isSavedTarget then
                local required = CFG.PartyRequiredMembers or 1
                local count = H.getPartyMemberCount() + 1
                if count < required then
                    log("Party: saved target " .. playerName .. " joined server - inviting immediately!")
                    H.invitePlayerByName(playerName)
                end
            end
        end
    end)
    Players.PlayerRemoving:Connect(function()
        H._playerListTick = 0  -- force refresh on next cycle
    end)

    -- Auto-select saved targets that are in server (NOT all players)
    function H.autoSelectPlayers()
        if not CFG.PartyEnabled then return end
        if CFG.PartyRole ~= "Leader" then return end
        local current = {}
        if type(CFG.PartyTargetUsers) == "table" then
            for _, v in ipairs(CFG.PartyTargetUsers) do
                if type(v) == "string" then table.insert(current, v) end
            end
        elseif type(CFG.PartyTargetUsers) == "string" and CFG.PartyTargetUsers ~= "" then
            current = { CFG.PartyTargetUsers }
        end
        if #current > 0 then return end  -- already have targets selected
        -- If we have saved targets, select only those that are in server
        if CFG.PartySavedTargets and #CFG.PartySavedTargets > 0 then
            local all = H.getServerPlayers()
            local toSelect = {}
            for _, savedName in ipairs(CFG.PartySavedTargets) do
                local savedDisplay = savedName:match("^([^%(]+)")
                if savedDisplay then savedDisplay = savedDisplay:gsub("%s+$", "") end
                for _, serverName in ipairs(all) do
                    local serverDisplay = serverName:match("^([^%(]+)")
                    if serverDisplay then serverDisplay = serverDisplay:gsub("%s+$", "") end
                    if savedDisplay == serverDisplay or savedName == serverName then
                        table.insert(toSelect, serverName)
                        break
                    end
                end
            end
            if #toSelect > 0 then
                CFG.PartyTargetUsers = toSelect
                log("Party: auto-selected " .. #toSelect .. " saved target(s) from server")
                pcall(function()
                    local dd = Options and Options.AF_PartyTargetUsers
                    if dd and dd.Control and dd.Control.Set then
                        dd.Control:Set(toSelect, false)
                    end
                end)
                -- Don't scheduleSave here — saved targets are already saved
            end
            return  -- Don't select all players
        end
        -- No saved targets — don't auto-select anyone (user must select manually)
    end

    -- Background loop: update party status + refresh data even when Auto Farm is OFF
    task.spawn(function()
        while not S.PartyUnloaded do
            -- Update status label
            if S.PartyStatusLabel and S.PartyStatusLabel.SetText then
                S.PartyStatusLabel:SetText(H.getPartyStatus())
            end
            -- Update members info label
            if S.PartyInfoLabel and S.PartyInfoLabel.SetText then
                if S.PartyData and type(S.PartyData) == "table" and S.PartyData.Members then
                    local names = {}
                    for _, m in pairs(S.PartyData.Members) do
                        if m.UserId ~= LP.UserId then
                            table.insert(names, m.DisplayName or m.Name or "?")
                        end
                    end
                    S.PartyInfoLabel:SetText("Members: " .. (#names > 0 and table.concat(names, ", ") or "solo"))
                else
                    S.PartyInfoLabel:SetText("Members: solo")
                end
            end
            -- Refresh player list + party data when Party is enabled
            if CFG.PartyEnabled then
                H.refreshPlayerList()
                H.refreshPartyData()
                -- Auto-select saved targets if none selected
                H.autoSelectPlayers()
                -- Auto-invite if Leader and not enough members yet (every 3s)
                if CFG.PartyRole == "Leader" then
                    local required = CFG.PartyRequiredMembers or 1
                    local count = H.getPartyMemberCount() + 1
                    if count < required then
                        -- autoInvite has 3s cooldown internally
                        H.autoInvite()
                    end
                    -- Auto-follow: if target not in server for too long, join their server
                    H.checkFollowTarget()
                end
            end
            task.wait(1)  -- check every 1s for faster response
        end
    end)

    -- Hook party signals on startup if Party is already enabled from saved config
    if CFG.PartyEnabled then
        task.spawn(function()
            task.wait(1)  -- wait for UI to initialize
            H.hookPartySignals()
            if CFG.PartyAutoAccept then H.refreshFriends() end
            -- Force immediate party data refresh (so status shows correct count right away)
            H._partyFirstRefresh = true
            H.refreshPartyData()
            -- Update status label immediately
            if S.PartyStatusLabel and S.PartyStatusLabel.SetText then
                S.PartyStatusLabel:SetText(H.getPartyStatus())
            end
            log("Party: signals hooked on startup (role=" .. tostring(CFG.PartyRole) .. ")")
        end)
    end

    -- Background auto-accept loop: check for pending invites and accept them
    -- This is a fallback in case InviteReceived signal is missed
    S._pendingInvites = S._pendingInvites or {}
    task.spawn(function()
        while not S.PartyUnloaded do
            if CFG.PartyEnabled and CFG.PartyAutoAccept and CFG.PartyRole == "Member" then
                -- Try to accept any pending invites (only from allowed inviters)
                for userId, _ in pairs(S._pendingInvites) do
                    if H.isAllowedInviter(userId) then
                        print("[AutoFarm][DEBUG] auto-accept: accepting pending invite from", tostring(userId))
                        H.acceptInvite(userId)
                    else
                        print("[AutoFarm][DEBUG] auto-accept: rejecting pending invite from", tostring(userId), "(not in target list)")
                    end
                    S._pendingInvites[userId] = nil
                end
            end
            task.wait(2)
        end
    end)

    function H.reportReceipt(action, ok, result, label)
        local status = H.receiptStatus(ok, result)
        local text = action .. ": " .. status
        if status == "REQUEST ERROR" and type(result) == "string" then text = text .. " | " .. result end
        log(text)
        if label and label.SetText then label:SetText(text) end
        return status == "CONFIRMED"
    end

    -- Redeem a code
    function H.redeemCode(code)
        if not code or code == "" then return false end
        local ok, res = call("CodesService", "RedeemCode", code)
        return H.reportReceipt("Redeem " .. tostring(code), ok, res, S.CodeResultLabel)
    end

    -- Allocate stat point
    -- Map display names to stat codes (game uses STR/DEX/INT/VIT/LCK)
    H.StatNameToCode = {
        Strength = "STR", Dexterity = "DEX", Intelligence = "INT",
        Vitality = "VIT", Luck = "LCK",
        STR = "STR", DEX = "DEX", INT = "INT", VIT = "VIT", LCK = "LCK",
    }

    function H.upStat(statType)
        -- Convert display name to stat code
        local code = H.StatNameToCode[statType] or statType
        local ok, res = call("StatService", "AllocatePoint", code)
        -- res must be truthy: nil/false = rejected (no SP etc.), not success
        if ok and res ~= nil and res ~= false then
            return true
        else
            log(("Stat FAIL: %s (code=%s ok=%s res=%s)"):format(statType, code, tostring(ok), tostring(res)))
            return false
        end
    end

    -- Auto allocate all skill points (game built-in)
    function H.autoAllocateStats()
        local ok, res = call("StatService", "AutoAllocate")
        log(("AutoAllocate: %s"):format(tostring(ok)))
        return ok
    end

    -- Allocate multiple points to a stat
    function H.allocatePoints(statType, count)
        local ok, res = call("StatService", "AllocatePoints", statType, count or 1)
        log(("AllocatePoints %s x%s: %s"):format(statType, tostring(count), tostring(ok)))
        return ok
    end

    -- "Recommended" stat for the ACTIVE class (same rule as the game's stat UI):
    -- Physical -> STR, Ranged -> DEX, Magic -> INT
    function H.recommendedStatCode()
        local map = { Physical = "STR", Ranged = "DEX", Magic = "INT" }
        local cls
        local pd = H.getPlayerData()
        if pd and pd.Data then cls = pd.Data.ActiveClass end
