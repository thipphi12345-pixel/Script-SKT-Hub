    -- Score an equipment item (higher = better)
    function H.scoreEquipItem(item)
        local score = (H.RarityIndex[item.Rarity] or 0) * 1000
        if item.Slot == "Ring" then
            score = score + (item.BaseDamage or 0) * 10
        end
        if (item.Slot == "Body" or item.Slot == "Head") and item.GuaranteedStat then
            score = score + (item.GuaranteedStat.Value or 0) * 10
        end
        if item.StatLines then
            for _, s in ipairs(item.StatLines) do
                score = score + math.abs(s.Value or 0) * 2
            end
        end
        score = score + (item.EnchantLevel or 0) * 50
        return score
    end

