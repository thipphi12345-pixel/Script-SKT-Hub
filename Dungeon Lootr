    -- Appraisal: reroll base stats ของ gear ที่ LevelReq < เลเวลเรา (เกมเตือน: อาจได้ stat ต่ำกว่าเดิม)

    -- Mystery Merchant: NPC มาทุก ~2 ชม. อยู่ 30 นาที — auto-buy stock ที่เลือก
    H._merchantDone = {}  -- ["<rotation>:<id>"] = true
    function H.buyMerchantStock()
        local ok, info = call("MysteryMerchantService", "GetShopInfo")
        if not ok or type(info) ~= "table" or not info.Active then return false end
        if workspace:GetServerTimeNow() >= (info.LeavesAt or 0) then return false end
        local rot = info.Rotation or 0
        local wantSet = raritySet(CFG.MerchantItems, nil)
        local buyAll = (next(wantSet) == nil)
        local rf = H.rawRemote("MysteryMerchantService", "RF", "BuyItem")
        local bought = 0
        for _, item in ipairs(info.Items or {}) do
            local id = type(item) == "table" and item.Id or nil
            if id and (buyAll or wantSet[id]) then
                local key = tostring(rot) .. ":" .. tostring(id)
                if not H._merchantDone[key] then
                    local okB, success, errCode
                    if rf then
                        okB, success, errCode = pcall(function() return rf:InvokeServer(id, rot) end)
                    else
                        okB, success = call("MysteryMerchantService", "BuyItem", id, rot)
                    end
                    if okB and success then
                        bought = bought + 1
                        H._merchantDone[key] = true
                        log(("Merchant: bought %s"):format(id))
                    else
                        if errCode and errCode ~= "NO_STARS" then
                            H._merchantDone[key] = true
                        end
                        log(("Merchant: buy %s failed (%s)"):format(id, tostring(errCode or success)))
                    end
                    task.wait(0.4)
                end
            end
        end
        if bought > 0 then log(("Merchant: bought %d item(s)"):format(bought)) end
        return bought > 0
    end

    H._merchantThread = nil
    function H.startAutoMerchant()
        if H._merchantThread then return end
        log("Auto Merchant started (checks every 60s)")
        H._merchantThread = task.spawn(function()
            while CFG.AutoMerchant and not S.PartyUnloaded do
                pcall(H.buyMerchantStock)
                task.wait(60)
            end
            H._merchantThread = nil
        end)
    end

    -- ============================================================
    -- Battle Pass Auto Claim (via UI Claim_All button)
    -- ============================================================
    -- Battle Pass Auto Claim System
    -- Replicates Claim_All button logic: loops tiers, calls ClaimReward directly
    -- Uses task.spawn so :await() can yield (fixes "cannot resume non-suspended coroutine")
    -- ============================================================

    -- Find Battlepass frame in PlayerGui
    function H.getBPFrame()
        local pg = LP:FindFirstChild("PlayerGui")
        if not pg then return nil end
        local main = pg:FindFirstChild("Main")
        if not main then return nil end
        local frames = main:FindFirstChild("Frames")
        if not frames then return nil end
        return frames:FindFirstChild("Battlepass")
    end

    -- Replicate Claim_All button logic: loop tiers 1..Tier, claim Free + Premium
    -- This is exactly what the game's Claim_All handler does internally
    function H.claimBattlePass()
        local pd = H.getPlayerData()
        if not pd or not pd.Data or not pd.Data.Battlepass then 
            return false 
        end
        local bp = pd.Data.Battlepass
        local maxTier = bp.Tier or 0
        local hasPremium = bp.HasPremium or false
        local claimedFree = bp.ClaimedFree or {}
        local claimedPremium = bp.ClaimedPremium or {}
        
        -- Get BattlepassService
        local bpService = H.svc("BattlepassService")
        if not bpService or not bpService.ClaimReward then 
            return false 
        end
        
        -- Run in task.spawn so :await() can yield
        task.spawn(function()
            local claimed = 0
            for i = 1, math.min(maxTier, 100) do
                -- Claim Free if not claimed
                if not table.find(claimedFree, i) then
                    local ok, res = pcall(function()
                        local r = bpService:ClaimReward(i, "Free")
                        if type(r) == "table" and r.await then return r:await() end
                        return r
                    end)
                    if ok and res then claimed = claimed + 1 end
                    task.wait(0.05)
                end
                -- Claim Premium if has premium and not claimed
                if hasPremium and not table.find(claimedPremium, i) then
                    local ok, res = pcall(function()
                        local r = bpService:ClaimReward(i, "Premium")
                        if type(r) == "table" and r.await then return r:await() end
                        return r
                    end)
                    if ok and res then claimed = claimed + 1 end
                    task.wait(0.05)
                end
            end
            if claimed > 0 then
                log(("BP: claimed %d rewards"):format(claimed))
            end
        end)
        return true
    end

    -- Auto Battle Pass loop (background, configurable interval)
    H._bpThread = nil
    function H.startAutoBattlePass()
        if H._bpThread then 
            task.cancel(H._bpThread)
            H._bpThread = nil
        end
        log("Auto Battle Pass started")
        H._bpThread = task.spawn(function()
            while CFG.AutoBattlePass and not S.PartyUnloaded do
                H.claimBattlePass()
                -- Wait based on configured interval (default 1s)
                local interval = CFG.BPCheckInterval or 1
                -- Use small waits so we can stop quickly
                local waited = 0
                while waited < interval and CFG.AutoBattlePass do
                    task.wait(0.1)
                    waited = waited + 0.1
                end
            end
            H._bpThread = nil
        end)
    end

