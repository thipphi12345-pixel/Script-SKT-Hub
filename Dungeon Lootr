    -- plan the next action for the Demonic Metal task given current stock
    H.wistoriaMetalPlan = function(data, metalsLeft)
        metalsLeft = math.max(tonumber(metalsLeft) or 0, 0)
        if metalsLeft <= 0 then return { action = "done" } end
        local needIngot = metalsLeft * 5
        local needEss   = metalsLeft * 2
        local needHeart = metalsLeft * 1
        local hIngot = H.wistoriaMatCount(data, "Exotic Ingot")
        local hEss   = H.wistoriaMatCount(data, "Exotic Essence")
        local hHeart = H.wistoriaMatCount(data, "Devil Heart")
        if hIngot < needIngot then
            local ingotsToCraft = needIngot - hIngot
            local oreNeed = ingotsToCraft * 5
            local hOre = H.wistoriaMatCount(data, "Exotic Ore")
            if hOre >= oreNeed then
                return { action = "craftmat", item = "Exotic Ingot", count = ingotsToCraft, have = hIngot, need = needIngot }
            end
            return { action = "farm", item = "Exotic Ore", have = hOre, need = oreNeed }
        elseif hEss < needEss then
            return { action = "essence", item = "Exotic Essence", have = hEss, need = needEss }
        elseif hHeart < needHeart then
            return { action = "farm", item = "Devil Heart", have = hHeart, need = needHeart }
        end
        return { action = "craftmetal", count = metalsLeft }
    end

