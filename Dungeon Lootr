    -- cache สำหรับ GetUnlockedDifficulties (เรียกครั้งเดียว ใช้ซ้ำ 30 วิ)
    local _diffUnlockCache = {}
    local _diffUnlockCacheTime = 0
    H.getUnlockedDifficulties = function(dungeonKey)
        local now = os.clock()
        if now - _diffUnlockCacheTime > 30 then
            _diffUnlockCache = {}
            _diffUnlockCacheTime = now
        end
        if _diffUnlockCache[dungeonKey] ~= nil then
            return _diffUnlockCache[dungeonKey]
        end
        local result = nil
        if call then
            local ok, res = call("DungeonQueueService", "GetUnlockedDifficulties", dungeonKey)
            if ok and type(res) == "table" then
                result = res
            end
        end
        _diffUnlockCache[dungeonKey] = result
        return result
    end

    function H.getLevelRecommendation()
        local pd = H.getPlayerData()
        local data = pd and pd.Data
        local level = type(data) == "table" and H.readCount(data.PlayerLevel) or nil
        local info = { level = level, blocked = {} }
        if not level or level < 1 then
            info.message = "Waiting for PlayerData.PlayerLevel."
            return info
        end
        local catalog = H.DungeonData
        if not catalog or type(catalog.Dungeons) ~= "table" or type(catalog.CanEnter) ~= "function" then
            info.message = "Dungeon recommendations unavailable: game data is not loaded."
            return info
        end
        local candidates = {}
        for key, dungeon in pairs(catalog.Dungeons) do
            if type(dungeon) == "table" and not dungeon.Legacy and not dungeon.ChallengeMode
                and not dungeon.HideFromSelect and not dungeon.Locked then
                local ok, allowed, reason = pcall(catalog.CanEnter, pd, key)
                local name = tostring(dungeon.DisplayName or key)
                if not ok or allowed ~= true then
                    table.insert(info.blocked, name .. ": " .. (ok and tostring(reason or "Not unlocked") or "Entry check unavailable"))
                elseif type(dungeon.DifficultyLevelBrackets) == "table" then
                    -- เช็คว่า difficulty ไหน unlock บ้างจาก server (GetUnlockedDifficulties)
                    -- ต้องเคยผ่าน difficulty ก่อนหน้า ถึงจะ unlock difficulty ที่สูงขึ้น
                    local unlockedMap = H.getUnlockedDifficulties(key)
                    for rank, mode in ipairs({ "Easy", "Normal", "Hard", "Nightmare" }) do
                        local bracket = dungeon.DifficultyLevelBrackets[mode]
                        local min = type(bracket) == "table" and H.readCount(bracket.Min) or nil
                        local max = type(bracket) == "table" and H.readCount(bracket.Max) or nil
                        if min and max and max >= min then
                            -- เช็คว่า difficulty นี้ unlock ไหม
                            local isUnlocked = true
                            if unlockedMap then
                                local diffInfo = unlockedMap[mode]
                                if type(diffInfo) == "table" then
                                    isUnlocked = diffInfo.Unlocked == true
                                else
                                    isUnlocked = false
                                end
                            end
                            if isUnlocked then
                                table.insert(candidates, {
                                    key = key, name = name, mode = mode, rank = rank,
                                    order = tonumber(dungeon.DisplayOrder) or 0,
                                    min = math.max(min, H.readCount(dungeon.MinLevel) or 0), max = max,
                                })
                            end
                        end
                    end
                end
            end
        end
        table.sort(candidates, function(a, b)
            if a.order ~= b.order then return a.order > b.order end
            if a.min ~= b.min then return a.min > b.min end
            if a.rank ~= b.rank then return a.rank > b.rank end
            return tostring(a.key) < tostring(b.key)
        end)
        for _, candidate in ipairs(candidates) do
            if candidate.min <= level then
                info.current = candidate
                break
            end
        end
        for _, candidate in ipairs(candidates) do
            local current = info.current
            if candidate.min > level and (not current or candidate.order > current.order
                or (candidate.key == current.key and candidate.rank > current.rank)) then
                if not info.next or candidate.min < info.next.min then info.next = candidate end
            end
        end
        info.candidates = candidates  -- exposed for fail-fallback (drop to lower dungeon)
        table.sort(info.blocked)
        info.message = "Level-based suggestion, not an XP-rate or clear-speed guarantee. Dungeon mode only."
        return info
    end

    function H.formatLevelRecommendation(info)
        local lines = { "Player Lv: " .. tostring(info.level or "Unknown") }
        if info.current then
            local stage = info.current
            table.insert(lines, string.format("Recommended: %s | Dungeon / %s | Lv %d-%d", stage.name, stage.mode, stage.min, stage.max))
            if info.level > stage.max then
                table.insert(lines, "Above this bracket; no higher unlocked recommendation is currently available.")
            end
        else
            table.insert(lines, "Recommended: No verified option for the available level and unlock data.")
        end
        if #info.blocked > 0 then
            table.insert(lines, "Other stages / requirements:\n" .. table.concat(info.blocked, "\n"))
        end
        return table.concat(lines, "\n")
    end

    -- Check moderation flags from PlayerData (client-side replica)
    H.getModerationFlags = function()
        local pd = H.getPlayerData()
        if not pd or type(pd.Data) ~= "table" then return nil end
        local data = pd.Data
        local flags = data.ModerationFlags
        local lifetime = H.readCount(data.ModerationFlags_Lifetime)
        local flagCount = type(flags) == "table" and 0 or nil
        local flagDetails = {}
        if type(flags) == "table" then
            for key, flag in pairs(flags) do
                flagCount = flagCount + 1
                if type(flag) == "table" then
                    -- Try common field names, fallback to first string/number values
                    local reason = flag.Detail
                    local time = flag.Timestamp
                    local source = flag.Source
                    -- If reason still nil, try to find any string field that's not the time
                    if type(reason) ~= "string" then
                        reason = type(flag.Reason) == "string" and flag.Reason or "Not provided"
                    end
                    -- If time still nil, try any number field
                    if time == nil then time = flag.Time end
                    -- If source still nil, try remaining string fields
                    if type(source) ~= "string" then
                        source = type(flag.Service) == "string" and flag.Service or "Not provided"
                    end
                    table.insert(flagDetails, {
                        key = tostring(key),
                        category = type(flag.Category) == "string" and flag.Category or "Not provided",
                        reason = reason,
                        time = H.readCount(time),
                        source = source,
                        raw = flag
                    })
                elseif type(flag) == "number" then
                    -- flag is just a timestamp
                    table.insert(flagDetails, {
                        key = tostring(key), category = "Not provided",
                        reason = "Not provided",
                        time = H.readCount(flag),
                        source = "Not provided",
                        raw = flag
                    })
                else
                    table.insert(flagDetails, {
                        key = tostring(key), category = "Not provided",
                        reason = type(flag) == "string" and flag or "Unsupported record format",
                        time = nil,
                        source = "Not provided",
                        raw = flag
                    })
                end
            end
        end
        table.sort(flagDetails, function(a, b)
            if a.time ~= b.time then return (a.time or math.huge) < (b.time or math.huge) end
            return a.key < b.key
        end)
        return {
            userId = LP.UserId,
            count = flagCount,
            lifetime = lifetime,
            details = flagDetails,
            atRisk = flagCount == 50,
            denied = lifetime ~= nil and lifetime > 100
        }
    end

    function H.moderationSummary(info)
        if not info then return "Moderation: Unknown - player data is not available." end
        local status = "Entry and rewards are not verified by this viewer."
        if info.denied then
            status = "Over 100 lifetime flags: Tournament entry denied by the Update 1.5 flag rule."
        elseif info.lifetime == nil or info.count == nil then
            status = "Unknown - some moderation fields are not available."
        elseif info.atRisk then
            status = "50 retained flags: At Risk under the Update 1.5 rule; rewards require staff review."
        end
        return string.format("UID: %s | Retained: %s | Lifetime: %s\n%s",
            tostring(info.userId), tostring(info.count or "Unknown"), tostring(info.lifetime or "Unknown"), status)
    end

