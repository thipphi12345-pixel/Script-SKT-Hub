    H.switchToNextLoopFarmMode = function(currentMode)
        if not CFG.LoopFarmEnabled then return false end
        if not S.LoopFarm then S.LoopFarm = { Counter = 0 } end
        S.LoopFarm.Counter = 0
        log("Loop Farm: Finished runs for " .. tostring(currentMode) .. ". Finding next mode...")
        
        local modes = { "Dungeon", "Raid", "BossRush", "Challenge", "Endless" }
        local runs = {
            Dungeon = CFG.LoopDungeonRuns or 5,
            Raid = CFG.LoopRaidRuns or 3,
            BossRush = CFG.LoopBossRushRuns or 1,
            Challenge = CFG.LoopChallengeRuns or 1,
            Endless = CFG.LoopEndlessRuns or 0
        }
        
        -- Find next mode based on runs > 0 AND the user actually having the mode toggled ON
        local idx = 0
        if currentMode ~= "Init" then
            for i, m in ipairs(modes) do
                if m == currentMode then idx = i; break end
            end
        end
        
        local nextMode = nil
        for i = 1, #modes do
            idx = idx + 1
            if idx > #modes then idx = 1 end
            local testMode = modes[idx]
            
            -- Check if it's enabled in UI
            local isEnabled = false
            if testMode == "Dungeon" then isEnabled = CFG.AutoJoin or CFG.AutoFarmLVL
            elseif testMode == "Raid" then isEnabled = CFG.RaidEnabled
            elseif testMode == "BossRush" then isEnabled = CFG.BossRushEnabled
            elseif testMode == "Challenge" then isEnabled = CFG.AutoChallenge
            elseif testMode == "Endless" then isEnabled = CFG.AutoFarmEndless
            end
            
            if runs[testMode] > 0 and isEnabled then
                nextMode = testMode
                break
            end
        end
        
        if nextMode then
            log("Loop Farm: Switching to " .. nextMode)
            if S.LoopFarmStatusLabel then
                local currentRun = S.LoopFarm.Counter + 1
                S.LoopFarmStatusLabel:SetText("Status: Running (" .. nextMode .. " [" .. tostring(currentRun) .. "/" .. tostring(runs[nextMode]) .. "])") 
            end
            
            S.LoopFarm.CurrentTarget = nextMode
            H.scheduleSave()
            -- Kickstart the new loop target
            task.delay(3, function()
                if S.Running then task.spawn(S._mainLoop) end
            end)
            return true
        else
            log("Loop Farm: No modes have runs > 0 or are enabled. Stopping.")
            if S.LoopFarmStatusLabel then S.LoopFarmStatusLabel:SetText("Status: Stopped (No targets)") end
            S.LoopFarm.CurrentTarget = nil
            return false
        end
    end

    -- ————————————————————————— Auto Join Best Stage: เลือกดันเจี้ยนที่ดีที่สุดที่ปลดล็อคได้ —————————————————————————
    -- ตรวจจาก DungeonData.CanEnter + DisplayOrder (เลือก Order สูงสุด = ด่านล่าสุด)
    H.getBestDungeonKey = function()
        if not H.DungeonData or not H.DungeonData.Dungeons then
            return CFG.DungeonKey  -- fallback ใช้ค่าเดิม
        end

        local pd = H.getPlayerData()
        local playerData = pd or { Data = {} }

        -- รวมดันเจี้ยนธรรมดา (ไม่ใช่ ChallengeMode และไม่ใช่ Legacy)
        local candidates = {}
        for key, data in pairs(H.DungeonData.Dungeons) do
            if not data.Legacy and not data.ChallengeMode then
                local canEnter, reason = pcall(function()
                    if H.DungeonData.CanEnter then
                        return H.DungeonData.CanEnter(playerData, key)
                    end
                    return true
                end)
                -- pcall คืน (ok, result) — ถ้า ok=false แปลว่า error ไม่ใช่ canEnter
                if canEnter and reason == true then
                    table.insert(candidates, { key = key, order = data.DisplayOrder or 0 })
                end
            end
        end

        -- เน€เธฃเธตเธขเธเธ•เธฒเธก DisplayOrder เธเธฒเธเธกเธฒเธเนเธเธเนเธญเธข (เธ”เนเธฒเธเธชเธนเธเธชเธธเธ” = เธ”เธตเธ—เธตเนเธชเธธเธ”)
        table.sort(candidates, function(a, b) return a.order > b.order end)

        if #candidates > 0 then
            local best = candidates[1]
            if best.key ~= CFG.DungeonKey then
                log(("Best stage: %s (Order=%d) โ€” switching from %s"):format(best.key, best.order, CFG.DungeonKey))
                CFG.DungeonKey = best.key
                P.LastDungeonKey = best.key
            end
            return best.key
        end

        return CFG.DungeonKey
    end

    -- ============================================================
    -- Auto Farm LVL: Progress through dungeons by DisplayOrder
    -- - Start from lowest available dungeon
    -- - On clear: advance to next dungeon
    -- - On fail: go back to last cleared dungeon
    -- ============================================================

    H.getSortedDungeons = function()
        if not H.DungeonData or not H.DungeonData.Dungeons then return {} end
        local pd = H.getPlayerData()
        local playerData = pd or { Data = {} }
        local list = {}
        for key, data in pairs(H.DungeonData.Dungeons) do
            if not data.Legacy and not data.ChallengeMode and not data.HideFromSelect then
                local canEnter = pcall(function()
                    if H.DungeonData.CanEnter then
                        return H.DungeonData.CanEnter(playerData, key)
                    end
                    return true
                end)
                if canEnter then
                    table.insert(list, { key = key, order = data.DisplayOrder or 0 })
                end
            end
        end
        table.sort(list, function(a, b) return a.order < b.order end)
        return list
    end

    H.getAutoFarmLVLNext = function()
        local sorted = H.getSortedDungeons()
        if #sorted == 0 then return CFG.DungeonKey end
        local current = P.AutoFarmLVL_Current
        local lastCleared = P.AutoFarmLVL_LastCleared
        if not current then
            -- Start from the highest enterable dungeon (latest available)
            -- so we don't waste time replaying early stages on fresh start
            local best = sorted[#sorted]
            P.AutoFarmLVL_Current = best.key
            log(("Auto Farm LVL: starting from latest available %s (order=%d)"):format(best.key, best.order))
            return best.key
        end
        local currentIdx = nil
        for i, d in ipairs(sorted) do
            if d.key == current then currentIdx = i; break end
        end
        if not currentIdx then
            -- Current dungeon no longer in list (locked/changed) -> use last cleared or highest
            if lastCleared then
                for i, d in ipairs(sorted) do
                    if d.key == lastCleared then currentIdx = i; break end
                end
            end
            if not currentIdx then currentIdx = #sorted end
            P.AutoFarmLVL_Current = sorted[currentIdx].key
            return sorted[currentIdx].key
        end
        if S.AutoFarmLVL_Failed and lastCleared then
            S.AutoFarmLVL_Failed = false
            P.AutoFarmLVL_Current = lastCleared
            log(("Auto Farm LVL: failed -> going back to %s"):format(lastCleared))
            return lastCleared
        end
        if S.AutoFarmLVL_Cleared then
            S.AutoFarmLVL_Cleared = false
            if currentIdx < #sorted then
                local nextD = sorted[currentIdx + 1]
                P.AutoFarmLVL_Current = nextD.key
                log(("Auto Farm LVL: cleared -> advancing to %s (order=%d)"):format(nextD.key, nextD.order))
                return nextD.key
            else
                log(("Auto Farm LVL: already at highest dungeon %s"):format(current))
                return current
            end
        end
        return current
    end

    H.startRun = function(mode)
        local isPartyLeader = CFG.PartyEnabled and CFG.PartyRole == "Leader" and H.getPartyMemberCount() >= 1
        if isPartyLeader then
            log("enterDungeon: Party Leader starting run with party -> RequestStartPodQueue")
            return call("DungeonQueueService", "RequestStartPodQueue")
        else
            log("enterDungeon: Solo starting run -> RequestStartSoloRun")
            return call("DungeonQueueService", "RequestStartSoloRun")
        end
    end

    H.enterDungeon = function()
        log("enterDungeon: called (Party=" .. tostring(CFG.PartyEnabled) .. " Role=" .. tostring(CFG.PartyRole) .. ")")
        -- Already in a dungeon? Skip selection, just warp to start
        if inRun() or LP:GetAttribute("InDungeon") then
            log("enterDungeon: already in dungeon -> warping to start")
            task.wait(0.5)
            local startPos = H.findDungeonStartPos()
            if startPos then H.warpTo(startPos) end
            return
        end
        -- Party Member mode: wait for leader to start the run
        if CFG.PartyEnabled and CFG.PartyRole == "Member" then
            log("[DEBUG Dungeon] Member mode - waiting for leader to start...")
            for i = 1, 360 do
                if not S.Running then return end
                if inRun() then
                    log("[DEBUG Dungeon] Member: entered dungeon via leader!")
                    task.wait(0.5)
                    -- Warp to dungeon start (Member too)
                    local startPos = H.findDungeonStartPos()
                    if startPos then
                        log(("Dungeon: Member warping to start at %.1f, %.1f, %.1f"):format(startPos.X, startPos.Y, startPos.Z))
                        H.warpTo(startPos)
                    end
                    return
                end
                if i > 1 and i % 20 == 0 then
                    log("[DEBUG Dungeon] Member: still waiting... (" .. math.floor(i * 0.5) .. "s)")
                end
                task.wait(0.5)
            end
            log("[DEBUG Dungeon] Member: timed out waiting for leader (180s)")
            return
        end
        -- Party Leader: wait for members then invite
        if CFG.PartyEnabled and CFG.PartyRole == "Leader" then
            log("enterDungeon: Leader mode - waiting for party members")
            H.waitForPartyMembers()
            -- Give member time to fully accept and sync
            print("[AutoFarm][DEBUG] Dungeon/Endless: waiting 3s for member to sync...")
            task.wait(3)
            -- Remember party members before entering dungeon (for re-invite after run)
            S._lastPartyMembers = {}
            if S.PartyData and S.PartyData.Members then
                for _, m in pairs(S.PartyData.Members) do
                    if m.UserId ~= LP.UserId then
                        local name = m.DisplayName or m.Name
                        if name then table.insert(S._lastPartyMembers, name) end
                    end
                end
            end
            S._reinvitedAfterDungeon = false  -- reset flag for next dungeon
            print("[AutoFarm][DEBUG] Dungeon: remembered party members: " .. table.concat(S._lastPartyMembers, ", "))
        end
        -- ถ้าเปิด AutoJoinBestStage -> เลือกดันเจี้ยนที่ดีที่สุดก่อน
        -- Endless mode: use EndlessDungeon + "Endless" difficulty
        if CFG.AutoFarmEndless then
            if not S.Running then return end
            local dKey = H.resolveDungeonKey(CFG.EndlessDungeon or "Bandits Den")
            print("[AutoFarm][DEBUG] Endless: entering", dKey)
            local sm_ok = call("DungeonQueueService", "RequestSelectMode", "Dungeon")
            print("[AutoFarm][DEBUG] Endless: RequestSelectMode ->", sm_ok)
            task.wait(0.1)
            if not S.Running then return end
            local sd_ok = call("DungeonQueueService", "RequestSelectDungeon", dKey)
            print("[AutoFarm][DEBUG] Endless: RequestSelectDungeon ->", sd_ok)
            task.wait(0.1)
            if not S.Running then return end
            local df_ok = call("DungeonQueueService", "RequestSelectDifficulty", "Endless")
            print("[AutoFarm][DEBUG] Endless: RequestSelectDifficulty ->", df_ok)
            task.wait(0.1)
            if not S.Running then return end
            local ok, res
            if H.startRun then
                print("[AutoFarm][DEBUG] Endless: calling H.startRun")
                ok, res = H.startRun("Dungeon")
            else
                print("[AutoFarm][DEBUG] Endless: using RequestStartSoloRun")
                ok, res = call("DungeonQueueService", "RequestStartSoloRun")
            end
            print("[AutoFarm][DEBUG] Endless: startRun -> ok=", tostring(ok), "res=", tostring(res))
            local entered = false
            for i = 1, 40 do
                if not S.Running then break end
                if inRun() then entered = true break end
                if LP:GetAttribute("InDungeon") then entered = true break end
                if i % 10 == 0 then
                    print("[AutoFarm][DEBUG] Endless: waiting...", i, "inRun=", tostring(inRun()), "InDungeon=", tostring(LP:GetAttribute("InDungeon")))
                end
                task.wait(0.5)
            end
            print("[AutoFarm][DEBUG] Endless: entered=", tostring(entered), "inRun=", tostring(inRun()))
            -- Warp to dungeon start
            if entered or inRun() then
                task.wait(0.5)
                local startPos = H.findDungeonStartPos()
                print("[AutoFarm][DEBUG] Endless: findDungeonStartPos ->", tostring(startPos))
                if startPos then
                    print("[AutoFarm][DEBUG] Endless: warping to", startPos.X, startPos.Y, startPos.Z)
                    H.warpTo(startPos)
                else
                    print("[AutoFarm][DEBUG] Endless: start position not found!")
                end
            else
                print("[AutoFarm][DEBUG] Endless: FAILED to enter!")
            end
            return
        end
        if CFG.AutoJoinBestStage and not S._wistoriaDungeonDrive then
            H.getBestDungeonKey()
        end
        -- Auto Farm LVL: use level-based recommendation (dungeon + difficulty)
        -- With difficulty fallback: if we failed a difficulty, drop to lower one
        local dKey, dDifficulty
        if S._wistoriaDungeonDrive then
            -- Wisteria material farm overrides dungeon + difficulty selection
            dKey = S._wistoriaDungeonDrive.key
            dDifficulty = S._wistoriaDungeonDrive.difficulty
        elseif CFG.AutoFarmLVL then
            local rec = H.getLevelRecommendation()
            if rec and rec.current then
                dKey = rec.current.key
                dDifficulty = rec.current.mode
                local failHist = CFG.AutoFarmLVL_History and CFG.AutoFarmLVL_History.Failed or {}
                local winHist  = CFG.AutoFarmLVL_History and CFG.AutoFarmLVL_History.Wins or {}
                local difficultyOrder = { "Easy", "Normal", "Hard", "Nightmare" }
                
                local startMode = dDifficulty
                local startRank = 1
                for i, m in ipairs(difficultyOrder) do
                    if m == startMode then startRank = i; break end
                end

                local targetDiff = startMode
                -- Find highest usable difficulty, or retry a failed one if lower has 10 wins
                for i = startRank, 1, -1 do
                    local mode = difficultyOrder[i]
                    local fk = dKey .. "_" .. mode
                    if failHist[fk] then
                        -- Failed. Can we retry? Check if lower difficulty has >= 10 wins.
                        if i > 1 then
                            local lowerMode = difficultyOrder[i-1]
                            local lowerFk = dKey .. "_" .. lowerMode
                            local lowerWins = winHist[lowerFk] or 0
                            if lowerWins >= 10 then
                                log(("Auto Farm LVL: %s reached 10 wins on %s! Retrying %s"):format(dKey, lowerMode, mode))
                                failHist[fk] = nil      -- Unblock the higher difficulty
                                winHist[lowerFk] = 0    -- Reset lower wins
                                H.scheduleSave()
                                targetDiff = mode
                                break
                            end
                        end
                        -- Cannot retry, continue down the loop to the next difficulty
                    else
                        -- Not failed, use it
                        targetDiff = mode
                        break
                    end
                end

                if targetDiff ~= startMode then
                    log(("Auto Farm LVL: %s/%s failed before -> dropping to %s"):format(dKey, startMode, targetDiff))
                end
                
                -- If even Easy is failed and cannot be retried -> drop to a LOWER dungeon
                if failHist[dKey .. "_" .. targetDiff] then
                    local failedDungeon = dKey
                    local picked = nil
                    local curIdx = nil
                    for idx, cand in ipairs(rec.candidates or {}) do
                        if cand == rec.current then curIdx = idx break end
                    end
                    for idx = (curIdx or 1) + 1, #(rec.candidates or {}) do
                        local cand = rec.candidates[idx]
                        -- skip same dungeon (all its modes failed) and failed combos
                        if cand.key ~= failedDungeon
                        and cand.min <= (rec.level or 0)
                        and not failHist[cand.key .. "_" .. cand.mode] then
                            picked = cand
                            break
                        end
                    end
                    if picked then
                        dKey = picked.key
                        dDifficulty = picked.mode
                        log(("Auto Farm LVL: all difficulties failed for %s -> dropping to %s/%s"):format(
                            failedDungeon, picked.key, picked.mode))
                    else
                        log(("Auto Farm LVL: all difficulties failed for %s, no lower option -> CFG fallback"):format(dKey))
                        dKey = CFG.DungeonKey
                        dDifficulty = CFG.Difficulty
                    end
                else
                    dDifficulty = targetDiff
                end
                S.AutoFarmLVL_CurrentDifficulty = dDifficulty
                S.AutoFarmLVL_LastDungeon = dKey
                log(("Auto Farm LVL: Lv %s -> %s / %s (Lv %d-%d) [dDifficulty=%s]"):format(
                    tostring(rec.level), dKey, dDifficulty, rec.current.min, rec.current.max, tostring(dDifficulty)))
                -- Update status label with current dungeon/mode
                if S.StatusLabel then
                    S.StatusLabel:SetText(("Status: %s / %s (Lv %s)"):format(dKey, dDifficulty, tostring(rec.level)))
                    if S.updateRealtimeStatus then S.updateRealtimeStatus(dKey .. " / " .. dDifficulty .. " (Lv " .. tostring(rec.level) .. ")") end
                end
            else
                log("Auto Farm LVL: no recommendation available, falling back to " .. tostring(CFG.DungeonKey))
                dKey = CFG.DungeonKey
                dDifficulty = CFG.Difficulty
            end
        elseif CFG.AutoNextDungeon then
            dKey = H.getAutoFarmLVLNext()
            dDifficulty = CFG.Difficulty
        else
            dKey = H.currentDungeonKey()
            dDifficulty = CFG.Difficulty
        end
        -- Normalize: saved config or dropdown may hold a DisplayName (e.g.
        -- "Goblin's Stronghold") but the server expects the internal key.
        dKey = H.resolveDungeonKey(dKey)
        if not S.Running then return end
        log("lobby -> select mode Dungeon")
        local sm_ok, sm_res = call("DungeonQueueService", "RequestSelectMode", "Dungeon")
        print("[AutoFarm][DEBUG] RequestSelectMode ->", sm_ok, sm_res)
        task.wait(0.3)
        if not S.Running then return end
        log("select dungeon " .. tostring(dKey))
        local sd_ok, sd_res = call("DungeonQueueService", "RequestSelectDungeon", dKey)
        print("[AutoFarm][DEBUG] RequestSelectDungeon ->", sd_ok, sd_res)
        task.wait(0.3)
        if not S.Running then return end
        local diffToUse = dDifficulty or CFG.Difficulty
        log("select difficulty " .. tostring(diffToUse) .. " (dDifficulty=" .. tostring(dDifficulty) .. ", CFG.Difficulty=" .. tostring(CFG.Difficulty) .. ")")
        local df_ok, df_res = call("DungeonQueueService", "RequestSelectDifficulty", diffToUse)
        print("[AutoFarm][DEBUG] RequestSelectDifficulty ->", df_ok, df_res)
        task.wait(0.5)
        if not S.Running then return end
        local ok, res
        if H.startRun then
            print("[AutoFarm][DEBUG] enterDungeon: calling H.startRun")
            ok, res = H.startRun("Dungeon")
        else
            print("[AutoFarm][DEBUG] enterDungeon: H.startRun not found - using RequestStartSoloRun directly")
            ok, res = call("DungeonQueueService", "RequestStartSoloRun")
        end
        print("[AutoFarm][DEBUG] startRun -> ok=", tostring(ok), "res=", tostring(res))
        -- Wait for teleport/load
        local entered = false
        for _ = 1, 40 do
            if not S.Running then break end
            if inRun() then entered = true break end
            -- Check InDungeon attribute too
            if LP:GetAttribute("InDungeon") then entered = true break end
            task.wait(0.5)
        end
        print("[AutoFarm][DEBUG] after wait: entered=", tostring(entered), "inRun=", tostring(inRun()), "InDungeon=", tostring(LP:GetAttribute("InDungeon")))
        -- If not entered and party mode, try RequestEnter (like Raid)
        -- Fallback for both solo and party: warp onto a pod then RequestEnter
        if not entered then
            print("[AutoFarm][DEBUG] Dungeon: didn't enter - warping to pod + RequestEnter...")
            local podPos = H.findPodPosition("Dungeon")
            if podPos then H.warpToPod(podPos) end
            local ok2, res2 = call("DungeonQueueService", "RequestEnter")
            print("[AutoFarm][DEBUG] Dungeon: RequestEnter -> ok=", tostring(ok2), "res=", tostring(res2))
            for _ = 1, 40 do
                if not S.Running then break end
                if inRun() or LP:GetAttribute("InDungeon") then entered = true break end
                task.wait(0.5)
            end
            print("[AutoFarm][DEBUG] after RequestEnter: entered=", tostring(entered), "inRun=", tostring(inRun()))
            -- Solo last resort: retry SoloRun now that we stand on the pod
            if not entered and not CFG.PartyEnabled then
                local ok3, res3 = call("DungeonQueueService", "RequestStartSoloRun")
                print("[AutoFarm][DEBUG] Dungeon: SoloRun retry on pod -> ok=", tostring(ok3), "res=", tostring(res3))
                for _ = 1, 40 do
                    if not S.Running then break end
                    if inRun() or LP:GetAttribute("InDungeon") then entered = true break end
                    task.wait(0.5)
                end
                print("[AutoFarm][DEBUG] after SoloRun retry: entered=", tostring(entered))
            end
        end
        print("[AutoFarm][DEBUG] Dungeon: entered=", tostring(entered), "inRun=", tostring(inRun()), "InDungeon=", tostring(LP:GetAttribute("InDungeon")))
        -- Warp to dungeon start (like Raid does)
        if entered or inRun() then
            print("[AutoFarm][DEBUG] Dungeon: entered - waiting for map to load...")
            task.wait(0.5)
            local startPos = H.findDungeonStartPos()
            print("[AutoFarm][DEBUG] Dungeon: findDungeonStartPos ->", tostring(startPos))
            if startPos then
                print("[AutoFarm][DEBUG] Dungeon: warping to start at", startPos.X, startPos.Y, startPos.Z)
                H.warpTo(startPos)
            else
                print("[AutoFarm][DEBUG] Dungeon: start position not found - will wait for farmLoop")
            end
        else
            print("[AutoFarm][DEBUG] Dungeon: failed to enter - ok=", tostring(ok), "res=", tostring(res))
        end
    end

    -- Record a failed LVL run into CFG.AutoFarmLVL_History (persisted via config).
    -- Called from finishRun, stall watchdog, and mainLoop run-ended path.
    function H.noteLVLFail(reason)
        if not (CFG.AutoFarmLVL or CFG.AutoNextDungeon) then return end
        if S._lvlFailRecorded then return end  -- count once per run
        S._lvlFailRecorded = true
        S.AutoFarmLVL_Failed = true
        S.AutoFarmLVL_Cleared = false
        local dk = S.AutoFarmLVL_LastDungeon
        local diff = S.AutoFarmLVL_CurrentDifficulty
        if dk and diff then
            local failKey = dk .. "_" .. diff
            CFG.AutoFarmLVL_History = CFG.AutoFarmLVL_History or { Failed = {}, Wins = {} }
            CFG.AutoFarmLVL_History.Failed = CFG.AutoFarmLVL_History.Failed or {}
            CFG.AutoFarmLVL_History.Failed[failKey] = true
            CFG.AutoFarmLVL_History.Wins = CFG.AutoFarmLVL_History.Wins or {}
            CFG.AutoFarmLVL_History.Wins[failKey] = 0
            S.AutoFarmLVL_FailCount = (S.AutoFarmLVL_FailCount or 0) + 1
            H.scheduleSave()
            log(("Auto Farm LVL: FAILED %s/%s (%s, fail #%d) -> will drop"):format(dk, diff, tostring(reason or "?"), S.AutoFarmLVL_FailCount))
        end
    end

    H.finishRun = function()
        log("boss defeated - run finished!")
        H.unanchorPlayer()
        H.hideCircle()

        -- 0. collect Key drops around boss (priority!)
        if CFG.AutoKeyCollect then
            pcall(H.collectAllKeyDrops)
        end

        -- 1. collect floor drops around boss
        pcall(function()
            local r = hrp()
            local pos = r and r.Position
            H.collectFloorDrops(pos, 60)
        end)

        -- Mark ALL rooms as cleared so collectAllDungeonChests will sweep everything
        local rooms = H.orderedRooms()
        for _, rm in ipairs(rooms) do
            S.Cleared[rm.Model] = true
            S.RoomStatus[rm.Model] = "cleared"
        end
        syncToPersistent()
        log("Marked all rooms cleared - sweeping chests across entire dungeon")

        -- 2. sweep ALL chests in dungeon (all rooms now marked cleared)
        H.collectAllDungeonChests()

        -- 3. collect floor drops again (chests may have spawned drops)
        pcall(function()
            local r = hrp()
            local pos = r and r.Position
            H.collectFloorDrops(pos, 60)
        end)

        -- 4. handle ChestSelection GUI (pick 2 chests)
        H.handleChestSelection()

        -- wait for chest opening and completion
        task.wait(3.0)
        if not S.Running then return end

        local status = S.Complete and S.Complete.Status
        log(("finishRun: S.Complete=%s, status=%s, LastDungeon=%s, CurrentDifficulty=%s"):format(
            tostring(S.Complete), tostring(status),
            tostring(S.AutoFarmLVL_LastDungeon), tostring(S.AutoFarmLVL_CurrentDifficulty)))

        -- If status is nil but we're in Auto Farm LVL, treat as cleared (boss was defeated)
        if not status and CFG.AutoFarmLVL then
            status = "Cleared"
            log("finishRun: status was nil -> assuming Cleared (boss defeated)")
        end

        -- Auto Farm LVL / Auto Next Dungeon: track clear/fail
        if CFG.AutoFarmLVL or CFG.AutoNextDungeon then
            if status == "Failed" then
                H.noteLVLFail("DungeonComplete")
                log(("Auto Farm LVL: run FAILED in %s -> will go back to last cleared"):format(
                    P.AutoFarmLVL_Current or CFG.DungeonKey))
            else
                S.AutoFarmLVL_Cleared = true
                S.AutoFarmLVL_Failed = false
                S.AutoFarmLVL_FailCount = 0
                -- Update win count for this difficulty
                if S.AutoFarmLVL_LastDungeon and S.AutoFarmLVL_CurrentDifficulty then
                    local clearKey = S.AutoFarmLVL_LastDungeon .. "_" .. S.AutoFarmLVL_CurrentDifficulty
                    if CFG.AutoFarmLVL_History and CFG.AutoFarmLVL_History.Wins then
                        CFG.AutoFarmLVL_History.Wins[clearKey] = (CFG.AutoFarmLVL_History.Wins[clearKey] or 0) + 1
                        H.scheduleSave()
                        log(("Auto Farm LVL: CLEARED %s (Win Count: %d)"):format(clearKey, CFG.AutoFarmLVL_History.Wins[clearKey]))
                    end
                end
                P.AutoFarmLVL_LastCleared = P.AutoFarmLVL_Current or CFG.DungeonKey
                log(("Auto Farm LVL: run CLEARED in %s -> will advance to next"):format(
                    P.AutoFarmLVL_Current or CFG.DungeonKey))
            end
        end

        -- Endless mode: replay to continue (not return to lobby)
        if CFG.AutoFarmEndless then
            log("Endless: replaying to continue")
            call("DungeonRunService", "RequestReplay")
        -- Auto Farm LVL: failed -> return to lobby to retry with lower difficulty
        elseif CFG.AutoFarmLVL and status == "Failed" then
            log("Auto Farm LVL: FAILED -> returning to lobby to retry with lower difficulty")
            call("DungeonRunService", "RequestReturn")
        -- Auto Farm LVL: cleared -> ออก lobby ทุกครั้ง (เพื่อขาย/อัปสเตต/ใส่ equip)
        elseif CFG.AutoFarmLVL and status ~= "Failed" then
            log("Auto Farm LVL: CLEARED -> returning to lobby (sell/equip/upgrade)")
            call("DungeonRunService", "RequestReturn")
        elseif CFG.AutoNextDungeon and status ~= "Failed" then
            log("Auto Next Dungeon: returning to lobby for next dungeon")
            call("DungeonRunService", "RequestReturn")
        elseif CFG.AutoReplay and status ~= "Failed" then
            log("Replay")
            call("DungeonRunService", "RequestReplay")
        elseif CFG.AutoReturnLobby then
            log("Return to lobby")
            call("DungeonRunService", "RequestReturn")
        end

        -- เธฃเธญเธเธ dungeon folder เน€เธ”เธดเธกเธซเธฒเธข (replay เธเธฐ regenerate / return เธญเธญเธ lobby)
        local old = H.dungeonFolder()
        for _ = 1, 60 do
            if not S.Running then break end
            local cur = H.dungeonFolder()
            if cur ~= old then break end
            task.wait(0.5)
        end
        -- Clear persistent cleared rooms so next run starts fresh (prevent resume bug)
        P.ClearedRooms = {}
        P.LootedChests = {}
        H.resetRunState(false)
        task.wait(2)
    end

    -- โ”€โ”€ Boss-Stage Room Audit: เธ•เธฃเธงเธเธชเธญเธเธซเนเธญเธเธ—เธตเนเธ•เธเธเนเธฒเธเธเนเธญเธเน€เธเนเธฒเธเธญเธช โ”€โ”€
    -- เธชเนเธเธ RoomStatus เธ—เธธเธเธซเนเธญเธ -> เธซเธฒเธซเนเธญเธเธ—เธตเนเธขเธฑเธเนเธกเนเน€เธเธฅเธตเธขเธฃเน -> เธงเธฒเธฃเนเธเธ•เธฃเธเนเธเธเธฑเธ”เธเธฒเธฃเธ—เธฑเธเธ—เธต
    -- เธเธทเธ true เธ–เนเธฒเธ—เธธเธเธซเนเธญเธเน€เธเธฅเธตเธขเธฃเนเนเธฅเนเธง, false เธ–เนเธฒเธขเธฑเธเธกเธตเธซเนเธญเธเธ•เธเธเนเธฒเธ
    H.auditUnclearedRooms = function(rooms)
        local uncleared = {}
        for _, rm in ipairs(rooms) do
            if not rm.IsBoss then
                local status = S.RoomStatus[rm.Model] or "pending"
                if status ~= "cleared" then
                    table.insert(uncleared, rm)
                end
            end
        end

        if #uncleared == 0 then
            log("Room Audit: all rooms cleared โ“")
            S.RoomAuditDone = true
            return true
        end

        log(("Room Audit: %d uncleared rooms found -> direct teleport"):format(#uncleared))
        for _, rm in ipairs(uncleared) do
            log(("  -> %s (Index=%d, status=%s)"):format(
                rm.Model.Name, rm.Index, S.RoomStatus[rm.Model] or "pending"))
        end

        -- เธงเธฒเธฃเนเธเธ•เธฃเธเนเธเธซเนเธญเธเธ—เธตเนเธ•เธเธเนเธฒเธเธ—เธฑเธเธ—เธต (เน€เธฃเธตเธขเธเธ•เธฒเธก Index)
        table.sort(uncleared, function(a, b) return a.Index < b.Index end)

        for _, rm in ipairs(uncleared) do
            if not S.Running or not inRun() then return false end

            log(("Direct teleport to uncleared room: %s"):format(rm.Model.Name))
            S.RoomStatus[rm.Model] = "in_progress"
            S.ProbeRoom = rm.Model
            S.ProbeTick = tick()
            S.VisitedRooms[rm.Model] = (S.VisitedRooms[rm.Model] or 0) + 1

            -- StreamAround + เธงเธฒเธฃเนเธเธ•เธฃเธเนเธเธซเนเธญเธเธเธฑเนเธ
            pcall(function() LP:RequestStreamAroundAsync(rm.Pos) end)
            task.wait(0.5)
            stopHoverLock()
            H.warpTo(rm.Pos + Vector3.new(0, 4, 0))
            task.wait(1.0)  -- เธฃเธญเธกเธญเธเธชเธ•เธฃเธตเธก

            -- เธ•เธฃเธงเธเธซเธฒเธกเธญเธเนเธเธซเนเธญเธเธเธตเน
            local roomEnemies = H.liveEnemies(rooms)
            local foundEnemies = false
            for _, e in ipairs(roomEnemies) do
                if e.Room == rm and isAlive(e.Model) then
                    foundEnemies = true
                    break
                end
            end

            if foundEnemies then
                -- เธกเธตเธกเธญเธ -> เธเธฒเธฃเนเธกเธเธเธเธงเนเธฒเธซเนเธญเธเธเธฐเธงเนเธฒเธ
                log(("Found enemies in %s โ€” farming..."):format(rm.Model.Name))
                local farmStart = tick()
                while S.Running and inRun() and (tick() - farmStart) < 60 do
                    local stillEnemies = false
                    local curEnemies = H.liveEnemies(rooms)
                    for _, e in ipairs(curEnemies) do
                        if e.Room == rm and isAlive(e.Model) then
                            stillEnemies = true
                            S.Target = e
                            S.ProgressTick = tick()
                            if not S.ChestBusy and not S.TelegraphDodgeActive then attack(e) end
                            task.wait(H.combatJitter(CFG.AttackInterval))
                            break
                        end
                    end
                    if not stillEnemies then
                        break
                    end
                end
                S.RoomStatus[rm.Model] = "cleared"
                S.Cleared[rm.Model] = true
                syncToPersistent()
                log(("Room %s cleared โ“"):format(rm.Model.Name))
            else
                -- เนเธกเนเธกเธตเธกเธญเธ -> เธ–เธทเธญเธงเนเธฒเน€เธเธฅเธตเธขเธฃเน (เธญเธฒเธเธชเธเธญเธงเนเธเธเนเธฒเธซเธฃเธทเธญเน€เธเธดเธฃเนเธเน€เธงเธญเธฃเนเน€เธเธฅเธตเธขเธฃเนเนเธซเน)
                S.RoomStatus[rm.Model] = "cleared"
                S.Cleared[rm.Model] = true
                S.RoomStuckCount[rm.Model] = (S.RoomStuckCount[rm.Model] or 0) + 1
                syncToPersistent()
                log(("Room %s no enemies -> marked cleared"):format(rm.Model.Name))
            end
        end

        -- เธ•เธฃเธงเธเธญเธตเธเธเธฃเธฑเนเธเธงเนเธฒเธ—เธธเธเธซเนเธญเธเน€เธเธฅเธตเธขเธฃเนเนเธฅเนเธง
        local stillUncleared = 0
        for _, rm in ipairs(rooms) do
            if not rm.IsBoss and (S.RoomStatus[rm.Model] or "pending") ~= "cleared" then
                stillUncleared = stillUncleared + 1
            end
        end

        if stillUncleared == 0 then
            S.RoomAuditDone = true
            log("Room Audit complete โ€” all rooms cleared โ“")
            return true
        end

        log(("Room Audit: %d rooms still uncleared after audit"):format(stillUncleared))
        return false
    end

    -- เธฅเธนเธเธเธฒเธฃเนเธกเนเธเธ”เธฑเธเน€เธเธตเนเธขเธ: เธงเธฒเธฃเนเธเน€เธเธเธฒเธฐเธซเนเธญเธเธ—เธตเนเธกเธตเธกเธญเธเธชเน€เธ•เธญเธฃเนเธญเธขเธนเนเธเธฃเธดเธ -> เธเธญเธช -> เน€เธเนเธเธเธฅเนเธญเธเธ—เธธเธเธซเนเธญเธ -> เธเธ
    H.farmLoop = function()
        log("in run โ€” farming")

        -- reset debug flag เน€เธเธทเนเธญ print เธฃเธฒเธขเธเธฒเธฃ drop เธ—เธฑเนเธเธซเธกเธ”เนเธเธฃเธญเธเนเธซเธกเน
        scanDebugDone = false

        -- โ”€โ”€ เน€เธฃเธดเนเธก Key Watcher: เธชเนเธเธเธซเธฒ key เนเธเธเน€เธฃเธตเธขเธฅเนเธ—เธกเนเธ•เธฅเธญเธ”เธเธฒเธฃเธเธฒเธฃเนเธก โ”€โ”€
        H.startKeyWatcher()

        -- โ”€โ”€ เน€เธฃเธดเนเธก Potion Watcher: เธ•เธฃเธงเธ HP เนเธเธเน€เธฃเธตเธขเธฅเนเธ—เธกเนเธ•เธฅเธญเธ”เธเธฒเธฃเธเธฒเธฃเนเธก โ”€โ”€
        H.startPotionWatcher()

        -- โ”€โ”€ เน€เธฃเธดเนเธก Parry Watcher: เธ•เธฃเธงเธเธเธฑเธเธกเธญเธเธเธฐเธ•เธต -> เธเธฒเธฃเนเธฃเธตเน/เธซเธฅเธ โ”€โ”€
        H.startParryWatcher()

        -- Boss Dodge Scanner: start if enabled
        if CFG.AutoBossDodge then startBossDodgeScanner() end
        startTelegraphDodgeScanner()

        -- —— รอให้ Dungeon โหลดเสร็จก่อน (ต้องมีส่วนประกอบอย่างน้อย 5 อย่างขึ้นไป) ——
        local dfLoad = H.dungeonFolder()
        local waitedLoad = 0
        while dfLoad and #dfLoad:GetChildren() < 5 and waitedLoad < 10 and S.Running and inRun() do
            task.wait(1)
            waitedLoad = waitedLoad + 1
        end

        -- Note: Blessing Altar early-warp has been removed to allow legit room-by-room clearing.
        -- It will now only grab the blessing after clearing the room it spawns in.

        local lastRoomLogged = nil

        -- Wait for dungeon to be ready before farming (InDungeon fallback)
        local waitStart = tick()
        while S.Running and not inRun() and (tick() - waitStart) < 15 do
            if LP:GetAttribute("InDungeon") then
                -- InDungeon is set but Generated_* not yet loaded - wait a bit more
                task.wait(0.5)
            else
                task.wait(0.5)
            end
        end

        while S.Running and (inRun() or LP:GetAttribute("InDungeon")) do
            -- If generation changed, a newer loop was started - abort this one
            if S.LoopGen ~= (S.CurrentLoopGen or 0) then
                log("farmLoop: newer generation detected - aborting stale loop")
                return "aborted"
            end
            -- Wait for respawn (prevent warp-to-mob bug after death)
            if S.Respawning then
                task.wait(0.5)
            end
            if not S.Respawning then
            -- เธเธเนเธฅเนเธง?
            if S.Complete then H.flushPendingKeys(); H.stopParryWatcher(); H.stopPotionWatcher(); H.stopKeyWatcher(); cleanupBossTracking(); return "complete" end
            if S.Phase == "Complete" or S.Phase == "Failed" then
                S.Complete = S.Complete or { Status = S.Phase == "Failed" and "Failed" or "Cleared" }
                H.flushPendingKeys()
                H.stopParryWatcher(); H.stopPotionWatcher(); H.stopKeyWatcher()
                cleanupBossTracking()
                return "complete"
            end

            if isDead() then
                task.wait(0.5)
            elseif S.EndlessBusy then
                task.wait(0.5)
            else
                -- Anti-fall: detect if player fell below map and warp back
                local rPre = hrp()
                if rPre and rPre.Position.Y < -50 then
                    log(("Anti-fall: Y=%.1f -> warping back"):format(rPre.Position.Y))
                    S.ProgressTick = tick()
                    local roomsAF = H.orderedRooms()
                    local safePos = nil
                    for _, rm in ipairs(roomsAF) do
                        if not S.Cleared[rm.Model] then
                            safePos = rm.Pos + Vector3.new(0, 5, 0)
                            break
                        end
                    end
                    if not safePos and #roomsAF > 0 then
                        safePos = roomsAF[1].Pos + Vector3.new(0, 5, 0)
                    end
                    if safePos then
                        stopHoverLock()
                        H.warpTo(safePos)
                        task.wait(0.5)
                    else
                        call("DungeonRunService", "RequestReturn")
                        task.wait(3)
                    end
                end
                local rooms = H.orderedRooms()
                local enemies = H.liveEnemies(rooms)
                local r = hrp()

                -- Summary log every 10s (reduced from 3s to avoid spam)
                if (tick() - (S.DbgTick or 0)) > 10 then
                    S.DbgTick = tick()
                    local uc = H.getUnclearedNormalRooms(rooms)
                    local ucNames = {}
                    for _, rm in ipairs(uc) do ucNames[#ucNames+1] = tostring(rm.Index) end
                    print(("[AutoFarm] Dungeon| rooms=%d live=%d room=%s/%s phase=%s target=%s uncleared=[%s] probe=%s"):format(
                        #rooms, #enemies,
                        tostring(S.RoomIdx), tostring(S.TotalRooms), tostring(S.Phase),
                        S.Target and S.Target.Model and S.Target.Model.Name or "none",
                        table.concat(ucNames, ","),
                        tostring(S.ProbeRoom and S.ProbeRoom.Name)))
                end

                if r and #rooms > 0 then
                    -- 1. เธเธฑเธ”เนเธขเธเธจเธฑเธ•เธฃเธน: เธเธญเธช (เนเธเธซเนเธญเธเธเธญเธช) vs เธกเธญเธเธชเน€เธ•เธญเธฃเนเธเธฃเธฃเธกเธ”เธฒ (เนเธเธซเนเธญเธเธเธฃเธฃเธกเธ”เธฒ)
                    local normalEnemies = {}
                    local boss = nil
                    for _, e in ipairs(enemies) do
                        if (e.Room and e.Room.IsBoss) or (e.IsBoss and (not e.Room or e.Room.IsBoss)) then
                            boss = e
                        else
                            table.insert(normalEnemies, e)
                        end
                    end

                    -- เธ•เธฃเธงเธเธชเธญเธเธงเนเธฒเธขเธฑเธเธกเธตเธซเนเธญเธเธเธฃเธฃเธกเธ”เธฒเธ—เธตเนเธขเธฑเธเนเธกเนเน€เธเธฅเธตเธขเธฃเนเธซเธฃเธทเธญเนเธกเน
                    local uncleared = H.getUnclearedNormalRooms(rooms)
                    local phaseIsBoss = (S.Phase == "BossPhase" or S.Phase == "Boss" or S.Phase == "BossWarp")
                    -- Go to boss if: phase is boss, OR a live boss already spawned
                    -- (don't sweep other rooms while a boss is standing there),
                    -- OR no normal enemies left AND no uncleared rooms left
                    local bossSpawned = boss and boss.Root and boss.Root.Parent and isAlive(boss.Model)
                    local onlyBossLeft = phaseIsBoss or bossSpawned or (#normalEnemies == 0 and #uncleared == 0)
                    -- Sequential sweep: an earlier room that was never entered must be visited FIRST,
                    -- even if later rooms already have spawned mobs (mobs only spawn after entering).
                    table.sort(uncleared, function(a, b) return a.Index < b.Index end)
                    local pendingRoom = nil
                    if not onlyBossLeft then
                        local lowestEnemyRoomIdx = math.huge
                        for _, e in ipairs(normalEnemies) do
                            local ix = (e.Room and e.Room.Index) or 999
                            if ix < lowestEnemyRoomIdx then lowestEnemyRoomIdx = ix end
                        end
                        for _, rm in ipairs(uncleared) do
                            if (S.VisitedRooms[rm.Model] or 0) == 0 and rm.Index < lowestEnemyRoomIdx then
                                pendingRoom = rm
                                break
                            end
                        end
                    end

                    -- โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€
                    -- เธเธฃเธ“เธตเธ—เธตเน 1: เธซเนเธญเธเธเธฃเธฃเธกเธ”เธฒเน€เธเธฅเธตเธขเธฃเนเธเธฃเธ 100% เนเธฅเนเธง -> เธเธธเนเธเนเธเธ•เธตเธเธญเธชเธเธเธ”เนเธฒเธเธ—เธฑเธเธ—เธตเนเธฅเธฐเนเธงเธ—เธตเนเธชเธธเธ”!
                    -- เนเธกเนเธกเธตเธเธฒเธฃเนเธงเธฐเธซเนเธญเธเธงเนเธฒเธ เนเธกเนเธกเธตเธเธฒเธฃเน€เธชเธตเธขเน€เธงเธฅเธฒเนเธกเนเนเธ•เนเธงเธดเธเธฒเธ—เธตเน€เธ”เธตเธขเธง!
                    -- โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€
                    -- เธเธญเธชเธกเธตเธเธตเธงเธดเธ•เนเธฅเธฐเธ•เธตเนเธ”เน -> เธ•เธตเน€เธฅเธขเธ—เธฑเธเธ—เธต เนเธกเนเธ•เนเธญเธเนเธฅเนเน€เธเนเธเธซเนเธญเธเธญเธฐเนเธฃเธญเธตเธ (เนเธกเนเธชเธเธงเนเธฒ S.Cleared เธเธฃเธเนเธซเธก)
                    if onlyBossLeft then
                        H.hideCircle()

                        -- Skip room audit: go straight to boss room (no checking after farming)
                        S.RoomAuditDone = true

                        -- If boss already spawned and alive -> attack it NOW.
                        -- (Before this, the branch only waited -> stood next to boss forever)
                        if boss and boss.Root and boss.Root.Parent and isAlive(boss.Model) then
                            S.BossWaitTick = nil
                            S.BossWaitTotal = nil
                            S.ProgressTick = tick()
                            S.Target = boss
                            if not S.ChestBusy and not S.TelegraphDodgeActive then attack(boss) end
                            task.wait(H.combatJitter(CFG.AttackInterval))
                        else
                        S.BossWaitTotal = S.BossWaitTotal or tick()
                        -- while waiting at the boss room, sweep for unused altars (dedicated
                        -- altar rooms are not part of the normal room list)
                        if (tick() - (S._altarScanTick or 0)) > 4 then
                            S._altarScanTick = tick()
                            H.useAltarsNear(nil, math.huge, "boss-wait")
                        end

                        -- Timeout: only re-audit after a LONG wait (boss can take 10-15s to spawn).
                        -- Short timeouts caused the "clear -> boss room -> re-check every room" ping-pong.
                        local bossWaitThreshold = 20
                        if S.BossWaitTick and (tick() - S.BossWaitTick) > bossWaitThreshold and not phaseIsBoss then
                            if not S.ForceAudited then
                                log("Boss not spawned after 20s -> resetting all normal rooms to re-audit!")
                                S.BossWaitTick = nil
                                S.ProbeRoom = nil
                                S.RoomAuditDone = false
                                S.LockedTarget = nil
                                S.ForceAudited = true -- Prevent infinite audit loops
                                -- Force all normal rooms to be uncleared so we revisit them
                                for _, rm in ipairs(rooms) do
                                    if not rm.IsBoss then
                                        S.Cleared[rm.Model] = false
                                        S.RoomStuckCount[rm.Model] = 0
                                    end
                                end
                                syncToPersistent()
                            else
                                log("Boss not spawned, but already force-audited once. Waiting patiently...")
                                S.BossWaitTick = tick() -- Reset tick to wait again without warping
                            end
                            task.wait(0.3)
                        elseif S.RoomAuditDone then
                            -- Keep ProgressTick alive while waiting for boss - but ONLY for first 30s.
                            -- After that, let the stall watchdog fire (MobStuckReturn / reset) so we never wait forever.
                            if (tick() - (S.BossWaitTotal or tick())) < 30 then
                                S.ProgressTick = tick()
                            end
                            -- ── Boss-First Check: วาร์ปไปห้องบอส ──
                            for _, rm in ipairs(rooms) do
                                if rm.IsBoss then
                                    local sp = rm.Model:FindFirstChild("Spawns", true)
                                    local bs = sp and sp:FindFirstChild("Boss_Spawn")
                                    local bossTarget = (bs and bs.Position or rm.Pos) + Vector3.new(0, 4, 0)
                                    
                                    local pPos = hrp() and hrp().Position
                                    -- Relax distance check to 150 to avoid fighting normal hover/falling movements
                                    local needsWarp = (S.ProbeRoom ~= rm.Model) or (pPos and (pPos - bossTarget).Magnitude > 150)
                                    
                                    if needsWarp then
                                        -- ── Final Check: Blessing Altar (Endless Only) ──
                                        if S.EndlessMode and S.Running and inRun() then
                                            H.useAltarsNear(nil, math.huge, "endless")
                                        end

                                        S.ProbeRoom = rm.Model
                                        S.ProbeTick = tick()
                                        S.BossWaitTick = S.BossWaitTick or tick()
                                        
                                        -- รอแมพห้องบอสโหลด
                                        pcall(function() LP:RequestStreamAroundAsync(rm.Pos) end)
                                        task.wait(1.0)
                                        
                                        local bossLoaded = rm.Model:FindFirstChild("Zone", true)
                                            or rm.Model:FindFirstChild("Spawns", true)
                                        if not bossLoaded then
                                            log("Boss room not loaded yet — waiting for stream...")
                                            task.wait(2.0)
                                            pcall(function() LP:RequestStreamAroundAsync(rm.Pos) end)
                                        end
                                        
                                        stopHoverLock()
                                        H.warpTo(bossTarget)
                                        log("Boss-First Check -> warped to boss room / corrected position, waiting for boss...")
                                    end
                                    break
                                end
                            end
                        end
                        task.wait(0.3)
                        end
                        elseif #normalEnemies > 0 then
                            -- case 2: live normal enemies -> pick target and attack
                            table.sort(normalEnemies, function(a, b)
                                -- boss-class enemies first (a boss out of its room still counts)
                                if a.IsBoss ~= b.IsBoss then return a.IsBoss end
                                local idxA = (a.Room and a.Room.Index) or 999
                                local idxB = (b.Room and b.Room.Index) or 999
                                if idxA ~= idxB then return idxA < idxB end
                                if a.Root and b.Root and r then
                                    return (a.Root.Position - r.Position).Magnitude < (b.Root.Position - r.Position).Magnitude
                                end
                                return false
                            end)
                            local cur = normalEnemies[1]
                            if S.LockedTarget and S.LockedTarget.Model and S.LockedTarget.Model.Parent and isAlive(S.LockedTarget.Model) then
                                cur = S.LockedTarget
                            else
                                S.LockedTarget = cur
                            end
                        local targetRoom = cur.Room

                        -- เข้าห้องใหม่ -> อัปเดตห้องและสตรีมรอบมอนสเตอร์ทันที (ข้ามห้องว่างทั้งหมด!)
                        if targetRoom and S.ProbeRoom ~= targetRoom.Model then
                            S.ProbeRoom, S.ProbeTick = targetRoom.Model, tick()
                            log(("Warping to room %s (mobs: %d)"):format(targetRoom.Model.Name, #normalEnemies))
                            pcall(function() LP:RequestStreamAroundAsync(targetRoom.Pos) end)
                            stopHoverLock()
                            H.warpTo(targetRoom.Pos + Vector3.new(0, 4, 0))
                            task.wait(0.3)
                            
                            -- Check Blessing Altar in this room BEFORE fighting mobs
                            if S.Running and inRun() then
                                local rBA = hrp()
                                local myPosBA = rBA and rBA.Position
                                H.useAltarsNear(myPosBA or targetRoom.Pos, 200, "in-room")
                            end

                        end
                        if targetRoom and CFG.ShowCircle then H.showCircle(targetRoom.Pos, CFG.AttackCircle) end

                        -- ล็อกเป้าและพุ่งไปตีมอนสเตอร์ตัวนี้ทันที
                        S.ProgressTick = tick()
                        S.Target = cur
                        if not S.ChestBusy and not S.TelegraphDodgeActive then attack(cur) end
                        -- (Key collection ทำโดย keyWatcher แบบเรียลไทม์ — ไม่ต้องเช็คที่นี่)

                        -- ถ้ามอนสเตอร์ในห้องนี้ตายหมด ให้บันทึกว่าเคลียร์ห้องนี้แล้ว
                        if targetRoom and not isAlive(cur.Model) then
                            S.LockedTarget = nil  -- reset locked target (dead)
                            local remainingInRoom = 0
                            for _, ne in ipairs(normalEnemies) do
                                if ne.Room == targetRoom and ne.Model ~= cur.Model and isAlive(ne.Model) then
                                    remainingInRoom = remainingInRoom + 1
                                end
                            end
                            if remainingInRoom == 0 then
                                S.Cleared[targetRoom.Model] = true
                                S.RoomStatus[targetRoom.Model] = "cleared"
                                syncToPersistent()
                                log(("Room %s cleared -> collecting chests"):format(targetRoom.Model.Name))
                                -- Collect chests in this room (no cross-room warp)
                                H.collectChestsInRoom(targetRoom.Model)
                                -- Check Blessing Altar nearby (if not done yet)
                                local r2 = hrp()
                                local myPos2 = r2 and r2.Position
                                if myPos2 then H.useAltarsNear(myPos2, 80, "after-clear") end

                            end
                        end
                        task.wait(H.combatJitter(CFG.AttackInterval))

                    -- โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€
                    -- กรณีที่ 3: ยังมีห้องธรรมดาที่ยังไม่เคลียร์ (uncleared) แต่มอนยังไม่สตรีมเข้ามา
                    -- วาร์ปตรงไปที่ห้องถัดไปตามลำดับทันที เพื่อให้มอนสเตอร์ในห้องนั้นโหลดออกมา
                    -- ──────────────────────────────────────────────────────────────────────────────────
                    else
                        -- Pass-through sweep: snap THROUGH each uncleared room quickly so its
                        -- spawn zone triggers. Mobs that spawn get picked up by the attack branch
                        -- on the next loop - no standing still checking rooms one by one.
                        H.unanchorPlayer()
                        H.hideCircle()
                        S.Target = nil

                        S.RoomVisitTick = S.RoomVisitTick or {}
                        local clearWait = CFG.RoomSpawnWait or 2.5

                        -- Passive clear: a room we already passed through that still has no live
                        -- mobs after clearWait counts as cleared.
                        for _, rm in ipairs(uncleared) do
                            local vt = S.RoomVisitTick[rm.Model]
                            if vt and (tick() - vt) >= clearWait then
                                local hasMobs = false
                                for _, e in ipairs(normalEnemies) do
                                    if e.Room and e.Room.Model == rm.Model and isAlive(e.Model) then
                                        hasMobs = true
                                        break
                                    end
                                end
                                if not hasMobs then
                                    S.Cleared[rm.Model] = true
                                    S.RoomStatus[rm.Model] = "cleared"
                                    syncToPersistent()
                                    log(("Room %s cleared (pass-through, no mobs)"):format(rm.Model.Name))
                                end
                            end
                        end
                        uncleared = H.getUnclearedNormalRooms(rooms)
                        table.sort(uncleared, function(a, b) return a.Index < b.Index end)

                        if #uncleared == 0 then
                            -- no normal rooms left -> warp into boss room once, the onlyBossLeft
                            -- branch above handles the wait/attack from here
                            for _, rm in ipairs(rooms) do
                                if rm.IsBoss then
                                    if S.ProbeRoom ~= rm.Model then
                                        S.ProbeRoom = rm.Model
                                        S.BossWaitTick = tick()
                                        log("No more enemy rooms left -> going to Boss room")
                                        pcall(function() LP:RequestStreamAroundAsync(rm.Pos) end)
                                        task.wait(0.4)
                                        stopHoverLock()
                                        H.warpTo(rm.Pos + Vector3.new(0, 4, 0))
                                    end
                                    break
                                end
                            end
                            task.wait(0.3)
                        else
                            -- next room to trigger = first uncleared room not yet passed through
                            local targetRoom = nil
                            for _, rm in ipairs(uncleared) do
                                if not S.RoomVisitTick[rm.Model] then
                                    targetRoom = rm
                                    break
                                end
                            end

                            if targetRoom then
                                S.RoomVisitTick[targetRoom.Model] = tick()
                                S.VisitedRooms[targetRoom.Model] = (S.VisitedRooms[targetRoom.Model] or 0) + 1
                                S.RoomStatus[targetRoom.Model] = "in_progress"
                                log(("Passing through %s to trigger spawns..."):format(targetRoom.Model.Name))
                                pcall(function() LP:RequestStreamAroundAsync(targetRoom.Pos) end)
                                stopHoverLock()
                                H.warpTo(targetRoom.Pos + Vector3.new(0, 3, 0))
                                task.wait(0.35) -- just long enough for the zone trigger, then move on
                                -- Blessing altars near this room (a run can have several) ->
                                -- trigger each unused one; BuffSelection watcher picks the card
                                local nAlt = H.useAltarsNear(targetRoom.Pos, 160, "pass")
                                if nAlt > 0 then
                                    print(("[AutoFarm] Altar| room=%s triggered=%d"):format(targetRoom.Model.Name, nAlt))
                                end
                            else
                                -- every room triggered; brief wait for late spawns / passive clears
                                -- dedicated altar rooms may not be in the room list -> sweep the
                                -- whole dungeon for unused altars every ~4s and go press them
                                if (tick() - (S._altarScanTick or 0)) > 4 then
                                    S._altarScanTick = tick()
                                    H.useAltarsNear(nil, math.huge, "dungeon")
                                end
                                task.wait(0.3)
                            end
                        end
                    end
                else
                    task.wait(0.5)
                end

                -- Stall watchdog
                if (tick() - S.ProgressTick) > CFG.StallTimeout then
                    if CFG.AutoFarmEndless then
                        -- Endless: don't return, just reset state and continue farming
                        log("stalled " .. CFG.StallTimeout .. "s -> Endless: reset and continue")
                        H.resetRunState()
                        H.flushPendingKeys()
                        S.ProgressTick = tick()  -- reset progress tick
                        task.wait(2)
                    elseif CFG.MobStuckReturn then
                        log("stalled " .. CFG.StallTimeout .. "s -> Mob Stuck Return enabled, returning to lobby")
                        H.noteLVLFail("stalled")
                        call("DungeonRunService", "RequestReturn")
                        task.wait(5)
                    else
                        log("stalled " .. CFG.StallTimeout .. "s -> Mob Stuck Return is OFF. Trying to reset state and continue.")
                        H.resetRunState()
                        H.flushPendingKeys()
                        S.ProgressTick = tick()  -- reset progress tick and try again
                        task.wait(2)
                    end
                end
                end

            end -- end if not S.Respawning
        end
        H.flushPendingKeys()
        H.stopParryWatcher(); H.stopPotionWatcher(); H.stopKeyWatcher()
        cleanupBossTracking()
        return "stopped"
    end


    -- =====================================================================
    -- BOSS RUSH AUTO FARM
    -- =====================================================================
    -- Boss Rush = fight boss after boss on increasing floors (1-100)
    -- Entry: DungeonQueueService:RequestSelectMode("BossRush")
    --        DungeonQueueService:RequestSelectFinalBoss(bossName)
    --        DungeonQueueService:RequestSelectSkipFloor(floor)
    --        DungeonQueueService:RequestEnter()
    -- Events: BossRushService.FloorStart(floor, bossName, tier)
    --         BossRushService.FloorCleared(floor, ?)
    --         BossRushService.DungeonComplete({Status, IsVictory, ...})
    --         BossRushService.LivesUpdate(lives)
    -- End:   BossRushService:RequestReplay() / RequestReturn()
    -- =====================================================================

    local BR = {
        Floor = 0,
        BossName = "",
        Tier = "",
        Lives = 3,
        FloorCleared = false,
        RunComplete = nil,  -- table from DungeonComplete
        Conns = {},
        Debug = false,  -- debug logging for boss scanning (disabled for production)
    }
    local BR_DEBUG = false  -- global flag for scan debugging (disabled for production)

    local function inBossRush()
        -- Primary: check player attribute
        if LP:GetAttribute("InBossRush") == true then return true end
        -- Fallback 1: check if BossRushService exists and has active floor data
        local brs = H.svc("BossRushService")
        if brs then
            local ok, active = pcall(function() return brs:GetAttribute("Active") end)
            if ok and active then return true end
        end
        -- Fallback 2: check if we selected BossRush mode via DungeonQueueService
        local dq = H.svc("DungeonQueueService")
        if dq then
            local ok, mode = pcall(function() return dq:GetAttribute("SelectedMode") end)
            if ok and mode == "BossRush" then return true end
        end
        return false
    end

    -- Find the boss model in workspace during Boss Rush
    -- Only match actual Boss Rush bosses by IsBoss attribute or exact boss names
    local BR_BOSS_NAMES = {
        -- Final bosses
        ["Cursed King"] = true, ["Satori"] = true, ["Anti Mage"] = true, ["Great Mage"] = true,
        -- Regular pool bosses (from BossRushData.REGULAR_POOL)
        ["Bandit Chief"] = true, ["Goblin Chief"] = true, ["Knight Lord"] = true,
        ["Verath"] = true, ["Valkskar"] = true, ["Ogge"] = true,
        ["Broken Reality"] = true, ["Bandit Enforcer"] = true, ["Goblin Warchief"] = true,
        ["Knight Champion"] = true, ["Dark Revenant"] = true, ["Frost Warden"] = true,
        -- Eclipse March (Update 25) route bosses
        ["White Hawk"] = true, ["Dragon Slayer"] = true,
        -- Empowered pool bosses (from BossRushData.EMPOWERED_POOL)
        ["Tenebris"] = true, ["Miyu"] = true,
        -- Enraged pool bosses (from BossRushData.ENRAGED_POOL)
        ["Karasu"] = true, ["Shadow Monarch"] = true, ["Awakened Devil"] = true,
        ["Kieru"] = true, ["Forge Archon"] = true, ["Mimika"] = true,
    }
    -- Exclusion list: entities that look like enemies but are NOT bosses
    -- Includes map geometry, NPCs, shop keepers, refill stations, decorations
    local BR_EXCLUDE_NAMES = {
        ["BananitaDolphinita"] = true,
        ["Dofin banana"] = true, ["Dofin"] = true, ["banana"] = true,
        ["Dummy"] = true, ["Training Dummy"] = true,
        ["NPC"] = true, ["Merchant"] = true, ["Blacksmith"] = true,
        -- Map geometry / decorations (NOT enemies)
        ["Seats"] = true, ["ShibuyaStationWall"] = true, ["567"] = true,
        ["ShadowClone"] = true,  -- shadow clone effect, not a real boss
        ["Floor"] = true, ["Wall"] = true, ["Door"] = true, ["Gate"] = true,
        ["Zone"] = true, ["Spawn"] = true, ["Arena"] = true,
        ["Potion_Station"] = true, ["Blessing_Altar"] = true, ["Skull_Totem"] = true,
        ["Chest"] = true, ["Key"] = true,
        -- Boss Rush UI/interaction NPCs (NOT bosses)
        ["Skip floor"] = true, ["SkipFloor"] = true, ["Skip_Floor"] = true,
        ["Skip"] = true, ["Floor_Skip"] = true,
        ["Replay"] = true, ["Return"] = true, ["Leave"] = true, ["Exit"] = true,
        ["Intermission"] = true, ["Lobby"] = true, ["Teleport"] = true,
        ["Portal"] = true, ["Waypoint"] = true, ["Marker"] = true,
        ["Prompt"] = true, ["Sign"] = true, ["Board"] = true, ["Display"] = true,
        ["Statue"] = true, ["Pedestal"] = true, ["Crystal"] = true, ["Orb"] = true,
        -- Eclipse March lobby NPCs (quest givers, NOT enemies)
        ["Casca"] = true, ["Hawk Commander"] = true, ["Wisteria Mentor"] = true,
    }

    -- Case-insensitive name match: checks exact and prefix only (NOT contains — too loose)
    -- "ShadowClone" contains "shadow" which would falsely match "Shadow Monarch"
    H.matchBossName = function(objName)
        if not objName or #objName == 0 then return false end
        local lower = objName:lower()
        for bossName in pairs(BR_BOSS_NAMES) do
            local bl = bossName:lower()
            -- Exact match
            if lower == bl then return true end
            -- Prefix match (e.g. "Valkskar, The Frostborn Warlord" starts with "Valkskar")
            if #lower >= #bl and lower:sub(1, #bl) == bl then return true end
            -- Suffix match (e.g. "Boss - Satori" ends with "satori")
            if #lower >= #bl and lower:sub(-#bl) == bl then return true end
        end
        return false
    end

    -- Get position from model: try HumanoidRootPart, PrimaryPart, GetPivot, then any BasePart
    -- Returns: (BasePart or nil, Vector3 or nil) — NEVER returns CFrame as first value
    -- Safe to call on Folder or any Instance (won't error on non-Model)
    H.getModelPos = function(model)
        if not model then return nil, nil end
        -- 1. HumanoidRootPart (works on Model and Folder)
        local root = model:FindFirstChild("HumanoidRootPart")
        if root and root.Parent then return root, root.Position end
        -- 2. PrimaryPart (only Model has this — wrap in pcall for safety)
        if model:IsA("Model") then
            local ok, pp = pcall(function() return model.PrimaryPart end)
            if ok and pp and pp.Parent then return pp, pp.Position end
        end
        -- 3. Find any BasePart in the model (CRITICAL for custom bosses without HRP/PrimaryPart)
        for _, child in ipairs(model:GetDescendants()) do
            if child:IsA("BasePart") and child.Parent then
                return child, child.Position
            end
        end
        -- 4. GetPivot() — return nil as root (CFrame is not an Instance)
        local ok, pivot = pcall(function() return model:GetPivot() end)
        if ok and pivot then
            return nil, pivot.Position
        end
        return nil, nil
    end

    -- Simple alive check for Boss Rush
    -- Real bosses have Humanoid with HP > 0, OR are spawning (have root part but no Dead flag)
    H.isBossRushAlive = function(model)
        if not (model and model.Parent) then return false end
        -- Check Dead attribute (server sets this when boss dies)
        local dead = false
        pcall(function() dead = model:GetAttribute("Dead") == true end)
        if dead then return false end
        -- Check Humanoid health if exists
        local hum = nil
        pcall(function() hum = model:FindFirstChildOfClass("Humanoid") end)
        if hum then
            -- In Boss Rush, bypass Health <= 0 check because milestone bosses might use fake 0 HP for custom health bars
            -- Raid crystals (Damage_Crystal) also expose a fake Humanoid at 0 HP — bypass in Raid too
            if hum.Health <= 0 and not (S.BossRushMode or S.RaidMode) then return false end
            return true
        end
        -- No Humanoid: accept ONLY if model has a real BasePart root (spawning boss)
        -- This is more permissive but still filters out pure decoration models
        local root, pos = H.getModelPos(model)
        if root and typeof(root) == "Instance" and root:IsA("BasePart") then
            return true
        end
        return false
    end

    -- Find nearest target in Boss Rush: STRICT — must be a real boss with BasePart root
    -- Priority: BR.BossName match > IsBoss attribute > boss name match
    -- NEVER targets non-boss models (no fallback to random enemies)
    -- Boss models live inside BossRush_NPCs folder (or any folder with "NPC" in name)
    findBossRushBoss = function()
        local best = nil
        local bestDist = math.huge
        local bestIsFloorBoss = false
        local r = hrp()
        local myPos = r and r.Position or Vector3.zero
        local floorBossName = BR.BossName and BR.BossName ~= "?" and BR.BossName or nil

        -- Collect candidates ONLY from BossRush_NPCs folder
        -- This folder contains only the current floor's real boss (one at a time)
        -- Skip Floor NPC and other interaction NPCs live elsewhere
        local candidates = {}
        pcall(function()
            local npcFolder = workspace:FindFirstChild("BossRush_NPCs")
            if npcFolder then
                for _, obj in ipairs(npcFolder:GetDescendants()) do
                    if obj:IsA("Model") and obj.Parent then
                        table.insert(candidates, obj)
                    end
                end
            end
        end)

        for _, obj in ipairs(candidates) do
            local isPlayer = false
            pcall(function() isPlayer = Players:GetPlayerFromCharacter(obj) ~= nil end)
            if not isPlayer and not BR_EXCLUDE_NAMES[obj.Name] then
                -- MUST have a real BasePart root (not nil from GetPivot)
                local root, pos = nil, nil
                pcall(function() root, pos = H.getModelPos(obj) end)
                if root and pos and typeof(root) == "Instance" and root:IsA("BasePart") then
                    local alive = false
                    pcall(function() alive = H.isBossRushAlive(obj) end)
                    if alive then
                        -- Calculate isBoss based on attribute or name
                        local isBoss = false
                        pcall(function() isBoss = obj:GetAttribute("IsBoss") == true end)
                        if not isBoss then
                            isBoss = H.matchBossName(obj.Name)
                        end

                        -- Determine if it matches the current floor boss specifically
                        local isFloorBoss = false
                        if floorBossName then
                            local lowerName = obj.Name:lower()
                            local lowerFloor = floorBossName:lower()
                            local matchesFloor = string.find(lowerName, lowerFloor, 1, true) ~= nil
                            if not matchesFloor then
                                local simpleName = string.gsub(lowerName, "[%p%s]", "")
                                local simpleFloor = string.gsub(lowerFloor, "[%p%s]", "")
                                matchesFloor = string.find(simpleName, simpleFloor, 1, true) ~= nil
                            end
                            if matchesFloor then
                                isFloorBoss = true
                                isBoss = true -- force true if it matches floor name
                            end
                        end

                        local dist = (myPos - pos).Magnitude

                        -- We will always save the entity as a candidate if it's alive in BossRush_NPCs.
                        -- But we prioritize isFloorBoss > isBoss > any fallback.
                        local candidateScore = 0
                        if isFloorBoss then candidateScore = 3
                        elseif isBoss then candidateScore = 2
                        else candidateScore = 1 end

                        if not best then
                            bestDist = dist
                            bestScore = candidateScore
                            best = { Model = obj, Root = root, IsBoss = isBoss }
                        else
                            if candidateScore > bestScore then
                                bestDist = dist
                                bestScore = candidateScore
                                best = { Model = obj, Root = root, IsBoss = isBoss }
                            elseif candidateScore == bestScore and dist < bestDist then
                                bestDist = dist
                                best = { Model = obj, Root = root, IsBoss = isBoss }
                            end
                        end
                    end
                end
            end
        end
        return best
    end

    -- Find the Boss Rush arena/spawn position in workspace
    -- Boss Rush uses Generated_* folder like normal dungeons, or a BossRush_* folder
    H.findBossRushArenaPos = function()
        -- Look for Generated_* folder (same as normal dungeon)
        for _, c in ipairs(workspace:GetChildren()) do
            if c:IsA("Folder") or c:IsA("Model") then
                local name = c.Name
                if name:sub(1, 10) == "Generated_" or name:sub(1, 9) == "BossRush_" then
                    -- Look for boss spawn point or arena center
                    local spawn = c:FindFirstChild("BossSpawn", true)
                        or c:FindFirstChild("Boss_Spawn", true)
                        or c:FindFirstChild("Spawn", true)
                        or c:FindFirstChild("Arena", true)
                        or c:FindFirstChild("BossArena", true)
                        or c:FindFirstChild("Floor", true)
                    if spawn then
                        local _, pos = H.getModelPos(spawn)
                        if pos then return pos end
                    end
                    -- Fallback: use the folder's own position
                    local _, pos = H.getModelPos(c)
                    if pos then return pos end
                    -- Fallback: use first child with position
                    for _, child in ipairs(c:GetChildren()) do
                        local _, cpos = H.getModelPos(child)
                        if cpos then return cpos end
                    end
                end
            end
        end
        -- Last resort: find the boss itself and warp to it
        local boss = findBossRushBoss()
        if boss and boss.Root then
            return boss.Root.Position
        end
        return nil
    end

    -- Warp to the boss arena/spawn position after entering Boss Rush
    H.warpToBossArena = function()
        local arenaPos = H.findBossRushArenaPos()
        if arenaPos then
            log(("Boss Rush: warping to arena at %.1f, %.1f, %.1f"):format(arenaPos.X, arenaPos.Y, arenaPos.Z))
            H.warpTo(arenaPos)
            local r = hrp()
            if r then
                hoverHoldPos = r.CFrame
                hoverHoldTime = tick()
                H.startHoverLock()
            end
            return true
        end
        log("Boss Rush: arena position not found - waiting for boss to spawn")
        return false
    end

    -- Enter Boss Rush from lobby
    H.enterBossRush = function()
        if not CFG.BossRushEnabled then return false end
        -- Party Member mode: wait for leader to start
        if CFG.PartyEnabled and CFG.PartyRole == "Member" then
            log("[DEBUG BossRush] Member mode - waiting for leader to start...")
            for i = 1, 360 do
                if not S.Running or not CFG.BossRushEnabled then return false end
                if inBossRush() then break end
                if i > 1 and i % 20 == 0 then
                    log("[DEBUG BossRush] Member: still waiting... (" .. math.floor(i * 0.5) .. "s)")
                end
                task.wait(0.5)
            end
            if not inBossRush() then return false end
            log("Boss Rush: entered (via leader)")
            return true
        end
        -- Party Leader: wait for members before entering
        if CFG.PartyEnabled and CFG.PartyRole == "Leader" then
            H.waitForPartyMembers()
        end
        -- Stand at the BossRush prompt/pod FIRST so the server registers us in the
        -- queue zone before any select calls (mirrors real player: walk up -> UI opens -> pick -> Enter)
        local brPrompt = H.findPromptPos("BossRush")
        if brPrompt then
            H.warpToPod(brPrompt)
            task.wait(0.3)
        end
        print("[AutoFarm] Boss Rush: selecting mode...")
        call("DungeonQueueService", "RequestSelectMode", "BossRush"); task.wait(0.5)
        local boss = S.WistoriaBRBoss or CFG.BossRushFinalBoss or "Cursed King"
        local isEclipse = (boss == "Eclipse March")
        print("[AutoFarm] Boss Rush: selecting final boss: " .. boss)
        call("DungeonQueueService", "RequestSelectFinalBoss", boss); task.wait(0.5)
        local skip = tonumber(CFG.BossRushSkipFloor) or 0
        print("[AutoFarm] Boss Rush: selecting skip floor: " .. tostring(skip))
        if not isEclipse then
            call("DungeonQueueService", "RequestSelectSkipFloor", skip); task.wait(0.5)
        end
        -- Re-warp in case selects happened while we drifted
        local bp0 = H.findPromptPos("BossRush")
        if bp0 then
            H.warpToPod(bp0)
            task.wait(0.3)
        end
        -- Server result lives in res (ok only means the Lua call didn't throw).
        -- Success must be a truthy value — nil/false/{Success=false} means rejected.
        local function enterOk(v)
            if type(v) == "table" then return v.Success == true end
            return v ~= nil and v ~= false
        end
        -- Eclipse March (Update 25): the game's own UI enters via
        -- Update25Service:Enter(floor) with floor in {0,10,20}
        -- (skip cost = floor/2 BossRushSkipTickets). "Eclipse March" is also a
        -- registered FINAL_BOSSES route, so RequestEnter works as fallback.
        local eclipseMsg = nil
        local function eclipseEnter(floor)
            local s = H.svc("Update25Service")
            if s and s.Enter then
                local ok, a, b = pcall(function()
                    local r = s.Enter(s, floor)
                    if type(r) == "table" and r.await then
                        local _, p1, p2 = r:await()
                        return p1, p2
                    end
                    return r
                end)
                if ok then return a, b end
                return false, a
            end
            local rf = H.rawRemote("Update25Service", "RF", "Enter")
            if rf and rf:IsA("RemoteFunction") then
                local ok, a, b = pcall(function() return rf:InvokeServer(floor) end)
                if ok then return a, b end
                return false, a
            end
            return false, "no Update25Service.Enter"
        end
        local eclipseReturnTried = false
        local function requestEnter(skipFloor)
            if isEclipse then
                local f = 0
                if skipFloor >= 20 then f = 20 elseif skipFloor >= 10 then f = 10 end
                local a, b = eclipseEnter(f)
                eclipseMsg = b
                if enterOk(a) then return true, a end
                -- Server wants us in the lobby place (stale InDungeon/InRaid flags
                -- or still inside a run instance): fire RequestReturn, wait for the
                -- teleport, and let the retry loop call Enter again.
                if type(b) == "string" and b:lower():find("lobby") and not eclipseReturnTried then
                    eclipseReturnTried = true
                    print("[AutoFarm] Eclipse: server says not in lobby - RequestReturn...")
                    pcall(H.returnToLobby)
                    task.wait(5)
                    a, b = eclipseEnter(f)
                    eclipseMsg = b
                    if enterOk(a) then return true, a end
                end
                -- rejected (level lock / no tickets / event closed) -> try the
                -- normal queue path since the route is a valid FINAL_BOSSES entry
                print(("[AutoFarm] Eclipse: Enter(%d) rejected: %s - trying RequestEnter"):format(f, tostring(b)))
                return call("DungeonQueueService", "RequestEnter")
            end
            return call("DungeonQueueService", "RequestEnter")
        end
        if isEclipse and CFG.EclipseAutoQuest ~= false then
            local aq, ar = call("Update25Service", "Action", "Accept")
            print(("[AutoFarm] Eclipse: Action(Accept) -> ok=%s res=%s"):format(tostring(aq), tostring(ar)))
            task.wait(0.3)
        end
        print("[AutoFarm] Boss Rush: RequestEnter...")
        local ok, res = requestEnter(skip)
        print(("[AutoFarm] Boss Rush: RequestEnter -> ok=%s res=%s"):format(tostring(ok), tostring(res)))

        local entered = ok and enterOk(res)
        local tries = 0
        while not entered and tries < 4
            and S.Running and CFG.BossRushEnabled do
            tries += 1
            task.wait(1)
            local bp = H.findPromptPos("BossRush")
            if bp then H.warpToPod(bp); task.wait(0.3) end
            ok, res = requestEnter(skip)
            print(("[AutoFarm] Boss Rush: RequestEnter retry %d -> ok=%s res=%s"):format(tries, tostring(ok), tostring(res)))
            entered = ok and enterOk(res)
        end

        -- Fallback if we failed to enter while trying to use a skip ticket
        if not entered and skip > 0 then
            print(("[AutoFarm] Boss Rush: enter failed with skip (%s) - retrying without skip..."):format(tostring(res)))
            if Library and Library.Notify then
                Library:Notify({Title = "Boss Rush Note", Description = tostring(res) .. " - Retrying without skip...", Duration = 4})
            end
            call("DungeonQueueService", "RequestSelectSkipFloor", 0); task.wait(0.5)
            ok, res = requestEnter(0)
            print(("[AutoFarm] Boss Rush: RequestEnter (no-skip) -> ok=%s res=%s"):format(tostring(ok), tostring(res)))
            entered = ok and enterOk(res)
        end

        if not entered then
            -- Diagnose: ask the server why we can't enter (level lock, queue state, etc.)
            local aOk, aRes = call("DungeonQueueService", "GetBossRushAccessState")
            print(("[AutoFarm] Boss Rush: GetBossRushAccessState -> ok=%s res=%s"):format(tostring(aOk), tostring(aRes)))
            local failMsg = eclipseMsg or res or aRes
            if failMsg and Library and Library.Notify then
                Library:Notify({Title = "Boss Rush Failed", Description = tostring(failMsg), Duration = 4})
            end
            task.wait(3)
            return false
        end

        -- Wait for in-run flag (Eclipse route may use the generic run attrs)
        for _ = 1, 40 do
            if not S.Running or inBossRush() or inRun() or LP:GetAttribute("InDungeon") then break end
            task.wait(0.5)
        end
        if not (inBossRush() or inRun() or LP:GetAttribute("InDungeon")) then return false end
        -- Wait for arena to load, then warp to it
        log("Boss Rush: entered - waiting for arena to load...")
        task.wait(2)
        H.warpToBossArena()
        return true
    end

