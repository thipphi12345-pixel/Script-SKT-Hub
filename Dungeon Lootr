    -- Hook BossRushService events
    H.hookBossRushEvents = function()
        -- Clear old conns
        for _, c in ipairs(BR.Conns) do pcall(function() c:Disconnect() end) end
        BR.Conns = {}

        local brs = H.svc("BossRushService")
        if not brs then return end

        -- FloorStart(floor, bossName, tier)
        if brs.FloorStart then
            local c = brs.FloorStart:Connect(function(floor, bossName, tier)
                BR.Floor = floor or 0
                BR.BossName = bossName or "?"
                BR.Tier = tier or ""
                BR.FloorCleared = false
                log(("Boss Rush: Floor %d started - %s (%s)"):format(floor, bossName or "?", tier or ""))
            end)
            table.insert(BR.Conns, c)
        end

        -- FloorCleared(floor, ?)
        if brs.FloorCleared then
            local c = brs.FloorCleared:Connect(function(floor, data)
                BR.FloorCleared = true
                -- Wisteria quest: a floor-100 clear = 1 Demon Eye win
                if S._wistoriaBRDrive and floor and floor >= 100 then
                    S._wistoriaWins = (S._wistoriaWins or 0) + 1
                    log(("Wistoria: floor 100 cleared - Demon Eyes %d/12"):format(S._wistoriaWins))
                end
                log(("Boss Rush: Floor %d cleared!"):format(floor or BR.Floor))
            end)
            table.insert(BR.Conns, c)
        end

        -- LivesUpdate(lives)
        if brs.LivesUpdate then
            local c = brs.LivesUpdate:Connect(function(lives)
                BR.Lives = lives or 0
                log(("Boss Rush: Lives = %d"):format(lives or 0))
            end)
            table.insert(BR.Conns, c)
        end

        -- DungeonComplete({Status, IsVictory, ...})
        if brs.DungeonComplete then
            local c = brs.DungeonComplete:Connect(function(info)
                BR.RunComplete = type(info) == "table" and info or { Status = "Cleared" }
                log("Boss Rush: DungeonComplete - " .. tostring(BR.RunComplete.Status))
            end)
            table.insert(BR.Conns, c)
        end

        -- ChestSelection(chests, maxPicks) — Boss Rush floor chest selection
        -- ใช้ H.handleChestSelection() รวม (รองรับทุกด่าน)
        if brs.ChestSelection then
            local c = brs.ChestSelection:Connect(function(chests, maxPicks)
                log(("Boss Rush: ChestSelection event (chests=%d maxPicks=%s)"):format(
                    type(chests) == "table" and #chests or 0,
                    tostring(maxPicks)))
                if not S.Running then return end
                if not S.BossRushMode then return end
                -- รอ animation เสร็จก่อนเลือก
                local max = CFG.MaxChestPicks or 2
                task.wait(0.6 + (max * 0.2))
                H.handleChestSelection()
            end)
            table.insert(BR.Conns, c)
        end

        -- MilestoneReached(milestoneId) — auto claim milestone rewards
        if brs.MilestoneReached then
            local c = brs.MilestoneReached:Connect(function(milestoneId)
                if not (S.Running and CFG.BossRushAutoClaim) then return end
                if not S.BossRushMode then return end
                -- Wait a moment for reward to be claimable
                task.wait(0.5)
                pcall(function() call("BossRushService", "ClaimMilestoneReward", milestoneId) end)
            end)
            table.insert(BR.Conns, c)
        end
    end

    H.unhookBossRushEvents = function()
