    -- สร้างรายการสินค้าทั้งหมดที่ร้านขายได้ (จาก EquipmentTemplates.GetShopItemIds)
    -- เรียงตาม rarity จากหายาก → ง่าย (MaxRarity desc)
    -- label = "DisplayName [Slot] (MinRarity-MaxRarity)"
    H.buildShopItemEntries = function()
        local entries = {}
        if not H.EquipmentTemplates or not H.EquipmentTemplates.GetShopItemIds then
            return entries
        end
        local ok, ids = pcall(function() return H.EquipmentTemplates.GetShopItemIds() end)
        if not ok or type(ids) ~= "table" then return entries end
        for _, itemId in ipairs(ids) do
            local tmpl = nil
            pcall(function() tmpl = H.EquipmentTemplates.GetTemplate(itemId) end)
            local name = (tmpl and tmpl.DisplayName) or itemId
            local slot = (tmpl and tmpl.Slot) or ""
            local minR = (tmpl and tmpl.MinRarity) or ""
            local maxR = (tmpl and tmpl.MaxRarity) or ""
            local label = name
            if slot ~= "" then label = label .. " [" .. slot .. "]" end
            if minR ~= "" and maxR ~= "" then label = label .. " (" .. minR .. "-" .. maxR .. ")" end
            table.insert(entries, {
                itemId = itemId,
                label = label,
                name = name,
                slot = slot,
                minR = minR,
                maxR = maxR,
                rarityIdx = H.RarityIndex[maxR] or 0,
            })
        end
        -- เรียง: rarity หายากก่อน (desc), ถ้า rarity เท่ากัน → ตาม slot (Head, Body, Ring), ถ้าเท่ากัน → ตามชื่อ
        local slotOrder = { Head = 1, Body = 2, Ring = 3 }
        table.sort(entries, function(a, b)
            if a.rarityIdx ~= b.rarityIdx then return a.rarityIdx > b.rarityIdx end
            local sa = slotOrder[a.slot] or 99
            local sb = slotOrder[b.slot] or 99
            if sa ~= sb then return sa < sb end
            return a.name < b.name
        end)
        return entries
    end

