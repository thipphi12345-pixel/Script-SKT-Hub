    -- trigger ProximityPrompt like the real client does.
    -- Hold prompts get a genuine InputHoldBegin/End cycle over the real
    -- HoldDuration — forcing HoldDuration=0 or firing with 0 hold time is a
    -- server-side flag vector (hold-time validation).
    H.triggerPrompt = function(prompt)
        if not prompt then return false end
        local hold = prompt.HoldDuration or 0
        if hold > 0 then
            return pcall(function()
                prompt:InputHoldBegin()
                task.wait(hold + 0.05 + math.random() * 0.1)
                prompt:InputHoldEnd()
            end)
        end
        local ok = false
        if fireproximityprompt then
            ok = pcall(function() fireproximityprompt(prompt) end)
        end
        if not ok then
            ok = pcall(function()
                prompt:InputHoldBegin()
                task.wait(0.1)
                prompt:InputHoldEnd()
            end)
        end
        return ok
    end

    -- เธงเธฒเธฃเนเธเนเธ altar เนเธฅเนเธง trigger
    H.warpAndTrigger = function(model)
        if not model then return false end
        local prompt = H.findPrompt(model)
        -- aim at the prompt's real position (e.g. Blessing_Altar.PromptAttachment)
        -- the model pivot can be far from where the prompt actually is
        local pos = nil
        if prompt then
            local pp = prompt.Parent
            if pp and pp:IsA("Attachment") then
                pos = pp.WorldPosition
            elseif pp and pp:IsA("BasePart") then
                pos = pp.Position
            end
        end
        if not pos then
            local ok, cf = pcall(function() return model:GetPivot() end)
            pos = ok and cf.Position or nil
        end
        if not pos then return false end
        pcall(function() LP:RequestStreamAroundAsync(pos) end)
        stopHoverLock()
        H.warpTo(pos + Vector3.new(0, 3, 0))
        task.wait(0.4)
        if not prompt then
            log("No ProximityPrompt found in " .. model.Name)
            return false
        end
        local r = hrp()
        if r and (r.Position - pos).Magnitude > 10 then
            H.warpTo(pos + Vector3.new(0, 2, 0))
            task.wait(0.2)
        end
        print(("[AutoFarm] Prompt| %s enabled=%s hold=%.1f maxDist=%.1f los=%s"):format(
            model.Name, tostring(prompt.Enabled), prompt.HoldDuration or 0,
            prompt.MaxActivationDistance or 10, tostring(prompt.RequiresLineOfSight)))
        log("Triggering " .. model.Name .. " prompt...")
        local ok = H.triggerPrompt(prompt)
        task.wait(0.4)
        if not ok then ok = H.triggerPrompt(prompt) end
        task.wait(0.3)
        return ok
    end

