            { rarity = "Mythic",    hardcoded = { "Divergent", "Cursed Child", "Wanderer" } },
            { rarity = "Celestial", hardcoded = { "Artemis", "Vacio", "Azure Devil", "Forge Archon", "Necromancer", "Moon Witch" } },
            { rarity = "Exotic",    hardcoded = { "Sinister Trigger", "Embertide", "Dragoon", "Hawk Commander" } },
        }
        local cd = gameData("Class_Data")
        -- Only classes obtainable from the summon shop (Summonable ~= false),
        -- using the same getter SummoningData rolls from
        local getPool = cd and (cd.GetSummonableClassesByRarity or cd.GetClassesByRarity)
        if getPool then
            for _, g in ipairs(groups) do
                local ok, names = pcall(function() return getPool(g.rarity) end)
                if ok and type(names) == "table" and #names > 0 then
                    -- pool is authoritative: show ONLY summonable classes
                    g.names = {}
                    for _, n in ipairs(names) do g.names[#g.names + 1] = tostring(n) end
                else
                    g.names = g.hardcoded
                end
            end
            -- rarity buckets that exist in data but not in our hardcoded groups
            local seenRarity = {}
            for _, g in ipairs(groups) do seenRarity[g.rarity] = true end
            if cd.GetAllClassNames then
                local ok, all = pcall(function() return cd.GetAllClassNames() end)
                if ok and type(all) == "table" then
                    for _, cn in ipairs(all) do
                        local ok2, d = pcall(function() return cd.Get(cn) end)
                        local rar = ok2 and type(d) == "table" and d.Rarity or nil
                        local summonable = ok2 and type(d) == "table" and d.Summonable ~= false
                        if rar and summonable then
                            if not seenRarity[rar] then
                                seenRarity[rar] = true
                                table.insert(groups, { rarity = rar, names = {} })
                            end
                            for _, g in ipairs(groups) do
                                if g.rarity == rar then
                                    local found = false
                                    for _, n in ipairs(g.names) do if n == cn then found = true break end end
                                    if not found then table.insert(g.names, cn) end
                                    break
                                end
                            end
                        end
                    end
                end
            end
        else
            for _, g in ipairs(groups) do g.names = g.hardcoded end
        end
        return groups
    end

