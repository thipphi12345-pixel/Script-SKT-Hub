    -- ============================================================
    -- Item Services: Dismantle / Appraisal / Mystery Merchant
    -- ============================================================
    local function raritySet(input, fallback)
        local set = {}
        if type(input) == "string" then
            if input ~= "" then set[input] = true end
        elseif type(input) == "table" then
            for k, v in pairs(input) do
                if type(k) == "number" and type(v) == "string" and v ~= "" then set[v] = true
                elseif type(k) == "string" and v then set[k] = true end
            end
        end
        if next(set) == nil and fallback then set[fallback] = true end
        return set
    end

    local function equippedGuidSet(Data)
        local set = {}
        for _, slotName in ipairs({"Head", "Body", "Ring"}) do
            local eq = (Data.Equipment or {})[slotName]
            if type(eq) == "table" and eq.GUID then set[eq.GUID] = true end
        end
        return set
    end

    -- Dismantle: เกมให้แยกเฉพาะ gear ที่ ForgeLevel > 0, identified, ไม่ lock, ไม่ใส่อยู่
    function H.dismantleGearByRarity(rarities)
        local set = raritySet(rarities, "Common")
        local pd = H.getPlayerData()
        if not (pd and pd.Data and pd.Data.EquipmentInventory) then return false end
        local equippedSet = equippedGuidSet(pd.Data)
        local guids = {}
        for _, v in pairs(pd.Data.EquipmentInventory) do
            if type(v) == "table" and v.GUID and not v.Locked and v.Identified ~= false
                and not equippedSet[v.GUID] and set[v.Rarity]
                and type(v.ForgeLevel) == "number" and v.ForgeLevel > 0 then
                table.insert(guids, v.GUID)
            end
        end
        if #guids == 0 then return false end
        log(("Dismantle: %d forged item(s)"):format(#guids))
        local ok, res = call("DismantleService", "DismantleItems", guids)
        log(("Dismantle: ok=%s res=%s"):format(tostring(ok), tostring(res)))
        return ok
    end

    H._dismantleThread = nil
