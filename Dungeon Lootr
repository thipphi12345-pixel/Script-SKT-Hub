    -- Invite a player by UserId
    function H.invitePlayer(userId)
        if not userId then return false end
        log(("Party: inviting UserId %s"):format(tostring(userId)))
        local ok, res = call("DungeonQueueService", "RequestInvite", userId)
        log(("Party: invite -> ok=%s res=%s"):format(tostring(ok), tostring(res)))
        if not ok then
            -- Retry once after short delay
            task.wait(0.5)
            log("Party: retrying invite...")
            ok, res = call("DungeonQueueService", "RequestInvite", userId)
            log(("Party: invite retry -> ok=%s res=%s"):format(tostring(ok), tostring(res)))
        end
        return ok
    end

    -- Invite a player by name (looks up UserId from Players)
    function H.invitePlayerByName(name)
        if not name or name == "" then return false end
        -- Strip "DisplayName (@UserName)" format
        local displayName = name:match("^([^%(]+)")
        if displayName then displayName = displayName:gsub("%s+$", "") end
        local searchName = displayName or name
        for _, p in ipairs(Players:GetPlayers()) do
            if p.Name == searchName or p.DisplayName == searchName
                or p.Name == name or p.DisplayName == name then
                return H.invitePlayer(p.UserId)
            end
        end
        log("Party: player not found - " .. tostring(name) .. " (searched " .. #Players:GetPlayers() .. " players)")
        return false
    end

