        Func = function()
            -- คืนค่า CFG ทั้งหมดเป็น default
            for k, v in pairs(DEFAULT_CONFIG) do
                CFG[k] = (type(v) == "table") and table.clone(v) or v
            end
            -- คืนค่า UI ทั้งหมดเป็น default โดย map UI key → CFG key (strip "AF_")
            if Library and Library.Toggles then
                for key, option in pairs(Library.Toggles) do
                    if option.SetValue then
                        local cfgKey = key:gsub("^AF_", "")
                        local defVal = DEFAULT_CONFIG[cfgKey]
                        if defVal ~= nil then
                            pcall(function() option:SetValue(defVal) end)
                        end
                    end
                end
            end
            if Library and Library.Options then
                for key, option in pairs(Library.Options) do
                    if option.SetValue then
                        local cfgKey = key:gsub("^AF_", "")
                        local defVal = DEFAULT_CONFIG[cfgKey]
                        if defVal ~= nil then
                            pcall(function() option:SetValue(defVal) end)
                        end
                    end
                end
            end
            -- save config ใหม่ (เป็นค่า default)
            Library:ApplyAppearance(CFG)
            H.saveConfig()
            log("Settings reset to defaults — CFG + UI reset, saved to config file")
            pcall(function()
