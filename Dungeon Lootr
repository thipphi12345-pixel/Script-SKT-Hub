    -- Auto Buy: ดักซื้อสินค้าใน Buy Shop อัตโนมัติ
    -- ไม่ต้องเข้าร้าน — ดึงข้อมูลร้านจาก server ตรงๆ แล้วซื้อเลย
    H._buyThread = nil
    H._lastShopHash = nil -- เก็บค่า hash ของร้านค้า
    
    function H.buyShopItems()
        -- Step 1: ดึงรายการสินค้าจาก ShopService:GetEquipmentShopInfo() (ไม่ต้องเข้าร้าน)
        local okInfo, shopItems = call("ShopService", "GetEquipmentShopInfo")
        if not okInfo or type(shopItems) ~= "table" then
            return false
        end
        
        -- Create a simple hash of the shop items to avoid spamming
        local currentHash = ""
        for _, item in ipairs(shopItems) do
            if type(item) == "table" and item.GUID then
                currentHash = currentHash .. tostring(item.GUID) .. ","
            end
        end
        if currentHash == H._lastShopHash then
            return false -- Shop hasn't changed, no need to check
        end
        H._lastShopHash = currentHash

        -- Step 2: สร้าง set ของ ItemId ที่เลือก
        local wantSet = {}
        if type(CFG.AutoBuyItems) == "table" then
            for _, id in ipairs(CFG.AutoBuyItems) do
                if type(id) == "string" and id ~= "" then
                    wantSet[id] = true
                end
            end
        end
        if next(wantSet) == nil then
            return false
        end

        -- Step 2.5: Build Rarity set for filtering
        local wantRarity = {}
        if type(CFG.AutoBuyRarity) == "table" then
            for k, v in pairs(CFG.AutoBuyRarity) do
                if type(k) == "number" and type(v) == "string" then wantRarity[v] = true
                elseif type(k) == "string" and v then wantRarity[k] = true end
            end
        elseif type(CFG.AutoBuyRarity) == "string" and CFG.AutoBuyRarity ~= "" then
            wantRarity[CFG.AutoBuyRarity] = true
        end
        
        -- Step 3: ซื้อทีละชิ้นที่ตรงกับที่เลือก
        local bought = 0
        for _, item in ipairs(shopItems) do
            if type(item) == "table" and item.GUID and item.ItemId and wantSet[item.ItemId] then
                -- Check rarity filter if configured
                if next(wantRarity) ~= nil and not wantRarity[item.Rarity] then
                    continue -- Skip if rarity doesn't match
                end

                log(("Auto Buy: buying %s [%s] (GUID=%s cost=%d)"):format(item.ItemId, tostring(item.Rarity), item.GUID, item.Cost or 0))
                local okBuy = call("ShopService", "BuyEquipment", item.GUID)
                if okBuy then
                    bought = bought + 1
                    task.wait(0.3)
                else
                    log(("Auto Buy: BuyEquipment failed for %s"):format(item.ItemId))
                end
            end
        end
        
        if bought > 0 then
            log(("Auto Buy: bought %d item(s)"):format(bought))
            -- Force a rehash next time because we bought something (shop stock changed)
            H._lastShopHash = nil 
        end
        return bought > 0
    end

    function H.startAutoBuy()
        if H._buyThread then return end
        log("Auto Buy started (Smart Mode: Only checks when shop updates)")
        H._lastShopHash = nil -- Reset cache on start
        H._buyThread = task.spawn(function()
            while CFG.AutoBuy and not S.PartyUnloaded do
                H.buyShopItems()
                task.wait(5) -- We can loop faster safely now, because the hash check is instantaneous and silent
            end
            H._buyThread = nil
        end)
    end

    -- Class Reroll loop
    H._rerollThread = nil
    function H.getSlotData()
        local ok, res = call("SummoningService", "GetSlotData")
        if not ok or not res then
            for _, obj in pairs(game:GetService("ReplicatedStorage"):GetDescendants()) do
                if obj.Name == "GetSlotData" and obj:IsA("RemoteFunction") then
                    local s, r = pcall(function() return obj:InvokeServer() end)
                    if s then ok, res = s, r ; break end
                end
            end
        end
        if ok and type(res) == "string" then
            local s, d = pcall(function() return game:GetService("HttpService"):JSONDecode(res) end)
            if s and type(d) == "table" then res = d end
        end
        return ok, res
    end

    function H.toggleSlotLock(slot)
        local ok, res = call("SummoningService", "ToggleSlotLock", tonumber(slot))
        if ok then return true end
        for _, obj in pairs(game:GetService("ReplicatedStorage"):GetDescendants()) do
            if obj.Name == "ToggleSlotLock" and obj:IsA("RemoteFunction") then
                local s, r = pcall(function() return obj:InvokeServer(tonumber(slot)) end)
                if s then return true end
            end
        end
        return false
    end

    function H.startClassReroll()
        if H._rerollThread then return end
        log("Class Reroll started (Multi-Slot Auto Lock)")
        H._rerollThread = task.spawn(function()
            while CFG.ClassRerollRunning and not S.PartyUnloaded do
                local ok, slotData = H.getSlotData()
                if ok and type(slotData) == "table" then
                    local parsedSlots = {}
                    for sStr, className in pairs(slotData.Slots or {}) do
                        local snum = tonumber(sStr)
                        if snum and type(className) == "string" then
                            local isLocked = slotData.SlotLocks and (slotData.SlotLocks[snum] == true or slotData.SlotLocks[tostring(snum)] == true)
                            parsedSlots[snum] = { Class = className, Locked = isLocked }
                            if S.SlotLabels and S.SlotLabels[snum] then
                                S.SlotLabels[snum]:SetText(string.format("Slot %d : %s %s", snum, className, isLocked and "[LOCKED]" or "[UNLOCKED]"))
                            end
                        end
                    end

                    local slotsToRoll = CFG.ClassRerollSlot or {}
                    if type(slotsToRoll) ~= "table" then slotsToRoll = {tostring(slotsToRoll)} end
                    
                    local needsSpin = false
                    local slotToSpin = nil
                    local allSelectedLocked = true
                    local foundAnySlot = false
                    
                    for _, sStr in ipairs(slotsToRoll) do
                        local snum = tonumber(sStr)
                        if snum then
                            local sInfo = parsedSlots[snum]
                            if sInfo then
                                foundAnySlot = true
                                local action = CFG.SelectedClasses[sInfo.Class] or "Keep"
                                
                                -- "Stop" means lock it. "Keep" means keep rolling (skip it).
                                if action == "Stop" then
                                    if not sInfo.Locked then
                                        log("Locking Slot " .. snum .. " (Got " .. sInfo.Class .. ")")
                                        H.toggleSlotLock(snum)
                                        task.wait(0.5)
                                    end
                                else
                                    allSelectedLocked = false
                                    if sInfo.Locked then
                                        log("Unlocking Slot " .. snum .. " to reroll (Currently " .. sInfo.Class .. ")")
                                        H.toggleSlotLock(snum)
                                        task.wait(0.5)
                                    end
                                    if not needsSpin then
                                        needsSpin = true
                                        slotToSpin = snum
                                    end
                                end
                            else
                                allSelectedLocked = false
                                if not needsSpin then
                                    needsSpin = true
                                    slotToSpin = snum
                                end
                            end
                        end
                    end
                    
                    if not foundAnySlot then
                        -- Fallback: Could not parse slots, just act like the old script and spin continuously
                        needsSpin = true
                        allSelectedLocked = false
                        if not H._warnedParse then
                            H._warnedParse = true
                            log("Warning: Could not read slot data. Falling back to continuous spin.")
                            -- Dump raw data for debugging
                            print("RAW SLOT DATA:", tostring(slotData))
                            if type(slotData) == "table" then
                                for k,v in pairs(slotData) do print(k, v) end
                            end
                        end
                    end
                    
                    if allSelectedLocked and foundAnySlot and #slotsToRoll > 0 then
                        log("All selected slots have achieved 'Keep' classes. Stopping Auto Reroll.")
                        CFG.ClassRerollRunning = false
                        -- Sync the UI toggle so the switch flips off with the loop.
                        pcall(function()
                            local t = Toggles and Toggles.AF_ClassReroll
                            if t and t.Control and t.Control.Set then
                                t.Control:Set(false, false)
                            end
                        end)
                    elseif needsSpin then
                        if slotToSpin then
                            local currentActive = slotData.ActiveIndex or 1
                            if currentActive ~= slotToSpin then
                                log("Switching to Slot " .. tostring(slotToSpin))
                                local okSwitch = call("SummoningService", "SwitchSlot", slotToSpin)
                                if not okSwitch then
                                    for _, obj in pairs(game:GetService("ReplicatedStorage"):GetDescendants()) do
                                        if obj.Name == "SwitchSlot" and obj:IsA("RemoteFunction") then
                                            pcall(function() obj:InvokeServer(slotToSpin) end)
                                            break
                                        end
                                    end
                                end
                                task.wait(0.5)
                            end
                        end
                        local spinType = CFG.ClassSpinType or "Normal"
                        H.summoningSpin(spinType)
                        task.wait(1.5)
                    else
                        task.wait(1)
                    end
                else
                    if not H._warnedFetch then
                        H._warnedFetch = true
                        log("Warning: Failed to fetch SlotData. Falling back to continuous spin.")
                    end
                    -- Fallback spin
                    local spinType = CFG.ClassSpinType or "Normal"
                    H.summoningSpin(spinType)
                    task.wait(1.5)
                end
            end
            H._rerollThread = nil
        end)
    end

