    -- Request return to lobby
    function H.returnToLobby()
        -- Fire EVERY known return remote. A wrong-mode RequestReturn does not
        -- error (call() returns true because the remote fired fine — the server
        -- just ignores it), so stopping at the first "ok" never reached the
        -- correct service. Firing all is harmless: wrong-mode calls are no-ops.
        local parts = {}
        for _, svc in ipairs({
            "DungeonRunService", "BossRushService", "RaidRunService",
            "ChallengeRunService", "PayloadRunService",
        }) do
            local ok = call(svc, "RequestReturn")
            table.insert(parts, svc .. "=" .. tostring(ok))
        end
        log("ReturnToLobby: " .. table.concat(parts, " "))
        return true
    end

    -- Select dungeon and enter
    function H.selectAndEnterDungeon(dungeonKey, difficulty)
        call("DungeonQueueService", "RequestSelectMode", "Dungeon")
        task.wait(0.3)
        call("DungeonQueueService", "RequestSelectDungeon", H.resolveDungeonKey(dungeonKey))
        task.wait(0.3)
        call("DungeonQueueService", "RequestSelectDifficulty", difficulty or "Easy")
        task.wait(0.3)
        local ok, res
        if H.startRun then
            ok, res = H.startRun("Dungeon")
        else
