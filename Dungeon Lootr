    task.spawn(function()
        while not S.PartyUnloaded do
            if S.ClassLabel and S.ClassLabel.Label and S.ClassLabel.Label.Parent then
                local cn = H.getActiveClassName() or "Unknown"
                local data = H.getClassData(cn)
                local typeStr = "Unknown"
                local heightStr = "--"
                if data then
                    local range = data.Range or 8
                    local dmgType = data.DamageType or "Physical"
                    local useProj = data.UseProjectile or false
                    if useProj or dmgType == "Ranged" or dmgType == "Magic" or range >= 21 then
                        typeStr = "Long"
                        heightStr = "19 (Max)"
                    elseif range >= 15 then
                        typeStr = "Mid"
                        heightStr = "16"
                    else
                        typeStr = "Melee"
                        heightStr = "12"
                    end
                end
                pcall(function()
                    S.ClassLabel:SetText(("Class: %s | Type: %s | Height: %s"):format(cn, typeStr, heightStr))
                end)
            end
            task.wait(2)
        end
    end)

