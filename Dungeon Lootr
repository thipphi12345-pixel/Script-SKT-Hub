        function Group:AddLabel(keyOrText, config)
            local isRegistered = type(config) == "table" and not config.Unregistered
            local text = isRegistered and tostring(config.Text or keyOrText) or tostring(keyOrText)
            local label = self.Tab:AddLabel(text, config)

            local function ResizeLabel(value)
                label.TextWrapped = true
                label.AutomaticSize = Enum.AutomaticSize.Y
                label.Size = UDim2.new(1, 0, 0, config and config.Status and 24 or 22)
            end
            ResizeLabel(text)

            local wrapper = {
                Label = label,
                Group = self,
                Value = text,
            }

            function wrapper:SetText(value)
                if not self.Label then return end
                if self.Value == tostring(value) and self.Label.Text == self.Value then return end
                self.Value = tostring(value)
                pcall(function()
                    if self.Label and self.Label.Parent then
                        self.Label.Text = self.Value
                    end
                end)
                pcall(function()
                    if self.Label and self.Label.Parent then
                        ResizeLabel(self.Value)
                    end
                end)
            end

            function wrapper:SetProgress(have, need)
                self.Group.Tab:SetStatusProgress(self.Label, have, need)
            end

            function wrapper:AddKeyPicker(key, pickerConfig)
                pickerConfig = pickerConfig or {}
                self.Label.Visible = false
                self.Label.Size = UDim2.fromOffset(0, 0)
                return self.Group:AddKeybind(key, pickerConfig)
            end

            if isRegistered then
                local option = CreateBoundOption(self.Library, self.Library.Options, keyOrText, text, nil)
                option.Label = label
                option._ResizeLabel = ResizeLabel
                return option
            end
            return wrapper
        end

