        local ok, catalog = pcall(require, module)
        local codes = ok and H.publicCodes(catalog) or nil
        if not codes then return "Unable to read the game's code list." end
        return "Active public codes in this server: " .. tostring(#codes) .. "\n"
            .. (#codes > 0 and table.concat(codes, "\n") or "None listed")
