                        self.Controls.Name:SetValue(value)
                    end
                end,
            })
            group:AddButton({ Text = "Save Config", Func = function() self:Save() end })
            group:AddButton({ Text = "Load Selected", Func = function() self:Load() end })
            group:AddButton({ Text = "Delete Selected", Func = function() self:Delete() end })
            group:AddButton({ Text = "Refresh List", Func = function() self:Refresh() end })
            group:AddButton({ Text = "Set Selected as Autoload", Func = function() self:SetAutoload() end })
            group:AddButton({ Text = "Clear Autoload", Func = function() self:ClearAutoload() end })
            self:Refresh()
        end
        
        return ConfigManager
        
        end)()

