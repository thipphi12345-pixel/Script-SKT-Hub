    -- Equip Best: ใส่ทุก slot (Head, Body, Ring) พร้อมกันโดยตรง
    -- จาก dump: OnEquipBestClicked วนลูปทุก slot → EquipmentService:Equip(GUID)
    -- ไม่ต้องใช้ firesignal UI (ไม่ต้องเปิด Inventory)
    function H.equipBestGear()
        -- Step 1: Collect all loot from dungeon storage
        local okCollect, resCollect = call("EquipmentService", "CollectAll")
        log(("EquipBest CollectAll: ok=%s res=%s"):format(tostring(okCollect), tostring(resCollect)))
        task.wait(0.3)
        -- Step 2: หา best item แต่ละ slot แล้ว Equip โดยตรง
        local pd = H.getPlayerData()
        if not pd or not pd.Data then
            log("EquipBest: no PlayerData")
            return false
        end
        local Data = pd.Data
        local playerLevel = Data.PlayerLevel or 1
        local inv = Data.EquipmentInventory
        if not inv then
            log("EquipBest: no EquipmentInventory")
            return false
        end
        -- รวม item ที่ใส่อยู่ + item ใน inventory แยกตาม slot
        local slots = { Head = {}, Body = {}, Ring = {} }
        for _, v in pairs(inv) do
            if type(v) == "table" and v.GUID and v.Slot and not v.Locked
               and (not v.LevelReq or playerLevel >= v.LevelReq)
               and v.Identified ~= false then
                if slots[v.Slot] then
                    table.insert(slots[v.Slot], v)
                end
            end
        end
        -- เพิ่ม item ที่ใส่อยู่
        local equipped = Data.Equipment or {}
        for _, slotName in ipairs({"Head", "Body", "Ring"}) do
            local eq = equipped[slotName]
            if type(eq) == "table" and eq.GUID and eq.Identified ~= false then
                eq._isEquipped = true
                table.insert(slots[slotName], eq)
            end
        end
        -- หา best item แต่ละ slot แล้ว Equip
        local equippedCount = 0
        for _, slotName in ipairs({"Head", "Body", "Ring"}) do
            local items = slots[slotName]
            if #items > 0 then
                local bestItem = nil
                local bestScore = -1
                for _, item in ipairs(items) do
                    local score = H.scoreEquipItem(item)
                    if score > bestScore then
                        bestScore = score
                        bestItem = item
                    end
                end
                if bestItem and not bestItem._isEquipped then
                    local ok, res = call("EquipmentService", "Equip", bestItem.GUID)
                    if ok then
                        equippedCount = equippedCount + 1
                        log(("EquipBest: %s -> %s (score=%d)"):format(slotName, bestItem.GUID, bestScore))
                    else
                        log(("EquipBest: %s FAILED: %s"):format(slotName, tostring(res)))
                    end
                    task.wait(0.1)
                end
            end
        end
        log(("EquipBest: equipped %d slots"):format(equippedCount))
        return equippedCount > 0
    end

    -- Sell gear: วาร์ปไป SellShop → trigger prompt → SellEquipment(GUIDs)
    -- จาก dump: ShopService:SellEquipment(table ของ GUIDs) ขายทีเดียว
    -- รองรับหลาย rarity: ส่งเป็น string ("Common") หรือ table ({"Common","Uncommon"})
    -- กรอง: ไม่ขายของที่ใส่อยู่ (Equipped) + ไม่ขายของล็อค (Locked)
    -- ทำซ้ำจนกว่าจะไม่มีของที่ตรงเงื่อนไข (ขายจนหมด)
    function H.sellGearByRarity(rarities)
        -- ก่อนขาย, เช็คว่าถ้าเปิด AutoEquipBest ให้ใส่ของที่ดีที่สุดก่อน เผื่อจะได้ไม่ขายของดีไป
        if CFG.AutoEquipBest and H.equipBestGear then
            H.equipBestGear()
            task.wait(0.5) -- รอ server อัพเดท status 
        end

        -- แปลง input เป็น set ของ rarity ที่จะขาย
        local sellSet = {}
        if type(rarities) == "string" then
            sellSet[rarities] = true
        elseif type(rarities) == "table" then
            for k, v in pairs(rarities) do
                if type(k) == "number" and type(v) == "string" and v ~= "" then
                    sellSet[v] = true
                elseif type(k) == "string" and v then
                    sellSet[k] = true
                end
            end
        end
        -- ถ้าไม่มี rarity เลือก = ใช้ Common
        if next(sellSet) == nil then sellSet["Common"] = true end

        -- Step 0: เช็ค inventory ก่อน — มีของที่จะขายไหม? (ไม่วาร์ปถ้าไม่มี)
        local pd = H.getPlayerData()
        if not pd or not pd.Data or not pd.Data.EquipmentInventory then
            log("Sell Gear: no EquipmentInventory")
            return false
        end
        local equipped = pd.Data.Equipment or {}
        local equippedSet = {}
        for _, slotName in ipairs({"Head", "Body", "Ring"}) do
            local eq = equipped[slotName]
            if type(eq) == "table" and eq.GUID then
                equippedSet[eq.GUID] = true
            end
        end
        local hasItemsToSell = false
        for _, v in pairs(pd.Data.EquipmentInventory) do
            if type(v) == "table" and v.GUID and not v.Locked and not equippedSet[v.GUID] then
                if sellSet[v.Rarity] then
                    hasItemsToSell = true
                    break
                end
            end
        end
        if not hasItemsToSell then
            -- ไม่มีของที่จะขาย = ข้าม (ไม่วาร์ป ไม่รบกวน Auto Farm)
            return false
        end
        log("Sell Gear: found items to sell, proceeding...")

        -- Step 1: Equip Best ก่อนขาย (ใส่ของที่ดีที่สุดก่อน = ไม่ขายทิ้ง)
        log("Sell Gear: Equip Best first (before selling)")
        pcall(function() H.equipBestGear() end)
        task.wait(0.5)

        -- Step 2 & 3 (Warp and Prompt Trigger) have been removed to make selling fully remote.

        -- Step 4: ขายซ้ำจนกว่าจะไม่มีของที่ตรงเงื่อนไข
        local totalSold = 0
        local maxRounds = 10  -- ป้องกัน infinite loop
        for round = 1, maxRounds do
            pd = H.getPlayerData()
            if not pd or not pd.Data or not pd.Data.EquipmentInventory then
                log("Sell Gear: no EquipmentInventory (round " .. round .. ")")
                break
            end
            local Data = pd.Data
            local inv = Data.EquipmentInventory
            equipped = Data.Equipment or {}
            -- สร้าง set ของ GUID ที่ใส่อยู่ (ไม่ขาย)
            equippedSet = {}
            for _, slotName in ipairs({"Head", "Body", "Ring"}) do
                local eq = equipped[slotName]
                if type(eq) == "table" and eq.GUID then
                    equippedSet[eq.GUID] = true
                end
            end
            -- หา item ที่จะขาย: rarity ตรงกับที่เลือก + ไม่ใส่อยู่ + ไม่ล็อค
            local toSell = {}
            for _, v in pairs(inv) do
                if type(v) == "table" and v.GUID and not v.Locked and not equippedSet[v.GUID] then
                    if sellSet[v.Rarity] then
                        table.insert(toSell, v.GUID)
                    end
                end
            end
            if #toSell == 0 then
                log(("Sell Gear: round %d - no more items to sell (total sold: %d)"):format(round, totalSold))
                break
            end
            log(("Sell Gear: round %d - selling %d items"):format(round, #toSell))
            local ok, res = call("ShopService", "SellEquipment", toSell)
            log(("Sell Gear: round %d - SellEquipment ok=%s res=%s"):format(round, tostring(ok), tostring(res)))
            if ok then
                totalSold = totalSold + #toSell
            else
                log(("Sell Gear: round %d FAILED, stopping"):format(round))
                break
            end
            task.wait(0.5)  -- รอ server update inventory
        end
        log(("Sell Gear: total sold %d items"):format(totalSold))
        return totalSold > 0
    end

