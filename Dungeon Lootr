    -- Format number with commas (e.g. 1500000 -> 1,500,000)
    function H.formatCoins(n)
        local s = tostring(math.floor(n or 0))
        local out = ""
        local len = #s
        for i = 1, len do
            if i > 1 and (len - i + 1) % 3 == 0 then out = out .. "," end
            out = out .. s:sub(i, i)
        end
        return out
    end

    -- Auto Up Stat loop (allocate 1 point at a time cycling through selected stats until SP empty)
    H._upStatThread = nil
    H._upStatGen = 0  -- generation token: orphan threads from older toggles must die
    function H.stopAutoUpStat()
        H._upStatGen = H._upStatGen + 1
        if H._upStatThread then
            task.cancel(H._upStatThread)
            H._upStatThread = nil
        end
    end
    function H.startAutoUpStat()
        H.stopAutoUpStat()
        -- Build codes from EnabledStats (fallback to UpStatTypes)
        -- "Recommended" resolves live each allocation so it follows class swaps
        local codes = {}
        if CFG.EnabledStats then
            for _, stat in ipairs({ "Recommended", "STR", "DEX", "INT", "VIT", "LCK" }) do
                if CFG.EnabledStats[stat] then
                    table.insert(codes, stat)
                end
            end
        end
        if #codes == 0 then
            -- Fallback to UpStatTypes
            for _, s in ipairs(CFG.UpStatTypes or {}) do
                table.insert(codes, H.StatNameToCode[s] or s)
            end
        end
        if #codes == 0 then codes = { "DEX" } end
        log(("Auto Stats started (stats=%s speed=%ss)"):format(table.concat(codes, ","), tostring(CFG.StatAllocSpeed or 0.3)))
        local allocated = 0
        local idx = 1
        local myGen = H._upStatGen
        H._upStatThread = task.spawn(function()
            while CFG.AutoUpStat and H._upStatGen == myGen and not S.PartyUnloaded do
                -- Don't spam the remote when there are no points to spend
                local sp
                pcall(function()
                    local pd = H.getPlayerData()
                    sp = pd and pd.Data and pd.Data.UnspentSkillPoints
                end)
                if type(sp) == "number" and sp <= 0 then
                    if allocated > 0 then
                        log(("Auto Stats: allocated %d points (SP depleted)"):format(allocated))
                        allocated = 0
                    end
                    for i = 1, 10 do
                        if not CFG.AutoUpStat or H._upStatGen ~= myGen then break end
                        task.wait(0.5)
                    end
                    continue
                end
                -- Cycle through selected stats
                local code = codes[((idx - 1) % #codes) + 1]
                if code == "Recommended" then
                    code = H.recommendedStatCode()
                end
                local ok = H.upStat(code)
                if not ok then
                    -- No more SP - wait but check more frequently for stop
                    if allocated > 0 then
                        log(("Auto Stats: allocated %d points (SP depleted)"):format(allocated))
                        allocated = 0
                    end
                    for i = 1, 10 do
                        if not CFG.AutoUpStat or H._upStatGen ~= myGen then break end
                        task.wait(0.5)
                    end
                else
                    allocated = allocated + 1
                    idx = idx + 1
                    task.wait(CFG.StatAllocSpeed or 0.3)
                end
            end
            if allocated > 0 then
                log(("Auto Stats: allocated %d points"):format(allocated))
            end
            if H._upStatGen == myGen then H._upStatThread = nil end
        end)
    end

