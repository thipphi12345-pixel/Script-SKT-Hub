        function Library:OptimizeScrolling()
            local window = self.Window
            if window and window.Finalize then
                pcall(function() window:Finalize() end)
            end
            local pages = window and window.Pages
            if not pages then return end

            for _, page in ipairs(pages:GetChildren()) do
                if page:IsA("ScrollingFrame") and not page:GetAttribute("GakuranScrollOptimized") then
                    local layout = page:FindFirstChildOfClass("UIListLayout")
                    if layout then
                        page:SetAttribute("GakuranScrollOptimized", true)
                        page.ScrollingDirection = Enum.ScrollingDirection.Y
                        page.ElasticBehavior = Enum.ElasticBehavior.Always
                        page.ScrollBarThickness = 3
                        page.AutomaticCanvasSize = Enum.AutomaticSize.Y
                        page.CanvasSize = UDim2.fromOffset(0, 140) -- Generous bottom margin for phone/touch

                        local updateQueued = false
                        local function UpdateCanvas()
                            if updateQueued then return end
                            updateQueued = true
                            task.defer(function()
                                updateQueued = false
                                if not page.Parent or not layout.Parent then return end
                                local contentH = layout.AbsoluteContentSize.Y
                                for _, child in ipairs(page:GetChildren()) do
                                    if child:IsA("GuiObject") and child.Visible and child ~= layout then
                                        local childBottom = child.Position.Y.Offset + child.AbsoluteSize.Y
                                        if childBottom > contentH then contentH = childBottom end
                                    end
                                end
                                page.CanvasSize = UDim2.fromOffset(0, math.max(contentH + 140, 300))
                            end)
                        end

                        UpdateCanvas()
                        local connection = layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(UpdateCanvas)
                        local descConn = page.DescendantAdded:Connect(function() task.delay(0.1, UpdateCanvas) end)
                        local descRem = page.DescendantRemoving:Connect(function() task.delay(0.1, UpdateCanvas) end)
                        if window.Connections then
                            table.insert(window.Connections, connection)
                            table.insert(window.Connections, descConn)
                            table.insert(window.Connections, descRem)
                        end
                    end
                end
            end
        end

        function Library:SetTheme(presetName, customAccent)
            -- Every preset keeps the same obsidian base and only swaps the accent
            -- ramp, so `White` stays "text on an Ink surface" in all of them.
            local accents = {
                Gold = Color3.fromRGB(214, 183, 124),
                Sapphire = Color3.fromRGB(123, 169, 233),
                Amethyst = Color3.fromRGB(177, 153, 229),
                Jade = Color3.fromRGB(117, 197, 178),
                Crimson = Color3.fromRGB(225, 139, 151),
                Mono = Color3.fromRGB(196, 204, 218),
                Cyber = Color3.fromRGB(117, 205, 217),
            }
            local requested = tostring(presetName or "Gold")
            if requested == "Custom" then
                local ok, color = pcall(Color3.fromHex, tostring(customAccent or "7BA9E9"))
                if ok then
                    local h, s, v = color:ToHSV()
                    accents.Custom = Color3.fromHSV(h, math.min(s, 0.72), math.clamp(v, 0.65, 0.92))
                    for key, fixed in pairs(self.UI.BaseTheme) do
                        if not key:find("Accent", 1, true) and accents.Custom == fixed then
                            accents.Custom = Color3.new(math.min(fixed.R + 1 / 255, 0.99), fixed.G, fixed.B)
                            break
                        end
                    end
                end
            end
            local wantedName = accents[requested] and requested or "Gold"
            local wanted = table.clone(self.UI.BaseTheme)
            wanted.Accent = accents[wantedName]
            wanted.AccentGlow = wanted.Accent:Lerp(wanted.White, 0.25)
            wanted.AccentDeep = wanted.Accent:Lerp(wanted.Paper, 0.55)
            wanted.AccentSoft = wanted.Accent:Lerp(wanted.White, 0.4)
            wanted.AccentBright = wanted.Accent:Lerp(wanted.White, 0.6)
            local liveTheme = self.UI and self.UI.Theme
            if type(liveTheme) ~= "table" then return false end
            self.UI.FinishTweens()

            local previous = {}
            for key, nextColor in pairs(wanted) do
                previous[key] = liveTheme[key]
                liveTheme[key] = nextColor
            end

            local window = self.Window
            local screen = window and window.Screen
            if screen then
                local objects = { screen }
                for _, descendant in ipairs(screen:GetDescendants()) do
                    objects[#objects + 1] = descendant
                end

                local function TranslateColor(object, property)
                    if property == "BackgroundColor3" and object:GetAttribute("ThemeFixedColor") then return end
                    local ok, current = pcall(function() return object[property] end)
                    if not ok or typeof(current) ~= "Color3" then return end
                    for key, oldColor in pairs(previous) do
                        if typeof(oldColor) == "Color3" and current == oldColor then
                            pcall(function() object[property] = wanted[key] end)
                            return
                        end
                    end
                end

                for _, object in ipairs(objects) do
                    TranslateColor(object, "BackgroundColor3")
                    TranslateColor(object, "TextColor3")
                    TranslateColor(object, "ScrollBarImageColor3")
                    TranslateColor(object, "BorderColor3")
                    TranslateColor(object, "ImageColor3")
                    TranslateColor(object, "PlaceholderColor3")
                    if object:IsA("UIStroke") then
                        TranslateColor(object, "Color")
                    elseif object:IsA("UIGradient") then
                        local points = {}
                        for _, point in ipairs(object.Color.Keypoints) do
                            local color = point.Value
                            for key, oldColor in pairs(previous) do
                                if color == oldColor then color = wanted[key] break end
                            end
                            points[#points + 1] = ColorSequenceKeypoint.new(point.Time, color)
                        end
                        object.Color = ColorSequence.new(points)
                    end
                end
                table.clear(objects)
            end

            -- Gradients hold a baked ColorSequence, so the Color3 sweep above
            -- cannot touch them; rebuild the accent ramp explicitly.
            if window and type(window.AccentGradients) == "table" then
                local ramp = ColorSequence.new({
                    ColorSequenceKeypoint.new(0, wanted.AccentSoft or wanted.Accent),
                    ColorSequenceKeypoint.new(0.5, wanted.AccentBright or wanted.Accent),
                    ColorSequenceKeypoint.new(1, wanted.AccentSoft or wanted.Accent),
                })
                for _, gradient in ipairs(window.AccentGradients) do
                    if gradient.Parent then pcall(function() gradient.Color = ramp end) end
                end
            end

            self.CurrentTheme = wantedName
            self.ThemeRevision = (self.ThemeRevision or 0) + 1
            return true
        end

