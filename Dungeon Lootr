    H.isChestLocked = function(m)
        if not (m and m:IsA("Model")) then return true end
        if m:GetAttribute("Locked") == true or m:GetAttribute("RequiresKey") == true then return true end
        if m.Parent and m.Parent.Name:lower():find("lock") then return true end
        local lock = m:FindFirstChild("Chest_Lock")
        if lock and lock:IsA("Model") then return true end
        local prompt = m:FindFirstChild("ChestPrompt", true) or m:FindFirstChildOfClass("ProximityPrompt")
        if not prompt or not prompt.Enabled then return true end
        local at = (prompt.ActionText or ""):lower()
        local ot = (prompt.ObjectText or ""):lower()
        if at:find("lock") or at:find("key") or ot:find("lock") or ot:find("key") then
            return true
        end
        return false
    end

    -- Anti-cheat: ChestZoneWarp fires when a chest is claimed while combat
    -- rooms before it are still uncleared on the server. Resolve the chest's
    -- owning room as the NEAREST room, then require every normal room up to it
    -- to be completed on the server (S.Zones) — or locally cleared when zone
    -- data is absent (nil zone must NOT silently pass).
    H.chestSafeToOpen = function(chestPos)
        local rooms = H.orderedRooms()
        if #rooms == 0 then return true end
        local chestIdx = math.huge
        local bestDist = math.huge
        for _, rm in ipairs(rooms) do
            local d = (rm.Pos - chestPos).Magnitude
            if d < bestDist then
                bestDist = d
                chestIdx = rm.Index
            end
        end
        -- Chest not near any known room -> every room counts as "before" it
        if bestDist > (CFG.RoomRadius or 60) * 1.5 then chestIdx = math.huge end
        for _, rm in ipairs(rooms) do
            if not rm.IsBoss and rm.Index <= chestIdx then
                local serverZone = S.Zones and S.Zones[rm.Index]
                if serverZone then
                    if serverZone.Completed ~= true then return false end
                elseif not S.Cleared[rm.Model] then
                    return false
                end
            end
        end
        return true
    end

    -- เธงเธฒเธฃเนเธเนเธเน€เธเนเธ Chests เธ•เธฒเธกเธซเนเธญเธเธ•เนเธฒเธเน เธ—เธตเนเธกเธต Chests เนเธซเนเน€เธเนเธ (เธเนเธฒเธกเธซเธตเธเธ—เธตเนเธฅเนเธญเธเนเธฅเธฐเธซเธตเธเธเธญเธเนเธกเธ)
    H.collectAllDungeonChests = function()
        if not S.Running then return end
        local df = H.dungeonFolder()
        if not df then return end
        local rooms = H.orderedRooms()
        if #rooms == 0 then return end

        log("sweeping dungeon for chests...")
        -- หยุด combat ก่อนเก็บ chest
        S.ChestBusy = true
        S.Target = nil
        S.LockedTarget = nil
        S.WarpedTarget = nil
        if stopHoverLock then stopHoverLock() end

        local chests = {}
        local seen = {}

        local function addChest(c)
            if c and c:IsA("Model") and not seen[c] and c.Name:find("Chest") and not c.Name:find("Selection") then
                if c.Parent and c.Parent.Name:lower():find("lock") then return end
                local p = c:GetPivot().Position
                -- ChestZoneWarp safety: skip if any earlier combat room is still
                -- uncleared on the server (handles nil-zone data strictly too)
                if not H.chestSafeToOpen(p) then return end
                seen[c] = true
                table.insert(chests, c)
            end
        end

        for _, c in ipairs(df:GetChildren()) do addChest(c) end
        for _, rm in ipairs(rooms) do
            for _, c in ipairs(rm.Model:GetChildren()) do addChest(c) end
        end

        local opened = 0
        for _, ch in ipairs(chests) do
            if not S.Running then break end
            if ch and ch.Parent and not H.isChestLocked(ch) and not S.LootedChests[ch] then
                local prompt = ch:FindFirstChild("ChestPrompt", true) or ch:FindFirstChildOfClass("ProximityPrompt")
                if prompt and prompt.Enabled then
                    local p = ch:GetPivot().Position
                    H.warpTo(p + Vector3.new(0, 3, 0))
                    task.wait(0.3)
                    H.triggerPrompt(prompt)
                    S.LootedChests[ch] = true
                    opened = opened + 1
                    task.wait(0.4)
                end
            end
        end
        if opened > 0 then
            log(("looted %d chest(s) across dungeon"):format(opened))
        else
            log("no unlocked chests remaining")
        end
        -- ปล่อย flag ให้ combat ทำงานต่อ
        S.ChestBusy = false
    end

    -- Collect chests in a specific room (called after clearing each room)
    H.collectChestsInRoom = function(roomModel)
        if not S.Running then return end
        if not roomModel then return end
        local opened = 0
        for _, c in ipairs(roomModel:GetDescendants()) do
            if not S.Running then break end
            if c:IsA("Model") and c.Name:find("Chest") and not c.Name:find("Selection")
                and not H.isChestLocked(c) and not S.LootedChests[c]
                and H.chestSafeToOpen(c:GetPivot().Position) then
                local prompt = c:FindFirstChild("ChestPrompt", true) or c:FindFirstChildOfClass("ProximityPrompt")
                if prompt and prompt.Enabled then
                    local p = c:GetPivot().Position
                    S.ChestBusy = true
                    H.warpTo(p + Vector3.new(0, 3, 0))
                    task.wait(0.3)
                    H.triggerPrompt(prompt)
                    S.LootedChests[c] = true
                    opened = opened + 1
                    task.wait(0.4)
                end
            end
        end
        -- Also check Generated_* direct children near this room
        local df = H.dungeonFolder()
        if df then
            local rmPos = H.roomPos(roomModel)
            for _, c in ipairs(df:GetChildren()) do
                if not S.Running then break end
                if c:IsA("Model") and c.Name:find("Chest") and not c.Name:find("Selection")
                    and not H.isChestLocked(c) and not S.LootedChests[c] then
                    local p = c:GetPivot().Position
                    -- Check radius carefully to avoid collecting chests from the NEXT room (cross-room bleeding)
                    if rmPos and (rmPos - p).Magnitude <= CFG.RoomRadius * 1.5 then
                        local prompt = c:FindFirstChild("ChestPrompt", true) or c:FindFirstChildOfClass("ProximityPrompt")
                        if prompt and prompt.Enabled and H.chestSafeToOpen(p) then
                            S.ChestBusy = true
                            H.warpTo(p + Vector3.new(0, 3, 0))
                            task.wait(0.3)
                            H.triggerPrompt(prompt)
                            S.LootedChests[c] = true
                            opened = opened + 1
                            task.wait(0.4)
                        end
                    end
                end
            end
        end
        if opened > 0 then
            log(("looted %d chest(s) in %s"):format(opened, roomModel.Name))
        end
        S.ChestBusy = false
    end

    H.handleBuffSelection = function(candidates)
        if S._buffSelectHandledByFunc then return end
        S._buffSelectHandledByFunc = true
        task.spawn(function()
            if type(candidates) == "table" and #candidates > 0 then
                log(("Blessing: BuffSelection received %d candidates"):format(#candidates))
            end
            -- Human-like read time before picking (instant 0.1s selection is a flag signature)
            task.wait(0.6 + math.random() * 0.8)
            pcall(function()
                local pg = LP:FindFirstChild("PlayerGui")
                local main = pg and pg:FindFirstChild("Main")
                local hud = main and main:FindFirstChild("HUD")
                local bs = hud and hud:FindFirstChild("Boost_Selection")

                -- Determine which priority list to use
                local isChallenge = H.inChallenge and H.inChallenge() or (workspace:FindFirstChild("Challenge_Dungeons") ~= nil)
                local priorityList = CFG.BlessingPriorityDungeon
                if isChallenge then
                    priorityList = CFG.BlessingPriorityChallenge
                elseif H.inPayload() then
                    priorityList = CFG.BlessingPriorityPayload or CFG.BlessingPriorityDungeon
                elseif S.EndlessMode then
                    priorityList = CFG.BlessingPriorityEndless or CFG.BlessingPriorityDungeon
                elseif CFG.AutoFarmLVL then
                    priorityList = CFG.BlessingPriorityAutoFarmLVL or CFG.BlessingPriorityDungeon
                end

                local cardTitles = {}
                if type(candidates) == "table" then
                    for i = 1, 3 do
                        if candidates[i] and candidates[i].Title then
                            cardTitles[i] = candidates[i].Title
                        end
                    end
                end
                -- Fallback: read from UI
                if not cardTitles[1] and bs and bs.Visible then
                    for i = 1, 3 do
                        local card = bs:FindFirstChild("Boost_" .. i)
                        if card then
                            local title = card:FindFirstChild("Title")
                            cardTitles[i] = title and title.Text or ""
                        end
                    end
                end

                local function norm(s) return (s or ""):lower():gsub("%s+", ""):gsub("'", "") end

                log(("Blessing: cards=[%s|%s|%s] priority=[%s]"):format(
                    cardTitles[1] or "?", cardTitles[2] or "?", cardTitles[3] or "?",
                    table.concat(priorityList, ",")))

                local selectedIdx = nil
                for _, prefName in ipairs(priorityList) do
                    if prefName and prefName ~= "None" then
                        local normPref = norm(prefName)
                        if normPref ~= "" then
                            for i = 1, 3 do
                                local normTitle = norm(cardTitles[i])
                                if normTitle ~= "" and normTitle == normPref then
                                    selectedIdx = i
                                    log(("Blessing: priority '%s' exact matched card %d ('%s')"):format(prefName, i, cardTitles[i]))
                                    break
                                end
                            end
                        end
                    end
                    if selectedIdx then break end
                end

                if not selectedIdx then
                    for _, prefName in ipairs(priorityList) do
                        if prefName and prefName ~= "None" then
                            local normPref = norm(prefName)
                            if normPref ~= "" and #normPref >= 4 then
                                for i = 1, 3 do
                                    local normTitle = norm(cardTitles[i])
                                    if normTitle ~= "" and (normTitle:find(normPref, 1, true) or normPref:find(normTitle, 1, true)) then
                                        selectedIdx = i
                                        log(("Blessing: priority '%s' partial matched card %d ('%s')"):format(prefName, i, cardTitles[i]))
                                        break
                                    end
                                end
                            end
                        end
                        if selectedIdx then break end
                    end
                end

                if not selectedIdx then
                    selectedIdx = 1
                    log(("Blessing: no priority match -> auto-select card 1 ('%s')"):format(cardTitles[1] or "?"))
                end

                if bs and bs.Visible then
                    local card = bs:FindFirstChild("Boost_" .. selectedIdx)
                    if card and card:IsA("GuiButton") and firesignal then
                        pcall(function() firesignal(card.MouseButton1Click) end)
                        task.wait(0.6)
                    end
                end

                -- Direct remote only as fallback when the card click didn't dismiss
                -- the selection UI — clicking + remote together double-fires
                -- SelectBuff, which is a server-visible anomaly.
                if not bs or bs.Visible then
                    local dbs = H.svc("DungeonBuffService")
                    if dbs and dbs.SelectBuff then
                        pcall(function() dbs:SelectBuff(selectedIdx):await() end)
                        log(("Blessing: SelectBuff(%d) called via Knit (UI fallback)"):format(selectedIdx))
                    else
                        pcall(function()
                            game:GetService("ReplicatedStorage").Packages._Index["sleitnick_knit@1.7.0"].knit.Services.DungeonBuffService.RF.SelectBuff:InvokeServer(selectedIdx)
                            log(("Blessing: SelectBuff(%d) called via RemoteFunction (UI fallback)"):format(selectedIdx))
                        end)
                    end
                end
            end)
            if inRun() and (S.Phase == "Dungeon" or S.Phase == "Normal") then
                S.BlessingDone = true
            end
            task.wait(1)
            S._buffSelectHandledByFunc = false
        end)
    end

    -- เน€เธฅเธทเธญเธ 2 Chests เธญเธฑเธ•เนเธเธกเธฑเธ•เธดเน€เธกเธทเนเธญเธเธเธ”เธฑเธเน€เธเธตเนเธขเธ (เธ—เธฑเนเธเธเนเธฒเธ Remote, Controller, เนเธฅเธฐ UI เธเธฅเธดเธ)
    H.handleChestSelection = function()
        if not S.Running then return end
        -- Reentry guard: event hook, GUI watcher, and main loop can all call this
        if S._chestSelecting and tick() - S._chestSelecting < 5 then return end
        S._chestSelecting = tick()
        local max = CFG.MaxChestPicks or 2
        log(("Auto-selecting %d chests (mode=%s)..."):format(max, S.BossRushMode and "BossRush" or "Dungeon"))

        -- กำหนด service + remote ตามด่านปัจจุบัน (ใช้ได้ทุกด่าน)
        local serviceName = "DungeonRunService"
        local remoteName = "SelectChests"
        if S.BossRushMode then
            serviceName = "BossRushService"
            remoteName = "SelectFloorChests"
        elseif H.inChallenge and H.inChallenge() then
            serviceName = "ChallengeRunService"
            remoteName = "SelectChests"
        end

        -- 1. เรียก Remote โดยตรง
        local picks = {}
        for i = 1, max do table.insert(picks, i) end
        local ok, res = call(serviceName, remoteName, picks)
        log(("%s.%s %s -> %s"):format(serviceName, remoteName, tostring(picks), tostring(ok and res or res)))

        -- If the remote was accepted, confirm the selection UI dismissed.
        -- The controller/UI paths below are fallbacks only — running all three
        -- unconditionally fires the same selection remotes multiple times.
        if ok then
            task.wait(0.8)
            local pg = LP:FindFirstChild("PlayerGui")
            local main = pg and pg:FindFirstChild("Main")
            local hud = main and main:FindFirstChild("HUD")
            local cs = hud and hud:FindFirstChild("Chest_Selection")
            if not (cs and cs.Visible) then return end
            log("Chest_Selection still visible after remote -> fallback")
        end

        -- 2. สั่งผ่าน Knit Controller (ใช้ได้ทุกด่าน — controller เดียวกัน)
        pcall(function()
            local csc = Knit and Knit.GetController("ChestSelectionController")
            if csc and csc._active then
                for _ = 1, 20 do
                    if csc._ready then break end
                    task.wait(0.1)
                end
                for i = 1, max do
                    pcall(function() csc:_SelectChest(i) end)
                    task.wait(0.2)
                end
                task.wait(0.3)
                if csc._OnFinish then csc:_OnFinish() end
                log("Chest selection: finished via controller")
            end
        end)

        -- 3. คลิกปุ่มใน UI HUD.Chest_Selection (fallback)
        pcall(function()
            local pg = LP:FindFirstChild("PlayerGui")
            local main = pg and pg:FindFirstChild("Main")
            local hud = main and main:FindFirstChild("HUD")
            local cs = hud and hud:FindFirstChild("Chest_Selection")
            if cs and cs.Visible then
                for i = 1, max do
                    local c = cs:FindFirstChild("Chest_" .. i)
                    if c and c:IsA("GuiButton") and firesignal then firesignal(c.MouseButton1Click) end
                    task.wait(0.15)
                end
                local finish = cs:FindFirstChild("Finish")
                if finish and finish:IsA("GuiButton") and finish.Visible and firesignal then
                    task.wait(0.15)
                    firesignal(finish.MouseButton1Click)
                end
            end
        end)
    end

    -- โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€ Server-event hooks โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€โ”€
    H.hookRunEvents = function()
        local drs = { }
        for _, n in ipairs({"StateUpdate", "RoomLayoutUpdate", "ZoneEntered", "DungeonComplete", "ChestSelection", "EndlessDecision"}) do
            drs[n] = evt("DungeonRunService", n)
        end
        do
            -- StateUpdate(phase, left, total, roomIdx, totalRooms)  โ€” DungeonHUDController:3070
            -- StateUpdate(phase, left, total, roomIdx, totalRooms)  — DungeonHUDController:3070
            connect(drs.StateUpdate, function(phase, left, total, roomIdx, totalRooms)
                S.Phase, S.EnemiesLeft, S.EnemiesTotal = phase, left, total
                S.RoomIdx, S.TotalRooms = roomIdx or S.RoomIdx, totalRooms or S.TotalRooms
                S.ProgressTick = tick()

                -- —— รอให้ Dungeon โหลดเสร็จก่อน (ต้องมีส่วนประกอบอย่างน้อย 5 อย่างขึ้นไป) ——
                local dfLoad = H.dungeonFolder()
                local waitedLoad = 0
                while dfLoad and #dfLoad:GetChildren() < 5 and waitedLoad < 10 and S.Running and inRun() do
                    task.wait(1)
                    waitedLoad = waitedLoad + 1
                end

                -- Note: Blessing_Altar early-warp removed from StateUpdate.
            end)
            -- RoomLayoutUpdate(zones, curIdx) — :3086 ; zones[i] = {Index, IsBoss, Completed}
            connect(drs.RoomLayoutUpdate, function(zones, cur)
                if type(zones) == "table" then
                    S.Zones = {}
                    for _, z in ipairs(zones) do
                        if type(z) == "table" and z.Index then
                            S.Zones[z.Index] = { IsBoss = z.IsBoss == true, Completed = z.Completed == true }
                        end
                    end
                end
                if cur then S.RoomIdx = cur end
                S.ProgressTick = tick()
            end)
            connect(drs.ZoneEntered, function(idx)
                if idx then S.RoomIdx = idx end
                S.ProgressTick = tick()
            end)
            -- DungeonComplete({Status="Cleared"/"Failed"/"Extracted", IsVictory, Source}) — :3175
            connect(drs.DungeonComplete, function(info)
                S.Complete = type(info) == "table" and info or { Status = "Cleared" }
                log("DungeonComplete: " .. tostring(S.Complete.Status))
            end)
            -- EndlessDecision({Seconds, ExtensionIndex, NextMult}) — fires at Endless checkpoint
            -- Auto Continue/Extract based on AutoEndlessCheckpoint + ExtractAtDepth settings
            connect(drs.EndlessDecision, function(info)
                if not (S.Running and CFG.AutoFarmEndless and CFG.AutoEndlessCheckpoint) then return end
                
                S.EndlessBusy = true -- Pause farming loop
                
                if type(info) ~= "table" then info = {} end
                local checkpoint = (info.ExtensionIndex or 0) + 1
                local shouldExtract = false
                if CFG.ExtractAtDepth and checkpoint >= (CFG.EndlessDepth or 10) then
                    shouldExtract = true
                    log(("Endless checkpoint %d >= depth %d -> Extract"):format(checkpoint, CFG.EndlessDepth or 10))
                else
                    log(("Endless checkpoint %d -> Continue"):format(checkpoint))
                end
                
                -- Wait for chest collection to finish before submitting
                local waitTime = 0
                while S.ChestBusy and waitTime < 10 do
                    task.wait(0.5)
                    waitTime = waitTime + 0.5
                end

                -- Submit immediately (game has its own timeout)
                H.submitEndlessChoice(not shouldExtract)
                -- Update progress tick to prevent stall watchdog
                S.ProgressTick = tick()
                
                -- Wait for new room to generate and character to teleport safely
                task.wait(3.5)
                
                -- Reset auditing state for the new room
                S.ProbeRoom = nil
                S.ForceAudited = false
                S.EndlessBusy = false -- Resume farming
            end)
            -- หีบ: ChestSelection(chests, maxPicks) — ChestSelectionController:703-710
            connect(drs.ChestSelection, function(chests, maxPicks)
                task.wait(0.6)
                H.handleChestSelection()
            end)
        end

        -- GUI watcher: auto-select chests when Chest_Selection GUI becomes visible
        -- (fallback in case the server event doesn't fire or fires too early)
        task.spawn(function()
            while S.Running do
                task.wait(0.5)
                if not S.Running then break end
                local pg = LP:FindFirstChild("PlayerGui")
                local main = pg and pg:FindFirstChild("Main")
                local hud = main and main:FindFirstChild("HUD")
                local cs = hud and hud:FindFirstChild("Chest_Selection")
                if cs and cs.Visible and not S._chestSelectHandled then
                    S._chestSelectHandled = true
                    log("Chest_Selection GUI detected -> auto-selecting")
                    task.wait(0.5)
                    H.handleChestSelection()
                    task.wait(2)
                    S._chestSelectHandled = false
                elseif cs and not cs.Visible then
                    S._chestSelectHandled = false
                end
            end
        end)
        -- Blessing/Buff: DungeonBuffService.BuffSelection -> click UI card
        -- Iterate through BlessingPriority list, pick first match from 3 shown cards
        local dbs = H.svc("DungeonBuffService")
        connect(evt("DungeonBuffService", "BuffSelection"), function(candidates)
            if not S.Running then return end
            H.handleBuffSelection(candidates)
        end)

        -- Blessing/Buff GUI Watcher: auto-select buff when Boost_Selection GUI becomes visible
        -- (fallback in case the server event doesn't fire or fires too early)
        task.spawn(function()
            while S.Running do
                task.wait(0.25)
                if not S.Running then break end
                local pg = LP:FindFirstChild("PlayerGui")
                local main = pg and pg:FindFirstChild("Main")
                local hud = main and main:FindFirstChild("HUD")
                local bs = hud and hud:FindFirstChild("Boost_Selection")
                if bs and bs.Visible and not S._buffSelectHandled then
                    S._buffSelectHandled = true
                    log("Boost_Selection GUI detected -> auto-selecting")
                    task.wait(0.15)
                    H.handleBuffSelection(nil)
                    task.wait(1)
                    S._buffSelectHandled = false
                elseif bs and not bs.Visible then
                    S._buffSelectHandled = false
                end
            end
        end)
        -- Auto Boss Dodge: hook BossHealthUpdate จากทุก service (Dungeon/Challenge/BossRush/Raid)
        -- BossHealthUpdate(currentHP, maxHP, bossName, bossType) — ส่งชื่อบอสมาตอนบอสเกิด
        for _, svcName in ipairs({"DungeonRunService", "ChallengeRunService", "BossRushService", "RaidRunService"}) do
            local bossEvent = evt(svcName, "BossHealthUpdate")
            if bossEvent then
                connect(bossEvent, function(currentHP, maxHP, bossName, bossType)
                    if not (S.Running and CFG.AutoBossDodge) then return end
                    if not bossName then return end
                    -- ไม่ log ทุกครั้ง — setupBossTracking จะ log เองถ้าเป็นบอสใหม่
                    H.setupBossTracking(bossName)
                end)
            end
        end
        -- Auto Chest Selection: hook ChestSelection จาก Challenge/Endless/Raid (Dungeon และ BossRush มีแล้ว)
        for _, svcName in ipairs({"ChallengeRunService", "RaidRunService"}) do
            local chestEvent = evt(svcName, "ChestSelection")
            if chestEvent then
                connect(chestEvent, function(chests, maxPicks)
                    if not S.Running then return end
                    log(("%s: ChestSelection event (chests=%d maxPicks=%s)"):format(
                        svcName,
                        type(chests) == "table" and #chests or 0,
                        tostring(maxPicks)))
                    task.wait(0.25)
                    H.handleChestSelection()
                end)
            end
        end
        -- Anti-AFK
        connect(LP.Idled, function()
            pcall(function()
                VirtualUser:CaptureController()
                VirtualUser:ClickButton2(Vector2.new())
            end)
        end)
        -- Respawn -> reset target/progress + wait for character to fully load
        connect(LP.CharacterAdded, function(newChar)
            S.ProgressTick = tick()
            S.Respawning = true
            S.WarpedTarget = nil
            -- Stop hover lock during respawn (prevent warp to mob while loading)
            if stopHoverLock then stopHoverLock() end
            -- Restore collision (new character starts fresh)
            H.setFullNoclip(false)
            log("Respawn: character loading - pausing combat")
            -- Wait for HumanoidRootPart to be available
            pcall(function()
                newChar:WaitForChild("HumanoidRootPart", 10)
            end)
            -- Wait for Humanoid to be available and alive
            local hum2 = newChar:WaitForChild("Humanoid", 10)
            if hum2 then
                -- Wait until Health > 0 (fully spawned)
                local waitTick = tick()
                while hum2.Health <= 0 and (tick() - waitTick) < 5 do
                    task.wait(0.2)
                end
            end
            -- Additional buffer: let client fully sync (prevents "stuck/frozen" bug)
            task.wait(2)
            S.Respawning = false
            log("Respawn: character ready - resuming combat")
        end)
    end

