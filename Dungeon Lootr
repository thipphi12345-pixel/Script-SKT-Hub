    -- ============================================================
    -- Dynamic content lists (auto-update): merge hardcoded fallbacks with
    -- live game data modules so new dungeons/bosses/classes/buffs
    -- appear in dropdowns automatically when the game updates.
    -- ============================================================
    local _dataModCache = {}
    local function gameData(name)
        if _dataModCache[name] ~= nil then
            return _dataModCache[name] or nil
        end
        local mod
        pcall(function()
            local gi = ReplicatedStorage:FindFirstChild("GameInfo")
            local m = gi and gi:FindFirstChild(name)
            if m and m:IsA("ModuleScript") then mod = require(m) end
        end)
        if not mod then
            pcall(function()
                local inst = ReplicatedStorage:FindFirstChild(name, true)
                if inst and inst:IsA("ModuleScript") then mod = require(inst) end
            end)
        end
        if not mod and name == "Class_Data" then mod = H.ClassData end
        if not mod and name == "Enemy_Data" then mod = H.EnemyData end
        _dataModCache[name] = mod or false
        return mod
    end

    -- merge: keep fallback order first (preserves existing selections), append new
    local function mergedValues(fallback, extra)
        local out, seen = {}, {}
        for _, v in ipairs(fallback) do
            if not seen[v] then seen[v] = true; out[#out + 1] = v end
        end
        for _, v in ipairs(extra or {}) do
            if type(v) == "string" and v ~= "" and not seen[v] then
                seen[v] = true; out[#out + 1] = v
            end
        end
        return out
    end

    H.dynamicValues = function(kind, fallback)
        local extra = {}
        if kind == "dungeons" then
            local dd = gameData("DungeonData") or H.DungeonData
            if dd and type(dd.Dungeons) == "table" then
                local list = {}
                H._dungeonKeyByName = H._dungeonKeyByName or {}
                for k, d in pairs(dd.Dungeons) do
                    if type(d) == "table" then
                        -- map every entry (incl. hidden/legacy/challenge) so any
                        -- saved config value still resolves back to a real key
                        H._dungeonKeyByName[tostring(d.DisplayName or k)] = k
                        H._dungeonKeyByName[k] = k
                        if not d.Legacy and not d.ChallengeMode and not d.HideFromSelect then
                            list[#list + 1] = { name = tostring(d.DisplayName or k), order = d.DisplayOrder or 0 }
                        end
                    end
                end
                table.sort(list, function(a, b) return a.order < b.order end)
                for _, e in ipairs(list) do extra[#extra + 1] = e.name end
                -- show only real dungeons: merging the key-name fallback would
                -- duplicate entries (e.g. "Goblins" vs "Goblin's Stronghold")
                if #extra > 0 then return mergedValues({}, extra) end
            end
        elseif kind == "challenge" then
            local cd = gameData("ChallengeData")
            if cd and cd.FEATURED_DUNGEON then extra[#extra + 1] = tostring(cd.FEATURED_DUNGEON) end
            local dd = gameData("DungeonData") or H.DungeonData
            if dd and type(dd.Dungeons) == "table" then
                for k, d in pairs(dd.Dungeons) do
                    if type(d) == "table" and d.ChallengeMode and not d.HideFromSelect then
                        extra[#extra + 1] = tostring(d.DisplayName or k)
                    end
                end
            end
        elseif kind == "raids" then
            local rd = gameData("RaidData")
            if rd and type(rd.Raids) == "table" then
                for k, d in pairs(rd.Raids) do
                    extra[#extra + 1] = tostring((type(d) == "table" and d.DisplayName) or k)
                end
            end
        elseif kind == "raidDifficulties" then
            local rd = gameData("RaidData")
            if rd and type(rd.DIFFICULTY_ORDER) == "table" then
                for _, v in ipairs(rd.DIFFICULTY_ORDER) do extra[#extra + 1] = tostring(v) end
            end
        elseif kind == "bossRushBosses" then
            local bd = gameData("BossRushData")
            if bd and type(bd.FINAL_BOSSES) == "table" then
                if type(bd.FINAL_BOSS_ORDER) == "table" then
                    for _, n in ipairs(bd.FINAL_BOSS_ORDER) do
                        if bd.FINAL_BOSSES[n] then extra[#extra + 1] = tostring(n) end
                    end
                end
                for k in pairs(bd.FINAL_BOSSES) do extra[#extra + 1] = tostring(k) end
            end
        elseif kind == "blessings" then
            local bd = gameData("BuffData")
            if bd and type(bd.Buffs) == "table" then
                for _, b in ipairs(bd.Buffs) do
                    if type(b) == "table" and b.Title then extra[#extra + 1] = tostring(b.Title) end
                end
            end
        elseif kind == "classes" then
            local cd = gameData("Class_Data")
            if cd and cd.GetAllClassNames then
                local ok, names = pcall(function() return cd.GetAllClassNames() end)
                if ok and type(names) == "table" then
                    for _, n in ipairs(names) do extra[#extra + 1] = tostring(n) end
                end
            end
        end
        return mergedValues(fallback, extra)
    end

    -- Resolve a dungeon display name (or legacy/internal key) to the internal
    -- key the server expects for DungeonQueueService:RequestSelectDungeon.
    H.resolveDungeonKey = function(name)
        if type(name) ~= "string" or name == "" then return name end
        local map = H._dungeonKeyByName
        if map and map[name] then return map[name] end
        local dd = gameData("DungeonData") or H.DungeonData
        if dd and type(dd.Dungeons) == "table" then
            for k, d in pairs(dd.Dungeons) do
                if k == name then return k end
                if type(d) == "table" and tostring(d.DisplayName or k) == name then return k end
            end
        end
        return name
    end

