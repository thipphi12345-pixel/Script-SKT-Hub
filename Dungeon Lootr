    -- Flight controller (CFrame lerp + full noclip) — replaces teleport-style warpTo
    -- ใช้ CFrame lerp (smooth interpolation) แทน BodyVelocity
    -- เหตุผล: BodyVelocity เคารพ collision ของ torso/legs → ติดกำแพง → บัคนอกโลก
    -- CFrame lerp ผ่านกำแพงได้ (เหมือนบิน) + ปิด CanCollide ทุก part ตอนบิน

    -- Noclip ทุก part ของ character ตอนบิน (ป้องกันติดกำแพง)
    H.setFullNoclip = function(enabled)
        local char = LP.Character
        if not char then return end
        if enabled then
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") and part.CanCollide then
                    part.CanCollide = false
                end
            end
        else
            -- Let Humanoid naturally restore its limb collisions instead of forcing everything to true
            -- Forcing HumanoidRootPart or Accessories to true breaks character movement
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum then
                hum:ChangeState(Enum.HumanoidStateType.GettingUp)
            end
        end
    end

    -- flyTo: fly to target position using CFrame lerp (smooth, bypasses walls)
    local FLY_STEP_SIZE = 12    -- studs per step (smaller = smoother)
    local FLY_STEP_WAIT = 0.04 -- seconds per step (base — jittered per step; ~265 studs/s, flags never fired on speed)
    local FLY_TIMEOUT = 10     -- max seconds
    local FLY_ARRIVE_DIST = 3  -- studs (considered arrived)

    H.flyTo = function(pos, lookAt)
        local r = hrp()
        if not r then return end
        r.Anchored = false

        local targetPos = typeof(pos) == "Vector3" and pos or pos.Position
        local startPos = r.Position
        local totalDist = (targetPos - startPos).Magnitude

        -- ระยะสั้นมาก -> snap ตรงเลย
        if totalDist <= 5 then
            if lookAt then
                r.CFrame = CFrame.new(targetPos, Vector3.new(lookAt.X, targetPos.Y, lookAt.Z))
            else
                r.CFrame = CFrame.new(targetPos)
            end
            r.AssemblyLinearVelocity = Vector3.zero
            r.AssemblyAngularVelocity = Vector3.zero
            return
        end

        -- หยุด hover lock ก่อนบิน (ป้องกัน conflict)
        if stopHoverLock then stopHoverLock() end

        -- เปิด noclip ทุก part (ป้องกันติดกำแพงตอนบิน)
        H.setFullNoclip(true)

        local lookVec = lookAt and Vector3.new(lookAt.X, targetPos.Y, lookAt.Z) or nil
        local steps = math.ceil(totalDist / FLY_STEP_SIZE)
        local elapsed = 0

        for i = 1, steps do
            if not S.Running then break end
            r = hrp()
            if not r or not r.Parent then break end

            local t = i / steps
            local pos = startPos:Lerp(targetPos, t)

            if lookVec then
                r.CFrame = CFrame.new(pos, lookVec)
            else
                r.CFrame = CFrame.new(pos)
            end
            r.AssemblyLinearVelocity = Vector3.zero
            r.AssemblyAngularVelocity = Vector3.zero

            local stepWait = FLY_STEP_WAIT * (0.75 + math.random() * 0.6)
            task.wait(stepWait)
            elapsed = elapsed + stepWait
            if elapsed > FLY_TIMEOUT then break end
        end

        -- Final snap to target
        r = hrp()
        if r then
            if lookAt then
                r.CFrame = CFrame.new(targetPos, Vector3.new(lookAt.X, targetPos.Y, lookAt.Z))
            else
                r.CFrame = CFrame.new(targetPos)
            end
            r.AssemblyLinearVelocity = Vector3.zero
            r.AssemblyAngularVelocity = Vector3.zero
        end
    end

    -- warpTo: alias to flyTo (backward compat — all call sites use warpTo)
    -- flyTo uses BodyVelocity (flight) instead of teleport-style CFrame stepping
    
    
    H.warpTo = function(pos, lookAt)
