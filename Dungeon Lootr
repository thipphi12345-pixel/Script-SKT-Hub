    -- เน€เธฃเธตเธขเธ RF: Knit proxy (promise -> await) -> fallback RemoteFunction:InvokeServer ; return ok, result
    call = function(svcName, method, ...)
        local args = table.pack(...)
        local s = H.svc(svcName)
        if s and s[method] then
            local ok, res = pcall(function()
                local r = s[method](s, table.unpack(args, 1, args.n))
                if type(r) == "table" and r.await then
                    -- Promise:await() returns (success, data, err) — return data if present, else success
                    local pOk, pData, pErr = r:await()
                    if pData ~= nil then return pData end
                    if pErr ~= nil then return pOk, pErr end
                    return pOk
                end
                return r
            end)
            return ok, res
        end
        local rf = H.rawRemote(svcName, "RF", method)
        if rf and rf:IsA("RemoteFunction") then
            return pcall(function() return rf:InvokeServer(table.unpack(args, 1, args.n)) end)
        end
        return false, "no " .. svcName .. "." .. method
    end

    -- เธ•เนเธญ event: Knit signal (.Connect) เธซเธฃเธทเธญ RemoteEvent.OnClientEvent
    local function connect(signal, fn)
        if not signal then return end
        local ok, c = pcall(function()
            if typeof(signal) == "Instance" then return signal.OnClientEvent:Connect(fn) end
            return signal:Connect(fn)
        end)
        if ok and c then table.insert(S.Conns, c) end
    end

