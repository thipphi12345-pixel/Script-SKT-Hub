function Gakuran.GetNPCs()
    local found = {}
    for _, m in ipairs(WorkspaceService:GetDescendants()) do
        if m:IsA("Model") and m:FindFirstChildOfClass("Humanoid")
            and not PlayersService:GetPlayerFromCharacter(m) then
            found[#found + 1] = m
        end
    end
    return found
end

function Gakuran.FindNPC(name)
    if typeof(name) ~= "string" then return nil end
    local folder = WorkspaceService:FindFirstChild("NPCs")
    if folder then
        local exact = folder:FindFirstChild(name)
        if exact then return exact end
    end
    local lower = string.lower(name)
    for _, m in ipairs(Gakuran.GetNPCs()) do
        if string.lower(m.Name) == lower or string.lower(m.Name):find(lower, 1, true) then
            return m
        end
    end
    return nil
end

function Gakuran.NPCCFrame(nameOrModel)
    local model = typeof(nameOrModel) == "Instance" and nameOrModel or Gakuran.FindNPC(nameOrModel)
    if not model then return nil end
    local root = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart")
    return root and root.CFrame or nil
end

function Gakuran.TeleportToNPC(name, offset)
    local cf = Gakuran.NPCCFrame(name)
    local char = LocalPlayerRef and LocalPlayerRef.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not (cf and hrp) then return false end
    hrp.CFrame = cf * (offset or CFrame.new(0, 0, 3))
    return true
end

--// ----- Models / paths -----
-- All Workspace models sharing a name (e.g. Gakuran.GetModels("BasketballCarton")).
function Gakuran.GetModels(name)
    local found = {}
    if typeof(name) ~= "string" then return found end
    for _, m in ipairs(WorkspaceService:GetDescendants()) do
        if m:IsA("Model") and m.Name == name then
            found[#found + 1] = m
        end
    end
    return found
end

-- Dotted path resolve under Workspace, e.g. Gakuran.WSPath("AreaHitboxes.Rooftop")
function Gakuran.WSPath(dotted)
    return _resolvePath(WorkspaceService, dotted)
end

