-- Target lock cache: once we resolve a player for a given quest label, keep
-- using that same player until the label changes. This prevents the resolver
-- from matching a DIFFERENT player on a subsequent tick (fuzzy match flipping)
-- which causes the "teleport back and forth" bug.
local _photoLockedLabel = nil
local _photoLockedTarget = nil  -- { root = root, kind = "Player"/"Area", pos = Vector3 }

local function _photoClearTargetLock()
    _photoLockedLabel = nil
    _photoLockedTarget = nil
end

-- Canonical area-name set for "is this label a place?" checks (kind unknown)
local _photoAreaNamesNorm = {}
for _, _an in ipairs(PHOTO_AREA_LABELS) do
    _photoAreaNamesNorm[_photoNormalize(_an)] = true
end

local function _photoIsKnownAreaLabel(lbl)
    local n = _photoNormalize(lbl)
    return _photoAreaLabelToNameNorm[n] ~= nil or _photoAreaNamesNorm[n] ~= nil
end

-- Resolves a quest location (canonical area name or friendly label) to a world
-- position. Checks overrides -> scanned area results -> tagged landmarks.
local function _photoResolveAreaPosition(areaOrLabel)
    if not areaOrLabel or areaOrLabel == "" then return nil end
    local wantArea = _photoAreaLabelToNameNorm[_photoNormalize(areaOrLabel)] or _photoStripThe(areaOrLabel)
    wantArea = _photoNormalize(wantArea)
    if wantArea == "" then return nil end

    for overrideLabel, pos in pairs(PHOTO_AREA_POSITION_OVERRIDES) do
        if _photoNormalize(overrideLabel) == wantArea then return pos end
    end
    if _photoAreaResults then
        for areaLabel, rec in pairs(_photoAreaResults) do
            if _photoNormalize(areaLabel) == wantArea then return rec.position end
        end
    end
    if typeof(scanPhotoAreas) == "function" and not _photoAreaResults then
        pcall(scanPhotoAreas)
        if _photoAreaResults then
            for areaLabel, rec in pairs(_photoAreaResults) do
                if _photoNormalize(areaLabel) == wantArea then return rec.position end
            end
        end
    end

    local ok, tagged = pcall(function()
        return game:GetService("CollectionService"):GetTagged("PhotoJobLandmark")
    end)
    if ok and tagged then
        for _, inst in ipairs(tagged) do
            if _photoNormalize(inst.Name) == wantArea then
                if inst:IsA("Model") then
                    local pp = inst.PrimaryPart or inst:FindFirstChildWhichIsA("BasePart", true)
                    if pp then return pp.Position end
                elseif inst:IsA("BasePart") then
                    return inst.Position
                end
            end
        end
    end
    return nil
end

function _resolvePhotoTargetByLabel(label, task)
    if not label or label == "" then return nil, nil, nil, "no assignment label" end

    local LP = game:GetService("Players").LocalPlayer
    local raw = tostring(label)

    -- Live task metadata (PhotoJobState) is authoritative: "Area"/"Landmark"
    -- tasks must go to a place and must NEVER fuzzy-match a player name.
    local taskKind = (typeof(task) == "table") and task.TaskKind or nil
    local taskArea = (typeof(task) == "table") and task.Area or nil
    local targetUserId = (typeof(task) == "table") and tonumber(task.TargetUserId) or nil
    local isAreaTask = (taskKind == "Area") or (taskKind == "Landmark")
        or (type(taskArea) == "string" and taskArea ~= "")
    local isPlayerTask = (taskKind == "Player") or (targetUserId ~= nil and not isAreaTask)

    -- Area/Landmark assignment: resolve the location directly, skip ALL player
    -- matching (this was the bug that warped to players on place quests).
    if isAreaTask then
        local pos = _photoResolveAreaPosition(taskArea or label)
        if pos then
            _photoLockedLabel = label
            _photoLockedTarget = { pos = pos, kind = "Area" }
            return pos, "Area", nil
        end
        return nil, nil, nil, string.format("no area/landmark matched '%s'", tostring(taskArea or label))
    end

    -- The game's own PhotoJob marker already tracks the live target position
    -- (Camera.PhotoJobMarkerAnchor) and shows the target's name on its Label.
    -- When that name matches the quest label we can skip ALL name matching:
    -- no more warping to a different player whose name merely looks similar,
    -- and it works even while the target's character is streamed out.
    if not isAreaTask then
        local cam = workspace.CurrentCamera or workspace:FindFirstChildOfClass("Camera")
        local anchor = cam and cam:FindFirstChild("PhotoJobMarkerAnchor")
        local bb = anchor and anchor:FindFirstChild("PhotoJobMarker")
        local lbl = bb and bb:FindFirstChild("Label")
        local markerName = (lbl and lbl:IsA("TextLabel")) and lbl.Text or nil
        if anchor and anchor:IsA("BasePart") and type(markerName) == "string" then
            local mNorm = _photoNormalize(markerName)
            local lNorm = _photoNormalize(label)
            if mNorm ~= "" and (mNorm == lNorm
                or (lNorm ~= "" and lNorm:find(mNorm, 1, true))
                or (mNorm ~= "" and mNorm:find(lNorm, 1, true))) then
                _photoLockedLabel = label
                _photoLockedTarget = { root = anchor, kind = "Player", score = 100 }
                return anchor.Position + Vector3.new(0, 1, 0), "Player", anchor
            end
        end
    end

    -- Return locked target if we already resolved this label and the target is still valid
    local prevLockPlayer = nil -- remembered across lock-clear for tie stability
    if _photoLockedLabel == label and _photoLockedTarget then
        local t = _photoLockedTarget
        prevLockPlayer = (t.kind == "Player") and t.player or nil
        local lockOk = (t.kind == "Player") or (not isPlayerTask)
        if lockOk then
            if t.kind == "Player" then
                local root = t.root
                local p = t.player
                -- Only a confident (exact-ish) match stays locked; fuzzy locks
                -- re-resolve below so a better-named player can take over
                -- instead of pinning the wrong person with a similar name.
                local stillInGame = p and p.Parent == game:GetService("Players")
                if root and root.Parent and stillInGame and (t.score or 0) >= 90 then
                    local hum = root.Parent:FindFirstChildOfClass("Humanoid")
                    if not hum or hum.Health > 0 then
                        return root.Position + Vector3.new(0, 1, 0), "Player", root
                    end
                end
            elseif t.kind == "Area" then
                return t.pos, "Area", nil
            end
        end
        -- Target invalid — clear lock and re-resolve
        _photoClearTargetLock()
    end

    -- Kind unknown (UI scan only) but the label IS a known photo area:
    -- resolve the location BEFORE trying player names so a place name can
    -- never be mistaken for a player.
    if not isPlayerTask and _photoIsKnownAreaLabel(label) then
        local pos = _photoResolveAreaPosition(label)
        if pos then
            _photoLockedLabel = label
            _photoLockedTarget = { pos = pos, kind = "Area" }
            return pos, "Area", nil
        end
    end

    -- Player task with a server-given UserId: direct exact lookup, no fuzzy.
    if isPlayerTask and targetUserId then
        local okU, p = pcall(function()
            return game:GetService("Players"):GetPlayerByUserId(targetUserId)
        end)
        if okU and p and p ~= LP then
            local char = p.Character or workspace:FindFirstChild(p.Name)
            local root = char and (char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart or char:FindFirstChild("Torso"))
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if root and (not hum or hum.Health > 0) then
                _photoLockedLabel = label
                _photoLockedTarget = { root = root, kind = "Player", player = p, score = 100 }
                return root.Position + Vector3.new(0, 1, 0), "Player", root
            end
        end
    end

    -- Extract all potential candidate substrings to match
    local candidates = {}
    local seenCand = {}
    local function addCandidate(s, isWord)
        local n = _photoNormalize(s)
        if n ~= "" and not seenCand[n] and n ~= "npc" and n ~= "the" then
            seenCand[n] = true
            table.insert(candidates, { n = n, word = isWord == true })
        end
    end

    -- 1. If label has parentheses e.g. "CoolGamer (@cool_gamer)" or "Kazushi (NPC)"
    local insideParen = raw:match("%b()")
    if insideParen then
        addCandidate(insideParen:sub(2, -2))
        addCandidate(raw:gsub("%b()", ""))
    end

    -- 2. Strip leading @
    if raw:find("@") then
        addCandidate(raw:gsub("@", ""))
    end

    -- 3. Individual words in label (only >= 4 chars to avoid short false positives)
    for w in raw:gmatch("%S+") do
        if #w >= 4 then addCandidate(w, true) end
    end

    -- 4. Full normalized string
    addCandidate(raw)

    local wantName = _photoNormalize(label)

    -- =========================================================================
    -- Player matching: score EVERY player and keep only the single best one.
    -- The game stores custom roleplay names as attributes on
    -- Character.PlayerData (FirstName/LastName); the quest label uses the
    -- combined "First Last".
    --
    -- Exact matches always outrank substring matches, so look-alike names can
    -- no longer hijack the target (e.g. label "marco" can no longer lock onto
    -- "devil_marco29" when a real "marco" is in the server). The old code
    -- returned the FIRST fuzzy hit in player order, which is what warped to
    -- the wrong person.
    -- =========================================================================
    local function _photoPlayerFullName(p)
        local char = p.Character
        if not char then return nil end
        local pd = char:FindFirstChild("PlayerData")
        if not pd then return nil end
        local first = pd:GetAttribute("FirstName")
        local last = pd:GetAttribute("LastName")
        if typeof(first) ~= "string" or first == "" then return nil end
        if typeof(last) ~= "string" or last == "" then return nil end
        return _photoNormalize(first .. " " .. last)
    end

    local _photoPlrs = game:GetService("Players")
    local bestScore, bestPlayer, bestRoot = 0, nil, nil

    for _, p in ipairs(_photoPlrs:GetPlayers()) do
        if p ~= LP then
            local nm = _photoNormalize(p.Name)
            local dn = _photoNormalize(p.DisplayName)
            local fullName = _photoPlayerFullName(p)
            local score = 0

            if nm == wantName or dn == wantName then
                score = 100 -- exact Roblox username/display name
            elseif fullName and fullName == wantName then
                score = 100 -- exact in-game roleplay name ("First Last")
            else
                if fullName and #wantName >= 4 and #fullName >= 4
                    and (fullName:find(wantName, 1, true) or wantName:find(fullName, 1, true)) then
                    score = 80
                end
                for _, cand in ipairs(candidates) do
                    local c = cand.n
                    if c ~= "" then
                        local s = 0
                        if nm == c or dn == c then
                            s = cand.word and 85 or 90
                        elseif #c >= 5
                            and (nm:find(c, 1, true) or dn:find(c, 1, true)
                                or c:find(nm, 1, true) or c:find(dn, 1, true)) then
                            -- Fuzzy: rank by how much of the player's name the
                            -- candidate covers — the closest name wins, not the
                            -- first one in player order.
                            local cover = #c / math.max(#nm, #dn, 1)
                            s = (cand.word and 45 or 60) + math.floor(cover * 30)
                        end
                        if s > score then score = s end
                    end
                end
            end

            if score > 0 then
                if p == prevLockPlayer then score = score + 3 end -- stability on ties
                if score > bestScore then
                    local char = p.Character or workspace:FindFirstChild(p.Name)
                    local root = char and (char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart or char:FindFirstChild("Torso"))
                    local hum = char and char:FindFirstChildOfClass("Humanoid")
                    if root and (not hum or hum.Health > 0) then
                        bestScore, bestPlayer, bestRoot = score, p, root
                    end
                end
            end
        end
    end

    if bestPlayer and bestRoot then
        _photoLockedLabel = label
        _photoLockedTarget = { root = bestRoot, kind = "Player", player = bestPlayer, score = bestScore }
        return bestRoot.Position + Vector3.new(0, 1, 0), "Player", bestRoot
    end

    -- =========================================================================
    -- Check 3/4: Area overrides -> scanned areas -> tagged landmarks.
    -- Skipped entirely for explicit Player tasks (never warp to a place when
    -- the assignment is a person).
    -- =========================================================================
    if not isPlayerTask then
        local pos = _photoResolveAreaPosition(label)
        if pos then
            _photoLockedLabel = label
            _photoLockedTarget = { pos = pos, kind = "Area" }
            return pos, "Area"
        end
    end

    -- Check 5: REMOVED — was scanning workspace for NPC/bot models which caused
    -- false matches. Quests only target real players or areas, not workspace NPCs.

    return nil, nil, nil, string.format("no player/area/landmark matched '%s'", label)
end

