                or DEFAULT_JUMP_HEIGHT,
            0,
            20
        )
    end

    local Controller = {
        Board = nil,
        Connections = {},
        Tracks = {},
        Humanoid = nil,
        OriginalJumpHeight = nil,
        OriginalWalkSpeed = nil,
        TargetSpeed = DEFAULT_WALK_SPEED,
    }

    local function CalculateBoardOffset(hipHeight, rootHeight, boardHeight)
        return -(math.max(0, hipHeight) + rootHeight * 0.5) + boardHeight * 0.5 + 0.08
    end

    assert(CalculateBoardOffset(2, 2, 0.4) < 0, "Skateboard offset must remain below the character")

    local function FindTemplate()
        local assets = ReplicatedStorage:FindFirstChild("Assets")
        local vehicles = assets and assets:FindFirstChild("Vehicles")
        local skateboard = vehicles and vehicles:FindFirstChild("Skateboard")
        local template = skateboard and skateboard:FindFirstChild("Skateboard")
        return if template and template:IsA("Model") then template else nil
    end

    local function FindBoardPart(board)
        if board.PrimaryPart then return board.PrimaryPart end
        for _, name in ipairs({ "Main", "Board", "Deck" }) do
            local candidate = board:FindFirstChild(name, true)
            if candidate and candidate:IsA("BasePart") then return candidate end
        end
        return board:FindFirstChildWhichIsA("BasePart", true)
    end

    local function FindAnimation(name)
        local animations = ReplicatedStorage:FindFirstChild("Animations")
        local vehicles = animations and animations:FindFirstChild("Vehicles")
        local skateboard = vehicles and vehicles:FindFirstChild("Skateboard")
        local animation = skateboard and skateboard:FindFirstChild(name)
        if animation and animation:IsA("Animation") then
            animation = animation:Clone()
            animation.AnimationId = ANIMATION_IDS[name] or animation.AnimationId
            return animation
        end

        local animationId = ANIMATION_IDS[name]
        if not animationId then return nil end

        animation = Instance.new("Animation")
        animation.Name = "Int3Skateboard" .. name
        animation.AnimationId = animationId
        return animation
    end

    function Controller:_Disconnect()
        for _, connection in ipairs(self.Connections) do
            pcall(function() connection:Disconnect() end)
        end
        table.clear(self.Connections)
    end

    function Controller:_StopTracks()
        for _, track in ipairs(self.Tracks) do
            pcall(function() track:Stop(0.12) end)
        end
        table.clear(self.Tracks)
    end

    function Controller:Dismount(silent)
        ContextActionService:UnbindAction(MOBILE_BOOST_ACTION)
        ContextActionService:UnbindAction(MOBILE_JUMP_ACTION)
        self:_Disconnect()
        self:_StopTracks()
        local humanoid = self.Humanoid
        if humanoid and humanoid.Parent then
            if self.OriginalWalkSpeed ~= nil then
                humanoid.WalkSpeed = self.OriginalWalkSpeed
            end
            if self.OriginalJumpHeight ~= nil then
                humanoid.JumpHeight = self.OriginalJumpHeight
            end
        end
        self.Humanoid = nil
        self.OriginalJumpHeight = nil
        self.OriginalWalkSpeed = nil
        self.TargetSpeed = WalkSpeed()
        if self.Board then
            pcall(function() self.Board:Destroy() end)
            self.Board = nil
        end
        if not silent then
            Library:Notify({
                Title = "Skateboard",
                Description = "Local skateboard removed.",
                Time = 2,
            })
        end
    end

    function Controller:Mount()
        self:Dismount(true)

        local character = LocalPlayer.Character
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        local root = character and (character:FindFirstChild("HumanoidRootPart") or character.PrimaryPart)
        local template = FindTemplate()
        if not (character and humanoid and root) then
            Library:Notify({ Title = "Skateboard", Description = "Character is not ready.", Time = 3 })
            return false
        end
        if not template then
            Library:Notify({
                Title = "Skateboard",
                Description = "ReplicatedStorage.Assets.Vehicles.Skateboard.Skateboard was not found.",
                Time = 4,
            })
            return false
        end

        local board = template:Clone()
        board.Name = "Int3LocalSkateboard"
        local boardPart = FindBoardPart(board)
        if not (boardPart and boardPart:IsA("BasePart")) then
            board:Destroy()
            Library:Notify({ Title = "Skateboard", Description = "The skateboard has no usable BasePart.", Time = 4 })
            return false
        end

        board.PrimaryPart = boardPart
        for _, descendant in ipairs(board:GetDescendants()) do
            if descendant:IsA("BasePart") then
                descendant.Anchored = false
                descendant.CanCollide = false
                descendant.CanTouch = false
                descendant.Massless = true
                descendant.AssemblyLinearVelocity = Vector3.zero
                descendant.AssemblyAngularVelocity = Vector3.zero
                if descendant ~= boardPart then
                    local weld = Instance.new("WeldConstraint")
                    weld.Name = "Int3BoardWeld"
                    weld.Part0 = boardPart
                    weld.Part1 = descendant
                    weld.Parent = boardPart
                end
            end
        end

        board.Parent = Workspace
        local _, boardSize = board:GetBoundingBox()
        local yOffset = CalculateBoardOffset(humanoid.HipHeight, root.Size.Y, boardSize.Y)
        board:PivotTo(root.CFrame * CFrame.new(0, yOffset, 0) * CFrame.Angles(0, math.rad(90), 0))

        local characterWeld = Instance.new("WeldConstraint")
        characterWeld.Name = "Int3CharacterWeld"
        characterWeld.Part0 = root
        characterWeld.Part1 = boardPart
        characterWeld.Parent = boardPart
        self.Board = board
        self.Humanoid = humanoid
        self.OriginalJumpHeight = humanoid.JumpHeight
        self.OriginalWalkSpeed = humanoid.WalkSpeed
        self.TargetSpeed = WalkSpeed()
        humanoid.WalkSpeed = self.TargetSpeed
        if not humanoid.UseJumpPower then
            humanoid.JumpHeight = JumpHeight()
        end

        local idleTrack
        local boostTrack
        local jumpTrack
        local boosting = false
        local coasting = false
        local wasMoving = false
        local coastSpeed = 0
        local coastDeceleration = BOOST_COAST_DECELERATION
        local boostDirection = Vector3.zero
        local boostUntil = 0
        local canJump = humanoid.FloorMaterial ~= Enum.Material.Air
        local nextJumpAt = 0

        local function PlayIdle()
            if idleTrack and not idleTrack.IsPlaying then idleTrack:Play(0.12) end
        end

        local function SetBoosting(enabled)
            if enabled and boosting then return end
            local wasBoosting = boosting
            boosting = enabled
            local boostSpeed = BoostSpeed()
            self.TargetSpeed = if enabled then boostSpeed else WalkSpeed()
            humanoid.WalkSpeed = self.TargetSpeed
            if enabled then
                coasting = false
                wasMoving = false
                local look = root.CFrame.LookVector
                local flatLook = Vector3.new(look.X, 0, look.Z)
                boostDirection = if flatLook.Magnitude > 0.01 then flatLook.Unit else Vector3.new(0, 0, -1)
                boostUntil = if boostTrack then math.huge else os.clock() + BOOST_FALLBACK_DURATION
                if idleTrack then idleTrack:Stop(0.12) end
                if boostTrack then
                    boostTrack:Play(0.08)
                end
                local velocity = root.AssemblyLinearVelocity
                root.AssemblyLinearVelocity =
                    Vector3.new(boostDirection.X * boostSpeed, velocity.Y, boostDirection.Z * boostSpeed)
            else
                if wasBoosting then
                    coasting = true
                    coastSpeed = boostSpeed
                    coastDeceleration = BOOST_COAST_DECELERATION
                end
                if boostTrack and boostTrack.IsPlaying then boostTrack:Stop(0.12) end
                PlayIdle()
            end
        end

        local animator = humanoid:FindFirstChildOfClass("Animator")
        if animator then
            local idleAnimation = FindAnimation("Idle")
            local boostAnimation = FindAnimation("Boost")
            local jumpAnimation = FindAnimation("Jump")

            local function LoadTrack(animation, looped, priority)
                if not animation then return nil end
                local loadedTrack
                pcall(function()
                    loadedTrack = animator:LoadAnimation(animation)
                    loadedTrack.Looped = looped
                    loadedTrack.Priority = priority
                    self.Tracks[#self.Tracks + 1] = loadedTrack
                end)
                if not animation:IsDescendantOf(game) then
                    animation:Destroy()
                end
                return loadedTrack
            end

            idleTrack = LoadTrack(idleAnimation, true, Enum.AnimationPriority.Action)
            boostTrack = LoadTrack(boostAnimation, false, Enum.AnimationPriority.Action)
            jumpTrack = LoadTrack(jumpAnimation, false, Enum.AnimationPriority.Action2)

            PlayIdle()
            if boostTrack then
                self.Connections[#self.Connections + 1] = boostTrack.Stopped:Connect(function()
                    if boosting then SetBoosting(false) end
                end)
            end
        end

        self.Connections[#self.Connections + 1] = UserInputService.InputBegan:Connect(function(input)
            if input.KeyCode == Enum.KeyCode.LeftShift and not UserInputService:GetFocusedTextBox() then
                SetBoosting(true)
            end
        end)
        self.Connections[#self.Connections + 1] = humanoid.StateChanged:Connect(function(_, newState)
            if newState == Enum.HumanoidStateType.Jumping then
                if jumpTrack then jumpTrack:Play(0.08) end
            elseif newState == Enum.HumanoidStateType.Freefall then
                canJump = false
            elseif newState == Enum.HumanoidStateType.Landed then
                nextJumpAt = os.clock() + JUMP_COOLDOWN
            end
        end)
        local function RequestJump()
            if humanoid.Health <= 0 or not canJump or os.clock() < nextJumpAt then return end
            canJump = false
            if not humanoid.UseJumpPower then
                humanoid.JumpHeight = JumpHeight()
            end
            humanoid.Jump = true
            humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
        end

        self.Connections[#self.Connections + 1] = UserInputService.JumpRequest:Connect(RequestJump)
        if UserInputService.TouchEnabled then
            ContextActionService:BindAction(MOBILE_BOOST_ACTION, function(_, inputState)
                if inputState == Enum.UserInputState.Begin then SetBoosting(true) end
                return Enum.ContextActionResult.Sink
            end, true, Enum.KeyCode.LeftShift)
            ContextActionService:SetTitle(MOBILE_BOOST_ACTION, "BOOST")
            ContextActionService:SetPosition(MOBILE_BOOST_ACTION, UDim2.new(1, -230, 1, -105))

            ContextActionService:BindAction(MOBILE_JUMP_ACTION, function(_, inputState)
                if inputState == Enum.UserInputState.Begin then RequestJump() end
                return Enum.ContextActionResult.Sink
            end, true, Enum.KeyCode.Space)
            ContextActionService:SetTitle(MOBILE_JUMP_ACTION, "JUMP")
            ContextActionService:SetPosition(MOBILE_JUMP_ACTION, UDim2.new(1, -150, 1, -105))
        end
        self.Connections[#self.Connections + 1] = RunService.Heartbeat:Connect(function(deltaTime)
            if boosting and os.clock() >= boostUntil then SetBoosting(false) end
            if not canJump
                and nextJumpAt > 0
                and os.clock() >= nextJumpAt
                and humanoid.FloorMaterial ~= Enum.Material.Air then
                canJump = true
            end

            local walkSpeed = WalkSpeed()
            local boostSpeed = BoostSpeed()
            local targetSpeed = if boosting then boostSpeed else walkSpeed
            self.TargetSpeed = targetSpeed
            if humanoid.WalkSpeed ~= targetSpeed then humanoid.WalkSpeed = targetSpeed end

            local state = humanoid:GetState()
            local direction = humanoid.MoveDirection
            local moving = direction.Magnitude > 0.01
                and humanoid.FloorMaterial ~= Enum.Material.Air
                and (state == Enum.HumanoidStateType.Running
                    or state == Enum.HumanoidStateType.RunningNoPhysics)

            if not boosting and not moving and wasMoving then
                wasMoving = false
                local velocity = root.AssemblyLinearVelocity
                local horizontal = Vector3.new(velocity.X, 0, velocity.Z)
                coastSpeed = math.min(walkSpeed, horizontal.Magnitude)
                if horizontal.Magnitude > 0.01 then boostDirection = horizontal.Unit end
                coastDeceleration = CRUISE_COAST_DECELERATION
                coasting = coastSpeed > 1
            end

            if boosting then
                local look = root.CFrame.LookVector
                local flatLook = Vector3.new(look.X, 0, look.Z)
                if flatLook.Magnitude > 0.01 then boostDirection = flatLook.Unit end
                local velocity = root.AssemblyLinearVelocity
                root.AssemblyLinearVelocity = Vector3.new(
                    boostDirection.X * boostSpeed,
                    velocity.Y,
                    boostDirection.Z * boostSpeed
                )
            elseif coasting and direction.Magnitude <= 0.01 then
                coastSpeed = math.max(0, coastSpeed - coastDeceleration * deltaTime)
                local velocity = root.AssemblyLinearVelocity
                root.AssemblyLinearVelocity = Vector3.new(
                    boostDirection.X * coastSpeed,
                    velocity.Y,
                    boostDirection.Z * coastSpeed
                )
                if coastSpeed <= 1 then coasting = false end
            elseif moving then
                coasting = false
                wasMoving = true
                local velocity = root.AssemblyLinearVelocity
                local current = Vector3.new(velocity.X, 0, velocity.Z)
                local desired = direction.Unit * targetSpeed
                local horizontal = current:Lerp(desired, 1 - math.exp(-CRUISE_RESPONSE * deltaTime))
                boostDirection = direction.Unit
                root.AssemblyLinearVelocity = Vector3.new(horizontal.X, velocity.Y, horizontal.Z)
            end
        end)

        self.Connections[#self.Connections + 1] = humanoid.Died:Connect(function()
            self:Dismount(true)
            task.defer(function()
                local toggle = Toggles.LocalSkateboard
                if toggle and toggle.Value then toggle:SetValue(false) end
            end)
        end)
        self.Connections[#self.Connections + 1] = character.AncestryChanged:Connect(function(_, parent)
            if not parent then
                self:Dismount(true)
                task.defer(function()
                    local toggle = Toggles.LocalSkateboard
                    if toggle and toggle.Value then toggle:SetValue(false) end
                end)
            end
        end)

        Library:Notify({
            Title = "Skateboard",
            Description = "Local skateboard equipped. Only your client can see it.",
            Time = 4,
        })
        return true
    end

    function Controller:Destroy()
        self:Dismount(true)
    end

    return Controller
end)()

