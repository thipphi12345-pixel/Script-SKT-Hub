local function normalizeAnimationId(value)
    if typeof(value) == "number" then
        if value ~= value or value <= 0 then return nil end
        return string.format("%.0f", value)
    end
    if typeof(value) == "string" then return value:match("%d+") end
    return nil
end

local AnimationRemap = {}
do
    local remapModule = ReplicatedStorage:FindFirstChild("AnimationRemap")
    if remapModule and remapModule:IsA("ModuleScript") then
        local ok, remap = pcall(require, remapModule)
        if ok and type(remap) == "table" then
            for oldId, newId in pairs(remap) do
                local oldKey = normalizeAnimationId(oldId)
                local newKey = normalizeAnimationId(newId)
                if oldKey and newKey then AnimationRemap[oldKey] = newKey end end end end end

local AttackDB = {}
local AttackDBCount = 0

local function buildAttackDB()
    AttackDB = {}
    AttackDBCount = 0
    if not CombatConfig then return end
    local anims = ReplicatedStorage:FindFirstChild("Animations")
    local combat = anims and anims:FindFirstChild("Combat")
    if not combat then return end
    local m1idx = { ["1stM1"] = 1, ["2ndM1"] = 2, ["3rdM1"] = 3, ["4thM1"] = 4 }
    for _, styleFolder in ipairs(combat:GetChildren()) do
        if styleFolder:IsA("Folder") and styleFolder.Name:sub(-5) == "Anims" then
            local styleName = styleFolder.Name:sub(1, #styleFolder.Name - 5)
            local styleKey = string.lower(styleName)
            local styleConfig = nil
            if typeof(CombatConfig.GetStyleConfig) == "function" then
                local ok, value = pcall(CombatConfig.GetStyleConfig, styleKey)
                if ok and type(value) == "table" then styleConfig = value end
            end
            local m2Variants = nil
            if typeof(CombatConfig.GetStyleM2Variants) == "function" then
                local ok, value = pcall(CombatConfig.GetStyleM2Variants, styleKey)
                if ok and type(value) == "table" then m2Variants = value end
            end
            if not m2Variants and styleConfig then
                m2Variants = styleConfig.M2Variants
            end
            for _, a in ipairs(styleFolder:GetChildren()) do
                if a:IsA("Animation") then
                    local id = normalizeAnimationId(a.AnimationId)
                    local delay, kind, idx
                    local variantName, variantConfig
                    if type(m2Variants) == "table" then
                        for name, variant in pairs(m2Variants) do
                            if type(variant) == "table" and variant.Anim == a.Name then
                                variantName = tostring(name)
                                variantConfig = variant
                                break
                            end
                        end
                    end
                    idx = m1idx[a.Name]
                    if idx and typeof(CombatConfig.GetScaledStyleM1HitboxDelay) == "function" then
                        kind = "M1"
                        local ok, v = pcall(CombatConfig.GetScaledStyleM1HitboxDelay, styleKey, idx, 1)
                        if ok then delay = v end
                    elseif a.Name == "MomentumM2" and typeof(CombatConfig.GetStyleM2HitboxDelay) == "function" then
                        kind = "M2M"
                        local ok, raw = pcall(CombatConfig.GetStyleM2HitboxDelay, styleKey, true)
                        if ok and typeof(CombatConfig.GetScaledHitboxDelay) == "function" then
                            local ok2, v = pcall(CombatConfig.GetScaledHitboxDelay, raw, 1)
                            if ok2 then delay = v end
                        elseif ok then
                            delay = raw
                        end
                    elseif variantConfig then
                        kind = "M2"
                        local raw = tonumber(variantConfig.HitboxDelay)
                        if typeof(CombatConfig.GetStyleM2HitboxDelay) == "function" then
                            local ok, value = pcall(
                                CombatConfig.GetStyleM2HitboxDelay,
                                styleKey,
                                false,
                                variantName
                            )
                            if ok then raw = tonumber(value) end
                        end
                        if raw and typeof(CombatConfig.GetScaledHitboxDelay) == "function" then
                            local ok, value = pcall(CombatConfig.GetScaledHitboxDelay, raw, 1)
                            if ok then delay = value end
                        else
                            delay = raw
                        end
                    elseif a.Name == "M2" and typeof(CombatConfig.GetStyleM2HitboxDelay) == "function" then
                        kind = "M2"
                        local ok, raw = pcall(CombatConfig.GetStyleM2HitboxDelay, styleKey)
                        if ok and typeof(CombatConfig.GetScaledHitboxDelay) == "function" then
                            local ok2, v = pcall(CombatConfig.GetScaledHitboxDelay, raw, 1)
                            if ok2 then delay = v end
                        elseif ok then
                            delay = raw
                        end
                    end
                    if id and typeof(delay) == "number" and delay > 0 and not AttackDB[id] then
                        AttackDB[id] = {
                            name = styleName .. "/" .. a.Name,
                            delay = delay,
                            kind = kind,
                            style = styleKey,
                            idx = (idx ~= nil and idx or nil),
                            variant = variantName,
                        }
                        AttackDBCount += 1
                    end end end end end
    for oldId, newId in pairs(AnimationRemap) do
        if AttackDB[newId] and not AttackDB[oldId] then
            AttackDB[oldId] = AttackDB[newId]
        end
    end
end
buildAttackDB()

