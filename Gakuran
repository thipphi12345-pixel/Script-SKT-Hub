    function R:_combatObserverArgument(value, depth, seen)
        local valueType = typeof(value)
        if valueType == "nil" then return "<nil>" end
        if valueType == "string" or valueType == "boolean" then return value end
        if valueType == "number" then
            return value == value and math.abs(value) < math.huge and value or tostring(value)
        end
        if valueType == "Instance" then
            local path = value.Name
            pcall(function() path = value:GetFullName() end)
            return {
                kind = "Instance",
                class = value.ClassName,
                name = value.Name,
                path = path,
            }
        end
        if valueType == "Vector3" then
            return { kind = "Vector3", x = value.X, y = value.Y, z = value.Z }
        end
        if valueType == "Vector2" then
            return { kind = "Vector2", x = value.X, y = value.Y }
        end
        if valueType == "Color3" then
            return { kind = "Color3", r = value.R, g = value.G, b = value.B }
        end
        if valueType == "table" then
            depth = depth or 0
            if depth >= 3 then return { kind = "table", truncated = true } end
            seen = seen or {}
            if seen[value] then return { kind = "table", cycle = true } end
            seen[value] = true
            local character = self:_characterFromValue(value)
            local fields, count, truncated = {}, 0, false
            for key, nested in pairs(value) do
                count += 1
                if count > 24 then
                    truncated = true
                    break
                end
                local keyType = typeof(key)
                local safeKey = (keyType == "string" or keyType == "number"
                    or keyType == "boolean") and tostring(key) or ("<" .. keyType .. ">")
                fields[safeKey] = self:_combatObserverArgument(nested, depth + 1, seen)
            end
            seen[value] = nil
            return {
                kind = "table",
                character = character and character.Name or nil,
                fields = fields,
                truncated = truncated or nil,
            }
        end
        return { kind = valueType, value = tostring(value) }
    end

    function R:_combatObserverAnimations(model)
        local humanoid = model and model:FindFirstChildOfClass("Humanoid")
        local animator = humanoid and humanoid:FindFirstChildOfClass("Animator")
        if not animator then return {} end
        local ok, tracks = pcall(animator.GetPlayingAnimationTracks, animator)
        if not ok or type(tracks) ~= "table" then return {} end
        local output = {}
        for index = 1, math.min(#tracks, 8) do
            local track = tracks[index]
            local snapshot = {}
            pcall(function()
                local animation = track.Animation
                snapshot.id = animation and parseAnimId(animation.AnimationId) or nil
                snapshot.name = animation and animation.Name or track.Name
                snapshot.timePosition = track.TimePosition
                snapshot.speed = track.Speed
                snapshot.weight = track.WeightCurrent
                snapshot.length = track.Length
                snapshot.priority = tostring(track.Priority)
            end)
            output[#output + 1] = snapshot
        end
        return output
    end

    function R:_combatObserverGeometry(model)
