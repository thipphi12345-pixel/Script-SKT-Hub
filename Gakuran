            else
                local onCd = ch:GetAttribute("M2Cooldown") == true
                local remaining = onCd and math.max(cdDur - (os.clock() - cdStart), 0) or 0
                local readyNow = showHighlight and not onCd
                if readyNow and (not highlightReady or highlightCharacter ~= ch) then
