    function R:_modeData(engine)
        engine = normalizeParryEngine(engine)
        local data = Config.engineTiming[engine]
        if typeof(data) ~= "table" then
            data = { animations = {}, styles = {}, totalSamples = 0 }
            Config.engineTiming[engine] = data
        end
        if typeof(data.animations) ~= "table" then data.animations = {} end
        if typeof(data.styles) ~= "table" then data.styles = {} end
        data.totalSamples = tonumber(data.totalSamples) or 0
        return data
    end

    function R:_record(container, key)
        key = tostring(key or "unknown")
        local record = container[key]
        if typeof(record) ~= "table" then
            record = { lead = 0, samples = 0, perfect = 0, regular = 0, hit = 0 }
            container[key] = record
        end
        record.lead = tonumber(record.lead) or 0
        record.samples = tonumber(record.samples) or 0
        record.perfect = tonumber(record.perfect) or 0
        record.regular = tonumber(record.regular) or 0
        record.hit = tonumber(record.hit) or 0
        return record
    end

    function R:_learningKey(value, strikeIndex)
        local key = tostring(value or "unknown")
        local strike = math.max(1, math.floor(tonumber(strikeIndex) or 1))
        return strike > 1 and (key .. "#" .. tostring(strike)) or key
    end

    function R:GetLearnedLead(engine, id, styleKey, strikeIndex, attackType)
        local policy = self.Policy[engine] or self.Policy.Adaptive
        local data = self:_modeData(engine)
        local animation = id and data.animations[self:_learningKey(id, strikeIndex)]
        if typeof(animation) == "table" and (tonumber(animation.samples) or 0) >= policy.minSamples then
            return math.clamp(tonumber(animation.lead) or 0, -policy.maxLead, policy.maxLead)
        end
        local style = styleKey and data.styles[self:_learningKey(styleKey, strikeIndex)]
        if typeof(style) == "table" and (tonumber(style.samples) or 0) >= policy.minSamples then
            return math.clamp(tonumber(style.lead) or 0, -policy.maxLead, policy.maxLead)
        end
        if engine == "Fusion" and attackType == "M1" then
            return math.clamp(
                self:GetLearnedLead("Perfect", id, styleKey, strikeIndex, attackType),
                -policy.maxLead,
                policy.maxLead
            )
        end
        -- Phantom/Apex: cross-reference Fusion AND Perfect learning, then apply boost
        if engine == "Phantom" or engine == "Apex" then
            local perfectLead = self:GetLearnedLead("Perfect", id, styleKey, strikeIndex, attackType)
            local fusionLead = self:GetLearnedLead("Fusion", id, styleKey, strikeIndex, attackType)
            -- Use whichever has more samples (more reliable)
            local perfectData = self:_modeData("Perfect")
            local fusionData = self:_modeData("Fusion")
            local perfectSamples = 0
            if perfectData and perfectData.animations then
                local anim = perfectData.animations[self:_learningKey(id, strikeIndex)]
                perfectSamples = anim and tonumber(anim.samples) or 0
            end
            local fusionSamples = 0
            if fusionData and fusionData.animations then
                local anim = fusionData.animations[self:_learningKey(id, strikeIndex)]
                fusionSamples = anim and tonumber(anim.samples) or 0
            end
            local bestLead = perfectSamples >= fusionSamples and perfectLead or fusionLead
            -- Apply learning boost (amplify adjustment for faster convergence)
            local boostedLead = bestLead
                + self:_phantomLearningBoost(attackType, bestLead)
            return math.clamp(boostedLead, -policy.maxLead, policy.maxLead)
        end
        return 0
    end

    function R:ResetLearning(engine)
        engine = normalizeParryEngine(engine)
        Config.engineTiming[engine] = { animations = {}, styles = {}, totalSamples = 0 }
        for _, attempt in ipairs(self.Attempts) do
            if attempt.engine == engine then attempt.cancelled = true end
        end
        markConfigDirty()
        self.StatusDirty = true
        self:UpdateStatus(true)
    end

    function R:_findAttempt(attackerModel, allowAnonymous, expectedAttackType, fusionWindow)
        local now = os.clock()
        local best, bestAge, candidates = nil, math.huge, 0
        for _, attempt in ipairs(self.Attempts) do
            local isFusionLike = attempt.engine == "Fusion" or attempt.engine == "Phantom" or attempt.engine == "Apex"
            if attempt.firedAt and not attempt.resolved and not attempt.cancelled
                and (not isFusionLike
                    or not attempt.token or not attempt.token.cancelled)
                and now - attempt.firedAt <= 1.8
                and (attackerModel == nil or attempt.model == attackerModel) then
                local age = math.abs(now - (attempt.predictedImpactAt or attempt.firedAt))
                local matchesFusion = not isFusionLike
                    or not expectedAttackType
                    or (attempt.profile and attempt.profile.attackType == expectedAttackType)
                local insideFusionWindow = not isFusionLike
                    or not fusionWindow
                    or age <= fusionWindow
                if matchesFusion and insideFusionWindow then
                    candidates += 1
                    if age < bestAge then
                        best, bestAge = attempt, age
                    end
                end
            end
        end
        if attackerModel then return best, candidates end
        if allowAnonymous and candidates >= 1 and bestAge <= 0.40 then
            return best, candidates
        end
        return nil, candidates
    end

    function R:_learn(attempt, kind, confidence)
        if not attempt or attempt.resolved or attempt.cancelled then return false end
        local profile = attempt.profile
        local isFusionLike = attempt.engine == "Fusion" or attempt.engine == "Phantom" or attempt.engine == "Apex"
        if isFusionLike and attempt.reactivePulse then
            attempt.resolved = true
            self:_diagnosticRecord("outcome", attempt, {
                outcome = kind,
                confidence = confidence,
                learningSkipped = "fixed-confirmed-pulse",
            })
            return true
        end
        if isFusionLike and profile and profile.attackType == "M2"
            and confidence == "health" then
            attempt.healthHitAt = nil
            self:_diagnosticRecord("outcome", attempt, {
                outcome = kind,
                confidence = confidence,
                learningSkipped = "ambiguous-m2-health",
            })
            return false
        end
        attempt.resolved = true

        -- SMART CANCEL ON SUCCESS
        if Options.FastUnblock and Options.FastUnblock.Value == true then
            if kind == "perfect" or kind == "regular" then
                -- Add a 0.08s Smart Delay before dropping the block so the server confirms the parry
                if self.Block and self.Block.active then
                    local releaseDelay = 0.08
                    -- Phantom/Apex: extend block hold if there are nearby threats (anti-feint + multi-attacker)
                    if (attempt.engine == "Phantom" or attempt.engine == "Apex")
                        and self:_phantomShouldHoldBlock(attempt, os.clock()) then
                        local extend = self:_phantomBlockExtendDuration(attempt, os.clock())
                        if extend > releaseDelay then
                            releaseDelay = extend
                        end
                    end
                    self.Block.releaseAt = math.min(self.Block.releaseAt, os.clock() + releaseDelay)
                end
            end
        end

        if not self:_usesConfirmedRemote(attempt)
            and kind == "perfect" and attempt.strikeIndex == 1 and attempt.token
            and profile and profile.attackType == "M2"
            and string.lower(tostring(profile.styleKey or "")) == "boxing" then
            attempt.token.cancelled = true
            attempt.token.cancelReason = "first-perfect"
        end
        if attempt.intentRearmed then
            self:_diagnosticRecord("outcome", attempt, {
                outcome = kind,
                confidence = confidence,
                learningSkipped = "intent-rearm",
            })
            self.StatusDirty = true
            self:UpdateStatus(true)
            return true
        end
        local engine = normalizeParryEngine(attempt.engine)
        local policy = self.Policy[engine]
        local data = self:_modeData(engine)
        local primary
        if attempt.id then
            primary = self:_record(data.animations,
                self:_learningKey(attempt.id, attempt.strikeIndex))
        else
            primary = self:_record(data.styles,
                self:_learningKey(attempt.styleKey, attempt.strikeIndex))
        end
        primary.samples += 1
        primary[kind] = (tonumber(primary[kind]) or 0) + 1

        if kind == "regular" then
            primary.lead = math.clamp(primary.lead - policy.regularStep, -policy.maxLead, policy.maxLead)
        elseif kind == "hit" and attempt.healthHitBlocking
            and attempt.healthHitAt and attempt.predictedImpactAt then
            local impactError = attempt.healthHitAt - attempt.predictedImpactAt
            if math.abs(impactError) >= 0.012 then
                primary.lead = math.clamp(primary.lead
                    - math.sign(impactError) * policy.hitStep, -policy.maxLead, policy.maxLead)
            end
        elseif kind == "hit" and confidence == "explicit" then
            local commandLate = attempt.commandAt and attempt.predictedImpactAt
                and attempt.commandAt >= attempt.predictedImpactAt
            local activationLate = attempt.activationAt and attempt.predictedImpactAt
                and attempt.activationAt >= attempt.predictedImpactAt
            if commandLate or activationLate then
                primary.lead = math.clamp(primary.lead + policy.hitStep, -policy.maxLead, policy.maxLead)
            end
        elseif kind == "perfect" then
            primary.lead *= 0.995
        end

        if attempt.id and attempt.styleKey then
            local style = self:_record(data.styles,
                self:_learningKey(attempt.styleKey, attempt.strikeIndex))
            style.samples += 1
            style[kind] = (tonumber(style[kind]) or 0) + 1
            if kind == "regular" then
                style.lead = math.clamp(style.lead - policy.regularStep * 0.25, -policy.maxLead, policy.maxLead)
            elseif kind == "hit" and confidence == "explicit"
                and attempt.commandAt and attempt.predictedImpactAt
                and attempt.commandAt >= attempt.predictedImpactAt then
                style.lead = math.clamp(style.lead + policy.hitStep * 0.25, -policy.maxLead, policy.maxLead)
            end
        end

        data.totalSamples += 1
        self:_diagnosticRecord("outcome", attempt, {
            outcome = kind,
            confidence = confidence,
        })
        markConfigDirty()
        local autoConfig = Library._AutoConfig
        if autoConfig and typeof(autoConfig.ObserveOutcome) == "function" then
            pcall(autoConfig.ObserveOutcome, autoConfig, attempt, kind, confidence)
        end
        self.StatusDirty = true
        self:UpdateStatus(true)
        return true
    end

    function R:_resolvePlayer(value, seen)
        if value == nil then return nil end
        if typeof(value) == "Instance" then
            if value:IsA("Player") then return value end
            if value:IsA("Model") then return Players:GetPlayerFromCharacter(value) end
            local model = value:FindFirstAncestorOfClass("Model")
            return model and Players:GetPlayerFromCharacter(model) or nil
        end
        if type(value) == "string" then
            local player = Players:FindFirstChild(value)
            if player and player:IsA("Player") then return player end
            for _, candidate in ipairs(Players:GetPlayers()) do
                if candidate.Character and candidate.Character.Name == value then return candidate end
            end
            return nil
        end
        if type(value) == "number" then return Players:GetPlayerByUserId(value) end
        if type(value) ~= "table" then return nil end
        seen = seen or {}
        if seen[value] then return nil end
        seen[value] = true
        for _, key in ipairs({
            "Player", "player", "Attacker", "attacker", "Victim", "victim",
            "Character", "character", "Target", "target",
        }) do
            local player = self:_resolvePlayer(rawget(value, key), seen)
            if player then return player end
        end
        return nil
    end

    function R:_classifyOutcome(eventName)
        return type(eventName) == "string" and self.OutcomeKinds[eventName] or nil
    end

    function R:_outcomeAttackType(eventName)
        if type(eventName) ~= "string" then return nil end
        local prefix = string.sub(eventName, 1, 2)
        return prefix == "M1" and "M1" or prefix == "M2" and "M2" or nil
    end

    function R:_observeOutcome(eventName, ...)
        local kind = self:_classifyOutcome(eventName)
        if not kind then return false end
        local args = table.pack(...)
        local attacker = args.n >= 1 and self:_resolvePlayer(args[1]) or nil
        local victim = args.n >= 2 and self:_resolvePlayer(args[2]) or nil
        local attackerModel = attacker and attacker.Character
            or (args.n >= 1 and self:_characterFromValue(args[1]) or nil)
        local victimModel = victim and victim.Character
            or (args.n >= 2 and self:_characterFromValue(args[2]) or nil)
        local localVictim = victim == LocalPlayer or victimModel == LocalPlayer.Character
        if not localVictim then return false end
        local explicit = attackerModel ~= nil and attackerModel ~= LocalPlayer.Character
        local expectedAttackType = self:_outcomeAttackType(eventName)
        local now = os.clock()
        local fusionActive = self.ActiveEngine == "Fusion"
        if explicit and attackerModel then
            self.RecentOutcomeAt[attackerModel] = {
                at = now,
                attackType = expectedAttackType,
            }
            if (kind == "perfect" or kind == "regular") and self:IsAutoPunishEnabled() then
                local punish = Library._AutoPunishController
                if punish and typeof(punish.ObserveOutcome) == "function" then
                    pcall(punish.ObserveOutcome, punish, attackerModel, expectedAttackType, kind)
                end
            end
        end
        local attempt = self:_findAttempt(
            explicit and attackerModel or nil,
            not explicit,
            expectedAttackType,
            fusionActive and self.FusionOutcomeCorrelationWindow or nil
        )
        if not attempt then
            if explicit and fusionActive then
                self:_diagnosticRecord("outcome-uncorrelated", {
                    model = attackerModel,
                    attackType = expectedAttackType,
                    source = "CombatOutcome",
                    sourceClass = "outcome",
                }, {
                    eventName = eventName,
                    outcome = kind,
                    confidence = "explicit",
                    correlationWindowMs = self.FusionOutcomeCorrelationWindow * 1000,
                })
                return true
            end
            return false
        end
        local learned = self:_learn(attempt, kind, explicit and "explicit" or "anonymous")
        if learned and kind == "perfect" and (attempt.engine == "Fusion" or attempt.engine == "Phantom" or attempt.engine == "Apex")
            and self.Block.active and self.Block.method == "Remote"
            and self.Block.attempt == attempt then
            local hasLaterStage = false
            for _, candidate in ipairs(self.Attempts) do
                if candidate ~= attempt and candidate.token == attempt.token
                    and not candidate.cancelled and not candidate.resolved
                    and (tonumber(candidate.strikeIndex) or 1) > (tonumber(attempt.strikeIndex) or 1) then
                    hasLaterStage = true
                    break
                end
            end
            if not hasLaterStage then self:_releaseBlock("fusion-perfect") end
        end
        return learned
    end

    function R:_styleData(styleKey)
        local styles = CombatConfig and CombatConfig.Styles
        if type(styles) ~= "table" then return nil end
        local wanted = string.lower(tostring(styleKey or ""))
        for key, value in pairs(styles) do
            if string.lower(tostring(key)) == wanted then return value end
        end
        return nil
    end

    function R:_nextComboIndex(value)
        local combo = tonumber(value)
        if not combo or combo ~= combo then return nil end
        combo = math.clamp(math.floor(combo), 0, 4)
        return combo <= 0 and 1 or (combo % 4) + 1
    end

    function R:_actualComboIndex(model)
        return model and self:_nextComboIndex(model:GetAttribute("Combo")) or nil
    end

    function R:_comboIndex(model)
        local now = os.clock()
        local state = self.ComboState and self.ComboState[model]
        if not state or now - state.last > 1.5 then
            state = { count = 1, last = now }
        elseif now - state.last < 0.12 then
            return state.count
        else
            state.count = math.min(4, state.count + 1)
            state.last = now
        end
        self.ComboState = self.ComboState or setmetatable({}, { __mode = "k" })
        self.ComboState[model] = state
        return state.count
    end

    function R:_fallbackDelay(model, attackType, comboIndex)
        local styleKey = styleOf(model)
        local speed = attackSpeedFor(model)
        local delay = attackType == "M2" and 0.30 or 0.32
        if attackType == "M1" and typeof(CombatConfig and CombatConfig.GetScaledStyleM1HitboxDelay) == "function" then
            local ok, value = pcall(CombatConfig.GetScaledStyleM1HitboxDelay, styleKey, comboIndex or 1, speed)
            if ok and typeof(value) == "number" and value > 0 then delay = value end
        elseif attackType == "M2" and typeof(CombatConfig and CombatConfig.GetStyleM2HitboxDelay) == "function" then
            local momentum = model and model:GetAttribute("HakariM2DoubleWindow") == true
            local okRaw, raw = pcall(CombatConfig.GetStyleM2HitboxDelay, styleKey, momentum)
            if okRaw and typeof(raw) == "number" then
                if typeof(CombatConfig.GetScaledHitboxDelay) == "function" then
                    local ok, value = pcall(CombatConfig.GetScaledHitboxDelay, raw, speed)
                    if ok and typeof(value) == "number" and value > 0 then delay = value end
                else
                    delay = raw
                end
            end
        end
        return delay, styleKey, speed
    end

    function R:_reactiveRawHitDelay(model, attackType, comboIndex, styleKey, attackSpeed)
        local config = CombatConfig
        styleKey = string.lower(tostring(styleKey or styleOf(model)))
        attackSpeed = math.max(0.05, tonumber(attackSpeed) or 1)
        if attackType == "M1" then
            local combo = math.clamp(math.floor(tonumber(comboIndex) or 1), 1, 4)
            if typeof(config and config.GetScaledStyleM1HitboxDelay) == "function" then
                local ok, delay = pcall(
                    config.GetScaledStyleM1HitboxDelay,
                    styleKey,
                    combo,
                    attackSpeed
                )
                if ok and typeof(delay) == "number" then return math.max(0, delay) end
            end
            local style
            if typeof(config and config.GetStyleConfig) == "function" then
                local ok, value = pcall(config.GetStyleConfig, styleKey)
                if ok and type(value) == "table" then style = value end
            end
            local delay = tonumber(style and style.M1HitboxDelay)
                or tonumber(config and config.M1 and config.M1.DefaultHitboxDelay)
                or 0.32
            local offsets = style and style.M1HitboxDelayOffsets
            if type(offsets) == "table" then
                delay += tonumber(offsets[combo]) or 0
            elseif typeof(config and config.GetStyleM1HitboxDelayOffset) == "function" then
                local ok, offset = pcall(config.GetStyleM1HitboxDelayOffset, styleKey, combo)
                if ok and typeof(offset) == "number" then delay += offset end
            end
            return math.max(0, delay)
        end

        local delay
        if typeof(config and config.GetStyleM2HitboxDelay) == "function" then
            local ok, value = pcall(config.GetStyleM2HitboxDelay, styleKey, false)
            if ok and typeof(value) == "number" then delay = value end
        end
        if typeof(delay) ~= "number"
            and typeof(config and config.GetStyleNumber) == "function" then
            local fallback = tonumber(config and config.M2 and config.M2.DefaultHitboxDelay)
                or 0.30
            local ok, value = pcall(
                config.GetStyleNumber,
                styleKey,
                "M2HitboxDelay",
                fallback
            )
            if ok and typeof(value) == "number" then delay = value end
        end
        delay = math.max(0, tonumber(delay)
            or tonumber(config and config.M2 and config.M2.DefaultHitboxDelay)
            or 0.30)
        if typeof(config and config.GetScaledHitboxDelay) == "function" then
            local ok, value = pcall(config.GetScaledHitboxDelay, delay, attackSpeed)
            if ok and typeof(value) == "number" then delay = math.max(0, value) end
        end
        return delay
    end

    function R:_reactiveHitboxDuration(styleKey, attackType)
        local fallback = attackType == "M2"
            and tonumber(CombatConfig and CombatConfig.M2 and CombatConfig.M2.HitboxDuration)
            or tonumber(CombatConfig and CombatConfig.M1 and CombatConfig.M1.HitboxDuration)
        fallback = fallback or 0.15
        if attackType == "M2"
            and typeof(CombatConfig and CombatConfig.GetStyleM2HitboxDuration) == "function" then
            local ok, duration = pcall(CombatConfig.GetStyleM2HitboxDuration, styleKey)
            if ok and typeof(duration) == "number" then return math.max(0, duration) end
        end
        if typeof(CombatConfig and CombatConfig.GetStyleNumber) == "function" then
            local field = attackType == "M2" and "M2HitboxDuration" or "M1HitboxDuration"
            local ok, duration = pcall(CombatConfig.GetStyleNumber, styleKey, field, fallback)
            if ok and typeof(duration) == "number" then return math.max(0, duration) end
        end
        return math.max(0, fallback)
    end

    function R:_reactivePulseTiming(threat, profile, strikeIndex)
        local engine = self:Engine()
        local fusion = engine == "Fusion" or engine == "Phantom" or engine == "Apex"
        if threat.sourceClass ~= "token"
            or not fusion or profile.attackType ~= "M2" then
            return nil
        end
        local timing = self.ReactiveTiming
        local attackType = profile.attackType
        local styleKey = string.lower(tostring(profile.styleKey or styleOf(threat.model)))
        local boxingM2 = attackType == "M2" and styleKey == "boxing"
        local strike = math.max(1, math.floor(tonumber(strikeIndex) or 1))
        if strike > 1 and not boxingM2 then return nil end

        local startedAt = tonumber(threat.startedAt) or os.clock()
        local livePing = tonumber(getPing())
        local ping = math.clamp(livePing or tonumber(self.PingEMA) or 0, 0, 0.35)
        local perfectWindow = tonumber(
            CombatConfig and CombatConfig.Block and CombatConfig.Block.PerfectBlockWindow
        ) or 0.125
        local rawHitDelay = self:_reactiveRawHitDelay(
            threat.model,
            attackType,
            profile.comboIndex or threat.comboIndex,
            styleKey,
            fusion and attackSpeedFor(threat.model) or 1
        )
        local styleDelay = attackType == "M2" and styleKey == "wrestling" and 0.05 or 0
        local compensatedPing = fusion and not boxingM2 and ping * 0.5 or ping
        local networkHitLead = math.min(compensatedPing, timing.NetworkHitCap)
        local hitDelay = math.max(0, rawHitDelay - networkHitLead + styleDelay)
        local timingTargetDelay = rawHitDelay + styleDelay
        local timingPing = compensatedPing
        local lowPingBonus = 0
        if boxingM2 then
            hitDelay = strike == 2 and timing.BoxingSecondHit or timing.BoxingFirstHit
            timingTargetDelay = hitDelay
            timingPing = ping >= timing.LowPingThreshold and compensatedPing or 0
            lowPingBonus = ping < timing.LowPingThreshold and timing.LowPingBonus or 0
        end

        local rawLead = timingPing
            - lowPingBonus
            + perfectWindow * timing.PerfectWindowWeight
            + timing.BaseLead
            + (attackType == "M2" and timing.M2Lead or 0)
        local baseRawLead = rawLead
        local appliedLead, leadCap
        if fusion then
            local userOffset = (tonumber(Options.TimingOffset and Options.TimingOffset.Value) or -85) / 1000
        if IsGakuran() and threat.attackType == "M1" then
            local sweetSpotDelay = tonumber(Options.GakuranSweetSpot and Options.GakuranSweetSpot.Value) or 0
            userOffset = userOffset + sweetSpotDelay
        end
            local offsetDelta = math.clamp(userOffset + 0.085, -0.035, 0.035)
            rawLead -= offsetDelta
            if engine == "Phantom" then
                appliedLead, leadCap = self:_phantomLeadBudget(
                    attackType, timingTargetDelay, rawLead, nil, styleKey)
            elseif engine == "Apex" then
                appliedLead, leadCap = self:_apexLeadBudget(
                    attackType, timingTargetDelay, rawLead, nil, styleKey)
            else
                appliedLead, leadCap = self:_fusionLeadBudget(attackType, timingTargetDelay, rawLead)
            end
        else
            appliedLead = rawLead
        end
        local blockDelay = timingTargetDelay - appliedLead
        local blockAt = startedAt + math.max(0, blockDelay)
        local hitAt = startedAt + hitDelay
        local duration = self:_reactiveHitboxDuration(styleKey, attackType)
        local cooldown = tonumber(
            CombatConfig and CombatConfig.Block and CombatConfig.Block.CooldownSeconds
        ) or 0.5
        local activationPing = ping >= timing.LowPingThreshold and ping or 0
        local hold
        if boxingM2 then
            hold = strike == 2 and timing.BoxingSecondHold
                or (fusion and self.BoxingM2FirstStrikeHoldSeconds or timing.BoxingFirstHold)
        elseif attackType == "M2" then
            local holdExtra = styleKey == "wrestling" and 0.10 or 0.02
            hold = math.clamp((hitAt - blockAt) + duration + holdExtra, 0.12, cooldown + 0.15)
        else
            hold = math.max(
                0.04,
                cooldown - activationPing,
                (hitAt - blockAt) + 0.05 - activationPing
            )
        end
        if fusion then hold += math.max(0, appliedLead - baseRawLead) end

        local highPingM1 = attackType == "M1" and ping >= timing.LowPingThreshold
        local confirmTail = (engine == "Phantom" and self:_phantomConfirmTail())
            or (engine == "Apex" and self:_apexConfirmTail())
            or (fusion and self.FusionTiming.ConfirmTail or timing.ConfirmTail)
        local confirmUntil = attackType == "M1" and not highPingM1
            and math.max(blockAt, hitAt - timing.NormalM1ConfirmLead)
            or hitAt + duration + confirmTail

        local retryLimit = (attackType == "M2" or highPingM1)
            and timing.RetryLimit or timing.NormalRetryLimit
        local retryInterval = highPingM1
            and timing.HighPingM1RetryInterval or timing.RetryInterval
        local initialRetryDelay = highPingM1
            and timing.HighPingM1InitialRetryDelay or timing.NormalInitialRetryDelay
        if fusion then
            if engine == "Phantom" then
                local pt = self.PhantomTiming
                local pingBoost = math.floor(
                    math.clamp(tonumber(self.PingEMA) or 0, 0, 0.35) * 10
                    * pt.PingRetryBoost)
                retryLimit = boxingM2 and strike == 2
                    and math.clamp(pt.M2RetryBase + pingBoost + 1, 0, 10)
                    or math.clamp(
                        (attackType == "M2" and pt.M2RetryBase or pt.M1RetryBase)
                        + pingBoost, 0, 10)
                retryInterval = math.clamp(
                    pt.BaseRetryInterval
                    + math.clamp(tonumber(self.PingEMA) or 0, 0, 0.35)
                        * pt.PingRetryScale,
                    pt.MinRetryInterval, pt.MaxRetryInterval)
                initialRetryDelay = math.max(retryInterval * 0.7, pt.MinRetryInterval)
            elseif engine == "Apex" then
                local at = self.ApexTiming
                local pingBoost = math.floor(
                    math.clamp(tonumber(self.PingEMA) or 0, 0, 0.35) * 10
                    * at.PingRetryBoost)
                retryLimit = boxingM2 and strike == 2
                    and math.clamp(at.M2RetryBase + pingBoost + 1, 0, 10)
                    or math.clamp(
                        (attackType == "M2" and at.M2RetryBase or at.M1RetryBase)
                        + pingBoost, 0, 10)
                retryInterval = math.clamp(
                    at.BaseRetryInterval
                    + math.clamp(tonumber(self.PingEMA) or 0, 0, 0.35)
                        * at.PingRetryScale,
                    at.MinRetryInterval, at.MaxRetryInterval)
                initialRetryDelay = math.max(retryInterval * 0.6, at.MinRetryInterval)
            else
                retryLimit = boxingM2 and strike == 2
                    and self.FusionTiming.BoxingSecondRetryLimit
                    or self.FusionTiming.RemoteM2RetryLimit
                retryInterval = math.max(self.FusionTiming.RemoteRetryInterval, retryInterval)
                initialRetryDelay = math.max(self.FusionTiming.RemoteInitialRetryDelay, initialRetryDelay)
            end
        end
        return {
            blockAt = blockAt,
            hitAt = hitAt,
            confirmUntil = confirmUntil,
            hitDelay = hitDelay,
            timingTargetDelay = timingTargetDelay,
            blockDelay = math.max(0, blockDelay),
            hold = hold,
            ping = ping,
            timingPing = timingPing,
            perfectWindow = perfectWindow,
            hitboxDuration = duration,
            boxingSecond = boxingM2 and strike == 2,
            retryLimit = retryLimit,
            retryInterval = retryInterval,
            initialRetryDelay = initialRetryDelay,
            fusionRawLead = fusion and rawLead or nil,
            fusionLead = fusion and appliedLead or nil,
            fusionLeadCap = fusion and leadCap or nil,
        }
    end

    function R:_multiHitCount(styleKey, attackType)
        if attackType ~= "M2" then return 1 end
        local data = self:_styleData(styleKey)
        return math.clamp(math.floor(tonumber(data and data.M2MultiHitCount) or 1), 1, 4)
    end

    function R:_multiHitGap(styleKey, attackType)
        return attackType == "M2" and string.lower(tostring(styleKey or "")) == "boxing"
            and self.BoxingM2GapSeconds or 0.42
    end

    function R:_reactiveForwardReach(styleKey, attackType)
        local config = CombatConfig
        local offset
        if typeof(config and config.GetStyleHitboxForwardOffset) == "function" then
            local ok, value = pcall(config.GetStyleHitboxForwardOffset, styleKey, attackType)
            if ok and typeof(value) == "number" then offset = value end
        end
        if typeof(offset) ~= "number" then
            local root = attackType == "M2" and config and config.M2 or config and config.M1
            offset = tonumber(root and root.DefaultHitboxForwardOffset) or 4
            if typeof(config and config.GetStyleNumber) == "function" then
                local field = attackType == "M2"
                    and "M2HitboxForwardOffsetBonus" or "M1HitboxForwardOffsetBonus"
                local ok, bonus = pcall(config.GetStyleNumber, styleKey, field, 0)
                if ok and typeof(bonus) == "number" then offset += bonus end
            end
        end
        return math.max(0, offset + 1.75
            + (attackType == "M2" and 0.35 or 0))
    end

    function R:_reactiveThreatSnapshot(item, myRoot, enemyRoot)
        if not (item and myRoot and enemyRoot) then return nil end
        local profile = item.profile or {}
        local decision = self.ReactiveDecision
        local attackType = item.attackType == "M2" and "M2" or "M1"
        local styleKey = string.lower(tostring(profile.styleKey or styleOf(item.model)))
        local relative3 = enemyRoot.Position - myRoot.Position
        local relative = Vector3.new(relative3.X, 0, relative3.Z)
        local distance = relative.Magnitude
        local direction = distance > 0.001 and relative.Unit or Vector3.new(0, 0, -1)
        local enemyLook3 = enemyRoot.CFrame.LookVector
        local enemyLook = Vector3.new(enemyLook3.X, 0, enemyLook3.Z)
        local myLook3 = myRoot.CFrame.LookVector
        local myLook = Vector3.new(myLook3.X, 0, myLook3.Z)
        local attackerFacingDot = enemyLook.Magnitude > 0.001
            and enemyLook.Unit:Dot(-direction) or 1
        local localFacingDot = myLook.Magnitude > 0.001
            and myLook.Unit:Dot(direction) or 1

        local relativeVelocity3 =
            enemyRoot.AssemblyLinearVelocity - myRoot.AssemblyLinearVelocity
        local relativeVelocity =
            Vector3.new(relativeVelocity3.X, 0, relativeVelocity3.Z)
        local approachSpeed = relativeVelocity:Dot(-direction)
        local lateralVelocity = relativeVelocity + direction * approachSpeed
        local lateralSpeed = lateralVelocity.Magnitude
        local now = os.clock()
        local hitAt = tonumber(item.predictedImpactAt) or now
        local duration = tonumber(item.reactivePulse and item.reactivePulse.hitboxDuration)
            or self:_reactiveHitboxDuration(styleKey, attackType)
        local horizon = math.clamp(
            hitAt + duration + decision.ProjectionPadding - now,
            0,
            1.25
        )
        local projectedDistance = distance
        local projectedTime = 0
        local speedSquared = relativeVelocity:Dot(relativeVelocity)
        if distance > 0.001 and speedSquared > 0.01 and horizon > 0 then
            projectedTime = math.clamp(
                -relative:Dot(relativeVelocity) / speedSquared,
                0,
                horizon
            )
            projectedDistance = (relative + relativeVelocity * projectedTime).Magnitude
        end

        local reach = self:_reactiveForwardReach(styleKey, attackType)
        local maxRange = math.max(0, tonumber(profile.maxRange) or 10)
        local rangeDistance = math.min(distance, projectedDistance)
        local withinRange = rangeDistance <= maxRange
        local pointBlank = distance <= decision.PointBlankRange
            or (distance <= decision.PointBlankLooseRange
                and attackerFacingDot >= decision.PointBlankFacing)
        local direct = distance <= reach and attackerFacingDot >= decision.FacingThreshold
        local closeFacing = distance <= reach
            and attackerFacingDot >= decision.CloseFacingThreshold
        local approachContact = projectedDistance <= reach
            + (attackType == "M2"
                and decision.M2OmniContactBuffer or decision.M1OmniContactBuffer)
        local crossingContact = approachContact and (
            approachSpeed >= 2 or lateralSpeed >= 2.5 or projectedTime > 0
        )

        local inside, reason = false, "no-live-threat"
        if item.reactiveBoxingSecond or item.fusionBoxingSecond then
            inside = withinRange
            reason = inside and "boxing-second-pulse" or reason
        elseif attackType == "M2" then
            local wrestling = styleKey == "wrestling"
                and distance <= decision.WrestlingRange
            local forwardLunge = distance <= decision.ForwardLungeRange
                and attackerFacingDot >= decision.FacingThreshold
            local omnidirectional = distance <= reach + decision.M2OmniContactBuffer
            inside = withinRange and (
                wrestling or forwardLunge or omnidirectional or pointBlank
                    or direct or closeFacing or crossingContact
            )
            if wrestling then
                reason = "wrestling-grab-proximity"
            elseif forwardLunge then
                reason = "forward-lunge-M2"
            elseif omnidirectional then
                reason = "omnidirectional-M2"
            elseif pointBlank then
                reason = "point-blank-overlap"
            elseif crossingContact then
                reason = "moving-M2-contact"
            elseif direct or closeFacing then
                reason = "facing-M2"
            end
        else
            local directBuffer = distance <= reach + decision.M1DirectThreatBuffer
                and attackerFacingDot >= decision.FacingThreshold
            local omnidirectional = distance <= reach + decision.M1OmniContactBuffer
                and (pointBlank or crossingContact)
            inside = withinRange and (
                direct or closeFacing or directBuffer or omnidirectional
                    or pointBlank or crossingContact
            )
            if pointBlank then
                reason = "point-blank-overlap"
            elseif crossingContact then
                reason = "moving-M1-contact"
            elseif omnidirectional then
                reason = "omnidirectional-M1"
            elseif directBuffer then
                reason = "facing-M1-buffer"
            elseif direct or closeFacing then
                reason = "facing-M1"
            end
        end

        return {
            inside = inside,
            reason = reason,
            distanceStuds = distance,
            projectedDistanceStuds = projectedDistance,
            projectedContactIn = projectedTime,
            projectedLateralSpeed = lateralSpeed,
            approachSpeed = approachSpeed,
            reachStuds = reach,
            attackerFacingDot = attackerFacingDot,
            localFacingDot = localFacingDot,
            withinRange = withinRange,
            styleKey = styleKey,
            attackType = attackType,
        }
    end

    function R:_profileGeometry(measured)
        return {
            maxRange = math.max(0, tonumber(Options.MaxRange and Options.MaxRange.Value) or 10),
            hitboxX = tonumber(measured and measured.HitboxX) or self.DefaultProfile.HitboxX,
            hitboxY = tonumber(measured and measured.HitboxY) or self.DefaultProfile.HitboxY,
            hitboxZ = tonumber(measured and measured.HitboxZ) or self.DefaultProfile.HitboxZ,
            hso = tonumber(measured and measured.HSO) or self.DefaultProfile.HSO,
            hold = math.max(0.05, (tonumber(Options.BlockHold and Options.BlockHold.Value) or 394) / 1000),
        }
    end

    function R:_resolveProfile(threat)
        if threat.track then
            local id = threat.id
            local custom = id and Config.parries[id]
            if not self:IsAllKnown() and not custom then return nil end
            local measured = id and INTERIUM_MEASURED_PROFILES[id]
            local db = id and AttackDB[id]
            local impactPosition, name, source
            if custom then
                impactPosition = tonumber(custom.delay)
                name = custom.name
                source = "builder"
            elseif (self:Engine() == "Fusion") and db then
                impactPosition = tonumber(db.delay)
                name = db.name
                source = "combat-config"
            elseif measured then
                impactPosition = tonumber(measured.Delay)
                name = measured.Name
                source = "measured-v1"
            elseif db then
                impactPosition = tonumber(db.delay)
                name = db.name
                source = "combat-config"
            end
            if not impactPosition or impactPosition < 0 then
                -- Generic-combo fallback: the animation id is not in any
                -- database, but the style is known and the game exposes combo
                -- index + config delays, so synthesize a profile instead of
                -- dropping the threat (previously a guaranteed free hit).
                local combo = math.clamp(math.floor(tonumber(
                    threat.comboIndex or self:_actualComboIndex(threat.model) or 1) or 1), 1, 4)
                local styleKey = styleOf(threat.model)
                local genericDelay
                if threat.attackType == "M2" then
                    if typeof(CombatConfig and CombatConfig.GetStyleM2HitboxDelay) == "function" then
                        local okRaw, raw = pcall(CombatConfig.GetStyleM2HitboxDelay, styleKey)
                        if okRaw and typeof(raw) == "number" then
                            if typeof(CombatConfig.GetScaledHitboxDelay) == "function" then
                                local ok, v = pcall(CombatConfig.GetScaledHitboxDelay, raw, 1)
                                if ok then genericDelay = tonumber(v) end
                            else
                                genericDelay = raw
                            end
                        end
                    end
                elseif typeof(CombatConfig and CombatConfig.GetScaledStyleM1HitboxDelay) == "function" then
                    local ok, v = pcall(CombatConfig.GetScaledStyleM1HitboxDelay, styleKey, combo, 1)
                    if ok then genericDelay = tonumber(v) end
                end
                if genericDelay and genericDelay > 0 then
                    local geometry = self:_profileGeometry(nil)
                    local _, styleSource = ResolveCombatStyle(threat.model)
                    geometry.impactPosition = genericDelay
                    geometry.name = "generic/" .. tostring(styleKey)
                    geometry.source = "generic-combo"
                    geometry.styleKey = styleKey
                    geometry.combatStyleSource = styleSource
                    geometry.attackType = threat.attackType or "M1"
                    geometry.comboIndex = combo
                    geometry.animationLeadCorrection = 0
                    geometry.multiHitCount = self:_multiHitCount(styleKey, geometry.attackType)
                    geometry.multiHitGap = self:_multiHitGap(styleKey, geometry.attackType)
                    return geometry
                end
                return nil
            end
            if not impactPosition or impactPosition < 0 then return nil end
            local geometry = self:_profileGeometry(measured)
            local resolvedStyle, styleSource = ResolveCombatStyle(threat.model)
            local customHold = custom and tonumber(custom.hold)
            if customHold then geometry.hold = math.max(0.05, customHold) end
            geometry.impactPosition = impactPosition
            geometry.name = tostring(name or id)
            geometry.source = source
            geometry.styleKey = db and db.style or resolvedStyle
            geometry.combatStyleSource = styleSource
            geometry.attackType = db and (db.kind == "M2" or db.kind == "M2M") and "M2"
                or threat.attackType or "M1"
            geometry.comboIndex = db and db.idx or threat.comboIndex
            local leadCorrections = geometry.attackType == "M2"
                and self.M2LeadCorrection or self.M1LeadCorrection
            geometry.animationLeadCorrection = (tonumber(leadCorrections[id]) or 0)
                + (custom and tonumber(custom.leadCorrection) or 0)
            geometry.multiHitCount = self:_multiHitCount(geometry.styleKey, geometry.attackType)
            geometry.multiHitGap = self:_multiHitGap(geometry.styleKey, geometry.attackType)
            return geometry
        end

        if not self:IsAllKnown() then return nil end
        local combo = threat.attackType == "M1"
            and (threat.comboIndex or self:_actualComboIndex(threat.model)
                or self:_comboIndex(threat.model)) or 1
        combo = math.clamp(math.floor(tonumber(combo) or 1), 1, 4)
        local delay, styleKey, speed = self:_fallbackDelay(threat.model, threat.attackType, combo)
        local _, styleSource = ResolveCombatStyle(threat.model)
        local geometry = self:_profileGeometry(nil)
        geometry.name = tostring(threat.source or threat.attackType)
        geometry.source = threat.sourceClass
        geometry.styleKey = styleKey
        geometry.combatStyleSource = styleSource
        geometry.attackType = threat.attackType
        geometry.attackSpeed = speed
        geometry.comboIndex = combo
        geometry.impactAt = (tonumber(threat.startedAt) or os.clock())
            + (tonumber(threat.windupSeconds) or delay)
        geometry.multiHitCount = threat.sourceClass == "special"
            and 1 or self:_multiHitCount(styleKey, threat.attackType)
        geometry.multiHitGap = self:_multiHitGap(styleKey, threat.attackType)
        return geometry
    end

    function R:_directServerRemote()
        local remotes = ReplicatedStorage:FindFirstChild("Remotes")
        local server = remotes and remotes:FindFirstChild("Server")
        return server and server:IsA("RemoteEvent") and server or nil
    end

    function R:_preferredMethod(attempt)
        if attempt and attempt.transportResolved then
            return attempt.transportMethod, attempt.transportDriver
        end
        local selected = tostring(Options.ParryMethod and Options.ParryMethod.Value or "Auto")
        local method, driver
        if (selected == "Module" or selected == "Auto")
            and not (attempt and attempt.transportSkipModule) then
            local module = getBlockModule()
            if module and typeof(module.Block) == "function"
                and typeof(module.Unblock) == "function" then
                method, driver = "Module", module
            end
        end
        if not method and (selected == "Remote" or selected == "Auto")
            and not (attempt and attempt.transportSkipRemote) then
            driver = self:_directServerRemote()
            method = driver and "Remote" or nil
        end
        if not method and (selected == "VIM" or selected == "Auto") and not IsTouchPrimary() then
            method = "VIM"
        end
        if attempt then
            attempt.transportResolved = true
            attempt.transportMethod = method
            attempt.transportDriver = driver
            attempt.transportSelection = selected
        end
        return method, driver
    end

    function R:_fireRemoteBlock(remote, active)
        if not (remote and remote:IsA("RemoteEvent")) then return false end
        return pcall(function()
            if active then
                -- M1 Cancel: Forcefully stop any ongoing attack animation before blocking
                pcall(function()
                    remote:FireServer({
                        Type = "Combat",
                        Action = "M1",
                        Func = "HoldDeactivated"
                    })
                end)
            end
            local payload = {
                Type = "Combat",
                Func = active and "Activated" or "Deactivated",
                Action = "Block",
            }
            if active and IsGakuran() then
                -- Machine-Gun Parry: Fast release block in Gakuran.
                -- Cancel any pending release thread before starting a
                -- new one so rapid parries do not stack multiple
                -- Deactivated remotes (which desyncs block state and
                -- wastes memory on orphaned threads).
                if self._machineGunThread then
                    pcall(task.cancel, self._machineGunThread)
                end
                self._machineGunThread = task.delay(0.08, function()
                    self._machineGunThread = nil
                    pcall(function()
                        remote:FireServer({
                            Type = "Combat",
                            Func = "Deactivated",
                            Action = "Block",
                        })
                    end)
                end)
            end
            if active then
                local serverTime = (typeof(Workspace.GetServerTimeNow) == 'function' and Workspace:GetServerTimeNow()) or os.time()
                local totalOffset = 0
                _stampCombatCredit("Block.Activated")
                remote:FireServer(payload, serverTime + totalOffset)
            else
                remote:FireServer(payload)
            end
        end)
    end

    function R:_pressRemoteBlock(remote)
        return self:_fireRemoteBlock(remote, true)
    end

    -- Single VIM fallback helper: replaces three identical copies
    -- of the same VirtualInputManager fallback block that were
    -- inline in _pressBlock. Returns true, vim on success.
    function R:_tryVIMFallback(attempt, fromMethod, reason)
        if IsTouchPrimary() then return false, nil end
        local okService, vim = pcall(game.GetService, game, "VirtualInputManager")
        if not okService or not vim then return false, nil end
        local vimOk = pcall(vim.SendKeyEvent, vim, true, Enum.KeyCode.F, false, game)
        if not vimOk then return false, nil end
        if attempt then
            attempt.transportResolved = true
            attempt.transportMethod = "VIM"
            attempt.transportDriver = vim
        end
        self:_diagnosticRecord("transport-fallback", attempt or {}, {
            from = fromMethod,
            to = "VIM",
            reason = reason,
        })
        return true, vim
    end

    function R:_pressBlock(attempt)
        local method, driver = self:_preferredMethod(attempt)
        if method == "Remote" then
            local ok = self:_pressRemoteBlock(driver)
            if ok then return true, method, driver end
            local selected = attempt and attempt.transportSelection
                or tostring(Options.ParryMethod and Options.ParryMethod.Value or "Auto")
            if selected == "Auto" then
                if attempt then
                    attempt.transportSkipRemote = true
                    attempt.transportResolved = false
                end
                local vimOk, vim = self:_tryVIMFallback(attempt, "Remote", "remote-press-failed")
                if vimOk then return true, "VIM", vim end
            end
            return false, method, driver
        end
        if method == "Module" then
            _stampCombatCredit("Block.Activated")
            local ok, result = pcall(driver.Block)
            if ok and result ~= false then return true, method, driver end
            if not ok then _cachedBlockMod = nil end
            local selected = attempt and attempt.transportSelection
                or tostring(Options.ParryMethod and Options.ParryMethod.Value or "Auto")
            if selected == "Auto" then
                if attempt then
                    attempt.transportSkipModule = true
                    attempt.transportResolved = false
                end
                local remote = self:_directServerRemote()
                if remote then
                    if attempt then
                        attempt.transportResolved = true
                        attempt.transportMethod = "Remote"
                        attempt.transportDriver = remote
                    end
                    self:_diagnosticRecord("transport-fallback", attempt or {}, {
                        from = "Module",
                        to = "Remote",
                        reason = ok and "module-returned-false" or "module-error",
                    })
                    local remoteOk = self:_pressRemoteBlock(remote)
                    if remoteOk then return true, "Remote", remote end
                    if attempt then
                        attempt.transportSkipRemote = true
                        attempt.transportResolved = false
                    end
                    local vimOk, vim = self:_tryVIMFallback(attempt, "Remote", "remote-press-failed")
                    if vimOk then return true, "VIM", vim end
                    return false, "Remote", remote
                end
                local vimOk, vim = self:_tryVIMFallback(attempt, "Module", "remote-unavailable")
                if vimOk then return true, "VIM", vim end
            end
            return false, method, driver
        end
        if method == "VIM" then
            if IsTouchPrimary() then return false, method, nil end
            local okService, vim = pcall(game.GetService, game, "VirtualInputManager")
            if not okService or not vim then return false, method, nil end
            local ok = pcall(vim.SendKeyEvent, vim, true, Enum.KeyCode.F, false, game)
            if ok then return true, method, vim end
            return false, method, vim
        end
        return false, "Unavailable", nil
    end

    function R:_releaseBlock(reason)
        local block = self.Block
        local now = os.clock()
        local wasActive = block.active == true
        if self._machineGunThread then
            pcall(task.cancel, self._machineGunThread)
            self._machineGunThread = nil
        end
        local attempt = block.attempt
        if wasActive then block.lastReleaseAt = now end
        if block.method == "Module" and block.module and typeof(block.module.Unblock) == "function" then
            pcall(block.module.Unblock)
        elseif block.method == "VIM" and block.vim then
            pcall(block.vim.SendKeyEvent, block.vim, false, Enum.KeyCode.F, false, game)
        elseif block.method == "Remote" and block.remote then
            self:_fireRemoteBlock(block.remote, false)
        end
        if wasActive then
            self:_diagnosticRecord("block-release-command", attempt or {}, {
                reason = tostring(reason or "release"),
                heldMs = block.pressedAt and (now - block.pressedAt) * 1000 or nil,
                blockCommandSequence = attempt and attempt.blockCommandSequence
                    or block.commandSequence,
            })
        end
        block.active = false
        block.releaseAt = 0
        block.method = nil
        block.module = nil
        block.vim = nil
        block.remote = nil
        block.pressedAt = nil
        block.attempt = nil
        block.activationCaptured = false
        block.confirmed = false
        block.confirmationFailed = false
        block.confirmUntil = 0
        block.moduleFallbackAt = 0
        block.retryAt = 0
        block.retryCount = 0
        block.retryLimit = 0
        block.retryInterval = 0.061
        block.baselineBlocking = false
        block.baselinePerfectBlocking = false
        block.blockingSawFalse = true
        block.perfectSawFalse = true
        block.softPending = false
        self:_refreshPauseM1()
    end

    function R:StopForTyping()
        self:_releaseBlock("typing-focus")
        self.StatusDirty = true
    end

    function R:_resetRemoteConfirmation(reason)
        local block = self.Block
        if not block.active or block.method ~= "Remote" or not block.confirmed then
            return false
        end
        local character = LocalPlayer.Character
        if character and (character:GetAttribute("Blocking") == true
            or character:GetAttribute("PerfectBlocking") == true) then
            return false
        end
        block.confirmed = false
        block.confirmationFailed = false
        block.blockingSawFalse = true
        block.perfectSawFalse = true
        block.retryAt = math.min(block.retryAt or 0, os.clock())
        self:_refreshPauseM1()
        self:_diagnosticRecord("block-confirmation-lost", block.attempt or {}, {
            reason = tostring(reason or "attributes-cleared"),
            retries = block.retryCount,
        })
        return true
    end

    function R:_tickTransportFallback(now)
        local pending = self.TransportFallback
        if not pending then return end
        local attempt = pending.attempt
        if not self.CombatRunning or not self:IsAutoEnabled()
            or not attempt or attempt.cancelled or attempt.resolved
            or (attempt.token and attempt.token.cancelled) then
            self.TransportFallback = nil
            return
        end
        if now >= pending.untilAt then
            self.TransportFallback = nil
            self:_diagnosticRecord("transport-fallback-expired", attempt, {
                reason = "module-cooldown",
            })
            local emergencyItem = attempt.emergencyDodgeItem
            if emergencyItem and attempt.emergencyDodgeEligible == true then
                local dodged = self:_tryReservedEmergencyDodge(
                    emergencyItem,
                    attempt,
                    "module-cooldown"
                )
                if not dodged then self:_cancelItem(emergencyItem) end
            end
            return
        end
        local character = LocalPlayer.Character
        local interaction = self:_localInteractionReason(character)
        if not character or not character.Parent
            or character:GetAttribute("Equip") ~= true
            or character:GetAttribute("BlockCooldown") == true
            or character:GetAttribute("Ragdoll") == true
            or character:GetAttribute("Downed") == true
            or character:GetAttribute("GuardBroken") == true
            or character:GetAttribute("Greenzone") == true
            or character:GetAttribute("RpCombatLocked") == true
            or interaction then
            return
        end
        self.TransportFallback = nil
        attempt.transportSkipModule = true
        attempt.transportResolved = false
        local remaining = pending.untilAt - now
        if remaining < 0.05 then
            self:_diagnosticRecord("transport-fallback-expired", attempt, {
                reason = "insufficient-hold-window",
            })
            local emergencyItem = attempt.emergencyDodgeItem
            if emergencyItem and attempt.emergencyDodgeEligible == true then
                local dodged = self:_tryReservedEmergencyDodge(
                    emergencyItem,
                    attempt,
                    "insufficient-hold-window"
                )
                if not dodged then self:_cancelItem(emergencyItem) end
            end
            return
        end
        local ok = self:RequestBlock(remaining, attempt)
        if not ok then
            self:_diagnosticRecord("transport-fallback-failed", attempt, {
                reason = "cooldown-cleared-but-transport-unavailable",
            })
            local emergencyItem = attempt.emergencyDodgeItem
            if emergencyItem and attempt.emergencyDodgeEligible == true then
                local dodged = self:_tryReservedEmergencyDodge(
                    emergencyItem,
                    attempt,
                    "cooldown-cleared-but-transport-unavailable"
                )
                if not dodged then self:_cancelItem(emergencyItem) end
            end
        end
    end

    function R:_remoteRetryPolicy(attempt)
        local attackType = attempt and attempt.profile and attempt.profile.attackType
        local engine = attempt and attempt.engine or self:Engine()
        if engine == "Phantom" then
            return self:_phantomRetryPolicy(attempt)
        end
        if engine == "Apex" then
            return self:_apexRetryPolicy(attempt)
        end
        local cap = attackType == "M1" and 2 or 3
        local requested = tonumber(attempt and attempt.reactiveRetryLimit)
        local interval = math.max(0.061, tonumber(attempt and attempt.reactiveRetryInterval)
            or self.FusionTiming.RemoteRetryInterval)
        local initialDelay = math.max(0.061, tonumber(attempt and attempt.reactiveInitialRetryDelay)
            or interval)
        return math.clamp(math.floor(requested or cap), 0, cap), interval, initialDelay
    end

    function R:RequestBlock(hold, attempt)
        if Library._ShouldStopAutomationForTyping() then return false end
        local now = os.clock()
        hold = math.max(0.05, tonumber(hold) or 0.394)
        local block = self.Block
        if self.TransportFallback and self.TransportFallback.attempt ~= attempt then
            self.TransportFallback = nil
        end
        if self.Block.active and attempt and self.Block.attempt ~= attempt then
            attempt.freshRearm = true
            self:_releaseBlock("fresh-rearm")
        end
        if self.Block.active then
            self.Block.releaseAt = math.max(self.Block.releaseAt, now + hold)
            if attempt then
                self.Block.attempt = attempt
                attempt.commandAt = now
                attempt.method = self.Block.method
                attempt.issued = true
            end
            self:_diagnosticRecord("block-extend", attempt or {}, {
                holdMs = hold * 1000,
            })
            return true
        end
        if attempt then
            attempt.sincePreviousBlockCommandMs = block.lastCommandAt > 0
                and (now - block.lastCommandAt) * 1000 or nil
            attempt.sincePreviousBlockReleaseMs = block.lastReleaseAt > 0
                and (now - block.lastReleaseAt) * 1000 or nil
        end
        local character = LocalPlayer.Character
        if character and character:GetAttribute("BlockCooldown") == true then
            self:_diagnosticRecord("block-cooldown", attempt or {}, {
                holdMs = hold * 1000,
            })
            return false
        end
        local blockingWasActive = character
            and character:GetAttribute("Blocking") == true or false
        local perfectWasActive = character
            and character:GetAttribute("PerfectBlocking") == true or false
        block.commandSequence += 1
        block.lastCommandAt = now
        if attempt then attempt.blockCommandSequence = block.commandSequence end
        self.Block.pressedAt = now
        self.Block.attempt = attempt
        self.Block.activationCaptured = false
        local ok, method, driver = self:_pressBlock(attempt)
        if not ok then
            self:_diagnosticRecord("block-press-failed", attempt or {}, {
                method = method,
                holdMs = hold * 1000,
                blockCommandSequence = block.commandSequence,
            })
            self.Block.pressedAt = nil
            self.Block.attempt = nil
            self.Block.activationCaptured = false
            return false
        end
        self.Block.active = true
        self.Block.releaseAt = now + hold
        self.Block.method = method
        self.Block.module = method == "Module" and driver or nil
        self.Block.vim = method == "VIM" and driver or nil
        self.Block.remote = method == "Remote" and driver or nil
        self.Block.confirmed = false
        self.Block.confirmationFailed = false
        self.Block.baselineBlocking = blockingWasActive
        self.Block.baselinePerfectBlocking = perfectWasActive
        self.Block.blockingSawFalse = not blockingWasActive
        self.Block.perfectSawFalse = not perfectWasActive
        self.Block.softPending = character
            and character:GetAttribute("ParryBuffered") == true or false
        local predictedConfirmAt = (tonumber(attempt and attempt.predictedImpactAt) or now)
            + self.FusionTiming.ConfirmTail
        self.Block.confirmUntil = method == "Remote"
            and math.max(
                tonumber(attempt and attempt.reactiveConfirmUntil) or 0,
                predictedConfirmAt,
                now + 0.10
            ) or 0
        local selected = attempt and attempt.transportSelection
            or tostring(Options.ParryMethod and Options.ParryMethod.Value or "Auto")
        self.Block.moduleFallbackAt = method == "Module" and selected == "Auto"
            and (now + math.max(0.061, self.FusionTiming.RemoteRetryInterval)) or 0
        local retryLimit, retryInterval, initialRetryDelay = self:_remoteRetryPolicy(attempt)
        self.Block.retryAt = now + initialRetryDelay
        self.Block.retryCount = 0
        self.Block.retryLimit = method == "Remote" and retryLimit or 0
        self.Block.retryInterval = retryInterval
        if attempt then
            attempt.commandAt = now
            attempt.method = method
            attempt.issued = true
        end
        self:_refreshPauseM1()
        self:_diagnosticRecord("block-press-command", attempt or {}, {
            method = method,
            holdMs = hold * 1000,
            blockCommandSequence = block.commandSequence,
            transportFrozen = attempt and attempt.transportResolved == true or false,
            baselineBlocking = blockingWasActive,
            baselinePerfectBlocking = perfectWasActive,
            softPending = self.Block.softPending,
            retryLimit = self.Block.retryLimit,
            retryIntervalMs = self.Block.retryInterval * 1000,
        })
        return true
    end

    function R:_claim(threat, profile)
        local now = os.clock()
        local key = tostring(threat.model)
        local engine = self:Engine()
        local boxingM2 = threat.attackType == "M2"
            and string.lower(tostring(profile and profile.styleKey or "")) == "boxing"
        local fusionLikeClaim = engine == "Fusion"
        local priorities = fusionLikeClaim and boxingM2 and self.FusionBoxingM2SourcePriority
            or (fusionLikeClaim and threat.attackType == "M2" and self.FusionM2SourcePriority)
            or self.SourcePriority
        local priority = tonumber(threat.priority)
            or priorities[threat.sourceClass] or 1
        local previous = self.Claims[key]
        local window = boxingM2 and self.BoxingM2ClaimSeconds
            or (threat.attackType == "M2" and 0.75 or 0.22)
        if previous and now - previous.time < window then
            local fusionAttackUpgrade = (engine == "Fusion")
                and previous.attackType == "M1" and threat.attackType == "M2"
                and now - previous.time <= self.TokenReclassifySeconds
            if priority < previous.priority and not fusionAttackUpgrade then return nil end
            if fusionAttackUpgrade then priority = math.max(priority, previous.priority) end
            if priority == previous.priority then
                local separateAnimation = threat.sourceClass == "animation"
                    and previous.sourceClass == "animation"
                    and tostring(previous.identity) ~= tostring(threat.identity)
                    and now - previous.time >= 0.08
                local capoeiraUpgrade = threat.isCapoeiraEnd == true
                    and previous.isCapoeira == true
                local attackUpgrade = previous.attackType == "M1"
                    and threat.attackType == "M2"
                    and now - previous.time <= self.TokenReclassifySeconds
                if not separateAnimation and not capoeiraUpgrade and not attackUpgrade then return nil end
                if separateAnimation then previous = nil end
            end
            if previous and previous.token then
                local supersededToken = previous.token
                supersededToken.cancelled = true
                supersededToken.cancelReason = "superseded-by-" .. tostring(threat.sourceClass)
                if engine == "Fusion" then
                    for _, attempt in ipairs(self.Attempts) do
                        if attempt.token == supersededToken then attempt.cancelled = true end
                    end
                    if self.Block.attempt and self.Block.attempt.token == supersededToken then
                        self:_releaseBlock("claim-superseded")
                    end
                end
                self:_diagnosticRecord("claim-superseded", threat, {
                    previousSourceClass = previous.sourceClass,
                    previousAttackType = previous.attackType,
                })
            end
        end
        self.Sequence += 1
        local token = {
            id = self.Sequence,
            cancelled = false,
            generation = self.Generation,
            model = threat.model,
        }
        self.Claims[key] = {
            time = now,
            priority = priority,
            sourceClass = threat.sourceClass,
            attackType = threat.attackType,
            identity = threat.identity,
            isCapoeira = threat.isCapoeira,
            strategy = threat.strategy,
            token = token,
        }
        self.ClaimSweep += 1
        if self.ClaimSweep >= 40 then
            self.ClaimSweep = 0
            for claimKey, claim in pairs(self.Claims) do
                if now - claim.time > 2 then self.Claims[claimKey] = nil end
            end
        end
        return token
    end

    function R:_remaining(item, now)
        if item.track then
            local ok, position, speed, playing = pcall(function()
                return tonumber(item.track.TimePosition) or 0,
                    tonumber(item.track.Speed) or 0,
                    item.track.IsPlaying
            end)
            if not ok or playing ~= true then
                if now - item.createdAt <= 0.06 then return math.huge end
                return nil
            end
            if speed == 0 then return math.huge end
            return (item.impactPosition - position) / math.abs(speed)
        end
        return item.impactAt - now
    end

    function R:_fusionLeadBudget(attackType, windup, rawLead, transportFloor)
        local timing = self.FusionTiming
        local m2 = attackType == "M2"
        local minimum = math.max(
            m2 and timing.M2MinLead or timing.M1MinLead,
            math.max(0, tonumber(transportFloor) or 0)
        )
        local minimumCap = m2 and timing.M2MinEarlyCap or timing.M1MinEarlyCap
        local maximumCap = m2 and timing.M2MaxEarlyCap or timing.M1MaxEarlyCap
        local fraction = m2 and timing.M2WindupFraction or timing.M1WindupFraction
        local cap = math.clamp(math.max(0, tonumber(windup) or 0) * fraction,
            minimumCap, maximumCap)
        minimum = math.min(minimum, cap)
        return math.clamp(tonumber(rawLead) or 0, minimum, cap), cap
    end

    --[[
        Phantom apply tuning: overrides PhantomTiming with values from UI
        when PhantomTuningEnabled is true. Restores defaults when disabled.
    ]]
    function R:_phantomApplyTuning()
        local Options = self.Options or {}
        local tuningEnabled = Options.PhantomTuningEnabled
            and Options.PhantomTuningEnabled.Value == true
        if not tuningEnabled then
            -- Restore defaults if we have them
            if self._phantomTimingDefaults then
                self.PhantomTiming = self._phantomTimingDefaults
                self._phantomTimingDefaults = nil
            end
            return
        end
        -- Save defaults on first enable
        if not self._phantomTimingDefaults then
            local copy = {}
            for k, v in pairs(self.PhantomTiming) do
                copy[k] = v
            end
            self._phantomTimingDefaults = copy
        end
        local timing = self.PhantomTiming
        local function optMs(name, defaultMs)
            local o = Options[name]
            if o and o.Value ~= nil then return (o.Value / 1000) end
            return defaultMs
        end
        local function optFrac(name, defaultFrac)
            local o = Options[name]
            if o and o.Value ~= nil then return (o.Value / 100) end
            return defaultFrac
        end
        timing.PingLeadFactor   = optFrac("PhantomPingLeadFactor",     timing.PingLeadFactor)
        timing.JitterLeadBonus  = optMs("PhantomJitterBonus",          timing.JitterLeadBonus)
        timing.PingSpikeLeadBonus = optMs("PhantomSpikeBonus",         timing.PingSpikeLeadBonus)
        timing.MultiThreatWindow      = optMs("PhantomMultiThreatWindow",      timing.MultiThreatWindow)
        timing.FeintRecoveryWindow    = optMs("PhantomFeintWindow",          timing.FeintRecoveryWindow)
        timing.MultiThreatBlockExtend = optMs("PhantomBlockExtend",          timing.MultiThreatBlockExtend)
        timing.BaseLead         = optMs("PhantomRhythmBonus",          timing.BaseLead) -- rhythm affects base lead
        timing.AdaptiveHoldBase = optMs("PhantomAdaptiveHold",         timing.AdaptiveHoldBase)
    end

    --[[
        Phantom lead budget: ping-adaptive with per-style windup fractions.
        Combines Fusion's per-style logic with Adaptive's learning,
        plus ping-spike detection and low/high ping adjustments.
    ]]
    function R:_phantomLeadBudget(attackType, windup, rawLead, transportFloor, styleKey)
        local timing = self.PhantomTiming
        local m2 = attackType == "M2"
        local styleKeyLower = string.lower(tostring(styleKey or ""))
        local ping = math.clamp(tonumber(self.PingEMA) or 0, 0, 0.35)
        -- Per-style windup fraction
        local fraction = m2 and timing.M2WindupFraction or timing.M1WindupFraction
        if m2 and styleKeyLower == "boxing" then
            fraction = timing.BoxingM2WindupFraction
        elseif m2 and styleKeyLower == "wrestling" then
            fraction = timing.WrestlingM2WindupFraction
        end
        -- Ping-adaptive minimum lead
        local pingLead = math.clamp(ping * timing.PingLeadFactor,
            timing.PingLeadMin, timing.PingLeadMax)
        -- Ping-spike bonus (extra lead for unstable connections)
        local spikeBonus = self:_phantomPingSpikeBonus()
        -- Low-ping boost (aggressive lead for stable connections)
        local lowPingBoost = self:_phantomLowPingBoost()
        -- High-ping safety margin
        local highPingSafety = self:_phantomHighPingSafety()
        local minimum = math.max(
            m2 and timing.M2MinLead or timing.M1MinLead,
            pingLead + spikeBonus + lowPingBoost + highPingSafety,
            math.max(0, tonumber(transportFloor) or 0)
        )
        -- Caps scale slightly with ping for high-ping tolerance
        local pingScale = 1 + math.clamp(ping * 0.3, 0, 0.15)
        local minimumCap = (m2 and timing.M2MinEarlyCap or timing.M1MinEarlyCap) * pingScale
        local maximumCap = (m2 and timing.M2MaxEarlyCap or timing.M1MaxEarlyCap) * pingScale
        local cap = math.clamp(math.max(0, tonumber(windup) or 0) * fraction,
            minimumCap, maximumCap)
        minimum = math.min(minimum, cap)
        -- Jitter bonus + spike bonus + low-ping boost + high-ping safety
        local totalBonus = timing.JitterLeadBonus + spikeBonus
            + lowPingBoost + highPingSafety
        local rawLeadAdjusted = (tonumber(rawLead) or 0) + totalBonus
        return math.clamp(rawLeadAdjusted, minimum, cap), cap
    end

    --[[
        Phantom retry policy: retry count and interval scale with ping.
        Higher ping = more retries with longer intervals.
    ]]
    function R:_phantomRetryPolicy(attempt)
        local timing = self.PhantomTiming
        local attackType = attempt and attempt.profile and attempt.profile.attackType
        local m2 = attackType == "M2"
        local ping = math.clamp(tonumber(self.PingEMA) or 0, 0, 0.35)
        -- Base retry count scales with ping
        local baseCount = m2 and timing.M2RetryBase or timing.M1RetryBase
        local pingBoost = math.floor(ping * 10 * timing.PingRetryBoost)
        local cap = math.clamp(baseCount + pingBoost, 0, 10)
        local requested = tonumber(attempt and attempt.reactiveRetryLimit)
        -- Retry interval scales with ping
        local interval = math.clamp(
            timing.BaseRetryInterval + ping * timing.PingRetryScale,
            timing.MinRetryInterval, timing.MaxRetryInterval)
        local initialDelay = math.max(interval * 0.7, timing.MinRetryInterval)
        return math.clamp(math.floor(requested or cap), 0, cap), interval, initialDelay
    end

    --[[
        Phantom confirm tail: scales with ping for adaptive confirm window.
    ]]
    function R:_phantomConfirmTail()
        local timing = self.PhantomTiming
        local ping = math.clamp(tonumber(self.PingEMA) or 0, 0, 0.35)
        return math.clamp(
            timing.BaseConfirmTail + ping * timing.PingConfirmScale,
            timing.BaseConfirmTail, timing.MaxConfirmTail)
    end

    --[[
        Apex lead budget: maximum aggression variant of Phantom.
        Lower windup fractions, wider caps, stronger ping adaptation.
        Also applies server-time prediction offset for earlier leads.
    ]]
    function R:_apexLeadBudget(attackType, windup, rawLead, transportFloor, styleKey)
        local timing = self.ApexTiming
        local m2 = attackType == "M2"
        local styleKeyLower = string.lower(tostring(styleKey or ""))
        local ping = math.clamp(tonumber(self.PingEMA) or 0, 0, 0.35)
        -- Per-style windup fraction (more aggressive than Phantom)
        local fraction = m2 and timing.M2WindupFraction or timing.M1WindupFraction
        if m2 and styleKeyLower == "boxing" then
            fraction = timing.BoxingM2WindupFraction
        elseif m2 and styleKeyLower == "wrestling" then
            fraction = timing.WrestlingM2WindupFraction
        elseif m2 and styleKeyLower == "capoeira" then
            fraction = timing.CapoeiraM2WindupFraction
        elseif m2 and styleKeyLower == "kure" then
            fraction = timing.KureM2WindupFraction
        end
        -- Ping-adaptive minimum lead (stronger than Phantom)
        local pingLead = math.clamp(ping * timing.PingLeadFactor,
            timing.PingLeadMin, timing.PingLeadMax)
        -- Ping-spike bonus (reuses Phantom spike state)
        local spikeBonus = self:_phantomPingSpikeBonus()
        -- Low-ping boost (stronger than Phantom)
        local lowPingBoost = (ping < timing.LowPingThreshold) and timing.LowPingLeadBoost or 0
        -- High-ping safety margin (less conservative than Phantom)
        local highPingSafety = (ping > timing.HighPingThreshold) and timing.HighPingSafetyMargin or 0
        -- Server-time prediction offset (Apex-exclusive)
        local serverTimePredict = math.clamp(
            ping * timing.ServerTimePredictionFactor,
            0, timing.ServerTimePredictionMax)
        local minimum = math.max(
            m2 and timing.M2MinLead or timing.M1MinLead,
            pingLead + spikeBonus + lowPingBoost + highPingSafety,
            math.max(0, tonumber(transportFloor) or 0)
        )
        -- Wider caps than Phantom for more coverage
        local pingScale = 1 + math.clamp(ping * 0.35, 0, 0.20)
        local minimumCap = (m2 and timing.M2MinEarlyCap or timing.M1MinEarlyCap) * pingScale
        local maximumCap = (m2 and timing.M2MaxEarlyCap or timing.M1MaxEarlyCap) * pingScale
        local cap = math.clamp(math.max(0, tonumber(windup) or 0) * fraction,
            minimumCap, maximumCap)
        minimum = math.min(minimum, cap)
        -- Total bonus includes server-time prediction
        local totalBonus = timing.JitterLeadBonus + spikeBonus
            + lowPingBoost + highPingSafety + serverTimePredict
        local rawLeadAdjusted = (tonumber(rawLead) or 0) + totalBonus
        return math.clamp(rawLeadAdjusted, minimum, cap), cap
    end

    --[[
        Apex retry policy: maximum retries within server Block.Activated cap.
        8 retries × 0.033s interval = ~30/s (under 32/s server limit).
    ]]
    function R:_apexRetryPolicy(attempt)
        local timing = self.ApexTiming
        local attackType = attempt and attempt.profile and attempt.profile.attackType
        local m2 = attackType == "M2"
        local ping = math.clamp(tonumber(self.PingEMA) or 0, 0, 0.35)
        -- Base retry count (higher than Phantom)
        local baseCount = m2 and timing.M2RetryBase or timing.M1RetryBase
        local pingBoost = math.floor(ping * 10 * timing.PingRetryBoost)
        local cap = math.clamp(baseCount + pingBoost, 0, 10)
        local requested = tonumber(attempt and attempt.reactiveRetryLimit)
        -- Retry interval (server minimum is 0.033s for Block.Activated)
        local interval = math.clamp(
            timing.BaseRetryInterval + ping * timing.PingRetryScale,
            timing.MinRetryInterval, timing.MaxRetryInterval)
        local initialDelay = math.max(interval * 0.6, timing.MinRetryInterval)
        return math.clamp(math.floor(requested or cap), 0, cap), interval, initialDelay
    end

    --[[
        Apex confirm tail: extended confirm window for maximum perfect block chance.
    ]]
    function R:_apexConfirmTail()
        local timing = self.ApexTiming
        local ping = math.clamp(tonumber(self.PingEMA) or 0, 0, 0.35)
        return math.clamp(
            timing.BaseConfirmTail + ping * timing.PingConfirmScale,
            timing.BaseConfirmTail, timing.MaxConfirmTail)
    end

    --[[
        Multi-threat timing table picker: Phantom attempts use PhantomTiming,
        Apex uses ApexTiming. Shared by the should-hold / extend-duration
        helpers.
    ]]
    function R:_multiThreatTiming(attempt)
        local engine = attempt and attempt.engine
        return (engine == "Apex" and self.ApexTiming)
            or self.PhantomTiming
    end

    --[[
        Phantom ping-spike detection: tracks sudden ping jumps and adds
        extra lead bonus to compensate for unstable connections.
    ]]
    function R:_phantomPingSpikeBonus()
        local timing = self.PhantomTiming
        local state = self.PhantomPingSpike
        if not state then return 0 end
        local now = os.clock()
        local ping = math.clamp(tonumber(self.PingEMA) or 0, 0, 0.35)
        -- Initialize on first call
        if state.lastUpdate == 0 then
            state.lastPing = ping
            state.lastUpdate = now
            return 0
        end
        -- Detect ping spike: sudden increase above threshold
        local delta = ping - state.lastPing
        if delta > timing.PingSpikeThreshold then
            state.spikeLevel = math.min(1.0, (state.spikeLevel or 0) + 0.5)
        end
        -- Decay spike level over time
        local elapsed = now - state.lastUpdate
        if elapsed > 0 then
            state.spikeLevel = (state.spikeLevel or 0)
                * math.pow(timing.PingSpikeDecay, elapsed * 10)
        end
        state.lastPing = ping
        state.lastUpdate = now
        return (state.spikeLevel or 0) * timing.PingSpikeLeadBonus
    end

    --[[
        Phantom learning boost: amplifies lead adjustment from outcomes.
        Combines Adaptive's fast learning with Fusion's stability.
    ]]
    function R:_phantomLearningBoost(attackType, baseStep)
        local timing = self.PhantomTiming
        local ping = math.clamp(tonumber(self.PingEMA) or 0, 0, 0.35)
        -- Higher boost for low ping (faster convergence)
        -- Lower boost for high ping (more stability)
        local pingFactor = 1.0 - math.clamp(ping * 0.5, 0, 0.4)
        local boosted = (tonumber(baseStep) or 0) * timing.LearningBoostFactor * pingFactor
        return math.min(boosted, timing.LearningBoostMaxStep)
    end

    --[[
        Phantom dual-confirmation: tighter release window when both
        block and perfect attributes are confirmed.
    ]]
    function R:_phantomDualConfirmWindow()
        local timing = self.PhantomTiming
        local ping = math.clamp(tonumber(self.PingEMA) or 0, 0, 0.35)
        -- Slightly wider window for high ping to account for attribute delay
        local pingAdjust = math.clamp(ping * 0.10, 0, 0.020)
        return timing.DualConfirmWindow + pingAdjust
    end

    --[[
        Phantom low-ping lead boost: extra aggressive lead for stable connections.
        Returns bonus lead when ping is below LowPingThreshold.
    ]]
    function R:_phantomLowPingBoost()
        local timing = self.PhantomTiming
        local ping = math.clamp(tonumber(self.PingEMA) or 0, 0, 0.35)
        if ping < timing.LowPingThreshold then
            -- Scale boost inversely with ping (lower ping = more boost)
            local margin = timing.LowPingThreshold - ping
            return timing.LowPingLeadBoost * (margin / timing.LowPingThreshold)
        end
        return 0
    end

    --[[
        Phantom high-ping safety margin: extra lead for very high ping.
        Returns safety margin when ping exceeds HighPingThreshold.
    ]]
    function R:_phantomHighPingSafety()
        local timing = self.PhantomTiming
        local ping = math.clamp(tonumber(self.PingEMA) or 0, 0, 0.35)
        if ping > timing.HighPingThreshold then
            local excess = ping - timing.HighPingThreshold
            return math.min(excess * 0.15, timing.HighPingSafetyMargin)
        end
        return 0
    end

    --[[
        Phantom nearby threats: checks Pending queue for other threats
        arriving within MultiThreatWindow. Returns count and earliest impact time.
        Used to decide whether to extend block instead of releasing.
    ]]
    function R:_phantomNearbyThreats(currentAttempt, now)
        local timing = self:_multiThreatTiming(currentAttempt)
        now = now or os.clock()
        local count = 0
        local earliestImpact = math.huge
        local window = timing.MultiThreatWindow
        local maxCount = timing.NearbyThreatMaxCount
        for _, item in ipairs(self.Pending) do
            if item ~= currentAttempt
                and not item.cancelled
                and not item.resolved
                and item.attempt
                and not item.attempt.cancelled
                and not item.attempt.resolved then
                local impactAt = tonumber(item.attempt.predictedImpactAt)
                if impactAt and impactAt > now
                    and (impactAt - now) <= window then
                    count += 1
                    if impactAt < earliestImpact then
                        earliestImpact = impactAt
                    end
                    if count >= maxCount then break end
                end
            end
        end
        for _, attempt in ipairs(self.Attempts) do
            if attempt ~= currentAttempt
                and attempt.firedAt
                and not attempt.cancelled
                and not attempt.resolved then
                local impactAt = tonumber(attempt.predictedImpactAt)
                if impactAt and impactAt > now
                    and (impactAt - now) <= window then
                    count += 1
                    if impactAt < earliestImpact then
                        earliestImpact = impactAt
                    end
                    if count >= maxCount then break end
                end
            end
        end
        return count, earliestImpact
    end

    --[[
        Phantom should hold block: returns true if there are nearby threats
        that warrant extending the block instead of releasing.
    ]]
    function R:_phantomShouldHoldBlock(currentAttempt, now)
        local timing = self:_multiThreatTiming(currentAttempt)
        now = now or os.clock()
        local count, earliestImpact = self:_phantomNearbyThreats(currentAttempt, now)
        if count == 0 then return false end
        local nextDelta = earliestImpact - now
        if nextDelta <= timing.FeintRecoveryWindow then
            return true
        end
        if count >= 2 then
            return true
        end
        return false
    end

    --[[
        Phantom block extend duration: how long to extend block when
        holding for nearby threats.
    ]]
    function R:_phantomBlockExtendDuration(currentAttempt, now)
        local engine = currentAttempt and currentAttempt.engine
        local timing = self:_multiThreatTiming(currentAttempt)
        now = now or os.clock()
        local count, earliestImpact = self:_phantomNearbyThreats(currentAttempt, now)
        if count == 0 then return 0 end
        local confirmTail = (engine == "Apex" and self:_apexConfirmTail())
            or self:_phantomConfirmTail()
        local extend = (earliestImpact - now) + confirmTail
        return math.clamp(extend, timing.MinBlockHoldAfterParry, timing.MultiThreatBlockExtend)
    end

    function R:_fireIn(item, remaining)
        if item.fusionLead ~= nil then return remaining - item.fusionLead end
        return remaining
            - item.pingLead
            - item.activationLead
            - item.frameLead
            + item.userOffset
            - item.learnedLead
            - (tonumber(item.animationLeadCorrection) or 0)
    end

    function R:_intentSnapshot(item)
        local strike = math.max(1, math.floor(tonumber(item.strikeIndex) or 1))
        local attempt = item and item.attempt
        local liveIntent = self:_usesLiveM2Intent(item)
        if (not liveIntent and item.sourceClass ~= "animation")
            or strike > 1 or item.isWrestlingGrab then
            return nil
        end
        local snapshot
        if liveIntent then
            local character = LocalPlayer.Character
            local myRoot = character and character:FindFirstChild("HumanoidRootPart")
            local enemyRoot = item.model and (
                item.model:FindFirstChild("HumanoidRootPart") or item.model.PrimaryPart
            )
            snapshot = self:_reactiveThreatSnapshot(item, myRoot, enemyRoot)
        else
            snapshot = self:_diagnosticHitbox(item.model, item.profile)
        end
        if not snapshot then return nil end
        if Toggles.AutoDodge and Toggles.AutoDodge.Value
            and Toggles.CanDodgeRearAttacks and Toggles.CanDodgeRearAttacks.Value then
            local dodgeThreshold = math.cos(math.rad(
                tonumber(Options.DodgeAngle and Options.DodgeAngle.Value) or 60
            ))
            if snapshot.localFacingDot < dodgeThreshold then return nil end
        end
        return snapshot
    end

    function R:_shouldSkipBoxingFirst(item, snapshot)
        if (item and (item.reactivePulse or self:_usesLiveM2Intent(item)))
            or not item or item.boxingM2 ~= true
            or math.max(1, math.floor(tonumber(item.strikeIndex) or 1)) ~= 1
            or not snapshot or snapshot.inside == true then
            return false
        end
        return (tonumber(snapshot.attackerFacingDot) or -1) < self.IntentFacingThreshold
    end

    function R:_cancelItem(item)
        if item.attempt then item.attempt.cancelled = true end
    end

    function R:_localInteractionReason(character)
        if not character then return nil end
        for _, attribute in ipairs(self.ReactiveInteractionAttributes) do
            local value = character:GetAttribute(attribute)
            if value == true
                or (type(value) == "string" and value ~= "")
                or (type(value) == "number" and value ~= 0) then
                return attribute
            end
        end
        local states = character:FindFirstChild("States")
        if not states then return nil end
        for _, name in ipairs(self.ReactiveInteractionStates) do
            local state = states:FindFirstChild(name)
            if state and (
                (state:IsA("ObjectValue") and state.Value ~= nil)
                    or (state:IsA("BoolValue") and state.Value == true)
            ) then
                return name
            end
        end
        return nil
    end

    function R:_localReady()
        local character = LocalPlayer.Character
        if not character or character:GetAttribute("Equip") ~= true then return false end
        if (self:Engine() == "Fusion" or self:Engine() == "Phantom" or self:Engine() == "Apex")
            and self:_localInteractionReason(character) then
            return false
        end
        if character:GetAttribute("Ragdoll") == true
            or character:GetAttribute("Downed") == true
            or character:GetAttribute("Greenzone") == true
            or character:GetAttribute("RpCombatLocked") == true then return false end
        local buffered = character:GetAttribute("ParryBuffered") == true
        if not buffered and (character:GetAttribute("CantAnything") == true) then return false end
        -- NOTE: Stunned is no longer a blocker for parrying, since we want to machine-gun parry during stunlocks
        
        return true
    end

    function R:_fusionCooldownResumeLead(attempt)
        local profile = attempt and attempt.profile
        if not attempt
            or (attempt.engine ~= "Fusion" and attempt.engine ~= "Phantom" and attempt.engine ~= "Apex")
            or attempt.strategy ~= "TrackM1"
            or not profile or profile.attackType ~= "M1" then
            return nil
        end
        local pingLead = math.clamp(
            self.PingEMA * (self.Policy[attempt.engine] or self.Policy.Fusion).pingFactor,
            0,
            0.10
        )
        local activationLead = math.clamp(self.Block.activationEMA, 0, 0.08)
        local frameLead = math.clamp(self.FrameEMA * 0.5, 0, 0.025)
        local minLead = (attempt.engine == "Phantom" and self.PhantomTiming.M1MinLead)
            or (attempt.engine == "Apex" and self.ApexTiming.M1MinLead)
            or self.FusionTiming.M1MinLead
        return math.max(
            minLead,
            pingLead + activationLead + frameLead
        )
    end

    function R:_fusionCooldownGate(item, now)
        local attempt = item and item.attempt
        local resumeLead = self:_fusionCooldownResumeLead(attempt)
        if not resumeLead then return "open" end

        local character = LocalPlayer.Character
        if not character or character:GetAttribute("BlockCooldown") ~= true then
            local startedAt = attempt.cooldownWaitStartedAt
            if startedAt then
                local predictedImpactAt = tonumber(
                    attempt.predictedImpactAt or item.predictedImpactAt
                )
                self:_diagnosticRecord("cooldown-resumed", item, {
                    waitedMs = math.max(0, now - startedAt) * 1000,
                    remainingToImpactMs = predictedImpactAt
                        and (predictedImpactAt - now) * 1000 or nil,
                    safeLeadMs = resumeLead * 1000,
                })
                attempt.cooldownWaitStartedAt = nil
                attempt.cooldownWaitUntil = nil
            end
            return "open"
        end

        local predictedImpactAt = tonumber(
            attempt.predictedImpactAt or item.predictedImpactAt
        )
        if not predictedImpactAt then return "expired" end

        local latestSafeAt = predictedImpactAt - resumeLead
        local remainingToSafeMs = (latestSafeAt - now) * 1000
        if remainingToSafeMs <= 0 then
            self:_diagnosticRecord("cooldown-unavailable", item, {
                remainingToImpactMs = (predictedImpactAt - now) * 1000,
                safeLeadMs = resumeLead * 1000,
                waitMs = attempt.cooldownWaitStartedAt
                    and (now - attempt.cooldownWaitStartedAt) * 1000 or 0,
            })
            return "expired"
        end

        if not attempt.cooldownWaitStartedAt then
            attempt.cooldownWaitStartedAt = now
            attempt.cooldownWaitUntil = latestSafeAt
            self:_diagnosticRecord("cooldown-wait", item, {
                remainingToImpactMs = (predictedImpactAt - now) * 1000,
                remainingToSafeMs = remainingToSafeMs,
                safeLeadMs = resumeLead * 1000,
            })
        end
        return "wait"
    end

    function R:_projectedThreatSnapshot(item, myRoot, enemyRoot, profile)
        local now = os.clock()
        local horizon = math.clamp(
            (tonumber(item.predictedImpactAt) or now) - now,
            0,
            self.ProjectionMaxSeconds
        )
        if horizon <= 0.005 then return nil end

        local relative3 = enemyRoot.Position - myRoot.Position
        local velocity3 = enemyRoot.AssemblyLinearVelocity - myRoot.AssemblyLinearVelocity
        local relative = Vector3.new(relative3.X, 0, relative3.Z)
        local velocity = Vector3.new(velocity3.X, 0, velocity3.Z)
        local velocitySquared = velocity:Dot(velocity)
        if relative.Magnitude <= 0.001 or velocitySquared <= 0.01 then return nil end

        local contactIn = math.clamp(-relative:Dot(velocity) / velocitySquared, 0, horizon)
        if contactIn <= 0.005 then return nil end

        local futureLocal = myRoot.Position + myRoot.AssemblyLinearVelocity * contactIn
        local futureEnemy = enemyRoot.Position + enemyRoot.AssemblyLinearVelocity * contactIn
        local futureEnemyCFrame = CFrame.new(futureEnemy) * enemyRoot.CFrame.Rotation
        local half = Vector3.new(profile.hitboxX, profile.hitboxY, profile.hitboxZ) * 0.5
        local box = futureEnemyCFrame * CFrame.new(0, 0, -(profile.hso + half.Z))
        local point = box:PointToObjectSpace(futureLocal)
        local radialVelocity = velocity:Dot(relative.Unit)
        local lateralSpeed = (velocity - relative.Unit * radialVelocity).Magnitude
        return (futureEnemy - futureLocal).Magnitude,
            contactIn,
            math.abs(point.X) <= half.X
                and math.abs(point.Y) <= half.Y
                and math.abs(point.Z) <= half.Z,
            lateralSpeed
    end

    function R:_shouldUseFusionMotionM1(evidence)
        return type(evidence) == "table"
            and evidence.offensiveConfirmed == true
            and evidence.animationConfirmed == true
            and evidence.projectedInsideHitbox == true
            and tonumber(evidence.closingSpeed) and evidence.closingSpeed >= 0.75
            and tonumber(evidence.attackerFacingDot)
                and evidence.attackerFacingDot >= self.ReactiveDecision.CloseFacingThreshold
            and tonumber(evidence.motionPredictedImpactAt)
            and tonumber(evidence.baselinePredictedImpactAt)
            and evidence.motionPredictedImpactAt + 0.008 < evidence.baselinePredictedImpactAt
            and evidence.motionPredictedImpactAt >= (tonumber(evidence.configuredImpactAt) or 0)
    end

    function R:_fusionMotionM1Timing(threat, profile, baselineImpactAt, now)
        now = tonumber(now) or os.clock()
        local evidence = {
            baselinePredictedImpactAt = baselineImpactAt,
            motionSelected = false,
            motionConfidence = "none",
            motionSelectionReason = "motion-unavailable",
        }
        if not threat or not profile or profile.attackType ~= "M1" then
            evidence.motionSelectionReason = "not-m1"
            return evidence
        end
        local track = threat.track
        local model = threat.model
        local character = LocalPlayer.Character
        local myRoot = character and character:FindFirstChild("HumanoidRootPart")
        local enemyRoot = model and (model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart)
        if not (track and model and myRoot and enemyRoot) then
            evidence.motionSelectionReason = "missing-track-or-root"
            return evidence
        end

        local trackSpeed, trackPlaying
        pcall(function()
            trackSpeed = math.abs(tonumber(track.Speed) or 0)
            trackPlaying = track.IsPlaying == true
        end)
        evidence.animationConfirmed = trackPlaying == true
            and (tonumber(trackSpeed) or 0) > 0.01
            and tonumber(profile.impactPosition) ~= nil
        evidence.offensiveConfirmed = model:GetAttribute("M1") == true
            or model:GetAttribute("PendingM1") == true
            or model:GetAttribute("CombatAttacking") == true
        local styleKey, styleSource = ResolveCombatStyle(model)
        styleKey = string.lower(tostring(profile.styleKey or styleKey))
        local comboIndex = math.clamp(math.floor(tonumber(
            profile.comboIndex or threat.comboIndex or self:_actualComboIndex(model) or 1
        ) or 1), 1, 4)
        local attackSpeed = math.max(0.05, tonumber(profile.attackSpeed) or attackSpeedFor(model))
        local configuredDelay = self:_reactiveRawHitDelay(
            model,
            "M1",
            comboIndex,
            styleKey,
            attackSpeed
        )
        evidence.styleKey = styleKey
        evidence.styleSource = profile.combatStyleSource or styleSource
        evidence.comboIndex = comboIndex
        evidence.attackSpeed = attackSpeed
        evidence.configuredImpactAt = (tonumber(threat.startedAt) or now) + configuredDelay
        if not evidence.offensiveConfirmed then
            evidence.motionSelectionReason = "offensive-evidence-missing"
            return evidence
        end
        if not evidence.animationConfirmed then
            evidence.motionSelectionReason = "animation-evidence-missing"
            return evidence
        end

        local horizon = math.clamp((tonumber(baselineImpactAt) or now) - now, 0, 0.45)
        local relative3 = enemyRoot.Position - myRoot.Position
        local relative = Vector3.new(relative3.X, 0, relative3.Z)
        local velocity3 = enemyRoot.AssemblyLinearVelocity - myRoot.AssemblyLinearVelocity
        local velocity = Vector3.new(velocity3.X, 0, velocity3.Z)
        local velocitySquared = velocity:Dot(velocity)
        if horizon <= 0.005 or relative.Magnitude <= 0.001 or velocitySquared <= 0.01 then
            evidence.motionSelectionReason = "no-projectable-motion"
            return evidence
        end
        local direction = relative.Unit
        local contactIn = math.clamp(-relative:Dot(velocity) / velocitySquared, 0, horizon)
        evidence.motionProjectedContactIn = contactIn
        evidence.motionPredictedImpactAt = now + contactIn
        evidence.closingSpeed = -velocity:Dot(direction)
        local enemyLook = Vector3.new(
            enemyRoot.CFrame.LookVector.X,
            0,
            enemyRoot.CFrame.LookVector.Z
        )
        evidence.attackerFacingDot = enemyLook.Magnitude > 0.001
            and enemyLook.Unit:Dot(-direction) or 1
        if contactIn <= 0.005 then
            evidence.motionSelectionReason = "no-future-contact"
            return evidence
        end

        local futureLocal = myRoot.Position + myRoot.AssemblyLinearVelocity * contactIn
        local futureEnemy = enemyRoot.Position + enemyRoot.AssemblyLinearVelocity * contactIn
        local futureEnemyCFrame = CFrame.new(futureEnemy) * enemyRoot.CFrame.Rotation
        local half = Vector3.new(profile.hitboxX, profile.hitboxY, profile.hitboxZ) * 0.5
        local box = futureEnemyCFrame * CFrame.new(0, 0, -(profile.hso + half.Z))
        local point = box:PointToObjectSpace(futureLocal)
        evidence.motionProjectedInsideHitbox = math.abs(point.X) <= half.X
            and math.abs(point.Y) <= half.Y
            and math.abs(point.Z) <= half.Z
        evidence.projectedInsideHitbox = evidence.motionProjectedInsideHitbox
        if not evidence.projectedInsideHitbox then
            evidence.motionSelectionReason = "projected-contact-outside-hitbox"
            evidence.motionConfidence = "low"
            return evidence
        end
        if evidence.motionPredictedImpactAt < evidence.configuredImpactAt then
            evidence.motionSelectionReason = "contact-before-configured-impact"
            evidence.motionConfidence = "medium"
            return evidence
        end
        if evidence.motionPredictedImpactAt + 0.008 >= baselineImpactAt then
            evidence.motionSelectionReason = "motion-not-earlier"
            evidence.motionConfidence = "medium"
            return evidence
        end
        evidence.motionSelected = self:_shouldUseFusionMotionM1(evidence)
        evidence.motionConfidence = evidence.motionSelected and "high" or "medium"
        evidence.motionSelectionReason = evidence.motionSelected
            and "motion-contact-confirmed" or "motion-safety-clamp"
        return evidence
    end

    function R:_validate(item, forEmergencyDodge)
        if Library._ShouldStopAutomationForTyping() then return false, "typing" end
        if not self:IsAutoEnabled() or not self:_localReady() then return false, "local-state" end
        local model = item.model
        if not model or not model.Parent or model == LocalPlayer.Character then return false, "attacker-gone" end
        if isExcludedAttacker(model) then return false, "excluded" end
        local humanoid = model:FindFirstChildOfClass("Humanoid")
        if humanoid and humanoid.Health <= 0 then return false, "attacker-dead" end
        local myCharacter = LocalPlayer.Character
        local myRoot = myCharacter and myCharacter:FindFirstChild("HumanoidRootPart")
        local enemyRoot = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
        if not (myRoot and enemyRoot) then return false, "root-missing" end
        local profile = item.profile
        local delta = enemyRoot.Position - myRoot.Position
        local distance = delta.Magnitude
        -- Face Target: remember who is attacking so the Heartbeat loop can
        -- snap-turn to face them. This mirrors the Premium implementation
        -- which records _lastAttacker / _lastAttackTime here and lets the
        -- per-frame controller do the actual rotation.
        if Toggles.FaceTarget and Toggles.FaceTarget.Value == true then
            State._lastAttacker = model
            State._lastAttackTime = os.clock()
        end
        local front = distance > 0.01 and myRoot.CFrame.LookVector:Dot(delta.Unit) or 1
        local evasiveRequested, evasiveMandatory, evasiveReason, evasiveSource,
            rearAttack, attackerM2Cooldown, evasiveEmergencyEligible = self:_evasivePolicy(item, front)
        local dodgeRequested = evasiveRequested
            or (forEmergencyDodge == true and evasiveEmergencyEligible == true)
        item.evasiveRequested = evasiveRequested
        item.evasiveMandatory = evasiveMandatory
        item.evasiveEmergencyEligible = evasiveEmergencyEligible
        item.evasivePolicy = tostring(Options.EvasiveMode and Options.EvasiveMode.Value or "None")
        item.evasiveReason = evasiveReason
        item.evasiveSource = evasiveSource
        item.rearAttack = rearAttack
        item.attackerM2Cooldown = attackerM2Cooldown
        local allowedRange = dodgeRequested
            and math.max(0, tonumber(Options.MaxRangeDodge and Options.MaxRangeDodge.Value) or 20)
            or profile.maxRange
        if not dodgeRequested and myCharacter:GetAttribute("BlockCooldown") == true then
            return false, "block-cooldown"
        end
        local size = Vector3.new(profile.hitboxX, profile.hitboxY, profile.hitboxZ)
        local box = enemyRoot.CFrame * CFrame.new(0, 0, -(profile.hso + profile.hitboxZ * 0.5))
        local point = box:PointToObjectSpace(myRoot.Position)
        local half = size * 0.5
        local inside = math.abs(point.X) <= half.X
            and math.abs(point.Y) <= half.Y
            and math.abs(point.Z) <= half.Z
        local projectedDistance, projectedContactIn, projectedInside, projectedLateralSpeed =
            self:_projectedThreatSnapshot(item, myRoot, enemyRoot, profile)
        item.projectedDistanceStuds = projectedDistance
        item.projectedContactIn = projectedContactIn
        item.projectedInsideHitbox = projectedInside
        item.projectedLateralSpeed = projectedLateralSpeed
        local effectiveDistance = math.min(distance, projectedDistance or math.huge)
        if effectiveDistance > allowedRange then
            return false, "range"
        end
        if item.reactivePulse or self:_usesLiveM2Intent(item) then
            local snapshot = self:_reactiveThreatSnapshot(item, myRoot, enemyRoot)
            if not snapshot or snapshot.inside ~= true then
                return false, snapshot and snapshot.reason or "reactive-no-threat"
            end
            item.reactiveReason = snapshot.reason
            item.projectedDistanceStuds = snapshot.projectedDistanceStuds
            item.projectedContactIn = snapshot.projectedContactIn
            item.projectedLateralSpeed = snapshot.projectedLateralSpeed
            item.reactiveReachStuds = snapshot.reachStuds
            item.reactiveAttackerFacingDot = snapshot.attackerFacingDot
            if item.attempt then
                item.attempt.reactiveReason = snapshot.reason
                item.attempt.reactiveReachStuds = snapshot.reachStuds
                item.attempt.reactiveAttackerFacingDot = snapshot.attackerFacingDot
            end
            self.LastQualifiedThreat = {
                model = model,
                profile = profile,
                at = os.clock(),
            }
            return true, nil, myRoot, enemyRoot
        end
        inside = inside or projectedInside == true
        local itemEngine = item.attempt and item.attempt.engine or self:Engine()
        local policy = self.Policy[itemEngine] or self.Policy.Adaptive
        if not inside and not item.isWrestlingGrab then
            -- ENFORCED STRICT HITBOX (No whiffing!)
            -- If we are not inside the 3D hitbox, we strictly check distance regardless of policy.
            if effectiveDistance > math.max(4, profile.maxRange * 0.90) then
                return false, "hitbox"
            end
        end
        self.LastQualifiedThreat = {
            model = model,
            profile = profile,
            at = os.clock(),
        }
        return true, nil, myRoot, enemyRoot
    end

    function R:_tryReservedEmergencyDodge(item, attempt, reason)
        if not item or not attempt or attempt.cancelled or attempt.resolved
            or attempt.emergencyDodgeEligible ~= true
            or attempt.emergencyDodgeAttempted == true
            or attempt.emergencyHitchancePassed ~= true then
            return false
        end
        attempt.emergencyDodgeAttempted = true
        local valid, validationReason = self:_validate(item, true)
        if not valid or (item.evasiveEmergencyEligible ~= true
            and item.evasiveRequested ~= true) then
            self:_diagnosticRecord("dodge-unavailable", item, {
                reason = reason,
                emergencyDodge = true,
                emergencyValidationReason = validationReason
                    or "emergency-no-longer-eligible",
                evasivePolicy = item.evasivePolicy,
                evasiveReason = item.evasiveReason,
                evasiveSource = item.evasiveSource,
            })
            return false
        end
        if self.Block.active and self.Block.attempt == attempt then
            self:_releaseBlock("reserved-emergency-dodge")
        end
        local direction = self:_evasiveDirection()
        local success, method, resolution = doDodge(item.model, direction)
        self:_diagnosticRecord(success and "cancelled" or "dodge-unavailable", item, {
            reason = reason,
            direction = direction,
            dodgeMethod = method,
            dodgeResolution = resolution,
            emergencyDodge = true,
            evasivePolicy = item.evasivePolicy,
            evasiveReason = item.evasiveReason,
            evasiveSource = item.evasiveSource,
        })
        if not success then return false end
        self.LastPipeline = "dodged-" .. tostring(reason)
        self.LastGate = self.LastPipeline
        self.StatusDirty = true
        self:_cancelItem(item)
        return true
    end

    function R:_respond(item)
        local valid, reason = self:_validate(item)
        if not valid then
            self.LastPipeline = tostring(reason or "validation")
            self.LastGate = self.LastPipeline
            self.StatusDirty = true
            self:_diagnosticRecord("rejected", item, { reason = self.LastPipeline })
            self:_cancelItem(item)
            return
        end

        -- Apply Phantom tuning from UI before processing
        if item.attempt and item.attempt.engine == "Phantom" then
            self:_phantomApplyTuning()
        end

        local attempt = item.attempt
        local evasiveRequested = item.evasiveRequested == true
        local evasiveEmergencyEligible = item.evasiveEmergencyEligible == true
        local responsePriority = tostring(
            Options.ResponsePriority and Options.ResponsePriority.Value or "Block First"
        )
        local localStyle, localStyleSource = ResolveCombatStyle(LocalPlayer.Character)
        local aliReady, aliExpiresAt, aliSource = self:_aliCounterState()
        local aliPolicy = ((responsePriority == "Ali Style" or responsePriority == "Ali/Wingchun Style") and (localStyle == "ali" or localStyle == "wingchun"))
        item.localCombatStyle = localStyle
        item.localCombatStyleSource = localStyleSource
        item.aliCounterReady = aliReady
        item.aliCounterSource = aliSource
        item.aliCounterExpiresInMs = math.max(0, aliExpiresAt - os.clock()) * 1000

        local function attemptEvasive(reason)
            local direction = self:_evasiveDirection()
            local success, method, resolution = doDodge(item.model, direction)
            local now = os.clock()
            local extra = {
                reason = reason,
                direction = direction,
                dodgeMethod = method,
                dodgeResolution = resolution,
                responsePriority = responsePriority,
                evasivePolicy = item.evasivePolicy,
                evasiveReason = item.evasiveReason,
                evasiveSource = item.evasiveSource,
                evasiveMandatory = item.evasiveMandatory,
                aliCounterReady = item.aliCounterReady,
                aliCounterSource = item.aliCounterSource,
                aliCounterExpiresInMs = item.aliCounterExpiresInMs,
            }
            if not success then
                self:_diagnosticRecord("dodge-unavailable", item, extra)
                return false
            end
            if aliPolicy then
                local ready, expiresAt, source = self:_startAliCounterProvisional(now)
                item.aliCounterReady = ready
                item.aliCounterSource = source
                item.aliCounterExpiresInMs = math.max(0, expiresAt - now) * 1000
                extra.aliCounterReady = ready
                extra.aliCounterSource = source
                extra.aliCounterExpiresInMs = item.aliCounterExpiresInMs
            end
            self.LastPipeline = "dodged-" .. tostring(reason)
            self.LastGate = self.LastPipeline
            self.StatusDirty = true
            self:_diagnosticRecord("cancelled", item, extra)
            self:_cancelItem(item)
            return true
        end

        if evasiveRequested and item.evasiveMandatory then
            if attemptEvasive("m2-priority") then return end
        end

        if item.isWrestlingGrab and not evasiveRequested
            and not (attempt and (attempt.engine == "Fusion" or attempt.engine == "Phantom" or attempt.engine == "Apex")) then
            self:_cancelItem(item)
            return
        end

        if Toggles.ParryHitchanceEnabled and Toggles.ParryHitchanceEnabled.Value then
            local chance = math.clamp(
                tonumber(Options.ParryHitchance and Options.ParryHitchance.Value) or 100,
                0,
                100
            )
            local roll = math.random() * 100
            if not self:PassesHitchance(chance, roll) then
                self.LastPipeline = "hitchance-skipped"
                self.LastGate = self.LastPipeline
                self.StatusDirty = true
                self:_diagnosticRecord("cancelled", item, {
                    reason = self.LastPipeline,
                    hitchance = chance,
                    hitchanceRoll = roll,
                    evasivePolicy = item.evasivePolicy,
                    evasiveReason = item.evasiveReason,
                    evasiveSource = item.evasiveSource,
                })
                self:_cancelItem(item)
                if Toggles.Notifications and Toggles.Notifications.Value then
                    pcall(function()
                        Library:Notify({
                            Title = "Parry Hitchance",
                            Description = string.format(
                                "Skipped %s | Chance %.0f%% (roll %.1f)",
                                tostring(item.profile.name or item.attackType or "attack"),
                                chance,
                                roll
                            ),
                            Time = 2,
                        })
                    end)
                end
                return
            end
        end

        
        -- NATIVE AUTO COUNTER INTEGRATION
        local wcToggle = Toggles.AutoWingChun
        if wcToggle and wcToggle.Value then
            local pKind = item.profile and item.profile.kind
            local isM1 = (item.attackType == "m1" or item.attackType == "M1" or pKind == "M1")
            local isM2 = (item.attackType == "m2" or item.attackType == "M2" or item.attackType == "heavy" or pKind == "M2" or pKind == "M2M")
            
            local counterM1 = Toggles.AutoCounterEnemyM1 and Toggles.AutoCounterEnemyM1.Value
            local counterM2 = Toggles.AutoCounterEnemyM2 and Toggles.AutoCounterEnemyM2.Value
            
            if (isM1 and counterM1) or (isM2 and counterM2) then
                local myChar = LocalPlayer.Character
                local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
                local enemyChar = item.model
                local enemyRoot = enemyChar and (enemyChar:FindFirstChild("HumanoidRootPart") or enemyChar.PrimaryPart)
                
                local validForCounter = false
                if myRoot and enemyRoot then
                    local maxRange = isM2 and 10 or 8
                    local dist = (myRoot.Position - enemyRoot.Position).Magnitude
                    
                    local theirLook = enemyRoot.CFrame.LookVector
                    local dirToUs = (myRoot.Position - enemyRoot.Position).Unit
                    local dot = theirLook:Dot(dirToUs)
                    
                    -- Only counter if they are close enough AND facing towards us
                    if dist <= maxRange and dot > 0.0 then
                        validForCounter = true
                    end
                end
                
                if validForCounter then
                    local chance = tonumber(Options.AutoCounterHitchance and Options.AutoCounterHitchance.Value) or 100
                    if math.random() * 100 <= chance then
                        local selStyle = Options.AutoCounterStyle and Options.AutoCounterStyle.Value or "WingChun"
                        if selStyle == "Ali" then
                            if attemptEvasive("ali-auto-counter") then return end
                        else
                            if myChar and myChar:GetAttribute("M2Cooldown") ~= true then
                                local remotes = game:GetService("ReplicatedStorage"):FindFirstChild("Remotes")
                                local serverRemote = remotes and remotes:FindFirstChild("Server")
                                task.spawn(function()
                                    local delayMs = Options.AutoCounterDelay and Options.AutoCounterDelay.Value or 20
                                    if delayMs > 0 then
                                        task.wait(delayMs / 1000)
                                    end
                                    pcall(function()
                                        local vim = game:GetService("VirtualInputManager")
                                        vim:SendKeyEvent(true, Enum.KeyCode.R, false, game)
                                        task.delay(0.05, function() vim:SendKeyEvent(false, Enum.KeyCode.R, false, game) end)
                                    end)
                                    if serverRemote then
                                        pcall(function()
                                            serverRemote:FireServer({ Type = "Combat", Action = "M2", Func = "ServerCheck" })
                                        end)
                                    end
                                end)
                                self.LastPipeline = "wingchun-counter"
                                self.LastGate = self.LastPipeline
                                self.StatusDirty = true
                                self:_diagnosticRecord("cancelled", item, { reason = "wingchun-counter" })
                                self:_cancelItem(item)
                                return
                            end end end end end
        end

        if evasiveRequested and responsePriority == "Evasive First" then
            if attemptEvasive("evasive-first") then return end
        elseif evasiveRequested and aliPolicy and aliReady then
            if attemptEvasive("ali-style-ready") then return end
        end

        if attempt and evasiveEmergencyEligible then
            attempt.emergencyDodgeEligible = true
            attempt.emergencyDodgeItem = item
            attempt.emergencyHitchancePassed = true
        end
        if not self:RequestBlock(item.blockHold or item.profile.hold, attempt) then
            if evasiveEmergencyEligible
                and self:_tryReservedEmergencyDodge(item, attempt, "block-transport-failed") then
                return
            end
            if evasiveRequested and attemptEvasive("block-transport-failed") then return end
            self.LastPipeline = "transport-failed"
            self.LastGate = self.LastPipeline
            self.StatusDirty = true
            self:_diagnosticRecord("rejected", item, {
                reason = self.LastPipeline,
                evasivePolicy = item.evasivePolicy,
                evasiveReason = item.evasiveReason,
                evasiveSource = item.evasiveSource,
                aliCounterReady = item.aliCounterReady,
                aliCounterSource = item.aliCounterSource,
                aliCounterExpiresInMs = item.aliCounterExpiresInMs,
            })
            self:_cancelItem(item)
            return
        end

        local now = os.clock()
        attempt.firedAt = now
        attempt.predictedImpactAt = item.predictedImpactAt
        self.FiredThreats += 1
        self.LastPipeline = "fired-" .. tostring(attempt.method or "unknown")
        self.LastGate = self.LastPipeline
        self.StatusDirty = true
        self:_diagnosticRecord("fired", item, {
            method = attempt.method,
            responsePriority = responsePriority,
            evasivePolicy = item.evasivePolicy,
            evasiveReason = item.evasiveReason,
            evasiveSource = item.evasiveSource,
            evasiveMandatory = item.evasiveMandatory,
            evasiveEmergencyEligible = item.evasiveEmergencyEligible,
            aliCounterReady = item.aliCounterReady,
            aliCounterSource = item.aliCounterSource,
            aliCounterExpiresInMs = item.aliCounterExpiresInMs,
        })
        if Toggles.Notifications and Toggles.Notifications.Value then
            pcall(function()
                Library:Notify({
                    Title = self:Engine() .. " Auto Parry",
                    Description = string.format("%s | %s", item.profile.name, item.profile.source),
                    Time = 1.5,
                })
            end)
        end
    end

    function R:_schedule(threat, profile, token)
        local now = os.clock()
        local engine = self:Engine()
        local strategy = threat.strategy or self:_strategyFor(threat, profile)
        local policy = self.Policy[engine] or self.Policy.Adaptive
        local ping = math.clamp(self.PingEMA * policy.pingFactor, 0, 0.12)
        local transportProbe = { engine = engine, strategy = strategy }
        local method = self:_preferredMethod(transportProbe)
        local activation = math.clamp(self.Block.activationEMA, 0, 0.08)
        if method == "VIM" then activation += math.min(self.FrameEMA, 0.033) end
        local frameLead = math.clamp(self.FrameEMA * 0.5, 0, 0.025)
        local userOffset = (tonumber(Options.TimingOffset and Options.TimingOffset.Value) or -85) / 1000
        if IsGakuran() and threat.attackType == "M1" then
            local sweetSpotDelay = tonumber(Options.GakuranSweetSpot and Options.GakuranSweetSpot.Value) or 0
            userOffset = userOffset + sweetSpotDelay
        end
        local baseImpactAt
        if threat.track then
            local ok, position, speed = pcall(function()
                return tonumber(threat.track.TimePosition) or 0, math.abs(tonumber(threat.track.Speed) or 0)
            end)
            if ok and speed > 0 then
                baseImpactAt = now + math.max(0, (profile.impactPosition - position) / speed)
            else
                baseImpactAt = now + profile.impactPosition
            end
        else
            baseImpactAt = tonumber(profile.impactAt)
                or now + math.max(0, tonumber(profile.impactPosition) or 0)
        end
        local fusionMotion = (engine == "Fusion" or engine == "Phantom" or engine == "Apex")
            and profile.attackType == "M1"
            and self:_fusionMotionM1Timing(threat, profile, baseImpactAt, now) or nil

        local boxingM2 = profile.attackType == "M2"
            and string.lower(tostring(profile.styleKey or "")) == "boxing"
        local fusionToken = (engine == "Fusion" or engine == "Phantom" or engine == "Apex")
            and profile.attackType == "M2"
            and threat.sourceClass == "token"
        local pulseToken = fusionToken
        local strikeCount = (pulseToken or engine == "Fusion") and boxingM2
            and 2 or (profile.multiHitCount or 1)
        local multiHitGap = (pulseToken or engine == "Fusion") and boxingM2
            and (self.ReactiveTiming.BoxingSecondHit - self.ReactiveTiming.BoxingFirstHit)
            or (tonumber(profile.multiHitGap) or 0.42)
        for strike = 1, strikeCount do
            local reactivePulse = pulseToken
                and self:_reactivePulseTiming(threat, profile, strike) or nil
            local useTrack = not reactivePulse and strike == 1 and threat.track or nil
            local learned = self:GetLearnedLead(
                engine,
                threat.id,
                profile.styleKey,
                strike,
                profile.attackType
            )
            local animationLeadCorrection = tonumber(profile.animationLeadCorrection) or 0
            local blockHold = tonumber(profile.hold) or 0.394
            if reactivePulse then
                learned = 0
                animationLeadCorrection = 0
                blockHold = reactivePulse.hold
            elseif strike == 1 and boxingM2 then
                animationLeadCorrection += self.BoxingM2FirstStrikeLeadCorrection
                blockHold = math.min(blockHold, self.BoxingM2FirstStrikeHoldSeconds)
            elseif strike == 2 and boxingM2 then
                animationLeadCorrection += self.BoxingM2SecondStrikeLeadCorrection
                if engine == "Fusion" then
                    blockHold = math.min(blockHold, self.ReactiveTiming.BoxingSecondHold)
                end
            end
            local impactAt
            if reactivePulse then
                impactAt = reactivePulse.blockAt
            elseif strike == 1 then
                impactAt = profile.impactAt
            else
                impactAt = baseImpactAt + (strike - 1) * multiHitGap
            end
            local predictedImpactAt = reactivePulse and reactivePulse.hitAt
                or (strike == 1 and baseImpactAt or impactAt)
            local motionSelected = fusionMotion and strike == 1
                and fusionMotion.motionSelected == true
            if motionSelected then
                predictedImpactAt = fusionMotion.motionPredictedImpactAt
                impactAt = predictedImpactAt
                useTrack = nil
            end
            local absoluteImpactAt = impactAt
            if useTrack then absoluteImpactAt = nil end
            local fusionRawLead, fusionLead, fusionLeadCap
            if engine == "Fusion" then
                if reactivePulse then
                    fusionRawLead = reactivePulse.fusionRawLead
                    fusionLead = reactivePulse.fusionLead
                    fusionLeadCap = reactivePulse.fusionLeadCap
                else
                    fusionRawLead = ping + activation + frameLead + learned
                        + animationLeadCorrection - userOffset
                    fusionLead, fusionLeadCap = self:_fusionLeadBudget(
                        profile.attackType,
                        math.max(0, predictedImpactAt - now),
                        fusionRawLead,
                        ping + activation + frameLead
                    )
                end
            elseif engine == "Phantom" then
                if reactivePulse then
                    fusionRawLead = reactivePulse.fusionRawLead
                    fusionLead = reactivePulse.fusionLead
                    fusionLeadCap = reactivePulse.fusionLeadCap
                else
                    local phantomPing = math.clamp(tonumber(self.PingEMA) or 0, 0, 0.35)
                    local phantomPingLead = math.clamp(
                        phantomPing * self.PhantomTiming.PingLeadFactor,
                        self.PhantomTiming.PingLeadMin,
                        self.PhantomTiming.PingLeadMax)
                    fusionRawLead = phantomPingLead + activation + frameLead + learned
                        + animationLeadCorrection - userOffset
                    fusionLead, fusionLeadCap = self:_phantomLeadBudget(
                        profile.attackType,
                        math.max(0, predictedImpactAt - now),
                        fusionRawLead,
                        phantomPingLead + activation + frameLead,
                        profile.styleKey
                    )
                end
            elseif engine == "Apex" then
                if reactivePulse then
                    fusionRawLead = reactivePulse.fusionRawLead
                    fusionLead = reactivePulse.fusionLead
                    fusionLeadCap = reactivePulse.fusionLeadCap
                else
                    local apexPing = math.clamp(tonumber(self.PingEMA) or 0, 0, 0.35)
                    local apexPingLead = math.clamp(
                        apexPing * self.ApexTiming.PingLeadFactor,
                        self.ApexTiming.PingLeadMin,
                        self.ApexTiming.PingLeadMax)
                    -- Apex includes server-time prediction in raw lead
                    local serverTimePredict = math.clamp(
                        apexPing * self.ApexTiming.ServerTimePredictionFactor,
                        0, self.ApexTiming.ServerTimePredictionMax)
                    fusionRawLead = apexPingLead + activation + frameLead + learned
                        + animationLeadCorrection + serverTimePredict - userOffset
                    fusionLead, fusionLeadCap = self:_apexLeadBudget(
                        profile.attackType,
                        math.max(0, predictedImpactAt - now),
                        fusionRawLead,
                        apexPingLead + activation + frameLead,
                        profile.styleKey
                    )
                end
            end
            local remoteConfirmUntil = reactivePulse and reactivePulse.confirmUntil or nil
            local remoteRetryLimit = reactivePulse and reactivePulse.retryLimit or nil
            local remoteRetryInterval = reactivePulse and reactivePulse.retryInterval or nil
            local remoteInitialRetryDelay = reactivePulse and reactivePulse.initialRetryDelay or nil
            if engine == "Fusion" and not reactivePulse then
                local duration = self:_reactiveHitboxDuration(profile.styleKey, profile.attackType)
                local confirmTailValue = self.FusionTiming.ConfirmTail
                remoteConfirmUntil = predictedImpactAt + duration + confirmTailValue
                local m1Retry = self.FusionTiming.RemoteM1RetryLimit
                local m2Retry = self.FusionTiming.RemoteM2RetryLimit
                remoteRetryLimit = profile.attackType == "M2"
                    and (boxingM2 and strike == 2
                        and self.FusionTiming.BoxingSecondRetryLimit
                        or m2Retry)
                    or m1Retry
                remoteRetryInterval = self.FusionTiming.RemoteRetryInterval
                remoteInitialRetryDelay = self.FusionTiming.RemoteInitialRetryDelay
            end
            if engine == "Phantom" and not reactivePulse then
                local duration = self:_reactiveHitboxDuration(profile.styleKey, profile.attackType)
                local confirmTailValue = self:_phantomConfirmTail()
                remoteConfirmUntil = predictedImpactAt + duration + confirmTailValue
                local m1Retry = self.PhantomTiming.M1RetryBase
                local m2Retry = self.PhantomTiming.M2RetryBase
                local pingBoostRetry = math.floor(
                    math.clamp(tonumber(self.PingEMA) or 0, 0, 0.35) * 10
                    * self.PhantomTiming.PingRetryBoost)
                remoteRetryLimit = profile.attackType == "M2"
                    and math.clamp(m2Retry + pingBoostRetry, 0, 10)
                    or math.clamp(m1Retry + pingBoostRetry, 0, 10)
                remoteRetryInterval = math.clamp(
                    self.PhantomTiming.BaseRetryInterval
                    + math.clamp(tonumber(self.PingEMA) or 0, 0, 0.35)
                        * self.PhantomTiming.PingRetryScale,
                    self.PhantomTiming.MinRetryInterval,
                    self.PhantomTiming.MaxRetryInterval)
                remoteInitialRetryDelay = math.max(
                    remoteRetryInterval * 0.7,
                    self.PhantomTiming.MinRetryInterval)
            end
            if engine == "Apex" and not reactivePulse then
                local duration = self:_reactiveHitboxDuration(profile.styleKey, profile.attackType)
                local confirmTailValue = self:_apexConfirmTail()
                remoteConfirmUntil = predictedImpactAt + duration + confirmTailValue
                local m1Retry = self.ApexTiming.M1RetryBase
                local m2Retry = self.ApexTiming.M2RetryBase
                local pingBoostRetry = math.floor(
                    math.clamp(tonumber(self.PingEMA) or 0, 0, 0.35) * 10
                    * self.ApexTiming.PingRetryBoost)
                remoteRetryLimit = profile.attackType == "M2"
                    and math.clamp(m2Retry + pingBoostRetry, 0, 10)
                    or math.clamp(m1Retry + pingBoostRetry, 0, 10)
                remoteRetryInterval = math.clamp(
                    self.ApexTiming.BaseRetryInterval
                    + math.clamp(tonumber(self.PingEMA) or 0, 0, 0.35)
                        * self.ApexTiming.PingRetryScale,
                    self.ApexTiming.MinRetryInterval,
                    self.ApexTiming.MaxRetryInterval)
                remoteInitialRetryDelay = math.max(
                    remoteRetryInterval * 0.6,
                    self.ApexTiming.MinRetryInterval)
            end

            local attempt = {
                engine = engine,
                strategy = strategy,
                id = threat.id,
                styleKey = profile.styleKey,
                model = threat.model,
                source = profile.source,
                sourceClass = threat.sourceClass,
                profile = profile,
                token = token,
                strikeIndex = strike,
                learnedLead = learned,
                animationLeadCorrection = animationLeadCorrection,
                blockHold = blockHold,
                learningKey = threat.id and self:_learningKey(threat.id, strike)
                    or self:_learningKey(profile.styleKey, strike),
                createdAt = now,
                predictedImpactAt = predictedImpactAt,
                baselinePredictedImpactAt = fusionMotion
                    and fusionMotion.baselinePredictedImpactAt or nil,
                motionPredictedImpactAt = fusionMotion
                    and fusionMotion.motionPredictedImpactAt or nil,
                motionClosingSpeed = fusionMotion and fusionMotion.closingSpeed or nil,
                motionProjectedContactIn = fusionMotion
                    and fusionMotion.motionProjectedContactIn or nil,
                motionProjectedInsideHitbox = fusionMotion
                    and fusionMotion.motionProjectedInsideHitbox or nil,
                motionConfidence = fusionMotion and fusionMotion.motionConfidence or nil,
                motionSelectionReason = fusionMotion
                    and fusionMotion.motionSelectionReason or nil,
                motionSelected = motionSelected == true,
                reactivePulse = reactivePulse ~= nil,
                reactiveTiming = reactivePulse,
                reactiveBoxingSecond = reactivePulse and reactivePulse.boxingSecond or false,
                fusionBoxingSecond = (engine == "Fusion") and boxingM2 and strike == 2,
                fusionRawLead = fusionRawLead,
                fusionLead = fusionLead,
                fusionLeadCap = fusionLeadCap,
                reactiveConfirmUntil = remoteConfirmUntil,
                reactiveRetryLimit = remoteRetryLimit,
                reactiveRetryInterval = remoteRetryInterval,
                reactiveInitialRetryDelay = remoteInitialRetryDelay,
                resolved = false,
                cancelled = false,
            }
            attempt.diagnosticId = tostring(threat.diagnosticId or token.id) .. "." .. tostring(strike)
            attempt.transportResolved = transportProbe.transportResolved
            attempt.transportMethod = transportProbe.transportMethod
            attempt.transportDriver = transportProbe.transportDriver
            attempt.transportSelection = transportProbe.transportSelection
            local item = {
                id = threat.id,
                engine = engine,
                strategy = strategy,
                model = threat.model,
                player = threat.player,
                attackType = profile.attackType,
                sourceClass = threat.sourceClass,
                source = threat.source,
                isWrestlingGrab = threat.isWrestlingGrab,
                track = useTrack,
                impactPosition = useTrack and profile.impactPosition or nil,
                impactAt = absoluteImpactAt,
                profile = profile,
                token = token,
                generation = self.Generation,
                createdAt = now,
                deadline = reactivePulse and reactivePulse.confirmUntil + 0.50
                    or now + math.max(2.5,
                        (baseImpactAt - now) + (strike - 1) * multiHitGap + 1.5),
                pingLead = reactivePulse and 0 or ping,
                activationLead = reactivePulse and 0 or activation,
                frameLead = reactivePulse and 0 or frameLead,
                userOffset = reactivePulse and 0 or userOffset,
                learnedLead = learned,
                animationLeadCorrection = animationLeadCorrection,
                fusionRawLead = fusionRawLead,
                fusionLead = not reactivePulse and fusionLead or nil,
                fusionLeadCap = fusionLeadCap,
                blockHold = blockHold,
                strikeIndex = strike,
                boxingM2 = boxingM2,
                reactivePulse = reactivePulse,
                reactiveBoxingSecond = reactivePulse and reactivePulse.boxingSecond or false,
                fusionBoxingSecond = (engine == "Fusion") and boxingM2 and strike == 2,
                predictedImpactAt = attempt.predictedImpactAt,
                baselinePredictedImpactAt = attempt.baselinePredictedImpactAt,
                motionPredictedImpactAt = attempt.motionPredictedImpactAt,
                motionClosingSpeed = attempt.motionClosingSpeed,
                motionProjectedContactIn = attempt.motionProjectedContactIn,
                motionProjectedInsideHitbox = attempt.motionProjectedInsideHitbox,
                motionConfidence = attempt.motionConfidence,
                motionSelectionReason = attempt.motionSelectionReason,
                motionSelected = attempt.motionSelected,
                attempt = attempt,
                diagnosticId = attempt.diagnosticId,
            }
            self.Pending[#self.Pending + 1] = item
            self.Attempts[#self.Attempts + 1] = attempt
            self.ScheduledThreats += 1
            self:_diagnosticRecord("scheduled", item)
        end
        self.LastPipeline = "scheduled-" .. tostring(threat.sourceClass)
        self.LastGate = "pending"
        self.StatusDirty = true
    end

    function R:Emit(threat)
        if Library._ShouldStopAutomationForTyping()
            or not self.CombatRunning
            or not self:IsAutoEnabled()
            or type(threat) ~= "table" then
            return false
        end
        if not threat.model or threat.model == LocalPlayer.Character or isExcludedAttacker(threat.model) then return false end
        threat.detectedAt = tonumber(threat.detectedAt) or os.clock()
        threat.startedAt = tonumber(threat.startedAt) or threat.detectedAt
        threat.sourceClass = self.SourcePriority[threat.sourceClass] and threat.sourceClass or "attribute"
        threat.attackType = threat.attackType == "M2" and "M2" or "M1"
        local profile = self:_resolveProfile(threat)
        if self.DiagnosticEnabled then
            self.DiagnosticAttackSequence += 1
            threat.diagnosticId = self.DiagnosticAttackSequence
            threat.profile = profile
            self:_diagnosticRecord("detected", threat, {
                profileFound = profile ~= nil,
                reason = not profile and "no-profile" or nil,
            })
        end
        if not profile then
            self.LastPipeline = "no-profile-" .. tostring(threat.id or threat.source or "unknown")
            self.LastGate = self.LastPipeline
            self.StatusDirty = true
            return false
        end
        threat.attackType = profile.attackType
        threat.strategy = self:_strategyFor(threat, profile)
        local token = self:_claim(threat, profile)
        if not token then
            self:_diagnosticRecord("claim-rejected", threat, {
                reason = "lower-or-duplicate-priority",
            })
            return false
        end
        self:_schedule(threat, profile, token)
        return true, token
    end

    --[[
        Dispatch a pending item whose fire time has arrived. Shared by the
        Heartbeat tick. Returns
        "wait" when the cooldown gate wants the item kept in Pending,
        otherwise "done" (the item is removed, cancelled, or re-queued for
        intent watching).
    ]]
    function R:_dispatchFire(item, index, now)
        local snapshot = self:_intentSnapshot(item)
        local attempt = item.attempt
        local watchIntent = snapshot and (
            (item.reactivePulse or self:_usesLiveM2Intent(item))
                and snapshot.inside ~= true
                or snapshot.attackerFacingDot < self.IntentFacingThreshold
        )
        local reactiveWait = watchIntent and self:_usesLiveM2Intent(item)
        local skipBoxingFirst = watchIntent
            and self:_shouldSkipBoxingFirst(item, snapshot)
        local cooldownState = self:_fusionCooldownGate(item, now)
        if cooldownState == "wait" then
            self.LastPipeline = "cooldown-wait"
            self.LastGate = "cooldown-wait"
            self.StatusDirty = true
            return "wait"
        elseif cooldownState == "expired" then
            self.LastPipeline = "cooldown-unavailable"
            self.LastGate = "cooldown-unavailable"
            self.StatusDirty = true
            table.remove(self.Pending, index)
            self:_diagnosticRecord("cancelled", item, {
                reason = "cooldown-unavailable",
            })
            self:_cancelItem(item)
            return "done"
        end
        if watchIntent and attempt then
            attempt.intentWatched = true
            attempt.intentFacingAtThreshold = snapshot.attackerFacingDot
            attempt.intentInsideAtThreshold = snapshot.inside
        end
        table.remove(self.Pending, index)
        if skipBoxingFirst and attempt then
            attempt.cancelled = true
            self.LastGate = "boxing-first-no-intent"
            self.StatusDirty = true
            self:_diagnosticRecord("cancelled", item, {
                reason = "boxing-first-no-intent",
                intentMode = "skip-first",
            })
        elseif reactiveWait and attempt then
            item.reactiveIntentPending = true
            item.intentWatchStartedAt = now
            item.intentWatchUntil = math.min(
                now + self.ReactiveIntentWindowSeconds,
                tonumber(attempt.reactiveConfirmUntil)
                    or now + self.ReactiveIntentWindowSeconds
            )
            attempt.intentWatchWindowMs = self.ReactiveIntentWindowSeconds * 1000
            self.Pending[#self.Pending + 1] = item
            self.LastGate = "reactive-intent-wait"
            self.StatusDirty = true
            self:_diagnosticRecord("intent-watch", item, {
                intentMode = "reactive-before-response",
            })
        else
            self:_respond(item)
        end
        if not skipBoxingFirst and not reactiveWait and watchIntent and attempt
            and not attempt.cancelled and attempt.firedAt then
            local boxingM2 = item.attackType == "M2"
                and string.lower(tostring(item.profile and item.profile.styleKey or "")) == "boxing"
            local intentWindow = boxingM2 and self.BoxingM2IntentRearmSeconds
                or self.IntentRearmSeconds
            item.intentWatchStartedAt = now
            item.intentWatchUntil = now + intentWindow
            attempt.intentWatchWindowMs = intentWindow * 1000
            self.Pending[#self.Pending + 1] = item
            self.LastGate = "intent-watch"
            self.StatusDirty = true
            self:_diagnosticRecord("intent-watch", item, {
                intentMode = "rearm",
            })
        end
        return "done"
    end

    function R:_tickPending(now)
        for index = #self.Pending, 1, -1 do
            local item = self.Pending[index]
            local remove = false
            local cancelReason
            if item.token.cancelled or item.token.generation ~= self.Generation
                or item.generation ~= self.Generation then
                self.LastGate = item.token.cancelReason or "superseded"
                self.StatusDirty = true
                cancelReason = self.LastGate
                remove = true
            elseif now > item.deadline then
                self.LastGate = "expired"
                self.StatusDirty = true
                cancelReason = self.LastGate
                remove = true
            elseif item.intentWatchStartedAt then
                local attempt = item.attempt
                local stopWatch = not attempt or attempt.resolved or attempt.cancelled
                if not stopWatch and now >= item.intentWatchUntil then
                    attempt.intentWatchExpired = true
                    self:_diagnosticRecord("intent-expired", item)
                    stopWatch = true
                end
                if not stopWatch then
                    local snapshot = self:_intentSnapshot(item)
                    if not snapshot then
                        stopWatch = true
                    else
                        local initialFacing = attempt.intentFacingAtThreshold
                        local turnedToward = initialFacing ~= nil
                            and (snapshot.attackerFacingDot >= self.IntentFacingThreshold
                                or (snapshot.attackerFacingDot >= self.IntentTurnFloor
                                    and snapshot.attackerFacingDot - initialFacing >= self.IntentTurnDelta))
                        local liveIntent = item.reactiveIntentPending
                            and snapshot.inside == true
                            or (not item.reactiveIntentPending and turnedToward)
                        if liveIntent then
                            attempt.intentWaitMs = (now - item.intentWatchStartedAt) * 1000
                            if item.reactiveIntentPending then
                                item.reactiveIntentPending = nil
                                attempt.intentFacingAtRearm = snapshot.attackerFacingDot
                                attempt.intentInsideAtRearm = snapshot.inside
                                self:_respond(item)
                            else
                                local valid, reason = self:_validate(item)
                                local ownsBlock = not self.Block.active or self.Block.attempt == attempt
                                if valid and ownsBlock then
                                    attempt.intentFacingAtRearm = snapshot.attackerFacingDot
                                    attempt.intentInsideAtRearm = snapshot.inside
                                    attempt.initialCommandAt = attempt.initialCommandAt or attempt.commandAt
                                    if self.Block.active then self:_releaseBlock("intent-rearm") end
                                    if self:RequestBlock(item.blockHold or item.profile.hold, attempt) then
                                        attempt.intentRearmed = true
                                        self.LastGate = "intent-rearm"
                                        self.StatusDirty = true
                                        self:_diagnosticRecord("intent-rearm", item)
                                    else
                                        self:_diagnosticRecord("intent-expired", item, {
                                            reason = "intent-rearm-transport",
                                        })
                                    end
                                else
                                    self:_diagnosticRecord("intent-expired", item, {
                                        reason = ownsBlock and tostring(reason or "validation") or "newer-block",
                                    })
                                end
                            end
                            stopWatch = true
                        end
                    end
                end
                if stopWatch then
                    if item.reactiveIntentPending and item.attempt then
                        item.attempt.cancelled = true
                    end
                    table.remove(self.Pending, index)
                    item = nil
                end
            else
                local remaining = self:_remaining(item, now)
                if remaining == nil then
                    self.LastGate = "track-ended"
                    self.StatusDirty = true
                    cancelReason = self.LastGate
                    if item.strikeIndex == 1 and item.token then item.token.cancelled = true end
                    remove = true
                elseif remaining ~= math.huge then
                    local fireIn = self:_fireIn(item, remaining)
                    if fireIn <= 0 then
                        if self:_dispatchFire(item, index, now) == "wait" then
                            continue
                        end
                        item = nil
                    end
                end
            end
            if remove and item then
                self:_diagnosticRecord("cancelled", item, { reason = cancelReason or "removed" })
                table.remove(self.Pending, index)
                self:_cancelItem(item)
            end
        end
    end

    function R:_tickBlock(now)
        local block = self.Block
        if not block.active then return end
        local typing = Library._ShouldStopAutomationForTyping()
        local remoteCancelled = block.method == "Remote" and block.attempt and (
            block.attempt.cancelled
                or (block.attempt.token and block.attempt.token.cancelled)
        )
        local localCharacter = LocalPlayer.Character
        local interaction = block.method == "Remote"
            and self:_localInteractionReason(localCharacter)
        local unequipped = block.method == "Remote"
            and (not localCharacter or localCharacter:GetAttribute("Equip") ~= true)
        -- SMART CANCEL ON MISS
        if Options.FastUnblock and Options.FastUnblock.Value == true and self:IsAutoEnabled() then
            if block.attempt and block.attempt.predictedImpactAt and not block.attempt.resolved then
                -- If it's been more than 0.1s past the predicted impact and we didn't get hit, cancel it!
                if now > (block.attempt.predictedImpactAt + 0.1) then
                    -- Phantom/Apex: check for nearby threats before releasing (anti-feint + multi-attacker)
                    if (block.attempt.engine == "Phantom" or block.attempt.engine == "Apex")
                        and self:_phantomShouldHoldBlock(block.attempt, now) then
                        local extend = self:_phantomBlockExtendDuration(block.attempt, now)
                        if extend > 0 then
                            block.releaseAt = math.max(block.releaseAt, now + extend)
                            self:_diagnosticRecord("phantom-block-extended", block.attempt, {
                                extendMs = extend * 1000,
                                reason = "multi-threat-hold",
                            })
                        end
                    else
                        self:_releaseBlock("smart-miss-cancelled")
                        return
                    end
                end
            end
        end

        if typing or interaction or unequipped or not self:IsAutoEnabled()
            or now >= block.releaseAt or remoteCancelled then
            local reason = typing and "typing"
                or (interaction and "local-interaction")
                or (unequipped and "unequipped")
                or (not self:IsAutoEnabled() and "auto-disabled")
                or (remoteCancelled and "remote-cancelled")
                or "hold-expired"
            self:_releaseBlock(reason)
            return
        end
        local character = LocalPlayer.Character
        if not character then return end
        local blocking = character:GetAttribute("Blocking") == true
        local perfect = character:GetAttribute("PerfectBlocking") == true
        if not blocking then block.blockingSawFalse = true end
        if not perfect then block.perfectSawFalse = true end
        if block.method == "Module" then
            if not block.confirmed and ((blocking and block.blockingSawFalse)
                or (perfect and block.perfectSawFalse)) then
                block.confirmed = true
                self:_refreshPauseM1()
                self:_diagnosticRecord("block-confirmed", block.attempt or {}, {
                    source = blocking and "Blocking" or "PerfectBlocking",
                    method = "Module",
                    baselineBlocking = block.baselineBlocking,
                    baselinePerfectBlocking = block.baselinePerfectBlocking,
                })
            end
            if block.confirmed or block.moduleFallbackAt <= 0
                or now < block.moduleFallbackAt then
                return
            end
            local attempt = block.attempt
            local fallbackUntil = block.releaseAt
            if attempt then
                attempt.transportSkipModule = true
                attempt.transportResolved = false
                attempt.transportMethod = nil
                attempt.transportDriver = nil
            end
            self:_diagnosticRecord("module-confirm-failed", attempt or {}, {
                graceMs = (block.moduleFallbackAt - (block.pressedAt or now)) * 1000,
                fallback = "Remote/VIM",
            })
            self:_releaseBlock("module-no-confirm")
            if attempt and not attempt.cancelled and not attempt.resolved then
                local current = LocalPlayer.Character
                local remainingWindow = fallbackUntil - now
                if remainingWindow < 0.05 then
                    self:_diagnosticRecord("transport-fallback-expired", attempt, {
                        reason = "insufficient-hold-window",
                    })
                    local emergencyItem = attempt.emergencyDodgeItem
                    if emergencyItem and attempt.emergencyDodgeEligible == true then
                        local dodged = self:_tryReservedEmergencyDodge(
                            emergencyItem,
                            attempt,
                            "insufficient-hold-window"
                        )
                        if not dodged then self:_cancelItem(emergencyItem) end
                    end
                elseif current and current:GetAttribute("BlockCooldown") == true then
                    self.TransportFallback = {
                        attempt = attempt,
                        untilAt = fallbackUntil,
                    }
                else
                    local ok = self:RequestBlock(remainingWindow, attempt)
                    if not ok then
                        if current and current:GetAttribute("BlockCooldown") == true then
                            self.TransportFallback = {
                                attempt = attempt,
                                untilAt = fallbackUntil,
                            }
                        else
                            local emergencyItem = attempt.emergencyDodgeItem
                            if emergencyItem and attempt.emergencyDodgeEligible == true then
                                local dodged = self:_tryReservedEmergencyDodge(
                                    emergencyItem,
                                    attempt,
                                    "module-fallback-transport-failed"
                                )
                                if not dodged then self:_cancelItem(emergencyItem) end end end end end
            end
            return
        end
        if block.method ~= "Remote" or not block.remote then return end
        if block.confirmed and not blocking and not perfect then
            self:_resetRemoteConfirmation("attributes-cleared")
        end
        if not block.confirmed and ((blocking and block.blockingSawFalse)
            or (perfect and block.perfectSawFalse)) then
            block.confirmed = true
            block.confirmationFailed = false
            self:_refreshPauseM1()
            self:_diagnosticRecord("block-confirmed", block.attempt or {}, {
                source = blocking and "Blocking" or "PerfectBlocking",
                retries = block.retryCount,
                baselineBlocking = block.baselineBlocking,
                baselinePerfectBlocking = block.baselinePerfectBlocking,
            })
        end
        local pending = character:GetAttribute("ParryBuffered") == true
        if pending and not block.softPending then
            self:_diagnosticRecord("block-pending", block.attempt or {}, {
                source = "ParryBuffered",
                hardConfirmed = block.confirmed,
            })
        end
        block.softPending = pending
        if block.confirmed then return end
        local confirmUntil = block.confirmUntil > 0
            and block.confirmUntil or (block.pressedAt or now) + 0.50
        if now > confirmUntil then
            if not block.confirmationFailed then
                block.confirmationFailed = true
                local attempt = block.attempt
                self:_diagnosticRecord("block-confirm-failed", attempt or {}, {
                    retries = block.retryCount,
                    retryLimit = block.retryLimit,
                    confirmWindowMs = block.pressedAt
                        and (confirmUntil - block.pressedAt) * 1000 or nil,
                    baselineBlocking = block.baselineBlocking,
                    baselinePerfectBlocking = block.baselinePerfectBlocking,
                    softPending = block.softPending,
                })
                local emergencyItem = attempt and attempt.emergencyDodgeItem
                if attempt and emergencyItem and attempt.emergencyDodgeEligible == true then
                    local dodged = self:_tryReservedEmergencyDodge(
                        emergencyItem,
                        attempt,
                        "remote-confirmation-failed"
                    )
                    if not dodged then
                        if self.Block.active and self.Block.attempt == attempt then
                            self:_releaseBlock("remote-confirm-failed-emergency-unavailable")
                        end
                        self:_cancelItem(emergencyItem)
                    end
                end
            end
            return
        end
        if now < block.retryAt or block.retryCount >= block.retryLimit then return end
        local retryAllowed = character.Parent
            and character:GetAttribute("Equip") == true
            and character:GetAttribute("Ragdoll") ~= true
            and character:GetAttribute("Downed") ~= true
            and character:GetAttribute("GuardBroken") ~= true
            and character:GetAttribute("Greenzone") ~= true
            and character:GetAttribute("RpCombatLocked") ~= true
            and character:GetAttribute("BlockCooldown") ~= true
        if not retryAllowed then
            block.retryAt = now + math.max(0.061, block.retryInterval)
            return
        end
        block.retryCount += 1
        block.retryAt = now + math.max(0.061, block.retryInterval)
        local ok = self:_pressRemoteBlock(block.remote)
        self:_diagnosticRecord(ok and "block-retry" or "block-retry-failed",
            block.attempt or {}, {
                retry = block.retryCount,
                retryLimit = block.retryLimit,
                retryIntervalMs = block.retryInterval * 1000,
                softPending = block.softPending,
            })
    end

    function R:_pruneAttempts(now)
        for index = #self.Attempts, 1, -1 do
            local attempt = self.Attempts[index]
            if not attempt.resolved and not attempt.cancelled and attempt.healthHitAt
                and now - attempt.healthHitAt >= 0.15 then
                self:_learn(attempt, "hit", "health")
            end
            if attempt.resolved or attempt.cancelled or now - attempt.createdAt > 3 then
                table.remove(self.Attempts, index)
            end
        end
        while #self.Attempts > 32 do table.remove(self.Attempts, 1) end
    end

    function R:UpdateStatus(force)
        local now = os.clock()
        if not force and not self.StatusDirty and now - self.LastStatusAt < 1 then return end
        self.LastStatusAt = now
        self.StatusDirty = false
        local engine = self:Engine()
        local data = self:_modeData(engine)
        local animations = 0
        for _ in pairs(data.animations) do animations += 1 end
        local state = self:IsAutoEnabled() and (self.CombatRunning and "Active" or "Starting")
            or (self:IsAutoPunishEnabled() and (self.CombatRunning and "Punish Ready" or "Starting"))
            or "Idle"
        local transport = "-"
        if self.CombatRunning then
            transport = select(1, self:_preferredMethod()) or "No transport"
        end
        local text = string.format(
            "%s | %s | %s | %d samples | %d animations\nW:%d D:%d S:%d F:%d P:%d | %s",
            engine, state, transport, data.totalSamples, animations,
            #self.WatcherList, self.DetectedThreats, self.ScheduledThreats,
            self.FiredThreats, #self.Pending, tostring(self.LastGate)
        )
        pcall(function()
            if EngineStatusLabel and typeof(EngineStatusLabel.SetText) == "function" then
                EngineStatusLabel:SetText(text)
            end
        end)
    end

    function R:SelfCheck()
        local epsilon = 0.000001
        local timelineRemaining = (0.60 - 0.30) / 1.50
        assert(math.abs(timelineRemaining - 0.20) < epsilon, "timeline remaining")
        local fallbackRemaining = 10.32 - 10.12
        assert(math.abs(fallbackRemaining - 0.20) < epsilon, "fallback elapsed")
        local userOffset = -85 / 1000
        assert(userOffset < 0, "negative offset must fire earlier")
        local item = {
            pingLead = 0.05,
            activationLead = 0.02,
            frameLead = 0.016,
            userOffset = -0.075,
            learnedLead = 0.01,
        }
        assert(math.abs(self:_fireIn(item, 0.50) - 0.329) < epsilon, "shared timing formula")
        item.animationLeadCorrection = 0.025
        assert(math.abs(self:_fireIn(item, 0.50) - 0.304) < epsilon,
            "per-animation lead correction")
        local releaseAt = math.max(1.0 + 0.4, 1.2 + 0.4)
        assert(math.abs(releaseAt - 1.6) < epsilon, "block hold extension")
        assert(self.Policy.Perfect.pingFactor > self.Policy.Adaptive.pingFactor,
            "engine ping policies")
        assert(self.Policy.Perfect.strictHitbox and not self.Policy.Adaptive.strictHitbox,
            "engine validation policies")
        assert(self.Policy.Fusion.strictHitbox and self.Policy.Fusion.pingFactor == 0.5,
            "fusion engine policy")
        local clampedFusionLead, fusionLeadCap = self:_fusionLeadBudget("M1", 0.26, 1, 0.03)
        assert(math.abs(fusionLeadCap - 0.117) < epsilon
            and math.abs(clampedFusionLead - fusionLeadCap) < epsilon,
            "Fusion M1 lead safety clamp")
        local flooredFusionLead, flooredFusionCap = self:_fusionLeadBudget("M2", 0.20, 0, 0.20)
        assert(flooredFusionLead == flooredFusionCap and flooredFusionLead <= 0.24,
            "Fusion transport floor must stay inside its lead cap")
        local m1Retries, m1Interval = self:_remoteRetryPolicy({
            engine = "Fusion", profile = { attackType = "M1" },
            reactiveRetryLimit = 99, reactiveRetryInterval = 0.01,
        })
        local m2Retries, m2Interval = self:_remoteRetryPolicy({
            engine = "Fusion", profile = { attackType = "M2" },
            reactiveRetryLimit = 99, reactiveRetryInterval = 0.01,
        })
        assert(self.FusionTiming.RemoteRetryInterval >= 0.061
            and self.FusionTiming.RemoteInitialRetryDelay >= 0.061
            and m1Retries == 2 and m2Retries == 3
            and m1Interval >= 0.061 and m2Interval >= 0.061,
            "shared transport retry bounds")
        local cooldownM1 = {
            engine = "Fusion",
            strategy = "TrackM1",
            profile = { attackType = "M1" },
        }
        local cooldownM2 = {
            engine = "Fusion",
            strategy = "TrackM1",
            profile = { attackType = "M2" },
        }
        local cooldownOtherEngine = {
            engine = "Perfect",
            strategy = "TrackM1",
            profile = { attackType = "M1" },
        }
        assert(self:_fusionCooldownResumeLead(cooldownM1)
                >= self.FusionTiming.M1MinLead
            and self:_fusionCooldownResumeLead(cooldownM2) == nil
            and self:_fusionCooldownResumeLead(cooldownOtherEngine) == nil,
            "Fusion cooldown gate scope")
        local m2Pulse = self.ReactiveTiming
        assert(math.abs(m2Pulse.BoxingSecondHit - m2Pulse.BoxingFirstHit - 0.53) < epsilon,
            "Fusion Boxing M2 pulse gap")
        assert(m2Pulse.BoxingFirstHold == 0.75 and m2Pulse.BoxingSecondHold == 0.30,
            "Fusion Boxing M2 pulse holds")
        assert(m2Pulse.NormalRetryLimit == 3 and m2Pulse.RetryLimit == 8,
            "Fusion pulse timing defaults")
        local perfectWindow = 0.125
        local lowPingBoxingFirst = m2Pulse.BoxingFirstHit
            + m2Pulse.LowPingBonus
            - perfectWindow * m2Pulse.PerfectWindowWeight
            - m2Pulse.BaseLead
            - m2Pulse.M2Lead
        assert(math.abs(lowPingBoxingFirst - 0.41125) < epsilon,
            "Fusion low-ping Boxing first pulse timing")
        local highPingBoxingSecond = m2Pulse.BoxingSecondHit
            - m2Pulse.LowPingThreshold
            - perfectWindow * m2Pulse.PerfectWindowWeight
            - m2Pulse.BaseLead
            - m2Pulse.M2Lead
        assert(math.abs(highPingBoxingSecond - 0.81125) < epsilon,
            "Fusion high-ping Boxing second pulse timing")
        assert(self:_classifyOutcome("M1PerfectBlocked") == "perfect"
            and self:_classifyOutcome("M2Blocked") == "regular"
            and self:_classifyOutcome("M1Hit") == "hit",
            "combat outcome classification")
        assert(self:_outcomeAttackType("M1PerfectBlocked") == "M1"
            and self:_outcomeAttackType("M2Hit") == "M2"
            and self:_outcomeAttackType("GrappleDirtyHit") == nil,
            "Fusion outcome attack type classification")
        assert(math.abs(self.FusionOutcomeCorrelationWindow - 0.20) < epsilon
            and math.abs(self.FusionAttributeOutcomeGuard - 0.30) < epsilon,
            "Fusion correlation guard windows")
        assert(self:_classifyOutcome("GrappleDirtyHit") == nil,
            "non-parry combat events must not train the learner")
        assert(self.SourcePriority.animation > self.SourcePriority.special
            and self.SourcePriority.special > self.SourcePriority.token
            and self.SourcePriority.token > self.SourcePriority.attribute,
            "threat source priority")
        assert(self.FusionBoxingM2SourcePriority.special
                > self.FusionBoxingM2SourcePriority.token
            and self.FusionBoxingM2SourcePriority.token
                > self.FusionBoxingM2SourcePriority.animation,
            "Fusion Boxing M2 source priority")
        assert(normalizeParryEngine("Reactive") == "Fusion"
            and normalizeParryEngine("Fusion") == "Fusion"
            and normalizeParryEngine("Nova") == "Phantom"
            and normalizeParryEngine("Apex") == "Fusion"
            and normalizeParryEngine("invalid") == "Fusion",
            "engine normalization")
        assert(self:_nextComboIndex(nil) == nil
            and self:_nextComboIndex(0) == 1
            and self:_nextComboIndex(1) == 2
            and self:_nextComboIndex(4) == 1,
            "server Combo must resolve to the next M1 index")
        assert(math.abs(self.TokenReclassifySeconds - 0.12) < epsilon,
            "token M1 to M2 reclassification window")
        local tokenAttributes = { CombatAttacking = true }
        local tokenModel = { Parent = true }
        function tokenModel:GetAttribute(name) return tokenAttributes[name] end
        local tokenCandidate = {
            model = tokenModel,
            data = {},
            createdAt = os.clock(),
        }
        assert(self:_tokenAttackSignal(tokenCandidate) == "M1",
            "token offensive signal must classify provisional M1")
        tokenAttributes.PendingM2 = true
        assert(self:_tokenAttackSignal(tokenCandidate) == "M2",
            "token M2 signal must supersede provisional M1")
        local savedClaims, savedSequence, savedSweep =
            self.Claims, self.Sequence, self.ClaimSweep
        self.Claims, self.Sequence, self.ClaimSweep = {}, 0, 0
        local claimModel = {}
        local provisional = self:_claim({
            model = claimModel,
            sourceClass = "token",
            attackType = "M1",
            identity = "selfcheck:M1",
        }, { styleKey = "basic" })
        local upgraded = self:_claim({
            model = claimModel,
            sourceClass = "token",
            attackType = "M2",
            identity = "selfcheck:M2",
        }, { styleKey = "basic" })
        assert(provisional and provisional.cancelled and upgraded,
            "token M2 must cancel its provisional M1 claim")
        self.Claims, self.Sequence, self.ClaimSweep =
            savedClaims, savedSequence, savedSweep
        assert(math.abs(self:_multiHitGap("boxing", "M2") - 0.45) < epsilon,
            "Boxing M2 follow-up gap")
        assert(math.abs(self:_multiHitGap("basic", "M2") - 0.42) < epsilon,
            "other M2 gap remains unchanged")
        assert(self:_learningKey("boxing-m2", 1) == "boxing-m2"
