function _acFireM1()
    local now = os.clock()
    -- Fast M1 mode: fire every 0.04s (server drops some but DPS increases)
    -- Normal mode: fire every 0.08s (server limit)
    local fastM1 = Toggles.AutoCombatFastM1 and Toggles.AutoCombatFastM1.Value
    local minInterval = fastM1 and 0.04 or 0.08
    if now - _lastM1Fire < minInterval then return true end
    _lastM1Fire = now
    -- Combo counter cycles 1-4 like a real M1 string — letting it grow
    -- unbounded makes the server ignore hits on the raw-remote fallback path.
    _acM1ComboCounter = (_acM1ComboCounter % 4) + 1
    local ok = pcall(function()
        local rs = game:GetService("ReplicatedStorage")
        local rem = rs:FindFirstChild("Remotes") and rs.Remotes:FindFirstChild("Server")
        if rem then
            -- Gakuran uses "ServerCheck" with combo counter, not "Activated"
            rem:FireServer({Type = "Combat", Action = "M1", Func = "ServerCheck"}, _acM1ComboCounter)
        end
    end)
    return ok
end

function _acSetSprint(on)
    if on == _acSprinting then return end
    _acSprinting = on
    pcall(function()
        local VIM = game:GetService("VirtualInputManager")
        VIM:SendKeyEvent(on, Enum.KeyCode.LeftShift, false, game)
    end)
end

function _acIsEnemyBehindUs(myRoot, theirRoot)
    if not (myRoot and theirRoot) then return false end
    local toEnemy = theirRoot.Position - myRoot.Position
    local flat = Vector3.new(toEnemy.X, 0, toEnemy.Z)
    if flat.Magnitude < 0.5 then return false end
    local dot = myRoot.CFrame.LookVector:Dot(flat.Unit)
    return dot < -0.2
end

function _acDidEnemyDash(theirRoot)
    if not (_acEnemyLastPos and theirRoot) then return false end
    local moved = (theirRoot.Position - _acEnemyLastPos).Magnitude
    return moved > 6
end

function _acWillAttackHitUs(model, maxRange)
    local myChar = LocalPlayer.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    local theirRoot = model and model:FindFirstChild("HumanoidRootPart")
    if not (myRoot and theirRoot) then return false end
    local dist = (myRoot.Position - theirRoot.Position).Magnitude
    if dist > (maxRange or 10) then return false end
    local dirToUs = myRoot.Position - theirRoot.Position
    local flatDir = Vector3.new(dirToUs.X, 0, dirToUs.Z)
    if flatDir.Magnitude < 0.001 then return true end
    local facingDot = theirRoot.CFrame.LookVector:Dot(flatDir.Unit)
    if facingDot < -0.2 then return false end
    if math.abs(myRoot.Position.Y - theirRoot.Position.Y) > 6 then return false end
    return true
end

--// Enemy status readers (comprehensive)
function _acEnemyIsStunned(model)
    return model:GetAttribute("Stunned") == true
        or model:GetAttribute("Parried") == true
        or model:GetAttribute("Ragdoll") == true
        or model:GetAttribute("GuardBroken") == true
        or model:GetAttribute("Downed") == true
        or model:GetAttribute("Grabbed") == true
        or model:GetAttribute("Grappled") == true
end

function _acEnemyIsBlocking(model)
    return model:GetAttribute("Blocking") == true
        or model:GetAttribute("Block") == true
        or model:GetAttribute("PerfectBlock") == true
end

function _acEnemyIsAttacking(model)
    return model:GetAttribute("M1") == true
        or model:GetAttribute("M2") == true
        or model:GetAttribute("CombatAttacking") == true
        or model:GetAttribute("Attacking") == true
        or model:GetAttribute("isAttacking") == true
        or model:GetAttribute("CombatM1") == true
end

function _acEnemyIsHeavyAttacking(model)
    return model:GetAttribute("M2") == true
        or model:GetAttribute("Heavy") == true
end

function _acEnemyIsUsingSkill(model)
    if model:GetAttribute("Dashing") == true or model:GetAttribute("Dash") == true then return false end
    return model:GetAttribute("Skill1") == true
        or model:GetAttribute("Skill2") == true
        or model:GetAttribute("Skill3") == true
        or model:GetAttribute("Skill4") == true
        or model:GetAttribute("Ultimate") == true
        or model:GetAttribute("Ult") == true
        or model:GetAttribute("UsingSkill") == true
end

--// Block helpers — same recipe as the Parry engine: cancel M1 hold, then Block with server time.
-- Remote only (no VIM at the same time, otherwise the server gets a double "Activated").
local function _acServerRemote()
    local rs = game:GetService("ReplicatedStorage")
    local remotes = rs:FindFirstChild("Remotes")
    return remotes and remotes:FindFirstChild("Server")
end

local _acBlockThread = nil
function _acDoBlock(hold)
    if _acBlockingNow then return end
    local myChar = LocalPlayer.Character
    if myChar and myChar:GetAttribute("BlockCooldown") == true then return end
    _acBlockingNow = true
    local rem = _acServerRemote()
    if rem then
        pcall(function()
            rem:FireServer({Type = "Combat", Action = "M1", Func = "HoldDeactivated"})
            local serverTime = (typeof(Workspace.GetServerTimeNow) == "function" and Workspace:GetServerTimeNow()) or os.time()
            _stampCombatCredit("Block.Activated")
            rem:FireServer({Type = "Combat", Action = "Block", Func = "Activated"}, serverTime)
        end)
    else
        pcall(function()
            game:GetService("VirtualInputManager"):SendKeyEvent(true, Enum.KeyCode.F, false, game)
        end)
    end
    if _acBlockThread then pcall(task.cancel, _acBlockThread) end
    _acBlockThread = task.delay(hold or 0.3, function()
        _acBlockThread = nil
        _acReleaseBlock()
    end)
end

function _acReleaseBlock()
    if not _acBlockingNow then return end
    _acBlockingNow = false
    _acLastBlockRelease = os.clock()
    if _acBlockThread then pcall(task.cancel, _acBlockThread); _acBlockThread = nil end
    local rem = _acServerRemote()
    if rem then
        pcall(function() rem:FireServer({Type = "Combat", Action = "Block", Func = "Deactivated"}) end)
    else
        pcall(function()
            game:GetService("VirtualInputManager"):SendKeyEvent(false, Enum.KeyCode.F, false, game)
        end)
    end
end

--// Smooth facing loop (Heartbeat). Rotates the root toward the target without PivotTo,
-- so it never fights Humanoid:MoveTo (that was the cause of stutter / not chasing).
local _acFaceConn = nil
local _acFacePos = nil        -- Vector3 to face, or nil = release rotation to the game
local _acFaceSnap = false     -- true = snap instantly (enemy is swinging)
local function _acStartFaceLoop()
    if _acFaceConn then return end
    _acFaceConn = RunService.Heartbeat:Connect(function()
        local myChar = LocalPlayer.Character
        local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
        local hum = myChar and myChar:FindFirstChildOfClass("Humanoid")
        if not (myRoot and hum) then return end
        if not _acFacePos or State.dodgeActive then
            if hum.AutoRotate ~= true and not (Toggles.FaceTarget and Toggles.FaceTarget.Value) then
                hum.AutoRotate = true
            end
            return
        end
        if hum.AutoRotate ~= false then hum.AutoRotate = false end
        local targetPos = Vector3.new(_acFacePos.X, myRoot.Position.Y, _acFacePos.Z)
        if (targetPos - myRoot.Position).Magnitude < 0.05 then return end
        local goal = CFrame.lookAt(myRoot.Position, targetPos)
        if _acFaceSnap then
            myRoot.CFrame = goal
        else
            myRoot.CFrame = myRoot.CFrame:Lerp(goal, 0.45)
        end
    end)
end
local function _acStopFaceLoop()
    if _acFaceConn then _acFaceConn:Disconnect(); _acFaceConn = nil end
    _acFacePos = nil
    pcall(function()
        local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if hum and not (Toggles.FaceTarget and Toggles.FaceTarget.Value) then hum.AutoRotate = true end
    end)
end

--// Manual target lock (E key / click)
local _acManualTarget = nil
local function _acCharacterFromInstance(inst)
    while inst and inst ~= workspace do
        if inst:IsA("Model") and inst:FindFirstChildOfClass("Humanoid") then return inst end
        inst = inst.Parent
    end
    return nil
end

local function _acPickTargetOnScreen()
    local mouse = LocalPlayer:GetMouse()
    local myChar = LocalPlayer.Character
    -- 1) Whatever is under the cursor
    local hit = mouse and mouse.Target
    local model = hit and _acCharacterFromInstance(hit)
    if model and model ~= myChar and not isExcludedAttacker(model) then
        local hum = model:FindFirstChildOfClass("Humanoid")
        if hum and hum.Health > 0 then return model end
    end
    -- 2) Fallback: player closest to the cursor on screen
    local cam = workspace.CurrentCamera
    if not cam then return nil end
    local mx, my = mouse and mouse.X or cam.ViewportSize.X / 2, mouse and mouse.Y or cam.ViewportSize.Y / 2
    local best, bestD = nil, 140 -- px
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character and not isExcludedAttacker(p.Character) then
            local root = p.Character:FindFirstChild("HumanoidRootPart")
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            if root and hum and hum.Health > 0 then
                local sp, onScreen = cam:WorldToViewportPoint(root.Position)
                if onScreen then
                    local d = (Vector2.new(sp.X, sp.Y) - Vector2.new(mx, my)).Magnitude
                    if d < bestD then bestD, best = d, p.Character end
                end
            end
        end
    end
    return best
end

local function _acToggleManualTarget()
    local acToggle = Toggles.AutoCombat
    if not (acToggle and acToggle.Value) then return end
    local model = _acPickTargetOnScreen()
    if not model then
        Library:Notify({ Title = "Auto Combat", Description = "No target under cursor", Time = 2, Type = "Warning" })
        return
    end
    if _acManualTarget == model then
        _acManualTarget = nil
        _acLockedModel = nil
        Library:Notify({ Title = "Auto Combat", Description = "Target unlocked", Time = 2 })
        return
    end
    _acManualTarget = model
    _acLockedModel = model
    _acComboCount = 0
    Library:Notify({ Title = "Auto Combat", Description = "Locked: " .. tostring(model.Name), Time = 2, Type = "Success" })
end

local _acSuppressClick = 0
Library._Performance:Track(UserInputService.InputBegan:Connect(function(input, gpe)
    local acToggle = Toggles.AutoCombat
    if not (acToggle and acToggle.Value) then return end
    if Library._IsUserTyping() or (Library.Window and Library.Window.CapturingKeybind) then return end
    if input.UserInputType == Enum.UserInputType.Keyboard then
        local opt = Options.AutoCombatLockKey
        if opt and tostring(opt.Value) == input.KeyCode.Name then
            _acToggleManualTarget()
        end
    elseif input.UserInputType == Enum.UserInputType.MouseButton1 and not gpe
        and os.clock() - _acSuppressClick > 0.08 then
        local clickSel = Toggles.AutoCombatClickSelect
        if clickSel and clickSel.Value then
            local model = _acPickTargetOnScreen()
            if model and model ~= _acManualTarget then
                _acManualTarget = model
                _acLockedModel = model
                _acComboCount = 0
                Library:Notify({ Title = "Auto Combat", Description = "Locked: " .. tostring(model.Name), Time = 2, Type = "Success" })
            end
        end
    end
end))

local ACQUIRE_RANGE = 22

function _acOnTargetSwing(model, track)
    local anim = track.Animation
    local id = anim and parseAnimId(anim.AnimationId)
    local info = id and AttackDB[id]
    if not info then return end
    if _acDodgeTracks[track] then return end
    _acDodgeTracks[track] = true

    local isM2 = (info.kind == "M2" or info.kind == "M2M")
    local isM1 = (info.kind == "M1")
    if not (isM1 or isM2) then return end

    local myChar0 = LocalPlayer.Character
    local myRoot0 = myChar0 and myChar0:FindFirstChild("HumanoidRootPart")
    local theirRoot0 = model:FindFirstChild("HumanoidRootPart")
    if not (myRoot0 and theirRoot0) then return end
    if (myRoot0.Position - theirRoot0.Position).Magnitude > ACQUIRE_RANGE then return end

    local hitDelay = info.delay or (isM2 and 0.4 or 0.25)
    local maxRange = isM2 and 10 or 8
    -- Enemy is swinging: stop attacking, snap-face them until the swing resolves
    _acEnemyAttackUntil = os.clock() + math.max(hitDelay - track.TimePosition, 0) + 0.2
    _acFaceSnap = true
    -- Pro: track enemy aggression for read-game AI
    _acEnemyLastSwingAt = os.clock()
    _acEnemySwingCount = _acEnemySwingCount + 1
    -- If enemy attacks frequently, they're aggressive (we should bait more)
    if _acEnemySwingCount > 2 then
        _acEnemyAggression = math.min(1, _acEnemyAggression + 0.15)
    end

    task.spawn(function()
        local ping = getPing()
        -- Parry engine timing: press slightly before impact, compensated for ping
        local pressAt = hitDelay - ping * 0.5 - 0.06
        if pressAt > track.TimePosition then
            while track.IsPlaying and track.TimePosition < pressAt do
                RunService.Heartbeat:Wait()
            end
        end
        _acFaceSnap = false
        local function whiff(window)
            _acEnemyAttackUntil = 0
            _acEnemyWhiffed = true
            _acPunishWindow = os.clock() + window
        end
        if not track.IsPlaying then whiff(0.6) return end
        if _acEnemyIsStunned(model) then whiff(0.6) return end

        if not _acWillAttackHitUs(model, maxRange) then
            whiff(0.6)
            return
        end

        local myChar = LocalPlayer.Character
        if not myChar or myChar:GetAttribute("Equip") ~= true then return end

        if isM2 then
            -- Heavy: side-step it (Beside = dash to the enemy's flank, never a random direction)
            if os.clock() - _acLastDash >= 0.4 and not State.dodgeActive then
                _acLastDash = os.clock()
                doDodge(model, "Beside")
            else
                -- Can't dash: hold block a bit longer for the heavy
                if not (Toggles.AutoParry and Toggles.AutoParry.Value) then _acDoBlock(0.45) end
            end
        else
            -- M1: PARRY. If the standalone Auto Parry is on, it already handles this — don't double press.
            if not (Toggles.AutoParry and Toggles.AutoParry.Value) then
                _acDoBlock(0.30)
            end
        end

        -- After the hit window passes, the enemy is in recovery -> punish window
        task.delay(0.18, function()
            if os.clock() >= _acEnemyAttackUntil - 0.2 then
                whiff(0.45)
            end
        end)
    end)
end

function _acSetTrackedModel(model)
    if model == _acTrackedModel then return end
    if _acTrackedConn then
        _acTrackedConn:Disconnect()
        _acTrackedConn = nil
    end
    _acTrackedModel = model
    if not model then return end
    local hum = model:FindFirstChildOfClass("Humanoid")
    local animator = hum and hum:FindFirstChildOfClass("Animator")
    if not animator then return end
    _acTrackedConn = animator.AnimationPlayed:Connect(function(track)
        _acOnTargetSwing(model, track)
    end)
end

local _acNpcCache = {}
local _acLastNpcCache = 0

--// One M1. Uses the real input path (melee module / input hook / VirtualUser) first;
-- the raw remote is only a fallback because it can silently do nothing.
local function _acPunch()
    _acSuppressClick = os.clock()
    if State.directM1() then return true end
    return _acFireM1()
end

--// Count nearby enemies (for gank detection)
local function _acCountNearbyEnemies(myRoot, range)
    local count = 0
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local r = p.Character:FindFirstChild("HumanoidRootPart")
            local h = p.Character:FindFirstChildOfClass("Humanoid")
            if r and h and h.Health > 0 and not isExcludedAttacker(p.Character) then
                if (myRoot.Position - r.Position).Magnitude <= range then count = count + 1 end
            end
        end
    end
    return count
end

--// Average position of nearby enemies (to escape away from the middle of a gank)
local function _acGetEnemyCenter(myRoot, range)
    local sumPos, count = Vector3.new(0, 0, 0), 0
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local r = p.Character:FindFirstChild("HumanoidRootPart")
            local h = p.Character:FindFirstChildOfClass("Humanoid")
            if r and h and h.Health > 0 and not isExcludedAttacker(p.Character) then
                if (myRoot.Position - r.Position).Magnitude <= range then
                    sumPos = sumPos + r.Position
                    count = count + 1
                end
            end
        end
    end
    if count == 0 then return nil end
    return sumPos / count
end

--// Walk helper: MoveTo a point just in front of the target (don't shove into them)
local function _acWalkTo(myHum, myRoot, targetPos, standOff)
    local dir = targetPos - myRoot.Position
    local flat = Vector3.new(dir.X, 0, dir.Z)
    if flat.Magnitude <= (standOff or 0) + 0.5 then return end
    local goal = targetPos - flat.Unit * (standOff or 0)
    pcall(function() myHum:MoveTo(goal) end)
end

local function _acResetEngagement()
    _acSetSprint(false)
    _acSetTrackedModel(nil)
    _acUpdateTargetIndicator(nil)
    _acReleaseBlock()
    _acFacePos = nil
    _acComboCount = 0
    _acRecovering = false
    _acComboPhase = "attack"
    _acEnemyLastPos = nil
    _acEnemyAttackUntil = 0
    _acEnemyWhiffed = false
end

task.spawn(function()
    while true do
        if getgenv()._SKT_Unloaded then break end

        local acToggle = Toggles.AutoCombat
        if not (acToggle and acToggle.Value) then
            _acResetEngagement()
            _acStopFaceLoop()
            _acLockedModel = nil
            _acManualTarget = nil
            task.wait(1)
            continue
        end
        _acStartFaceLoop()
        task.wait(0.05 + math.random() * 0.03)

        local myChar = LocalPlayer.Character
        local myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")
        local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
        if not (myChar and myHum and myRoot and myHum.Health > 0) then
            _acResetEngagement()
            continue
        end

        --// Am I CC'd?
        local isStunned = myChar:GetAttribute("Ragdoll") == true
            or myChar:GetAttribute("Stunned") == true
            or myChar:GetAttribute("Downed") == true
            or myChar:GetAttribute("Grabbed") == true
            or myChar:GetAttribute("Grappled") == true
        if isStunned then
            _acSetSprint(false)
            _acReleaseBlock()
            _acFacePos = nil
            _acComboCount = 0
            _acWasStunned = true
            _acComboPhase = "attack"
            continue
        end

        -- Just got out of stun: step back once, then re-engage when clean
        if _acWasStunned then
            _acWasStunned = false
            _acRecovering = true
            local nearestModel, nearestDist = nil, 12
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character then
                    local r = p.Character:FindFirstChild("HumanoidRootPart")
                    local h = p.Character:FindFirstChildOfClass("Humanoid")
                    if r and h and h.Health > 0 then
                        local d = (myRoot.Position - r.Position).Magnitude
                        if d < nearestDist then nearestDist, nearestModel = d, p.Character end
                    end
                end
            end
            if nearestModel and not State.dodgeActive then
                local r = nearestModel:FindFirstChild("HumanoidRootPart")
                if r then
                    -- dash follows MoveDirection: walk away first, then dash
                    local away = (myRoot.Position - r.Position)
                    away = Vector3.new(away.X, 0, away.Z)
                    if away.Magnitude > 0.1 then pcall(function() myHum:MoveTo(myRoot.Position + away.Unit * 12) end) end
                end
                _acLastDash = os.clock()
                doDodge(nearestModel, "Auto")
            end
        end

        if myChar:GetAttribute("Equip") ~= true then
            _acSetSprint(false)
            _acReleaseBlock()
            _acFacePos = nil
            -- Auto-equip: press E (same path Auto Kill uses) so the fighter
            -- doesn't just stand idle when the tool isn't out yet.
            if os.clock() - _acS.lastEquipTry > 0.8 then
                _acS.lastEquipTry = os.clock()
                pcall(function()
                    local vim = game:GetService("VirtualInputManager")
                    vim:SendKeyEvent(true, Enum.KeyCode.E, false, game)
                    task.delay(0.05, function() vim:SendKeyEvent(false, Enum.KeyCode.E, false, game) end)
                end)
            end
            continue
        end

        if _acRecovering then
            local stillBad = myChar:GetAttribute("IFRAMECD") == true or State.dodgeActive
            if stillBad then
                _acSetSprint(false)
                continue
            end
            _acRecovering = false
        end

        local searchRange = Options.AutoCombatRange and Options.AutoCombatRange.Value or 60
        local targetMode = Options.AutoCombatTarget and Options.AutoCombatTarget.Value or "Players"
        local lockMode = Options.AutoCombatTargetMode and Options.AutoCombatTargetMode.Value or "Nearest"
        local useM2 = Toggles.AutoCombatUseM2 and Toggles.AutoCombatUseM2.Value
        local smartDash = Toggles.AutoCombatSmartDash and Toggles.AutoCombatSmartDash.Value

        local bestTarget, bestModel, bestDist, bestScore = nil, nil, searchRange, searchRange

        local function validTarget(model)
            if not (model and model.Parent) or model == myChar then return nil end
            local root = model:FindFirstChild("HumanoidRootPart")
            local hum = model:FindFirstChildOfClass("Humanoid")
            if not (root and hum and hum.Health > 0) then return nil end
            if isExcludedAttacker(model) then return nil end
            return root, hum
        end

        -- Score = real distance minus an HP bonus: a nearly-dead enemy counts
        -- as ~10 studs "closer" so we finish weak targets instead of
        -- switching to whoever is literally nearest.
        local function checkTarget(model)
            local root, hum = validTarget(model)
            if not root then return end
            local dist = (myRoot.Position - root.Position).Magnitude
            local hpBonus = (1 - hum.Health / math.max(hum.MaxHealth, 1)) * 10
            local score = dist - hpBonus
            if score < bestScore then
                bestScore, bestDist, bestTarget, bestModel = score, dist, root, model
            end
        end

        --// 1) Manual lock (E key / click) always wins while the target is alive
        if _acManualTarget then
            local root = validTarget(_acManualTarget)
            if root then
                bestTarget, bestModel = root, _acManualTarget
                bestDist = (myRoot.Position - root.Position).Magnitude
            else
                _acManualTarget = nil
                _acLockedModel = nil
                Library:Notify({ Title = "Auto Combat", Description = "Target lost", Time = 2 })
            end
        end

        --// 2) Locked mode keeps the previous target
        if not bestTarget and lockMode == "Locked" then
            local root = validTarget(_acLockedModel)
            if root then
                local dist = (myRoot.Position - root.Position).Magnitude
                if dist <= searchRange then
                    bestTarget, bestModel, bestDist = root, _acLockedModel, dist
                end
            end
        end

        --// 3) Otherwise search (Manual mode never auto-picks)
        if not bestTarget and lockMode ~= "Manual" then
            if targetMode == "Players" or targetMode == "Both" then
                for _, p in ipairs(Players:GetPlayers()) do
                    if p.Character then checkTarget(p.Character) end
                end
            end
            if targetMode == "NPCs" or targetMode == "Both" then
                -- Cheap path: workspace.NPCs holds the named NPCs — refresh
                -- every 2s with a shallow scan (no full workspace traversal).
                if os.clock() - _acLastNpcCache > 2 then
                    _acLastNpcCache = os.clock()
                    local tempCache = {}
                    local npcFolder = Workspace:FindFirstChild("NPCs")
                    if npcFolder then
                        for _, npc in ipairs(npcFolder:GetChildren()) do
                            if npc:IsA("Model") and npc:FindFirstChildOfClass("Humanoid")
                                and not Players:GetPlayerFromCharacter(npc) then
                                table.insert(tempCache, npc)
                            end
                        end
                    end
                    -- Merge in extras found by the slow deep scan
                    for _, npc in ipairs(_acS.npcDeepExtra) do
                        if npc.Parent then table.insert(tempCache, npc) end
                    end
                    _acNpcCache = tempCache
                end
                -- Slow fallback: deep workspace sweep every 20s catches NPCs
                -- that live outside the NPCs folder (deep scan = heavy, rare).
                if os.clock() - _acS.lastNpcDeepScan > 20 then
                    _acS.lastNpcDeepScan = os.clock()
                    task.spawn(function()
                        local npcFolder = Workspace:FindFirstChild("NPCs")
                        local extras = {}
                        local desc = Workspace:GetDescendants()
                        for i, npc in ipairs(desc) do
                            if npc:IsA("Model")
                                and (not npcFolder or npc.Parent ~= npcFolder)
                                and npc:FindFirstChildOfClass("Humanoid")
                                and not Players:GetPlayerFromCharacter(npc)
                                and npc.Name ~= "Downed" then
                                table.insert(extras, npc)
                            end
                            if i % 1000 == 0 then task.wait() end
                        end
                        _acS.npcDeepExtra = extras
                    end)
                end
                for _, npc in ipairs(_acNpcCache) do
                    if npc and npc.Parent then checkTarget(npc) end
                end
            end
        end

        if not bestTarget then
            _acResetEngagement()
            if lockMode ~= "Manual" then _acLockedModel = nil end
            continue
        end

        _acLockedModel = (lockMode ~= "Nearest" or _acManualTarget) and bestModel or nil

        if bestModel ~= _acTrackedModel then
            _acEnemyAttackUntil = 0
            _acEnemyWhiffed = false
            _acComboCount = 0
        end
        _acSetTrackedModel(bestModel)
        _acUpdateTargetIndicator(bestModel)

        local now = os.clock()

        --// Read enemy state
        local eStunned = _acEnemyIsStunned(bestModel)
        local eBlocking = _acEnemyIsBlocking(bestModel)
        local eAttacking = _acEnemyIsAttacking(bestModel)
        local eHeavy = _acEnemyIsHeavyAttacking(bestModel)
        local eHum = bestModel:FindFirstChildOfClass("Humanoid")
        local eHpPercent = eHum and (eHum.Health / math.max(eHum.MaxHealth, 1)) or 1
        local myHpPercent = myHum.Health / math.max(myHum.MaxHealth, 1)
        local m2Ready = useM2 and myChar:GetAttribute("M2Cooldown") ~= true
        local enemyAttacking = (now < _acEnemyAttackUntil) or eAttacking
        _acEnemyLastPos = bestTarget.Position

        local engageRange = 6.5      -- start swinging
        local standOff = 3.2         -- how close we walk to them
        local threatRange = 11

        --// GANK CHECK: 2+ enemies close and HP < 45% -> get out, don't trade
        local nearbyEnemies = _acCountNearbyEnemies(myRoot, threatRange)
        if nearbyEnemies >= 2 and myHpPercent < 0.45 then
            _acReleaseBlock()
            _acFacePos = nil -- let the game rotate so we can actually run
            _acSetSprint(true)
            local center = _acGetEnemyCenter(myRoot, threatRange) or bestTarget.Position
            local away = myRoot.Position - center
            away = Vector3.new(away.X, 0, away.Z)
            if away.Magnitude > 0.1 then
                pcall(function() myHum:MoveTo(myRoot.Position + away.Unit * 30) end)
                if now - _acLastDash > 0.6 and not State.dodgeActive then
                    _acLastDash = now
                    doDodge(bestModel, "Auto")
                end
            end
            _acComboCount = 0
            continue
        end

        --// LOW HP 1v1: kite a little (walk away, keep facing to parry), no dashing spam
        if myHpPercent < 0.18 and eHpPercent > myHpPercent then
            _acReleaseBlock()
            _acFacePos = bestTarget.Position
            _acSetSprint(true)
            local away = myRoot.Position - bestTarget.Position
            away = Vector3.new(away.X, 0, away.Z)
            if away.Magnitude > 0.1 then pcall(function() myHum:MoveTo(myRoot.Position + away.Unit * 18) end) end
            _acComboCount = 0
            continue
        end

        --// CHASE: far away -> sprint at their PREDICTED position (lead the
        -- target by its velocity so we cut off runners instead of tailing).
        if bestDist > engageRange then
            _acReleaseBlock()
            _acFacePos = nil
            _acComboCount = 0
            _acComboPhase = "attack"
            if enemyAttacking and bestDist <= threatRange then
                -- They're swinging at the edge of range: stop, face them and let the parry land
                _acSetSprint(false)
                _acFacePos = bestTarget.Position
            else
                _acSetSprint(true)
                local tVel = bestTarget.AssemblyLinearVelocity or Vector3.zero
                local leadTime = math.clamp(bestDist / 60, 0, 0.4)
                local chasePos = bestTarget.Position + Vector3.new(tVel.X, 0, tVel.Z) * leadTime
                _acWalkTo(myHum, myRoot, chasePos, standOff)
                -- SmartDash gap-closer: dash forward to close large gaps fast
                if smartDash and bestDist > 12 and bestDist < 45
                    and now - _acLastDash > 0.9 and not State.dodgeActive then
                    _acLastDash = now
                    doDodge(bestModel, "Auto")
                end
            end
            continue
        end

        --// IN RANGE: always face them (smooth loop), stop sprinting
        _acFacePos = bestTarget.Position
        _acSetSprint(false)
        -- SmartDash strafe weave: orbit perpendicular to the target while in
        -- range — keeps standoff distance AND makes us hard to hit, without
        -- ever breaking facing (the face loop handles rotation).
        if smartDash and not enemyAttacking and not eStunned then
            if now >= _acS.strafeFlipAt then
                _acS.strafeDir = -_acS.strafeDir
                _acS.strafeFlipAt = now + 0.4 + math.random() * 0.25
            end
            local toUs = myRoot.Position - bestTarget.Position
            local flatUs = Vector3.new(toUs.X, 0, toUs.Z)
            if flatUs.Magnitude > 0.1 then
                local side = flatUs.Unit:Cross(Vector3.new(0, 1, 0)) * _acS.strafeDir
                local strafeGoal = bestTarget.Position
                    + flatUs.Unit * standOff + side * 2.5
                pcall(function() myHum:MoveTo(strafeGoal) end)
            end
        elseif bestDist > standOff + 1.2 and not enemyAttacking then
            _acWalkTo(myHum, myRoot, bestTarget.Position, standOff)
        end

        --// A) Enemy is swinging HEAVY (M2) -> DEFEND ONLY. M2 is dangerous, must dodge/parry.
        if (eHeavy and eAttacking) or _acBlockingNow then
            _acComboCount = 0
            -- Heavy without a tracked animation (attribute only): step to their side
            if eHeavy and eAttacking and now - _acLastDash > 0.5 and not State.dodgeActive then
                _acLastDash = now
                doDodge(bestModel, "Beside")
            end
            continue
        end

        --// A2) Enemy is swinging M1 -> TRADE (pro players trade M1s, don't just wait)
        -- Auto Parry handles the block. We still attack to out-DPS them.
        if enemyAttacking and not eHeavy then
            -- Still attack but at slightly slower rate (trading)
            if now - _acLastAttack > 0.18 then
                _acLastAttack = now
                if m2Ready and _acComboCount >= 2 then
                    if State.directM2() then _acComboCount = 0 end
                else
                    _acComboCount = _acComboCount + 1
                    _acPunch()
                    if _acComboCount >= 4 then
                        _acComboCount = 0
                        _acComboPhase = "pause"
                        _acPauseUntil = now + 0.15 + math.random() * 0.08
                    end
                end
            end
            continue
        end

        --// B) Enemy is stunned / parried / ragdolled -> PUNISH, full speed
        if eStunned then
            _acComboPhase = "punish"
            if now - _acLastAttack > 0.20 then
                _acLastAttack = now
                if m2Ready and _acComboCount >= 2 then
                    if State.directM2() then _acComboCount = 0 end
                else
                    _acComboCount = _acComboCount + 1
                    _acPunch()
                end
            end
            continue
        end
        if _acComboPhase == "punish" then _acComboPhase = "attack"; _acComboCount = 0 end

        --// C) Enemy is blocking -> guard break with M2 if ready, otherwise don't feed into the block
        if eBlocking then
            if m2Ready and now - _acLastAttack > 0.15 then
                _acLastAttack = now
                State.directM2()
                _acComboCount = 0
            end
            continue
        end

        --// D) Whiff punish: they swung and missed -> M2 immediately if ready, else M1 right away
        if _acEnemyWhiffed and now < _acPunishWindow then
            _acEnemyWhiffed = false
            _acComboPhase = "attack"
            if now - _acLastAttack > 0.06 then
                _acLastAttack = now
                if m2Ready then
                    if not State.directM2() then
                        _acPunch()
                    end
                    _acComboCount = 0
                else
                    _acComboCount = 1
                    _acPunch()
                end
            end
            continue
        elseif _acEnemyWhiffed then
            _acEnemyWhiffed = false
        end

        --// E) Neutral: they're not attacking -> we attack. M1 chain, M2 after 2-3 hits when ready.
        if _acComboPhase == "pause" then
            if now >= _acPauseUntil then
                _acComboPhase = "attack"
                _acComboCount = 0
            else
                continue
            end
        end

        --// PRO BAIT: if enemy is aggressive (swings a lot), occasionally spacing bait
        -- This is a MOVEMENT MODIFIER only — it does NOT block M1 attacks.
        if _acEnemyAggression > 0.4 and not _acBaitPhase and _acComboCount == 0
            and now - _acLastAttack > 0.5 and now - _acLastDash > 0.8 then
            if math.random() < 0.2 then
                _acBaitPhase = true
                _acBaitDir = 1
                _acBaitUntil = now + 0.25
            end
        end

        if _acBaitPhase then
            if now >= _acBaitUntil then
                if _acBaitDir == 1 then
                    _acBaitDir = -1
                    _acBaitUntil = now + 0.30
                    local away = myRoot.Position - bestTarget.Position
                    away = Vector3.new(away.X, 0, away.Z)
                    if away.Magnitude > 0.1 then
                        pcall(function() myHum:MoveTo(myRoot.Position + away.Unit * 8) end)
                    end
                else
                    _acBaitPhase = false
                    if _acEnemyWhiffed and now < _acPunishWindow then
                        _acComboPhase = "attack"
                        _acComboCount = 0
                    end
                end
            else
                if _acBaitDir == 1 then
                    _acWalkTo(myHum, myRoot, bestTarget.Position, standOff)
                end
                -- NO continue here: let M1 combo still fire while baiting
            end
        end

        --// PRO RETREAT: very rare, only when enemy is extremely aggressive
        if _acEnemyAggression > 0.7 and _acComboCount == 0
            and now - _acLastAttack > 1.2 and now - _acLastDash > 1.5
            and math.random() < 0.08 then
            local away = myRoot.Position - bestTarget.Position
            away = Vector3.new(away.X, 0, away.Z)
            if away.Magnitude > 0.1 then
                pcall(function() myHum:MoveTo(myRoot.Position + away.Unit * 6) end)
            end
            _acEnemyAggression = math.max(0, _acEnemyAggression - 0.15)
            -- NO continue: still allow M1 to fire
        end

        --// COMBO: M1 x4 at real swing cadence -> M2 finisher when ready -> short reset -> repeat.
        local m1Gap = 0.24 + math.random() * 0.05
        if now - _acLastAttack > m1Gap then
            _acLastAttack = now
            local didM2 = false
            -- M2 closes the string (after 3 M1s), or earlier to finish a low-HP enemy
            if m2Ready and (_acComboCount >= 3 or (_acComboCount >= 2 and eHpPercent < 0.35)) then
                didM2 = State.directM2()
                if didM2 then
                    _acComboCount = 0
                    _acComboPhase = "pause"
                    _acPauseUntil = now + 0.35 + math.random() * 0.15
                end
            end
            if not didM2 then
                _acComboCount = _acComboCount + 1
                _acPunch()
                -- Full 4-hit string done (no M2 available): brief reset so the chain restarts clean
                if _acComboCount >= 4 then
                    _acComboCount = 0
                    _acComboPhase = "pause"
                    _acPauseUntil = now + 0.22 + math.random() * 0.15
                end
            end
        end
    end
end)

--// ============================ Auto Warp Dodge (Teleport Evade) ============================
-- When an enemy swings at us, instantly teleport behind them to dodge.
local _warpDodgeCooldown = 0
local _warpDodgeLatch = setmetatable({}, { __mode = "k" }) -- per-attacker latch: one warp per swing
local function _findAttackingEnemy(range)
    local myChar = LocalPlayer.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myRoot then return nil end
    local function isThreat(char, root)
        if char:GetAttribute("CombatAttacking") ~= true
            and char:GetAttribute("M1") ~= true
            and char:GetAttribute("M2") ~= true then
            return false
        end
        -- Only a threat if the attacker is actually facing toward us
        local toUs = myRoot.Position - root.Position
        local dist = toUs.Magnitude
        if dist < 0.01 then return true end
        return root.CFrame.LookVector:Dot(toUs / dist) > 0.25
    end
    local bestModel, bestDist = nil, range
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local char = p.Character
            local root = char:FindFirstChild("HumanoidRootPart")
            local hum = char:FindFirstChildOfClass("Humanoid")
            if root and hum and hum.Health > 0 then
                local dist = (myRoot.Position - root.Position).Magnitude
                if dist <= bestDist and isThreat(char, root) then
                    bestDist = dist
                    bestModel = char
                end
            end
        end
    end
    -- Also check NPCs
    if not bestModel then
        for _, npc in ipairs(_acNpcCache or {}) do
            if npc and npc.Parent then
                local root = npc:FindFirstChild("HumanoidRootPart")
                local hum = npc:FindFirstChildOfClass("Humanoid")
                if root and hum and hum.Health > 0 then
                    local dist = (myRoot.Position - root.Position).Magnitude
                    if dist <= bestDist and isThreat(npc, root) then
                        bestDist = dist
                        bestModel = npc
                    end
                end
            end
        end
    end
    return bestModel
end

