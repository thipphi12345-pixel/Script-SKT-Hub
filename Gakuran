    function Window:Destroy()
        if self.Destroyed then return end
        self.Destroyed = true
        for object, animation in pairs(AmbientTweens) do
            animation:Cancel()
            AmbientTweens[object] = nil
        end
        for object, animation in pairs(ActiveTweens) do
            animation:Cancel()
            ActiveTweens[object] = nil
            TweenGoals[object] = nil
        end
        for _, connection in ipairs(self.Connections) do
            pcall(function()
                connection:Disconnect()
            end)
        end
        table.clear(self.Connections)
        if self.Screen then
            self.Screen:Destroy()
            self.Screen = nil
        end
        if self.WatermarkScreen then
            self.WatermarkScreen:Destroy()
            self.WatermarkScreen = nil
        end
        if self.Environment and self.Environment[ACTIVE_WINDOW_KEY] == self then
            self.Environment[ACTIVE_WINDOW_KEY] = nil
        end
    end

