local CombatStyleResolver = (function()
    local animationUtils = nil
    local nextUtilityAttemptAt = 0

    local function canonical(value)
        if typeof(value) ~= "string" then return nil end
        value = string.lower(value)
        return value ~= "" and value or nil
    end

    local function getAnimationUtils()
        if animationUtils then return animationUtils end
        local now = os.clock()
        if now < nextUtilityAttemptAt then return nil end
        nextUtilityAttemptAt = now + 5
        task.spawn(function()
            pcall(function()
                local shared = ReplicatedStorage:FindFirstChild("Shared")
                local utils = shared and shared:FindFirstChild("Utils")
                local module = utils and utils:FindFirstChild("CombatAnimationUtils")
                if module and module:IsA("ModuleScript") then
                    local resolved = require(module)
                    if type(resolved) == "table"
                        and typeof(resolved.GetCombatStyleForCharacter) == "function" then
                        animationUtils = resolved
                    end
                end
            end)
        end)
        return animationUtils
    end

    local function resolveFromValues(utilityStyle, characterStyle, playerStyle, characterDataStyle, playerDataStyle)
        local style = canonical(utilityStyle)
        if style then return style, "CombatAnimationUtils" end
        style = canonical(characterStyle)
        if style then return style, "Character.CombatStyle" end
        style = canonical(playerStyle)
        if style then return style, "Player.CombatStyle" end
        style = canonical(characterDataStyle)
        if style then return style, "Character.PlayerData.CombatStyle" end
        style = canonical(playerDataStyle)
        if style then return style, "Player.PlayerData.CombatStyle" end
        return "default", "default"
    end

    local function attribute(instance, name)
        if not instance then return nil end
        local ok, value = pcall(instance.GetAttribute, instance, name)
        return ok and value or nil
    end

    local combatStyleCache = setmetatable({}, { __mode = "k" })
    local function resolve(model)
        if not model then return "default", "default" end
        local utilityStyle = combatStyleCache[model]
        if not utilityStyle then
            local utility = getAnimationUtils()
            if utility then
                task.spawn(function()
                    local ok, value = pcall(utility.GetCombatStyleForCharacter, model)
                    if ok and type(value) == "string" then 
                        combatStyleCache[model] = value 
                    end
                end)
            end
        end
        local player = Players:GetPlayerFromCharacter(model)
        local characterData = model:FindFirstChild("PlayerData")
        local playerData = player and player:FindFirstChild("PlayerData")
        return resolveFromValues(
            utilityStyle,
            attribute(model, "CombatStyle"),
            attribute(player, "CombatStyle"),
            attribute(characterData, "CombatStyle"),
            attribute(playerData, "CombatStyle")
        )
    end

    return {
        Resolve = resolve,
        ResolveFromValues = resolveFromValues,
    }
end)()

