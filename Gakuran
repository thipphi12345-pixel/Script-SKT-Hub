    function R:_findDiagnosticContext(now)
        local best, bestScore, candidates = nil, math.huge, 0
        local seen = {}
        for index = #self.DiagnosticRecent, 1, -1 do
            local entry = self.DiagnosticRecent[index]
            local context = entry.context
            if now - entry.at <= 1.5 and context and not seen[context] then
                seen[context] = true
                candidates += 1
                local attempt = context.attempt or (context.createdAt and context.model and context)
                local predicted = context.predictedImpactAt or (attempt and attempt.predictedImpactAt)
                local score = predicted and math.abs(now - predicted) or (now - entry.at + 0.5)
                if context.diagStage == "fired" then score -= 0.15 end
                if score < bestScore then
                    best, bestScore = context, score
                end
            end
        end
        local confidence = bestScore <= 0.25 and "high"
            or bestScore <= 0.60 and "medium" or "low"
        return best, candidates, confidence
    end

    function R:_diagnosticDamage(beforeHealth, afterHealth)
        if not self.DiagnosticEnabled then return end
        local now = os.clock()
        local context, candidates, confidence = self:_findDiagnosticContext(now)
        local attempt = context and (context.attempt
            or (context.createdAt and context.model and context)) or nil
        local character = LocalPlayer.Character
        local blocking = character and character:GetAttribute("Blocking") == true
        local reason
        if not context then
            reason = "no-correlated-threat"
        elseif context.diagStage == "rejected" or context.diagStage == "cancelled" then
            reason = context.diagStage .. "-" .. tostring(context.diagReason or "unknown")
        elseif not (attempt and attempt.firedAt) then
            reason = "not-fired-" .. tostring(context.diagStage or "detected")
                .. (context.diagReason and ("-" .. tostring(context.diagReason)) or "")
        elseif not blocking and not self.Block.active then
            reason = "block-inactive-at-damage"
        else
            reason = "damage-during-block-window"
        end
        self:_diagnosticRecord("damage", context or {}, {
            reason = reason,
            healthBefore = beforeHealth,
            healthAfter = afterHealth,
            damage = math.max(0, beforeHealth - afterHealth),
            candidateCount = candidates,
            correlationConfidence = confidence,
            commandToDamageMs = attempt and attempt.commandAt
                and (now - attempt.commandAt) * 1000 or nil,
            predictedImpactErrorMs = attempt and attempt.predictedImpactAt
                and (now - attempt.predictedImpactAt) * 1000 or nil,
            blockingAttribute = blocking == true,
            lastGate = self.LastGate,
        })
    end

    function R:ExportDiagnostics()
        local root = "Int3/Gakuran/exports/parry-diagnostic"
        if typeof(writefile) ~= "function" or typeof(makefolder) ~= "function" then
            pcall(function()
                Library:Notify({ Title = "Parry Diagnostic", Description = "Executor cannot write files.", Time = 4 })
            end)
            return nil
        end
        local current = ""
        for part in root:gmatch("[^/]+") do
            current = current == "" and part or (current .. "/" .. part)
            if typeof(isfolder) ~= "function" or not isfolder(current) then
                pcall(makefolder, current)
            end
        end
        local stamp = os.date("!%Y%m%d-%H%M%S")
        local path = string.format("%s/parry-%s-%04d.json",
            root, stamp, math.floor(os.clock() * 1000) % 10000)
        local payload = {
            schema = "int3.parry-diagnostic.v7",
            createdAtUnix = os.time(),
            startedAtUnix = self.DiagnosticStartedUnix,
            elapsedSeconds = os.clock() - self.DiagnosticStartedClock,
            placeId = game.PlaceId,
            jobId = game.JobId,
            mobile = IsTouchPrimary(),
            attackDatabaseCount = AttackDBCount,
            settings = {
                engine = self:Engine(),
                method = tostring(Options.ParryMethod and Options.ParryMethod.Value or "Auto"),
                transportPolicy = "Auto: Module > Server Remote > desktop VIM",
                coverage = tostring(Options.AttackCoverage and Options.AttackCoverage.Value or "All Known"),
                timingOffsetMs = tonumber(Options.TimingOffset and Options.TimingOffset.Value),
                blockHoldMs = tonumber(Options.BlockHold and Options.BlockHold.Value),
                maxRange = tonumber(Options.MaxRange and Options.MaxRange.Value),
            },
            summary = self.DiagnosticSummary,
            events = self.DiagnosticEvents,
        }
        local okEncode, encoded = pcall(HttpService.JSONEncode, HttpService, payload)
        local okWrite = okEncode and pcall(writefile, path, encoded)
        pcall(function()
            Library:Notify({
                Title = "Parry Diagnostic",
                Description = okWrite and ("Exported " .. path) or "Export failed.",
                Time = 5,
            })
        end)
        return okWrite and path or nil
    end

    function R:Engine()
        return normalizeParryEngine(Options.ParryEngine and Options.ParryEngine.Value)
    end

    function R:_strategyFor(threat, profile)
        local engine = self:Engine()
        if engine ~= "Fusion" and engine ~= "Phantom" and engine ~= "Apex" then return "LegacyTrack" end
        if profile.attackType ~= "M2" then return "TrackM1" end
        local styleKey = string.lower(tostring(profile.styleKey or styleOf(threat.model)))
        if styleKey == "boxing" then return "BoxingM2" end
        if threat.isWrestlingGrab or threat.sourceClass == "special" then return "SpecialM2" end
        return "ConfirmedM2"
    end

    function R:_usesConfirmedRemote(value)
        local attempt = value and (value.attempt or value)
        if type(attempt) ~= "table" then return false end
        return attempt.method == "Remote" or attempt.transportMethod == "Remote"
    end

    function R:_usesLiveM2Intent(value)
        local attempt = value and (value.attempt or value)
        return type(attempt) == "table"
            and (attempt.engine == "Fusion" or attempt.engine == "Phantom" or attempt.engine == "Apex")
            and attempt.profile and attempt.profile.attackType == "M2"
    end

    function R:_aliCounterCooldown()
        local cooldown = 6
        if CombatConfig and typeof(CombatConfig.GetStyleEvasiveCounter) == "function" then
            local ok, config = pcall(CombatConfig.GetStyleEvasiveCounter, "ali")
            local configured = ok and type(config) == "table" and tonumber(config.Cooldown) or nil
            if configured and configured >= 0 then cooldown = configured end
        end
        self.AliCounterCooldown = cooldown
        return cooldown
    end

    function R:_aliCounterState(now)
        now = tonumber(now) or os.clock()
        local expiresAt = tonumber(self.AliCounterReadyAt) or 0
        return now >= expiresAt, expiresAt, self.AliCounterSource or "initial-ready",
            tonumber(self.AliCounterCooldown) or 6
    end

    function R:_startAliCounterProvisional(now)
        now = tonumber(now) or os.clock()
        local cooldown = self:_aliCounterCooldown()
        self.AliCounterReadyAt = now + cooldown
        self.AliCounterSource = "provisional-dodge"
        return self:_aliCounterState(now)
    end

    function R:_observeAliCounter(channel, eventName, ...)
        if eventName ~= "StyleEvasiveCounter" then return false end
        local localCharacter = LocalPlayer.Character
        if not localCharacter or ResolveCombatStyle(localCharacter) ~= "ali" then return false end
        local args = table.pack(...)
        local appliesToLocal = false
        for _, model in ipairs(self:_collectCharacters(table.unpack(args, 1, args.n))) do
            if model == localCharacter then
                appliesToLocal = true
                break
            end
        end
        if not appliesToLocal then
            for index = 1, args.n do
                local value = args[index]
                if type(value) == "string"
                    and (value == localCharacter.Name or value == LocalPlayer.Name) then
                    appliesToLocal = true
                    break
                end
            end
        end
        if not appliesToLocal then return false end

        local now = os.clock()
        local token = "StyleEvasiveCounter\0" .. self:_combatEventSignature(eventName, args)
        local previous = self.CombatEventTokens[token]
        if previous and now - previous < 0.20 then return false end
        self.CombatEventTokens[token] = now
        self.AliCounterCharacter = localCharacter
        self.AliCounterReadyAt = now + self:_aliCounterCooldown()
        self.AliCounterSource = "CombatBroadcast:" .. tostring(channel)
        self:_diagnosticRecord("ali-counter-broadcast", {
            model = localCharacter,
            source = self.AliCounterSource,
        }, {
            aliCounterReady = false,
            aliCounterSource = self.AliCounterSource,
            aliCounterExpiresInMs = self.AliCounterCooldown * 1000,
        })
        return true
    end

