function _photoEnsureFloatBV(root)
    if not root or not root.Parent then return end
    pcall(function()
        -- Dedupe: stale copies of this script (or leftovers after a reload)
        -- used to stack extra AutoFarmFloat movers on the root and fight us.
        for _, c in ipairs(root:GetChildren()) do
            if c:IsA("BodyVelocity") and c.Name == "AutoFarmFloat" and c ~= _photoFloatBV then
                pcall(function() c:Destroy() end)
            end
        end
        if not _photoFloatBV or _photoFloatBV.Parent ~= root then
            if _photoFloatBV then pcall(function() _photoFloatBV:Destroy() end) end
            _photoFloatBV = Instance.new("BodyVelocity")
            _photoFloatBV.Name = "AutoFarmFloat"
            _photoFloatBV.Velocity = Vector3.new(0, 0, 0)
            _photoFloatBV.MaxForce = Vector3.new(9e9, 9e9, 9e9)
            _photoFloatBV.Parent = root
        end
    end)
end

function _photoGroundedPosition(pos)
    local LP = game:GetService("Players").LocalPlayer
    local WS = game:GetService("Workspace")
    local ok, result = pcall(function()
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        local myChar = LP and LP.Character
        if myChar then params.FilterDescendantsInstances = { myChar } end
        local hit = WS:Raycast(Vector3.new(pos.X, pos.Y + 4, pos.Z), Vector3.new(0, -8, 0), params)
        if hit and hit.Position then return hit end
        return nil
    end)
    if ok and result and result.Position then
        return Vector3.new(pos.X, result.Position.Y + 0.2, pos.Z)
    end
    return Vector3.new(pos.X, pos.Y, pos.Z)
end

