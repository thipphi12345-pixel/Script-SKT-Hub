    function R:_evasivePolicyFor(
        autoDodge,
        mode,
        attackType,
        attackerM2Cooldown,
        rearAttack,
        rearEnabled
    )
        if autoDodge ~= true then
            return false, false, "auto-dodge-disabled", "toggle", false
        end
        if rearAttack == true and rearEnabled ~= true then
            return false, false, "rear-toggle-off", "CanDodgeRearAttacks", false
        end
        if mode == "M2" then
            return attackType == "M2", false,
                attackType == "M2" and "m2-mode" or "attack-type", "mode", false
        end
        if mode == "M1 & M2" then
            local matches = attackType == "M1" or attackType == "M2"
            return matches, false, matches and "m1-m2-mode" or "attack-type", "mode", false
        end
        if mode == "M2 Priority" then
            if attackType == "M2" then
                return true, true, "m2-priority-m2", "attack-type", false
            end
            if attackType == "M1" and attackerM2Cooldown == true then
                return true, true, "m2-priority-m1-attacker-cooldown", "attacker.M2Cooldown", false
            end
            if attackType == "M1" then
                return false, false, "m2-priority-m1-reserve-block",
                    attackerM2Cooldown == false and "attacker.M2Cooldown=false"
                    or "attacker.M2Cooldown=unknown", true
            end
            return false, false, "attack-type", "attack-type", false
        end
        return false, false, "evasive-mode-none", "mode", false
    end

    function R:_evasivePolicy(item, front)
        local mode = tostring(Options.EvasiveMode and Options.EvasiveMode.Value or "None")
        local autoDodge = Toggles.AutoDodge and Toggles.AutoDodge.Value == true
        local rearThreshold = math.cos(math.rad(
            tonumber(Options.DodgeAngle and Options.DodgeAngle.Value) or 60
        ))
        local rearAttack = (tonumber(front) or 1) < rearThreshold
        local rearEnabled = Toggles.CanDodgeRearAttacks
            and Toggles.CanDodgeRearAttacks.Value == true
        local attackerM2Cooldown = item.model and item.model:GetAttribute("M2Cooldown")
        local requested, mandatory, reason, source, emergencyEligible = self:_evasivePolicyFor(
            autoDodge,
            mode,
            item.attackType,
            attackerM2Cooldown,
            rearAttack,
            rearEnabled
        )
        return requested, mandatory, reason, source, rearAttack, attackerM2Cooldown,
            emergencyEligible
    end

