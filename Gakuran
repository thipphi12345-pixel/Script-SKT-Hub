    function R:_ensureLogger()
        if not Logger and createLoggerWindow then
            local ok, value = pcall(createLoggerWindow)
            if ok then Logger = value end
        end
        if Logger and Logger.frame then Logger.frame.Visible = self:IsLoggerEnabled() end
        return Logger
    end

    function R:OnAnimation(model, track)
        if not self.WatchRunning or not model or not track then return end
        local animation
        local okAnimation = pcall(function() animation = track.Animation end)
        if not okAnimation or not animation then return end
        local id = parseAnimId(animation.AnimationId)
        if not id then return end
        local distance = distanceToModel(model)
        local category, animationName = "Action", animation.Name or "Animation"
        pcall(function() category, animationName = classifyAnim(track, animation) end)

        if self:IsLoggerEnabled() then
            local rangeEnabled = Toggles.LoggerRangeOn and Toggles.LoggerRangeOn.Value
            local captureRange = tonumber(Options.LoggerRange and Options.LoggerRange.Value) or 50
            if (not rangeEnabled or distance == nil or distance <= captureRange)
                and not Config.blacklist[id] then
                local key = tostring(model) .. "|" .. id
                local now = os.clock()
                if not recentLog[key] or now - recentLog[key] > 0.5 then
                    recentLog[key] = now
                    recentLogSweep += 1
                    if recentLogSweep >= 200 then
                        recentLogSweep = 0
                        for recentKey, timestamp in pairs(recentLog) do
                            if now - timestamp > 5 then recentLog[recentKey] = nil end
                        end
                    end
                    local logger = self:_ensureLogger()
                    if logger then
                        local sourceLabel, sourceType = getSourceInfo(model)
                        pcall(logger.addRow, logger, id, animationName, sourceLabel, sourceType, category)
                    end
                end
            end
        end

        if not self.CombatRunning or not self:IsAutoEnabled() then return end
        local looped = false
        pcall(function() looped = track.Looped == true end)
        if looped or category == "Movement" then return end
        local interest = (tonumber(Options.MaxRange and Options.MaxRange.Value) or 10) + 12
        if distance and distance > interest then return end
        local detectedAt = os.clock()
        self.DetectedThreats += 1
        self.LastPipeline = "detected-animation"
        self.StatusDirty = true
        local db = AttackDB[id]
        local attackType = db and (db.kind == "M2" or db.kind == "M2M") and "M2" or "M1"
        local position, speed = 0, 1
        pcall(function()
            position = tonumber(track.TimePosition) or 0
            speed = math.abs(tonumber(track.Speed) or 1)
        end)
        local watcher = self.Watchers[model]
        local tokenEvent = watcher and watcher.lastTokenEvent
        if tokenEvent and detectedAt - tokenEvent.createdAt <= self.TokenAnimationMatchSeconds then
            self:_diagnosticRecord("token-animation-match", {
                id = id,
                model = model,
                attackType = attackType,
                source = "Animation",
                sourceClass = "animation",
                comboIndex = tokenEvent.comboIndex,
                track = track,
            }, {
                actionToken = tokenEvent.identity,
                tokenToAnimationMs = (detectedAt - tokenEvent.createdAt) * 1000,
            })
            watcher.lastTokenEvent = nil
        end
        self:Emit({
            id = id,
            model = model,
            player = Players:GetPlayerFromCharacter(model),
            attackType = attackType,
            sourceClass = "animation",
            source = "Animation",
            identity = tostring(track) .. ":" .. id,
            track = track,
            comboIndex = self:_actualComboIndex(model),
            detectedAt = detectedAt,
            startedAt = detectedAt - (speed > 0 and position / speed or 0),
        })
    end

    function R:OnAttribute(model, attribute, requestedType, active)
        if not self.CombatRunning or not model or active ~= true then return end
        local now = os.clock()
        self.StatusDirty = true
        local attackType = requestedType
        if attackType ~= "M1" and attackType ~= "M2" then
            attackType = model:GetAttribute("M2") == true and "M2" or "M1"
        end
        if (self.ActiveEngine == "Fusion") and attackType == "M1" then
            local recent = self.RecentOutcomeAt[model]
            local age = recent and now - (tonumber(recent.at) or now) or math.huge
            if recent and recent.attackType == "M1"
                and age >= 0 and age <= self.FusionAttributeOutcomeGuard then
                self.LastPipeline = "attribute-suppressed"
                self:_diagnosticRecord("attribute-suppressed", {
                    model = model,
                    attackType = attackType,
                    source = attribute,
                    sourceClass = "attribute",
                }, {
                    reason = "post-outcome-echo",
                    outcomeAgeMs = age * 1000,
                    guardWindowMs = self.FusionAttributeOutcomeGuard * 1000,
                })
                return
            end
        end
        self.DetectedThreats += 1
        self.LastPipeline = "detected-" .. tostring(attribute)
        self:Emit({
            model = model,
            player = Players:GetPlayerFromCharacter(model),
            attackType = attackType,
            sourceClass = "attribute",
            source = attribute,
            identity = attribute,
            comboIndex = attackType == "M1" and self:_actualComboIndex(model) or nil,
            detectedAt = now,
            startedAt = now,
        })
    end

    function R:_tokenAttackSignal(candidate)
        local model = candidate.model
        if not model or not model.Parent
            or model:GetAttribute("Blocking") == true
            or model:GetAttribute("PerfectBlocking") == true then
            return nil
        end
        if model:GetAttribute("M2") == true then return "M2", "M2" end
        if model:GetAttribute("PendingM2") == true then return "M2", "PendingM2" end
        if model:GetAttribute("WrestlingM2Attempting") == true then
            return "M2", "WrestlingM2Attempting"
        end
        local lastM2CooldownAt = candidate.data and candidate.data.lastM2CooldownAt
        if lastM2CooldownAt
            and math.abs(lastM2CooldownAt - candidate.createdAt) <= self.TokenReclassifySeconds then
            return "M2", "M2Cooldown"
        end
        if model:GetAttribute("M1") == true then return "M1", "M1" end
        if model:GetAttribute("PendingM1") == true then return "M1", "PendingM1" end
        if model:GetAttribute("CombatAttacking") == true then return "M1", "CombatAttacking" end
        return nil
    end

    function R:_queueActionToken(data)
        local model = data and data.model
        if not self.CombatRunning or not model or not model.Parent then return end
        local tokenValue = model:GetAttribute("CombatToken")
        if tokenValue == data.combatToken then return end
        data.combatToken = tokenValue
        if data.tokenCandidate then data.tokenCandidate.cancelled = true end
        data.tokenCandidate = nil
        if tokenValue == nil or tokenValue == "" then return end

        local now = os.clock()
        local candidate = {
            model = model,
            data = data,
            identity = tostring(tokenValue),
            source = "CombatToken",
            sourceClass = "combattoken",
            comboIndex = self:_actualComboIndex(model),
            createdAt = now,
            expiresAt = now + self.TokenReclassifySeconds,
            generation = self.Generation,
            attemptedType = nil,
            emittedType = nil,
            cancelled = false,
        }
        data.tokenCandidate = candidate
        data.lastTokenEvent = candidate
        self.TokenCandidates[#self.TokenCandidates + 1] = candidate
        self:_diagnosticRecord("token-received", candidate, {
            actionToken = candidate.identity,
            reclassifyWindowMs = self.TokenReclassifySeconds * 1000,
        })
    end

    function R:_tickTokenCandidates(now)
        for index = #self.TokenCandidates, 1, -1 do
            local candidate = self.TokenCandidates[index]
            local data = candidate and candidate.data
            local remove = not candidate
                or candidate.cancelled
                or candidate.generation ~= self.Generation
                or not candidate.model
                or not candidate.model.Parent
                or not data
                or data.tokenCandidate ~= candidate
            if not remove then
                local attackType, signal = self:_tokenAttackSignal(candidate)
                if attackType == "M2" and candidate.attemptedType ~= "M2" then
                    local reclassified = candidate.attemptedType == "M1"
                    candidate.attemptedType = "M2"
                    self.DetectedThreats += 1
                    self.LastPipeline = "detected-token-M2"
                    self.StatusDirty = true
                    local accepted = self:Emit({
                        model = candidate.model,
                        player = Players:GetPlayerFromCharacter(candidate.model),
                        attackType = "M2",
                        sourceClass = "token",
                        source = "CombatToken/" .. tostring(signal),
                        identity = "token:" .. candidate.identity .. ":M2",
                        comboIndex = candidate.comboIndex,
                        detectedAt = now,
                        startedAt = candidate.createdAt,
                    })
                    if accepted then candidate.emittedType = "M2" end
                    self:_diagnosticRecord("token-classified", candidate, {
                        actionToken = candidate.identity,
                        attackType = "M2",
                        signal = signal,
                        reclassifiedFromM1 = reclassified,
                        claimAccepted = accepted == true,
                        classifyLatencyMs = (now - candidate.createdAt) * 1000,
                    })
                    remove = true
                elseif attackType == "M1" and not candidate.attemptedType then
                    candidate.attemptedType = "M1"
                    self.DetectedThreats += 1
                    self.LastPipeline = "detected-token-M1"
                    self.StatusDirty = true
                    local accepted = self:Emit({
                        model = candidate.model,
                        player = Players:GetPlayerFromCharacter(candidate.model),
                        attackType = "M1",
                        sourceClass = "token",
                        source = "CombatToken/" .. tostring(signal),
                        identity = "token:" .. candidate.identity .. ":M1",
                        comboIndex = candidate.comboIndex,
                        detectedAt = now,
                        startedAt = candidate.createdAt,
                    })
                    if accepted then candidate.emittedType = "M1" end
                    self:_diagnosticRecord("token-classified", candidate, {
                        actionToken = candidate.identity,
                        attackType = "M1",
                        signal = signal,
                        provisional = true,
                        claimAccepted = accepted == true,
                        classifyLatencyMs = (now - candidate.createdAt) * 1000,
                    })
                end
                if now >= candidate.expiresAt then
                    if not candidate.attemptedType then
                        self:_diagnosticRecord("token-discarded", candidate, {
                            actionToken = candidate.identity,
                            reason = "no-offensive-signal",
                        })
                    end
                    remove = true
                end
            end
            if remove then
                if data and data.tokenCandidate == candidate then data.tokenCandidate = nil end
                table.remove(self.TokenCandidates, index)
            end
        end
    end

    function R:_bindModelCombat(data)
        if not self.CombatRunning or not data or data.combatBound then return end
        local model = data.model
        if not model or not model.Parent then return end
        data.combatBound = true
        data.combatConnections = data.combatConnections or {}
        data.lastM2CooldownAt = nil
        for _, spec in ipairs({
            { "CombatAttacking", nil },
            { "M1", "M1" },
            { "PendingM1", "M1" },
            { "M2", "M2" },
            { "PendingM2", "M2" },
            { "WrestlingM2Attempting", "M2" },
        }) do
            local attribute, attackType = spec[1], spec[2]
            data.combatConnections[#data.combatConnections + 1] =
                model:GetAttributeChangedSignal(attribute):Connect(function()
                    local active = model:GetAttribute(attribute) == true
                    if R.CombatRunning and active then
                        R.AttributeQueue[#R.AttributeQueue + 1] = {
                            model = model,
                            attribute = attribute,
                            attackType = attackType,
                            active = active,
                        }
                    end
                end)
        end
        data.combatConnections[#data.combatConnections + 1] =
            model:GetAttributeChangedSignal("CombatToken"):Connect(function()
                if R.CombatRunning then R:_queueActionToken(data) end
            end)
        data.combatConnections[#data.combatConnections + 1] =
            model:GetAttributeChangedSignal("M2Cooldown"):Connect(function()
                if R.CombatRunning and model:GetAttribute("M2Cooldown") == true then
                    local now = os.clock()
                    data.lastM2CooldownAt = now
                    if (R:Engine() == "Fusion") and R:IsAutoEnabled() then
                        data.m2CooldownSequence = (data.m2CooldownSequence or 0) + 1
                        R.DetectedThreats += 1
                        R.LastPipeline = "detected-M2Cooldown"
                        R.StatusDirty = true
                        R:Emit({
                            model = model,
                            player = Players:GetPlayerFromCharacter(model),
                            attackType = "M2",
                            sourceClass = "token",
                            source = "M2Cooldown",
                            identity = "m2cooldown:" .. tostring(data.m2CooldownSequence),
                            detectedAt = now,
                            startedAt = now,
                        })
                    end
                end
            end)
    end

    function R:_unbindModelCombat(data)
        if not data then return end
        if data.tokenCandidate then data.tokenCandidate.cancelled = true end
        data.tokenCandidate = nil
        data.lastTokenEvent = nil
        data.combatToken = nil
        data.lastM2CooldownAt = nil
        data.m2CooldownSequence = nil
        self:_clearConnections(data.combatConnections or {})
        data.combatBound = false
    end

    function R:_hookAnimator(data, animator)
        if not data or data.animator == animator or not animator then return end
        if data.animatorConnection then self:_disconnect(data.animatorConnection) end
        data.animator = animator
        data.playing = setmetatable({}, { __mode = "k" })
        self.PollElapsed = math.max(self.PollElapsed, 0.75)
        data.animatorConnection = animator.AnimationPlayed:Connect(function(track)
            if not R.WatchRunning then return end
            data.playing[track] = true
            R.AnimationQueue[#R.AnimationQueue + 1] = {
                model = data.model,
                track = track,
            }
        end)
        data.connections[#data.connections + 1] = data.animatorConnection
    end

    function R:_unwatch(model)
        local data = self.Watchers[model]
        if not data then return end
        self:_unbindModelCombat(data)
        self:_clearConnections(data.connections)
        self.Watchers[model] = nil
        local index = data.index
        local last = self.WatcherList[#self.WatcherList]
        self.WatcherList[#self.WatcherList] = nil
        if last and last ~= data and index then
            self.WatcherList[index] = last
            last.index = index
        end
        if self.PollCursor > #self.WatcherList then self.PollCursor = 1 end
    end

    function R:_watchModel(model)
        if not self.WatchRunning or not model or self.Watchers[model]
            or model == LocalPlayer.Character or not model:IsA("Model") then return end
        local humanoid = model:FindFirstChildOfClass("Humanoid")
        if not humanoid then return end
        local data = {
            model = model,
            humanoid = humanoid,
            animator = nil,
            animatorConnection = nil,
            connections = {},
            combatConnections = {},
            combatBound = false,
            combatToken = nil,
            lastM2CooldownAt = nil,
            tokenCandidate = nil,
            lastTokenEvent = nil,
            playing = setmetatable({}, { __mode = "k" }),
        }
        self.Watchers[model] = data
        data.index = #self.WatcherList + 1
        self.WatcherList[data.index] = data
        local animator = humanoid:FindFirstChildOfClass("Animator")
        if animator then self:_hookAnimator(data, animator) end
        data.connections[#data.connections + 1] = humanoid.ChildAdded:Connect(function(child)
            if child:IsA("Animator") and R.WatchRunning then R:_hookAnimator(data, child) end
        end)
        data.connections[#data.connections + 1] = humanoid.AnimationPlayed:Connect(function(track)
            if not R.WatchRunning then return end
            data.playing[track] = true
            R.AnimationQueue[#R.AnimationQueue + 1] = {
                model = model,
                track = track,
            }
        end)
        data.connections[#data.connections + 1] = model.AncestryChanged:Connect(function(_, parent)
            if parent == nil then R:_unwatch(model) end
        end)
        if self.CombatRunning then self:_bindModelCombat(data) end
    end

    function R:_enqueueScan(instance)
        if not instance or self.ScanSeen[instance] then return end
        self.ScanSeen[instance] = true
        self.ScanQueue[#self.ScanQueue + 1] = instance
    end

    function R:_resetScan()
        table.clear(self.ScanQueue)
        self.ScanHead = 1
        self.ScanSeen = setmetatable({}, { __mode = "k" })
        local playersFolder = game:GetService("Workspace"):FindFirstChild("Players")
        if playersFolder then
            local nearby = playersFolder:GetChildren()
            table.sort(nearby, function(a, b)
                return (distanceToModel(a) or math.huge) < (distanceToModel(b) or math.huge)
            end)
            for _, child in ipairs(nearby) do self:_enqueueScan(child) end
            self:_enqueueScan(playersFolder)
        end
        for _, child in ipairs(Workspace:GetChildren()) do
            if child ~= playersFolder then self:_enqueueScan(child) end
        end
    end

    function R:_processScan(limit)
        limit = limit or 48
        local processed = 0
        while processed < limit and self.ScanHead <= #self.ScanQueue do
            local instance = self.ScanQueue[self.ScanHead]
            self.ScanHead += 1
            processed += 1
            if instance and instance.Parent then
                local watchedModel = instance:IsA("Model") and instance:FindFirstChildOfClass("Humanoid")
                if watchedModel then
                    self:_watchModel(instance)
                elseif instance:IsA("Folder") or instance:IsA("Model") then
                    for _, child in ipairs(instance:GetChildren()) do self:_enqueueScan(child) end
                end
            end
        end
        if self.ScanHead > #self.ScanQueue then
            table.clear(self.ScanQueue)
            self.ScanHead = 1
            self.ScanSeen = setmetatable({}, { __mode = "k" })
        end
    end

    function R:_onGakuranHitboxAdded(hitbox)
        if not self:IsAutoEnabled() then return end
        local pos = hitbox.Position
        
        -- Identify attacker by proximity to hitbox
        local closestEnemy = nil
        local closestDist = math.huge
        for _, model in ipairs(self.Claims) do
            if type(model) == "table" and model.model then model = model.model end
            if model and model.Parent and model ~= LocalPlayer.Character then
                local root = model:FindFirstChild("HumanoidRootPart")
                if root then
                    local dist = (root.Position - pos).Magnitude
                    if dist < closestDist then
                        closestDist = dist
                        closestEnemy = model
                    end
                end
            end
        end
        
        if closestEnemy and closestDist <= 15 then
            local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if myRoot then
                local distToMe = (myRoot.Position - pos).Magnitude
                local velocity = hitbox.AssemblyLinearVelocity
                local speed = velocity.Magnitude
                
                -- Sweet spot timing
                local contactIn = 0.05
                if speed > 10 then
                    contactIn = distToMe / speed
                end
                
                local delayTime = math.max(0, contactIn - 0.05)
                
                task.delay(delayTime, function()
                    local remote = self:_directServerRemote()
                    if remote then
                        -- Sweet spot block
                        self:_fireRemoteBlock(remote, true)
                        -- Machine-gun fast unblock (ready for next flurry)
                        task.delay(0.1, function()
                            self:_fireRemoteBlock(remote, false)
                        end)
                    end
                end)
            end
        end
    end

    function R:_processAnimations(limit)
        limit = limit or 48
        local processed = 0
        while processed < limit and self.AnimationHead <= #self.AnimationQueue do
            local entry = self.AnimationQueue[self.AnimationHead]
            self.AnimationHead += 1
            processed += 1
            if entry and entry.model and entry.model.Parent and entry.track then
                self:OnAnimation(entry.model, entry.track)
            end
        end
        if self.AnimationHead > #self.AnimationQueue then
            table.clear(self.AnimationQueue)
            self.AnimationHead = 1
        end
    end

    function R:_processAttributes(limit)
        limit = limit or 32
        local processed = 0
        while processed < limit and self.AttributeHead <= #self.AttributeQueue do
            local entry = self.AttributeQueue[self.AttributeHead]
            self.AttributeHead += 1
            processed += 1
            if self.CombatRunning and entry and entry.model and entry.model.Parent then
                self:OnAttribute(entry.model, entry.attribute, entry.attackType, entry.active)
            end
        end
        if self.AttributeHead > #self.AttributeQueue then
            table.clear(self.AttributeQueue)
            self.AttributeHead = 1
        end
    end

    function R:_pollWatched()
        local total = #self.WatcherList
        if total == 0 then return end
        local count = math.min(8, total)
        for _ = 1, count do
            if self.PollCursor > #self.WatcherList then self.PollCursor = 1 end
            local data = self.WatcherList[self.PollCursor]
            self.PollCursor += 1
            if data and data.model.Parent and data.animator then
                local ok, tracks = pcall(data.animator.GetPlayingAnimationTracks, data.animator)
                if ok and type(tracks) == "table" then
                    -- Reuse a scratch set instead of allocating a new weak
                    -- table per model per poll (~250 allocs/sec in combat).
                    local playing = data._pollScratch
                    if playing then table.clear(playing) else
                        playing = setmetatable({}, { __mode = "k" })
                        data._pollScratch = playing
                    end
                    for _, track in ipairs(tracks) do
                        playing[track] = true
                        if not data.playing[track] then
                            data.playing[track] = true
                            self.AnimationQueue[#self.AnimationQueue + 1] = {
                                model = data.model,
                                track = track,
                            }
                        end
                    end
                    data.playing = playing
                end
            elseif data then
                self:_unwatch(data.model)
            end
        end
    end

    function R:_characterFromValue(value, seen, depth)
        if value == nil then return nil end
        if typeof(value) == "Instance" then
            if value:IsA("Player") then return value.Character end
            if value:IsA("Model") and (value:FindFirstChildOfClass("Humanoid")
                or value:FindFirstChild("HumanoidRootPart")) then return value end
            if value:IsA("BasePart") then
                local model = value:FindFirstAncestorOfClass("Model")
                if model and (model:FindFirstChildOfClass("Humanoid")
                    or model:FindFirstChild("HumanoidRootPart")) then return model end
            end
            return nil
        end
        if type(value) == "string" then
            local player = self:_resolvePlayer(value)
            if player and player.Character then return player.Character end
            for _, data in ipairs(self.WatcherList) do
                if data.model and data.model.Parent and data.model.Name == value then
                    return data.model
                end
            end
            local playersFolder = game:GetService("Workspace"):FindFirstChild("Players")
            local model = playersFolder and playersFolder:FindFirstChild(value)
            if model and model:IsA("Model") and (model:FindFirstChildOfClass("Humanoid")
                or model:FindFirstChild("HumanoidRootPart")) then return model end
            return nil
        end
        if type(value) ~= "table" then return nil end
        depth = depth or 0
        if depth >= 3 then return nil end
        seen = seen or {}
        if seen[value] then return nil end
        seen[value] = true
        for _, key in ipairs({
            "Character", "character", "Char", "char", "Attacker", "attacker",
            "Target", "target", "Victim", "victim", "Model", "model",
        }) do
            local model = self:_characterFromValue(rawget(value, key), seen, depth + 1)
            if model then return model end
        end
        local inspected = 0
        for _, nested in pairs(value) do
            inspected += 1
            if inspected > 24 then break end
            local model = self:_characterFromValue(nested, seen, depth + 1)
            if model then return model end
        end
        return nil
    end

    function R:_collectCharacters(...)
        local output, included = {}, {}
        local args = table.pack(...)
        for index = 1, args.n do
            local model = self:_characterFromValue(args[index])
            if model and not included[model] then
                included[model] = true
                output[#output + 1] = model
            end
        end
        return output
    end

    function R:_observeSpecialCombatEvent(eventName, ...)
        if not self.CombatRunning then return false end
        if eventName == "CapoeiraM2WindStart" or eventName == "CapoeiraM2WindEnd" then
            local attacker
            for _, model in ipairs(self:_collectCharacters(...)) do
                if model ~= LocalPlayer.Character then attacker = model; break end
            end
            if not attacker then return false end
            local ending = eventName == "CapoeiraM2WindEnd"
            local now = os.clock()
            self:Emit({
                model = attacker,
                player = Players:GetPlayerFromCharacter(attacker),
                attackType = "M2",
                sourceClass = "special",
                source = eventName,
                identity = ending and "CapoeiraM2WindEnd" or "CapoeiraM2Wind",
                detectedAt = now,
                startedAt = now,
                windupSeconds = ending and 0.05
                    or 0.55 / math.max(0.05, attackSpeedFor(attacker)),
                isCapoeira = true,
                isCapoeiraEnd = ending or nil,
            })
            return true
        end
        if eventName == "WrestlingM2GrabStart" then
            local localCharacter = LocalPlayer.Character
            local attacker, targetsLocal = nil, false
            for _, model in ipairs(self:_collectCharacters(...)) do
                if model == localCharacter then targetsLocal = true
                elseif not attacker then attacker = model end
            end
            if not targetsLocal or not attacker then return false end
            local now = os.clock()
            self:Emit({
                model = attacker,
                player = Players:GetPlayerFromCharacter(attacker),
                attackType = "M2",
                sourceClass = "special",
                source = "WrestlingM2GrabStart",
                identity = "WrestlingM2GrabStart",
                detectedAt = now,
                startedAt = now,
                windupSeconds = 0.15,
                isWrestlingGrab = true,
                priority = 4,
            })
            return true
        end
        if eventName == "WrestlingM2GrabEnd" then
            -- Grab ended without slam — cancel any pending WrestlingGrab threat
            local localCharacter = LocalPlayer.Character
            for _, model in ipairs(self:_collectCharacters(...)) do
                if model == localCharacter then
                    for i = #self.Pending, 1, -1 do
                        local item = self.Pending[i]
                        if item.isWrestlingGrab then
                            self:_diagnosticRecord("cancelled", item, { reason = "WrestlingM2GrabEnd" })
                            self:_cancelItem(item)
                            table.remove(self.Pending, i)
                        end
                    end
                    break
                end
            end
            return true
        end
        if eventName == "WrestlingM2SlamCrater" then
            -- Wrestling slam impact — emit a short-window threat so we can evasive
            local localCharacter = LocalPlayer.Character
            local attacker, targetsLocal = nil, false
            for _, model in ipairs(self:_collectCharacters(...)) do
                if model == localCharacter then targetsLocal = true
                elseif not attacker then attacker = model end
            end
            if not targetsLocal or not attacker then return false end
            local now = os.clock()
            self:Emit({
                model = attacker,
                player = Players:GetPlayerFromCharacter(attacker),
                attackType = "M2",
                sourceClass = "special",
                source = "WrestlingM2SlamCrater",
                identity = "WrestlingM2SlamCrater",
                detectedAt = now,
                startedAt = now,
                windupSeconds = 0.10,
                isWrestlingSlam = true,
                priority = 5,
            })
            return true
        end
        if eventName == "KureM2Slam" then
            -- Kure slam impact — emit a short-window threat so we can evasive
            local localCharacter = LocalPlayer.Character
            local attacker, targetsLocal = nil, false
            for _, model in ipairs(self:_collectCharacters(...)) do
                if model == localCharacter then targetsLocal = true
                elseif not attacker then attacker = model end
            end
            if not targetsLocal or not attacker then return false end
            local now = os.clock()
            self:Emit({
                model = attacker,
                player = Players:GetPlayerFromCharacter(attacker),
                attackType = "M2",
                sourceClass = "special",
                source = "KureM2Slam",
                identity = "KureM2Slam",
                detectedAt = now,
                startedAt = now,
                windupSeconds = 0.10,
                isKureSlam = true,
                priority = 5,
            })
            return true
        end
        return false
    end

    function R:_observeCombatEvent(eventName, ...)
        if not self.CombatRunning or type(eventName) ~= "string" then return false end
        local args = table.pack(...)
        local token = args.n >= 3 and args[3] or nil
        local tokenType = type(token)
        local tokenKey = (tokenType == "string" or tokenType == "number")
            and eventName .. "\0" .. tostring(token) or nil
        local now = os.clock()
        local previous = tokenKey and self.CombatEventTokens[tokenKey] or nil
        if previous and now - previous < 2 then return false end

        local handled = self:_observeSpecialCombatEvent(eventName, table.unpack(args, 1, args.n))
        handled = self:_observeOutcome(eventName, table.unpack(args, 1, args.n)) or handled
        if handled and tokenKey then
            self.CombatEventTokens[tokenKey] = now
            if now - self.CombatEventTokenSweepAt >= 2 then
                self.CombatEventTokenSweepAt = now
                local cutoff = now - 3
                for key, timestamp in pairs(self.CombatEventTokens) do
                    if timestamp < cutoff then self.CombatEventTokens[key] = nil end
                end
            end
        end
        return handled
    end

    function R:_bindLocalCharacter(character)
        self:_clearConnections(self.LocalConnections or {})
        self.LocalConnections = {}
        _cachedBlockMod = nil
        _cachedEvasiveMod = nil
        self:_releaseBlock("character-rebind")
        if not character then return end
        self.LastQualifiedThreat = nil
        if self.AliCounterCharacter ~= character then
            self.AliCounterCharacter = character
            self.AliCounterReadyAt = 0
            self.AliCounterSource = "character-rebind-initial-ready"
        end
        local function warmCombatModules()
            if not R.CombatRunning then return end
            Library._Performance:RefreshGCFor("parry")
            pcall(getBlockModule)
            pcall(getCombatUtils)
            if (Toggles.AutoDodge and Toggles.AutoDodge.Value)
                or tostring(Options.EvasiveMode and Options.EvasiveMode.Value or "None") ~= "None" then
                pcall(getEvasiveModule)
            end
        end
        local function invalidateCombatModules()
            _cachedBlockMod = nil
            _cachedEvasiveMod = nil
            task.defer(warmCombatModules)
        end
        task.defer(warmCombatModules)
        local humanoid = character:FindFirstChildOfClass("Humanoid")
            or character:WaitForChild("Humanoid", 5)
        if humanoid then
            local lastHealth = humanoid.Health
            self.LocalConnections[#self.LocalConnections + 1] = humanoid.HealthChanged:Connect(function(health)
                if health < lastHealth and R.CombatRunning then
                    local now = os.clock()
                    R:_diagnosticDamage(lastHealth, health)
                    local attempt, candidateCount = R:_findAttempt(nil, true)
                    local isFusionLike = attempt and (attempt.engine == "Fusion" or attempt.engine == "Phantom" or attempt.engine == "Apex")
                    local fusionCorrelation = not attempt
                        or not isFusionLike
                        or candidateCount == 1
                    local impactWindow = isFusionLike and 0.30 or 0.40
                    if attempt and attempt.predictedImpactAt and fusionCorrelation
                        and math.abs(now - attempt.predictedImpactAt) <= impactWindow then
                        attempt.healthHitAt = now
                        attempt.healthHitBlocking = character:GetAttribute("Blocking") == true
                        attempt.healthCorrelationCandidates = candidateCount
                    elseif attempt and isFusionLike and not fusionCorrelation then
                        R:_diagnosticRecord("health-learning-skipped", attempt, {
                            reason = "ambiguous-attempts",
                            candidateCount = candidateCount,
                        })
                    end
                    local activeAttempt = R.Block.attempt
                    local confirmedEngine = activeAttempt and (activeAttempt.engine == "Fusion" or activeAttempt.engine == "Phantom" or activeAttempt.engine == "Apex")
                    if confirmedEngine and R.Block.method == "Remote" and R.Block.active then
                        R:_releaseBlock("damage-taken")
                    end
                end
                lastHealth = health
            end)
        end
        local previousCombatAttribute = {
            Blocking = character:GetAttribute("Blocking") == true,
            PerfectBlocking = character:GetAttribute("PerfectBlocking") == true,
            ParryBuffered = character:GetAttribute("ParryBuffered") == true,
            BlockCooldown = character:GetAttribute("BlockCooldown") == true,
        }
        local function recordCombatAttribute(attribute)
            local value = character:GetAttribute(attribute) == true
            local previous = previousCombatAttribute[attribute]
            previousCombatAttribute[attribute] = value
            if not R.DiagnosticEnabled then return end
            local now = os.clock()
            local attempt = R.Block.attempt or R:_findAttempt(nil, true)
            R:_diagnosticRecord("local-attribute", attempt or {}, {
                attribute = attribute,
                previousValue = previous,
                value = value,
                sinceBlockCommandMs = R.Block.lastCommandAt > 0
                    and (now - R.Block.lastCommandAt) * 1000 or nil,
                sinceBlockReleaseMs = R.Block.lastReleaseAt > 0
                    and (now - R.Block.lastReleaseAt) * 1000 or nil,
            })
        end
        local function noteRemoteAttribute(attribute, value)
            local block = R.Block
            if not block.active or block.method ~= "Remote" then return end
            if attribute == "Blocking" then
                if not value then block.blockingSawFalse = true end
            elseif attribute == "PerfectBlocking" then
                if not value then block.perfectSawFalse = true end
            elseif attribute == "ParryBuffered" then
                if value and not block.softPending then
                    R:_diagnosticRecord("block-pending", block.attempt or {}, {
                        source = "ParryBuffered",
                        hardConfirmed = block.confirmed,
                    })
                end
                block.softPending = value
                return
            else
                return
            end
            if not value and character:GetAttribute("Blocking") ~= true
                and character:GetAttribute("PerfectBlocking") ~= true then
                R:_resetRemoteConfirmation("attributes-cleared")
            end
            local fresh = value and ((attribute == "Blocking" and block.blockingSawFalse)
                or (attribute == "PerfectBlocking" and block.perfectSawFalse))
            if fresh then
                block.confirmed = true
                block.confirmationFailed = false
                R:_refreshPauseM1()
                R:_diagnosticRecord("block-confirmed", block.attempt or {}, {
                    source = attribute,
                    retries = block.retryCount,
                    baselineBlocking = block.baselineBlocking,
                    baselinePerfectBlocking = block.baselinePerfectBlocking,
                })
            end
        end
        self.LocalConnections[#self.LocalConnections + 1] =
            character:GetAttributeChangedSignal("Blocking"):Connect(function()
                recordCombatAttribute("Blocking")
                local block = R.Block
                local value = character:GetAttribute("Blocking") == true
                noteRemoteAttribute("Blocking", value)
                if not value or not block.pressedAt or block.activationCaptured then return end
                local now = os.clock()
                local network = math.clamp(R.PingEMA * 0.5, 0, 0.10)
                local sample = math.clamp(now - block.pressedAt - network, 0, 0.08)
                block.activationCaptured = true
                block.activationSamples += 1
                local alpha = block.activationSamples < 4 and 0.35 or 0.15
                block.activationEMA += (sample - block.activationEMA) * alpha
                local attempt = block.attempt
                if not attempt or attempt.cancelled or attempt.resolved then
                    attempt = R:_findAttempt(nil, true)
                end
                if attempt then
                    attempt.activationAt = now
                    R:_diagnosticRecord("block-activated", attempt, {
                        activationLatencyMs = (now - block.pressedAt) * 1000,
                        activationCompensationMs = sample * 1000,
                    })
                end
            end)
        for _, attribute in ipairs({ "PerfectBlocking", "ParryBuffered", "BlockCooldown" }) do
            self.LocalConnections[#self.LocalConnections + 1] =
                character:GetAttributeChangedSignal(attribute):Connect(function()
                    recordCombatAttribute(attribute)
                    local value = character:GetAttribute(attribute) == true
                    noteRemoteAttribute(attribute, value)
                    if attribute == "PerfectBlocking"
                        and value
                        and R.Block.attempt
                        and (R.Block.attempt.engine == "Fusion" or R.Block.attempt.engine == "Phantom" or R.Block.attempt.engine == "Apex")
                        and R.Block.confirmed
                        and R.Block.active and R.Block.method == "Remote" then
                        local attempt = R.Block.attempt
                        if attempt and attempt.profile
                            and attempt.profile.attackType == "M1"
                            and attempt.predictedImpactAt then
                            local styleKey = string.lower(tostring(attempt.styleKey or ""))
                            local recovery = styleKey == "boxing"
                                and R.ReactiveDecision.BoxingM1Recovery
                                or R.ReactiveDecision.M1Recovery
                            local now = os.clock()
                            R.Block.releaseAt = math.max(
                                now + 0.04,
                                attempt.predictedImpactAt + recovery
                            )
                            R:_diagnosticRecord("perfect-release-aligned", attempt, {
                                releaseInMs = (R.Block.releaseAt - now) * 1000,
                            })
                        end
                    end
                end)
        end
        local boundPlayerData = setmetatable({}, { __mode = "k" })
        local function bindPlayerData(playerData)
            if not playerData or boundPlayerData[playerData] then return end
            boundPlayerData[playerData] = true
            for _, attribute in ipairs({ "CombatType", "CombatStyle" }) do
                R.LocalConnections[#R.LocalConnections + 1] =
                    playerData:GetAttributeChangedSignal(attribute):Connect(invalidateCombatModules)
            end
        end
        bindPlayerData(character:FindFirstChild("PlayerData"))
        bindPlayerData(LocalPlayer:FindFirstChild("PlayerData"))
        R.LocalConnections[#R.LocalConnections + 1] =
            character:GetAttributeChangedSignal("CombatStyle"):Connect(invalidateCombatModules)
        R.LocalConnections[#R.LocalConnections + 1] =
            LocalPlayer:GetAttributeChangedSignal("CombatStyle"):Connect(invalidateCombatModules)
        self.LocalConnections[#self.LocalConnections + 1] = character.ChildAdded:Connect(function(child)
            if child.Name == "PlayerData" then bindPlayerData(child) end
        end)
        self.LocalConnections[#self.LocalConnections + 1] = character.ChildRemoved:Connect(function(child)
            if child.Name == "PlayerData" then invalidateCombatModules() end
        end)
        self.LocalConnections[#self.LocalConnections + 1] = LocalPlayer.ChildAdded:Connect(function(child)
            if child.Name == "PlayerData" then bindPlayerData(child) end
        end)
        self.LocalConnections[#self.LocalConnections + 1] = LocalPlayer.ChildRemoved:Connect(function(child)
            if child.Name == "PlayerData" then invalidateCombatModules() end
        end)
    end

    function R:_receiveCombatBroadcast(channel, eventName, ...)
        if type(eventName) ~= "string" then return end
        self:_recordCombatObservation(channel, eventName, ...)
        self:_observeAliCounter(channel, eventName, ...)
        if self.CombatRunning then self:_observeCombatEvent(eventName, ...) end
    end

    function R:_disconnectCombatObserver()
        self:_clearConnections(self.ObserverConnections)
    end

    function R:_connectOutcome()
        if #self.ObserverConnections > 0 then return true end
        local shared = ReplicatedStorage:FindFirstChild("Shared")
        local network = shared and shared:FindFirstChild("Network")
        if not network then return false end
        local function connect(remote, callback)
            if not remote then return end
            local ok, connection = pcall(function()
                return remote.OnClientEvent:Connect(callback)
            end)
            if ok and connection then
                self.ObserverConnections[#self.ObserverConnections + 1] = connection
            end
        end
        connect(network:FindFirstChild("CombatBroadcastURE"), function(eventName, ...)
            R:_receiveCombatBroadcast("unreliable", eventName, ...)
        end)
        connect(network:FindFirstChild("CombatClientRemoteEvent"), function(eventName, ...)
            if eventName == "CombatPairCosmetic" then
                local args = table.pack(...)
                local combatEvent = args[1]
                if type(combatEvent) == "string" then
                    R:_receiveCombatBroadcast(
                        "reliable",
                        combatEvent,
                        table.unpack(args, 2, args.n)
                    )
                end
                return
            end
            R:_receiveCombatBroadcast("reliable", eventName, ...)
        end)
        return #self.ObserverConnections > 0
    end

    function R:SetCombatObserver(enabled)
        enabled = enabled == true
        if enabled and not self.ObserverEnabled then self:ClearCombatObserver() end
        self.ObserverEnabled = enabled
        if enabled or self.CombatRunning then
            self:_connectOutcome()
        else
            self:_disconnectCombatObserver()
        end
        self:UpdateCombatObserverStatus()
    end

    function R:_tickHeartbeat(deltaTime)
        if not self.WatchRunning then return end
        local now = os.clock()
        deltaTime = math.clamp(tonumber(deltaTime) or self.FrameEMA, 0.001, 0.25)
        if self.CombatRunning then
            self.FrameEMA += (deltaTime - self.FrameEMA) * 0.08
            local ping = math.clamp(tonumber(getPing()) or 0, 0, 1)
            self.PingJitter += (math.abs(ping - self.PingEMA) - self.PingJitter) * 0.10
            self.PingEMA += (ping - self.PingEMA) * 0.05
        end
        self:_processAnimations(self.CombatRunning and 64 or 32)
        if self.CombatRunning then
            self:_processAttributes(48)
            self:_tickTokenCandidates(now)
        end
        self:_processScan(self.CombatRunning and 56 or 32)

        self.PollElapsed += deltaTime
        local pollInterval = self.CombatRunning and 0.03 or 0.20
        if self.PollElapsed >= pollInterval then
            self.PollElapsed = 0
            self:_pollWatched()
        end
        if self.CombatRunning then
            self:_tickPending(now)
            self:_tickTransportFallback(now)
            self:_tickBlock(now)
            self.TransportElapsed += deltaTime
            if self.TransportElapsed >= 10 then
                self.TransportElapsed = 0
                local selected = tostring(Options.ParryMethod and Options.ParryMethod.Value or "Auto")
                if selected ~= "VIM" and not _cachedBlockMod then
                    task.defer(function()
                        if not R.CombatRunning then return end
                        Library._Performance:RefreshGCFor("parry")
                        pcall(getBlockModule)
                    end)
                end
            end
            self.ContactElapsed += deltaTime
            if self.ContactElapsed >= 120 then
                self.ContactElapsed = 0
                if Toggles.ExcludeContacts and Toggles.ExcludeContacts.Value then
                    task.defer(function()
                        if R.CombatRunning then refreshContacts() end
                    end)
                end
            end
            if not self.LastPruneAt or now - self.LastPruneAt >= 0.5 then
                self.LastPruneAt = now
                self:_pruneAttempts(now)
            end
        end
        self:UpdateStatus(false)
        self:UpdateDiagnosticStatus(false)
    end

    function R:StartWatchers()
        if self.WatchRunning or not self.Alive then return end
        self.WatchRunning = true
        self:_resetScan()
        self.WatchConnections[#self.WatchConnections + 1] =
            Workspace.DescendantAdded:Connect(function(descendant)
                if not R.WatchRunning then return end
                if IsGakuran() and descendant.Parent and descendant.Parent.Name == "Hitboxes" and descendant:IsA("BasePart") then
                    task.defer(function() R:_onGakuranHitboxAdded(descendant) end)
                end
                if descendant:IsA("Humanoid") then
                    local model = descendant.Parent
                    if model and model:IsA("Model") then task.defer(function() R:_watchModel(model) end) end
                elseif descendant:IsA("Model") and descendant:FindFirstChildOfClass("Humanoid") then
                    task.defer(function() R:_watchModel(descendant) end)
                end
            end)
        self.HeartbeatConnection = RunService.Heartbeat:Connect(function(deltaTime)
            R:_tickHeartbeat(deltaTime)
        end)
        self.StatusDirty = true
    end

    function R:StopWatchers()
        if not self.WatchRunning then return end
        self.WatchRunning = false
        if self.HeartbeatConnection then
            self.HeartbeatConnection:Disconnect()
            self.HeartbeatConnection = nil
        end
        self:_clearConnections(self.WatchConnections)
        for index = #self.WatcherList, 1, -1 do
            local data = self.WatcherList[index]
            if data then self:_unwatch(data.model) end
        end
        table.clear(self.WatcherList)
        table.clear(self.ScanQueue)
        table.clear(self.AnimationQueue)
        table.clear(self.AttributeQueue)
        table.clear(self.TokenCandidates)
        self.ScanHead = 1
        self.ScanSeen = setmetatable({}, { __mode = "k" })
        self.AnimationHead = 1
        self.AttributeHead = 1
        self.PollCursor = 1
        self.StatusDirty = true
    end

    function R:_cancelAll()
        self.TransportFallback = nil
        for _, candidate in ipairs(self.TokenCandidates) do candidate.cancelled = true end
        table.clear(self.TokenCandidates)
        for _, data in ipairs(self.WatcherList) do data.tokenCandidate = nil end
        for _, claim in pairs(self.Claims) do
            if claim.token then claim.token.cancelled = true end
        end
        for _, item in ipairs(self.Pending) do self:_cancelItem(item) end
        table.clear(self.Pending)
        for _, attempt in ipairs(self.Attempts) do attempt.cancelled = true end
        table.clear(self.Attempts)
        table.clear(self.Claims)
        self:_releaseBlock("cancel-all")
    end

    function R:StartCombat()
        if self.CombatRunning or not self.Alive then return end
        self.CombatRunning = true
        self.Generation += 1
        self.ActiveEngine = self:Engine()
        self.DetectedThreats = 0
        self.ScheduledThreats = 0
        self.FiredThreats = 0
        self.LastPipeline = "watching"
        self.LastGate = "waiting"
        self.ContactElapsed = 0
        self.TransportElapsed = 0
        table.clear(self.CombatEventTokens)
        self.CombatEventTokenSweepAt = 0
        table.clear(self.RecentOutcomeAt)
        table.clear(self.TokenCandidates)
        for _, data in ipairs(self.WatcherList) do
            self:_bindModelCombat(data)
        end
        if Toggles.ExcludeFriends and Toggles.ExcludeFriends.Value then
            for _, player in ipairs(Players:GetPlayers()) do cacheFriend(player) end
        end
        self.CombatConnections[#self.CombatConnections + 1] = Players.PlayerAdded:Connect(function(player)
            if R.CombatRunning and Toggles.ExcludeFriends and Toggles.ExcludeFriends.Value then cacheFriend(player) end
        end)
        self.CombatConnections[#self.CombatConnections + 1] = LocalPlayer.CharacterAdded:Connect(function(character)
            if R.CombatRunning then task.defer(function() R:_bindLocalCharacter(character) end) end
        end)
        self:_bindLocalCharacter(LocalPlayer.Character)
        self:_connectOutcome()
        if Toggles.ExcludeContacts and Toggles.ExcludeContacts.Value then
            task.defer(function()
                if not R.CombatRunning then return end
                Library._Performance:RefreshGCFor("contacts")
                refreshContacts()
            end)
        end
        self.ActiveExcludeFriends =
            Toggles.ExcludeFriends ~= nil and Toggles.ExcludeFriends.Value == true
        self.ActiveExcludeContacts =
            Toggles.ExcludeContacts ~= nil and Toggles.ExcludeContacts.Value == true
        self.StatusDirty = true
    end

    function R:StopCombat()
        if not self.CombatRunning then return end
        self.CombatRunning = false
        self.Generation += 1
        self:_cancelAll()
        self:_clearConnections(self.CombatConnections)
        self:_clearConnections(self.LocalConnections or {})
        self.LocalConnections = {}
        if not self.ObserverEnabled then self:_disconnectCombatObserver() end
        table.clear(self.CombatEventTokens)
        self.CombatEventTokenSweepAt = 0
        table.clear(self.RecentOutcomeAt)
        table.clear(self.AttributeQueue)
        self.AttributeHead = 1
        for _, data in ipairs(self.WatcherList) do self:_unbindModelCombat(data) end
        self.ActiveExcludeFriends = false
        self.ActiveExcludeContacts = false
        if configDirty and saveCustomConfig() then configDirty = false end
        self.StatusDirty = true
    end

    function R:Refresh()
        if not self.Ready or not self.Alive or self.Loading > 0 then return end
        local needCombat = self:IsAutoEnabled() or self:IsAutoPunishEnabled()
        local needWatch = needCombat or self:IsLoggerEnabled()
        local selectedEngine = self:Engine()
        local coverage = tostring(Options.AttackCoverage and Options.AttackCoverage.Value or "All Known")
        local excludeFriends = Toggles.ExcludeFriends ~= nil and Toggles.ExcludeFriends.Value == true
        local excludeContacts = Toggles.ExcludeContacts ~= nil and Toggles.ExcludeContacts.Value == true
        if self.CombatRunning and (selectedEngine ~= self.ActiveEngine or coverage ~= self.ActiveCoverage) then
            self.Generation += 1
            self:_cancelAll()
            self.ActiveEngine = selectedEngine
        end
        self.ActiveCoverage = coverage
        if self.CombatRunning and excludeFriends and not self.ActiveExcludeFriends then
            for _, player in ipairs(Players:GetPlayers()) do cacheFriend(player) end
        end
        if self.CombatRunning and excludeContacts and not self.ActiveExcludeContacts then
            task.defer(function()
                if not R.CombatRunning then return end
                Library._Performance:RefreshGCFor("contacts")
                refreshContacts()
            end)
        end
        self.ActiveExcludeFriends = excludeFriends
        self.ActiveExcludeContacts = excludeContacts
        if needWatch then self:StartWatchers() end
        if needCombat then self:StartCombat() else self:StopCombat() end
        if not needWatch then self:StopWatchers() end
        if self:IsLoggerEnabled() then self:_ensureLogger() elseif Logger and Logger.frame then Logger.frame.Visible = false end
        self.StatusDirty = true
        self:UpdateStatus(true)
    end

    function R:Activate()
        if self.Ready or not self.Alive then return end
        self.Ready = true
        self.PingEMA = math.clamp(tonumber(getPing()) or 0, 0, 1)
        self:_aliCounterCooldown()
        local ok, message = pcall(function() self:SelfCheck() end)
        if not ok then warn("[SKT HUB X] ParryRuntime self-check failed: " .. tostring(message)) end
        self:ClearCombatObserver()
        self:SetCombatObserver(Toggles.CombatObserver ~= nil
            and Toggles.CombatObserver.Value == true)
        self:SetDiagnostics(Toggles.ParryDiagnostics ~= nil
            and Toggles.ParryDiagnostics.Value == true)
        self:Refresh()
        self:_refreshM2Assist()
    end

    function R:Destroy()
        if not self.Alive then return end
        self.Ready = false
        self.ObserverEnabled = false
        self:StopCombat()
        self:_disconnectCombatObserver()
        self:StopWatchers()
        self:_releaseBlock("destroy")
        local pause = Library._PauseM1Controller
        if pause and typeof(pause.Destroy) == "function" then pcall(pause.Destroy, pause) end
        local punish = Library._AutoPunishController
        if punish and typeof(punish.Destroy) == "function" then pcall(punish.Destroy, punish) end
        self.Alive = false
        if configDirty and saveCustomConfig() then configDirty = false end
    end

    return R
end)()

Library._M2AssistController = (function()
    local Controller = {
        Alive = true,
        Installed = false,
        Active = false,
        Character = nil,
        Target = nil,
        TargetSource = nil,
        Until = 0,
        InactiveSince = nil,
        M2Active = false,
        Connections = {},
        CharacterConnections = {},
    }

    local function disconnect(connections)
        for index = #connections, 1, -1 do
            local connection = connections[index]
            connections[index] = nil
            pcall(function() connection:Disconnect() end)
        end
    end

    function Controller:_m2Reach()
        local character = self.Character or LocalPlayer.Character
        local style = ResolveCombatStyle(character)
        local runtime = Library._ParryRuntime
        if runtime and typeof(runtime._reactiveForwardReach) == "function" then
            local ok, reach = pcall(runtime._reactiveForwardReach, runtime, style, "M2")
            if ok and typeof(reach) == "number" then return math.max(0, reach) end
        end
        local offset
        if CombatConfig and typeof(CombatConfig.GetStyleHitboxForwardOffset) == "function" then
            local ok, value = pcall(CombatConfig.GetStyleHitboxForwardOffset, style, "M2")
            if ok and typeof(value) == "number" then offset = value end
        end
        if typeof(offset) ~= "number" then
            offset = tonumber(CombatConfig and CombatConfig.M2
                and CombatConfig.M2.DefaultHitboxForwardOffset) or 4
        end
        return math.max(0, offset + 2.10)
    end

    function Controller:_range()
        return math.clamp(self:_m2Reach() + 8, 10, 24)
    end

    function Controller:_validTarget(model, range)
        local character = self.Character or LocalPlayer.Character
        if not model or model == character or not model.Parent then return false end
        if isExcludedAttacker(model)
            or model:GetAttribute("Whitelisted") == true
            or model:GetAttribute("Whitelist") == true then
            return false
        end
        local humanoid = model:FindFirstChildOfClass("Humanoid")
        if not humanoid or humanoid.Health <= 0 or model:GetAttribute("Downed") == true then
            return false
        end
        local myRoot = character and character:FindFirstChild("HumanoidRootPart")
        local targetRoot = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
        if not (myRoot and targetRoot) then return false end
        local offset = targetRoot.Position - myRoot.Position
        local horizontal = Vector3.new(offset.X, 0, offset.Z)
        return horizontal.Magnitude <= (tonumber(range) or self:_range())
    end

    function Controller:_selectTarget()
        local range = self:_range()
        local character = self.Character or LocalPlayer.Character
        local myRoot = character and character:FindFirstChild("HumanoidRootPart")
        if not myRoot then return nil, nil end

        local nearest
        local nearestDistance
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer then
                local target = player.Character
                if self:_validTarget(target, range) then
                    local targetRoot = target:FindFirstChild("HumanoidRootPart") or target.PrimaryPart
                    local offset = targetRoot.Position - myRoot.Position
                    local horizontal = Vector3.new(offset.X, 0, offset.Z)
                    local distance = horizontal.Magnitude
                    if distance <= range and (not nearestDistance or distance < nearestDistance) then
                        nearest = target
                        nearestDistance = distance
                    end
                end
            end
        end

        return nearest, nearest and "nearest-player" or nil
    end

    function Controller:_blocked(character)
        if not character or (Library._IsUserTyping and Library._IsUserTyping()) or State.dodgeActive then
            return true
        end
        if character:GetAttribute("Equip") ~= true
            or character:GetAttribute("Ragdoll") == true
            or character:GetAttribute("Stunned") == true
            or character:GetAttribute("CantAnything") == true
            or character:GetAttribute("Downed") == true
            or character:GetAttribute("Greenzone") == true
            or character:GetAttribute("RpCombatLocked") == true then
            return true
        end
        if Toggles.FlyEnabled and Toggles.FlyEnabled.Value == true then return true end
        if Toggles.LocalSkateboard and Toggles.LocalSkateboard.Value == true then return true end
        local runtime = Library._ParryRuntime
        return runtime and typeof(runtime._localInteractionReason) == "function"
            and runtime:_localInteractionReason(character) ~= nil or false
    end

    function Controller:Stop(reason)
        self.Active = false
        self.Target = nil
        self.TargetSource = nil
        self.Until = 0
        self.InactiveSince = nil
        self.StopReason = reason
        return true
    end

    function Controller:Start()
        local character = self.Character or LocalPlayer.Character
        if self:_blocked(character) then
            self:Stop("local-state")
            return false
        end
        local target, source = self:_selectTarget()
        if not target then
            self:Stop("no-approved-target")
            return false
        end
        self.Character = character
        self.Target = target
        self.TargetSource = source
        self.Active = true
        self.Until = os.clock() + 0.8
        self.InactiveSince = nil
        return true
    end

    function Controller:_syncM2State()
        local character = self.Character or LocalPlayer.Character
        local active = character and (character:GetAttribute("M2") == true
            or character:GetAttribute("PendingM2") == true) or false
        if active and not self.M2Active then
            self.M2Active = true
            self.InactiveSince = nil
            self:Start()
        elseif not active and self.M2Active then
            self.M2Active = false
            self.InactiveSince = os.clock()
        end
    end

    function Controller:_tick(deltaTime)
        if not self.Active then return end
        local now = os.clock()
        local character = self.Character
        if not self.Alive or not self.Installed or self:_blocked(character) then
            self:Stop("cancelled")
            return
        end
        if now >= self.Until then
            self:Stop("duration")
            return
        end
        local m2Active = character:GetAttribute("M2") == true
            or character:GetAttribute("PendingM2") == true
        if not m2Active then
            self.InactiveSince = self.InactiveSince or now
            if now - self.InactiveSince >= 0.06 then
                self:Stop("attributes-cleared")
                return
            end
        else
            self.InactiveSince = nil
        end

        local target = self.Target
        local source = self.TargetSource
        if not self:_validTarget(target, self:_range()) then
            target, source = self:_selectTarget()
            if not target then
                self:Stop("target-invalid")
                return
            end
        end
        local myRoot = character:FindFirstChild("HumanoidRootPart")
        local targetRoot = target:FindFirstChild("HumanoidRootPart") or target.PrimaryPart
        if not (myRoot and targetRoot) then
            self:Stop("root-missing")
            return
        end
        local offset = targetRoot.Position - myRoot.Position
        local horizontal = Vector3.new(offset.X, 0, offset.Z)
        self.Target = target
        self.TargetSource = source
        if horizontal.Magnitude <= 0.05 then return end
        local direction = horizontal.Unit
        local desired = CFrame.lookAt(myRoot.Position, myRoot.Position + direction)
        local alpha = math.clamp((tonumber(deltaTime) or 1 / 60) * 12, 0.2, 0.6)
        myRoot.CFrame = myRoot.CFrame:Lerp(desired, alpha)
    end

    function Controller:_bindCharacter(character)
        disconnect(self.CharacterConnections)
        self:Stop("respawn")
        self.Character = character
        self.M2Active = false
        if not character then return end
        for _, attribute in ipairs({ "M2", "PendingM2" }) do
            self.CharacterConnections[#self.CharacterConnections + 1] =
                character:GetAttributeChangedSignal(attribute):Connect(function()
                    Controller:_syncM2State()
                end)
        end
        self:_syncM2State()
    end

    function Controller:_install()
        if self.Installed or not self.Alive then return end
        self.Installed = true
        self.Connections[#self.Connections + 1] = LocalPlayer.CharacterAdded:Connect(function(character)
            Controller:_bindCharacter(character)
        end)
        self.Connections[#self.Connections + 1] = LocalPlayer.CharacterRemoving:Connect(function()
            Controller:_bindCharacter(nil)
        end)
        self.Connections[#self.Connections + 1] = RunService.Heartbeat:Connect(function(deltaTime)
            Controller:_tick(deltaTime)
        end)
        self:_bindCharacter(LocalPlayer.Character)
    end

    function Controller:_uninstall()
        self:Stop("disabled")
        disconnect(self.CharacterConnections)
        disconnect(self.Connections)
        self.Character = nil
        self.M2Active = false
        self.Installed = false
    end

    function Controller:Refresh()
        local enabled = self.Alive and Toggles.M2Assist ~= nil and Toggles.M2Assist.Value == true
        if enabled and not self.Installed then
            self:_install()
        elseif not enabled and self.Installed then
            self:_uninstall()
        end
        return enabled
    end

    function Controller:Destroy()
        if not self.Alive then return end
        self.Alive = false
        self:_uninstall()
    end

    return Controller
end)()

--// ============================ Face Target (Auto Turn) ============================
-- Ported from Premium. Records _lastAttacker / _lastAttackTime inside
-- _validate when an attack is incoming, then this Heartbeat loop snaps the
-- character to face that attacker. Falls back to nearest-player lerp when
-- no recent attack is recorded.
local faceTargetConn = nil
local _faceTargetSmooth = 0.25

local function startFaceTarget()
    if faceTargetConn then return end
    faceTargetConn = RunService.Heartbeat:Connect(function()
        local myChar = LocalPlayer.Character
        local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
        if not myRoot then return end
        if myChar:GetAttribute("Equip") ~= true then return end

        local hum = myChar:FindFirstChildOfClass("Humanoid")
        if hum and (hum:GetState() == Enum.HumanoidStateType.Ragdoll
            or hum:GetState() == Enum.HumanoidStateType.FallingDown) then return end

        -- Detect Shift-Lock / Mouse-Lock.
        local shiftLock = UserInputService.MouseBehavior == Enum.MouseBehavior.LockCenter
        local camera = workspace.CurrentCamera

        local closestDist = math.huge
        local closestTarget = nil
        local _snapToTarget = false

        -- Priority 1: the last attacker (within 3s) — snap instantly.
        if State._lastAttacker and State._lastAttacker.Parent
            and State._lastAttackTime and (os.clock() - State._lastAttackTime < 3) then
            local tRoot = State._lastAttacker:FindFirstChild("HumanoidRootPart")
            if tRoot then
                local dist = (myRoot.Position - tRoot.Position).Magnitude
                local ftRange = (Options.FaceTargetRange and Options.FaceTargetRange.Value) or 10
                if dist < ftRange then
                    closestTarget = tRoot
                    closestDist = dist
                    _snapToTarget = true
                end
            end
        end

        -- Priority 2: nearest player within range — smooth lerp.
        if not closestTarget then
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character then
                    local tRoot = p.Character:FindFirstChild("HumanoidRootPart")
                    if tRoot then
                        local uid = p.UserId
                        local exFriends = Toggles.ExcludeFriends and Toggles.ExcludeFriends.Value
                        local exContacts = Toggles.ExcludeContacts and Toggles.ExcludeContacts.Value
                        if not (exFriends and _friendCache[uid]) and not (exContacts and _contactIds[uid]) then
                            local dist = (myRoot.Position - tRoot.Position).Magnitude
                            local ftRange = Options.FaceTargetRange and Options.FaceTargetRange.Value or 10
                            if dist < closestDist and dist < ftRange then
                                closestDist = dist
                                closestTarget = tRoot
                            end end end end end
        end

        if closestTarget then
            if hum and hum.AutoRotate ~= false then hum.AutoRotate = false end
            local targetPos = Vector3.new(closestTarget.Position.X, myRoot.Position.Y, closestTarget.Position.Z)
            local goalCF = CFrame.lookAt(myRoot.Position, targetPos)

            if shiftLock and camera then
                -- Shift-Lock: the camera controller forces the character to
                -- face the camera direction every frame.  Setting myRoot.CFrame
                -- alone would be instantly overridden (tug-of-war / jitter).
                -- Instead, rotate BOTH the character and the camera by the
                -- same yaw delta.  The relative view doesn't change — it looks
                -- like the player simply flicked their mouse to face the
                -- target.  No screen jerk, no tug-of-war.
                local currentLook = myRoot.CFrame.LookVector
                local desiredLook = (targetPos - myRoot.Position).Unit
                local currentYaw = math.atan2(-currentLook.X, -currentLook.Z)
                local desiredYaw = math.atan2(-desiredLook.X, -desiredLook.Z)
                local deltaYaw = desiredYaw - currentYaw
                -- Normalize to [-pi, pi]
                while deltaYaw > math.pi do deltaYaw = deltaYaw - 2 * math.pi end
                while deltaYaw < -math.pi do deltaYaw = deltaYaw + 2 * math.pi end

                if _snapToTarget then
                    myRoot.CFrame = goalCF
                    camera.CFrame = camera.CFrame * CFrame.Angles(0, deltaYaw, 0)
                else
                    local alpha = _faceTargetSmooth
                    myRoot.CFrame = myRoot.CFrame:Lerp(goalCF, alpha)
                    camera.CFrame = camera.CFrame * CFrame.Angles(0, deltaYaw * alpha, 0)
                end
            else
                -- No Shift-Lock: just rotate the character directly.
                if _snapToTarget then
                    myRoot.CFrame = goalCF
                else
                    myRoot.CFrame = myRoot.CFrame:Lerp(goalCF, _faceTargetSmooth)
                end
            end
        else
            if hum and hum.AutoRotate ~= true then hum.AutoRotate = true end
        end
    end)
end

local function stopFaceTarget()
    if faceTargetConn then
        faceTargetConn:Disconnect()
        faceTargetConn = nil
        pcall(function()
            local myChar = LocalPlayer.Character
            local hum = myChar and myChar:FindFirstChildOfClass("Humanoid")
            if hum and hum.AutoRotate ~= true then hum.AutoRotate = true end
        end)
    end
end

Library._startFaceTarget = startFaceTarget
Library._stopFaceTarget = stopFaceTarget

Library._PauseM1Controller = (function()
    local Controller = {
        Alive = true,
        Bound = false,
        Generation = 0,
        ActionName = "Int3PauseM1",
    }
    local ContextActionService = game:GetService("ContextActionService")

    function Controller:_shouldGate()
        local runtime = Library._ParryRuntime
        local block = runtime and runtime.Block
        local attempt = block and block.attempt
        return self.Alive
            and Toggles.PauseM1 ~= nil and Toggles.PauseM1.Value == true
            and runtime ~= nil and runtime.Ready == true and runtime.CombatRunning == true
            and block ~= nil and block.active == true and block.confirmed ~= true
            and attempt ~= nil and not attempt.cancelled and not attempt.resolved
    end

    function Controller:_unbind()
        if not self.Bound then return end
        pcall(ContextActionService.UnbindAction, ContextActionService, self.ActionName)
        self.Bound = false
    end

    function Controller:Refresh()
        self.Generation += 1
        self:_unbind()
        if not self:_shouldGate() then return false end
        local generation = self.Generation
    local function gate()
            if not Controller.Alive or generation ~= Controller.Generation
                or not Controller:_shouldGate() then
                return Enum.ContextActionResult.Pass
            end
            return Enum.ContextActionResult.Sink
    end
        local priority = Enum.ContextActionPriority.High.Value + 1
        local ok = pcall(
            ContextActionService.BindActionAtPriority,
            ContextActionService,
            self.ActionName,
            gate,
            false,
            priority,
            Enum.UserInputType.MouseButton1
        )
        self.Bound = ok
        return ok
    end

    function Controller:Destroy()
        if not self.Alive then return end
        self.Alive = false
        self.Generation += 1
        self:_unbind()
    end

    return Controller
end)()

Library._AutoPunishController = (function()
    local Controller = {
        Alive = true,
        Generation = 0,
        Held = {},
        Recent = setmetatable({}, { __mode = "k" }),
    }
    local ContextActionService = game:GetService("ContextActionService")

    local function inputTypeFor(attackType)
        if attackType == "M1" then return Enum.UserInputType.MouseButton1 end
        if attackType == "M2" then return Enum.UserInputType.MouseButton2 end
        return nil
    end

    local function typeSpecificAction(name, attackType)
        local action = string.lower(tostring(name or ""))
        if action:sub(1, 4) == "int3" then return false end
        if action:find("ui", 1, true) or action:find("menu", 1, true) then return false end
        if attackType == "M1" then
            return action:find("m1", 1, true) ~= nil
                or action:find("light", 1, true) ~= nil
                or action:find("primary", 1, true) ~= nil
        end
        return action:find("m2", 1, true) ~= nil
            or action:find("heavy", 1, true) ~= nil
            or action:find("secondary", 1, true) ~= nil
    end

    function Controller:_record(stage, target, attackType, extra)
        local runtime = Library._ParryRuntime
        if runtime and typeof(runtime._diagnosticRecord) == "function" then
            runtime:_diagnosticRecord(stage, {
                model = target,
                attackType = attackType,
                source = "CombatBroadcast",
                sourceClass = "outcome",
            }, extra or {})
        end
    end

    function Controller:_findBoundAction(attackType)
        local inputType = inputTypeFor(attackType)
        if not inputType then return nil, "attack-type" end
        local ok, actions = pcall(
            ContextActionService.GetAllBoundActionInfo,
            ContextActionService
        )
        if not ok or type(actions) ~= "table" then return nil, "actions-unavailable" end
        local match = nil
        for name, info in pairs(actions) do
            local inputs = type(info) == "table" and info.inputTypes
            local usesInput = false
            if type(inputs) == "table" then
                for _, boundInput in ipairs(inputs) do
                    if boundInput == inputType then
                        usesInput = true
                        break
                    end
                end
            end
            if usesInput and typeSpecificAction(name, attackType) then
                if match and match ~= name then return nil, "ambiguous-action" end
                match = name
            end
        end
        return match, match and nil or "no-type-specific-action"
    end

    function Controller:_release(action, held)
        if self.Held[action] ~= held then return end
        self.Held[action] = nil
        pcall(
            ContextActionService.CallFunction,
            ContextActionService,
            action,
            Enum.UserInputState.End,
            nil
        )
    end

    function Controller:_releaseAll()
        while true do
            local action, held = next(self.Held)
            if not action then break end
            self:_release(action, held)
        end
    end

    function Controller:Refresh()
        self.Generation += 1
        if not self.Alive or Toggles.AutoPunish == nil or Toggles.AutoPunish.Value ~= true then
            self:_releaseAll()
            return false
        end
        local release = {}
        for action, held in pairs(self.Held) do
            local enabled = (held.attackType == "M1"
                    and Toggles.AutoPunishM1 ~= nil and Toggles.AutoPunishM1.Value == true)
                or (held.attackType == "M2"
                    and Toggles.AutoPunishM2 ~= nil and Toggles.AutoPunishM2.Value == true)
            if not enabled then release[#release + 1] = { action, held } end
        end
        for _, input in ipairs(release) do
            self:_release(input[1], input[2])
        end
        return true
    end

    function Controller:ObserveOutcome(target, attackType, kind)
        if not self:Refresh() then return false end
        if isMobile or (kind ~= "perfect" and kind ~= "regular") then return false end
        if (attackType == "M1" and (not Toggles.AutoPunishM1 or Toggles.AutoPunishM1.Value ~= true))
            or (attackType == "M2" and (not Toggles.AutoPunishM2 or Toggles.AutoPunishM2.Value ~= true)) then
            return false
        end
        if not target or not target.Parent or isExcludedAttacker(target) then return false end
        local runtime = Library._ParryRuntime
        if not runtime or not runtime:_localReady() then
            self:_record("auto-punish-rejected", target, attackType, { reason = "local-state" })
            return false
        end
        local character = LocalPlayer.Character
        local myRoot = character and character:FindFirstChild("HumanoidRootPart")
        local targetRoot = target:FindFirstChild("HumanoidRootPart") or target.PrimaryPart
        local targetHumanoid = target:FindFirstChildOfClass("Humanoid")
        local maxRange = math.max(4, tonumber(Options.MaxRange and Options.MaxRange.Value) or 10)
        if not myRoot or not targetRoot or (targetHumanoid and targetHumanoid.Health <= 0)
            or (targetRoot.Position - myRoot.Position).Magnitude > maxRange then
            self:_record("auto-punish-rejected", target, attackType, { reason = "target-state" })
            return false
        end
        local now = os.clock()
        local recent = self.Recent[target]
        if recent and recent.attackType == attackType and now - recent.at < 0.12 then
            return false
        end
        local action, reason = self:_findBoundAction(attackType)
        if not action then
            self:_record("auto-punish-unavailable", target, attackType, { reason = reason })
            return false
        end
        local previous = self.Held[action]
        if previous then self:_release(action, previous) end
        local ok = pcall(
            ContextActionService.CallFunction,
            ContextActionService,
            action,
            Enum.UserInputState.Begin,
            nil
        )
        if not ok then
            self:_record("auto-punish-unavailable", target, attackType, { reason = "action-call-failed" })
            return false
        end
        local held = { generation = self.Generation, attackType = attackType }
        self.Held[action] = held
        self.Recent[target] = { at = now, attackType = attackType }
        self:_record("auto-punish-command", target, attackType, {
            action = action,
            outcome = kind,
        })
        task.delay(0.04, function()
            Controller:_release(action, held)
        end)
        return true
    end

    function Controller:Destroy()
        if not self.Alive then return end
        self.Alive = false
        self.Generation += 1
        self:_releaseAll()
        table.clear(self.Recent)
    end

    return Controller
end)()

