    return _hudGui
end

local function DestroyHUD()
    if _hudConn then
        _hudConn:Disconnect()
        _hudConn = nil
    end
    if _hudGui then
        _hudGui.gui:Destroy()
        _hudGui = nil
    end
end

local function StartHUD()
    if _hudConn then return end
    BuildHUD()
    local elapsed = HUD_UPDATE_INTERVAL
    _hudConn = RunService.Heartbeat:Connect(function(deltaTime)
        elapsed += deltaTime
        if elapsed < HUD_UPDATE_INTERVAL then return end
        elapsed = 0
        if not _hudGui then return end
        local char = LocalPlayer.Character
        if not char then return end

        local showHp = Toggles.HudHealthBar and Toggles.HudHealthBar.Value
        local showStam = Toggles.HudStaminaBar and Toggles.HudStaminaBar.Value
        local scale = Options.CombatHUDScale and Options.CombatHUDScale.Value or 1.0

        local stam = _hudGui.stam
        if stam.container.Visible ~= (showStam == true) then
            stam.container.Visible = showStam == true
        end
        if showStam then
            local baseW = 300 * scale
            local baseH = 24 * scale
            stam.container.Size = UDim2.new(0, baseW, 0, baseH)
            stam.container.Position = UDim2.new(0.5, -(baseW/2), 1, stam.yBase * scale)
            stam.title.Position = UDim2.new(0, 0, 0, -20 * scale)
            stam.title.Size = UDim2.new(1, 0, 0, 20 * scale)
            stam.title.TextSize = 14 * scale
            stam.num.TextSize = 14 * scale

            local s = char:GetAttribute("Stamina")
            if typeof(s) ~= "number" then s = 100 end
            if stam.value ~= s then
                stam.value = s
                local sPct = math.clamp(s / 100, 0, 1)
                stam.fill.Size = UDim2.new(sPct, 0, 1, 0)
                stam.num.Text = string.format("%d / 100", math.floor(s + 0.5))
                local fillCol = stam.color
                if s < 25 then
                    fillCol = Color3.fromRGB(231, 76, 60)
                end
                local grad = stam.fill:FindFirstChildOfClass("UIGradient")
                if grad then
                    grad.Color = ColorSequence.new({
                        ColorSequenceKeypoint.new(0, fillCol),
                        ColorSequenceKeypoint.new(1, Color3.new(fillCol.r * 0.5, fillCol.g * 0.5, fillCol.b * 0.5))
                    })
                else
                    stam.fill.BackgroundColor3 = fillCol
                end
            end
        end

        local hpInfo = _hudGui.hp
        if hpInfo.container.Visible ~= (showHp == true) then
            hpInfo.container.Visible = showHp == true
        end
        if showHp then
            local baseW = 300 * scale
            local baseH = 24 * scale
            hpInfo.container.Size = UDim2.new(0, baseW, 0, baseH)
            hpInfo.container.Position = UDim2.new(0.5, -(baseW/2), 1, hpInfo.yBase * scale)
            hpInfo.title.Position = UDim2.new(0, 0, 0, -20 * scale)
            hpInfo.title.Size = UDim2.new(1, 0, 0, 20 * scale)
            hpInfo.title.TextSize = 14 * scale
            hpInfo.num.TextSize = 14 * scale

            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum then
                local hp = hum.Health
                local maxHp = hum.MaxHealth
                if maxHp <= 0 then maxHp = 100 end
                if hpInfo.value ~= hp or hpInfo.maxValue ~= maxHp then
                    hpInfo.value = hp
                    hpInfo.maxValue = maxHp
                    local hpPct = math.clamp(hp / maxHp, 0, 1)
                    hpInfo.fill.Size = UDim2.new(hpPct, 0, 1, 0)
                    hpInfo.num.Text = string.format("%d / %d", math.floor(hp + 0.5), math.floor(maxHp + 0.5))
                    local fillCol = hpInfo.color
                    if hpPct < 0.25 then
                        fillCol = Color3.fromRGB(231, 76, 60)
                    end
                    local grad = hpInfo.fill:FindFirstChildOfClass("UIGradient")
                    if grad then
                        grad.Color = ColorSequence.new({
                            ColorSequenceKeypoint.new(0, fillCol),
                            ColorSequenceKeypoint.new(1, Color3.new(fillCol.r * 0.5, fillCol.g * 0.5, fillCol.b * 0.5))
                        })
                    else
                        hpInfo.fill.BackgroundColor3 = fillCol
                    end end end end end)
end

