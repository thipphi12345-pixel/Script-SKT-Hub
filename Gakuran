    function Window:CompleteIntro()
        local overlay = self.IntroOverlay
        if self.Destroyed or not overlay or not overlay.Parent then return end
        self.IntroOverlay = nil
        pcall(function() self.IntroLabel.Text = "Workspace ready" end)
        task.delay(MotionEnabled and 0.25 or 0, function()
            if not overlay.Parent then return end
            -- Release input first: the shield button must never outlive the fade.
            pcall(function()
                local shield = overlay:FindFirstChild("InputShield")
                if shield then shield.Visible = false end
            end)
            pcall(function()
                local animation = self.IntroSweep and AmbientTweens[self.IntroSweep]
                if animation then animation:Cancel() end
                if self.IntroSweep then AmbientTweens[self.IntroSweep] = nil end
            end)
            pcall(function()
                tween(overlay, 0.3, { GroupTransparency = 1 }, Enum.EasingStyle.Quart)
            end)
            pcall(function() overlay.GroupTransparency = 1 end)
            task.delay(MotionEnabled and 0.35 or 0, function()
                pcall(function() if overlay.Parent then overlay:Destroy() end end)
                self.IntroLabel = nil
                if MotionEnabled and not self.Destroyed then
                    for index, tab in ipairs(self.Tabs or {}) do
                        local button = tab.Button
                        if button and button.Parent then
                            local parts = {
                                { button, "BackgroundTransparency", 0.04 },
                                { tab.Label, "TextTransparency", 0 },
                                { tab.Icon, "BackgroundTransparency", 0.45 },
                                { tab.IconImage, "ImageTransparency", 0 },
                                { tab.IconGlyph, "TextTransparency", 0 },
                                { tab.ButtonStroke, "Transparency", 0.45 },
                                { tab.IconStroke, "Transparency", 0.45 },
                            }
                            for _, part in ipairs(parts) do
                                if part[1] then part[1][part[2]] = 1 end
                            end
                            task.delay(math.min(index * 0.04, 0.6), function()
                                if self.Destroyed or not button.Parent then return end
                                for _, part in ipairs(parts) do
                                    local object, property, target = part[1], part[2], part[3]
                                    if object and object.Parent then
                                        pcall(function()
                                            local reveal = TweenService:Create(object, TweenInfo.new(0.28, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
                                                [property] = target,
                                            })
                                            -- keep a reference: unreferenced tweens can be GC'd mid-play on some executors
                                            ActiveTweens[object] = reveal
                                            reveal:Play()
                                        end)
                                    end
                                end
                                -- absolute fallback: if any tween failed or was collected, force the final state
                                task.delay(0.4, function()
                                    for _, part in ipairs(parts) do
                                        local object, property, target = part[1], part[2], part[3]
                                        if object and object.Parent then
                                            pcall(function() object[property] = target end)
                                        end
                                    end
                                end)
                            end)
                        end
                    end
                end
            end)
        end)
    end

    function Window:Toggle(force)
        if self.Destroyed then return false end
        -- Debounce: ignore rapid double-toggles within 0.2s (prevents flicker from
        -- overlapping input handlers on mobile / floating buttons).
        local now = os.clock()
        if self._lastToggleAt and (now - self._lastToggleAt) < 0.2 and force == nil then
            return self.Visible
        end
        self._lastToggleAt = now
        if force == nil then
            self.Visible = not self.Visible
        else
            self.Visible = force == true
        end
        self.VisibilityGeneration = (self.VisibilityGeneration or 0) + 1
        local generation = self.VisibilityGeneration
        local targetScale = self.TargetScale or self.Scale.Scale
        if self.Visible then
            self.Screen.Enabled = true
            self.Root.Visible = true
            self.Root.GroupTransparency = 1
            self.Scale.Scale = targetScale * 0.96 -- Extravagant Pop Up
            tween(self.Root, 0.24, { GroupTransparency = 0 }, Enum.EasingStyle.Quart)
            tween(self.Scale, 0.32, { Scale = targetScale }, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
            if self.Shadow then self.Shadow.Visible = not self.LowDetail end
            if MotionEnabled and self.TabList then
                self.TabList.Position = UDim2.fromOffset(4, 40)
                tween(self.TabList, 0.32, { Position = UDim2.fromOffset(10, 40) }, Enum.EasingStyle.Quart)
            end
            for _, animation in pairs(AmbientTweens) do
                if MotionEnabled then animation:Play() end
            end
            if _G.SKTFpsPingGui then pcall(function() _G.SKTFpsPingGui.Enabled = true end) end
        else
            tween(self.Root, 0.25, { GroupTransparency = 1 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
            tween(self.Scale, 0.25, { Scale = targetScale * 0.97 }, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
            if self.Shadow then self.Shadow.Visible = false end
            for object, animation in pairs(AmbientTweens) do
                -- The watermark lives on a separate ScreenGui that stays visible
                -- while the window is hidden, so its shimmer must keep playing.
                local onWatermark = false
                if object and self.WatermarkScreen then
                    local ok, desc = pcall(function() return object:IsDescendantOf(self.WatermarkScreen) end)
                    onWatermark = ok and desc == true
                end
                if not onWatermark then animation:Pause() end
            end
            if _G.SKTFpsPingGui then pcall(function() _G.SKTFpsPingGui.Enabled = false end) end
            task.delay(0.35, function()
                if not self.Destroyed and self.VisibilityGeneration == generation and not self.Visible then
                    self.Root.Visible = false
                    self.Screen.Enabled = false
                end
            end)
        end
        return self.Visible
    end

