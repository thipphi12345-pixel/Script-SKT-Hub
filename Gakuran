--// Anti-AFK
-- Two layers: swallow the GuiService/Player Idled kick, and nudge the humanoid so
-- server side activity checks keep seeing input.
local _antiAfkActive = false
local _antiAfkIdledConnection
local _antiAfkVirtualUser

startAntiAfk = function()
    if _antiAfkActive then return end
    _antiAfkActive = true

    -- Disable all default Roblox Idle Disconnect connections
    pcall(function()
        if typeof(getconnections) == "function" then
            for _, conn in ipairs(getconnections(LocalPlayer.Idled)) do
                if conn.Disable then conn:Disable() end
                if conn.Disconnect then conn:Disconnect() end
            end
        end
    end)

    if not _antiAfkVirtualUser then
        pcall(function() _antiAfkVirtualUser = game:GetService("VirtualUser") end)
    end

    if not _antiAfkIdledConnection then
        _antiAfkIdledConnection = LocalPlayer.Idled:Connect(function()
            if not _antiAfkActive then return end
            local vu = _antiAfkVirtualUser
            if not vu then return end
            pcall(function()
                vu:CaptureController()
                vu:ClickButton2(Vector2.new(0, 0))
            end)
        end)
    end

    task.spawn(function()
        while _antiAfkActive and Library._Performance.Alive do
            local interval = tonumber(Options.AntiAfkInterval and Options.AntiAfkInterval.Value) or 20
            task.wait(math.clamp(interval, 5, 120))
            if not _antiAfkActive or not Library._Performance.Alive then break end

            -- Periodic VirtualUser heartbeat to keep connection alive 24/7
            if _antiAfkVirtualUser then
                pcall(function()
                    _antiAfkVirtualUser:CaptureController()
                    _antiAfkVirtualUser:ClickButton2(Vector2.new(0, 0))
                end)
            end

            -- Never fight the parry engine or interrupt a dodge; skip this tick instead.
            local runtime = Library._ParryRuntime
            if runtime and runtime.Block and runtime.Block.active then continue end

            local character = LocalPlayer.Character
            local humanoid = character and character:FindFirstChildOfClass("Humanoid")
            if humanoid and humanoid.Health > 0 then
                pcall(function() humanoid:ChangeState(Enum.HumanoidStateType.Jumping) end)
            end
        end
    end)
end

stopAntiAfk = function()
    _antiAfkActive = false
    if _antiAfkIdledConnection then
        pcall(function() _antiAfkIdledConnection:Disconnect() end)
        _antiAfkIdledConnection = nil
    end
end

--// Server Hop
local _serverHopRunning = false

function _GetHttpRequest()
    return (syn and syn.request)
        or (http and http.request)
        or http_request
        or (fluxus and fluxus.request)
        or request
end

function _FetchServerPage(placeId, cursor)
    local requestFunction = _GetHttpRequest()
    if not requestFunction then return nil end
    local url = string.format(
        "https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100&cursor=%s",
        placeId,
        cursor or ""
    )
    local ok, response = pcall(requestFunction, {
        Url = url,
        Method = "GET",
        Headers = { ["Content-Type"] = "application/json" },
    })
    if not ok or type(response) ~= "table" then return nil end
    local okDecode, data = pcall(function()
        return HttpService:JSONDecode(response.Body or "")
    end)
    if not okDecode or type(data) ~= "table" then return nil end
    return data
end

hopServer = function(mode)
    if _serverHopRunning then
        Library:Notify({ Title = "Server Hop", Description = "Already searching for a server.", Time = 3 })
        return
    end
    if not _GetHttpRequest() then
        Library:Notify({
            Title = "Server Hop",
            Description = "This executor has no HTTP request function.",
            Time = 4,
        })
        return
    end

    mode = tostring(mode or "Random")
    _serverHopRunning = true
    Library:Notify({ Title = "Server Hop", Description = "Finding servers...", Time = 2 })

    task.spawn(function()
        local placeId = game.PlaceId
        local currentJobId = game.JobId
        local servers = {}
        local cursor = nil
        local pages = 0

        repeat
            pages += 1
            local data = _FetchServerPage(placeId, cursor)
            if not data or type(data.data) ~= "table" then break end
            for _, server in ipairs(data.data) do
                local playing = tonumber(server.playing) or 0
                local capacity = tonumber(server.maxPlayers) or math.huge
                if server.id ~= currentJobId and playing > 0 and playing < capacity then
                    table.insert(servers, server)
                end
            end
            cursor = data.nextPageCursor
            task.wait(0.1)
        until not cursor or pages >= 5 or #servers >= 50

        if #servers == 0 then
            _serverHopRunning = false
            Library:Notify({ Title = "Server Hop", Description = "No available servers found.", Time = 3 })
            return
        end

        local target
        if mode == "Lowest Ping" then
            table.sort(servers, function(a, b)
                return (tonumber(a.ping) or 9999) < (tonumber(b.ping) or 9999)
            end)
            target = servers[1]
        elseif mode == "Most Players" then
            table.sort(servers, function(a, b)
                return (tonumber(a.playing) or 0) > (tonumber(b.playing) or 0)
            end)
            target = servers[1]
        elseif mode == "Least Players" then
            table.sort(servers, function(a, b)
                return (tonumber(a.playing) or 0) < (tonumber(b.playing) or 0)
            end)
            target = servers[1]
        else
            target = servers[math.random(1, #servers)]
        end

        if not target or not target.id then
            _serverHopRunning = false
            Library:Notify({ Title = "Server Hop", Description = "Failed to pick a server.", Time = 3 })
            return
        end

        Library:Notify({
            Title = "Server Hop",
            Description = string.format("Teleporting to a server with %d players...", tonumber(target.playing) or 0),
            Time = 3,
        })
        local ok, message = pcall(function()
            game:GetService("TeleportService"):TeleportToPlaceInstance(placeId, target.id, LocalPlayer)
        end)
        _serverHopRunning = false
        if not ok then
            Library:Notify({ Title = "Server Hop", Description = "Teleport failed: " .. tostring(message), Time = 4 })
        end
    end)
end

--// Auto Sprint
local autoSprintConn = nil
local _isSprintingActive = false
local _sprintHumanoid
local _sprintButtons = setmetatable({}, { __mode = "k" })
local _sprintConnections = {}
local _sprintPlayerGui
local _sprintGuiAddedConnection
local _sprintGuiRemovingConnection
local _sprintCharacterChildConnection
local _virtualInputManager
local _contextActionService
local _sprintRoute
local _sprintActionName
local TriggerMobileSprintButton
pcall(function() _virtualInputManager = game:GetService("VirtualInputManager") end)
pcall(function() _contextActionService = game:GetService("ContextActionService") end)

function ReleaseSprintActivation()
    local route = _sprintRoute
    local actionName = _sprintActionName
    _sprintRoute = nil
    _sprintActionName = nil
    _isSprintingActive = false
    if route == "Action" and actionName and _contextActionService then
        pcall(
            _contextActionService.CallFunction,
            _contextActionService,
            actionName,
            Enum.UserInputState.End,
            nil
        )
    elseif route == "Keyboard" and _virtualInputManager then
        pcall(_virtualInputManager.SendKeyEvent, _virtualInputManager, false, Enum.KeyCode.LeftShift, false, game)
    elseif route == "Mobile" and TriggerMobileSprintButton then
        pcall(TriggerMobileSprintButton, false, true)
    end
end

function FindBoundSprintAction()
    if not _contextActionService then return nil end
    local ok, actions = pcall(
        _contextActionService.GetAllBoundActionInfo,
        _contextActionService
    )
    if not ok or type(actions) ~= "table" then return nil end

    local match
    for name, info in pairs(actions) do
        if type(name) == "string" then
            local lowered = string.lower(name)
            local nameMatches = lowered:find("sprint", 1, true)
                or lowered:find("run", 1, true)
            local inputTypes = type(info) == "table" and info.inputTypes
            if nameMatches and type(inputTypes) == "table" then
                for _, inputType in pairs(inputTypes) do
                    if inputType == Enum.KeyCode.LeftShift then
                        if match and match ~= name then return nil end
                        match = name
                        break
                    end end end end end
    return match
end

function BeginSprintActivation()
    if _sprintRoute then ReleaseSprintActivation() end
    local actionName = FindBoundSprintAction()
    if actionName and _contextActionService then
        local ok, result = pcall(
            _contextActionService.CallFunction,
            _contextActionService,
            actionName,
            Enum.UserInputState.Begin,
            nil
        )
        if ok and result ~= false then
            _sprintRoute = "Action"
            _sprintActionName = actionName
            return true
        end
    end

    if not isMobile and _virtualInputManager then
        local ok, result = pcall(
            _virtualInputManager.SendKeyEvent,
            _virtualInputManager,
            true,
            Enum.KeyCode.LeftShift,
            false,
            game
        )
        if ok and result ~= false then
            _sprintRoute = "Keyboard"
            return true
        end
    elseif isMobile and TriggerMobileSprintButton then
        local ok, triggered = pcall(TriggerMobileSprintButton, true, true)
        if ok and triggered then
            _sprintRoute = "Mobile"
            return true
        end
    end
    return false
end

function IsSprintButton(instance)
    return (instance:IsA("ImageButton") or instance:IsA("TextButton"))
        and (instance.Name == "Sprint" or instance.Name == "Run")
end

function TrackSprintButton(instance)
    if IsSprintButton(instance) then _sprintButtons[instance] = true end
end

function BindSprintPlayerGui(playerGui)
    if playerGui ~= _sprintPlayerGui then ReleaseSprintActivation() end
    if _sprintGuiAddedConnection then _sprintGuiAddedConnection:Disconnect() end
    if _sprintGuiRemovingConnection then _sprintGuiRemovingConnection:Disconnect() end
    _sprintGuiAddedConnection = nil
    _sprintGuiRemovingConnection = nil
    _sprintPlayerGui = playerGui
    table.clear(_sprintButtons)
    if not playerGui then return end

    for _, descendant in ipairs(playerGui:GetDescendants()) do TrackSprintButton(descendant) end
    _sprintGuiAddedConnection = playerGui.DescendantAdded:Connect(TrackSprintButton)
    _sprintGuiRemovingConnection = playerGui.DescendantRemoving:Connect(function(descendant)
        _sprintButtons[descendant] = nil
    end)
end

function DisconnectSprintWatchers()
    if _sprintCharacterChildConnection then
        _sprintCharacterChildConnection:Disconnect()
        _sprintCharacterChildConnection = nil
    end
    for index = #_sprintConnections, 1, -1 do
        local connection = _sprintConnections[index]
        _sprintConnections[index] = nil
        if connection then pcall(function() connection:Disconnect() end) end
    end
    BindSprintPlayerGui(nil)
    _sprintHumanoid = nil
end

function BindSprintCharacter(character)
    if _sprintCharacterChildConnection then
        _sprintCharacterChildConnection:Disconnect()
        _sprintCharacterChildConnection = nil
    end
    local humanoid = character and character:FindFirstChildOfClass("Humanoid") or nil
    if humanoid ~= _sprintHumanoid then ReleaseSprintActivation() end
    _sprintHumanoid = humanoid
    if character and not _sprintHumanoid then
        _sprintCharacterChildConnection = character.ChildAdded:Connect(function(child)
            if child:IsA("Humanoid") then
                if _sprintCharacterChildConnection then
                    _sprintCharacterChildConnection:Disconnect()
                    _sprintCharacterChildConnection = nil
                end
                ReleaseSprintActivation()
                _sprintHumanoid = child
            end
        end)
    end
end

function StartSprintWatchers()
    DisconnectSprintWatchers()
    BindSprintPlayerGui(LocalPlayer:FindFirstChild("PlayerGui"))
    _sprintConnections[#_sprintConnections + 1] = LocalPlayer.ChildAdded:Connect(function(child)
        if child:IsA("PlayerGui") then BindSprintPlayerGui(child) end
    end)
    _sprintConnections[#_sprintConnections + 1] = LocalPlayer.ChildRemoved:Connect(function(child)
        if child == _sprintPlayerGui then BindSprintPlayerGui(nil) end
    end)
    _sprintConnections[#_sprintConnections + 1] = LocalPlayer.CharacterAdded:Connect(BindSprintCharacter)
    _sprintConnections[#_sprintConnections + 1] = LocalPlayer.CharacterRemoving:Connect(function(character)
        if character == LocalPlayer.Character then
            ReleaseSprintActivation()
            _sprintHumanoid = nil
        end
    end)
    BindSprintCharacter(LocalPlayer.Character)
end

function RefreshSprintPlayerGui()
    local currentPlayerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if currentPlayerGui ~= _sprintPlayerGui or next(_sprintButtons) == nil then
        BindSprintPlayerGui(currentPlayerGui)
    end
end

TriggerMobileSprintButton = function(state, skipRebind)
    if typeof(getconnections) ~= "function" then return false end
    if not skipRebind then RefreshSprintPlayerGui() end
    local triggered = false
    local function FireSignal(signal, input)
        local ok, connections = pcall(getconnections, signal)
        if not ok or type(connections) ~= "table" then return end
        for _, conn in ipairs(connections) do
            local callbackOk, callback = pcall(function()
                return conn and conn.Function
            end)
            if callbackOk and type(callback) == "function" then
                local called = input == nil and pcall(callback) or pcall(callback, input)
                triggered = called or triggered
            end
        end
    end
    for gui in pairs(_sprintButtons) do
        if gui.Parent then
            if state then
                FireSignal(
                    gui.InputBegan,
                    { UserInputType = Enum.UserInputType.Touch, UserInputState = Enum.UserInputState.Begin }
                )
                FireSignal(gui.MouseButton1Down)
            else
                FireSignal(
                    gui.InputEnded,
                    { UserInputType = Enum.UserInputType.Touch, UserInputState = Enum.UserInputState.End }
                )
                FireSignal(gui.MouseButton1Up)
            end
        else
            _sprintButtons[gui] = nil
        end
    end
    return triggered
end

startAutoSprint = function()
    if autoSprintConn then return end
    _isSprintingActive = false
    StartSprintWatchers()
    local _sprintElapsed = 0
    autoSprintConn = RunService.Heartbeat:Connect(function(dt)
        _sprintElapsed += dt
        if _sprintElapsed < 0.15 then return end
        _sprintElapsed = 0
        local hum = _sprintHumanoid
        local character = LocalPlayer.Character
        if hum and (not hum.Parent or hum.Parent ~= character) then
            ReleaseSprintActivation()
            BindSprintCharacter(character)
            hum = _sprintHumanoid
        end
        if not hum then return end
        
        local isMoving = hum.MoveDirection.Magnitude > 0
        if isMoving and not _isSprintingActive then
            RefreshSprintPlayerGui()
            _isSprintingActive = BeginSprintActivation()
        elseif not isMoving and _isSprintingActive then
            ReleaseSprintActivation()
        end
    end)
end

stopAutoSprint = function()
    if autoSprintConn then
        autoSprintConn:Disconnect()
        autoSprintConn = nil
    end
    ReleaseSprintActivation()
    DisconnectSprintWatchers()
end

