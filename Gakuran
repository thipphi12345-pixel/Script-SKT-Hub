            -- Never leave CapturingKeybind stuck: abandoning the capture would
            -- permanently disable the window toggle key until re-execution.
            local token = (self.Window._KeybindCaptureToken or 0) + 1
            self.Window._KeybindCaptureToken = token
            task.delay(10, function()
