function _photoEnsureFollowConn()
    if _photoFollowConn then
        getgenv()._SKT_PhotoFollowConn = _photoFollowConn
        return
    end
    -- Kill stale follow connections left behind by an older copy of this
    -- script: re-executing used to orphan the old Heartbeat conn + its
    -- BodyVelocity, and two drivers fighting caused visible stutter. We find
    -- them via an upvalue holding a BodyVelocity named "AutoFarmFloat"
    -- (name-based upvalue lookup is unreliable on some executors, so we
    -- inspect the upvalue VALUES). Runs only at conn creation, not per tick.
    pcall(function()
        if typeof(getconnections) ~= "function" or typeof(debug) ~= "table" then return end
        for _, c in ipairs(getconnections(game:GetService("RunService").Heartbeat)) do
            local f = c.Function
            if not f and typeof(c.GetFunction) == "function" then
                local okF, ff = pcall(c.GetFunction, c)
                if okF then f = ff end
            end
            if type(f) == "function" and f ~= _photoFollowHeartbeatFn then
                local isOurs = false
                for i = 1, 40 do
                    local rets = { pcall(debug.getupvalue, f, i) }
                    for j = 2, #rets do
                        local v = rets[j]
                        if typeof(v) == "Instance" and v:IsA("BodyVelocity") and v.Name == "AutoFarmFloat" then
                            isOurs = true break
                        end
                    end
                    if isOurs then break end
                end
                if isOurs then pcall(function() c:Disconnect() end) end
            end
        end
    end)
    local LP = game:GetService("Players").LocalPlayer
    local _photoElapsed = 0
    local _emoteCacheAt, _emoteCache = 0, false
    local _hbFn = function(dt)
        _photoElapsed += dt
        if _photoElapsed < 0.05 then return end
        _photoElapsed = 0
        if not getgenv()._SKT_AutoPhotoEnabled then return end
        local myChar = LP and LP.Character
        local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
        if not myRoot then return end
        pcall(function()
            _photoEnsureFloatBV(myRoot)
            if not LP.Character then return end
            -- Emote probe walks attributes + anim tracks; cache it briefly so
            -- the heartbeat doesn't pay that cost every tick.
            local _enow = os.clock()
            if _enow - _emoteCacheAt > 0.3 then
                _emoteCacheAt = _enow
                _emoteCache = _sktIsEmoting(myChar)
            end
            local _hum = myChar:FindFirstChildOfClass("Humanoid")
            if _emoteCache then
                _photoFloatBV.Velocity = Vector3.new(0, 0, 0)
                getgenv()._SKT_PhotoHeadstand = false
                if _hum and _hum.PlatformStand then _hum.PlatformStand = false end
                return
            end
            -- PlatformStand keeps the body in free physics orientation so the
            -- upside-down pose isn't forced upright — held for the WHOLE farm
            -- session, not just while standing on a target's head.
            if _hum and not _hum.PlatformStand then _hum.PlatformStand = true end
            getgenv()._SKT_PhotoHeadstand = true

            local targetRoot = _photoFollowTargetRoot
            local goalPos, rotGoal
            if targetRoot and targetRoot.Parent then
                _photoHoldPos = nil
                _photoHoldRot = nil
                _photoIdleRot = nil
                local angleCfg = _photoPlayerAngles[_photoAngleIndex] or _photoPlayerAngles[1]
                local cf = angleCfg.getCF(targetRoot)
                goalPos = cf.Position
                rotGoal = cf - cf.Position
            else
                -- No live player target: hover in place (or at the area spot
                -- the farm loop set), still upside-down. Capture the idle
                -- base rotation ONCE so we don't flip relative to ourselves.
                goalPos = _photoHoldPos or myRoot.Position
                if _photoHoldRot then
                    rotGoal = _photoHoldRot - _photoHoldRot.Position
                else
                    if not _photoIdleRot then
                        _photoIdleRot = (myRoot.CFrame - myRoot.Position)
                            * CFrame.Angles(0, 0, math.rad(180))
                    end
                    rotGoal = _photoIdleRot
                end
            end

            -- Never fall off the map / never sink under the spot: if we end
            -- up far below where we should hover (knocked down, clipped
            -- through the floor), snap straight back up.
            if myRoot.Position.Y < goalPos.Y - 14 then
                LP.Character:PivotTo(CFrame.new(goalPos) * rotGoal)
                myRoot.Velocity = Vector3.new(0, 0, 0)
                if _photoFloatBV then _photoFloatBV.Velocity = Vector3.new(0, 0, 0) end
                return
            end

            local delta = goalPos - myRoot.Position
            local dist = delta.Magnitude
            if dist > 10 then
                -- Far away: snap once to catch up (fresh target / area jump)
                LP.Character:PivotTo(CFrame.new(goalPos) * rotGoal)
                myRoot.Velocity = Vector3.new(0, 0, 0)
                _photoFloatBV.Velocity = Vector3.new(0, 0, 0)
            else
                if dist > 0.35 then
                    -- Glide toward the spot instead of hard-teleporting every tick
                    _photoFloatBV.Velocity = delta.Unit * math.clamp(dist * 6, 5, 45)
                else
                    _photoFloatBV.Velocity = Vector3.new(0, 0, 0)
                end
                -- Rotate only, never snap-translate here (no jitter).
                if myRoot.RotVelocity.Magnitude > 0.01 then
                    myRoot.RotVelocity = Vector3.new(0, 0, 0)
                end
                myRoot.CFrame = CFrame.new(myRoot.Position)
                    * (myRoot.CFrame - myRoot.Position):Lerp(rotGoal, 0.3)
            end
        end)
    end
    _photoFollowHeartbeatFn = _hbFn
    _photoFollowConn = game:GetService("RunService").Heartbeat:Connect(_hbFn)
    getgenv()._SKT_PhotoFollowConn = _photoFollowConn
end

