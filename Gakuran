--// ============================ Gakuran World API ============================
-- Built from the live client structure dump (place 128736949265057, ver 7607).
-- Self-contained: does not depend on the xpcall scope above. Exposed globally
-- as getgenv().SKT_Gakuran so other blocks (or the executor console) can call it.
do

local WorkspaceService = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local PlayersService = game:GetService("Players")
local LocalPlayerRef = PlayersService.LocalPlayer

local Gakuran = {}

--// ----- Remote lookup -----
-- Gakuran.Remote("PhotoJobSubmit") searches ReplicatedStorage.Remotes first,
-- then falls back to a full dotted path relative to ReplicatedStorage
-- (e.g. "Shared.Network.CombatClientRemoteEvent").
local function _resolvePath(root, dotted)
    local node = root
    for part in string.gmatch(dotted, "[^%.]+") do
        node = node and node:FindFirstChild(part)
        if not node then return nil end
    end
    return node
end

function Gakuran.Remote(name)
    if typeof(name) ~= "string" or name == "" then return nil end
    local remotes = ReplicatedStorage:FindFirstChild("Remotes")
    local hit = remotes and _resolvePath(remotes, name)
    if hit then return hit end
    return _resolvePath(ReplicatedStorage, name)
end

function Gakuran.Fire(name, ...)
    local remote = Gakuran.Remote(name)
    if not (remote and remote:IsA("RemoteEvent")) then return false, "not a RemoteEvent: " .. tostring(name) end
    return pcall(remote.FireServer, remote, ...)
end

function Gakuran.Invoke(name, ...)
    local remote = Gakuran.Remote(name)
    if not (remote and remote:IsA("RemoteFunction")) then return false, "not a RemoteFunction: " .. tostring(name) end
    return pcall(remote.InvokeServer, remote, ...)
end

--// ----- Blink (Shared.Network.Client) -----
-- Live module exposes 154 events, e.g. JobApplyToShift.Fire({ShiftId=...}),
-- YenAppSendYen.Fire({...}), DemaeSetOnline.Fire({Online=1}).
local _gakBlink = nil
function Gakuran.Blink()
    if _gakBlink then return _gakBlink end
    if getgenv()._SKT_BlinkMod then
        _gakBlink = getgenv()._SKT_BlinkMod
        return _gakBlink
    end
    local mod
    local ok = pcall(function()
        local net = ReplicatedStorage:FindFirstChild("Shared") and ReplicatedStorage.Shared:FindFirstChild("Network")
        mod = net and net:FindFirstChild("Client")
    end)
    if not (ok and typeof(mod) == "Instance" and mod:IsA("ModuleScript")) then
        for _, d in ipairs(ReplicatedStorage:GetDescendants()) do
            if d:IsA("ModuleScript") and d.Name == "Client" and d.Parent and d.Parent.Name == "Network" then
                mod = d
                break
            end
        end
    end
    if not (typeof(mod) == "Instance" and mod:IsA("ModuleScript")) then return nil end
    local ok2, result = pcall(require, mod)
    if ok2 and type(result) == "table" then
        _gakBlink = result
        getgenv()._SKT_BlinkMod = result
        return result
    end
    return nil
end

function Gakuran.BlinkFire(event, args)
    local blink = Gakuran.Blink()
    local ev = blink and blink[event]
    if not (ev and ev.Fire) then return false, "no blink event: " .. tostring(event) end
    return pcall(ev.Fire, args or {})
end

function Gakuran.BlinkOn(event, fn)
    local blink = Gakuran.Blink()
    local ev = blink and blink[event]
    if not (ev and ev.On) then return nil end
    return ev.On(fn)
end

