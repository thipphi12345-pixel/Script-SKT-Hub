Library._SafeGuardController = (function()
    local CHECK_INTERVAL = 0.15
    local TRIGGER_Y = -270
    local TARGET_Y = -260
    local TWEEN_DURATION = 0.35
    local COOLDOWN_DURATION = 0.75

    local Controller = {
        Alive = true,
        Enabled = false,
        Mode = "Safe",
        HeartbeatConnection = nil,
        CharacterAddedConnection = nil,
        CharacterRemovingConnection = nil,
        Tween = nil,
        TweenConnection = nil,
        CheckElapsed = 0,
        CooldownUntil = 0,
    }

    function Controller:_CancelTween()
        local connection = self.TweenConnection
        self.TweenConnection = nil
        if connection then connection:Disconnect() end

        local tween = self.Tween
        self.Tween = nil
        if tween then pcall(function() tween:Cancel() end) end
    end

    function Controller:_Check()
        if not self.Alive or not self.Enabled then return end
        if self.Tween or os.clock() < self.CooldownUntil then return end

        local character = LocalPlayer.Character
        local root = character and character:FindFirstChild("HumanoidRootPart")
        if not root or not root.Parent then return end
        if root.Position.Y >= TRIGGER_Y then return end

        local position = root.Position
        local targetCFrame = CFrame.new(position.X, TARGET_Y, position.Z) * root.CFrame.Rotation
        self.CooldownUntil = os.clock() + COOLDOWN_DURATION

        if self.Mode == "Unsafe" then
            root.CFrame = targetCFrame
            return
        end

        local tween = TweenService:Create(
            root,
            TweenInfo.new(TWEEN_DURATION, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
            { CFrame = targetCFrame }
        )
        self.Tween = tween
        self.TweenConnection = tween.Completed:Connect(function()
            if self.TweenConnection then
                self.TweenConnection:Disconnect()
                self.TweenConnection = nil
            end
            if self.Tween == tween then self.Tween = nil end
        end)
        tween:Play()
    end

    function Controller:_StopHeartbeat()
        if self.HeartbeatConnection then
            self.HeartbeatConnection:Disconnect()
            self.HeartbeatConnection = nil
        end
        self.CheckElapsed = 0
    end

    function Controller:_StartHeartbeat()
        if self.HeartbeatConnection then return end
        self.CheckElapsed = CHECK_INTERVAL
        self.HeartbeatConnection = RunService.Heartbeat:Connect(function(deltaTime)
            if not self.Alive or not self.Enabled then return end
            self.CheckElapsed += deltaTime
            if self.CheckElapsed < CHECK_INTERVAL then return end
            self.CheckElapsed = 0
            self:_Check()
        end)
    end

    function Controller:SetEnabled(enabled)
        if not self.Alive then return end
        self.Enabled = enabled == true
        if self.Enabled then
            self:_StartHeartbeat()
        else
            self:_StopHeartbeat()
            self:_CancelTween()
            self.CooldownUntil = 0
        end
    end

    function Controller:SetMode(mode)
        self.Mode = mode == "Unsafe" and "Unsafe" or "Safe"
    end

    function Controller:BuildUI(tab)
        local group = tab:AddLeftGroupbox("Safe Guard")
        group:AddToggle("SafeGuard", {
            Text = "Safe Guard",
            Default = false,
            Tooltip = "Recover the character when HumanoidRootPart falls below Y -270.",
            Callback = function(enabled)
                Controller:SetEnabled(enabled)
            end,
        })
        group:AddDropdown("SafeGuardMode", {
            Text = "Mode",
            Values = { "Safe", "Unsafe" },
            Default = "Safe",
            Tooltip = "Safe tweens to the recovery height; Unsafe moves immediately.",
            Callback = function(value)
                Controller:SetMode(value)
            end,
        })
    end

    function Controller:Destroy()
        self.Alive = false
        self.Enabled = false
        self:_StopHeartbeat()
        self:_CancelTween()
        self.CooldownUntil = 0
        if self.CharacterAddedConnection then
            self.CharacterAddedConnection:Disconnect()
            self.CharacterAddedConnection = nil
        end
        if self.CharacterRemovingConnection then
            self.CharacterRemovingConnection:Disconnect()
            self.CharacterRemovingConnection = nil
        end
    end

    local function ResetCharacterState()
        if not Controller.Alive then return end
        Controller:_CancelTween()
        Controller.CooldownUntil = 0
        Controller.CheckElapsed = CHECK_INTERVAL
    end

    Controller.CharacterAddedConnection = LocalPlayer.CharacterAdded:Connect(ResetCharacterState)
    Controller.CharacterRemovingConnection = LocalPlayer.CharacterRemoving:Connect(ResetCharacterState)

    return Controller
end)()

--// WARP: fF Area Teleport
Library._AreaTeleportController = (function()
    local Controller = { Areas = {}, Dropdown = nil, SuppressTeleport = true }

    local function GetAreaFolder()
        local hitboxes = game:GetService("Workspace"):FindFirstChild("AreaHitboxes")
        return hitboxes and hitboxes:FindFirstChild("Nishikata High")
    end

    local function GetAreaName(part, folder)
        local parent = part.Parent
        if not parent or parent == folder then return part.Name end
        local names = {}
        while parent and parent ~= folder do
            table.insert(names, 1, parent.Name)
            parent = parent.Parent
        end
        return table.concat(names, "/")
    end

    function Controller:Refresh()
        local folder = GetAreaFolder()
        local bestByName = {}
        table.clear(self.Areas)

        if folder then
            for _, part in ipairs(folder:GetDescendants()) do
                if part:IsA("BasePart") then
                    local name = GetAreaName(part, folder)
                    local volume = part.Size.X * part.Size.Y * part.Size.Z
                    local current = bestByName[name]
                    if name ~= "" and (not current or volume > current.Volume) then
                        bestByName[name] = { Part = part, Volume = volume }
                    end
                end
            end
        end

        local names = {}
        for name, entry in pairs(bestByName) do
            self.Areas[name] = entry.Part
            table.insert(names, name)
        end
        table.sort(names, function(a, b) return string.lower(a) < string.lower(b) end)
        if #names == 0 then names[1] = "No Areas Found" end

        if self.Dropdown then
            self.SuppressTeleport = true
            pcall(function()
                self.Dropdown:SetValues(names)
                self.Dropdown:SetDisabledValues(#names == 1 and names[1] == "No Areas Found" and names or {})
            end)
            self.SuppressTeleport = false
        end
        return names
    end

    function Controller:Teleport(name)
        local part = self.Areas[name]
        local character = LocalPlayer.Character
        local root = character and character:FindFirstChild("HumanoidRootPart")
        if not part or not part.Parent then
            Library:Notify({ Title = "Area Teleport", Description = "That area is no longer available.", Time = 3 })
            self:Refresh()
            return
        end
        if not root then
            Library:Notify({ Title = "Area Teleport", Description = "Character is not ready.", Time = 3 })
            return
        end
        root.CFrame = part.CFrame * CFrame.new(0, 3, 0)
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
    end

    function Controller:BuildUI(tab)
        local group = tab:AddLeftGroupbox("Area Teleport")
        local names = self:Refresh()
        group:AddLabel("Uses the game's live area hitboxes. Duplicate parts are merged into one area.", true)
        self.Dropdown = group:AddDropdown("AreaTeleport", {
            Text = "Area",
            Values = names,
            Default = names[1],
            DisabledValues = names[1] == "No Areas Found" and names or {},
            Tooltip = "Teleport to the selected area.",
            Callback = function(value)
                if not Controller.SuppressTeleport and value ~= "No Areas Found" then
                    Controller:Teleport(value)
                end
            end,
        })
        task.defer(function() Controller.SuppressTeleport = false end)
        group:AddButton({ Text = "Refresh Areas", Func = function() Controller:Refresh() end })
    end

    function Controller:Destroy()
        table.clear(self.Areas)
        self.Dropdown = nil
    end

    return Controller
end)()

