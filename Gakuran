--// Yen Transfer — 100% Natural Human UI Flow + Auto Re-Equip & Re-Open Watchdog
local _yenTransferRunning = false

local function _findPhoneGui()
    local pg = game:GetService("Players").LocalPlayer:FindFirstChild("PlayerGui")
    return pg and pg:FindFirstChild("FlipPhoneGui")
end

local function _isHoldingPhone()
    local char = game:GetService("Players").LocalPlayer.Character
    if not char then return false end
    return char:GetAttribute("ItemEquipped") == "FlipPhone"
end

local function _isPhoneOpen()
    local gui = _findPhoneGui()
    if not gui or not gui.Enabled then return false end
    local anchor = gui:FindFirstChild("PhoneAnchor")
    if not anchor or not anchor.Visible then return false end
    return true
end

-- จำลองการกดปุ่มแบบคนเล่นจริง (Human Click/Tap)
local function _clickBtn(btn)
    if not btn then return false end
    pcall(function()
        local center = btn.AbsolutePosition + (btn.AbsoluteSize / 2)
        local touchPosTable = { [1] = center }
        
        if typeof(firesignal) == "function" then
            pcall(firesignal, btn.InputBegan, { UserInputType = Enum.UserInputType.Touch, UserInputState = Enum.UserInputState.Begin })
            pcall(firesignal, btn.MouseButton1Down)
            pcall(firesignal, btn.TouchTap, touchPosTable, false)
            pcall(firesignal, btn.Activated)
            pcall(firesignal, btn.MouseButton1Click)
            pcall(firesignal, btn.MouseButton1Up)
            pcall(firesignal, btn.InputEnded, { UserInputType = Enum.UserInputType.Touch, UserInputState = Enum.UserInputState.End })
        end

        if typeof(getconnections) == "function" then
            for _, sig in ipairs({"TouchTap", "Activated", "MouseButton1Click", "MouseButton1Down", "MouseButton1Up"}) do
                if btn[sig] then
                    for _, c in ipairs(getconnections(btn[sig]) or {}) do
                        pcall(c.Fire, c, touchPosTable, false)
                        pcall(c.Fire, c)
                    end
                end
            end
        end
    end)
    return true
end

-- พิมพ์ข้อความลง TextBox และกด Enter แบบธรรมชาติ
local function _typeInputText(textBox, text, pressEnter)
    if not textBox then return false end
    pressEnter = pressEnter ~= false
    pcall(function()
        if typeof(textBox.CaptureFocus) == "function" then
            pcall(textBox.CaptureFocus, textBox)
            task.wait(0.08)
        end
        textBox.Text = tostring(text)
        task.wait(0.08)
        if typeof(textBox.ReleaseFocus) == "function" then
            pcall(textBox.ReleaseFocus, textBox, pressEnter)
        end
        if typeof(firesignal) == "function" then
            pcall(firesignal, textBox.FocusLost, pressEnter, Enum.KeyCode.Return)
            pcall(firesignal, textBox.FocusLost, pressEnter)
        end
        if typeof(getconnections) == "function" then
            for _, c in ipairs(getconnections(textBox.FocusLost) or {}) do
                pcall(c.Fire, c, pressEnter, Enum.KeyCode.Return)
                pcall(c.Fire, c, pressEnter)
            end
        end
    end)
    return true
end

-- =========================================================================
--  Step 1: ถือและเปิดมือถือ (Equip & Open Phone)
-- =========================================================================
local function _equipPhone()
    local lp = game:GetService("Players").LocalPlayer
    local char = lp.Character
    if not char then return false end
    
    if char:GetAttribute("ItemEquipped") ~= "FlipPhone" then
        pcall(function()
            local rs = game:GetService("ReplicatedStorage")
            local remotes = rs:FindFirstChild("Remotes")
            if remotes then
                if remotes:FindFirstChild("ItemSelect") then remotes.ItemSelect:FireServer("FlipPhone") end
                if remotes:FindFirstChild("ItemEquip") then remotes.ItemEquip:FireServer("FlipPhone") end
            end
        end)
        pcall(function()
            local backpack = lp:FindFirstChild("Backpack")
            if backpack and char and char:FindFirstChild("Humanoid") then
                for _, item in ipairs(backpack:GetChildren()) do
                    if item:IsA("Tool") and (item.Name:lower():find("phone") or item.Name:lower():find("flip")) then
                        char.Humanoid:EquipTool(item)
                        break
                    end
                end
            end
        end)
    end
    return char:GetAttribute("ItemEquipped") == "FlipPhone"
end

local function _openPhone()
    local gui = _findPhoneGui()
    if not gui then return false end

    _equipPhone()

    local uis = game:GetService("UserInputService")
    local isMobile = uis.TouchEnabled or uis.PreferredInput == Enum.PreferredInput.Touch
    local lp = game:GetService("Players").LocalPlayer

    if isMobile then
        local pg = lp:FindFirstChild("PlayerGui")
        if pg then
            pcall(function()
                local cas = game:GetService("ContextActionService")
                for actionName, info in pairs(cas:GetAllBoundActionInfo()) do
                    local aName = tostring(actionName):lower()
                    local title = typeof(info) == "table" and tostring(info.title or ""):lower() or ""
                    if aName:find("phone") or aName:find("flip") or title:find("phone") then
                        cas:CallFunction(actionName, Enum.UserInputState.Begin, nil)
                        task.wait(0.04)
                        cas:CallFunction(actionName, Enum.UserInputState.End, nil)
                    end
                end
            end)
            for _, d in ipairs(pg:GetDescendants()) do
                if (d:IsA("GuiButton") or d:IsA("ImageButton") or d:IsA("TextButton")) and d.Visible then
                    local n = d.Name:lower()
                    local t = d:IsA("TextButton") and tostring(d.Text):lower() or ""
                    local isPhone = n:find("phone") or n:find("flip") or t:find("phone") or t:find("📱")
                    if not isPhone then
                        for _, c in ipairs(d:GetChildren()) do
                            if c:IsA("TextLabel") and (c.Text:lower():find("phone") or c.Text:find("📱")) then
                                isPhone = true
                                break
                            elseif c:IsA("ImageLabel") and c.Image:lower():find("phone") then
                                isPhone = true
                                break
                            end
                        end
                    end
                    if isPhone and not n:find("skt") then
                        _clickBtn(d)
                    end
                end
            end
        end
    else
        pcall(function()
            local vim = game:GetService("VirtualInputManager")
            vim:SendKeyEvent(true, Enum.KeyCode.LeftAlt, false, game)
            task.wait(0.04)
            vim:SendKeyEvent(false, Enum.KeyCode.LeftAlt, false, game)
        end)
    end

    pcall(function()
        gui.Enabled = true
        local anchor = gui:FindFirstChild("PhoneAnchor")
        if anchor then anchor.Visible = true end
    end)

    return true
end

-- ระบบ Watchdog: ตรวจสอบและบังคับให้ถือมือถือ + เปิดหน้าจอมือถืออยู่เสมอ (แม้โดนต่อยหลุดมือ)
local function _ensurePhoneOpenAndHeld()
    local char = game:GetService("Players").LocalPlayer.Character
    if not char then return false end

    -- 1. เช็คว่าถือมือถืออยู่ไหม ถ้าหลุดจากการโดนต่อย ให้ถือใหม่ทันที
    if char:GetAttribute("ItemEquipped") ~= "FlipPhone" then
        _openPhone()
        task.wait(0.25)
    end

    -- 2. เช็คว่าหน้าจอมือถือเปิดอยู่ไหม ถ้าปิดอยู่ ให้เปิดใหม่ทันที
    if not _isPhoneOpen() then
        _openPhone()
        task.wait(0.3)
    end

    return _isPhoneOpen()
end

-- =========================================================================
--  Step 2: เข้าแอพ YenApp ตามลำดับปุ่มจริงของเกม
-- =========================================================================
local function _openYenApp()
    local gui = _findPhoneGui()
    if not gui then return false end
    local contentArea = gui:FindFirstChild("PhoneAnchor") and gui.PhoneAnchor:FindFirstChild("ContentArea") or gui

    local mainPage = contentArea:FindFirstChild("YenAppMainPage", true)
    if mainPage and mainPage.Visible then return true end

    -- 1. อยู่ที่ HomePage ให้กดปุ่ม HomeMenuButton ("▼ MENU")
    local homePage = contentArea:FindFirstChild("HomePage", true)
    if homePage and homePage.Visible then
        local menuBtn = homePage:FindFirstChild("HomeMenuButton", true) or homePage:FindFirstChild("MenuButton", true)
        if not menuBtn then
            for _, d in ipairs(homePage:GetDescendants()) do
                if (d:IsA("GuiButton") or d:IsA("TextButton") or d:IsA("ImageButton")) and (d.Name:lower():find("menu") or (d:IsA("TextButton") and d.Text:lower():find("menu"))) then
                    menuBtn = d
                    break
                end
            end
        end
        if menuBtn then
            _clickBtn(menuBtn)
            task.wait(0.35)
        end
    end

    -- 2. อยู่ที่ MenuPage ให้กดปุ่ม YENAPP
    local menuPage = contentArea:FindFirstChild("MenuPage", true)
    if menuPage and menuPage.Visible then
        local yenBtn = menuPage:FindFirstChild("YENAPP", true) or menuPage:FindFirstChild("YenApp", true)
        if not yenBtn then
            for _, d in ipairs(menuPage:GetDescendants()) do
                if (d:IsA("GuiButton") or d:IsA("TextButton") or d:IsA("ImageButton")) and (d.Name:lower():find("yen") or (d:IsA("TextButton") and d.Text:lower():find("yen"))) then
                    yenBtn = d
                    break
                end
            end
        end
        if yenBtn then
            _clickBtn(yenBtn)
            task.wait(0.35)
        end
    end

    mainPage = contentArea:FindFirstChild("YenAppMainPage", true)
    return mainPage and mainPage.Visible
end

