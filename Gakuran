    function Tab:SetStatusProgress(label, have, need)
        local card = label and label.Parent
        local track = card and card:FindFirstChild("ProgressTrack")
        if not track then return end
        have, need = tonumber(have), tonumber(need)
        track.Visible = have ~= nil and need ~= nil and need > 0
        local badge = card.StatusHeader.Badge
        local badgeStroke = badge:FindFirstChild("BadgeStroke")
        if not track.Visible then
            badge.Text = "STATUS"
            badge.TextColor3 = Theme.AccentSoft
            badge.BackgroundColor3 = Theme.AccentDeep
            badge.BackgroundTransparency = 0.55
            if badgeStroke then
                badgeStroke.Color = Theme.Accent
                badgeStroke.Transparency = 0.55
            end
            card.StatusHeader.Indicator.BackgroundColor3 = Theme.Accent
            return
        end
        local fraction = math.clamp(have / need, 0, 1)
        local complete = fraction >= 1
        badge.Text = complete and "COMPLETE" or (tostring(math.floor(fraction * 100)) .. "%")
        badge.TextColor3 = complete and Theme.Success or Theme.AccentSoft
        badge.BackgroundColor3 = complete and Theme.Success or Theme.AccentDeep
        badge.BackgroundTransparency = complete and 0.78 or 0.55
        if badgeStroke then
            badgeStroke.Color = complete and Theme.Success or Theme.Accent
            badgeStroke.Transparency = complete and 0.35 or 0.55
        end
        card.StatusHeader.Indicator.BackgroundColor3 = complete and Theme.Success or Theme.Accent
        local targetColor = fraction >= 1 and Theme.Success or Theme.Accent
        local targetSize = UDim2.fromScale(fraction, 1)
        if track.ProgressFill.Size == targetSize and track.ProgressFill.BackgroundColor3 == targetColor then return end
        if self.Window and not self.Window.Visible then
            track.ProgressFill.Size = targetSize
            track.ProgressFill.BackgroundColor3 = targetColor
        else
            tween(track.ProgressFill, 0.28, {
                Size = targetSize, BackgroundColor3 = targetColor,
            }, Enum.EasingStyle.Quart)
        end
    end

