            local position = 1 + (#sorted - 1) * ratio
            local lower = math.floor(position)
            local upper = math.ceil(position)
            if lower == upper then return sorted[lower] end
            local weight = position - lower
            return sorted[lower] * (1 - weight) + sorted[upper] * weight
        end
        local median = quantile(0.5)
        local deviations = table.create(#sorted)
        for index, value in ipairs(sorted) do deviations[index] = math.abs(value - median) end
        table.sort(deviations)
        local middle = 1 + (#deviations - 1) * 0.5
        local lower, upper = math.floor(middle), math.ceil(middle)
        local mad = lower == upper and deviations[lower]
            or (deviations[lower] + deviations[upper]) * 0.5
        return {
            count = #sorted,
            median = median,
            p75 = quantile(0.75),
            p90 = quantile(0.90),
            mad = mad,
            minimum = sorted[1],
            maximum = sorted[#sorted],
