    function R:_diagnosticTimingEvidence(
        model,
        profile,
        context,
        attempt,
        trackPosition,
        trackSpeed,
        predictedImpactAt,
        now
    )
        local playerData = model and model:FindFirstChild("PlayerData")
        local currentHeight = playerData
            and tonumber(playerData:GetAttribute("CurrentHeight")) or nil
        local storedHeight = playerData
            and tonumber(playerData:GetAttribute("Height")) or nil
        local resolvedHeight = currentHeight or storedHeight
        local heightSource = currentHeight and "PlayerData.CurrentHeight"
            or (storedHeight and "PlayerData.Height" or "Unavailable")
        local heightMultiplier
        local multiplierSource = "Default"
        local combatUtils = _combatUtils
        if combatUtils then
            local ok, combatHeight, multiplier = pcall(function()
                local height = combatUtils.GetCharacterHeight(model)
                if typeof(height) ~= "number" then return nil, nil end
                return height, combatUtils.GetAttackSpeedMultiplier(height)
            end)
            if ok then
                if typeof(combatHeight) == "number" then
                    resolvedHeight = combatHeight
                    heightSource = "CombatUtils.GetCharacterHeight"
                end
                if typeof(multiplier) == "number" and multiplier > 0 then
                    heightMultiplier = multiplier
                    multiplierSource = "CombatUtils.GetAttackSpeedMultiplier"
                end
            end
        end
        if not heightMultiplier then
            local profileSpeed = profile and tonumber(profile.attackSpeed)
            heightMultiplier = profileSpeed and profileSpeed > 0 and profileSpeed or 1
            multiplierSource = profileSpeed and profileSpeed > 0
                and "ProfileAttackSpeed" or "Default1"
        end

        local styleKey = (profile and profile.styleKey) or (attempt and attempt.styleKey)
            or (model and styleOf(model)) or "default"
        local attackType = context.attackType or (profile and profile.attackType) or "M1"
        local comboIndex = math.clamp(math.floor(tonumber(
            (profile and profile.comboIndex) or context.comboIndex or 1
        ) or 1), 1, 4)
        local baseDelay, scaledDelay
        if CombatConfig then
            if attackType == "M2"
                and typeof(CombatConfig.GetStyleM2HitboxDelay) == "function" then
                local momentum = model and model:GetAttribute("HakariM2DoubleWindow") == true
                local okBase, value = pcall(
                    CombatConfig.GetStyleM2HitboxDelay,
                    styleKey,
                    momentum
                )
                if okBase and typeof(value) == "number" and value >= 0 then
                    baseDelay = value
                    if typeof(CombatConfig.GetScaledHitboxDelay) == "function" then
                        local okScaled, scaled = pcall(
                            CombatConfig.GetScaledHitboxDelay,
                            value,
                            heightMultiplier
                        )
                        if okScaled and typeof(scaled) == "number" then
                            scaledDelay = scaled
                        end
                    end
                end
            elseif attackType == "M1"
                and typeof(CombatConfig.GetScaledStyleM1HitboxDelay) == "function" then
                local styleData
                if typeof(CombatConfig.GetStyleConfig) == "function" then
                    local okStyle, value = pcall(CombatConfig.GetStyleConfig, styleKey)
                    if okStyle and type(value) == "table" then styleData = value end
                end
                local defaultDelay = CombatConfig.M1
                    and tonumber(CombatConfig.M1.DefaultHitboxDelay) or 0.32
                local styleDelay = type(styleData) == "table"
                    and tonumber(styleData.M1HitboxDelay) or nil
                local offset = 0
                if typeof(CombatConfig.GetStyleM1HitboxDelayOffset) == "function" then
                    local okOffset, value = pcall(
                        CombatConfig.GetStyleM1HitboxDelayOffset,
                        styleKey,
                        comboIndex
                    )
                    if okOffset and typeof(value) == "number" then offset = value end
                end
                baseDelay = math.max(0, (styleDelay or defaultDelay) + offset)
                local okScaled, scaled = pcall(
                    CombatConfig.GetScaledStyleM1HitboxDelay,
                    styleKey,
                    comboIndex,
                    heightMultiplier
                )
                if okScaled and typeof(scaled) == "number" then scaledDelay = scaled end
            end
        end

        local maxOneWay = 0.35
        local pingConfig = CombatConfig and CombatConfig.Shared
            and CombatConfig.Shared.NetworkAnimPingCompensation
        if type(pingConfig) == "table"
            and typeof(pingConfig.MaxEstimatedOneWaySeconds) == "number" then
            maxOneWay = pingConfig.MaxEstimatedOneWaySeconds
        end
        local estimatedOneWay = math.clamp(self.PingEMA * 0.5, 0, maxOneWay)
        local pingMultiplier = scaledDelay and scaledDelay > 0
            and scaledDelay / (scaledDelay + estimatedOneWay) or nil
        local expectedTrackSpeed = pingMultiplier and heightMultiplier * pingMultiplier or nil
        local impactPosition = profile and tonumber(profile.impactPosition)
        local trackRemaining = impactPosition and trackPosition and trackSpeed
            and math.abs(trackSpeed) > 0
            and (impactPosition - trackPosition) / math.abs(trackSpeed) or nil
        local learnedLead = tonumber(context.learnedLead
            or (attempt and attempt.learnedLead)) or 0
        local timingSource = trackRemaining and "AnimationTrack"
            or (profile and tostring(profile.source))
            or (baseDelay and "CombatConfig" or tostring(context.sourceClass or "Unknown"))
        if math.abs(learnedLead) > 0.000001 then
            timingSource ..= "+Learned"
        end

        return {
            source = timingSource,
            layers = {
                animationTrack = trackRemaining ~= nil,
                combatConfig = baseDelay ~= nil,
                learned = math.abs(learnedLead) > 0.000001,
            },
            style = styleKey,
            attackType = attackType,
            comboIndex = attackType == "M1" and comboIndex or nil,
            playerDataCurrentHeight = currentHeight,
            playerDataHeight = storedHeight,
            resolvedHeight = resolvedHeight,
            heightSource = heightSource,
            heightMultiplier = heightMultiplier,
            heightMultiplierSource = multiplierSource,
            combatConfigBaseDelayMs = baseDelay and baseDelay * 1000 or nil,
            combatConfigScaledDelayMs = scaledDelay and scaledDelay * 1000 or nil,
            estimatedOneWayPingMs = estimatedOneWay * 1000,
            estimatedPingAnimationMultiplier = pingMultiplier,
            expectedTrackSpeed = expectedTrackSpeed,
            observedTrackSpeed = trackSpeed,
            observedVsExpectedSpeed = trackSpeed and expectedTrackSpeed
                and trackSpeed - expectedTrackSpeed or nil,
            impactPosition = impactPosition,
            trackPosition = trackPosition,
            trackRemainingToImpactMs = trackRemaining and trackRemaining * 1000 or nil,
            calculatedImpactInMs = trackRemaining and trackRemaining * 1000
                or (predictedImpactAt and (predictedImpactAt - now) * 1000 or nil),
        }
    end

