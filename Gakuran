Library._Performance:Track(UserInputService.InputBegan:Connect(function(input)
    if input.UserInputType ~= Enum.UserInputType.Keyboard
        or input.KeyCode == Enum.KeyCode.Unknown
        or Library._IsUserTyping()
        or (Library.Window and Library.Window.CapturingKeybind)
        or os.clock() - (tonumber(Library._KeybindReboundAt) or 0) < 0.12 then
        return
    end

    local keyName = input.KeyCode.Name
    local menuBind = Options.MenuKeybind
    local menuVal = menuBind and tostring(menuBind.Value)
    local windowToggleKey = Library.Window and Library.Window.ToggleKey

    -- Handle Menu Keybind (e.g. RightShift) to toggle UI
    if (menuVal and menuVal == keyName) 
        or (windowToggleKey and input.KeyCode == windowToggleKey)
        or (not menuVal and not windowToggleKey and input.KeyCode == Enum.KeyCode.RightShift) then
        if Library.Window then
            Library.Window:Toggle()
        end
        return
    end

    for _, binding in ipairs(Library._FeatureKeybinds) do
        local option = Options[binding.option]
        if option and tostring(option.Value) == keyName then
            local toggle = Toggles[binding.toggle]
            if toggle and toggle.SetValue then
                toggle:SetValue(toggle.Value ~= true)
            end
            return
        end
    end
end))

--// WARP: Player Movement
Library._MovementController = (function()
    local Movement = {}
    local ContextActionService = game:GetService("ContextActionService")
    local movementConnection
    local movementAccumulator = 0
    local movementState = {
        walkSpeed = false,
        fly = false,
        noClip = false,
        flyUp = false,
        flyDown = false,
    }
    local originalWalkSpeeds = setmetatable({}, { __mode = "k" })
    local originalCollisions = setmetatable({}, { __mode = "k" })
    local noClipParts = setmetatable({}, { __mode = "k" })
    local desiredNoClipParts = setmetatable({}, { __mode = "k" })
    local noClipPartConnections = setmetatable({}, { __mode = "k" })
    local connectedNoClipCharacters = setmetatable({}, { __mode = "k" })
    local noClipCharacter
    local noClipAddedConnection
    local noClipRemovingConnection
    local noClipSimulationConnection
    local characterConnection
    local FLY_UP_ACTION = "InteriumFlyUp"
    local FLY_DOWN_ACTION = "InteriumFlyDown"
    local MAX_NO_CLIP_CARRY_ASSEMBLY_PARTS = 128

    local function RestoreWalkSpeed()
        for humanoid, value in pairs(originalWalkSpeeds) do
            if humanoid.Parent then
                humanoid.WalkSpeed = value
            end
        end
        table.clear(originalWalkSpeeds)
    end

    local function DisconnectNoClipPartWatcher(part)
        local connection = noClipPartConnections[part]
        if connection then
            connection:Disconnect()
            noClipPartConnections[part] = nil
        end
    end

    local function DisconnectAllNoClipPartWatchers()
        for _, connection in pairs(noClipPartConnections) do
            connection:Disconnect()
        end
        table.clear(noClipPartConnections)
    end

    local function RestoreCollisions()
        table.clear(noClipParts)
        DisconnectAllNoClipPartWatchers()
        for part, value in pairs(originalCollisions) do
            if part.Parent then
                part.CanCollide = value
            end
        end
        table.clear(originalCollisions)
    end

    local function DisconnectNoClipCharacter()
        if noClipAddedConnection then
            noClipAddedConnection:Disconnect()
            noClipAddedConnection = nil
        end
        if noClipRemovingConnection then
            noClipRemovingConnection:Disconnect()
            noClipRemovingConnection = nil
        end
        noClipCharacter = nil
        table.clear(noClipParts)
        table.clear(desiredNoClipParts)
        table.clear(connectedNoClipCharacters)
    end

    local function RestoreNoClipPart(part)
        noClipParts[part] = nil
        DisconnectNoClipPartWatcher(part)
        local original = originalCollisions[part]
        if original ~= nil and part.Parent then
            part.CanCollide = original
        end
        originalCollisions[part] = nil
    end

    local function TrackNoClipPart(instance)
        if not movementState.noClip or not instance:IsA("BasePart") then return end
        noClipParts[instance] = true

        if originalCollisions[instance] == nil then
            originalCollisions[instance] = instance.CanCollide
        end

        if not noClipPartConnections[instance] then
            noClipPartConnections[instance] =
                instance:GetPropertyChangedSignal("CanCollide"):Connect(function()
                    if movementState.noClip
                        and noClipParts[instance]
                        and instance.Parent
                        and instance.CanCollide then
                        instance.CanCollide = false
                    end
                end)
        end

        if instance.CanCollide then
            instance.CanCollide = false
        end
    end

    local function CharacterModelOfPart(part)
        local ancestor = part.Parent
        while ancestor and ancestor ~= Workspace do
            if ancestor:IsA("Model") and ancestor:FindFirstChildOfClass("Humanoid") then
                return ancestor
            end
            ancestor = ancestor.Parent
        end
        return nil
    end

    local function EnforceNoClipParts()
        if not movementState.noClip then return end
        for part in pairs(noClipParts) do
            if part.Parent then
                if originalCollisions[part] == nil then
                    originalCollisions[part] = part.CanCollide
                end
                if part.CanCollide then part.CanCollide = false end
            else
                RestoreNoClipPart(part)
            end
        end
    end

    local function RefreshNoClipParts(character)
        table.clear(desiredNoClipParts)
        table.clear(connectedNoClipCharacters)

        for _, descendant in ipairs(character:GetDescendants()) do
            if descendant:IsA("BasePart") then
                desiredNoClipParts[descendant] = true
            end
        end

        local hasCarryTarget = false
        local states = character:FindFirstChild("States")
        local carrying = states and states:FindFirstChild("Carrying")
        if carrying and carrying:IsA("ObjectValue") then
            local carriedCharacter = carrying.Value
            if carriedCharacter
                and carriedCharacter:IsA("Model")
                and carriedCharacter.Parent
                and carriedCharacter:FindFirstChildOfClass("Humanoid")
                and carriedCharacter ~= character then
                connectedNoClipCharacters[carriedCharacter] = true
                hasCarryTarget = true
            end
        end

        local root = character:FindFirstChild("HumanoidRootPart")
        if root and root:IsA("BasePart") then
            local carryWeld = root:FindFirstChild("CarryWeld")
            if carryWeld
                and (carryWeld:IsA("Weld") or carryWeld:IsA("WeldConstraint"))
                and carryWeld.Part1 then
                local carriedCharacter = CharacterModelOfPart(carryWeld.Part1)
                if carriedCharacter and carriedCharacter ~= character then
                    connectedNoClipCharacters[carriedCharacter] = true
                    hasCarryTarget = true
                end
            end

            local ok, connectedParts = pcall(root.GetConnectedParts, root, true)
            if ok then
                for _, part in ipairs(connectedParts) do
                    local connectedCharacter = CharacterModelOfPart(part)
                    if connectedCharacter and connectedCharacter ~= character then
                        connectedNoClipCharacters[connectedCharacter] = true
                        hasCarryTarget = true
                    end
                end

                if hasCarryTarget and #connectedParts <= MAX_NO_CLIP_CARRY_ASSEMBLY_PARTS then
                    for _, part in ipairs(connectedParts) do
                        if not part.Anchored then
                            desiredNoClipParts[part] = true
                        end end end end end

        for connectedCharacter in pairs(connectedNoClipCharacters) do
            for _, descendant in ipairs(connectedCharacter:GetDescendants()) do
                if descendant:IsA("BasePart") then
                    desiredNoClipParts[descendant] = true
                end
            end
        end

        for part in pairs(noClipParts) do
            if not desiredNoClipParts[part] then
                RestoreNoClipPart(part)
            end
        end
        for part in pairs(desiredNoClipParts) do
            TrackNoClipPart(part)
        end
    end

    local function BindNoClipCharacter(character)
        if character == noClipCharacter then
            if character then RefreshNoClipParts(character) end
            return
        end
        if noClipCharacter then RestoreCollisions() end
        DisconnectNoClipCharacter()
        if not character then return end

        noClipCharacter = character
        RefreshNoClipParts(character)
        noClipAddedConnection = character.DescendantAdded:Connect(function(descendant)
            if descendant:IsA("BasePart") then
                TrackNoClipPart(descendant)
            elseif descendant:IsA("JointInstance") or descendant:IsA("WeldConstraint") then
                task.defer(function()
                    if movementState.noClip and noClipCharacter == character then
                        RefreshNoClipParts(character)
                        EnforceNoClipParts()
                    end
                end)
            end
        end)
        noClipRemovingConnection = character.DescendantRemoving:Connect(function(descendant)
            if descendant:IsA("BasePart") then RestoreNoClipPart(descendant) end
        end)
    end

    local function UpdateMovementLoop()
        local active = movementState.walkSpeed or movementState.fly or movementState.noClip

        if active and not movementConnection then
            movementAccumulator = 0
            movementConnection = RunService.Heartbeat:Connect(function(deltaTime)
                local character = LocalPlayer.Character
                local humanoid = character and character:FindFirstChildOfClass("Humanoid")
                local root = character and character:FindFirstChild("HumanoidRootPart")
                if not (character and humanoid and root) then
                    return
                end

                if movementState.fly then
                    local speed = tonumber(Options.FlySpeedValue and Options.FlySpeedValue.Value) or 50
                    local vertical = (movementState.flyUp and 1 or 0) - (movementState.flyDown and 1 or 0)
                    root.AssemblyLinearVelocity =
                        humanoid.MoveDirection * speed + Vector3.new(0, vertical * speed, 0)
                    root.AssemblyAngularVelocity = Vector3.zero
                end

                if movementState.walkSpeed and not _sktIsEmoting(character) then
                    if originalWalkSpeeds[humanoid] == nil then
                        originalWalkSpeeds[humanoid] = humanoid.WalkSpeed
                    end

                    local target = tonumber(Options.WalkSpeedValue and Options.WalkSpeedValue.Value) or 24
                    if humanoid.WalkSpeed ~= target then
                        humanoid.WalkSpeed = target
                    end

                    local state = humanoid:GetState()
                    local direction = humanoid.MoveDirection
                    if not movementState.fly
                        and direction.Magnitude > 0.01
                        and humanoid.FloorMaterial ~= Enum.Material.Air
                        and (state == Enum.HumanoidStateType.Running
                            or state == Enum.HumanoidStateType.RunningNoPhysics) then
                        local velocity = root.AssemblyLinearVelocity
                        local horizontal = direction.Unit * target
                        root.AssemblyLinearVelocity =
                            Vector3.new(horizontal.X, velocity.Y, horizontal.Z)
                    end
                end

                movementAccumulator += deltaTime
                if movementAccumulator < 0.1 then
                    return
                end
                movementAccumulator = 0

                if movementState.noClip then
                    if noClipCharacter ~= character then
                        BindNoClipCharacter(character)
                    else
                        RefreshNoClipParts(character)
                    end
                    EnforceNoClipParts()
                end
            end)
        elseif not active and movementConnection then
            movementConnection:Disconnect()
            movementConnection = nil
        end
    end

    local function RebindCharacter(character)
        if not character then
            return
        end
        if movementState.noClip then
            BindNoClipCharacter(character)
        end

        task.defer(function()
            local humanoid =
                character:FindFirstChildOfClass("Humanoid")
                or character:WaitForChild("Humanoid", 3)

            if humanoid and movementState.walkSpeed then
                if originalWalkSpeeds[humanoid] == nil then
                    originalWalkSpeeds[humanoid] = humanoid.WalkSpeed
                end
                humanoid.WalkSpeed =
                    tonumber(Options.WalkSpeedValue and Options.WalkSpeedValue.Value) or 24
            end

            if movementState.noClip then
                for part in pairs(noClipParts) do
                    if part.Parent then TrackNoClipPart(part) end
                end
            end
        end)
    end

    local function StartWalkSpeed()
        movementState.walkSpeed = true
        UpdateMovementLoop()
    end

    local function StopWalkSpeed()
        movementState.walkSpeed = false
        RestoreWalkSpeed()
        UpdateMovementLoop()
    end

    local function FlyVerticalAction(actionName, inputState)
        local pressed =
            inputState == Enum.UserInputState.Begin
            or inputState == Enum.UserInputState.Change

        if actionName == FLY_UP_ACTION then
            movementState.flyUp = pressed
        else
            movementState.flyDown = pressed
        end
        return Enum.ContextActionResult.Sink
    end

    local function StartFly()
        if movementState.fly then
            return
        end

        movementState.fly = true
        ContextActionService:BindAction(
            FLY_UP_ACTION,
            FlyVerticalAction,
            true,
            Enum.KeyCode.Space,
            Enum.KeyCode.ButtonA
        )
        ContextActionService:BindAction(
            FLY_DOWN_ACTION,
            FlyVerticalAction,
            true,
            Enum.KeyCode.LeftControl,
            Enum.KeyCode.ButtonB
        )
        ContextActionService:SetTitle(FLY_UP_ACTION, "UP")
        ContextActionService:SetTitle(FLY_DOWN_ACTION, "DOWN")
        ContextActionService:SetPosition(FLY_UP_ACTION, UDim2.new(1, -150, 1, -210))
        ContextActionService:SetPosition(FLY_DOWN_ACTION, UDim2.new(1, -75, 1, -210))
        UpdateMovementLoop()
    end

    local function StopFly()
        movementState.fly = false
        movementState.flyUp = false
        movementState.flyDown = false
        ContextActionService:UnbindAction(FLY_UP_ACTION)
        ContextActionService:UnbindAction(FLY_DOWN_ACTION)

        local character = LocalPlayer.Character
        local root = character and character:FindFirstChild("HumanoidRootPart")
        if root then
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
        end
        UpdateMovementLoop()
    end

    local function StartNoClip()
        if movementState.noClip then return end
        movementState.noClip = true
        BindNoClipCharacter(LocalPlayer.Character)
        noClipSimulationConnection = RunService.PreSimulation:Connect(EnforceNoClipParts)
        UpdateMovementLoop()
    end

    local function StopNoClip()
        if noClipSimulationConnection then
            noClipSimulationConnection:Disconnect()
            noClipSimulationConnection = nil
        end
        movementState.noClip = false
        RestoreCollisions()
        DisconnectNoClipCharacter()
        UpdateMovementLoop()
    end

    function Movement:SetWalkSpeed(enabled)
        if enabled then
            StartWalkSpeed()
        else
            StopWalkSpeed()
        end
    end

    function Movement:SetFly(enabled)
        if enabled then
            StartFly()
        else
            StopFly()
        end
    end

    function Movement:SetNoClip(enabled)
        if enabled then
            StartNoClip()
        else
            StopNoClip()
        end
    end

    function Movement:StopAll()
        StopFly()
        StopNoClip()
        StopWalkSpeed()
    end

    function Movement:Destroy()
        self:StopAll()
        if characterConnection then
            characterConnection:Disconnect()
            characterConnection = nil
        end
    end

    characterConnection = LocalPlayer.CharacterAdded:Connect(RebindCharacter)
    if LocalPlayer.Character then
        RebindCharacter(LocalPlayer.Character)
    end

    return Movement
end)()

Library._ZoomOutController = (function()
    local Controller = {}
    local enabled = false
    local applying = false
    local originalMaximum = LocalPlayer.CameraMaxZoomDistance
    local maximumChangedConnection

    local function ConfiguredMaximum()
        return math.clamp(
            tonumber(Options.ZoomOutDistance and Options.ZoomOutDistance.Value) or 400,
            10,
            400
        )
    end

    local function ApplyMaximum()
        if not enabled or applying then return end
        local wanted = ConfiguredMaximum()
        if math.abs(LocalPlayer.CameraMaxZoomDistance - wanted) <= 0.001 then return end

        applying = true
        pcall(function()
            LocalPlayer.CameraMaxZoomDistance = wanted
        end)
        applying = false
    end

    local function DisconnectEnforcement()
        if maximumChangedConnection then
            maximumChangedConnection:Disconnect()
            maximumChangedConnection = nil
        end
    end

    local function ConnectEnforcement()
        DisconnectEnforcement()
        maximumChangedConnection = LocalPlayer
            :GetPropertyChangedSignal("CameraMaxZoomDistance")
            :Connect(function()
                if enabled and not applying then
                    task.defer(ApplyMaximum)
                end
            end)
    end

    function Controller:SetEnabled(value)
        value = value == true
        if value == enabled then
            if enabled then ApplyMaximum() end
            return
        end

        if value then
            originalMaximum = LocalPlayer.CameraMaxZoomDistance
            enabled = true
            ConnectEnforcement()
            ApplyMaximum()
        else
            enabled = false
            DisconnectEnforcement()
            applying = true
            pcall(function()
                LocalPlayer.CameraMaxZoomDistance = originalMaximum
            end)
            applying = false
        end
    end

    function Controller:SetMaximum()
        if enabled then ApplyMaximum() end
    end

    function Controller:Destroy()
        self:SetEnabled(false)
    end

    return Controller
end)()

