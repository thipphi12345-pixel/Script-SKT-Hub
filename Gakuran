    function R:_combatObserverCorrelation(eventName, args, characters, now)
        local lower = string.lower(eventName)
        local attackType = string.find(lower, "m1", 1, true) and "M1"
            or string.find(lower, "m2", 1, true) and "M2"
            or string.find(lower, "grapple", 1, true) and "Grapple"
            or "Combat"
        local phase = (string.find(lower, "swing", 1, true)
            or string.find(lower, "windstart", 1, true)
            or string.find(lower, "grapplestart", 1, true)) and "start" or nil
        if not phase and (self.OutcomeKinds[eventName]
            or string.find(lower, "grapplehit", 1, true)
            or string.find(lower, "grappleend", 1, true)
            or string.find(lower, "guardbroken", 1, true)) then
            phase = "outcome"
        end
        if eventName == "NpcCombatSound" then
            local sound = string.lower(tostring(args[2] or ""))
            phase = string.find(sound, "swing", 1, true) and "start" or nil
        end
        if not phase then return nil end

        local attacker = type(args[1]) == "string" and args[1] or nil
        if not attacker then
            for _, character in ipairs(characters) do
                if not character.localCharacter then attacker = character.name; break end
            end
        end
        for index = #self.ObserverRecentStarts, 1, -1 do
            if now - self.ObserverRecentStarts[index].at > 3 then
                table.remove(self.ObserverRecentStarts, index)
            end
        end

        if phase == "start" then
            self.ObserverCorrelationSequence += 1
            local id = "combat-" .. tostring(self.ObserverCorrelationSequence)
            self.ObserverRecentStarts[#self.ObserverRecentStarts + 1] = {
                id = id,
                at = now,
                event = eventName,
                attackType = attackType,
                attacker = attacker,
            }
            while #self.ObserverRecentStarts > 64 do table.remove(self.ObserverRecentStarts, 1) end
            return { id = id, phase = phase, attackType = attackType, attacker = attacker }
        end

        local best, bestScore
        for index = #self.ObserverRecentStarts, 1, -1 do
            local candidate = self.ObserverRecentStarts[index]
            local compatibleType = candidate.attackType == attackType
                or candidate.attackType == "Combat" or attackType == "Combat"
            local compatibleAttacker = not attacker or not candidate.attacker
                or attacker == candidate.attacker
            if compatibleType and compatibleAttacker then
                local score = now - candidate.at
                if candidate.attackType ~= attackType then score += 0.5 end
                if attacker and candidate.attacker == attacker then score -= 1 end
                if not bestScore or score < bestScore then
                    best, bestScore = candidate, score
                end
            end
        end
        return {
            id = best and best.id or nil,
            phase = phase,
            attackType = attackType,
            attacker = attacker,
            startEvent = best and best.event or nil,
            sinceStartMs = best and (now - best.at) * 1000 or nil,
        }
    end

    function R:_combatEventSignature(eventName, args)
        local count = math.min(args.n, 8)
        local parts = table.create(count + 1)
        parts[1] = eventName
        for index = 1, count do
            local value = args[index]
            if typeof(value) == "Instance" then
                parts[index + 1] = value.ClassName .. ":" .. value.Name
            else
                parts[index + 1] = typeof(value) .. ":" .. tostring(value)
            end
        end
        return table.concat(parts, "\0")
    end

    function R:_recordCombatObservation(channel, eventName, ...)
        if not self.ObserverEnabled then return false end
        local now = os.clock()
        local args = table.pack(...)
        local signature = self:_combatEventSignature(eventName, args)
        local previous = self.ObserverSignatures[signature]
        if previous and now - previous < 0.20 then
            self.ObserverDuplicates += 1
            self:_queueCombatObserverStatus()
            return false
        end
        self.ObserverSignatures[signature] = now
        if #self.ObserverEvents >= 10000 then
            self.ObserverDropped += 1
            self:_queueCombatObserverStatus()
            return false
        end

        local characters = {}
        for _, model in ipairs(self:_collectCharacters(table.unpack(args, 1, args.n))) do
            local player = Players:GetPlayerFromCharacter(model)
            local style, styleSource = ResolveCombatStyle(model)
            characters[#characters + 1] = {
                name = model.Name,
                player = player and player.Name or nil,
                userId = player and player.UserId or nil,
                style = style,
                styleSource = styleSource,
                localCharacter = model == LocalPlayer.Character,
                geometry = self:_combatObserverGeometry(model),
                animations = self:_combatObserverAnimations(model),
            }
        end
        local arguments = table.create(args.n)
        for index = 1, args.n do
            arguments[index] = self:_combatObserverArgument(args[index])
        end
        local correlation = self:_combatObserverCorrelation(eventName, args, characters, now)
        local observedAttempt
        for _, model in ipairs(self:_collectCharacters(table.unpack(args, 1, args.n))) do
            if model ~= LocalPlayer.Character then
                observedAttempt = self:_findAttempt(model, false)
                if observedAttempt then break end
            end
        end

        self.ObserverSequence += 1
        self.ObserverEvents[#self.ObserverEvents + 1] = {
            index = self.ObserverSequence,
            timeMs = (now - self.ObserverStartedClock) * 1000,
            channel = channel,
            event = eventName,
            engine = observedAttempt and observedAttempt.engine or self:Engine(),
            strategy = observedAttempt and observedAttempt.strategy or nil,
            attemptId = observedAttempt and observedAttempt.diagnosticId or nil,
            characters = characters,
            arguments = arguments,
            correlation = correlation,
        }
        if not self.ObserverCounts[eventName] then
            self.ObserverCounts[eventName] = 0
            self.ObserverTypeCount += 1
        end
        self.ObserverCounts[eventName] += 1
        self.ObserverChannelCounts[channel] = (self.ObserverChannelCounts[channel] or 0) + 1

        if self.ObserverSequence % 128 == 0 then
            local cutoff = now - 2
            for key, timestamp in pairs(self.ObserverSignatures) do
                if timestamp < cutoff then self.ObserverSignatures[key] = nil end
            end
        end
        self:_queueCombatObserverStatus()
        return true
    end

    function R:ExportCombatObserver()
        if typeof(writefile) ~= "function" or typeof(makefolder) ~= "function" then
            Library:Notify({ Title = "Combat Observer", Description = "Executor cannot write files.", Time = 4 })
            return nil
        end
        local root = "Int3/Gakuran/exports/combat-observer"
        local current = ""
        for part in root:gmatch("[^/]+") do
            current = current == "" and part or (current .. "/" .. part)
            pcall(makefolder, current)
        end
        local path = string.format(
            "%s/combat-%s-%04d.json",
            root,
            os.date("!%Y%m%d-%H%M%S"),
            math.floor(os.clock() * 1000) % 10000
        )
        local payload = {
            schema = "int3.combat-observer.v3",
            createdAtUnix = os.time(),
            startedAtUnix = self.ObserverStartedUnix,
            elapsedSeconds = os.clock() - self.ObserverStartedClock,
            placeId = game.PlaceId,
            jobId = game.JobId,
            summary = {
                events = #self.ObserverEvents,
                eventTypes = self.ObserverTypeCount,
                duplicates = self.ObserverDuplicates,
                dropped = self.ObserverDropped,
                channels = self.ObserverChannelCounts,
                byEvent = self.ObserverCounts,
            },
            events = self.ObserverEvents,
        }
        local okEncode, encoded = pcall(HttpService.JSONEncode, HttpService, payload)
        local okWrite = okEncode and pcall(writefile, path, encoded)
        Library:Notify({
            Title = "Combat Observer",
            Description = okWrite and ("Exported " .. path) or "Export failed.",
            Time = 5,
        })
        return okWrite and path or nil
    end

