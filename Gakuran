function _photoFindAssignmentInfo()
    -- Cached ~0.5s: previously this re-scanned EVERY PlayerGui descendant on
    -- every loop tick (~10x/sec) — the main source of the "gets laggier the
    -- longer it runs" churn. The state remote supplies the task anyway.
    local now = os.clock()
    if (now - _photoInfoCacheAt) < 0.5 then return _photoInfoCache end
    _photoInfoCacheAt = now
    local pg = game:GetService("Players").LocalPlayer:FindFirstChild("PlayerGui")
    if not pg then _photoInfoCache = nil return nil end
    local ok, info = pcall(function()
        for _, d in ipairs(pg:GetDescendants()) do
            if (d:IsA("TextLabel") or d:IsA("TextButton"))
                and typeof(d.Text) == "string"
                and _photoIsActuallyVisible(d)
                and not _photoIsOwnGui(d)
            then
                local label = _photoExtractLabel(d.Text)
                if label then
                    local res = { label = label, time = "", streak = "", pay = "", total = "" }
                    if d.Parent then
                        for _, sibling in ipairs(d.Parent:GetDescendants()) do
                            if sibling:IsA("TextLabel") and sibling ~= d then
                                local txt = sibling.Text
                                if typeof(txt) == "string" then
                                    local lowerTxt = txt:lower()
                                    if lowerTxt:match("^%d+:%d%d$") then
                                        res.time = txt
                                    elseif lowerTxt:match("streak") then
                                        res.streak = txt
                                    elseif txt:match("^%+") then
                                        res.pay = txt
                                    elseif txt:match("%d+") and not txt:match("%+") and not txt:lower():match("streak") and not txt:match(":") then
                                        res.total = txt
                                    end end end end end
                    return res
                end
            end
        end
        return nil
    end)
    _photoInfoCache = (ok and info) or nil
    return _photoInfoCache
end

