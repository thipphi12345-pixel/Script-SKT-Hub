function tryAutoApplyPhotoJob()
    if _photoApplyBusy then return false end
    _photoApplyBusy = true
    local gotTask = false
    pcall(function()
        local RS = game:GetService("ReplicatedStorage")
        local r12 = RS:FindFirstChild("Remotes")
        r12 = r12 and r12:FindFirstChild("PhotoJobSubmit")
        if not r12 then
            for _, d in ipairs(RS:GetDescendants()) do
                if d.Name == "PhotoJobSubmit" and d:IsA("RemoteFunction") then r12 = d break end
            end
        end
        if not r12 then
            if _photoSetStatus then _photoSetStatus("PhotoJobSubmit remote not found") end
            return
        end
        _photoSubmitRemote = r12
        local actions = { "Start" }
        if _photoApplyFails >= 2 then
            actions = { "Start", "Begin", "ClockIn", "Request", "Next", "NewTask", "Refresh" }
        end
        for _, act in ipairs(actions) do
            local ok, res, extra = pcall(function() return r12:InvokeServer(act) end)
            print(string.format("[Auto Photo] Apply '%s' -> ok=%s res=%s extra=%s",
                act, tostring(ok), tostring(res), tostring(extra)))
            if _photoSetStatus then
                _photoSetStatus(string.format("Clock-in '%s' -> %s", act, tostring(ok and res or "error")))
            end
            local t0 = os.clock()
            while os.clock() - t0 < 0.6 do
                task.wait(0.1)
                if _photoCurrentTask ~= nil then gotTask = true break end
            end
            if gotTask then break end
            if ok and typeof(res) == "table" and (res.Kind or res.Label or res.Text) then
                _photoCurrentTask = res
                gotTask = true
                break
            end
        end
    end)
    if gotTask then
        _photoApplyFails = 0
    else
        _photoApplyFails = _photoApplyFails + 1
    end
    _photoApplyBusy = false
    return gotTask
end

