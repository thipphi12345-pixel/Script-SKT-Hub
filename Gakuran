    local results = {}
    local _c3=0; for _, inst in ipairs(game:GetService("Workspace"):GetDescendants()) do _c3=_c3+1; if _c3%500==0 then task.wait() end
        if inst:IsA("BasePart") or inst:IsA("Model") then
