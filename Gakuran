-- Global on purpose: the Danger Zone button is built long before this point,
-- and the call only resolves once the whole script has finished loading.
function DestroyScript()
    if _G._int3Destroying then return end
    _G._int3Destroying = true

    -- บันทึกคอนฟิกปัจจุบันก่อนปิดทุกอย่าง (เก็บไว้ใน _destroy_save)
    -- แล้วกัน auto-save ไม่ให้ทับคอนฟิกตอนปิด toggle ทั้งหมด
    Library._DestroyingScript = true
    pcall(function()
        if Toggles.AutoSaveConfig and Toggles.AutoSaveConfig.Value then
            SaveManager:Save("_destroy_save")
        end
    end)

    -- Reset all toggles to their default (off) values so that when
    -- the script is reloaded, nothing is left running. This is
    -- different from Unload which just hides the UI but leaves
    -- background loops active.
    pcall(function()
        if Toggles and type(Toggles) == "table" then
            for key, toggle in pairs(Toggles) do
                if toggle and type(toggle.SetValue) == "function" then
                    pcall(toggle.SetValue, toggle, false)
                end
            end
        end
    end)

    -- Reset all getgenv flags so background loops stop immediately
    pcall(function()
        if typeof(getgenv) == "function" then
            local env = getgenv()
            env._SKT_AutoPhotoEnabled = false
            env._SKT_AutoPhotoRejoinEnabled = false
            env._SKT_Unloaded = true
            env._SKT_Loaded = false
        end
    end)

    -- Cleanup follow/spectate
    pcall(function() if stopFollow then stopFollow() end end)
    pcall(function()
        if spectateConn then
            spectateConn:Disconnect()
            spectateConn = nil
        end
        local myChar = LocalPlayer.Character
        if myChar and myChar:FindFirstChild("Humanoid") then
            Workspace.CurrentCamera.CameraSubject = myChar.Humanoid
        end
    end)

    -- Cleanup Auto Photo: หยุด follow + ล้าง BodyVelocity + unanchor + restore CanCollide
    pcall(function()
        if typeof(getgenv()._SKT_PhotoStopFollow) == "function" then
            getgenv()._SKT_PhotoStopFollow()
        end
    end)
    pcall(function()
        local char = LocalPlayer.Character
        if char then
            local root = char:FindFirstChild("HumanoidRootPart")
            if root then
                root.Anchored = false
                root.Velocity = Vector3.new(0, 0, 0)
            end
            -- restore CanCollide (ยกเลิก noclip)
            for _, p in ipairs(char:GetDescendants()) do
                if p:IsA("BasePart") and not p.CanCollide then
                    p.CanCollide = true
                end
            end
        end
    end)
    -- ปิด noclip connection
    pcall(function()
        if getgenv()._SKT_NoclipConnection then
            getgenv()._SKT_NoclipConnection:Disconnect()
            getgenv()._SKT_NoclipConnection = nil
        end
    end)

    pcall(_ExternalUnload)

    -- Anything parented outside the library's ScreenGui has to go manually.
    local hosts = {}
    if typeof(gethui) == "function" then
        local ok, host = pcall(gethui)
        if ok and host then table.insert(hosts, host) end
    end
    table.insert(hosts, game:GetService("CoreGui"))
    local playerGui = LocalPlayer and LocalPlayer:FindFirstChildOfClass("PlayerGui")
    if playerGui then table.insert(hosts, playerGui) end

    local strays = {
        "Int3UI", "Int3BootstrapStatus", "Int3ExecutorWarning",
        "GakuranMobileToggle", "GakuranHUD", "GKLogger", "GKPreview",
    }
    for _, host in ipairs(hosts) do
        for _, name in ipairs(strays) do
            local found = host:FindFirstChild(name)
            while found do
                pcall(function() found:Destroy() end)
                found = host:FindFirstChild(name)
            end
        end
    end

    for _, key in ipairs({
        "_int3Bootstrap", "_int3ExecutorWarningGui", "_int3GakuranUnload",
        "_int3GakuranDevAccess", "_int3GakuranBuildChannel", "_interiumUnload",
        "__INT3_UI_WINDOW",
    }) do
        _G[key] = nil
    end
    if typeof(getgenv) == "function" then
        local ok, environment = pcall(getgenv)
        if ok and type(environment) == "table" then
            environment.__INT3_UI_WINDOW = nil
            environment._int3GakuranUnload = nil
        end
    end

    _G._int3Destroying = nil
end

--// ============================ Auto Save System ============================
-- Hooks into all options/toggles so that any change triggers a debounced save
-- to the "_auto_save" config. On next run, the autoload system loads it back.
local _autoSaveDirty = false
local _autoSaveTimer = nil
local _autoSaveDebounce = 3.0  -- seconds to wait after last change before saving

function _triggerAutoSave()
    if not (Toggles.AutoSaveConfig and Toggles.AutoSaveConfig.Value) then return end
    if Library._ConfigLoading then return end
    if Library._DestroyingScript then return end -- กัน auto-save ตอน DestroyScript ปิด toggle ทั้งหมด
    _autoSaveDirty = true
    if _autoSaveTimer then task.cancel(_autoSaveTimer) end
    _autoSaveTimer = task.delay(_autoSaveDebounce, function()
        _autoSaveTimer = nil
        if not _autoSaveDirty then return end
        _autoSaveDirty = false
        pcall(function()
            SaveManager:Save("_auto_save")
            -- Ensure it's set as autoload
            local autoloadPath = SaveManager.Folder .. "/autoload.txt"
            local current = ""
            if isfile(autoloadPath) then
                local ok, data = pcall(readfile, autoloadPath)
                if ok then current = data or "" end
            end
            if current ~= "_auto_save" then
                SaveManager:SetAutoload("_auto_save")
            end
        end)
    end)
end

-- Hook into all existing options and toggles
task.defer(function()
    for _, option in pairs(Library.Options or {}) do
        if option and option.OnChanged then
            option:OnChanged(_triggerAutoSave)
        end
    end
    for _, toggle in pairs(Library.Toggles or {}) do
        if toggle and toggle.OnChanged then
            toggle:OnChanged(_triggerAutoSave)
        end
    end
end)

