    function R:_diagnosticGeometry(model)
        local character = LocalPlayer.Character
        local myRoot = character and character:FindFirstChild("HumanoidRootPart")
        local enemyRoot = model and (model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart)
        if not (myRoot and enemyRoot) then return { side = "unknown" } end
        local delta = enemyRoot.Position - myRoot.Position
        local distance = delta.Magnitude
        local relative = myRoot.CFrame:PointToObjectSpace(enemyRoot.Position)
        local side
        if math.abs(relative.X) > math.abs(relative.Z) then
            side = relative.X >= 0 and "right" or "left"
        else
            side = relative.Z <= 0 and "front" or "back"
        end
        local direction = distance > 0.001 and delta.Unit or Vector3.new(0, 0, -1)
        local myVelocity = myRoot.AssemblyLinearVelocity
        local enemyVelocity = enemyRoot.AssemblyLinearVelocity
        return {
            distanceStuds = distance,
            side = side,
            angleDegrees = math.deg(math.atan2(relative.X, -relative.Z)),
            relativeX = relative.X,
            relativeY = relative.Y,
            relativeZ = relative.Z,
            localFacingDot = myRoot.CFrame.LookVector:Dot(direction),
            attackerFacingDot = enemyRoot.CFrame.LookVector:Dot(-direction),
            localSpeed = myVelocity.Magnitude,
            attackerSpeed = enemyVelocity.Magnitude,
            closingSpeed = -(enemyVelocity - myVelocity):Dot(direction),
        }
    end

    function R:_diagnosticHitbox(model, profile)
        if type(profile) ~= "table" then return nil end
        local character = LocalPlayer.Character
        local myRoot = character and character:FindFirstChild("HumanoidRootPart")
        local enemyRoot = model and (model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart)
        if not (myRoot and enemyRoot) then return nil end
        local half = Vector3.new(
            tonumber(profile.hitboxX) or 0,
            tonumber(profile.hitboxY) or 0,
            tonumber(profile.hitboxZ) or 0
        ) * 0.5
        local box = enemyRoot.CFrame * CFrame.new(
            0,
            0,
            -((tonumber(profile.hso) or 0) + half.Z)
        )
        local point = box:PointToObjectSpace(myRoot.Position)
        local delta = enemyRoot.Position - myRoot.Position
        local direction = delta.Magnitude > 0.001 and delta.Unit or Vector3.new(0, 0, -1)
        return {
            inside = math.abs(point.X) <= half.X
                and math.abs(point.Y) <= half.Y
                and math.abs(point.Z) <= half.Z,
            attackerFacingDot = enemyRoot.CFrame.LookVector:Dot(-direction),
            localFacingDot = myRoot.CFrame.LookVector:Dot(direction),
            localX = point.X,
            localY = point.Y,
            localZ = point.Z,
            halfX = half.X,
            halfY = half.Y,
            halfZ = half.Z,
        }
    end

    function R:_diagnosticLocalState()
        local character = LocalPlayer.Character
        local state = {}
        if not character then return state end
        for _, attribute in ipairs(self.DiagnosticAttributes) do
            state[attribute] = character:GetAttribute(attribute) == true
        end
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if humanoid then
