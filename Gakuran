-- Hook UserInputService so Hit & Return only triggers when the PLAYER presses M1/M2 manually.
-- Auto Combat / Auto Kill use State.directM1 / _acFireM1 directly, so they won't trigger this.
local _hitReturnConn
local function _hitReturnDoAttack(isM2)
    local now = os.clock()
    if now < _hitReturnCooldown then return end
    -- Skip if Auto Combat or Auto Kill is running (they handle their own attacks)
    local acOn = Toggles.AutoCombat and Toggles.AutoCombat.Value
    local akOn = Toggles.AutoKill and Toggles.AutoKill.Value
    if acOn or akOn then return end
    local range = Options.HitAndReturnRange and Options.HitAndReturnRange.Value or 30
    local target, tRoot = _hitReturnFindTarget(range)
    if not target or not tRoot then return end
    local myChar = LocalPlayer.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myRoot then return end
    -- Save original position, teleport behind target, strike, return
    local origCFrame = myRoot.CFrame
    local behindCFrame = tRoot.CFrame * CFrame.new(0, 0, 3.8)
    myChar:PivotTo(behindCFrame)
    _hitReturnCooldown = now + (isM2 and 0.2 or 0.15)
    -- Fire the attack remote directly (the game's M1/M2 module will also fire from the input,
    -- but we teleport back fast so the server sees us at the target position)
    if isM2 then
        if not State.directM2() then _acFireM1() end
    else
        _acFireM1()
    end
    -- Return after a tiny delay (let the server register the hit)
    task.delay(0.08, function()
        pcall(function()
            if myChar and myChar.Parent and myChar:FindFirstChild("HumanoidRootPart") then
                myChar:PivotTo(origCFrame)
            end
        end)
    end)
end

