-- Translate a string to the current language (exact match first, then patterns).
function LanguageSystem.Translate(text)
    if LanguageSystem.Current ~= "TH" then return text end
    local s = tostring(text)
    local direct = LanguageSystem.Translations[s]
    if direct then return direct end
    for _, rule in ipairs(LanguageSystem.Patterns) do
        local replaced = s:gsub(rule[1], rule[2])
        if replaced ~= s then return replaced end
    end
    return s
end

-- Reverse table for TH -> EN
LanguageSystem.Reverse = {}
for en, th in pairs(LanguageSystem.Translations) do
    LanguageSystem.Reverse[th] = en
end

-- Store original text and font of each TextLabel for switching back
LanguageSystem.OriginalTexts = {}
LanguageSystem.OriginalFonts = {}
LanguageSystem.OriginalPlaceholders = {}

-- Split "Label  <arrow>" texts used by section headers and dropdown selectors.
local function _langSplitTrailing(text)
    local base, arrow = text:match("^(.-)  (%S+)$")
    if base then return base, arrow end
    return text, nil
end

-- Walk the GUI tree and translate all TextLabels
function LanguageSystem.Apply(lang)
    LanguageSystem.Current = lang
    -- Resolve the real main window ScreenGui. Window.Raw is a table; its .Screen
    -- field is the Int3UI ScreenGui living in PlayerGui. Never trust a bare
    -- name match first -- gethui() hosts SKT helper guis (floating toggle etc).
    local root = nil
    local raw = (typeof(Window) == "table") and Window.Raw or nil
    if type(raw) == "table" and typeof(raw.Screen) == "Instance" then
        root = raw.Screen
    elseif typeof(raw) == "Instance" then
        root = raw:IsA("ScreenGui") and raw or raw:FindFirstAncestorOfClass("ScreenGui")
    end
    if not root then
        local Players = game:GetService("Players")
        local pg = Players.LocalPlayer and Players.LocalPlayer:FindFirstChild("PlayerGui")
        local candidates = {
            pg,
            typeof(gethui) == "function" and gethui() or nil,
            game:GetService("CoreGui"),
        }
        for _, parent in ipairs(candidates) do
            if parent then
                local direct = parent:FindFirstChild("Int3UI")
                if direct and direct:IsA("ScreenGui") then root = direct break end
            end
        end
        if not root then
            for _, parent in ipairs(candidates) do
                if parent then
                    for _, child in ipairs(parent:GetChildren()) do
                        if child:IsA("ScreenGui") and child.Name
                            and (child.Name:match("Int3") or child.Name:match("SKT"))
                            and child:FindFirstChild("Window") then
                            root = child
                            break
                        end
                    end
                end
                if root then break end
            end
        end
    end
    if not root then return end

    for _, obj in ipairs(root:GetDescendants()) do
        if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
            local currentText = obj.Text
            if currentText and #currentText > 0 then
                -- Store original text and font using obj instance directly
                if not LanguageSystem.OriginalTexts[obj] then
                    LanguageSystem.OriginalTexts[obj] = currentText
                end
                if not LanguageSystem.OriginalFonts[obj] then
                    LanguageSystem.OriginalFonts[obj] = obj.Font
                end

                local original = LanguageSystem.OriginalTexts[obj]
                local isSelector = obj.Name == "Selector" or obj.Name == "Header"
                local checkboxPrefix = original:match("^(%[[x ]%] )")
                local lookup = checkboxPrefix and original:sub(#checkboxPrefix + 1) or original
                local arrow = nil
                if isSelector then
                    lookup, arrow = _langSplitTrailing(lookup)
                end
                if lang == "TH" then
                    -- Translate EN -> TH (exact table first, then dynamic patterns)
                    local translated = LanguageSystem.Translate(lookup)
                    if translated ~= lookup then
                        local newText = (checkboxPrefix or "") .. translated .. (arrow and ("  " .. arrow) or "")
                        obj.Text = newText
                        -- Ensure font supports Thai glyphs flawlessly in Roblox
                        obj.Font = Enum.Font.GothamMedium
                    end
                else
                    -- Revert TH -> EN (restore original English text, keep current arrow state)
                    local curArrow = isSelector and (currentText:match("  (%S+)$") or arrow) or nil
                    obj.Text = original:match("^(.-)  %S+$") and isSelector and (lookup .. "  " .. (curArrow or "")) or original
                    if checkboxPrefix then
                        obj.Text = checkboxPrefix .. (LanguageSystem.Reverse[lookup] or lookup)
                    end
                    if LanguageSystem.OriginalFonts[obj] then
                        obj.Font = LanguageSystem.OriginalFonts[obj]
                    end
                end
            end
            -- Translate TextBox placeholders too
            if obj:IsA("TextBox") then
                local ph = obj.PlaceholderText
                if ph and #ph > 0 then
                    if not LanguageSystem.OriginalPlaceholders[obj] then
                        LanguageSystem.OriginalPlaceholders[obj] = ph
                    end
                    local origPh = LanguageSystem.OriginalPlaceholders[obj]
                    if lang == "TH" then
                        obj.PlaceholderText = LanguageSystem.Translate(origPh)
                    else
                        obj.PlaceholderText = origPh
                    end
                end
            end
        end
    end
end

