                local menuBind = rawget(_G, "Options") and Options.MenuKeybind
                local menuVal = menuBind and tostring(menuBind.Value)
                if (menuVal and menuVal == keyName)
                    or (self.ToggleKey and input.KeyCode == self.ToggleKey)
                    or (not menuVal and not self.ToggleKey and input.KeyCode == Enum.KeyCode.RightShift) then
                    self:Toggle()
                end
            end)
        )

        self.Environment = environment
        environment[ACTIVE_WINDOW_KEY] = self
        self:ShowIntro()
        return self
    end

