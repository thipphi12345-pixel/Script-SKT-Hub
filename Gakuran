local DodgeSteering = (function()
    local pathParams = RaycastParams.new()
    pathParams.FilterType = Enum.RaycastFilterType.Exclude
    local groundParams = RaycastParams.new()
    groundParams.FilterType = Enum.RaycastFilterType.Exclude

    local function flat(vector)
        return Vector3.new(vector.X, 0, vector.Z)
    end

    local function unit(vector)
        vector = flat(vector)
        return vector.Magnitude > 0.001 and vector.Unit or nil
    end

    local function config()
        local evasive = CombatConfig and CombatConfig.Evasive
        return math.max(0.05, tonumber(evasive and evasive.DashDuration) or 0.20),
            math.max(1, tonumber(evasive and evasive.DashSpeed) or 20)
    end

    local function threatField(root, range)
        local away, count = Vector3.zero, 0
        range = math.max(1, tonumber(range) or 20)
        for _, player in ipairs(Players:GetPlayers()) do
            local character = player ~= LocalPlayer and player.Character or nil
            local otherRoot = character and character:FindFirstChild("HumanoidRootPart")
            local humanoid = character and character:FindFirstChildOfClass("Humanoid")
            if otherRoot and humanoid and humanoid.Health > 0 then
                local delta = flat(otherRoot.Position - root.Position)
                local distance = delta.Magnitude
                if distance > 0.001 and distance <= range then
                    count += 1
                    away -= delta.Unit * (1.15 - math.clamp(distance / range, 0, 1))
                end
            end
        end
        return count, away
    end

    local function resolve(model, requested)
        local character = LocalPlayer.Character
        local root = character and character:FindFirstChild("HumanoidRootPart")
        local attacker = model and (model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart)
        if not (root and root:IsA("BasePart") and attacker and attacker:IsA("BasePart")) then
            return nil, { mode = "Default", reason = "root-missing" }, 0.20, 20
        end

        local duration, dashSpeed = config()
        local attackerVelocity = flat(attacker.AssemblyLinearVelocity)
        local localVelocity = flat(root.AssemblyLinearVelocity)
        if attackerVelocity.Magnitude > 28 then attackerVelocity = attackerVelocity.Unit * 28 end
        if localVelocity.Magnitude > 28 then localVelocity = localVelocity.Unit * 28 end
        local predictedAttacker = attacker.Position + attackerVelocity * duration
        local predictedLocal = root.Position + localVelocity * duration
        local forward = unit(attacker.CFrame.LookVector)
            or unit(attacker.Position - root.Position) or Vector3.new(0, 0, -1)
        local right = unit(attacker.CFrame.RightVector) or Vector3.new(-forward.Z, 0, forward.X)
        local relative = flat(root.Position - attacker.Position)
        local nearSide = relative:Dot(right) >= 0 and 1 or -1
        local offset = 3.6
        local _, away = threatField(root, math.max(10,
            tonumber(Options.MaxRangeDodge and Options.MaxRangeDodge.Value) or 20))
        local awayDirection = unit(away)
        pathParams.FilterDescendantsInstances = { character, model }
        groundParams.FilterDescendantsInstances = { character, model }
        local bestDirection, bestMode, bestSide, bestScore

        local function consider(mode, side, position)
            local path = flat(position - root.Position)
            local distance = path.Magnitude
            if distance <= 0.001 then return end
            local direction = path.Unit
            local projectedDistance = flat(position - predictedLocal).Magnitude
            local reachable = projectedDistance <= dashSpeed * duration + 2
            local pathHit = game:GetService("Workspace"):Raycast(root.Position + Vector3.new(0, 2, 0), path, pathParams)
            local groundOrigin = Vector3.new(position.X,
                math.max(root.Position.Y, predictedAttacker.Y) + 4, position.Z)
            local groundHit = game:GetService("Workspace"):Raycast(groundOrigin, Vector3.new(0, -12, 0), groundParams)
            if not reachable or pathHit or not groundHit then return end
            local fromAttacker = flat(position - predictedAttacker)
            local facingBias = fromAttacker.Magnitude > 0.001 and forward:Dot(fromAttacker.Unit) or 0
            local score = distance * 0.20 + math.abs(projectedDistance - offset) * 1.40
                + (facingBias + 1) * 2
            if awayDirection then score -= direction:Dot(awayDirection) * 1.5 end
            if not bestScore or score < bestScore - 0.0001 then
                bestDirection, bestMode, bestSide, bestScore = direction, mode, side, score
            end
        end

        local behind = predictedAttacker - forward * offset
        local besideNear = predictedAttacker + right * offset * nearSide
        local besideFar = predictedAttacker - right * offset * nearSide
        local front = predictedAttacker + forward * offset
        if requested == "Behind" then
            consider("Behind", 0, behind)
        elseif requested == "Beside" then
            consider("Beside", nearSide, besideNear)
            consider("Beside", -nearSide, besideFar)
        elseif requested == "Auto" then
            consider("Behind", 0, behind)
            consider("Beside", nearSide, besideNear)
            consider("Beside", -nearSide, besideFar)
            consider("Front", 0, front)
        end
        if bestDirection then
            return bestDirection, { mode = bestMode, side = bestSide, reason = "safe-candidate", score = bestScore },
                duration, dashSpeed
        end
        return nil, { mode = "Default", reason = "fallback-game-default" }, duration, dashSpeed
    end

    local function steer(character, root, direction, duration, dashSpeed)
        if not (character and root and direction) then return end
        task.spawn(function()
            local velocity
            for heartbeat = 0, 2 do
                local candidate = root:FindFirstChild("EvasiveDashLinearVelocity")
                if candidate and candidate:IsA("LinearVelocity") then velocity = candidate; break end
                if heartbeat < 2 then RunService.Heartbeat:Wait() end
            end
            if not velocity or velocity.Parent ~= root then return end
            local speed = velocity.VectorVelocity.Magnitude
            if speed < 1 then speed = dashSpeed end
            local targetX = direction.X * speed
            local targetZ = direction.Z * speed
            local expiresAt = os.clock() + duration
            repeat
                if character ~= LocalPlayer.Character or velocity.Parent ~= root then break end
                local current = velocity.VectorVelocity
                if math.abs(current.X - targetX) > 0.001
                    or math.abs(current.Z - targetZ) > 0.001 then
                    velocity.VectorVelocity = Vector3.new(targetX, current.Y, targetZ)
                end
                if os.clock() >= expiresAt then break end
                RunService.Heartbeat:Wait()
            until false
        end)
    end

    return { Resolve = resolve, Steer = steer }
end)()

local function doDodge(model, direction)
    if Library._ShouldStopAutomationForTyping() or State.dodgeActive then
        return false, "blocked", { mode = "Default", reason = "dodge-busy-or-typing" }
    end
    State.dodgeActive = true
    local character = LocalPlayer.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    local steering, resolution, duration, dashSpeed = DodgeSteering.Resolve(model, direction)
    local assist = Library._M2AssistController
    if assist and typeof(assist.Stop) == "function" then pcall(assist.Stop, assist, "dodge") end

    local evasive = getEvasiveModule()
    local method = "Direct"
    local ok, result
    if evasive and typeof(evasive.Evasive) == "function" then
        method = "Module"
        _stampCombatCredit("Evasive.Evasive")
        ok, result = pcall(evasive.Evasive)
        local activeDash = false
        local hasActiveDashContract = typeof(evasive.IsDashActive) == "function"
        if ok and hasActiveDashContract then
            local activeOk, active = pcall(evasive.IsDashActive)
            activeDash = activeOk and active == true
        end
        if hasActiveDashContract then
            ok = ok and activeDash
        else
            ok = ok and result == true
        end
    else
        ok = directDodge()
    end
    if not ok then
        State.dodgeActive = false
        return false, method, resolution
    end

    if steering then DodgeSteering.Steer(character, root, steering, duration, dashSpeed) end
    task.delay(math.max(0.20, duration + 0.05), function()
        State.dodgeActive = false
    end)
    return true, method, resolution
end

