local function GetExecutorCompatibility()
    local executorName = "Unknown"
    local identify = typeof(identifyexecutor) == "function" and identifyexecutor
        or (typeof(getexecutorname) == "function" and getexecutorname or nil)
    if identify then
        local ok, name, version = pcall(identify)
        if ok and name ~= nil then
            executorName = tostring(name)
            if version ~= nil and tostring(version) ~= "" then
                executorName ..= " " .. tostring(version)
            end
        end
    end

    local identity
    local getIdentity = typeof(getthreadidentity) == "function" and getthreadidentity
        or (typeof(getidentity) == "function" and getidentity or nil)
    if getIdentity then
        local ok, value = pcall(getIdentity)
        if ok then identity = tonumber(value) end
    end

    local nameLower = string.lower(executorName)
    local unsupported = nameLower:find("xeno", 1, true) ~= nil
        or (identity ~= nil and identity <= 3)
    return unsupported, executorName, identity
end

