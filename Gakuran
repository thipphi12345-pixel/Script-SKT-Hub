        local first = 1
        while first <= count and now - self.Outcomes[first].at > 300 do
            first += 1
        end
        if first <= 1 then return end
        local remaining = count - first + 1
        if remaining > 0 then table.move(self.Outcomes, first, count, 1) end
        for index = remaining + 1, count do self.Outcomes[index] = nil end
    end

