function _photoExtractLabel(text)
    if typeof(text) ~= "string" or text == "" then return nil end
    local clean = text:gsub("<[^>]+>", "")
    clean = clean:gsub("^%s+", ""):gsub("%s+$", "")
    if clean == "" then return nil end

    local label = clean:match("^[Gg]et a photo of%s+(.-)%s*$")
        or clean:match("^[Tt]ake a photo of%s+(.-)%s*$")
        or clean:match("^[Gg]et a picture of%s+(.-)%s*$")
        or clean:match("^[Tt]ake a picture of%s+(.-)%s*$")
        or clean:match("^[Pp]hotograph%s+(.-)%s*$")
        or clean:match("^[Pp]hoto of%s+(.-)%s*$")
        or clean:match("^[Pp]icture of%s+(.-)%s*$")
        or clean:match("^[Tt]arget:%s*(.-)%s*$")
        or clean:match("^[Tt]ask:%s*(.-)%s*$")
        or clean:match("^[Aa]ssignment:%s*(.-)%s*$")
    if not label or label == "" then return nil end

    label = label:gsub("%s*%->.*$", "")
    label = label:gsub("%s*%b()%s*$", "")
    label = label:gsub("%s*%b[]%s*$", "")
    label = label:gsub("%s*[%-——]%s*%d[%d:]*%s*$", "")
    -- Strip direction/angle words that the quest may append to the name
    label = label:gsub("%s+[Ff]rom the front%s*$", "")
    label = label:gsub("%s+[Ff]rom the back%s*$", "")
    label = label:gsub("%s+[Ff]rom behind%s*$", "")
    label = label:gsub("%s+[Ff]rom the left%s*$", "")
    label = label:gsub("%s+[Ff]rom the right%s*$", "")
    label = label:gsub("%s+[Ff]rom above%s*$", "")
    label = label:gsub("%s+[Bb]ehind%s*$", "")
    label = label:gsub("%s+[Ff]ront%s*$", "")
    label = label:gsub("%s+[Bb]ack%s*$", "")
    label = label:gsub("%s+[Ll]eft%s*$", "")
    label = label:gsub("%s+[Rr]ight%s*$", "")
    label = label:gsub("%s+[Aa]bove%s*$", "")
    label = label:gsub("[%.!,]%s*$", "")
    label = label:gsub("^%s+", ""):gsub("%s+$", "")
    if label == "" then return nil end
    return label
end

