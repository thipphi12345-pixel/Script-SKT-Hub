            { FillTransparency = 0.45, OutlineTransparency = 0.05 }
        )
        local tween = readyPulse
        readyPulseConnection = tween.Completed:Connect(function()
            if tween ~= readyPulse then return end
            if readyPulseConnection then readyPulseConnection:Disconnect() end
            readyPulseConnection = nil
