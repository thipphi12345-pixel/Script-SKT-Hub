    function R:PassesHitchance(chance, roll)
        chance = math.clamp(tonumber(chance) or 100, 0, 100)
        if chance <= 0 then return false end
        if chance >= 100 then return true end
        return (tonumber(roll) or math.random() * 100) < chance
    end

