local _fogConnections = {}
local _fogAtmosphereConnections = {}
local _fogAtmosphere = nil
local _origAtmo = nil

local function EnforceNoFogAtmosphere()
    local atmo = _fogAtmosphere
    if not atmo or not atmo.Parent then return end
    if atmo.Density ~= 0 then atmo.Density = 0 end
    if atmo.Haze ~= 0 then atmo.Haze = 0 end
    if atmo.Glare ~= 0 then atmo.Glare = 0 end
end

local function BindNoFogAtmosphere(atmo)
    DisconnectVisualConnections(_fogAtmosphereConnections)
    _fogAtmosphere = atmo
    _origAtmo = nil
    if not atmo then return end

    _origAtmo = {
        Density = atmo.Density,
        Offset = atmo.Offset,
        Glare = atmo.Glare,
        Haze = atmo.Haze,
    }
    EnforceNoFogAtmosphere()
    for _, property in ipairs({ "Density", "Haze", "Glare" }) do
        _fogAtmosphereConnections[#_fogAtmosphereConnections + 1] =
            atmo:GetPropertyChangedSignal(property):Connect(function()
                if Toggles.NoFog and Toggles.NoFog.Value then
                    EnforceNoFogAtmosphere()
                end
            end)
    end
end

local function EnforceNoFog()
    if Lighting.FogEnd ~= 9e9 then Lighting.FogEnd = 9e9 end
    if Lighting.FogStart ~= 9e9 then Lighting.FogStart = 9e9 end
    local atmo = Lighting:FindFirstChildOfClass("Atmosphere")
    if atmo ~= _fogAtmosphere then
        BindNoFogAtmosphere(atmo)
    else
        EnforceNoFogAtmosphere()
    end
end

local function EnableNoFog()
    if #_fogConnections > 0 then return end
    EnforceNoFog()
    for _, property in ipairs({ "FogEnd", "FogStart" }) do
        _fogConnections[#_fogConnections + 1] =
            Lighting:GetPropertyChangedSignal(property):Connect(function()
                if Toggles.NoFog and Toggles.NoFog.Value then
                    EnforceNoFog()
                end
            end)
    end
    _fogConnections[#_fogConnections + 1] = Lighting.ChildAdded:Connect(function(child)
        if child:IsA("Atmosphere") and Toggles.NoFog and Toggles.NoFog.Value then
            EnforceNoFog()
        end
    end)
    _fogConnections[#_fogConnections + 1] = Lighting.ChildRemoved:Connect(function(child)
        if child == _fogAtmosphere then
            DisconnectVisualConnections(_fogAtmosphereConnections)
            _fogAtmosphere = nil
            _origAtmo = nil
            if Toggles.NoFog and Toggles.NoFog.Value then
                task.defer(EnforceNoFog)
            end
        end
    end)
end

local function DisableNoFog()
    DisconnectVisualConnections(_fogConnections)
    DisconnectVisualConnections(_fogAtmosphereConnections)
    local atmo = _fogAtmosphere
    if atmo and atmo.Parent and _origAtmo then
        atmo.Density = _origAtmo.Density
        atmo.Offset = _origAtmo.Offset
        atmo.Glare = _origAtmo.Glare
        atmo.Haze = _origAtmo.Haze
    end
    _fogAtmosphere = nil
    _origAtmo = nil
    Lighting.FogEnd = _visDefaults.FogEnd
    Lighting.FogStart = _visDefaults.FogStart
end

