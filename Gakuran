local PhotoGroup = Tabs.AutoFarm:AddLeftGroupbox("Auto Farm Photo", "camera")



PhotoGroup:AddToggle("AutoPhotoFullAuto", {
    Text = "Auto Farm Photo (Full Auto)",
    Default = false,
    Tooltip = "Automatically clocks in for the Newspaper job and walks to the current PhotoJob assignment (Player/Area/Landmark), submitting the photo for you. (Noclip Built-in)",
    Callback = function(val)
        getgenv()._SKT_AutoPhotoEnabled = val
        if val then
            if not getgenv()._SKT_NoclipConnection then
                local RunService = game:GetService("RunService")
                local Players = game:GetService("Players")

                -- Cache the BasePart list per character instead of running
                -- GetDescendants() every physics step (~240Hz). Refreshed on
                -- respawn and at a slow 1s cadence for accessories/limbs.
                local noclipParts = {}
                local noclipChar = nil
                local noclipScanAt = 0

                local _stepAccum = 0
                getgenv()._SKT_NoclipConnection = RunService.Stepped:Connect(function(_, dt)
                    if getgenv()._SKT_AutoPhotoEnabled then
                        -- 240Hz physics step -> ~60Hz effective: velocity fixes
                        -- and noclip don't need to run every physics step.
                        _stepAccum = _stepAccum + (dt or 0.004)
                        if _stepAccum < 0.016 then return end
                        _stepAccum = 0
                        local char = Players.LocalPlayer.Character
                        if char then
                            local now = os.clock()
                            if char ~= noclipChar or now - noclipScanAt > 1 then
                                noclipChar = char
                                noclipScanAt = now
                                table.clear(noclipParts)
                                for _, p in ipairs(char:GetDescendants()) do
                                    if p:IsA("BasePart") then
                                        noclipParts[#noclipParts + 1] = p
                                    end
                                end
                            end
                            local hum = char:FindFirstChildOfClass("Humanoid")
                            local root = char:FindFirstChild("HumanoidRootPart")
                            local emoting = _sktIsEmoting(char)

                            -- Instant Anti-Ragdoll & Stand-Up on hit/knockdown
                            -- (skipped while the game locks movement for an
                            -- emote, and while the photo farm deliberately
                            -- holds us upside-down on a target's head)
                            if not emoting and hum and hum.Health > 0 and not getgenv()._SKT_PhotoHeadstand then
                                if hum.PlatformStand then hum.PlatformStand = false end
                                if hum.Sit then hum.Sit = false end
                                local st = hum:GetState()
                                if st == Enum.HumanoidStateType.Ragdoll
                                    or st == Enum.HumanoidStateType.FallingDown
                                    or st == Enum.HumanoidStateType.Physics
                                    or st == Enum.HumanoidStateType.Seated then
                                    hum:ChangeState(Enum.HumanoidStateType.GettingUp)
                                end
                            end

                            if not emoting and root then
                                -- ล้างแรงผลักลงพื้นทันทีเมื่อโดนต่อย ไม่ให้ตัวจมดินทะลุแมพ
                                -- เขียนเฉพาะตอนค่าไม่เป็นศูนย์ — unconditional
                                -- writes every step force physics recomputes.
                                if root.Velocity.Y < 0 then
                                    root.Velocity = Vector3.new(root.Velocity.X, 0, root.Velocity.Z)
                                end
                                if root.RotVelocity.Magnitude > 0.01 then
                                    root.RotVelocity = Vector3.new(0, 0, 0)
                                end
                                pcall(function()
                                    if root.AssemblyLinearVelocity.Y < 0 then
                                        root.AssemblyLinearVelocity = Vector3.new(root.AssemblyLinearVelocity.X, 0, root.AssemblyLinearVelocity.Z)
                                    end
                                    if root.AssemblyAngularVelocity.Magnitude > 0.01 then
                                        root.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                                    end
                                end)
                            end

                            -- Safe Noclip: Keep character limbs frictionless through walls
                            for _, p in ipairs(noclipParts) do
                                if p.CanCollide then
                                    p.CanCollide = false
                                end
                            end
                        end
                    else
                        if getgenv()._SKT_NoclipConnection then
                            getgenv()._SKT_NoclipConnection:Disconnect()
                            getgenv()._SKT_NoclipConnection = nil
                        end
                    end
                end)
            end
            -- Anti-sit: jump every 2 seconds to break out of the
            -- spawn chair after a game reload/respawn. Without this
            -- the character stays seated and warp (CFrame set) is
            -- rejected by the server because the Humanoid is in
            -- Seated state.
            if not getgenv()._SKT_AntiSitJumpConn then
                getgenv()._SKT_AntiSitJumpLastJump = 0
                getgenv()._SKT_AntiSitJumpConn = task.spawn(function()
                    while getgenv()._SKT_AutoPhotoEnabled do
                        task.wait(0.5)
                        if getgenv()._SKT_Unloaded then break end
                        if not getgenv()._SKT_AutoPhotoEnabled then break end
                        local now = os.clock()
                        if now - (getgenv()._SKT_AntiSitJumpLastJump or 0) >= 2.0 then
                            getgenv()._SKT_AntiSitJumpLastJump = now
                            local char = game:GetService("Players").LocalPlayer.Character
                            local hum = char and char:FindFirstChildOfClass("Humanoid")
                            if hum and hum.Health > 0 and hum.Sit and not _sktIsEmoting(char) then
                                pcall(function()
                                    hum.Sit = false
                                    hum.Jump = true
                                end)
                            end
                        end
                    end
                    getgenv()._SKT_AntiSitJumpConn = nil
                end)
            end
            -- Anti-AFK: ส่ง input ปลอมทุก 4 นาที กันถูกเตะออกจากเกม
            if not getgenv()._SKT_AntiAFKConn then
                getgenv()._SKT_AntiAFKConn = task.spawn(function()
                    while getgenv()._SKT_AutoPhotoEnabled do
                        task.wait(10)
                        if getgenv()._SKT_Unloaded then break end
                        if not getgenv()._SKT_AutoPhotoEnabled then break end
                        local now = os.clock()
                        if now - (getgenv()._SKT_AntiAFKLastInput or 0) >= 240 then
                            getgenv()._SKT_AntiAFKLastInput = now
                            pcall(function()
                                -- VirtualUser heartbeat: counts as input for the idle kick
                                -- but does NOT press any keybind (RightShift toggles this UI).
                                local vu = game:GetService("VirtualUser")
                                vu:CaptureController()
                                vu:ClickButton2(Vector2.new(0, 0))
                            end)
                        end
                    end
                    getgenv()._SKT_AntiAFKConn = nil
                end)
            end
            -- Track prompts via ProximityPromptService events instead of
            -- scanning all of workspace:GetDescendants() every 1.5s (a full
            -- workspace scan is tens of thousands of instances = hitch).
            if not getgenv()._SKT_PromptShownConn then
                local pps = game:GetService("ProximityPromptService")
                getgenv()._SKT_ShownPrompts = getgenv()._SKT_ShownPrompts or {}
                getgenv()._SKT_PromptShownConn = pps.PromptShown:Connect(function(prompt)
                    getgenv()._SKT_ShownPrompts[prompt] = os.clock()
                end)
                getgenv()._SKT_PromptHiddenConn = pps.PromptHidden:Connect(function(prompt)
                    getgenv()._SKT_ShownPrompts[prompt] = nil
                end)
            end
            -- Auto-skip dialog: กด Space ทุก 1.5s เพื่อข้าม dialog/animation
            if not getgenv()._SKT_AutoSkipDialogConn then
                getgenv()._SKT_AutoSkipDialogConn = task.spawn(function()
                    while getgenv()._SKT_AutoPhotoEnabled do
                        task.wait(1.5)
                        if getgenv()._SKT_Unloaded then break end
                        if not getgenv()._SKT_AutoPhotoEnabled then break end
                        -- เช็คว่ามี dialog/ProximityPrompt อยู่ไหม
                        local hasDialog = false
                        pcall(function()
                            local pg = game:GetService("Players").LocalPlayer:FindFirstChild("PlayerGui")
                            if pg then
                                -- Skip known-huge GUIs (our hub, phone, emote
                                -- wheel, scoreboards) — scanning all 17k+
                                -- descendants every 1.5s caused a hitch.
                                local skipGui = {
                                    Int3UI = true, FluxUILayerTop = true,
                                    EmoteWheel = true, FlipPhoneGui = true,
                                    PianoScreenGui = true,
                                }
                                for _, gui in ipairs(pg:GetChildren()) do
                                    if hasDialog then break end
                                    if gui:IsA("ScreenGui") and gui.Enabled
                                        and not skipGui[gui.Name] then
                                        for _, d in ipairs(gui:GetDescendants()) do
                                            if d:IsA("TextLabel") and d.Visible then
                                                local txt = tostring(d.Text or ""):lower()
                                                if txt:match("press") or txt:match("tap") or txt:match("continue")
                                                    or txt:match("skip") or txt:match("close") or txt:match("dialog") then
                                                    hasDialog = true
                                                    break
                                                end
                                            end
                                        end
                                    end
                                end
                            end
                            -- เช็ค ProximityPrompt ที่โชว์ให้เราเมื่อไม่นานมานี้
                            -- (PromptShown fires only when the prompt is in
                            -- range + line of sight, so no distance check needed)
                            if not hasDialog then
                                local shown = getgenv()._SKT_ShownPrompts
                                if shown then
                                    local now = os.clock()
                                    for p, t in pairs(shown) do
                                        if p:IsA("ProximityPrompt") and p.Enabled and (now - t) < 6 then
                                            hasDialog = true break end
                                    end
                                end
                            end
                        end)
                        if hasDialog then
                            pcall(function()
                                local vim = game:GetService("VirtualInputManager")
                                vim:SendKeyEvent(true, Enum.KeyCode.Space, false, game)
                                task.wait(0.05)
                                vim:SendKeyEvent(false, Enum.KeyCode.Space, false, game)
                            end)
                        end
                    end
                    getgenv()._SKT_AutoSkipDialogConn = nil
                end)
            end
            -- Auto-equip phone: ถือมือถืออัตโนมัติถ้ายังไม่ได้ถือ
            if not getgenv()._SKT_AutoEquipPhoneConn then
                getgenv()._SKT_AutoEquipPhoneConn = task.spawn(function()
                    while getgenv()._SKT_AutoPhotoEnabled do
                        task.wait(2)
                        if getgenv()._SKT_Unloaded then break end
                        if not getgenv()._SKT_AutoPhotoEnabled then break end
                        local char = game:GetService("Players").LocalPlayer.Character
                        if char and char:GetAttribute("ItemEquipped") ~= "FlipPhone" then
                            pcall(_equipPhone)
                        end
                    end
                    getgenv()._SKT_AutoEquipPhoneConn = nil
                end)
            end
        else
            if getgenv()._SKT_NoclipConnection then
                getgenv()._SKT_NoclipConnection:Disconnect()
                getgenv()._SKT_NoclipConnection = nil
            end
            getgenv()._SKT_AntiSitJumpConn = nil
            getgenv()._SKT_AntiAFKConn = nil
            getgenv()._SKT_AutoSkipDialogConn = nil
            getgenv()._SKT_AutoEquipPhoneConn = nil
            if getgenv()._SKT_PromptShownConn then
                pcall(function() getgenv()._SKT_PromptShownConn:Disconnect() end)
                getgenv()._SKT_PromptShownConn = nil
            end
            if getgenv()._SKT_PromptHiddenConn then
                pcall(function() getgenv()._SKT_PromptHiddenConn:Disconnect() end)
                getgenv()._SKT_PromptHiddenConn = nil
            end
            if getgenv()._SKT_ShownPrompts then
                table.clear(getgenv()._SKT_ShownPrompts)
            end
            -- หยุด follow + ล่าง BodyVelocity + unanchor
            if typeof(_photoHardStop) == "function" then
                _photoHardStop()
            end
            pcall(function()
                local char = game:GetService("Players").LocalPlayer.Character
                if char then
                    local root = char:FindFirstChild("HumanoidRootPart")
                    if root then
                        root.Anchored = false
                        root.Velocity = Vector3.new(0, 0, 0)
