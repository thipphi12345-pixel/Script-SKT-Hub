                if inst:IsA("Model") then
                    local pp = inst.PrimaryPart or inst:FindFirstChildWhichIsA("BasePart", true)
                    pos = pp and pp.Position
                else
                    pos = inst.Position
                end
                if pos then
                    results[matchLabel] = { path = inst:GetFullName(), position = pos }
                end
            end
        end
    end

    _photoAreaResults = results
end

