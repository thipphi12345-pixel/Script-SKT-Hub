        local showM2Status = Toggles.ESPShowM2Status and Toggles.ESPShowM2Status.Value
        local showStyle = Toggles.ESPShowStyle and Toggles.ESPShowStyle.Value
        local showDist = Toggles.ESPShowDistance and Toggles.ESPShowDistance.Value
        local showTracers = Toggles.ESPTracers and Toggles.ESPTracers.Value
        local showHighlight = Toggles.ESPHighlight and Toggles.ESPHighlight.Value
        local tracerColor = (Options.ESPTracerColor and Options.ESPTracerColor.Value) or Color3.fromRGB(255, 255, 255)
        local highlightColor = (Options.ESPHighlightColor and Options.ESPHighlightColor.Value) or Color3.fromRGB(255, 60, 60)
        local range = (Options.ESPRange and Options.ESPRange.Value) or 100000
        local myChar = LocalPlayer.Character
        local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")

        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer then
                local char = player.Character
                local hum = char and char:FindFirstChildOfClass("Humanoid")
                local head = char and (char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart"))
                local alive = hum and hum.Health > 0
                local dist = 0
                local inRange = true
                if myRoot and head then
                    dist = (myRoot.Position - head.Position).Magnitude
                    -- inRange = dist <= range (Removed limit to show all players)
                end

                if on and char and hum and head and alive and inRange then
                    local o = espObjects[player]
                    if not o or o.gui.Adornee ~= head then
                        if o then RemoveESP(player) end
                        MakeESP(player, head)
                        o = espObjects[player]
                        o._lastText = nil -- force refresh on rebuild
                    end

                    -- Build name string (like Premium)
                    local nameStr = player.DisplayName or player.Name
                    if showStyle then
                        local style = styleOf(char)
                        if style and style ~= "default" and style ~= "" then
                            nameStr = string.format("%s\n<font size='10' color='#cccccc'>[%s]</font>", nameStr, style)
                        end
                    end
                    if showDist then
                        local meters = math.floor(dist * 0.28)
                        nameStr = nameStr .. string.format("\n<font size='10' color='#ffeb8a'>[%dm]</font>", meters)
                    end
                    -- RichText writes re-parse markup every time -- only write
                    -- when the string actually changed (major FPS saver).
                    if o._lastText ~= nameStr then
                        o._lastText = nameStr
                        o.text.Text = nameStr
                    end

                    -- HP bar (always show when ESP is on). Quantized to 2%
                    -- steps so bars/gradients only rebuild when health
                    -- actually moves -- avoids ColorSequence churn per tick.
                    if o.hpBg and not o._hpShown then o.hpBg.Visible = true o._hpShown = true end
                    local hpPct = math.clamp(hum.Health / (hum.MaxHealth > 0 and hum.MaxHealth or 100), 0, 1)
                    local hpQ = math.floor(hpPct * 50 + 0.5)
                    if o._lastHpQ ~= hpQ then
                        o._lastHpQ = hpQ
                        local pq = hpQ / 50
                        o.hpFill.Size = UDim2.new(pq, 0, 1, 0)
                        local green = Color3.fromRGB(70, 225, 70)
                        local yellow = Color3.fromRGB(255, 180, 0)
                        local red = Color3.fromRGB(255, 70, 70)
                        local curColor
                        if pq > 0.5 then
                            curColor = yellow:Lerp(green, (pq - 0.5) * 2)
                        else
                            curColor = red:Lerp(yellow, pq * 2)
                        end
                        o.hpFill.BackgroundColor3 = curColor
                        if o.hpGrad then
                            o.hpGrad.Color = ColorSequence.new(curColor, Color3.new(curColor.R * 0.6, curColor.G * 0.6, curColor.B * 0.6))
                        end
                    end

                    -- Stamina bar
                    if showStam then
                        if not o._stamShown then o.stamBg.Visible = true o._stamShown = true end
                        local stam = char:GetAttribute("Stamina")
                        if typeof(stam) ~= "number" then stam = 100 end
                        local maxStam = char:GetAttribute("MaxStamina")
                        if typeof(maxStam) ~= "number" then maxStam = 100 end
                        local stamPct = math.clamp(stam / maxStam, 0, 1)
                        local stamQ = math.floor(stamPct * 50 + 0.5)
                        if o._lastStamQ ~= stamQ then
                            o._lastStamQ = stamQ
                            o.stamFill.Size = UDim2.new(stamQ / 50, 0, 1, 0)
                            local sC = (Options.ESPStaminaColor and Options.ESPStaminaColor.Value) or Color3.fromRGB(70, 150, 255)
                            o.stamFill.BackgroundColor3 = sC
                            if o.stamGrad then
                                o.stamGrad.Color = ColorSequence.new(sC, Color3.new(sC.R * 0.6, sC.G * 0.6, sC.B * 0.6))
                            end
                        end
                    elseif o._stamShown ~= false then
                        o._stamShown = false
                        o.stamBg.Visible = false
                    end

                    -- M2 status bar
                    if showM2Status and o.m2Bg then
                        if o._m2Shown ~= true then o.m2Bg.Visible = true o._m2Shown = true end
                        local onCooldown = char:GetAttribute("M2Cooldown") == true
                        if o._lastM2Cd ~= onCooldown then
                            o._lastM2Cd = onCooldown
                            if onCooldown then
                                o.m2Fill.BackgroundColor3 = Color3.fromRGB(255, 70, 70)
                                if o.m2Grad then
                                    o.m2Grad.Color = ColorSequence.new(Color3.fromRGB(255, 70, 70), Color3.fromRGB(150, 40, 40))
                                end
                                if o.m2Txt then o.m2Txt.Text = "M2 COOLDOWN" end
                            else
                                o.m2Fill.BackgroundColor3 = Color3.fromRGB(70, 225, 70)
                                if o.m2Grad then
                                    o.m2Grad.Color = ColorSequence.new(Color3.fromRGB(70, 225, 70), Color3.fromRGB(40, 150, 40))
                                end
                                if o.m2Txt then o.m2Txt.Text = "M2 READY" end
                            end
                        end
                    elseif o.m2Bg and o._m2Shown ~= false then
                        o._m2Shown = false
                        o.m2Bg.Visible = false
                    end

                    -- Highlight (chams)
                    if o.highlight then
                        local wantHl = showHighlight == true
                        if o._lastHl ~= wantHl or (wantHl and o._lastHlColor ~= highlightColor) then
                            o._lastHl = wantHl
                            o._lastHlColor = highlightColor
                            o.highlight.Enabled = wantHl
                            if wantHl then
                                o.highlight.FillColor = highlightColor
                                o.highlight.OutlineColor = Color3.new(1, 1, 1)
                                if o.highlight.Parent ~= char then
                                    o.highlight.Parent = char
                                end
                            end
                        end
                    end

                    -- Tracers
                    if o.tracer then
                        local wantTracer = showTracers == true and myRoot ~= nil
                        if o._lastTracer ~= wantTracer then
                            o._lastTracer = wantTracer
                            o.tracer.Enabled = wantTracer
                            if wantTracer then o.tracer.Color = ColorSequence.new(tracerColor) end
                        end
                        if wantTracer and (not o.tracer.Attachment0 or o.tracer.Attachment0.Parent ~= myRoot) then
                            local att0 = myRoot:FindFirstChild("ESP_Att0")
                            if not att0 then
                                att0 = Instance.new("Attachment")
                                att0.Name = "ESP_Att0"
                                att0.Position = Vector3.new(0, -2, 0)
                                att0.Parent = myRoot
                            end
                            o.tracer.Attachment0 = att0
                        end
                    end
                else
                    if espObjects[player] then RemoveESP(player) end
                end
            end
        end

        for player in pairs(espObjects) do
            if not player.Parent then RemoveESP(player) end
        end
        end)
        if not ok then
            warn("[SKT Hub X ESP] loop error: " .. tostring(err))
        end

        local rate = (Options.ESPUpdateRate and Options.ESPUpdateRate.Value) or 10
        task.wait(math.clamp(1 / rate, 0.05, 0.5))
    end
end)

