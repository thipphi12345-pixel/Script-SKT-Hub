            return cachedLeftDoor, cachedRightDoor
        end

        local classroomDoors = game:GetService("Workspace"):FindFirstChild("ClassroomDoors")
        local slidingDoors = classroomDoors and classroomDoors:FindFirstChild("SlidingDoors")
        cachedLeftDoor = slidingDoors and slidingDoors:FindFirstChild("LeftDoor") or nil
        cachedRightDoor = slidingDoors and slidingDoors:FindFirstChild("RightDoor") or nil
        table.clear(cachedDoorParts)
        return cachedLeftDoor, cachedRightDoor
    end

    local function GetDoorParts(door)
        if not door then return nil end
        local cached = cachedDoorParts[door]
        if cached then return cached end

        local parts = {}
        if door:IsA("BasePart") then
            parts[#parts + 1] = door
        end
        for _, descendant in ipairs(door:GetDescendants()) do
            if descendant:IsA("BasePart") then
                parts[#parts + 1] = descendant
            end
        end
        cachedDoorParts[door] = parts
        return parts
    end

    local function ObjectAhead(root, object)
        if not object or not object.Parent then return false, math.huge end

        local parts = GetDoorParts(object)
        local bestScore = math.huge
        for _, part in ipairs(parts or {}) do
            if part.Parent then
                local relative = root.CFrame:PointToObjectSpace(part.Position)
                local forward = -relative.Z
                local lateral = math.abs(relative.X)
                local vertical = math.abs(relative.Y)
                local horizontalAllowance = 3.5 + math.max(part.Size.X, part.Size.Z) * 0.5
                local verticalAllowance = 4.5 + part.Size.Y * 0.5
                local forwardAllowance = 10 + math.max(part.Size.X, part.Size.Z) * 0.5

                if forward >= -0.75
                    and forward <= forwardAllowance
                    and lateral <= horizontalAllowance
                    and vertical <= verticalAllowance then
                    local score = math.max(forward, 0) + lateral * 0.35 + vertical * 0.1
                    if score < bestScore then bestScore = score end
                end
            end
        end

        if bestScore < math.huge then return true, bestScore end

        if object:IsA("Model") then
            local ok, boxCFrame, boxSize = pcall(object.GetBoundingBox, object)
            if ok and boxCFrame and boxSize then
                local relative = root.CFrame:PointToObjectSpace(boxCFrame.Position)
                local forward = -relative.Z
                local lateral = math.abs(relative.X)
                local vertical = math.abs(relative.Y)
                if forward >= -0.75
                    and forward <= 10 + math.max(boxSize.X, boxSize.Z) * 0.5
                    and lateral <= 3.5 + math.max(boxSize.X, boxSize.Z) * 0.5
                    and vertical <= 4.5 + boxSize.Y * 0.5 then
                    return true, math.max(forward, 0) + lateral * 0.35
                end
            end
        end

        return false, math.huge
    end

    local function FireDoor(remote, door, doorName)
        local arguments = DOOR_ARGUMENTS[doorName]
        if not door or not door.Parent or not arguments then return false end
        return pcall(function()
            remote:FireServer(door, arguments[1], arguments[2], arguments[3])
        end)
    end

    local function OpenDoorAhead()
        local character = LocalPlayer.Character
        local root = character and character:FindFirstChild("HumanoidRootPart")
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        if not character or not root or not humanoid or humanoid.Health <= 0 then return end

        local leftDoor, rightDoor = ResolveDoors()
        if not leftDoor and not rightDoor then return end

        local leftAhead, leftScore = ObjectAhead(root, leftDoor)
        local rightAhead, rightScore = ObjectAhead(root, rightDoor)
        if not leftAhead and not rightAhead then return end

        local now = os.clock()
        if now - lastOpenAt < 1 then return end

        local remotes = ReplicatedStorage:FindFirstChild("Remotes")
        local remote = remotes and remotes:FindFirstChild("Door")
        if not remote or not remote:IsA("RemoteEvent") then return end

        lastOpenAt = now
        local opened = false
        if leftDoor then opened = FireDoor(remote, leftDoor, "LeftDoor") or opened end
        if rightDoor then opened = FireDoor(remote, rightDoor, "RightDoor") or opened end

        if not opened or not leftDoor or not rightDoor then
            cachedLeftDoor = nil
            cachedRightDoor = nil
            table.clear(cachedDoorParts)
        end
    end

    local function Run(workerGeneration)
        while enabled
            and generation == workerGeneration
            and Library._Performance
            and Library._Performance.Alive do
            OpenDoorAhead()
            task.wait(0.1)
        end
    end

    function Controller:SetEnabled(value)
        value = value == true
        if value == enabled then return end

        enabled = value
        generation += 1
        lastOpenAt = 0
        if enabled then
            task.spawn(Run, generation)
        end
    end

    function Controller:Destroy()
        enabled = false
        generation += 1
        lastOpenAt = 0
        cachedLeftDoor = nil
        cachedRightDoor = nil
        table.clear(cachedDoorParts)
    end

    return Controller
end)()

Library._LockOnController = (function()
    local Controller = {}
    local ContextActionService = game:GetService("ContextActionService")
    local ACTION = "InteriumLockOn"
    local RENDER = "InteriumLockOnCamera"
    local targetPlayer
    local enabled = false

    local function SetCameraOffset(offset)
        local character = LocalPlayer.Character
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        if humanoid then humanoid.CameraOffset = offset end
    end

    local function Notify(message)
        pcall(function()
            Library:Notify({ Title = "Lock-On", Description = message, Time = 2 })
        end)
    end

    local function LivingRoot(player)
        local character = player and player.Character
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        local root = character and (character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("Head"))
        if humanoid and humanoid.Health > 0 and root then return root end
        return nil
    end

    local function PlayerFromMouse()
        local mouse = LocalPlayer:GetMouse()
        local part = mouse and mouse.Target
        if not part then return nil end
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character and part:IsDescendantOf(player.Character) then
                return player
            end
        end
        return nil
    end

    local function PlayerNearestScreenCenter()
        local camera = game:GetService("Workspace").CurrentCamera
        if not camera then return nil end
        local center = camera.ViewportSize * 0.5
        local limit = math.max(180, math.min(camera.ViewportSize.X, camera.ViewportSize.Y) * 0.35)
        local best, bestDistance
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer then
                local root = LivingRoot(player)
                if root then
                    local point, visible = camera:WorldToViewportPoint(root.Position)
                    if visible then
                        local distance = (Vector2.new(point.X, point.Y) - center).Magnitude
                        if distance <= limit and (not bestDistance or distance < bestDistance) then
                            best, bestDistance = player, distance
                        end end end end end
        return best
    end

    local function SetTarget(player)
        if player == targetPlayer then player = nil end
        targetPlayer = player
        if not player then SetCameraOffset(Vector3.zero) end
        Notify(player and ("Locked to " .. player.DisplayName) or "Unlocked")
    end
    function Controller:GetTarget()
        return targetPlayer
    end

    local function HandleAction(_, state, input)
        if state ~= Enum.UserInputState.Begin then return Enum.ContextActionResult.Sink end
        local player = input.UserInputType == Enum.UserInputType.MouseButton3
            and PlayerFromMouse() or PlayerNearestScreenCenter()
        if player then
            SetTarget(player)
        elseif targetPlayer then
            SetTarget(nil)
        else
            Notify("No player near the center of the screen")
        end
        return Enum.ContextActionResult.Sink
    end

    function Controller:SetEnabled(value)
        value = value == true
        if enabled == value then return end
        enabled = value
        if not enabled then
            targetPlayer = nil
            SetCameraOffset(Vector3.zero)
            ContextActionService:UnbindAction(ACTION)
            RunService:UnbindFromRenderStep(RENDER)
            return
        end

        ContextActionService:BindAction(ACTION, HandleAction, true, Enum.UserInputType.MouseButton3)
        ContextActionService:SetTitle(ACTION, "LOCK")
        ContextActionService:SetPosition(ACTION, UDim2.new(1, -145, 1, -285))
        RunService:BindToRenderStep(RENDER, Enum.RenderPriority.Camera.Value + 1, function()
            if not targetPlayer then return end
            local camera = game:GetService("Workspace").CurrentCamera
            local root = LivingRoot(targetPlayer)
            if not (camera and root) then
                SetTarget(nil)
                return
            end
            SetCameraOffset(Vector3.new(
                tonumber(Options.LockOnOffsetX and Options.LockOnOffsetX.Value) or 0,
                tonumber(Options.LockOnOffsetY and Options.LockOnOffsetY.Value) or 0,
                tonumber(Options.LockOnOffsetZ and Options.LockOnOffsetZ.Value) or 0
            ))
            camera.CFrame = CFrame.lookAt(camera.CFrame.Position, root.Position, Vector3.yAxis)
        end)
    end

    function Controller:Destroy()
        self:SetEnabled(false)
    end

    return Controller
end)()

