-- Follow Player implementation
local followConn = nil
startFollow = function()
    if followConn then return end
    local _followElapsed = 0
    followConn = RunService.Heartbeat:Connect(function(dt)
        _followElapsed += dt
        if _followElapsed < 0.1 then return end
        _followElapsed = 0
        local sel = Options.TeleportTarget and Options.TeleportTarget.Value
        if not sel or sel == "(no players)" then return end
        local target = Players:FindFirstChild(sel)
        if not target or not target.Character then return end
        local tRoot = target.Character:FindFirstChild("HumanoidRootPart")
        local myChar = LocalPlayer.Character
        local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
        if not (tRoot and myRoot) then return end
        local offset = (Options.TeleportOffset and Options.TeleportOffset.Value) or 3
        if LocalPlayer.Character then LocalPlayer.Character:PivotTo(tRoot.CFrame * CFrame.new(0, 0, offset)) end
    end)
end
stopFollow = function()
    if followConn then
        followConn:Disconnect()
        followConn = nil
    end
end

TeleportPlayerGroup:AddToggle("FollowPlayer", {
    Text = "Follow Player",
    Default = false,
    Tooltip = "Teleports your character behind player",
    Callback = function(val)
        if val then startFollow() else stopFollow() end
    end,
})

