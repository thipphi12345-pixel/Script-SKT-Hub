-- Floor levels verified from map dump: main club floor Y≈-291.5, locker-level floor Y≈-283.2
local CLUB_AKUMA_POS = Vector3.new(-284.74, -288.0, 316.83)
local CLUB_AKUMA_LOCKER_POS = Vector3.new(-309.0, -280.0, 374.0)
local _akumaAutoRunning = false
local _akumaLastApply = 0
local _akumaLastTeleport = 0
local _akumaLastLocker = 0
local _akumaLastBoardRefresh = 0
local _akumaLastQuit = 0

local function _findAkumaShift()
    for _, s in ipairs(JobsState.shifts) do
        if s.Area and tostring(s.Area):lower():find("akuma") then
            return s
        end
    end
    return nil
end

local function _teleportTo(pos)
    local LP = game:GetService("Players").LocalPlayer
    local char = LP and LP.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return false end
    pcall(function()
        local ws = game:GetService("Workspace")
        local target = pos
        -- Raycast down to land on real floor (prevents falling through the map)
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.FilterDescendantsInstances = { char }
        local hit = ws:Raycast(pos + Vector3.new(0, 8, 0), Vector3.new(0, -30, 0), params)
        if hit then
            target = Vector3.new(pos.X, hit.Position.Y + 3.2, pos.Z)
        end
        char:PivotTo(CFrame.new(target))
        root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
    end)
    return true
end

local function _teleportToAkuma()
    return _teleportTo(CLUB_AKUMA_POS)
end

