            pcall(VirtualInputManager.SendMouseButtonEvent, VirtualInputManager, input.X, input.Y, 0, false, game, 0)
        elseif input.Mode == "Button" and input.Target and input.Target.Parent and type(firesignal) == "function" then
            pcall(firesignal, input.Target.MouseButton1Up, input.X, input.Y)
        end
    end

    function Controller:PressLane(lane, length, generation)
        if not self.Running or generation ~= self.Generation then return end
        local receptor = self.Receptors[lane]
        if not receptor or not receptor.Parent then return end
        self:ReleaseLane(lane)

        local keyCode = GetKeyCode(receptor)
        local input
        if keyCode then
            local action = CallBoundAction(keyCode, Enum.UserInputState.Begin)
            if action then
                input = { Mode = "Action", Action = action }
            elseif not IS_TOUCH
                and pcall(VirtualInputManager.SendKeyEvent, VirtualInputManager, true, keyCode, false, game) then
                input = { Mode = "Keyboard", KeyCode = keyCode }
            end
        end

        if not input then
            local target = receptor:IsA("GuiButton") and receptor
                or receptor:FindFirstChildWhichIsA("GuiButton", true)
                or receptor
            local center = GetCenter(target)
            local x, y = math.floor(center.X), math.floor(center.Y)
            local canFireButton = target:IsA("GuiButton") and type(firesignal) == "function"
            if canFireButton and type(getconnections) == "function" then
                local ok, connections = pcall(getconnections, target.MouseButton1Down)
                canFireButton = ok and type(connections) == "table" and #connections > 0
            end
            if canFireButton and pcall(firesignal, target.MouseButton1Down, x, y) then
                input = { Mode = "Button", Target = target, X = x, Y = y }
            elseif pcall(VirtualInputManager.SendTouchEvent, VirtualInputManager, lane, 0, x, y) then
                input = { Mode = "Touch", X = x, Y = y }
            elseif pcall(VirtualInputManager.SendMouseButtonEvent, VirtualInputManager, x, y, 0, true, game, 0) then
                input = { Mode = "Mouse", X = x, Y = y }
            end
        end

        if not input then return end
        self.Held[lane] = input
        task.delay(math.max(tonumber(length) or 0, TOUCH_LEAD > 0 and 0.04 or 0.02), function()
            if generation == self.Generation and self.Held[lane] == input then
                self:ReleaseLane(lane)
            end
        end)
    end

    function Controller:PickDelay()
        local order = { "Perfect", "Good", "Okay", "Bad", "Miss" }
        local ranges = {
            Perfect = { 0, 0 },
            Good = { 0.035, 0.055 },
            Okay = { 0.07, 0.095 },
            Bad = { 0.11, 0.145 },
        }
        local total = 0
        for _, name in ipairs(order) do
            local option = Options["Rhythm" .. name]
            total += math.max(tonumber(option and option.Value) or 0, 0)
        end
        if total <= 0 then return 0 end
        local roll = math.random() * total
        for _, name in ipairs(order) do
            local option = Options["Rhythm" .. name]
            roll -= math.max(tonumber(option and option.Value) or 0, 0)
            if roll <= 0 then
                if name == "Miss" then return nil end
                local range = ranges[name]
                return range[1] + math.random() * (range[2] - range[1])
            end
        end
        return 0
    end

    function Controller:TrackNote(note)
        if note.Name == "NoteTemplate" and note:IsA("GuiObject") then
            self.Notes[note] = self.Notes[note] or { WasVisible = false }
        end
    end

    function Controller:BindRoot(root)
        if root == self.Root then return end
        DisconnectAll(self.Connections)
        self.Root = root
        self.Lanes = root and root:FindFirstChild("Lanes")
        table.clear(self.Receptors)
        self.Notes = setmetatable({}, { __mode = "k" })
        if not root then return end

        local receptors = root:FindFirstChild("Receptors")
        local function TrackReceptor(receptor)
            local lane = tonumber(receptor.Name:match("(%d+)$"))
            if lane and receptor:IsA("GuiObject") then self.Receptors[lane] = receptor end
        end
        if receptors then
            for _, receptor in ipairs(receptors:GetChildren()) do TrackReceptor(receptor) end
            table.insert(self.Connections, receptors.ChildAdded:Connect(TrackReceptor))
            table.insert(self.Connections, receptors.ChildRemoved:Connect(function(receptor)
                for lane, tracked in pairs(self.Receptors) do
                    if tracked == receptor then self.Receptors[lane] = nil end
                end
            end))
        end
        if self.Lanes then
            for _, descendant in ipairs(self.Lanes:GetDescendants()) do self:TrackNote(descendant) end
            table.insert(self.Connections, self.Lanes.DescendantAdded:Connect(function(note)
                self:TrackNote(note)
            end))
            table.insert(self.Connections, self.Lanes.DescendantRemoving:Connect(function(note)
                self.Notes[note] = nil
            end))
        end
        table.insert(self.Connections, root.ChildAdded:Connect(function(child)
            if child.Name == "Lanes" or child.Name == "Receptors" then self.Root = nil end
        end))
        table.insert(self.Connections, root.ChildRemoved:Connect(function(child)
            if child == self.Lanes or child == receptors then self.Root = nil end
        end))
    end

    function Controller:Step()
        if not self.Running then return end
        local ui = PlayerGui:FindFirstChild("RhythmServiceUI")
        local root = ui and ui:FindFirstChild("RhythmRoot")
        self:BindRoot(root)
        if not root or not self.Lanes or not next(self.Receptors) then
            self:SetStatus("fallback waiting -- equip an instrument and start a song")
            return
        end

        local active = 0
        local generation = self.Generation
        for note, state in pairs(self.Notes) do
            if not note.Parent then
                self.Notes[note] = nil
            elseif note.Visible then
                active += 1
                local lane = tonumber(note:GetAttribute("NoteLane"))
                local receptor = lane and self.Receptors[lane]
                local signature = tostring(note:GetAttribute("NoteTime")) .. "|"
                    .. tostring(lane) .. "|" .. tostring(note:GetAttribute("NoteLength"))
                if signature ~= state.Signature or not state.WasVisible then
                    state.Signature = signature
                    state.Hit = false
                    state.PreviousOffset = nil
                end
                state.WasVisible = true

                if not state.Hit and receptor then
                    local offset = note.AbsolutePosition.Y + note.AbsoluteSize.Y * note.AnchorPoint.Y
                        - (receptor.AbsolutePosition.Y + receptor.AbsoluteSize.Y * receptor.AnchorPoint.Y)
                    local now = os.clock()
                    local crossed = offset == 0
                    if state.PreviousOffset ~= nil then
                        local elapsed = now - (state.PreviousClock or now)
                        local speed = elapsed > 0 and (offset - state.PreviousOffset) / elapsed or 0
                        local arrival = math.abs(speed) > 0.001 and -offset / speed or math.huge
                        crossed = (state.PreviousOffset < 0 and offset >= 0)
                            or (state.PreviousOffset > 0 and offset <= 0)
                            or (TOUCH_LEAD > 0 and arrival >= 0 and arrival <= TOUCH_LEAD)
                    end
                    state.PreviousOffset, state.PreviousClock = offset, now
                    if crossed then
                        state.Hit = true
                        local delay = self:PickDelay()
                        if delay ~= nil then
                            local length = math.max(tonumber(note:GetAttribute("NoteLength")) or 0, 0)
                            if delay <= 0 then
                                self:PressLane(lane, length, generation)
                            else
                                task.delay(delay, function()
                                    self:PressLane(lane, length, generation)
                                end)
                            end
                        end
                    end
                end
            else
                state.WasVisible = false
            end
        end
        self:SetStatus(string.format("UI fallback active -- %d notes", active))
    end

    function Controller:Start(statusCallback)
        if self.Running then
            self.Status = statusCallback
            return
        end
        self.Running = true
        self.Generation += 1
        self.Status = statusCallback
        self.RenderConnection = RunService.RenderStepped:Connect(function() self:Step() end)
    end

    function Controller:Stop()
        if not self.Running and not self.RenderConnection then return end
        self.Running = false
        self.Generation += 1
        if self.RenderConnection then self.RenderConnection:Disconnect() end
        self.RenderConnection = nil
        for lane in pairs(self.Held) do self:ReleaseLane(lane) end
        self:BindRoot(nil)
        self.Status = nil
    end

    function Controller:Destroy()
        self:Stop()
    end

    return Controller
end)()

function StartRhythmEngine()
    if rhythmEngineRunning then return end
    rhythmEngineRunning = true
    Library._Performance.RhythmGeneration = (Library._Performance.RhythmGeneration or 0) + 1
    local generation = Library._Performance.RhythmGeneration
    Library._Performance:RefreshGCFor("rhythm")

    local ORDER = { "Perfect", "Good", "Okay", "Bad", "Miss" }
    local JMAP  = { Perfect = "PERFECT", Good = "GOOD", Okay = "OKAY", Bad = "BAD", Miss = "MISS" }

    local setId = setthreadidentity or setidentity
        or (getgenv and (getgenv().setthreadidentity or getgenv().setidentity))
    local function Elevate()
        if setId then pcall(setId, 8) end
    end

    local function CollectGC()
        return _CollectGC()
    end

    local inspectedModules = setmetatable({}, { __mode = "k" })
    local function FindViaModules()
        local glm = getloadedmodules or (getgenv and getgenv().getloadedmodules)
        local guv = debug and debug.getupvalues
        if typeof(glm) ~= "function" or typeof(guv) ~= "function" then return nil end
        local found
        local now = os.clock()
        pcall(function()
            for _, m in ipairs(glm()) do
                local lastInspectedAt = inspectedModules[m]
                if (not lastInspectedAt or now - lastInspectedAt >= 6)
                    and typeof(m) == "Instance"
                    and m.Parent ~= nil
                    and (m:IsA("ModuleScript") or m:IsA("Script")) then
                    inspectedModules[m] = now
                    local okReq, mod = pcall(require, m)
                    if okReq and type(mod) == "table" then
                        for _, fn in pairs(mod) do
                            if type(fn) == "function" then
                                local okUv, ups = pcall(guv, fn)
                                if okUv and type(ups) == "table" then
                                    for _, u in pairs(ups) do
                                        if type(u) == "table" and rawget(u, "_startPlayGateUntil") ~= nil
                                            and rawget(u, "_startPlaySeq") ~= nil then
                                            found = u
                                            return
                                        end end end end end
                    end
                end
            end
        end)
        return found
    end

    local svc = nil
    local function FindService()
        if svc and rawget(svc, "_startPlaySeq") ~= nil then return svc end
        svc = nil
        local gc = CollectGC()
        if gc then
            for _, o in ipairs(gc) do
                if type(o) == "table" and rawget(o, "_startPlayGateUntil") ~= nil and rawget(o, "_startPlaySeq") ~= nil then
                    svc = o; break
                end
            end
        end
        if not svc then
            svc = FindViaModules()
        end
        return svc
    end

    local function PickJudgment()
        local r = {}
        for _, n in ipairs(ORDER) do
            local opt = Options["Rhythm" .. n]
            r[n] = (opt and opt.Value) or 0
        end
        local total = 0
        for _, n in ipairs(ORDER) do total += (r[n] or 0) end
        if total <= 0 then return "PERFECT" end
        local roll = math.random() * total
        local cum = 0
        for _, n in ipairs(ORDER) do
            cum += (r[n] or 0)
            if roll <= cum then return JMAP[n] end
        end
        return "PERFECT"
    end

    local function EarlyOffsetFor(judgment, windows)
        local function SampleBand(low, high)
            return (low + math.random() * math.max(high - low, 0)) / 1000
        end
        if judgment == "PERFECT" then return SampleBand(0, (windows.PERFECT or 43) * 0.8)
        elseif judgment == "GOOD" then return SampleBand((windows.PERFECT or 43) + 3, (windows.GOOD or 76) * 0.9)
        elseif judgment == "OKAY" then return SampleBand((windows.GOOD or 76) + 3, (windows.OKAY or 106) * 0.9)
        elseif judgment == "BAD"  then return SampleBand((windows.OKAY or 106) + 3, (windows.BAD or 140) * 0.9)
        end
        return nil
    end

    local lastStatusText
    local lastDiscoveryRefreshAt = os.clock()
    local nextPlayingStatusAt = 0
    local function SetRhythmStatus(text)
        text = tostring(text or "")
        if text == lastStatusText then return end
        lastStatusText = text
        local status = Options.RhythmStatus
        if status then pcall(status.SetText, status, text) end
    end

    task.spawn(function()
        Elevate()
        while rhythmEngineRunning and Library._Performance.Alive and Library._Performance.RhythmGeneration == generation do
            Elevate()
            local rt = Toggles.AutoRhythmToggle
            if not rt or not rt.Value then
                SetRhythmStatus("idle (toggle Auto Rhythm on)")
                task.wait(0.4)
                continue
            end

            local s = FindService()
            if not s then
                local now = os.clock()
                if now - lastDiscoveryRefreshAt >= 6 then
                    lastDiscoveryRefreshAt = now
                    Library._Performance:RefreshGCFor("rhythm")
                    s = FindService()
                end
            end
            if not s then
                if Library._RhythmUIFallback then
                    Library._RhythmUIFallback:Start(SetRhythmStatus)
                else
                    SetRhythmStatus("RhythmService not found -- equip an instrument on a stage")
                end
                task.wait(0.5)
                continue
            end
            local session = rawget(s, "_session")
            if not session or rawget(session, "_destroyed") or type(rawget(session, "_liveNotes")) ~= "table" then
                if Library._RhythmUIFallback then
                    Library._RhythmUIFallback:Start(SetRhythmStatus)
                else
                    SetRhythmStatus("waiting for a song to start...")
                end
                
                if session and rawget(session, "_destroyed") then
                    svc = nil
                    Library._Performance:RefreshGCFor("rhythm")
                    task.wait(2)
                else
                    task.wait(0.25)
                end
                continue
            end
            if Library._RhythmUIFallback then Library._RhythmUIFallback:Stop() end

            if rawget(session, "_autoplayEnabled") == true then
                session._autoplayEnabled = false
            end

            local okNow, now = pcall(session._now, session)
            if not okNow or type(now) ~= "number" then
                RunService.Heartbeat:Wait()
                continue
            end

            local W = rawget(session, "_windows") or { PERFECT = 43, GOOD = 76, OKAY = 106, BAD = 140 }
            local badSec = (W.BAD or 140) / 1000
            local active = rawget(session, "_active")

            if type(active) ~= "table" then
                RunService.Heartbeat:Wait()
                continue
            end

            local view = rawget(session, "_view")
            local callbacks = rawget(session, "_onLanePressedCallbacks")
            local activeCount = 0

            for _, note in pairs(active) do
                if type(note) == "table" and note.t then
                    activeCount += 1
                    if not (note.hit or note.attempted or note._ap) then
                        local dt = note.t - now
                        if dt <= -badSec then
                            note._ap = true
                        elseif dt < 1.0 then
                            if note._apJudg == nil then
                                note._apJudg = PickJudgment()
                                note._apOff = EarlyOffsetFor(note._apJudg, W)
                            end
                            if note._apJudg == "MISS" then
                            elseif note._apOff and now >= (note.t - note._apOff) then
                                local lane = note.lane
                                pcall(session._onPressLane, session, lane, note.t - note._apOff)
                                if view then pcall(view.PressReceptor, view, lane) end
                                if callbacks then
                                    for _, cb in pairs(callbacks) do
                                        if cb then pcall(cb, lane) end
                                    end
                                end
                                note._ap = true
                                if (note.len or 0) > 0 then
                                    local releaseAt = note.t + note.len
                                    task.delay(math.max(releaseAt - now, 0.05) + 0.03, function()
                                        Elevate()
                                        pcall(session._onReleaseLane, session, lane, releaseAt)
                                        if view then pcall(view.ReleaseReceptor, view, lane) end
                                    end)
                                end end end end end
            end

            local combo = rawget(session, "_combo") or 0
            local jc = rawget(session, "_judgeCounts") or {}
            local statusNow = os.clock()
            if statusNow >= nextPlayingStatusAt then
                nextPlayingStatusAt = statusNow + 0.2
                SetRhythmStatus(string.format("playing -- combo %d | active %d\nP%d G%d O%d B%d M%d",
                    combo, activeCount,
                    jc.PERFECT or 0, jc.GOOD or 0, jc.OKAY or 0, jc.BAD or 0, jc.MISS or 0))
            end

            RunService.Heartbeat:Wait()
        end
    end)

    local status = Options.RhythmStatus
    if status then pcall(status.SetText, status, "toggle Auto Rhythm, then play a song") end
end

if Toggles.AutoRhythmToggle then
    Toggles.AutoRhythmToggle:OnChanged(function(value)
        if value then
            StartRhythmEngine()
        else
            rhythmEngineRunning = false
            Library._Performance.RhythmGeneration = (Library._Performance.RhythmGeneration or 0) + 1
            if Library._RhythmUIFallback then Library._RhythmUIFallback:Stop() end
        end
    end)
    if Toggles.AutoRhythmToggle.Value then StartRhythmEngine() end
