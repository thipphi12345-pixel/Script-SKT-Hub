do
local POIGroup = Tabs.Teleport:AddRightGroupbox("Points of Interest")

local _poiScanDone = false
local function _poiFixedPos(name)
    if name == "Spawn" then
        local s = workspace:FindFirstChild("SpawnLocation")
        return s and s:IsA("BasePart") and s.Position
    elseif name == "GAKUMART (Shop)" then
        local m = workspace:FindFirstChild("GakumartModel")
        local pp = m and (m:IsA("BasePart") and m or m.PrimaryPart or m:FindFirstChildWhichIsA("BasePart", true))
        return pp and pp.Position
    elseif name == "Skateboard Shop" then
        local m = workspace:FindFirstChild("SkateboardShop")
        local pp = m and (m:IsA("BasePart") and m or m.PrimaryPart or m:FindFirstChildWhichIsA("BasePart", true))
        return pp and pp.Position
    elseif name == "Gymnasium" then
        local m = workspace:FindFirstChild("Indoor Gymnasium ") or workspace:FindFirstChild("Indoor Gymnasium")
        local pp = m and (m:IsA("BasePart") and m or m.PrimaryPart or m:FindFirstChildWhichIsA("BasePart", true))
        return pp and pp.Position
    end
    return nil
end

local POI_PHOTO_AREAS = {
    "Rooftop", "Courtyard", "Cafeteria", "Basketball Court", "Dojo Room",
    "Music Room", "Parking Lot", "Nishikata High Entrance", "Infirmary",
    "Study Room", "Lounge", "Nishikata District",
}

local function _poiResolvePos(name)
    local pos = _poiFixedPos(name)
    if pos then return pos end
    -- Photo-job areas live in the same AreaHitboxes scan the Area Teleport
    -- controller already maintains — reuse it (no extra workspace scan).
    -- Keys may be nested paths ("School/Rooftop"), so match on the last
    -- segment with normalization.
    local ctrl = Library._AreaTeleportController
    if not _poiScanDone and ctrl and typeof(ctrl.Refresh) == "function" then
        _poiScanDone = true
        pcall(function() ctrl:Refresh() end)
    end
    if ctrl and ctrl.Areas then
        local want = tostring(name):lower():gsub("[%s%p%c]", "")
        local part = ctrl.Areas[name]
        if part and part.Parent then return part.Position end
        for key, p in pairs(ctrl.Areas) do
            local seg = tostring(key):match("[^/]*$") or tostring(key)
            local norm = seg:lower():gsub("[%s%p%c]", "")
            if norm == want and p and p.Parent then return p.Position end
        end
    end
    -- Last resort: recursive name search
    local inst = workspace:FindFirstChild(name, true)
    if inst then
        if inst:IsA("BasePart") then return inst.Position end
        local pp = inst:IsA("Model") and (inst.PrimaryPart or inst:FindFirstChildWhichIsA("BasePart", true))
        if pp then return pp.Position end
    end
    return nil
end

local POI_NAMES = { "Spawn", "GAKUMART (Shop)", "Skateboard Shop", "Gymnasium" }
for _, a in ipairs(POI_PHOTO_AREAS) do table.insert(POI_NAMES, a) end

POIGroup:AddDropdown("POITarget", {
    Text = "Point of Interest",
    Values = POI_NAMES,
    Default = "Spawn",
    Multi = false,
    Tooltip = "Pick a fixed location: spawn, shops, gym, or any photo-job area.",
})
POIGroup:AddButton({
    Text = "Teleport to POI",
    Func = function()
        local sel = Options.POITarget and Options.POITarget.Value
        if not sel then return end
        local pos = _poiResolvePos(sel)
        if not pos then
            Library:Notify({ Title = "POI Teleport", Description = "Could not locate " .. tostring(sel) .. " (area not streamed in yet?).", Time = 3, Type = "Warning" })
            return
        end
        local myChar = LocalPlayer.Character
        local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
        if not myRoot then
            Library:Notify({ Title = "POI Teleport", Description = "Character is not ready.", Time = 3 })
            return
        end
        myChar:PivotTo(CFrame.new(pos + Vector3.new(0, 3, 0)))
        myRoot.AssemblyLinearVelocity = Vector3.zero
        myRoot.AssemblyAngularVelocity = Vector3.zero
        Library:Notify({ Title = "POI Teleport", Description = "Teleported to " .. tostring(sel), Time = 2 })
    end,
})

