    if tag == "" then
        pcall(function()
            Library:Notify({ Title = "Yen Transfer", Message = "Please enter a Target Yen Tag first.", Duration = 3 })
        end)
        return nil
    end
    if amount < 10 then
        pcall(function()
            Library:Notify({ Title = "Yen Transfer", Message = "Minimum transfer amount is 10 yen.", Duration = 3 })
        end)
        return nil
    end
    if amount > 250000 then
        pcall(function()
            Library:Notify({ Title = "Yen Transfer", Message = "Maximum transfer amount is 250,000 yen.", Duration = 3 })
        end)
        return nil
    end
    return tag, amount
end

