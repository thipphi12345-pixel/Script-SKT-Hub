            if not self:_IsIdle() then
                self.Note = "Context changed; waiting to apply the pending rollback first."
                return false
            end
            self:_ApplyPending()
            if self.PendingRecommendation then return false end
        end
        if self.Trial then
            if not self:_IsIdle() then
                self.Note = "Context changed; waiting for combat to settle before restoring the prior profile."
                return false
            end
            local rollback = table.clone(self.Trial.previous)
            rollback.reason = "context changed; restored the prior validated profile"
            rollback.trial = nil
            self.PendingRecommendation = nil
            self:_SetValues(rollback)
            self.AppliedAt = os.clock()
            self.LastApplied = rollback
            self.Trial = nil
        end
        self.CurrentContext = context
        self.CurrentKey = key
        self.PendingRecommendation = nil
        self.ValuesDirty = false
        self:_ResetMeasurements("Engine/input context changed; restarting the baseline.")
        local profile = self:_Profile(context)
        if profile.saved then
            self.NeedsBaseline = false
            self:_Queue(profile)
        else
            local current = self:_CurrentValues()
            self.NeedsBaseline = true
            self.LastApplied = {
                key = key,
                timingOffset = current.timingOffset,
                blockHold = current.blockHold,
                maxRange = current.maxRange,
