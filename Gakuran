        if not runtime or not attempt.id then return nil, nil, nil, nil end
        local engine = normalizeParryEngine(attempt.engine)
        local data = runtime:_modeData(engine)
        local key = LearningKey(attempt.id, attempt.strikeIndex)
        local record = data.animations[key]
        if typeof(record) ~= "table" then return key, nil, nil, nil end
        return key, tonumber(record.lead), tonumber(record.samples), record
    end

    function Controller:ObserveOutcome(attempt, kind, confidence)
        if not self.Running or typeof(attempt) ~= "table" then return end
        if type(attempt.method) == "string" and attempt.method ~= "" then
            self:_ObserveTransport(attempt.method)
        end
        if confidence ~= "explicit"
            or (self.AppliedAt > 0
                and (tonumber(attempt.createdAt) or 0) < self.AppliedAt) then
            return
        end
        self.OutcomeSerial += 1
        local now = os.clock()
        self:_PruneOutcomes(now)
        local learningKey, learnerLead, learnerSamples, learnerRecord =
            self:_LearningState(attempt)
        local scheduledLead = tonumber(attempt.learnedLead)
        local frozen = self.Trial and self.Trial.startedAt
            and self.Trial.learningSnapshot
            and self.Trial.learningSnapshot[learningKey] or nil
        if frozen then
            if typeof(learnerRecord) ~= "table" or not IsFinite(scheduledLead)
                or math.abs(scheduledLead - frozen.lead) > 0.000001 then
                return
            end
            learnerRecord.lead = frozen.lead
            learnerLead = frozen.lead
        elseif not IsFinite(learnerLead) or not IsFinite(scheduledLead)
            or math.abs(learnerLead - scheduledLead) > 0.000001 then
            return
        end
        local event = {
            serial = self.OutcomeSerial,
            at = now,
            kind = tostring(kind),
            confidence = tostring(confidence),
            animation = tostring(attempt.id or "unknown"),
            style = tostring(attempt.styleKey or "unknown"),
            strike = math.max(1, math.floor(tonumber(attempt.strikeIndex) or 1)),
            learningKey = learningKey,
            learnerLead = learnerLead,
            scheduledLead = scheduledLead,
            learnerSamples = learnerSamples,
            direction = 0,
            weight = 0,
        }
        if kind == "regular" then
            event.direction = 1
            event.weight = 0.5
        elseif kind == "hit" then
            local impactAt = tonumber(attempt.predictedImpactAt)
            local commandLate = impactAt and tonumber(attempt.commandAt)
                and attempt.commandAt >= impactAt
            local activationLate = impactAt and tonumber(attempt.activationAt)
                and attempt.activationAt >= impactAt
            if commandLate or activationLate then
                event.direction = -1
                event.weight = 1
            end
        end
        self.Outcomes[#self.Outcomes + 1] = event
        if #self.Outcomes > self.MaximumOutcomes + 32 then
            local count = #self.Outcomes
            local first = count - self.MaximumOutcomes + 1
            table.move(self.Outcomes, first, count, 1)
            for index = self.MaximumOutcomes + 1, count do
                self.Outcomes[index] = nil
            end
        end
    end

    function Controller:_OutcomeSummary()
        self:_PruneOutcomes(os.clock())
        local summary = {
            total = #self.Outcomes,
            explicit = 0,
            perfect = 0,
            regular = 0,
            hit = 0,
            styles = {},
            explicitStyles = {},
            explicitAnimations = {},
            explicitPerfect = 0,
            explicitRegular = 0,
            explicitHit = 0,
            byAnimation = {},
            buckets = {},
        }
        for _, event in ipairs(self.Outcomes) do
            summary[event.kind] = (tonumber(summary[event.kind]) or 0) + 1
            if event.confidence == "explicit" then
                summary.explicit += 1
                local explicitKey = "explicit"
                    .. string.upper(string.sub(event.kind, 1, 1))
                    .. string.sub(event.kind, 2)
                summary[explicitKey] = (tonumber(summary[explicitKey]) or 0) + 1
                if event.style ~= "unknown" then summary.explicitStyles[event.style] = true end
                if event.animation ~= "unknown" then
                    local animationKey = LearningKey(event.animation, event.strike)
                    summary.explicitAnimations[animationKey] = true
                    local outcomes = summary.byAnimation[animationKey]
                    if not outcomes then
                        outcomes = {
                            total = 0,
                            perfect = 0,
                            regular = 0,
                            hit = 0,
                            leadMinimum = math.huge,
                            leadMaximum = -math.huge,
                            sampleMinimum = math.huge,
                            styles = {},
                        }
                        summary.byAnimation[animationKey] = outcomes
                    end
                    outcomes.total += 1
                    outcomes[event.kind] = (tonumber(outcomes[event.kind]) or 0) + 1
                    if event.style ~= "unknown" then outcomes.styles[event.style] = true end
                    if IsFinite(event.learnerLead) then
                        outcomes.leadMinimum = math.min(outcomes.leadMinimum, event.learnerLead)
                        outcomes.leadMaximum = math.max(outcomes.leadMaximum, event.learnerLead)
                    end
                    if IsFinite(event.learnerSamples) then
                        outcomes.sampleMinimum = math.min(
                            outcomes.sampleMinimum,
                            event.learnerSamples
                        )
                    end
                end
            end
            if event.style ~= "unknown" then summary.styles[event.style] = true end
            if event.direction ~= 0 and event.animation ~= "unknown" then
                local key = LearningKey(event.animation, event.strike)
                local bucket = summary.buckets[key]
                if not bucket then
                    bucket = { score = 0, weight = 0 }
                    summary.buckets[key] = bucket
                end
                bucket.score += event.direction * event.weight
                bucket.weight += event.weight
            end
        end
        return summary
    end

    function Controller:_LearningSnapshot(keys)
        local runtime = Library._ParryRuntime
        if not runtime then return nil end
        local engine = runtime:Engine()
        local policy = runtime.Policy[engine] or runtime.Policy.Adaptive
        local data = runtime:_modeData(engine)
        local snapshot = {}
        for _, key in ipairs(keys) do
            local record = data.animations[key]
            if typeof(record) ~= "table"
                or (tonumber(record.samples) or 0) < policy.minSamples then
                return nil
            end
            snapshot[key] = {
                lead = tonumber(record.lead) or 0,
                samples = tonumber(record.samples) or 0,
            }
        end
        return snapshot
    end

    function Controller:_LearningChanged(snapshot)
        if typeof(snapshot) ~= "table" then return true end
        local runtime = Library._ParryRuntime
        if not runtime then return true end
        local data = runtime:_modeData(runtime:Engine())
        for key, before in pairs(snapshot) do
            local current = data.animations[key]
            if typeof(current) ~= "table"
                or math.abs((tonumber(current.lead) or 0) - before.lead) > 0.000001 then
                return true, key
            end
        end
        return false
    end

    function Controller:_TuneOffset(summary, currentOffset)
        local runtime = Library._ParryRuntime
        if summary.explicit < 32 or not runtime
            or runtime.Block.activationSamples < 3 then
            return currentOffset, nil, nil
        end
        local engine = runtime:Engine()
        local policy = runtime.Policy[engine] or runtime.Policy.Adaptive
        local earlier, later, eligible = 0, 0, 0
        local eligibleOutcomes = 0
        local eligibleKeys = {}
        local eligibleStyles = {}
        for key, bucket in pairs(summary.buckets) do
            local outcomes = summary.byAnimation[key]
            local stableLearner = outcomes
                and IsFinite(outcomes.leadMinimum)
                and IsFinite(outcomes.leadMaximum)
                and outcomes.leadMaximum - outcomes.leadMinimum <= 0.000001
                and IsFinite(outcomes.sampleMinimum)
                and outcomes.sampleMinimum >= policy.minSamples
            if stableLearner and bucket.weight >= 1
                and math.abs(bucket.score) >= 0.75 then
                eligible += 1
                eligibleOutcomes += outcomes.total
                eligibleKeys[#eligibleKeys + 1] = key
                for style in pairs(outcomes.styles or {}) do
                    eligibleStyles[style] = true
                end
                if bucket.score < 0 then earlier += 1 else later += 1 end
            end
        end
        if eligible < 4 or eligibleOutcomes < 24
            or CountKeys(eligibleStyles) < 2 then
            return currentOffset, nil, nil
        end
        local dominant = math.max(earlier, later)
        if dominant / eligible < 0.75 then return currentOffset, nil, nil end
        local learningSnapshot = self:_LearningSnapshot(eligibleKeys)
        if not learningSnapshot then return currentOffset, nil, nil end
        local direction = earlier > later and -1 or 1
        local nextOffset = math.clamp(
            currentOffset + direction * 4,
            self.Baseline.timingOffset - 20,
            self.Baseline.timingOffset + 20
        )
        if nextOffset == currentOffset then return currentOffset, nil, nil end
        return nextOffset, direction < 0
            and "validated cross-animation correction: 4ms earlier"
            or "validated cross-animation correction: 4ms later",
            learningSnapshot
    end

    function Controller:_ValidateTrial(summary)
        local trial = self.Trial
        if not trial then return false end
        if not trial.startedAt then
            self.Confidence = "VALIDATING"
            self.Note = "Candidate is ready and waiting for an idle combat boundary."
            return true
        end
        local learningChanged, learningKey = self:_LearningChanged(trial.learningSnapshot)
        if learningChanged then
            local rollback = table.clone(trial.previous)
            rollback.reason = "per-animation learner changed; global trial cancelled"
            rollback.trial = nil
            rollback.rollback = true
            self.Trial = nil
            self.Confidence = "STABLE"
            self.Note = rollback.reason
                .. (learningKey and (" (" .. tostring(learningKey) .. ").") or ".")
            table.clear(self.Outcomes)
            self:_Queue(rollback)
            return true
        end
        local timedOut = os.clock() - trial.startedAt >= 300
        local beforeTotal, beforePerfect, beforeHit = 0, 0, 0
        local afterTotal, afterPerfect, afterHit = 0, 0, 0
        local overlappingAnimations = 0
        local beforeStyles, afterStyles = {}, {}
        for key in pairs(trial.learningSnapshot or {}) do
            local before = trial.byAnimation and trial.byAnimation[key]
            local after = summary.byAnimation[key]
            if before and before.total >= 2 and after and after.total >= 2 then
                overlappingAnimations += 1
                beforeTotal += before.total
                beforePerfect += before.perfect
                beforeHit += before.hit
                afterTotal += after.total
                afterPerfect += after.perfect
                afterHit += after.hit
                for style in pairs(before.styles or {}) do beforeStyles[style] = true end
                for style in pairs(after.styles or {}) do afterStyles[style] = true end
            end
        end
        local diverse = CountKeys(beforeStyles) >= 2
            and CountKeys(afterStyles) >= 2
            and overlappingAnimations >= 4
            and beforeTotal >= 24
            and afterTotal >= 24
        if not timedOut and not diverse then
            self.Confidence = "VALIDATING"
            self.Note = string.format(
                "Validating candidate: %d/24 matched outcomes, %d/4 animations.",
                afterTotal,
                overlappingAnimations
            )
            return true
        end

        local perfectRate = afterTotal > 0 and afterPerfect / afterTotal or 0
        local hitRate = afterTotal > 0 and afterHit / afterTotal or 1
        local baselinePerfectRate = beforeTotal > 0 and beforePerfect / beforeTotal
            or trial.perfectRate
        local baselineHitRate = beforeTotal > 0 and beforeHit / beforeTotal or trial.hitRate
        local perfectDelta = perfectRate - baselinePerfectRate
        local hitDelta = hitRate - baselineHitRate
        local worse = perfectDelta <= -0.05 or hitDelta >= 0.05
        local improved = not timedOut and not worse
            and (perfectDelta >= 0.05 or hitDelta <= -0.05)
        local enoughToReject = timedOut or worse or afterTotal >= 48
        if improved then
            self.Trial = nil
            self.Confidence = "HIGH"
            self.LastApplied.trial = nil
            self.LastApplied.validated = true
            self.LastApplied.reason = "candidate passed rolling validation"
            self.Note = string.format(
                "Candidate validated (Perfect %+.1f%%, Hit %+.1f%%).",
                perfectDelta * 100,
                hitDelta * 100
            )
            self:_PersistProfile(
                self.LastApplied,
                self.CurrentContext,
                self:_StatsSnapshot(false)
            )
            table.clear(self.Outcomes)
            return true
        end
        if enoughToReject then
            local rollback = table.clone(trial.previous)
            rollback.reason = timedOut
                and "candidate timed out; restored validated profile"
                or "candidate did not improve outcomes; restored validated profile"
            rollback.trial = nil
            rollback.rollback = true
            self.Trial = nil
            self.Confidence = "STABLE"
            self.Note = rollback.reason .. "."
            table.clear(self.Outcomes)
            self:_Queue(rollback)
            return true
        end
        self.Confidence = "VALIDATING"
        self.Note = "Candidate evidence is neutral; collecting up to 48 explicit outcomes."
        return true
    end

    function Controller:_Evaluate()
        local sampleCount = math.min(#self.NetworkSamples, #self.FrameSamples)
        if sampleCount < self.MinimumSamples then return end
        local now = os.clock()
        if now - self.LastEvaluationAt < 20 then return end
        self.LastEvaluationAt = now
        local stats = self:_StatsSnapshot(true)
        local network = stats.network
        local dataPing = stats.data
        local frame = stats.frame
        local frameSpike = stats.spike
        if not network or not frame then return end
        local unstable = (self.NetworkSource == "Network"
                and (network.mad > 25 or network.p90 - network.median > 80))
            or (dataPing and (dataPing.mad > 40
                or dataPing.p90 - dataPing.median > 120))
            or frame.p90 > 50
            or (frameSpike and frameSpike.p90 > 80)
        local summary = self:_OutcomeSummary()
        local trialTimedOut = self.Trial and self.Trial.startedAt
            and now - self.Trial.startedAt >= 300
        if trialTimedOut then
            self:_ValidateTrial(summary)
        elseif unstable then
            self.Confidence = "UNSTABLE"
            self.Note = "Connection/frame variance is high; keeping the safe profile."
        else
            if self.NeedsBaseline then
                self.NeedsBaseline = false
                self.Confidence = "STABLE"
                local baseline = self:_Profile(
                    self.CurrentContext,
                    "two-minute stable baseline"
                )
                baseline.saved = nil
                baseline.validated = true
                self.Note = "Two-minute baseline passed stability checks; applying the safe profile."
                self:_Queue(baseline)
                return
            end
            if self.PendingRecommendation then
                self.Note = "A validated profile is waiting for an idle combat boundary."
                return
            end
            if not self:_ValidateTrial(summary) then
                local current = self.LastApplied or self:_Profile(self.CurrentContext)
                local offset, reason, learningSnapshot =
                    self:_TuneOffset(summary, current.timingOffset)
                self.Confidence = summary.explicit >= 32 and "VALIDATING" or "STABLE"
                if reason then
                    self.Trial = {
                        previous = table.clone(current),
                        perfectRate = summary.explicit > 0
                            and summary.explicitPerfect / summary.explicit or 0,
                        hitRate = summary.explicit > 0
                            and summary.explicitHit / summary.explicit or 1,
                        byAnimation = summary.byAnimation,
                        learningSnapshot = learningSnapshot,
                        startedAt = nil,
                    }
                    self.Confidence = "VALIDATING"
                    self.Note = reason .. "; starting a rolling A/B check."
                    self:_Queue({
                        key = self.CurrentKey,
                        timingOffset = offset,
                        blockHold = self.Baseline.blockHold,
                        maxRange = self:_CurrentValues().maxRange,
                        reason = reason,
                        trial = true,
                        validated = false,
                    })
                    table.clear(self.Outcomes)
                else
                    local runtime = Library._ParryRuntime
                    local activation = runtime and runtime.Block.activationSamples or 0
                    self.Note = string.format(
                        "Global gate: %d/32 reliable | %d/2 styles | %d/4 animations | %d/3 activation.",
                        summary.explicit,
                        CountKeys(summary.explicitStyles),
                        CountKeys(summary.explicitAnimations),
                        activation
                    )
                end
            end
        end
        if now - self.LastPersistAt >= 120 and self.LastApplied
            and self.LastApplied.validated == true
            and self.LastApplied.provisional ~= true
            and not self.Trial and not self.PendingRecommendation then
            self:_PersistProfile(self.LastApplied, self.CurrentContext, stats)
        end
    end

    function Controller:_StatusText()
        local context = self.CurrentContext or self:_Context()
        local stats = self:_StatsSnapshot(false)
        local network = stats.network
        local dataPing = stats.data
        local frame = stats.frame
        local frameSpike = stats.spike
        local values = self:_CurrentValues()
        local sampleCount = math.min(#self.NetworkSamples, #self.FrameSamples)
        local phase = sampleCount < self.MinimumSamples
            and string.format("%d/%d samples", sampleCount, self.MinimumSamples)
            or string.format("%d combat outcomes", #self.Outcomes)
        local networkText = network and string.format("%.0fms (p90 %.0f)", network.median, network.p90)
            or "waiting"
        local networkLabel = self.NetworkSource == "Data"
            and "Data fallback" or "Network"
        local dataText = dataPing and string.format("%.0fms", dataPing.median) or "unavailable"
        local fps = frame and frame.median > 0 and (1000 / frame.median) or nil
        local height = context.height and string.format("%.3f", context.height) or "unknown"
        return string.format(
            "%s - %s\n%s %s | Data %s | FPS %s | Spike %s\n%s | Height %s | %s/%s\nApplied %dms | Hold %dms | Range %d\n%s",
            self.Confidence,
            phase,
            networkLabel,
            networkText,
            dataText,
            fps and string.format("%.0f", fps) or "waiting",
            frameSpike and string.format("%.0fms", frameSpike.p90) or "waiting",
            context.style,
            height,
            context.engine,
            context.transport,
            values.timingOffset,
            values.blockHold,
            values.maxRange,
            self.Note
        )
    end

    function Controller:_UpdateStatus(force)
        local now = os.clock()
        if not force and now - self.LastStatusAt < 5 then return end
        self.LastStatusAt = now
        local label = Library._AutoConfigStatusLabel
        if label and typeof(label.SetText) == "function" then
            local text = self:_StatusText()
            if force or text ~= self.LastStatusText then
                self.LastStatusText = text
                label:SetText(text)
            end
        end
    end

    function Controller:_Sample()
        local context = self:_Context()
        if not self:_SwitchContext(context) then
            self:_UpdateStatus(false)
            return
        end
        if self.ValuesDirty then
            self.ValuesDirty = false
            if self.NeedsBaseline then
                local current = self:_CurrentValues()
                self.LastApplied = {
                    key = self.CurrentKey,
                    timingOffset = current.timingOffset,
                    blockHold = current.blockHold,
                    maxRange = current.maxRange,
                    reason = "user values during baseline scan",
                    provisional = true,
                    validated = false,
                }
                self:_ResetMeasurements(
                    "Timing changed during the provisional scan; restarted the two-minute baseline."
                )
            else
                local recommendation = self.LastApplied or self:_Profile(context)
                recommendation = table.clone(recommendation)
                recommendation.key = self.CurrentKey
                recommendation.maxRange = self:_CurrentValues().maxRange
                recommendation.reason = "restored Auto Config after config change"
                self:_Queue(recommendation)
            end
        end
        local dataPing = self:_ReadDataPingMs()
        if dataPing then Push(self.DataSamples, dataPing, self.MaximumSamples) end
        local network = self:_ReadNetworkPingMs()
        local now = os.clock()
        if network then
            self.RawPingLastAt = now
            if self.NetworkSource == "Network" then
                Push(self.NetworkSamples, network, self.MaximumSamples)
            else
                self.RawPingCandidateCount += 1
                if self.RawPingCandidateCount >= 5 then
                    self.RawPingCandidateCount = 0
                    self:_SetNetworkSource(
                        "Network",
                        "Raw network ping is stable; restarted latency samples with the preferred source."
                    )
                    Push(self.NetworkSamples, network, self.MaximumSamples)
                elseif dataPing then
                    self:_SetNetworkSource("Data")
                    Push(self.NetworkSamples, dataPing, self.MaximumSamples)
                end
            end
        else
            self.RawPingCandidateCount = 0
            if self.NetworkSource == "Network" and dataPing
                and now - self.RawPingLastAt >= 10 then
                self:_SetNetworkSource(
                    "Data",
                    "Raw network ping became unavailable; restarted with Data Ping fallback."
                )
            elseif self.NetworkSource == nil and dataPing then
                self:_SetNetworkSource("Data")
            end
            if self.NetworkSource == "Data" and dataPing then
                Push(self.NetworkSamples, dataPing, self.MaximumSamples)
            end
        end
        local frame, frameSpike = self:_ReadFrameSampleMs()
        if frame then Push(self.FrameSamples, frame, self.MaximumSamples) end
        if frameSpike then Push(self.FrameSpikeSamples, frameSpike, self.MaximumSamples) end
        self:_ApplyPending()
        self:_Evaluate()
        self:_UpdateStatus(false)
    end

    function Controller:_Run(generation)
        task.spawn(function()
            local nextSampleAt = os.clock()
            while Controller.Alive and Controller.Running
                and Controller.Generation == generation do
                Controller.SampleWakeOvershootMs = math.max(
                    0,
                    (os.clock() - nextSampleAt) * 1000
                )
                local ok, message = pcall(function() Controller:_Sample() end)
                if not ok then
                    Controller.Confidence = "ERROR"
                    Controller.Note = tostring(message)
                    Controller:_UpdateStatus(true)
                end
                nextSampleAt += Controller.SampleInterval
                local remaining = nextSampleAt - os.clock()
                if remaining > 0 then
                    task.wait(remaining)
                else
                    nextSampleAt = os.clock()
                    task.wait()
                end
            end
        end)
    end

    function Controller:SetEnabled(enabled)
        enabled = enabled == true
        if not self.Ready then
            self.Running = enabled
            return
        end
        if self.Running == enabled then
            self:_UpdateStatus(true)
            return
        end
        self.Generation += 1
        self.Running = enabled
        if not enabled then
            self.Confidence = "PAUSED"
            self.Note = "Auto Config is off; current values are unchanged."
            self:_UpdateStatus(true)
            return
        end
        self.Previous = self:_CurrentValues()
        Config.autoConfig.previous = table.clone(self.Previous)
        markConfigDirty()
        self.CurrentContext = nil
        self.CurrentKey = nil
        self:_ResetMeasurements()
        self:_SwitchContext(self:_Context())
        self:_Run(self.Generation)
        self:_UpdateStatus(true)
    end

    function Controller:ResetScan()
        if not self.Ready then return end
        if not self.Running then
            if Toggles.AutoConfigEnabled then Toggles.AutoConfigEnabled:SetValue(true) end
            return
        end
        self.Generation += 1
        if self.Trial then
            local rollback = table.clone(self.Trial.previous)
            rollback.reason = "fresh scan restored the last validated profile"
            rollback.trial = nil
            rollback.rollback = true
            self.Trial = nil
            self:_Queue(rollback)
        end
        self:_ResetMeasurements("Fresh two-minute scan started.")
        self:_Run(self.Generation)
        self:_UpdateStatus(true)
    end

    function Controller:OnTimingValueChanged()
        if self.Ready and self.Running and not self.Applying then
            self.ValuesDirty = true
            self.Note = self.NeedsBaseline
                and "Timing changed; the provisional baseline will restart."
                or "A timing value changed; restoring the active automatic profile."
        end
    end

    function Controller:Revert()
        local previous = self.Previous
        if typeof(previous) ~= "table" then previous = Config.autoConfig.previous end
        if not self:_ValidValues(previous) then
            self.Note = "No valid previous values are available."
            self:_UpdateStatus(true)
            return false
        end
        if Toggles.AutoConfigEnabled and Toggles.AutoConfigEnabled.Value then
            Toggles.AutoConfigEnabled:SetValue(false)
        end
        self:_SetValues(previous)
        self.PendingRecommendation = nil
        self.LastApplied = nil
        self.Trial = nil
        self.Note = "Reverted to the values from before Auto Config started."
        self:_UpdateStatus(true)
        pcall(function()
            Library:Notify({
                Title = "Auto Config",
                Description = "Previous timing values restored. Auto Config is now off.",
                Time = 4,
            })
        end)
        return true
    end

    function Controller:Activate()
        if self.Ready or not self.Alive then return end
        local enabled = Toggles.AutoConfigEnabled == nil
            or Toggles.AutoConfigEnabled.Value == true
        self.Ready = true
        self.Running = not enabled
        self:SetEnabled(enabled)
    end

    function Controller:Destroy()
        if not self.Alive then return end
        self.Alive = false
        self.Ready = false
        self.Running = false
        self.Generation += 1
        self.PendingRecommendation = nil
        self.Trial = nil
    end

    return Controller
end)()

