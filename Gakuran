-- =========================================================================
--  การโอนเงินผ่าน Blink API (เกมใหม่ใช้ Blink แทน UI clicking)
-- =========================================================================
local _yenBlink = nil
local _yenResultHandlers = {}

local function _getYenBlink()
    if _yenBlink then return _yenBlink end
    -- Reuse Jobs/Demae blink if already loaded
    if getgenv()._SKT_BlinkMod then _yenBlink = getgenv()._SKT_BlinkMod; return _yenBlink end
    local rs = game:GetService("ReplicatedStorage")
    local ok, mod = pcall(function()
        return rs:FindFirstChild("Shared")
            and rs.Shared:FindFirstChild("Network")
            and rs.Shared.Network:FindFirstChild("Client")
    end)
    if ok and typeof(mod) == "Instance" and mod:IsA("ModuleScript") then
        local ok2, result = pcall(require, mod)
        if ok2 and type(result) == "table" then
            _yenBlink = result
            getgenv()._SKT_BlinkMod = result
            return result
        end
    end
    return nil
end

-- NOTE: Blink's .On() stores ONE listener slot per event (last registration
-- wins). The game re-registers its own handler whenever the phone is used, so
-- we must re-subscribe at the start of every transfer to guarantee we hold
-- the slot when the result arrives.
local function _ensureYenResultHandlers(force)
    local blink = _getYenBlink()
    if not blink then return end
    if not force and next(_yenResultHandlers) then return end
    -- Listen for search results
    if blink.YenAppSearchTagResult and blink.YenAppSearchTagResult.On then
        _yenResultHandlers.search = blink.YenAppSearchTagResult.On(function(data)
            _yenResultHandlers._lastSearch = data
        end)
    end
    -- Listen for send results
    if blink.YenAppSendYenResult and blink.YenAppSendYenResult.On then
        _yenResultHandlers.send = blink.YenAppSendYenResult.On(function(data)
            _yenResultHandlers._lastSend = data
        end)
    end
end

-- =========================================================================
--  Secure request tokens: the live game signs YenApp (and other) packets with
--  {Token, Check, Nonce} produced by a client-side secure-store object that
--  exposes obj:NextForKey("Phone.YenAppSendYen") -> token, check, nonce.
--  We locate the live instance in the GC and reuse it — no phone UI needed.
-- =========================================================================
local _yenSecureInst = nil
local _yenSecureScanAt = 0
local function _getYenSecure()
    if _yenSecureInst then return _yenSecureInst end
    if os.clock() - _yenSecureScanAt < 15 then return nil end
    _yenSecureScanAt = os.clock()
    if typeof(getgc) ~= "function" then return nil end
    -- Use the shared GC cache instead of a private getgc() scan -- a direct
    -- scan allocates a multi-million-entry table and hitches ~100ms+.
    Library._Performance:RefreshGCFor("yen")
    local gc = Library._Performance:GetGC()
    if type(gc) ~= "table" or #gc == 0 then return nil end
    local class = nil
    for _, v in ipairs(gc) do
        if type(v) == "table" then
            local okF, fn = pcall(rawget, v, "NextForKey")
            if okF and type(fn) == "function" and rawget(v, "_refreshFromAttributes") ~= nil then
                class = v
                break
            end
        end
    end
    if not class then return nil end
    for _, v in ipairs(gc) do
        if type(v) == "table" then
            local mt = getmetatable(v)
            if mt and mt.__index == class and rawget(v, "_seed") ~= nil then
                _yenSecureInst = v
                return v
            end
        end
    end
    return nil
end

local function _yenSecureFields(key)
    local inst = _getYenSecure()
    if not inst then return nil end
    local ok, token, check, nonce = pcall(function()
        return inst:NextForKey(key)
    end)
    if ok and token ~= nil then
        return token, check, nonce
    end
    return nil
end

local function _doYenTransferUI(tag, amount)
    if _yenTransferRunning then return false, "Transfer already running" end
    _yenTransferRunning = true

    local lbl = getgenv().YenTransferStatusLabel
    local function status(msg)
        if lbl then pcall(function() lbl:SetText(msg) end) end
    end

    task.spawn(function()
        local blink = _getYenBlink()
        -- Direct (no phone UI) path requires Blink + the live secure-token store.
        local directOk = blink ~= nil and _getYenSecure() ~= nil
        if not directOk then
            -- Fallback: try old UI flow if Blink not available
            status("Blink not found — trying UI flow...")
            _ensurePhoneOpenAndHeld()
            task.wait(0.2)
            local inYenApp = _openYenApp()
            if not inYenApp then
                for i = 1, 10 do
                    _ensurePhoneOpenAndHeld()
                    task.wait(0.2)
                    if _openYenApp() then inYenApp = true break end
                end
            end
            if not inYenApp then
                status("Error: Blink ไม่พบ และเข้า YenApp ไม่ได้")
                _yenTransferRunning = false
                return
            end
            task.wait(0.25)
            status("ค้นหา @" .. tag .. "...")
            _ensurePhoneOpenAndHeld()
            local searched = _searchYenTag(tag)
            if not searched then
                status("Error: ไม่พบช่องค้นหา")
                _yenTransferRunning = false
                return
            end
            local payClicked = false
            for i = 1, 30 do
                _ensurePhoneOpenAndHeld()
                task.wait(0.15)
                if _clickProfilePay() then payClicked = true break end
            end
            if not payClicked then
                status("Error: ไม่พบผู้เล่น @" .. tag)
                _yenTransferRunning = false
                return
            end
            task.wait(0.35)
            status("กรอกจำนวน " .. amount .. "...")
            _ensurePhoneOpenAndHeld()
            local amountSet = false
            for i = 1, 20 do
                _ensurePhoneOpenAndHeld()
                if _enterYenAmount(amount) then amountSet = true break end
                task.wait(0.1)
            end
            if not amountSet then
                status("Error: ไม่พบช่องกรอกจำนวน")
                _yenTransferRunning = false
                return
            end
            task.wait(0.25)
            status("กำลังยืนยันการโอนเงิน...")
            _ensurePhoneOpenAndHeld()
            local confirmed = false
            for i = 1, 15 do
                _ensurePhoneOpenAndHeld()
                if _clickConfirmPay() then confirmed = true break end
                task.wait(0.1)
            end
            if not confirmed then
                status("Error: ไม่พบปุ่ม Confirm")
                _yenTransferRunning = false
                return
            end
            task.wait(0.4)
            status("โอนสำเร็จ " .. amount .. " ¥ ให้ @" .. tag)
            pcall(function()
                Library:Notify({ Title = "Yen Transfer", Message = "Sent " .. amount .. " yen to @" .. tag, Duration = 3 })
            end)
            _yenTransferRunning = false
            return
        end

        -- Blink API flow (new game) — re-register the single listener slot so
        -- the game's own handler can't beat us to the result.
        _ensureYenResultHandlers(true)

        -- Step 1: Search for tag
        status("ค้นหา @" .. tag .. "...")
        _yenResultHandlers._lastSearch = nil
        if blink.YenAppSearchTag and blink.YenAppSearchTag.Fire then
            local sTok, sCheck, sNonce = _yenSecureFields("Phone.YenAppSearchTag")
            if sTok == nil then
                status("Error: secure token unavailable")
                _yenTransferRunning = false
                return
            end
            pcall(blink.YenAppSearchTag.Fire, { Tag = tag, Token = sTok, Check = sCheck, Nonce = sNonce })
        else
            status("Error: YenAppSearchTag not available")
            _yenTransferRunning = false
            return
        end

        -- Wait for search result
        local searchResult = nil
        for i = 1, 30 do
            task.wait(0.1)
            if _yenResultHandlers._lastSearch then
                searchResult = _yenResultHandlers._lastSearch
                _yenResultHandlers._lastSearch = nil
                break
            end
        end
        if not searchResult then
            status("Error: ไม่ได้รับผลค้นหาจาก server")
            _yenTransferRunning = false
            return
        end
        if not searchResult.Success then
            status("Error: ไม่พบ tag @" .. tag .. " (" .. tostring(searchResult.Reason or "unknown") .. ")")
            _yenTransferRunning = false
            return
        end

        -- Step 2: Send yen
        status("กำลังโอน " .. amount .. " ¥ ให้ @" .. tag .. "...")
        _yenResultHandlers._lastSend = nil
        if blink.YenAppSendYen and blink.YenAppSendYen.Fire then
            local sTok, sCheck, sNonce = _yenSecureFields("Phone.YenAppSendYen")
            if sTok == nil then
                status("Error: secure token unavailable")
                _yenTransferRunning = false
                return
            end
            pcall(blink.YenAppSendYen.Fire, { TargetTag = tag, Amount = amount, Token = sTok, Check = sCheck, Nonce = sNonce })
        else
            status("Error: YenAppSendYen not available")
            _yenTransferRunning = false
            return
        end

        -- Wait for send result
        local sendResult = nil
        for i = 1, 30 do
            task.wait(0.1)
            if _yenResultHandlers._lastSend then
                sendResult = _yenResultHandlers._lastSend
                _yenResultHandlers._lastSend = nil
                break
            end
        end
        if not sendResult then
            status("Error: ไม่ได้รับผลการโอนจาก server")
            _yenTransferRunning = false
            return
        end
        if sendResult.Success then
            status("โอนสำเร็จ " .. amount .. " ¥ ให้ @" .. tag)
            pcall(function()
                Library:Notify({ Title = "Yen Transfer", Message = "Sent " .. amount .. " yen to @" .. tag, Duration = 3 })
            end)
        else
            status("Error: โอนไม่สำเร็จ (" .. tostring(sendResult.Reason or "unknown") .. ")")
        end
        _yenTransferRunning = false
    end)
    return true
end

