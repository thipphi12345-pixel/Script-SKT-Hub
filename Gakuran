-- Emote / game movement-lock detection (do-block keeps chunk locals under the
-- 200-local cap). While the game locks movement for an emote (controls
-- disabled, an emote attribute, or an emote animation track), SKT movement
-- overrides must yield so they do not break the game's lock.
do
    local _sktEmoteAnimIds = nil
    local _sktEmoteAnimCount = 0
    local _sktPlayerControls = nil
    local _sktEmoteCheckAt = 0
    local _sktEmoteCheckResult = false

    local function _sktCollectEmoteAnimIds()
        if _sktEmoteAnimIds and _sktEmoteAnimCount > 0 then return _sktEmoteAnimIds end
        _sktEmoteAnimIds = {}
        _sktEmoteAnimCount = 0
        pcall(function()
            local pg = LocalPlayer:FindFirstChild("PlayerGui")
            local wheel = pg and pg:FindFirstChild("EmoteWheel")
            local container = wheel and wheel:FindFirstChild("Container")
            if not container then return end
            for _, slot in ipairs(container:GetChildren()) do
                local preview = slot:FindFirstChild("EmotePreview")
                local model = preview and preview:FindFirstChildWhichIsA("Model", true)
                local humanoid = model and model:FindFirstChildOfClass("Humanoid")
                local animator = humanoid and humanoid:FindFirstChildOfClass("Animator")
                if animator then
                    for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
                        local anim = track.Animation
                        if anim and anim.AnimationId and not _sktEmoteAnimIds[anim.AnimationId] then
                            _sktEmoteAnimIds[anim.AnimationId] = true
                            _sktEmoteAnimCount += 1
                        end
                    end
                end
            end
        end)
        return _sktEmoteAnimIds
    end

    local function _sktControlsDisabledByGame()
        local ok, res = pcall(function()
            if not _sktPlayerControls then
                local ps = LocalPlayer:FindFirstChild("PlayerScripts")
                local pm = ps and ps:FindFirstChild("PlayerModule")
                if not pm then return false end
                local mod = require(pm)
                _sktPlayerControls = mod and mod:GetControls()
            end
            return _sktPlayerControls ~= nil and _sktPlayerControls.controlsEnabled == false
        end)
        return ok and res == true
    end

    local function _sktEmotingNow(char)
        if _sktControlsDisabledByGame() then return true end
        if not char then return false end
        for key, value in pairs(char:GetAttributes()) do
            local name = key:lower()
            if value and (name:find("emote") or name:find("dance")) then return true end
        end
        local hum = char:FindFirstChildOfClass("Humanoid")
        local animator = hum and hum:FindFirstChildOfClass("Animator")
        if animator then
            local ids = _sktCollectEmoteAnimIds()
            for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
                local anim = track.Animation
                if anim and anim.AnimationId and ids[anim.AnimationId] then return true end
                if tostring(track.Name):lower():find("emote") then return true end
            end
        end
        return false
    end

    function _sktIsEmoting(char)
        -- Throttled: called from per-frame loops.
        local now = os.clock()
        if now - _sktEmoteCheckAt < 0.15 then return _sktEmoteCheckResult end
        _sktEmoteCheckAt = now
        _sktEmoteCheckResult = _sktEmotingNow(char or LocalPlayer.Character)
        return _sktEmoteCheckResult
    end
end

