    function Performance:Track(connection)
        if connection then table.insert(self.Connections, connection) end
        -- Long sessions accumulate dead connections (feature toggles, respawns);
        -- prune disconnected entries so the table can't grow forever.
        if #self.Connections >= 200 then
            for index = #self.Connections, 1, -1 do
                local entry = self.Connections[index]
                local ok, connected = pcall(function() return entry.Connected end)
                if ok and connected == false then
                    table.remove(self.Connections, index)
                end
            end
        end
        return connection
    end

    function Performance:ScanGC(force)
        if not self.Alive then return {} end
        local now = os.clock()
        if type(self.GCObjects) == "table" and #self.GCObjects > 0 and now < self.GCExpiresAt then
            return self.GCObjects
        end
        if not force then return {} end

        -- Hard floor: a full getgc() heap scan allocates a multi-million-entry
        -- table and costs ~100+ms (visible hitch). Never allow more than one
        -- real scan per 30s no matter which feature asks.
        if now < (self.GCNextScanAt or 0) then
            return self.GCObjects or {}
        end
        self.GCNextScanAt = now + 30

        local gc = getgc or (getgenv and getgenv().getgc)
        if typeof(gc) ~= "function" then return {} end
        local objects
        pcall(function() objects = gc(true) end)
        if type(objects) ~= "table" or #objects == 0 then
            pcall(function() objects = gc(false) end)
        end
        if type(objects) == "table" and #objects > 0 then
            self.GCObjects = objects
            self.GCScanCount += 1
            self.GCGeneration += 1
            self.GCExpiresAt = now + 3
            local generation = self.GCGeneration
            task.delay(3.1, function()
                if self.Alive and self.GCGeneration == generation and os.clock() >= self.GCExpiresAt then
                    table.clear(self.GCObjects)
                end
            end)
        end
        return self.GCObjects
    end

    function Performance:GetGC()
        return self:ScanGC(false)
    end

    function Performance:RefreshGCFor(feature)
        feature = tostring(feature or "unknown")
        local now = os.clock()
        local last = tonumber(self.FeatureGCRefresh[feature]) or 0
        if now - last < 10 and #self.GCObjects > 0 and now < self.GCExpiresAt then
            return self.GCObjects
        end
        self.FeatureGCRefresh[feature] = now
        return self:ScanGC(true)
    end

    function Performance:GetPing()
        local now = os.clock()
        if now - self.PingUpdatedAt >= 0.10 then
            local ok, value = pcall(LocalPlayer.GetNetworkPing, LocalPlayer)
            if ok and typeof(value) == "number" then self.PingValue = value end
            self.PingUpdatedAt = now
        end
        return self.PingValue
    end

    function Performance:Destroy()
        if not self.Alive then return end
        self.Alive = false
        for _, connection in ipairs(self.Connections) do
            pcall(function() connection:Disconnect() end)
        end
        table.clear(self.Connections)
        for _, name in ipairs({ "NotifyWake", "ESPWake", "M2Wake" }) do
            local event = self[name]
            if event then
                pcall(function() event:Fire() end)
                pcall(function() event:Destroy() end)
                self[name] = nil
            end
        end
        table.clear(self.GCObjects)
    end

    return Performance
end)()

