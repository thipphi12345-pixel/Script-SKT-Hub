local _forceChatConn = nil
PlayerGroup:AddToggle("ForceShowChat", {
    Text = "Force Show Chat",
    Default = false,
    Tooltip = "บังคับเปิดแชทในแมพที่ปิดไว้ (เช่น Greenzone, ห้องบางห้อง)",
    Callback = function(val)
        if val then
            local StarterGui = game:GetService("StarterGui")
            local TextChatService = game:GetService("TextChatService")
            pcall(function()
                StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Chat, true)
                if TextChatService.ChatWindowConfiguration then
                    TextChatService.ChatWindowConfiguration.Enabled = true
                end
                if TextChatService.ChatInputBarConfiguration then
                    TextChatService.ChatInputBarConfiguration.Enabled = true
                end
            end)
            if _forceChatConn then _forceChatConn:Disconnect() end
            local _chatElapsed = 0
            _forceChatConn = game:GetService("RunService").Heartbeat:Connect(function(dt)
                if getgenv()._SKT_Unloaded then
                    _forceChatConn:Disconnect()
                    _forceChatConn = nil
                    return
                end
                _chatElapsed += dt
                if _chatElapsed < 0.5 then return end
                _chatElapsed = 0
                pcall(function()
                    if not StarterGui:GetCoreGuiEnabled(Enum.CoreGuiType.Chat) then
                        StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Chat, true)
                    end
                    if TextChatService.ChatWindowConfiguration
                        and not TextChatService.ChatWindowConfiguration.Enabled then
                        TextChatService.ChatWindowConfiguration.Enabled = true
                    end
                    if TextChatService.ChatInputBarConfiguration
                        and not TextChatService.ChatInputBarConfiguration.Enabled then
                        TextChatService.ChatInputBarConfiguration.Enabled = true
                    end
                end)
            end)
        else
            if _forceChatConn then
                _forceChatConn:Disconnect()
                _forceChatConn = nil
            end
        end
    end,
})

