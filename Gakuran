            if mem > 5000 then memColor = "E74C3C"
            elseif mem > 2000 then memColor = "F39C12" end
            memVal.Text = string.format('<font color="#FFFFFF">%d KB</font>', mem)

            local elapsed = math.floor(now - _dashStartTime)
            local mins = math.floor(elapsed / 60)
            local secs = elapsed % 60
            local hours = math.floor(mins / 60)
            mins = mins % 60
            local uptimeStr
            if hours > 0 then
                uptimeStr = string.format("%dh %dm %ds", hours, mins, secs)
            elseif mins > 0 then
                uptimeStr = string.format("%dm %ds", mins, secs)
            else
                uptimeStr = string.format("%ds", secs)
            end
            uptimeVal.Text = string.format('<font color="#FFFFFF">%s</font>', uptimeStr)
        end
    end)
