Library._FunUtilityController = (function()
    local Controller = {
        Alive = true,
        HairEnabled = false,
        HairColor = "White",
        HairOriginals = setmetatable({}, { __mode = "k" }),
        HairConnection = nil,
        CharacterConnection = nil,
        FlingEnabled = false,
        FlingThread = nil,
        FlingMove = 0.1,
        PreviousNoClip = nil,
    }
    local HAIR_COLORS = {
        White = Color3.fromRGB(255, 255, 255),
        Black = Color3.fromRGB(20, 20, 20),
        Gray = Color3.fromRGB(128, 128, 128),
        ["Dark Brown"] = Color3.fromRGB(60, 35, 20),
        Brown = Color3.fromRGB(110, 70, 45),
        ["Light Brown"] = Color3.fromRGB(160, 110, 75),
        Blonde = Color3.fromRGB(235, 205, 140),
        Red = Color3.fromRGB(175, 45, 35),
        Orange = Color3.fromRGB(220, 115, 45),
        Yellow = Color3.fromRGB(245, 220, 70),
        Green = Color3.fromRGB(65, 170, 90),
        Blue = Color3.fromRGB(65, 115, 220),
        Purple = Color3.fromRGB(135, 75, 190),
        Pink = Color3.fromRGB(235, 120, 175),
    }
    local HAIR_COLOR_NAMES = {
        "White", "Black", "Gray", "Dark Brown", "Brown", "Light Brown", "Blonde",
        "Red", "Orange", "Yellow", "Green", "Blue", "Purple", "Pink",
    }

    function Controller:Remember(instance, property)
        local properties = self.HairOriginals[instance]
        if not properties then
            properties = {}
            self.HairOriginals[instance] = properties
        end
        if properties[property] == nil then properties[property] = instance[property] end
    end

    function Controller:ApplyHair()
        if not self.HairEnabled then return end
        local character = LocalPlayer.Character
        local color = HAIR_COLORS[self.HairColor]
        if not character or not color then return end

        for _, texture in ipairs(character:GetDescendants()) do
            if texture.Name == "HairColorTexture"
                and (texture:IsA("Texture") or texture:IsA("Decal")) then
                self:Remember(texture, "Color3")
                texture.Color3 = color
                local accessory = texture:FindFirstAncestorWhichIsA("Accessory") or texture.Parent
                if accessory then
                    for _, descendant in ipairs(accessory:GetDescendants()) do
                        if descendant:IsA("BasePart") then
                            self:Remember(descendant, "Color")
                            descendant.Color = color
                        elseif descendant:IsA("SpecialMesh") then
                            self:Remember(descendant, "VertexColor")
                            descendant.VertexColor = Vector3.new(color.R, color.G, color.B)
                        elseif descendant.Name == "HairColorTexture"
                            and (descendant:IsA("Texture") or descendant:IsA("Decal")) then
                            self:Remember(descendant, "Color3")
                            descendant.Color3 = color
                        end end end end end
    end

    function Controller:RestoreHair()
        for instance, properties in pairs(self.HairOriginals) do
            if instance.Parent then
                for property, value in pairs(properties) do
                    pcall(function() instance[property] = value end)
                end
            end
        end
        self.HairOriginals = setmetatable({}, { __mode = "k" })
    end

    function Controller:BindHair(character)
        if self.HairConnection then
            self.HairConnection:Disconnect()
            self.HairConnection = nil
        end
        self.HairOriginals = setmetatable({}, { __mode = "k" })
        if not character then return end
        self.HairConnection = character.DescendantAdded:Connect(function(descendant)
            if self.HairEnabled and descendant.Name == "HairColorTexture" then
                task.defer(function()
                    if self.Alive and self.HairEnabled then self:ApplyHair() end
                end)
            end
        end)
        task.defer(function()
            if self.Alive then self:ApplyHair() end
        end)
    end

    function Controller:GetRoot()
        local character = LocalPlayer.Character
        return character and character:FindFirstChild("HumanoidRootPart")
    end

    function Controller:StopFlingVelocity()
        local root = self:GetRoot()
        if root then
            local velocity = root.AssemblyLinearVelocity
            root.AssemblyLinearVelocity = Vector3.new(velocity.X, 0, velocity.Z)
            root.AssemblyAngularVelocity = Vector3.zero
        end
    end

    function Controller:StartFling()
        if self.FlingThread then return end
        self.FlingThread = task.spawn(function()
            while self.Alive and self.FlingEnabled do
                local root = self:GetRoot()
                if root then
                    local velocity = root.AssemblyLinearVelocity
                    root.AssemblyLinearVelocity = velocity * 10000 + Vector3.new(0, 10000, 0)
                    RunService.RenderStepped:Wait()
                    if not self.FlingEnabled then break end
                    if root.Parent then root.AssemblyLinearVelocity = velocity end
                    RunService.Stepped:Wait()
                    if not self.FlingEnabled then break end
                    if root.Parent then
                        root.AssemblyLinearVelocity = velocity + Vector3.new(0, self.FlingMove, 0)
                        self.FlingMove = -self.FlingMove
                    end
                end
                RunService.Heartbeat:Wait()
            end
            self.FlingThread = nil
            self:StopFlingVelocity()
        end)
    end

    function Controller:SetFling(enabled)
        self.FlingEnabled = enabled == true
        if self.FlingEnabled then
            self.PreviousNoClip = Toggles.NoClipEnabled and Toggles.NoClipEnabled.Value == true
            if Toggles.NoClipEnabled and not self.PreviousNoClip then
                pcall(Toggles.NoClipEnabled.SetValue, Toggles.NoClipEnabled, true)
            end
            Library:Notify({
                Title = "Fling",
                Description = "Dangerous: physics abuse can reset, kick, or flag your character.",
                Time = 5,
            })
            self:StartFling()
        else
            self:StopFlingVelocity()
            if self.PreviousNoClip == false and Toggles.NoClipEnabled then
                pcall(Toggles.NoClipEnabled.SetValue, Toggles.NoClipEnabled, false)
            end
            self.PreviousNoClip = nil
        end
    end

    function Controller:BuildUI(tab, colorHairTab)
        local hairGroup = colorHairTab:AddLeftGroupbox("Hair Settings")
        hairGroup:AddToggle("ChangeHairColor", {
            Text = "Change Hair Color",
            Default = false,
            Callback = function(enabled)
                Controller.HairEnabled = enabled
                if enabled then Controller:ApplyHair() else Controller:RestoreHair() end
            end,
        })
        hairGroup:AddDropdown("SelectedHairColor", {
            Text = "Hair Color",
            Values = HAIR_COLOR_NAMES,
            Default = "White",
            Tooltip = "Change your hair color locally.",
            Callback = function(value)
                Controller.HairColor = value
                Controller:ApplyHair()
            end,
        })
        
        local group = tab:AddRightGroupbox("Fun Utilities")
        group:AddToggle("FlingAura", {
            Text = "Fling",
            Default = false,
            Tooltip = "Risk: may reset, kick, or flag you.",
            Callback = function(enabled) Controller:SetFling(enabled) end,
        })
    end

    function Controller:Destroy()
        self.Alive = false
        self:SetFling(false)
        self:RestoreHair()
        if self.HairConnection then self.HairConnection:Disconnect() end
        if self.CharacterConnection then self.CharacterConnection:Disconnect() end
        self.HairConnection = nil
        self.CharacterConnection = nil
    end

    Controller.CharacterConnection = LocalPlayer.CharacterAdded:Connect(function(character)
        Controller:BindHair(character)
    end)
    Controller:BindHair(LocalPlayer.Character)
    return Controller
end)()

