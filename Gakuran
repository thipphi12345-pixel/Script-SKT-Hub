    gui.Name = "GakuranHUD"
    gui.ResetOnSpawn = false
    gui.IgnoreGuiInset = true
    gui.DisplayOrder = 9999
    pcall(function() gui.Parent = (typeof(gethui) == "function" and gethui()) or game:GetService("CoreGui") end)
    
    local function MakeThinBar(yOffset, fillColor, titleText)
        local container = Instance.new("Frame")
        container.BackgroundTransparency = 1
        container.Position = UDim2.new(0.5, -150, 1, yOffset)
        container.Size = UDim2.new(0, 300, 0, 24)
