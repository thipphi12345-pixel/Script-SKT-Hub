    function Int3UI.FinishTweens()
        for object, properties in pairs(TweenGoals) do
            local animation = ActiveTweens[object]
            if animation then animation:Cancel() end
            if object.Parent then
                for property, value in pairs(properties) do object[property] = value end
            end
        end
        table.clear(ActiveTweens)
        table.clear(TweenGoals)
    end
    function Int3UI.SetReducedMotion(reduced)
        MotionEnabled = reduced ~= true
        if not MotionEnabled then Int3UI.FinishTweens() end
        local window = (getgenv and getgenv() or _G)[ACTIVE_WINDOW_KEY]
        for object, animation in pairs(AmbientTweens) do
            if object.Parent then
                if MotionEnabled and window and window.Visible then animation:Play() else animation:Pause() end
            else
                animation:Cancel()
                AmbientTweens[object] = nil
            end
        end
    end
