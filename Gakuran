--// ============================ No Blur / Attr Strip / No Parry CD / Anti-AFK / Server Hop / Auto Sprint / No Dodge CD ============================
-- Wrapped in a do-block to scope locals and stay under Luau's 200-local limit.
do
local _noBlurActive = false
local _noBlurConnections = {}
local _noBlurEffectConnections = setmetatable({}, { __mode = "k" })
local _noBlurCamera
local _noBlurCameraConnection

local function DisconnectNoBlurConnections()
    for effect, connection in pairs(_noBlurEffectConnections) do
        if connection then pcall(function() connection:Disconnect() end) end
        _noBlurEffectConnections[effect] = nil
    end
    for index = #_noBlurConnections, 1, -1 do
        local connection = _noBlurConnections[index]
        _noBlurConnections[index] = nil
        if connection then pcall(function() connection:Disconnect() end) end
    end
    if _noBlurCameraConnection then
        _noBlurCameraConnection:Disconnect()
        _noBlurCameraConnection = nil
    end
    _noBlurCamera = nil
end

local function IsBlurEffect(instance)
    return instance:IsA("BlurEffect") or instance:IsA("ColorCorrectionEffect")
end

local function SuppressBlurEffect(effect)
    if not _noBlurActive or not IsBlurEffect(effect) then return end
    if effect.Enabled then effect.Enabled = false end
    if _noBlurEffectConnections[effect] then return end

    _noBlurEffectConnections[effect] = effect:GetPropertyChangedSignal("Enabled"):Connect(function()
        if _noBlurActive and effect.Parent and effect.Enabled then
            effect.Enabled = false
        end
    end)
end

local function ScanBlurContainer(container)
    if not container then return end
    for _, child in ipairs(container:GetChildren()) do
        SuppressBlurEffect(child)
    end
end

local function BindNoBlurCamera(camera)
    if camera == _noBlurCamera then return end
    if _noBlurCameraConnection then
        _noBlurCameraConnection:Disconnect()
        _noBlurCameraConnection = nil
    end
    if _noBlurCamera then
        for effect, connection in pairs(_noBlurEffectConnections) do
            if not effect.Parent or effect:IsDescendantOf(_noBlurCamera) then
                if connection then connection:Disconnect() end
                _noBlurEffectConnections[effect] = nil
            end
        end
    end
    _noBlurCamera = camera
    if not camera then return end
    ScanBlurContainer(camera)
    _noBlurCameraConnection = camera.ChildAdded:Connect(SuppressBlurEffect)
end

local function StartNoBlurEnforcement()
    if _noBlurActive then return end
    _noBlurActive = true
    ScanBlurContainer(Lighting)
    BindNoBlurCamera(game:GetService("Workspace").CurrentCamera)
    _noBlurConnections[#_noBlurConnections + 1] = Lighting.ChildAdded:Connect(SuppressBlurEffect)
    _noBlurConnections[#_noBlurConnections + 1] =
        game:GetService("Workspace"):GetPropertyChangedSignal("CurrentCamera"):Connect(function()
            BindNoBlurCamera(game:GetService("Workspace").CurrentCamera)
        end)
end

local function StopNoBlurEnforcement()
    if not _noBlurActive then return end
    _noBlurActive = false
    DisconnectNoBlurConnections()
end

local _attrStripActive = {
    noStun = false,
    infStamina = false,
    noRagdoll = false,
}
local _stunAttrs = { "Stunned", "CantAnything", "CombatAttacking", "CombatRecovery" }
local _ragdollAttrs = { "Ragdoll", "Downed", "RespawnLocked" }
local _attrStripConnections = {}
local _attrStripCharacterConnection
local _ragdollStateConnection
local _ragdollStateElapsed = 0

local function DisconnectAttributeStripConnections()
    for index = #_attrStripConnections, 1, -1 do
        local connection = _attrStripConnections[index]
        _attrStripConnections[index] = nil
        if connection then pcall(function() connection:Disconnect() end) end
    end
    if _attrStripCharacterConnection then
        _attrStripCharacterConnection:Disconnect()
        _attrStripCharacterConnection = nil
    end
    if _ragdollStateConnection then
        _ragdollStateConnection:Disconnect()
        _ragdollStateConnection = nil
    end
    _ragdollStateElapsed = 0
end

local function ApplyAttributeStrips(character)
    if not character then return end
    -- Never strip game state while an emote is playing: emotes use the same
    -- lock attributes and clearing them lets the player move mid-emote.
    if _sktIsEmoting(character) then return end

    if _attrStripActive.noStun then
        for _, attribute in ipairs(_stunAttrs) do
            if character:GetAttribute(attribute) == true then character:SetAttribute(attribute, nil) end
        end
    end

    if _attrStripActive.infStamina and character:GetAttribute("Stamina") ~= 100 then
        character:SetAttribute("Stamina", 100)
    end

    if _attrStripActive.noRagdoll then
        for _, attribute in ipairs(_ragdollAttrs) do
            if character:GetAttribute(attribute) == true then character:SetAttribute(attribute, nil) end
        end
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if humanoid then
            humanoid:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
            humanoid:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
        end
    end
end

local function BindAttributeStripCharacter(character)
    for index = #_attrStripConnections, 1, -1 do
        local connection = _attrStripConnections[index]
        _attrStripConnections[index] = nil
        if connection then pcall(function() connection:Disconnect() end) end
    end
    if not character then return end

    local watchedAttributes = {}
    local function WatchAttribute(attribute)
        if watchedAttributes[attribute] then return end
        watchedAttributes[attribute] = true
        _attrStripConnections[#_attrStripConnections + 1] =
            character:GetAttributeChangedSignal(attribute):Connect(function()
                ApplyAttributeStrips(character)
            end)
    end

    if _attrStripActive.noStun then
        for _, attribute in ipairs(_stunAttrs) do WatchAttribute(attribute) end
    end
    if _attrStripActive.infStamina then WatchAttribute("Stamina") end
    if _attrStripActive.noRagdoll then
        for _, attribute in ipairs(_ragdollAttrs) do WatchAttribute(attribute) end
        _attrStripConnections[#_attrStripConnections + 1] = character.ChildAdded:Connect(function(child)
            if child:IsA("Humanoid") then ApplyAttributeStrips(character) end
        end)
    end

    ApplyAttributeStrips(character)
end

local function _UpdateAttributeStripConnections()
    local anyActive = false
    for _, v in pairs(_attrStripActive) do
        if v then anyActive = true; break end
    end
    if anyActive then
        if not _attrStripCharacterConnection then
            _attrStripCharacterConnection = LocalPlayer.CharacterAdded:Connect(function(character)
                BindAttributeStripCharacter(character)
            end)
        end
        BindAttributeStripCharacter(LocalPlayer.Character)
    else
        DisconnectAttributeStripConnections()
    end

    if _attrStripActive.noRagdoll and not _ragdollStateConnection then
        _ragdollStateElapsed = 0
        _ragdollStateConnection = RunService.Heartbeat:Connect(function(deltaTime)
            _ragdollStateElapsed += deltaTime
            if _ragdollStateElapsed < 0.25 then return end
            _ragdollStateElapsed = 0
            local character = LocalPlayer.Character
            local humanoid = character and character:FindFirstChildOfClass("Humanoid")
            if humanoid then
                humanoid:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
                humanoid:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
            end
        end)
    elseif not _attrStripActive.noRagdoll and _ragdollStateConnection then
        _ragdollStateConnection:Disconnect()
        _ragdollStateConnection = nil
        _ragdollStateElapsed = 0
    end
end

--// No Ragdoll
startNoRagdoll = function()
    _attrStripActive.noRagdoll = true
    _UpdateAttributeStripConnections()
end
stopNoRagdoll = function()
    _attrStripActive.noRagdoll = false
    _UpdateAttributeStripConnections()
end

--// No Blur
