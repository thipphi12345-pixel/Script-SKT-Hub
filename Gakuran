-- Recommend the best settings based on measured ping/FPS.
local function recommendSettings(pingMs, fps)
    local rec = {}

    -- Parry Engine: Fusion as default, Phantom as advanced option
    rec.ParryEngine = "Fusion"
    rec.ParryMethod = "Auto"

    -- Timing Offset: tuned per ping bracket
    if pingMs < 50 then
        rec.TimingOffset = -75
    elseif pingMs < 100 then
        rec.TimingOffset = -85
    elseif pingMs < 150 then
        rec.TimingOffset = -100
    elseif pingMs < 200 then
        rec.TimingOffset = -115
    elseif pingMs < 300 then
        rec.TimingOffset = -130
    else
        rec.TimingOffset = -150
    end

    -- Block Hold: slightly longer for high ping to cover the window
    if pingMs < 80 then rec.BlockHold = 394
    elseif pingMs < 150 then rec.BlockHold = 420
    elseif pingMs < 250 then rec.BlockHold = 450
    else rec.BlockHold = 500 end

    -- Max Range: keep default
    rec.MaxRange = 10
    rec.MaxRangeDodge = 20

    -- Parry Hitchance: 100% always
    rec.ParryHitchance = 100

    -- Fast Unblock: on for low ping, off for high ping (safer)
    rec.FastUnblock = pingMs < 150

    -- Stop While Typing: always on
    rec.StopWhileTyping = true

    -- Exclude Friends/Contacts: on
    rec.ExcludeFriends = true
    rec.ExcludeContacts = true

    -- Response Priority
    rec.ResponsePriority = "Block First"
    rec.AttackCoverage = "All Known"

    -- Face Target: always on, range based on ping
    rec.FaceTarget = true
    if pingMs < 100 then rec.FaceTargetRange = 15
    elseif pingMs < 200 then rec.FaceTargetRange = 20
    else rec.FaceTargetRange = 30 end

    -- Auto Dodge: on with M2 Priority for smart dodging
    rec.AutoDodge = true
    rec.DodgeAngle = 60
    rec.M2Assist = true

    -- Auto Counter
    rec.AutoWingChun = false
    rec.AutoCounterDelay = fps < 30 and 0 or 20
    rec.AutoCounterHitchance = 100

    -- Auto Punish: on for low ping
    rec.AutoPunish = pingMs < 200

    return rec
end

-- Apply recommended settings to the UI.
local function applySettings(rec)
    task.spawn(function()
        local function setOpt(key, value)
            local o = Options[key]
            if o and o.SetValue then pcall(o.SetValue, o, value) end
        end
        local function setTog(key, value)
            local t = Toggles[key]
            if t and t.SetValue then pcall(t.SetValue, t, value) end
        end

        setOpt("ParryEngine", rec.ParryEngine)
        setOpt("ParryMethod", rec.ParryMethod)
        setOpt("TimingOffset", rec.TimingOffset)
        setOpt("BlockHold", rec.BlockHold)
        setOpt("MaxRange", rec.MaxRange)
        setOpt("MaxRangeDodge", rec.MaxRangeDodge)
        setOpt("ParryHitchance", rec.ParryHitchance)
        setTog("FastUnblock", rec.FastUnblock)
        setTog("StopWhileTyping", rec.StopWhileTyping)
        setTog("ExcludeFriends", rec.ExcludeFriends)
        setTog("ExcludeContacts", rec.ExcludeContacts)
        setOpt("ResponsePriority", rec.ResponsePriority)
        setOpt("AttackCoverage", rec.AttackCoverage)
        setTog("FaceTarget", rec.FaceTarget)
        setOpt("FaceTargetRange", rec.FaceTargetRange)
        setTog("AutoDodge", rec.AutoDodge)
        setOpt("DodgeAngle", rec.DodgeAngle)
        setTog("M2Assist", rec.M2Assist)
        setTog("AutoWingChun", rec.AutoWingChun)
        setOpt("AutoCounterDelay", rec.AutoCounterDelay)
        setOpt("AutoCounterHitchance", rec.AutoCounterHitchance)
        setTog("AutoPunish", rec.AutoPunish)
        if Library._ParryRuntime then Library._ParryRuntime:Refresh() end
    end)
end

-- Measure ping and FPS.
local function measurePerformance()
    local pingMs = 0
    pcall(function() pingMs = game:GetService("Stats").Network.ServerStatsItem["Data Ping"]:GetValue() end)
    if pingMs == 0 then pcall(function() pingMs = game:GetService("Players").LocalPlayer:GetNetworkPing() * 1000 end) end
    local fps = 60
    pcall(function() fps = math.floor(game:GetService("Workspace"):GetRealPhysicsFPS()) end)
    return pingMs, fps
end

