task.spawn(function()
    while task.wait(1) do
        if not _akumaAutoRunning then
            pcall(function() AkumaStatusLabel:SetText("Akuma Auto: Idle") end)
        else
            local blink = getBlink()
            local now = os.clock()
            local c = JobsState.commitment
            local statusLines = {}

            -- 1. Refresh board periodically
            if now - _akumaLastBoardRefresh > 10 then
                _akumaLastBoardRefresh = now
                refreshJobBoard()
            end

            -- 2. Find a Club Akuma shift
            local akumaShift = _findAkumaShift()

            if not c or not c.ShiftId then
                -- Not applied yet — apply to Club Akuma shift
                if akumaShift and now - _akumaLastApply > 3 then
                    _akumaLastApply = now
                    pcall(blink.JobApplyToShift.Fire, { ShiftId = akumaShift.ShiftId })
                    table.insert(statusLines, "สมัครกะ: " .. tostring(akumaShift.ShiftId))
                else
                    table.insert(statusLines, "ค้นหากะ Club Akuma...")
                end
            else
                -- Applied — check status
                local shiftId = c.ShiftId
                local clockedIn = c.ClockedIn == 1
                local inUniform = c.InUniform == 1
                local minutesWorked = c.MinutesWorked or 0
                local earnedYen = c.EarnedYen or 0

                table.insert(statusLines, string.format("กะ: %s", shiftId))
                table.insert(statusLines, string.format("Clocked In: %s | Uniform: %s",
                    clockedIn and "Yes" or "No",
                    inUniform and "Yes" or "No"))
                table.insert(statusLines, string.format("เวลาทำ: %.1f นาที | เงิน: %d ¥", minutesWorked, earnedYen))

                -- 3. No uniform yet — go stand at the locker and request it
                if not inUniform then
                    if now - _akumaLastTeleport > 3 then
                        _akumaLastTeleport = now
                        _teleportTo(CLUB_AKUMA_LOCKER_POS)
                    end
                    if now - _akumaLastLocker > 2 and blink.JobLockerRequest then
                        _akumaLastLocker = now
                        pcall(blink.JobLockerRequest.Fire, { Area = "Club Akuma" })
                        table.insert(statusLines, "เปิด locker ที่ Club Akuma...")
                    end
                    local lr = JobsState.lockerResult
                    if lr then
                        table.insert(statusLines, string.format("Locker: success=%s reject=%s",
                            tostring(lr.Success), tostring(lr.Rejection)))
                    end
                else
                    -- 4. Uniform on — stay at the work spot
                    if now - _akumaLastTeleport > 5 then
                        _akumaLastTeleport = now
                        _teleportToAkuma()
                    end
                end

                -- 5. Check if shift is over (find the shift's EndMinutes)
                if akumaShift then
                    local endMin = akumaShift.EndMinutes or 0
                    -- If worked more than the shift duration, quit and re-apply
                    if minutesWorked > (endMin - (akumaShift.StartMinutes or 0)) and minutesWorked > 0 then
                        if blink.JobQuitShift and now - _akumaLastQuit > 4 then
                            _akumaLastQuit = now
                            pcall(blink.JobQuitShift.Fire, { ShiftId = shiftId })
                            table.insert(statusLines, "หมดเวลา — ออกจากกะ...")
                        end
                    end
                end
            end

            pcall(function() AkumaStatusLabel:SetText(table.concat(statusLines, "\n")) end)
        end
    end
end)

