function _findPhotoRemotes()
    if _photoSubmitRemote and _photoSubmitRemote.Parent and _photoStateRemote and _photoStateRemote.Parent then
        return
    end
    local RS = game:GetService("ReplicatedStorage")
    -- New game uses Quenty's remote storage: ReplicatedStorage.RemoteFunctions / .RemoteEvents
    local submitName, stateName = "PhotoJobSubmit", "PhotoJobState"
    -- Read names from PhotoJobConfig if available
    pcall(function()
        local cfg = RS:FindFirstChild("Shared")
            and RS.Shared:FindFirstChild("Config")
            and RS.Shared.Config:FindFirstChild("PhotoJobConfig")
        if cfg then
            local mod = require(cfg)
            if mod and mod.SUBMIT_REMOTE then submitName = mod.SUBMIT_REMOTE end
            if mod and mod.STATE_REMOTE then stateName = mod.STATE_REMOTE end
        end
    end)
    -- Try Quenty storage folders first (new game)
    if not _photoSubmitRemote then
        local rfFolder = RS:FindFirstChild("RemoteFunctions")
        if rfFolder then
            _photoSubmitRemote = rfFolder:FindFirstChild(submitName)
        end
    end
    if not _photoStateRemote then
        local reFolder = RS:FindFirstChild("RemoteEvents")
        if reFolder then
            _photoStateRemote = reFolder:FindFirstChild(stateName)
        end
    end
    -- Try legacy "Remotes" folder
    if not _photoSubmitRemote or not _photoStateRemote then
        local remotes = RS:FindFirstChild("Remotes")
        if remotes then
            if not _photoSubmitRemote then
                _photoSubmitRemote = remotes:FindFirstChild(submitName)
            end
            if not _photoStateRemote then
                _photoStateRemote = remotes:FindFirstChild(stateName)
            end
        end
    end
    -- Deep scan ReplicatedStorage
    if not _photoSubmitRemote or not _photoStateRemote then
        local _c2=0; for _, d in ipairs(RS:GetDescendants()) do _c2=_c2+1; if _c2%500==0 then task.wait() end
            if d.Name == submitName and d:IsA("RemoteFunction") then
                _photoSubmitRemote = d
            elseif d.Name == stateName and d:IsA("RemoteEvent") then
                _photoStateRemote = d
            end
        end
    end
    -- Fallback: search entire DataModel
    if not _photoSubmitRemote or not _photoStateRemote then
        local _c3=0; for _, d in ipairs(game:GetDescendants()) do _c3=_c3+1; if _c3%500==0 then task.wait() end
            if d.Name == submitName and d:IsA("RemoteFunction") then
                _photoSubmitRemote = d
            elseif d.Name == stateName and d:IsA("RemoteEvent") then
                _photoStateRemote = d
            end
        end
    end
    if _photoSubmitRemote then
        print(string.format("[Auto Photo] Found PhotoJobSubmit: %s", _photoSubmitRemote:GetFullName()))
    end
    if _photoStateRemote then
        print(string.format("[Auto Photo] Found PhotoJobState: %s", _photoStateRemote:GetFullName()))
    end
end

