    function Window:FocusTab(tab)
        if not tab or self.SelectedTab ~= tab then return end
        tab.SectionFocused = false
        if self.SidebarRuleA then self.SidebarRuleA.Visible = true end
        if tab.Footer then tab.Footer.Visible = false end
        tween(tab.Button, 0.14, {
            BackgroundColor3 = Theme.Ink,
            Size = UDim2.new(1, 0, 0, 38),
        })
        tween(tab.Label, 0.14, {
            Position = UDim2.fromOffset(44, 0),
            TextColor3 = Theme.White,
        })
        if tab.IconImage then tween(tab.IconImage, 0.16, { ImageColor3 = Theme.Accent }) end
        if tab.IconGlyph then tween(tab.IconGlyph, 0.16, { TextColor3 = Theme.Accent }) end
        if tab.ActiveBar then
            tween(tab.ActiveBar, 0.18, { Size = UDim2.fromOffset(3, 22) }, Enum.EasingStyle.Back)
        end
        if tab.ActiveGlow then
            tween(tab.ActiveGlow, 0.18, { Size = UDim2.fromOffset(9, 22) }, Enum.EasingStyle.Back)
        end
        if tab.ButtonStroke then
            tween(tab.ButtonStroke, 0.14, { Color = Theme.Accent, Transparency = 0.15 })
        end
        if tab.SelectTint then
            tween(tab.SelectTint, 0.18, { BackgroundTransparency = 0.82 })
        end
        tween(tab.Icon, 0.16, {
            Size = UDim2.fromOffset(26, 26),
            BackgroundColor3 = Theme.AccentDeep,
            BackgroundTransparency = 0.35,
        }, Enum.EasingStyle.Quart)
        if tab.IconStroke then
            tween(tab.IconStroke, 0.16, { Color = Theme.Accent, Transparency = 0.2 })
        end
    end

    function Window:SelectTab(tab)
        if self.SelectedTab == tab then
            self:FocusTab(tab)
            return
        end
        local previousTab = self.SelectedTab
        for _, candidate in ipairs(self.Tabs) do
            local selected = candidate == tab
            if selected then
                candidate.Page.Visible = true
            else
                candidate.Page.Visible = false
            end
            if candidate.SectionList then candidate.SectionList.Visible = false end
            if candidate.Footer then candidate.Footer.Visible = false end
            tween(candidate.Button, 0.15, {
                BackgroundColor3 = selected and Theme.Ink or Theme.Raised,
                Size = UDim2.new(1, 0, 0, 38),
            })
            tween(candidate.Label, 0.15, {
                Position = UDim2.fromOffset(44, 0),
                TextColor3 = selected and Theme.White or Theme.InkSoft,
            })
            local iconColor = selected and Theme.Accent or Theme.InkSoft
            if candidate.IconImage then
                tween(candidate.IconImage, 0.18, { ImageColor3 = iconColor })
            end
            if candidate.IconGlyph then
                tween(candidate.IconGlyph, 0.18, { TextColor3 = iconColor })
            end
            if candidate.ActiveBar then
                tween(candidate.ActiveBar, 0.2, {
                    Size = UDim2.fromOffset(3, selected and 22 or 0),
                }, Enum.EasingStyle.Back)
            end
            if candidate.ActiveGlow then
                tween(candidate.ActiveGlow, 0.2, {
                    Size = UDim2.fromOffset(9, selected and 22 or 0),
                }, Enum.EasingStyle.Back)
            end
            if candidate.ButtonStroke then
                tween(candidate.ButtonStroke, 0.15, {
                    Color = selected and Theme.Accent or Theme.Line,
                    Transparency = selected and 0.15 or 0.45,
                })
            end
            if candidate.SelectTint then
                tween(candidate.SelectTint, 0.2, {
                    BackgroundTransparency = selected and 0.82 or 1,
                })
            end
            tween(candidate.Icon, 0.18, {
                Size = selected and UDim2.fromOffset(26, 26) or UDim2.fromOffset(24, 24),
                BackgroundColor3 = selected and Theme.AccentDeep or Theme.Ink,
                BackgroundTransparency = selected and 0.35 or 0.45,
            }, Enum.EasingStyle.Back)
            if candidate.IconStroke then
                tween(candidate.IconStroke, 0.18, {
                    Color = selected and Theme.Accent or Theme.LineSoft,
                    Transparency = selected and 0.2 or 0.45,
                })
            end
        end
        self.SelectedTab = tab
        if previousTab and previousTab.Page.Parent then
            local animation = ActiveTweens[previousTab.Page]
            if animation then animation:Cancel() end
            previousTab.Page.Visible = false
        end
        if tab.Sections and tab.Sections[1] and not tab.SelectedSection then
            tab:SelectSection(tab.Sections[1], false, false)
        end
        self:FocusTab(tab)
        local page = tab.Page
        page.Position = UDim2.fromOffset(14, 0)
        tween(page, 0.18, { Position = UDim2.fromOffset(0, 0) }, Enum.EasingStyle.Quart)
    end

