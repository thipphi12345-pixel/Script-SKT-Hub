function refreshSpectateDropdown()
    local values = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            table.insert(values, p.Name)
        end
    end
    if #values == 0 then
        table.insert(values, "(no players)")
        pcall(function()
            Options.SpectateTarget:SetValues(values)
            Options.SpectateTarget:SetDisabledValues({ "(no players)" })
        end)
    else
        pcall(function()
            Options.SpectateTarget:SetValues(values)
            Options.SpectateTarget:SetDisabledValues({})
        end)
    end
end

