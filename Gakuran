            local targetTime = hitDelay - ping * 0.5 - 0.18
            if targetTime > track.TimePosition then
                while track.IsPlaying and track.TimePosition < targetTime do
                    RunService.Heartbeat:Wait()
                end
            end
            if not track.IsPlaying then return end

            local myChar = LocalPlayer.Character
            local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
            local theirRoot = model:FindFirstChild("HumanoidRootPart")
            if not (myChar and myRoot and theirRoot) then return end
            local dist = (myRoot.Position - theirRoot.Position).Magnitude
            if dist > maxRange then return end

            if myChar:GetAttribute("M2Cooldown") == true then return end
            if os.clock() - awcLastM2 < 0.5 then return end
            awcLastM2 = os.clock()

            local selStyle = awcGetSelectedStyle()
            if selStyle == "Ali" then
                doDodge(model, "forward-side")
                awcPunishUntil = os.clock() + 1.5
            else
                local remotes = game:GetService("ReplicatedStorage"):FindFirstChild("Remotes")
                local serverRemote = remotes and remotes:FindFirstChild("Server")
                pcall(function()
                    local vim = game:GetService("VirtualInputManager")
                    vim:SendKeyEvent(true, Enum.KeyCode.R, false, game)
                    task.delay(0.05, function() vim:SendKeyEvent(false, Enum.KeyCode.R, false, game) end)
                end)
                if serverRemote then
                    pcall(function()
                        serverRemote:FireServer({ Type = "Combat", Action = "M2", Func = "ServerCheck" })
                    end)
                end
                awcPunishUntil = os.clock() + 2.3
            end
        end)
    end

    local function awcSetTrackedModel(model)
        if model == awcTrackedModel then return end
        if awcTrackedConn then
            awcTrackedConn:Disconnect()
            awcTrackedConn = nil
        end
        awcTrackedModel = model
        State.awcTrackedModel = model
        if not model then return end
        local hum = model:FindFirstChildOfClass("Humanoid")
        local animator = hum and hum:FindFirstChildOfClass("Animator")
        if not animator then return end
        awcTrackedConn = animator.AnimationPlayed:Connect(function(track)
            awcOnTargetSwing(model, track)
        end)
    end

    -- Expose cleanup for unload
    State._awcCleanup = function()
        awcSetTrackedModel(nil)
        awcPunishUntil = 0
    end

    while true do
        if getgenv()._SKT_Unloaded then break end

        local toggle = Toggles.AutoWingChun
        if not (toggle and toggle.Value) then
            awcSetTrackedModel(nil)
            awcPunishUntil = 0
            task.wait(1) -- sleep นานขึ้นตอนปิด (ลด CPU)
            continue
        end
        task.wait(0.1 + math.random() * 0.05)

        local myChar = LocalPlayer.Character
        local myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")
        local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
        if not (myChar and myHum and myRoot and myHum.Health > 0) then
            awcSetTrackedModel(nil)
            continue
        end

        local selStyle = awcGetSelectedStyle()
        if selStyle ~= "WingChun" and selStyle ~= "Ali" then
            awcSetTrackedModel(nil)
            continue
        end

        if myChar:GetAttribute("Ragdoll") == true or myChar:GetAttribute("Stunned") == true
            or myChar:GetAttribute("Downed") == true or myChar:GetAttribute("Grabbed") == true
            or myChar:GetAttribute("Grappled") == true then
            continue
        end

        local nearestModel, nearestDist = nil, 15
        local acTarget = _acTrackedModel
        if acTarget and acTarget.Parent then
            local r = acTarget:FindFirstChild("HumanoidRootPart")
            local h = acTarget:FindFirstChildOfClass("Humanoid")
            if r and h and h.Health > 0 then
                nearestModel, nearestDist = acTarget, (myRoot.Position - r.Position).Magnitude
            end
        end
        if not nearestModel then
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character then
                    local r = p.Character:FindFirstChild("HumanoidRootPart")
                    local h = p.Character:FindFirstChildOfClass("Humanoid")
                    if r and h and h.Health > 0 and not isExcludedAttacker(p.Character) then
                        local d = (myRoot.Position - r.Position).Magnitude
                        if d < nearestDist then
                            nearestDist = d
                            nearestModel = p.Character
                        end end end end end

        awcSetTrackedModel(nearestModel)
    end
end)

