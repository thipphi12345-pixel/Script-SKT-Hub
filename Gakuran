    function Tab:AddToggle(options)
        options = options or {}
        local value = options.Default == true
        local row = createControlRow(self, 38)

        local button = create("TextButton", {
            Name = "Toggle",
            AutoButtonColor = false,
            BackgroundTransparency = 1,
            Font = Enum.Font.GothamMedium,
            Position = UDim2.fromOffset(14, 0),
            Size = UDim2.new(1, -84, 1, 0),
            Text = options.Name or "Toggle",
            TextColor3 = Theme.InkSoft,
            TextSize = 12,
            TextWrapped = true,
            TextXAlignment = Enum.TextXAlignment.Left,
            ZIndex = 9,
            Parent = row,
        })

        -- Pill switch with ON/OFF label: the knob slides and the track fills
        -- gold; a tiny label spells the state out so it is readable even when
        -- the player has colour-vision issues.
        local track = create("TextButton", {
            Name = "SwitchTrack",
            AnchorPoint = Vector2.new(1, 0.5),
            AutoButtonColor = false,
            BackgroundColor3 = Theme.Paper,
            BorderSizePixel = 0,
            Position = UDim2.new(1, -10, 0.5, 0),
            Size = UDim2.fromOffset(46, 22),
            Text = "",
            ZIndex = 11,
            Parent = row,
        })
        corner(track, 999)
        local trackStroke = stroke(track, Theme.Line, 1, 0.15)

        local fill = create("Frame", {
            Name = "SwitchFill",
            BackgroundColor3 = Theme.Accent,
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            Size = UDim2.fromScale(1, 1),
            ZIndex = 11,
            Parent = track,
        })
        corner(fill, 999)

        local knob = create("Frame", {
            Name = "SwitchKnob",
            AnchorPoint = Vector2.new(0.5, 0.5),
            BackgroundColor3 = Theme.InkSoft,
            BorderSizePixel = 0,
            Position = UDim2.new(0, 12, 0.5, 0),
            Size = UDim2.fromOffset(16, 16),
            ZIndex = 13,
            Parent = track,
        })
        corner(knob, 999)

        local stateLabel = create("TextLabel", {
            Name = "StateLabel",
            AnchorPoint = Vector2.new(0.5, 0.5),
            BackgroundTransparency = 1,
            Font = Enum.Font.GothamMedium,
            Position = UDim2.new(0, 12, 0.5, 0),
            Size = UDim2.fromOffset(20, 16),
            Text = "OFF",
            TextColor3 = Theme.White,
            TextSize = 9,
            TextTransparency = 1,
            ZIndex = 14,
            Parent = track,
        })

        local function render(animate)
            -- Track is 46px wide; knob is 16px. ON = knob on right (x=34),
            -- OFF = knob on left (x=12). Label sits opposite the knob.
            local knobPosition = UDim2.new(0, value and 34 or 12, 0.5, 0)
            local labelPosition = UDim2.new(0, value and 12 or 34, 0.5, 0)
            local textColor = value and Theme.White or Theme.InkSoft
            local rowColor = value and Theme.Ink or Theme.PaperDark
            local knobColor = value and Theme.Black or Theme.InkSoft
            stateLabel.Text = value and "ON" or "OFF"
            stateLabel.TextColor3 = value and Theme.Black or Theme.White
            if animate then
                tweenControlRowColor(row, 0.14, rowColor)
                tween(button, 0.14, { TextColor3 = textColor })
                tween(fill, 0.16, { BackgroundTransparency = value and 0 or 1 })
                tween(knob, 0.18, { Position = knobPosition, BackgroundColor3 = knobColor }, Enum.EasingStyle.Back)
                tween(stateLabel, 0.18, { Position = labelPosition, TextTransparency = 0 }, Enum.EasingStyle.Back)
                tween(trackStroke, 0.14, { Transparency = value and 1 or 0.15 })
            else
                setControlRowColor(row, rowColor)
                button.TextColor3 = textColor
                fill.BackgroundTransparency = value and 0 or 1
                knob.Position = knobPosition
                knob.BackgroundColor3 = knobColor
                stateLabel.Position = labelPosition
                stateLabel.TextTransparency = 0
                trackStroke.Transparency = value and 1 or 0.15
            end
        end

        local function set(nextValue, fire)
            value = nextValue == true
            render(true)
            if fire ~= false then
                invokeCallback(options.Callback, value)
            end
        end

        button.MouseButton1Click:Connect(function()
            set(not value, true)
        end)
        track.MouseButton1Click:Connect(function()
            set(not value, true)
        end)
        render(false)

        return {
            Instance = row,
            Set = function(_, nextValue, fire)
                set(nextValue, fire)
            end,
