local function DH_CollectEmbers()
	if not workspace:FindFirstChild("EmberTemplate") then return false end
	for _, ember in ipairs(workspace:GetChildren()) do
		if ember.Name == "EmberTemplate" and ember:FindFirstChild("Part") then
			while Alive() and Cfg("AutoDragonHunter") and ember.Parent
				and ember:FindFirstChild("Part") do
				RunService.Heartbeat:Wait()
				Tween:To(ember.Part.CFrame)
			end
			return true
		end
	end
	return false
end

local function DH_HarvestBamboo(count)
	local waterfall = Refs.Map:FindFirstChild("Waterfall")
	local model = waterfall and waterfall:FindFirstChild("IslandModel")
	if not model then return 0 end
	local trees = {}
	for _, child in ipairs(model:GetChildren()) do
		if child.Name == "Tree" then
			local group = child:FindFirstChild("Group")
			if group and group:FindFirstChild("Meshes/bambootree") then
				table.insert(trees, child)
			end
		end
	end
	local done = 0
	for _, tree in ipairs(trees) do
		if done >= count then break end
		while Alive() and Cfg("AutoDragonHunter") do
			RunService.Heartbeat:Wait()
			if not (tree and tree.Parent) or workspace:FindFirstChild("EmberTemplate")
				or DH.needQuest or done >= count then break end
			Tween:To(tree.WorldPivot)
			Util.EquipByTip("Melee")
			Util.UseSkills({ "Z", "X", "C", "V", "F" })
		end
		done += 1
	end
	if done < count then DH.needQuest = true end
	return done
end

local function DH_GetQuest()
	local rf = Net:FindFirstChild("RF/DragonHunter")
	if not rf then return nil end
	local ok, res = pcall(function() return rf:InvokeServer({ Context = "Check" }) end)
	if ok and res and res.Text then return res.Text end
	local ok2, res2 = pcall(function() return rf:InvokeServer({ Context = "RequestQuest" }) end)
	return ok2 and res2 and res2.Text or nil
end

function Feature.DragonHunter()
	if not Farm:Allowed("AutoDragonHunter") then return end
	if DH.needQuest then
		if Util.Dist(DH_NPC.Position) > 10 then
			Tween:To(DH_NPC)
		else
			DH.questText = DH_GetQuest()
			while Alive() and Cfg("AutoDragonHunter") and type(DH.questText) ~= "string" do
				RunService.Heartbeat:Wait()
			end
			DH.needQuest = false
		end
		return
	end
	local txt = DH.questText
	if not txt then return end
	if txt:find("Hydra Enforcers") or txt:find("Venomous Assailants") then
		local mob = txt:find("Hydra Enforcers") and "Hydra Enforcer" or "Venomous Assailant"
		if Farm:FindEnemy({ mob }) then
			Farm:Engage({ mob })
		else
			Tween:To(DH_SPAWN)
		end
		if workspace:FindFirstChild("EmberTemplate") then
			DH.needQuest = DH_CollectEmbers()
		end
	else
		local count = 10
		if txt:find("/") then
			local parts = txt:split(" ")
			if #parts >= 2 then count = tonumber(parts[2]:split("/")[2]) or 10 end
		end
		if DH_HarvestBamboo(count) < count and not DH.needQuest then
			DH.needQuest = DH_CollectEmbers()
		end
	end
end

