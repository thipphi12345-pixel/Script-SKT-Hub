function Feature.AutoFishing()
	local char, root = GetChar(), GetRoot()
	local rod = char and char:FindFirstChildWhichIsA("Tool")
	if not (rod and root and rod:GetAttribute("InventoryCategory") == "Rod") then return end

	pcall(function()
		if (rod:GetAttribute("SkillChargeAlpha") or 0) >= 1 then
			Net["RF/JobToolAbilities"]:InvokeServer("Z", true)
		end
	end)

	local state = rod:GetAttribute("State")
	local castPos = nil
	pcall(function()
		local waterY = require(RS.Util.GetWaterHeightAtLocation)(root.Position)
		local cfg = require(RS.FishReplicated.FishingClient.Config)
		local range = cfg.Rod.MaxLaunchDistance * 0.9975124
		local ignore = { char, Refs.Characters, Refs.Enemies }
		local head = char:FindFirstChild("Head") or root
		local _, hitPos = workspace:FindPartOnRayWithIgnoreList(
			Ray.new(head.Position, root.CFrame.LookVector * range), ignore)
		if hitPos then
			local _, downPos = workspace:FindPartOnRayWithIgnoreList(
				Ray.new(hitPos + Vector3.new(0, 3, 0), Vector3.new(0, -500, 0)), ignore)
			if downPos and downPos.Y < waterY then
				castPos = Vector3.new(hitPos.X, math.max(downPos.Y, waterY), hitPos.Z)
			end
		end
	end)

	local fishReq = RS:FindFirstChild("FishReplicated") and RS.FishReplicated:FindFirstChild("FishingRequest")
	if not fishReq then return end
	if state == "ReeledIn" then
		pcall(FishAnim, "Fishing_Cast")
		pcall(function() fishReq:InvokeServer("StartCasting") end)
		task.wait(0.7)
		if castPos then
			pcall(function() fishReq:InvokeServer("CastLineAtLocation", castPos, 100, true) end)
		end
	elseif state == "Biting" then
		pcall(FishAnim, "Fishing_PullFishOut")
		pcall(function() fishReq:InvokeServer("Catching", true) end)
		task.wait(0.25)
		pcall(function() fishReq:InvokeServer("Catch", 1) end)
	else
		pcall(FishAnim, "Fishing_Idle")
	end
end

