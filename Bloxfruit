-- Hop Boss: a tiny standalone hopper persisted to disk and queued across
-- teleports, so the search keeps going server-to-server without needing the
-- whole hub re-executed. It stops itself (and deletes its file) on success.
do
local HOPBOSS_FILE = BRAND .. "/hopboss.lua"
local HOPBOSS_SRC = [==[
local BOSS = __BOSS__
local FILE = __FILE__
repeat task.wait() until game:IsLoaded()
task.wait(8)
if not (isfile and isfile(FILE)) then return end
local RS = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local function notify(t)
	pcall(function()
		game:GetService("StarterGui"):SetCore("SendNotification", { Title = "SKT HUB | Hop Boss", Text = t, Duration = 12 })
	end)
end
for _, c in ipairs({ workspace:FindFirstChild("Enemies"), RS }) do
	if c then
		for _, m in ipairs(c:GetChildren()) do
			if m:IsA("Model") and m.Name:find(BOSS, 1, true) then
				local h = m:FindFirstChildOfClass("Humanoid")
				if not h or h.Health > 0 then
					pcall(delfile, FILE)
					notify("Found " .. BOSS .. "!")
					return
				end
			end
		end
	end
end
notify(BOSS .. " not here, hopping...")
local q = queue_on_teleport or (syn and syn.queue_on_teleport)
if q then q("loadstring(readfile(" .. string.format("%q", FILE) .. "))()") end
local browser = RS:FindFirstChild("__ServerBrowser")
if not browser then return end
local list = {}
for page = 1, 5 do
	local ok, res = pcall(browser.InvokeServer, browser, page)
	if not ok or type(res) ~= "table" then break end
	for jobId, info in pairs(res) do
		local count = type(info) == "table" and (info.Count or 99) or tonumber(info) or 99
		if jobId ~= game.JobId and count < Players.MaxPlayers - 1 then list[#list + 1] = jobId end
	end
end
if #list > 0 then
	pcall(browser.InvokeServer, browser, "teleport", list[math.random(1, #list)])
end
]==]

local function HopBossPresent(name)
	for _, c in ipairs({ Refs.Enemies, RS }) do
		for _, m in ipairs(c:GetChildren()) do
			if m:IsA("Model") and m.Name:find(name, 1, true) then
				local h = m:FindFirstChildOfClass("Humanoid")
				if not h or h.Health > 0 then return true end
			end
		end
	end
	return false
end

