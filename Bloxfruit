local Farm = { SpawnIdx = 1 }

-- Higher entry wins when "Stack Farming" is on: only the first enabled feature runs.
Farm.PRIORITY = {
	"AutoFarmLevel", "AutoFarmNearest", "AutoFarmMastery", "AutoCollectChest",
	"AutoCollectBerry", "AutoFarmMaterial", "AutoAttackBoss", "AutoAttackAllBosses",
	"AutoPiratesSea", "AutoFactory", "AutoFindFruit", "AutoFarmSea",
	"AutoWoodPlanks", "AutoDragonHunter", "AutoTyrantSkies", "AutoCitizenQuest",
	"AutoRaid", "AutoTrial", "AutoV2", "AutoV3", "AutoKillAfterTrial",
	"SummonKitsune", "SummonMirage", "SummonPrehistoric", "FindLeviathan",
	"TweenKitsune", "TweenMirage", "TweenPrehistoric", "TweenFrozenDim",
	"AttackLeviathan", "AttackLeviathanSegment", "AttackLeviathanTail",
	"AutoEliteHunter", "AutoSoulReaper", "AutoFarmBones", "AutoCakePrince",
	"AutoDoughKing", "AutoRainbowHaki", "AutoGetSword", "AutoSerpentBow",
	"AutoSpawnerFruit",
}

-- Stack Farming semantics (ported from reference CheckStackPriority):
-- a task may run only if no higher-priority task is BOTH enabled and has
-- real work to do right now (its check() passes). This is what stops an
-- enabled-but-idle task from starving every farm below it.
function Farm:Allowed(flag)
	if not Alive() then return false end
	if not Cfg("StackFarming", false) then return true end
	local stack = self.STACK
	if not stack then return true end
	local idx
	for i, e in ipairs(stack) do
		if e[1] == flag then idx = i break end
	end
	if not idx then return true end -- not a coordinated farm task
	for i = 1, idx - 1 do
		local e = stack[i]
		if Cfg(e[1], false) then
			local ok, busy = pcall(e[2] or function() return true end)
			if ok and busy then return false end
		end
	end
	return true
end

function Farm:AnyActive()
	if not Alive() then return false end
	for _, name in ipairs(self.PRIORITY) do
		if Cfg(name, false) then return true end
	end
	return false
end

function Farm:FindEnemy(names, maxDist)
	local root = GetRoot()
	if not root then return nil end
	local set = Util.ToSet(names)
	local best, bestD2 = nil, maxDist and maxDist * maxDist or math.huge
	for _, mob in ipairs(EnemyList) do
		if EnemyMatch(mob.Name, set) and Util.IsAlive(mob) then
			local _, hrp = EntParts(mob)
			if hrp then
				local d = hrp.Position - root.Position
				local d2 = d.X * d.X + d.Y * d.Y + d.Z * d.Z
				if d2 < bestD2 then best, bestD2 = mob, d2 end
			end
		end
	end
	return best
end

local Orbit = { angle = 0, radius = 35 }
function Farm:OrbitPos(mobCF)
	Orbit.angle = (Orbit.angle + 5) % 360
	local r = math.rad(Orbit.angle)
	local h = tonumber(Cfg("FarmDistance", 20)) or 20
	return mobCF + Vector3.new(math.sin(r) * Orbit.radius, h, math.cos(r) * Orbit.radius)
end

function Farm:Engage(names)
	local set = Util.ToSet(names)
	for _, mob in ipairs(EnemyList) do
		if EnemyMatch(mob.Name, set) then
			local hrp = mob.PrimaryPart
			if hrp and Util.IsAlive(mob) then
				Combat:WatchSkills(mob)
				local root = GetRoot()
				local lastHp, lastDrop = math.huge, tick()
				while mob.Parent and Util.IsAlive(mob) and self:AnyActive() do
					RunService.Heartbeat:Wait()
					root = GetRoot()
					if not root then break end
					local hp = mob.Humanoid.Health
					if hp < lastHp then
						lastHp = hp
						lastDrop = tick()
					end
					if tick() < Combat.DodgeUntil then
						root.CFrame = hrp.CFrame * CFrame.new(0, 500, 0)
					elseif tick() - lastDrop > 3.5 then
						-- Hits not landing: positions likely diverged server-side.
						-- Dive onto the mob to force melee range, then resume.
						lastDrop = tick()
						root.CFrame = hrp.CFrame * CFrame.new(0, 6, 0)
					else
						Util.EquipWeapon()
						Util.ActivateHaki()
						Combat:BringMob(mob, hrp.CFrame)
						Combat:SetAim(hrp)
						Tween:To(self:OrbitPos(hrp.CFrame))
					end
				end
			end
		end
	end

	-- Mob is not spawned yet: hover at its replicated model position
	for _, m in ipairs(RS:GetChildren()) do
		if EnemyMatch(m.Name, set) and m and m.PrimaryPart then
			Tween:To(CFrame.new(m.PrimaryPart.Position + Vector3.new(0, tonumber(Cfg("FarmDistance", 20)) or 20, 10)))
		end
	end
end

function Farm:GotoSpawn(names)
	local wanted = {}
	for _, n in ipairs(type(names) == "table" and names or { names }) do
		wanted[CompactName(n)] = true
	end

	local targets = {}
	local folder = RS:FindFirstChild("FortBuilderReplicatedSpawnPositionsFolder")
	if folder then
		for _, p in ipairs(folder:GetChildren()) do
			if p:IsA("Part") and p:GetAttribute("Active") and wanted[CompactName(p.Name)] then
				table.insert(targets, p:GetPivot())
			end
		end
	end
	if #targets == 0 then
		local sp = Refs.WorldOrigin:FindFirstChild("EnemySpawns")
		if sp then
			for _, p in ipairs(sp:GetChildren()) do
				if wanted[CompactName(p.Name)] then
					table.insert(targets, p:IsA("BasePart") and p.CFrame or p:GetPivot())
				end
			end
		end
	end
	if #targets == 0 then return false end

	-- Pick the nearest spawn point and stick to it. Rotating through every
	-- spawn each call made the tween target flip between distant points,
	-- which looked like the character "bouncing back" while waiting.
	local root = GetRoot()
	local cf, bd = nil, math.huge
	for _, t in ipairs(targets) do
		local d = root and (t.Position - root.Position).Magnitude or 0
		if d < bd then bd, cf = d, t end
	end
	if cf and bd > 20 then
		Tween:To(cf * (bd > 150 and CFrame.new(0, 65, 5) or CFrame.new(0, 30, 5)))
	end
	return true
end

