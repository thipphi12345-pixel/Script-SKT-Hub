-- Premium styling pass -------------------------------------------------------
-- Rounded window, accent edge glow, gradient title, section underline accents.
-- Wrapped in a function (not a do-block): locals in a do-block still count
-- against the top-level chunk's 200-register Luau limit.
;(function()
	local W = Window.Items
	local main = W.MainFrame and W.MainFrame.Instance
	local function corner(inst, r)
		if inst and not inst:FindFirstChildOfClass("UICorner") then
			local c = Instance.new("UICorner")
			c.CornerRadius = UDim.new(0, r)
			c.Parent = inst
		end
	end

	if main then
		corner(main, 8)
		local stroke = Instance.new("UIStroke")
		stroke.Thickness = 1
		stroke.Transparency = 0.35
		stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		stroke.Color = ACCENT
		stroke.Parent = main
		local sg = Instance.new("UIGradient")
		sg.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, ACCENT),
			ColorSequenceKeypoint.new(1, ACCENT2),
		})
		sg.Rotation = -45
		sg.Parent = stroke

		-- subtle depth gradient on the window background
		local bg = Instance.new("UIGradient")
		bg.Rotation = 90
		bg.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 255, 255)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(150, 160, 180)),
		})
		bg.Parent = main
	end

	if W.LeftTabs and W.LeftTabs.Instance then corner(W.LeftTabs.Instance, 8) end
	if W.Content and W.Content.Instance then corner(W.Content.Instance, 8) end

	-- Animated brand gradient (title, subtitle, logo tint, logo ring). The
	-- palette is cyclic, so scrolling it gives a seamless flowing shimmer.
	local PALETTE = {
		Color3.fromRGB(110, 235, 255),
		Color3.fromRGB(0, 150, 255),
		Color3.fromRGB(95, 105, 255),
		Color3.fromRGB(170, 110, 255),
		Color3.fromRGB(0, 190, 255),
	}
	local function paletteAt(u)
		u = u % 1 * #PALETTE
		local i = math.floor(u)
		local a, b = PALETTE[i + 1], PALETTE[(i + 1) % #PALETTE + 1]
		return a:Lerp(b, u - i)
	end
	local function scrolled(t, whiteMix)
		local kps = {}
		for k = 0, 6 do
			local c = paletteAt(k / 6 * 0.6 + t)
			if whiteMix then c = c:Lerp(Color3.new(1, 1, 1), whiteMix) end
			kps[#kps + 1] = ColorSequenceKeypoint.new(k / 6, c)
		end
		return ColorSequence.new(kps)
	end

	local grads = {}
	local title = W.Title and W.Title.Instance
	local sub0 = W.SubTitle and W.SubTitle.Instance
	-- make room for the logo ring so it doesn't touch the brand text
	for _, t in ipairs({ title, sub0 }) do
		if t then t.Position = t.Position + UDim2.fromOffset(7, 0) end
	end
	if title then
		title.FontFace = Font.new(title.FontFace.Family, Enum.FontWeight.Bold)
		title.TextColor3 = Color3.new(1, 1, 1)
		local g = Instance.new("UIGradient")
		g.Parent = title
		grads[#grads + 1] = { g = g, speed = 0.12, mix = 0.1 }
		local glow = Instance.new("UIStroke")
		glow.Color = ACCENT
		glow.Thickness = 1
		glow.Transparency = 0.7
		glow.Parent = title
	end

	local sub = W.SubTitle and W.SubTitle.Instance
	if sub then
		sub.TextColor3 = Color3.new(1, 1, 1)
		local g = Instance.new("UIGradient")
		g.Parent = sub
		grads[#grads + 1] = { g = g, speed = 0.12, mix = 0.55, phase = 0.3 }
	end

	local logo = W.Logo and W.Logo.Instance
	local ring
	if logo then
		local lg = logo:FindFirstChildOfClass("UIGradient") or Instance.new("UIGradient", logo)
		lg.Rotation = -45
		grads[#grads + 1] = { g = lg, speed = 0.2, mix = 0.2 }

		local frame = Instance.new("Frame")
		frame.Name = "SKT_LogoRing"
		frame.AnchorPoint = Vector2.new(0.5, 0.5)
		frame.Position = UDim2.fromScale(0.5, 0.5)
		frame.Size = UDim2.new(1, 8, 1, 8)
		frame.BackgroundTransparency = 1
		frame.ZIndex = logo.ZIndex
		frame.Parent = logo
		local rc = Instance.new("UICorner")
		rc.CornerRadius = UDim.new(1, 0)
		rc.Parent = frame
		local rs = Instance.new("UIStroke")
		rs.Thickness = 1.6
		rs.Color = Color3.new(1, 1, 1)
		rs.Parent = frame
		ring = Instance.new("UIGradient")
		ring.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0),
			NumberSequenceKeypoint.new(0.45, 0.15),
			NumberSequenceKeypoint.new(0.75, 0.85),
			NumberSequenceKeypoint.new(1, 1),
		})
		ring.Parent = rs
	end

	if main and (#grads > 0 or ring) then
		local t, acc = 0, 0
		Conn(RunService.RenderStepped:Connect(function(dt)
			t = t + dt
			acc = acc + dt
			if acc < 1 / 30 or not main.Visible then return end
			acc = 0
			for _, e in ipairs(grads) do
				e.g.Color = scrolled(t * e.speed + (e.phase or 0), e.mix)
			end
			if ring then
				ring.Rotation = (t * 120) % 360
				ring.Color = scrolled(t * 0.2, 0.05)
			end
		end))
	end

	-- Clearly defined section panels: the library's glassy 0.65 transparency
	-- makes the boxes vanish on dark backdrops, so rows look like they float
	-- outside their section.
	for _, entry in ipairs(Library.ThemeItems) do
		local p = entry.Properties and entry.Properties.BackgroundColor3
		local item = entry.Item
		if typeof(item) == "Instance" and item:IsA("GuiObject") then
			if p == "Section Background" and item.BackgroundTransparency > 0.3 then
				item.BackgroundTransparency = 0.3
			elseif p == "Section Top" and item.BackgroundTransparency > 0.25 then
				item.BackgroundTransparency = 0.25
			end
		end
	end

	-- accent underline beneath each section header ("Section Top" items)
	for _, entry in ipairs(Library.ThemeItems) do
		if entry.Properties and entry.Properties.BackgroundColor3 == "Section Top"
			and typeof(entry.Item) == "Instance" and entry.Item:IsA("GuiObject") then
			local header = entry.Item.Parent -- the Outline-colored "Top" strip
			if header and not header:FindFirstChild("SKT_AccentLine") then
				local line = Instance.new("Frame")
				line.Name = "SKT_AccentLine"
				line.AnchorPoint = Vector2.new(0, 1)
				line.Position = UDim2.new(0, 0, 1, 0)
				line.Size = UDim2.new(1, 0, 0, 2)
				line.BorderSizePixel = 0
				line.BackgroundColor3 = ACCENT
				line.ZIndex = header.ZIndex + 1
				line.Parent = header
				local lg = Instance.new("UIGradient")
				lg.Rotation = 0
				lg.Color = ColorSequence.new({
					ColorSequenceKeypoint.new(0, ACCENT),
					ColorSequenceKeypoint.new(0.6, ACCENT2),
					ColorSequenceKeypoint.new(1, Color3.fromRGB(20, 22, 30)),
				})
				lg.Parent = line
			end
		end
	end
end)()

-- Outline every "Element"-themed control (checkboxes, buttons, sliders,
-- dropdown boxes) so the interactive boxes are easy to see.
do
	local strokeColor = Color3.fromRGB(70, 82, 115)
	for _, entry in ipairs(Library.ThemeItems) do
		local item = entry.Item
		if entry.Properties
			and entry.Properties.BackgroundColor3 == "Element"
			and typeof(item) == "Instance" and item:IsA("GuiObject")
			and item.AbsoluteSize.Y <= 60
			and not item:FindFirstChildOfClass("UIStroke") then
			local stroke = Instance.new("UIStroke")
			stroke.Color = strokeColor
			stroke.Thickness = 1
			stroke.Transparency = 0.25
			stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
			stroke.Parent = item
		end
	end
end

-- The sidebar is a plain Frame in this library, so pages overflow past the
-- window edge once there are many of them. Wrap its contents in a scrollable
-- frame so every tab stays reachable.
do
	local tabs = Window.Items and Window.Items.LeftTabs and Window.Items.LeftTabs.Instance
	if tabs then
		local scroller = Instance.new("ScrollingFrame")
		scroller.Name = "TabsScroller"
		scroller.BackgroundTransparency = 1
		scroller.BorderSizePixel = 0
		scroller.Size = UDim2.fromScale(1, 1)
		scroller.CanvasSize = UDim2.new()
		scroller.AutomaticCanvasSize = Enum.AutomaticSize.Y
		scroller.ScrollBarThickness = 2
		scroller.ScrollingDirection = Enum.ScrollingDirection.Y
		scroller.ClipsDescendants = true
		scroller.Parent = tabs
		for _, child in ipairs(tabs:GetChildren()) do
			if child ~= scroller then child.Parent = scroller end
		end
	end
end

Window:Init()
Notify(BRAND, "Loaded. Press Right Shift to toggle UI.", 5)
