------------------------------------------------------------------------
-- [5] Tween movement (BodyVelocity carrier + noclip + gate shortcuts)
------------------------------------------------------------------------
local Tween = { _ctrl = nil, _root = nil }

local function NewTweenController(root)
	local ctrl = { _collisions = {}, _tween = nil, _bv = nil }
	local baseVel = root.AssemblyLinearVelocity
	-- Anchored flight is NOT replicated to the server at all: the server
	-- keeps our position wherever the anchor engaged and rejects every
	-- melee hit -- AND it does not even prevent rubber-bands, since the
	-- game's server-side shadow position trails at sea level and asserts
	-- itself mid-flight regardless (verified live: a 3854-stud revert
	-- fired while anchored). The only movement the server actually
	-- tolerates is unanchored physics below ~150 studs/s, which is the
	-- speed cap enforced in Tween:To.
	ctrl._wasAnchored = root.Anchored

	for _, d in ipairs(root.Parent:GetDescendants()) do
		if d:IsA("BasePart") then
			ctrl._collisions[d] = d.CanCollide
			d.CanCollide = false
		end
	end

	root.AssemblyLinearVelocity = Vector3.zero
	root.AssemblyAngularVelocity = Vector3.zero

	local bv = Instance.new("BodyVelocity")
	bv.MaxForce = Vector3.new(4000, 4000, 4000)
	bv.Velocity = Vector3.zero
	bv.Parent = root
	ctrl._bv = bv

	-- Very long tweens still pause briefly every few thousand studs as a
	-- safety flush for any residual server/client drift. The real fix for
	-- the "arrive, stop, warp back" is the speed cap in Tween:To -- the
	-- server cannot track ~300 studs/s and reverts to its trailing
	-- position the moment the tween releases.
	local HOP_DIST, HOP_SETTLE = 2500, 0.6
	local hopping = false

	function ctrl:Move(cf, speed)
		-- Skip re-issuing while the destination is essentially unchanged;
		-- restarting the tween every frame was a source of jitter. Refresh
		-- the post-arrival hold so an active caller keeps the pin alive.
		if self._dest and self._speed == speed
			and (self._dest - cf.Position).Magnitude <= 4 then
			self._holdUntil = tick() + 1.2
			return
		end
		self._dest = cf.Position
		self._destCF = cf
		self._speed = speed
		self._holdUntil = nil
		self._holdGen = (self._holdGen or 0) + 1
		self:_leg()
	end

	function ctrl:_leg()
		if self._tween then self._tween:Cancel() end
		local dest, speed = self._dest, self._speed
		local dist = (dest - root.Position).Magnitude
		local legCF = self._destCF or CFrame.new(dest)
		if dist > HOP_DIST then
			hopping = true
			legCF = CFrame.new(root.Position + (dest - root.Position).Unit * HOP_DIST)
			dist = HOP_DIST
		else
			hopping = false
		end
		local dur = math.max(0.05, dist / math.max(speed, 1))
		-- The zero-velocity carrier damps physics while the CFrame tween does
		-- the actual moving. Pushing real velocity here makes the server's
		-- physics disagree with the tweened CFrame and it snaps us back.
		-- (MaxForce is raised to math.huge while holding at the destination;
		-- restore it whenever a new leg starts.)
		-- The game strips BodyVelocity off the character, so the carrier can
		-- vanish mid-flight. Recreate it whenever that happens.
		if not self._bv or not self._bv.Parent then
			local nbv = Instance.new("BodyVelocity")
			nbv.MaxForce = Vector3.new(4000, 4000, 4000)
			nbv.Velocity = Vector3.zero
			nbv.Parent = root
			self._bv = nbv
		end
		self._bv.MaxForce = Vector3.new(4000, 4000, 4000)
		self._bv.Velocity = Vector3.zero
		self._tween = TweenService:Create(root, TweenInfo.new(dur, Enum.EasingStyle.Linear), { CFrame = legCF })
		local tw = self._tween
		tw.Completed:Connect(function(state)
			if self._tween ~= tw then return end
			if state ~= Enum.PlaybackState.Completed then
				if self._bv then self._bv.Velocity = Vector3.zero end
				return
			end
			if not hopping then
				-- Arrived: keep the carrier pinning us briefly. Releasing the
				-- moment the tween ends lets gravity pull the character down
				-- before the caller re-issues -- a visible sink-and-yank loop.
				-- Callers that keep tweening refresh the hold via Move(); when
				-- nobody asks for this spot anymore it expires and we land.
				-- Pin the CFrame every frame: the game's anti-exploit strips
				-- BodyVelocity off the character, so a carrier-only hold lets
				-- gravity drop us between farm re-issues (the "keeps falling"
				-- loop). Rewriting CFrame survives the strip.
				if self._bv then
					self._bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
					self._bv.Velocity = Vector3.zero
				end
				self._holdUntil = tick() + 1.2
				local hg = (self._holdGen or 0) + 1
				self._holdGen = hg
				task.spawn(function()
					while Tween._ctrl == self and self._holdGen == hg
						and tick() < (self._holdUntil or 0) do
						if self._destCF and root.Parent then
							pcall(function()
								root.CFrame = self._destCF
								root.AssemblyLinearVelocity = Vector3.zero
							end)
						end
						task.wait()
					end
					if Tween._ctrl == self and self._holdGen == hg then
						Tween:Stop()
					end
				end)
				return
			end
			-- Settle briefly so the server accepts this hop, then continue
			-- to the next leg toward the same final destination. Extend the
			-- hold so the sweeper doesn't reclaim the carrier mid-hop, and pin
			-- the CFrame while paused since the BodyVelocity may be stripped.
			self._holdUntil = tick() + HOP_SETTLE + 0.5
			local d = self._dest
			task.spawn(function()
				local settleEnd = tick() + HOP_SETTLE
				while Tween._ctrl == self and self._dest == d
					and self._tween == tw and tick() < settleEnd do
					pcall(function()
						root.CFrame = legCF
						root.AssemblyLinearVelocity = Vector3.zero
					end)
					task.wait()
				end
				if Tween._ctrl == self and self._dest == d and self._tween == tw then
					self:_leg()
				end
			end)
		end)
		self._tween:Play()
	end

	function ctrl:Destroy()
		if self._tween then self._tween:Cancel() end
		if self._bv then self._bv:Destroy() end
		self._dest = nil
		self._destCF = nil
		for part, canCollide in pairs(self._collisions) do
			if part and part.Parent then part.CanCollide = canCollide end
		end
		if root.Parent then
			root.Anchored = ctrl._wasAnchored == true
			root.AssemblyLinearVelocity = baseVel
			root.AssemblyAngularVelocity = Vector3.zero
		end
	end

	return ctrl
end

-- NOTE: Data.EntranceGates are sea-transition portals (e.g. the Mansion
-- portal room), NOT intra-sea shortcuts. Routing normal tweens through
-- them fired requestEntrance mid-journey and the character was thrown
-- into the portal room ~3500 studs off course, then the farm loop flew
-- back, clipped the same gate, and ping-ponged forever. Gates are only
-- useful for real sea transitions, so Tween:To does not use them.

Tween._gating = false

function Tween:To(cf, speed)
	local root = GetRoot()
	if not root then return end
	speed = tonumber(speed) or tonumber(Cfg("TweenSpeed", 200)) or 200
	-- Hard ceiling: the server only tracks roughly ~150-200 studs/s of
	-- character movement. Faster tweens look fine client-side, but the
	-- server keeps a trailing shadow position and snaps the character
	-- back to it -- typically the moment the tween releases, sometimes
	-- mid-flight. Measured live: 150 clean, 200 mostly clean, 220+
	-- reverts often enough to matter, 300 reverts every trip.
	if speed > 200 then speed = 200 end

	-- Submarine rides seat the character on the server and keep re-placing it
	-- inside the moving submarine every tick until the ride finishes and the
	-- character disembarks. Tweening while the ride runs just fights that
	-- placement -- the server wins each tick and the character visibly
	-- rubber-bands back to the dock. Sit/SeatPart can read false between
	-- corrections, so also watch for the server moving us without a tween:
	-- any jump >50 studs while we aren't issuing movement extends the hold
	-- until the position has been stable for 2s. Hard cap in case the ride
	-- never engages.
	if self._submarineUntil then
		if tick() >= self._submarineUntil then
			self._submarineUntil = nil
			self._subLastPos = nil
			self._subMovedAt = nil
		else
			local hum = GetHuman()
			local riding = (hum and (hum.Sit or hum.SeatPart ~= nil)) or root.Anchored
			-- Seat state only proves boarding during the ride's first few
			-- seconds; after that the ride's own drift events carry the hold.
			-- Otherwise sitting on a normal seat (boats, chairs) would wedge
			-- the tween for the full hold window.
			if riding and tick() > self._submarineMin + 10 then
				riding = false
			end
			local p = root.Position
			if self._subLastPos and (p - self._subLastPos).Magnitude > 50 then
				self._subMovedAt = tick()
			end
			self._subLastPos = p
			local stillHeld = riding
				or tick() < self._submarineMin
				or (self._subMovedAt and tick() - self._subMovedAt < 2)
			-- Escape hatch for a wedged ride: if the server has kept us for a
			-- while already, LeaveAbnormally is the game's own reset for an
			-- abnormal submarine state -- fire it once and keep waiting.
			if stillHeld and self._subHeldSince
				and tick() - self._subHeldSince > 10
				and (not self._leaveFiredAt or tick() - self._leaveFiredAt > 5) then
				self._leaveFiredAt = tick()
				pcall(function()
					Net["RF/SubmarineTransportation"]:InvokeServer("LeaveAbnormally")
				end)
			end
			if stillHeld then
				return
			end
			self._submarineUntil = nil
			self._subLastPos = nil
			self._subMovedAt = nil
		end
	end

	-- Catch server-side teleports that happen outside the tracked ride
	-- window (a ride that overruns, portal pads, spawn corrections). If the
	-- character jumped >400 studs between calls while the tween never
	-- covered that distance, something else moved us -- pause and let the
	-- ride-watch logic above hold until the corrections stop.
	local now = tick()
	if self._seenPos and self._seenAt and now - self._seenAt < 1
		and (root.Position - self._seenPos).Magnitude > 400 then
		self._submarineMin = now + 2
		self._submarineUntil = now + 90
		self._subMovedAt = now
		self._subLastPos = nil
		self._subHeldSince = now
		return
	end
	self._seenPos = root.Position
	self._seenAt = now

	-- Submerged Island tunnels (Third Sea). "Inside" must test depth too:
	-- hovering at cruise altitude directly above the buried island is only
	-- ~2000 studs away in 3D and used to read as inside -> the exit branch
	-- kept firing LeaveAbnormally (which returns false from outside) and
	-- stopping the tween forever, freezing the character mid-air.
	local SUB = Vector3.new(10213.701, -1733.5026, 9940.189)
	local function InSubmerged()
		local p = root.Position
		if p.Y > -500 then return false end
		local dx, dz = p.X - SUB.X, p.Z - SUB.Z
		return dx * dx + dz * dz <= 3500 * 3500
	end
	if (SUB - cf.Position).Magnitude <= 3500 and not InSubmerged() then
		if Util.Dist(Vector3.new(-16267, 25, 1371)) > 5 then
			self:_issue(CFrame.new(-16267, 25, 1371), speed)
		else
			pcall(function()
				Net["RF/SubmarineWorkerSpeak"]:InvokeServer("TravelToSubmergedIsland")
			end)
			self:Stop()
			self._submarineMin = tick() + 5
			self._submarineUntil = tick() + 90
			self._subLastPos = nil
			self._subMovedAt = tick()
			self._subHeldSince = tick()
		end
		return
	end
	-- Position-based, not attribute-based: sub-areas inside the island (e.g.
	-- "Sealed Cavern") report a different CurrentLocation, so an attribute
	-- check falls through to a direct tween and the sealed area's server
	-- validation keeps snapping the character back.
	--
	-- LeaveAbnormally is the game's own instant escape: it drops the
	-- character at Tiki Outpost with NO submarine ride. InitiateTeleport
	-- runs the full ride, during which the server keeps re-seating the
	-- character aboard the submarine -- every attempted tween just fights
	-- the placement and rubber-bands back to the dock (possibly forever).
	if InSubmerged() and (SUB - cf.Position).Magnitude > 3500 then
		if not self._leaveFiredAt or tick() - self._leaveFiredAt > 3 then
			self._leaveFiredAt = tick()
			pcall(function()
				Net["RF/SubmarineTransportation"]:InvokeServer("LeaveAbnormally")
			end)
			self:Stop()
		end
		return
	end

	-- Cruise altitude: flying low across open water skims dock/portal trigger
	-- pads (they check distance, not Touched -- CanTouch=false doesn't help) and
	-- the server snaps the character back to the previous island's dock.
	-- Decide by HORIZONTAL distance, not 3D: a sea-level target thousands of
	-- studs away otherwise makes the whole trip a shallow descent that skims
	-- the water the entire way. Fly level at cruise height until nearly over
	-- the target, then descend in the final approach.
	local out = cf
	local dx, dz = cf.Position.X - root.Position.X, cf.Position.Z - root.Position.Z
	if dx * dx + dz * dz > 400 * 400 then
		-- NOTE: never include root.Position.Y here -- feeding the current
		-- altitude back into the cruise target makes each re-issue climb
		-- higher than the last, so the character ratchets upward forever.
		-- Deep targets (Submerged Island sits near Y=-2000): dive straight
		-- to the destination depth instead of climbing to the surface band
		-- and diving back down.
		local cruiseY = cf.Position.Y < -100
			and cf.Position.Y + 30
			or math.max(cf.Position.Y + 30, 150)
		out = CFrame.new(cf.Position.X, cruiseY, cf.Position.Z)
	end

	self:_issue(out, speed)
end

function Tween:_issue(cf, speed)
	local root = GetRoot()
	if not root then return end
	if self._ctrl and self._root ~= root then
		pcall(function() self._ctrl:Destroy() end)
		self._ctrl = nil
	end
	if not self._ctrl then
		self._ctrl = NewTweenController(root)
		self._root = root
	end
	self._ctrl:Move(cf, speed)
end

function Tween:Stop()
	if self._ctrl then
		pcall(function() self._ctrl:Destroy() end)
		self._ctrl = nil
		self._root = nil
	end
	self._usedGate = nil
	self._usedGateTarget = nil
end

