-- Lightweight tab switching. The library's Page:Turn fades EVERY descendant of
-- the page with its own tween (thousands of tweens + connections per click),
-- which froze the game for 120-190ms on each tab change. Swap pages directly
-- and animate only the page frame and the tab highlight instead.
;(function()
	local content = Window.Items and Window.Items.Content and Window.Items.Content.Instance
	if not (content and Window.Pages) then return end
	local fast = TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	local slide = TweenInfo.new(0.25, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
	for _, page in ipairs(Window.Pages) do
		local items = page.Items
		local frame = items and items.Page and items.Page.Instance
		local tab = items and items.Inactive and items.Inactive.Instance
		if frame and tab then
			page._sktRevealed = page.Active
			page.Turn = function(self, on)
				self.Active = on
				frame.Visible = on
				frame.Parent = on and content or Library.UnusedHolder.Instance
				TweenService:Create(tab, fast, { BackgroundTransparency = on and 0.25 or 1 }):Play()
				if not on then return end
				frame.Position = UDim2.fromOffset(0, 14)
				TweenService:Create(frame, slide, { Position = UDim2.new() }):Play()
				-- Rows start offset until their page is first shown; reveal once.
				if not self._sktRevealed then
					self._sktRevealed = true
					for _, sec in pairs(self.Sections) do
						task.spawn(function() pcall(sec.TweenElements, sec, true, true) end)
					end
				end
			end
		end
	end
end)()

