local Combat = { DodgeUntil = 0 }

-- Character respawn: drop any stale controller/attachments bound to the old body
Conn(LP.CharacterAdded:Connect(function(char)
	Tween:Stop()
	Combat.AimTarget = nil
	char:WaitForChild("HumanoidRootPart", 10)
end))

local HIT_ID = tostring(LP.UserId):sub(2, 4) .. "078da"

-- Fallback coroutine: replays RegisterHit ourselves
local HitThread = coroutine.create(function()
	pcall(function() RE.RegisterHit:FireServer(HIT_ID) end)
	while Alive() do
		local head, hits = coroutine.yield()
		pcall(function() RE.RegisterHit:FireServer(head, hits, nil, HIT_ID) end)
	end
end)
coroutine.resume(HitThread)

-- Prefer the game's own SendHitsToServer coroutine (saner behaviour).
-- The search itself (require + getupvalues) used to run on every attack --
-- i.e. every frame with FastAttack delay 0. The thread is cached now and
-- only re-searched when it dies.
local CachedHitThread = nil
local function FindHitThread()
	local ok, t = pcall(function()
		local g = RS:FindFirstChild("Global")
		if not g then return nil end
		for _, v in ipairs(getupvalues(require(g).SendHitsToServer)) do
			if type(v) == "thread" and coroutine.status(v) ~= "dead" then return v end
		end
	end)
	return ok and t or nil
end

local function HitThread_Get()
	if CachedHitThread and coroutine.status(CachedHitThread) ~= "dead" then
		return CachedHitThread
	end
	CachedHitThread = FindHitThread()
	return CachedHitThread or HitThread
end

function Combat:GetHits(range)
	local hits = {}
	local root = GetRoot()
	if not root then return hits end
	local me = GetChar()
	for _, list in ipairs({ EnemyList, CharList }) do
		for _, m in ipairs(list) do
			if m ~= me then
				local h, hrp, head = EntParts(m)
				if h and hrp and h.Health > 0
					and (hrp.Position - root.Position).Magnitude <= range then
					table.insert(hits, { m, head or hrp })
				end
			end
		end
	end
	return hits
end

local M1 = { last = 0, streak = 0 }
local function FruitM1(tool)
	local now = tick()
	M1.streak = (now - M1.last <= 0.4) and math.min(M1.streak + 1, 4) or 1
	M1.last = now
	local root = GetRoot()
	if not root then return end
	for _, mob in ipairs(EnemyList) do
		local hrp = mob and mob.PrimaryPart
		if hrp and Util.IsAlive(mob) and (hrp.Position - root.Position).Magnitude <= 50 then
			tool.LeftClickRemote:FireServer((hrp.Position - root.Position).Unit, M1.streak)
		end
	end
end

function Combat:AttackOnce()
	local char = GetChar()
	local tool = char and char:FindFirstChildOfClass("Tool")
	if not tool then return end
	local tip = tool.ToolTip

	if tip == "Blox Fruit" and tool:FindFirstChild("LeftClickRemote") then
		FruitM1(tool)
		return
	end

	if tip == "Gun" then
		local target = self.AimTarget
		if target and target.Parent then
			local root = GetRoot()
			pcall(function()
				RE.ShootGun:FireServer((target.Position - root.Position).Unit)
				if tool:FindFirstChild("RemoteEvent") then
					tool.RemoteEvent:FireServer(target.Position)
				end
			end)
		end
		return
	end

	if not table.find({ "Melee", "Sword", "Blox Fruit", "Gun" }, tip) then return end

	local hits = self:GetHits(60)
	if #hits == 0 then return end

	RE.RegisterAttack:FireServer(0)
	local head = table.remove(hits, 1)[2]
	local t = HitThread_Get()
	if t then
		coroutine.resume(t, head, hits)
	else
		RE.RegisterHit:FireServer(head, hits, nil, HIT_ID)
	end
end

function Combat:EnableSimulationRadius()
	pcall(function()
		sethiddenproperty(LP, "SimulationRadius", math.huge)
		sethiddenproperty(LP, "MaxSimulationRadius", math.huge)
	end)
end

local NO_BRING = { Shark = true, Piranha = true, Terrorshark = true }

-- Pin state per gathered mob. Part lists are cached once per model (calling
-- GetDescendants for every gathered mob every frame was pure GC churn), and
-- the mob's original collision/state is restored when we stop pinning it.
-- Releasing a mob with CanCollide still off left it unable to stand --
-- gravity pulled it through the floor, i.e. the "mobs fall through the map"
-- report.
local BringState = setmetatable({}, { __mode = "k" })

local function ReleaseBrought(v, st)
	for p, o in pairs(st.orig) do
		pcall(function()
			p.CanCollide, p.CanTouch = o[1], o[2]
		end)
	end
	local h = v.Parent and v:FindFirstChildOfClass("Humanoid")
	if h then
		pcall(function()
			h.AutoRotate = st.auto
			if h.Health > 0 then h:ChangeState(Enum.HumanoidStateType.GettingUp) end
		end)
	end
	BringState[v] = nil
end

task.spawn(function()
	while Alive() do
		task.wait(0.25)
		for v, st in pairs(BringState) do
			if not v.Parent or tick() - (st.t or 0) > 0.6 then
				ReleaseBrought(v, st)
			end
		end
	end
end)

function Combat:BringMob(mob, cf)
	if not Cfg("BringMob", true) then return end
	if not (mob and mob.Parent and cf) then return end
	self:EnableSimulationRadius()

	local radius = tonumber(Cfg("BringMobRadius", 300)) or 300
	local r2 = radius * radius
	local dest = cf.Position

	for _, v in ipairs(EnemyList) do
		if v and v.Name == mob.Name and not NO_BRING[v.Name] then
			local h, hrp = EntParts(v)
			if h and hrp and v:FindFirstChild("CharacterReady") and h.Health > 0
				and hrp:IsDescendantOf(workspace) then
				local d = hrp.Position - dest
				if d.X * d.X + d.Y * d.Y + d.Z * d.Z <= r2 then
					local st = BringState[v]
					if not st then
						st = { parts = {}, orig = {}, auto = h.AutoRotate, t = 0 }
						for _, p in ipairs(v:GetDescendants()) do
							if p:IsA("BasePart") then
								st.orig[p] = { p.CanCollide, p.CanTouch }
								table.insert(st.parts, p)
							end
						end
						BringState[v] = st
					end
					for _, p in ipairs(st.parts) do
						if p.Parent then
							p.CanCollide = false
							p.CanTouch = false
							p.AssemblyLinearVelocity = Vector3.zero
							p.AssemblyAngularVelocity = Vector3.zero
						end
					end
					h.AutoRotate = false
					pcall(function() h:ChangeState(Enum.HumanoidStateType.Physics) end)
					st.t = tick()
					hrp.CFrame = cf + Vector3.new(
						math.random(-20, 20) / 100, 0,
						math.random(-20, 20) / 100)
				end
			end
		end
	end
end

-- Aim redirect: point RemoteEvent(Vector3) skill shots at current target
local AimPart = nil
local AimPos = Vector3.zero
local AimStamp = 0
Combat.AimTarget = nil

function Combat:SetAim(part)
	if not part then AimPart = nil return end
	local ok, Mouse = pcall(require, RS:FindFirstChild("Mouse"))
	if ok and Mouse then
		pcall(function()
			Mouse.Hit = CFrame.new(part.Position)
			Mouse.Target = part
		end)
	end
	AimPart = part
	AimPos = part.Position
	AimStamp = tick()
	self.AimTarget = part
end

task.spawn(function()
	local ok, err = pcall(function()
		local mt = getrawmetatable(game)
		local namecall, index, newindex = mt.__namecall, mt.__index, mt.__newindex
		setreadonly(mt, false)

		local function aimActive()
			return AimPart and tick() - AimStamp < 5
		end
		local function aimPos()
			if tick() - AimStamp > 0.1 and AimPart then
				AimPos = AimPart.Position
				AimStamp = tick()
			end
			return AimPos
		end

		mt.__namecall = function(self, a, b, ...)
			local method = getnamecallmethod():lower()
			if tostring(self) == "RemoteEvent" and aimActive() then
				if method == "fireserver" and typeof(a) == "Vector3" then
					local p = aimPos()
					if p ~= Vector3.zero then return namecall(self, p, b, ...) end
				elseif method == "invokeserver"
					and table.find({ "Z", "X", "C", "V", "F" }, a)
					and typeof(b) == "Vector3" then
					local p = aimPos()
					if p ~= Vector3.zero then return namecall(self, a, p, ...) end
				end
			end
			return namecall(self, a, b, ...)
		end

		mt.__index = function(self, k)
			if k == "Part_Aim" and aimActive() then return AimPart end
			return index(self, k)
		end

		mt.__newindex = function(self, k, v)
			if k == "Part_Aim" and v == nil then
				AimPart = nil
				AimPos = Vector3.zero
				return
			end
			return newindex(self, k, v)
		end

		setreadonly(mt, true)
	end)
	if not ok then warn("[SKT] aim hook unavailable:", err) end
end)

-- Dodge: fly up while an enemy cast animation is playing
local DODGE_ANIMS = {
	["rbxassetid://9802959564"] = true,
	["rbxassetid://507766388"] = true,
	["http://www.roblox.com/asset/?id=9884584522"] = true,
}
local DodgeWatched = setmetatable({}, { __mode = "k" })

function Combat:WatchSkills(mob)
	if not mob or DodgeWatched[mob] then return end
	local animator = mob:FindFirstChildOfClass("Humanoid")
	animator = animator and animator:FindFirstChildOfClass("Animator")
	if not animator then return end
	DodgeWatched[mob] = true
	Conn(animator.AnimationPlayed:Connect(function(track)
		if not (track and track.Animation) then return end
		if DODGE_ANIMS[track.Animation.AnimationId] then return end
		if not Cfg("AutoDodgeSkill", false) then return end
		local dur = math.max(track.TimePosition or 1.5, 1.5)
		if tick() < self.DodgeUntil then
			self.DodgeUntil = self.DodgeUntil + math.floor(dur)
		else
			self.DodgeUntil = tick() + math.floor(dur)
		end
	end))
end

