local ESP = { Registry = {} } -- flag -> { [instance] = {folder, conn} }

function ESP:Attach(inst, flag)
	if not inst or not inst.Parent then return end
	local part = inst:IsA("BasePart") and inst
		or inst:IsA("Model") and (inst.PrimaryPart or inst:FindFirstChildWhichIsA("BasePart"))
	if not part or part:FindFirstChild("SKT_ESP") then return end

	local box = Instance.new("BoxHandleAdornment")
	box.Name = "SKT_ESP"
	box.AlwaysOnTop = true
	box.ZIndex = 10
	box.Transparency = 0.5
	box.Size = inst:IsA("Model") and inst:GetExtentsSize() or part.Size
	box.Color3 = Cfg(flag .. "Color", Color3.fromRGB(255, 255, 255))
	box.Adornee = part
	box.Parent = part

	local bb = Instance.new("BillboardGui")
	bb.Adornee = part
	bb.Size = UDim2.new(0, 200, 0, 40)
	bb.StudsOffset = Vector3.new(0, 3, 0)
	bb.AlwaysOnTop = true
	bb.Parent = box

	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.new(1, 0, 1, 0)
	label.TextColor3 = box.Color3
	label.TextStrokeTransparency = 0
	label.Font = Enum.Font.GothamBold
	label.TextSize = 10
	label.Text = inst.Name
	label.Parent = bb

	local conn = RunService.Heartbeat:Connect(function()
		local root = GetRoot()
		if not (root and part.Parent) then return end
		local dist = math.floor((root.Position - part.Position).Magnitude / 3)
		local h = inst:FindFirstChildOfClass("Humanoid")
		label.Text = h and string.format("%s\nHP %d | %dm", inst.Name, math.floor(h.Health), dist)
			or string.format("%s | %dm", inst.Name, dist)
	end)

	self.Registry[flag] = self.Registry[flag] or {}
	self.Registry[flag][inst] = { box = box, conn = conn }
end

function ESP:Clear(flag)
	local set = self.Registry[flag]
	if not set then return end
	for inst, rec in pairs(set) do
		if rec.conn then rec.conn:Disconnect() end
		if rec.box and rec.box.Parent then rec.box:Destroy() end
		set[inst] = nil
	end
end

function ESP:Apply(flag, iterator)
	if not Cfg(flag, false) then self:Clear(flag) return end
	for _, inst in ipairs(iterator()) do
		if not self.Registry[flag] or not self.Registry[flag][inst] then
			self:Attach(inst, flag)
		end
	end
end

