-- Leak sweep: if an older copy died before registering Unload, its ScreenGuis
-- and keybind listeners stay alive forever -- skill keys (Z/X/C/...) then keep
-- toggling a ghost window over ours. Destroy tagged GUIs and neuter every
-- leftover MenuBind so no stale listener can fire.
pcall(function()
	for _, g in ipairs(gethui():GetChildren()) do
		if g:IsA("ScreenGui") and g.Name == "SKT_HUB_GUI" then
			g:Destroy()
		end
	end
end)
pcall(function()
	local gc = getgc or (debug and debug.getgc)
	if not gc then return end
	for _, v in ipairs(gc(true)) do
		if type(v) == "table" and rawget(v, "Flag") == "MenuBind"
			and rawget(v, "Key") ~= nil then
			rawset(v, "Key", "Enum.KeyCode.Unknown")
		end
	end
end)

