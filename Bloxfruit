local Util = {}

local function GetChar()  return LP.Character end
local function GetRoot()  local c = LP.Character return c and c:FindFirstChild("HumanoidRootPart") end
local function GetHuman() local c = LP.Character return c and c:FindFirstChildOfClass("Humanoid") end

function Util.IsAlive(model)
	local h = model and EntParts(model)
	return h ~= nil and h.Health > 0
end

function Util.Dist(pos)
	local root = GetRoot()
	if not root then return math.huge end
	local p = typeof(pos) == "CFrame" and pos.Position
		or typeof(pos) == "Vector3" and pos
		or typeof(pos) == "Instance" and pos.GetPivot and pos:GetPivot().Position
	return p and (root.Position - p).Magnitude or math.huge
end

function Util.Remote(...)
	local ok, res = pcall(CommF.InvokeServer, CommF, ...)
	if ok then return res end
end

-- "Bandit [Lv. 5]" -> "Bandit"   |   compact: "Reborn Skeleton [Lv. 1975]" -> "RebornSkeleton"
local function StripTag(n) return (n:match("^(.-)%s*%[") or n):gsub("%s+$", "") end
local function CompactName(n) return (n:gsub("Lv%.", ""):gsub("[%[%] %d]", ""):gsub("%s+", "")) end

local NameCache = {}
local function EnemyMatch(name, set)
	local cached = NameCache[name]
	if not cached then
		cached = StripTag(name)
		NameCache[name] = cached
	end
	return set[name] or set[cached] or set[CompactName(name)]
end

function Util.ToSet(list)
	local t = {}
	if type(list) == "string" then
		t[list] = true t[StripTag(list)] = true t[CompactName(list)] = true
	elseif type(list) == "table" then
		for _, n in ipairs(list) do t[n] = true t[StripTag(n)] = true t[CompactName(n)] = true end
	end
	return t
end

function Util.EquipTool(tool)
	local h = GetHuman()
	if h and tool and tool.Parent ~= GetChar() then h:EquipTool(tool) end
end

function Util.EquipByTip(tip)
	-- Farm loops call this every frame; skip the backpack scan when the
	-- right tool is already in hand.
	local c = GetChar()
	local held = c and c:FindFirstChildOfClass("Tool")
	if held and held.ToolTip == tip then return held end
	for _, t in ipairs(LP.Backpack:GetChildren()) do
		if t:IsA("Tool") and t.ToolTip == tip then Util.EquipTool(t) return t end
	end
end

function Util.EquipWeapon()
	return Util.EquipByTip(Cfg("WeaponTool", "Melee"))
end

function Util.HasTool(name)
	local c = GetChar()
	return (c and c:FindFirstChild(name) ~= nil) or LP.Backpack:FindFirstChild(name) ~= nil
end

function Util.FindToolByTip(tip)
	for _, holder in ipairs({ LP.Backpack, GetChar() }) do
		if holder then
			for _, t in ipairs(holder:GetChildren()) do
				if t:IsA("Tool") and t.ToolTip == tip then return t end
			end
		end
	end
end

