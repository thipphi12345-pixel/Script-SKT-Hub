local Feature = {}

function Feature.FarmLevel()
	if not Farm:Allowed("AutoFarmLevel") then return end
	local q = Quest:Info()
	if not (q and q.Mob) then return end
	local mobs = { q.Mob }
	local noQuest  = Cfg("NoQuestMode", false)
	local autoTake = Cfg("AutoTakeQuest", false)

	if noQuest and not autoTake then
		if Farm:FindEnemy(mobs) then Farm:Engage(mobs)
		else Farm:GotoSpawn(mobs) task.wait(1) end
	elseif autoTake and not noQuest then
		if Quest:IsActive() then
			if Farm:FindEnemy(mobs) then Farm:Engage(mobs)
			else Farm:GotoSpawn(mobs) task.wait(1) end
		else
			Quest:Start(q.Group, q.Index)
		end
	elseif Quest:IsActive() then
		if Farm:FindEnemy(mobs) then Farm:Engage(mobs)
		else Farm:GotoSpawn(mobs) task.wait(1) end
	elseif q.GiverCF then
		if Util.Dist(q.GiverCF) <= 5 then Quest:Start(q.Group, q.Index)
		else Tween:To(q.GiverCF) end
	end
end

function Feature.FarmNearest()
	if not Farm:Allowed("AutoFarmNearest") then return end
	local range = tonumber(Cfg("NearestRange", 0)) or math.huge
	if range <= 0 then range = math.huge end
	local root = GetRoot()
	if not root then return end
	local best, bd = nil, range
	for _, mob in ipairs(EnemyList) do
		if mob.PrimaryPart and Util.IsAlive(mob) then
			local d = (mob.PrimaryPart.Position - root.Position).Magnitude
			if d < bd then bd, best = d, mob end
		end
	end
	if best then Farm:Engage({ best.Name }) end
end

local MASTERY_SETS = {
	["Bone"]        = { "Reborn Skeleton", "Demonic Soul", "Living Zombie", "Possessed Mummy" },
	["Cake Prince"] = { "Baking Staff", "Head Baker", "Cake Guard", "Cookie Crafter" },
}

local function MasteryKill(mobNames, mode)
	local mob = Farm:FindEnemy(mobNames)
	if not mob then
		-- No target loaded nearby -- travel to its spawn point like
		-- FarmLevel does instead of idling forever.
		Farm:GotoSpawn(mobNames)
		task.wait(1)
		return
	end
	local hrp = mob.PrimaryPart
	if not hrp then return end
	local base = hrp.CFrame
	local threshold = tonumber(Cfg("MasteryHealth", 45)) or 45
	local skills = type(Cfg("MasterySkills")) == "table" and Cfg("MasterySkills") or {}
	local lastHp, lastDrop = math.huge, tick()

	while task.wait() and Alive() do
		if not (mob.Parent and Util.IsAlive(mob) and Cfg("AutoFarmMastery") and Cfg("MasteryMode", "Level") == mode) then
			break
		end
		local hp = mob.Humanoid.Health / mob.Humanoid.MaxHealth * 100
		if hp < lastHp then
			lastHp = hp
			lastDrop = tick()
		end
		if hp <= threshold then
			Util.EquipByTip(Cfg("MasteryWeapon", "Blox Fruit"))
			Combat:BringMob(mob, base)
			Combat:SetAim(hrp)
			Util.UseSkills(skills)
		else
			Util.EquipWeapon()
			Combat:BringMob(mob, base)
		end
		Util.ActivateHaki()
		if tick() - lastDrop > 3.5 then
			-- Hits not landing: server position likely diverged. Dive onto
			-- the mob to force both positions into melee range, then resume.
			lastDrop = tick()
			local root = GetRoot()
			if root then root.CFrame = hrp.CFrame * CFrame.new(0, 6, 0) end
		end
		Tween:To(base + Vector3.new(0, tonumber(Cfg("FarmDistance", 20)) or 20, 1))
	end
end

function Feature.FarmMastery()
	if not Farm:Allowed("AutoFarmMastery") then return end
	local mode = Cfg("MasteryMode", "Level")

	if mode == "Level" then
		local q = Quest:Info()
		if not (q and q.Mob) then return end
		if Quest:IsActive() then
			MasteryKill({ q.Mob }, "Level")
		elseif q.GiverCF then
			if Util.Dist(q.GiverCF) <= 5 then Quest:Start(q.Group, q.Index)
			else Tween:To(q.GiverCF) end
		end
	elseif MASTERY_SETS[mode] then
		MasteryKill(MASTERY_SETS[mode], mode)
	elseif mode == "Nearest" then
		local root = GetRoot()
		if not root then return end
		local best, bd = nil, 3500
		for _, mob in ipairs(EnemyList) do
			if mob.PrimaryPart and Util.IsAlive(mob) then
				local d = (mob.PrimaryPart.Position - root.Position).Magnitude
				if d < bd then bd, best = d, mob end
			end
		end
		if best then MasteryKill({ best.Name }, "Nearest") end
	end
end

function Feature.CollectChest()
	if not Farm:Allowed("AutoCollectChest") then return end
	if Cfg("ChestStopOnRare", false)
		and (Util.HasTool("God's Chalice") or Util.HasTool("Fist of Darkness")) then
		return
	end
	if not Util.IsAlive(GetChar()) then return end
	local root = GetRoot()
	if not root then return end

	local best, bd = nil, math.huge
	for _, c in ipairs(CollectionService:GetTagged("_ChestTagged")) do
		if not c:GetAttribute("IsDisabled") then
			local d = (c:GetPivot().Position - root.Position).Magnitude
			if d < bd then bd, best = d, c end
		end
	end

	if best then
