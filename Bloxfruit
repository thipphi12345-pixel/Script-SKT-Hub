local Loops = { _started = {} }
function Loops:Add(flag, fn, interval)
	if self._started[flag] then return end
	self._started[flag] = true
	task.spawn(function()
		while Alive() do
			if Cfg(flag, false) then
				local ok, err = pcall(fn)
				if not ok then warn(("[SKT][%s] %s"):format(flag, tostring(err))) end
			end
			task.wait(interval or 0)
		end
	end)
end

