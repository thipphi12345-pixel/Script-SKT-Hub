-- Live entity caches. Combat loops (GetHits, BringMob, FindEnemy, IsAlive)
-- scanned Enemies/Characters with GetChildren() + FindFirstChild on every
-- model every frame -- table allocs plus hundreds of child lookups per
-- second was a measurable FPS cost while farming. Lists are maintained by
-- ChildAdded/ChildRemoved instead; per-model components are cached once
-- (weak keys die with the model; nil fields retry until the model finishes
-- replicating).
local EntCache = setmetatable({}, { __mode = "k" })
local function EntParts(m)
	local e = EntCache[m]
	if not e then
		e = {
			h = m:FindFirstChildOfClass("Humanoid"),
			hrp = m:FindFirstChild("HumanoidRootPart"),
			head = m:FindFirstChild("Head"),
		}
		EntCache[m] = e
	elseif not e.hrp then
		e.h = e.h or m:FindFirstChildOfClass("Humanoid")
		e.hrp = m:FindFirstChild("HumanoidRootPart")
		e.head = e.head or m:FindFirstChild("Head")
	end
	return e.h, e.hrp, e.head
end

local EnemyList, CharList = {}, {}
local function TrackFolder(folder, list)
	for _, m in ipairs(folder:GetChildren()) do table.insert(list, m) end
	Conn(folder.ChildAdded:Connect(function(m) table.insert(list, m) end))
	Conn(folder.ChildRemoved:Connect(function(m)
		local i = table.find(list, m)
		if i then table.remove(list, i) end
	end))
end
