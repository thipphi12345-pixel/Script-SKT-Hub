local RaidIslandConn = nil
function Feature.AutoRaid()
	if not Farm:Allowed("AutoRaid") then return end
	local raidActive = false
	pcall(function()
		raidActive = PlayerGui.Main.TopHUDList.RaidTimer.Visible
	end)

	if not raidActive then
		if Refs.WorldOrigin:FindFirstChild("Island 1") then raidActive = true end
	end

	if not raidActive then
		if not Util.HasTool("Special Microchip") then return end
		local island = SEA == 3 and Refs.Map:FindFirstChild("Boat Castle") or Refs.Map:FindFirstChild("CircleIsland")
		local summon = island and island:FindFirstChild("RaidSummon2")
		if not summon then return end
		local main = summon:FindFirstChild("Button") and summon.Button:FindFirstChild("Main")
		local cd = main and main:FindFirstChild("ClickDetector")
		if cd and fireclickdetector then
			fireclickdetector(cd)
		else
			Tween:To(summon:GetPivot())
		end
		return
	end

	-- Raid running: move to the newest island and engage nearest enemies
	if not RaidIslandConn then
		RaidIslandConn = Conn(Refs.WorldOrigin.Locations.ChildAdded:Connect(function(child)
			if child:IsA("Part") and child.Name:match("^Island %d+$") then
				Tween:To(child.CFrame * CFrame.new(4, 40, 10))
			end
		end))
	end
	for i = 5, 1, -1 do
		local loc = Refs.WorldOrigin.Locations:FindFirstChild("Island " .. i)
		if loc then
			local cf = loc:IsA("Model") and loc:GetPivot()
				or (loc:IsA("BasePart") and loc.CFrame)
			if cf then Tween:To(cf * CFrame.new(4, 40, 10)) end
			break
		end
	end
	local root = GetRoot()
	local best, bestD = nil, math.huge
	if root then
		for _, mob in ipairs(EnemyList) do
			if mob.PrimaryPart and Util.IsAlive(mob) then
				local d = (mob.PrimaryPart.Position - root.Position).Magnitude
				if d < bestD then best, bestD = mob, d end
			end
		end
	end
	if best then Farm:Engage({ best.Name }) end
	pcall(function()
		Util.Remote("Awakener", "Check")
		Util.Remote("Awakener", "Awaken")
	end)
end

