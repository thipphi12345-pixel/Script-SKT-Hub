-- Auto Farm Sea: sail to the chosen danger zone and engage whatever spawns
function Feature.SeaFarm()
	if not Farm:Allowed("AutoFarmSea") then return end
	local char = GetChar()
	if not (char and Util.IsAlive(char)) then return end
	local boat = Util.GetPlayerBoat()
	local dest = Data.LevelSea[Cfg("DangerLevel", "6")]
	local shark = Cfg("Terrorshark") and Farm:FindEnemy({ "Terrorshark" }, 1000)
	local piranha = Cfg("AttackPiranha") and Farm:FindEnemy({ "Piranha" }, 1000)
	local sharkMob = Cfg("AttackShark") and Farm:FindEnemy({ "Shark" }, 1000)
	local crew = Cfg("AttackFishCrew") and Farm:FindEnemy({ "Fish Crew Member" }, 1000)
	local ghost = Cfg("AttackGhostShip") and Util.FindBoatEnemy({ "PirateGrandBrigade", "PirateBrigade", "FishBoat" }, 1000)
	local sbFolder = GetSeaBeasts()
	local sb1 = Cfg("AttackSeaBeasts") and sbFolder and sbFolder:FindFirstChild("SeaBeast1")

	if shark and boat then
		if not shark.PrimaryPart then return end
		if Cfg("DodgeTerrorshark") and shark.PrimaryPart.CFrame.Y > -3 then
			Tween:To(shark.PrimaryPart.CFrame * CFrame.new(0, 600, 0))
		else
			Farm:Engage({ "Terrorshark" })
		end
	elseif piranha and boat then
		Farm:Engage({ "Piranha" })
	elseif sharkMob and boat then
		Farm:Engage({ "Shark" })
	elseif crew and boat then
		Farm:Engage({ "Fish Crew Member" })
	elseif ghost and boat then
		local seat = ghost:FindFirstChild("VehicleSeat")
		local ghum = ghost:FindFirstChildOfClass("Humanoid") or ghost:FindFirstChild("Humanoid")
		if seat then
			while Alive() and Cfg("AttackGhostShip") and Cfg("AutoFarmSea")
				and ghost.Parent and seat.Parent
				and (not ghum or (ghum:IsA("Humanoid") and ghum.Health > 0)
					or (ghum:IsA("NumberValue") and ghum.Value > 0)) do
				task.wait()
				local h = GetHuman()
				local target = (h and h.Health <= 5000) and seat.CFrame * CFrame.new(0, 400, 0) or seat.CFrame
				Tween:To(target)
				if Util.Dist(seat.Position) <= 50 then
					Combat:SetAim(seat)
					SeaWeapon()
					Util.UseSkills(SeaSkills())
				end
			end
		end
	elseif sb1 and boat then
		local hrp = sb1:FindFirstChild("HumanoidRootPart")
		if hrp and Util.Dist(hrp.Position) <= 5000 then
			TweenToSeaBeast(sb1)
			if Util.Dist(hrp.Position) <= 800 then
				Combat:SetAim(hrp)
				SeaWeapon()
				Util.UseSkills(SeaSkills())
			end
		end
	elseif boat then
		local h = GetHuman()
		local seat = boat:FindFirstChild("VehicleSeat")
		if not (h and h.Sit) then
			if seat then Tween:To(seat.CFrame) end
		elseif dest and Util.Dist(dest.Position) > 15500 then
			Util.BoatTween(boat, dest * CFrame.new(0, 20, 0))
		elseif (Lighting.RainCorrection and Lighting.RainCorrection.Enabled and Cfg("DodgeRoughSea"))
			or (GetSeaBeasts() and GetSeaBeasts():FindFirstChild("SeaBeast1") and not Cfg("AttackSeaBeasts")) then
			local root = GetRoot()
			if root then Util.BoatTween(boat, root.CFrame * CFrame.new(-150, 20, 15)) end
		end
	else
		GetBoatOrBuy()
	end
end

