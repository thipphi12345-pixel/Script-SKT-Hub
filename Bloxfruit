-- Stack Farming priority table: { flag, hasWork() }. A task only blocks the
-- tasks below it when it is enabled AND hasWork() says there is something to
-- do right now -- an idle task yields to lower priorities instead of
-- starving them (this was the "Auto Farm doesn't work" bug).
local function Stack_AnyEnemy()
	for _, m in ipairs(EnemyList) do
		if Util.IsAlive(m) and m:FindFirstChild("HumanoidRootPart") then return true end
	end
	return false
end

local function Stack_SpawnKnown(names)
	local set = Util.ToSet(names)
	local function scan(container)
		for _, p in ipairs(container:GetChildren()) do
			if EnemyMatch(p.Name, set) then return true end
		end
		return false
	end
	local f = RS:FindFirstChild("FortBuilderReplicatedSpawnPositionsFolder")
	if f and scan(f) then return true end
	local sp = Refs.WorldOrigin:FindFirstChild("EnemySpawns")
	return sp ~= nil and scan(sp)
end

local function Stack_EnemyOrSpawn(names)
	return Farm:FindEnemy(names) ~= nil or Stack_SpawnKnown(names)
end

local function Stack_QuestMob()
	local ok, q = pcall(function() return Quest:Info() end)
	return ok and q ~= nil and q.Mob ~= nil and Stack_EnemyOrSpawn({ q.Mob })
end

