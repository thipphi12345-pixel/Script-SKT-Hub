-- Returns { Index, GiverCF, Mob, Group, LevelReq, MobClean }
function Quest:Info()
	local level = LP.Data.Level.Value
	local team = tostring(LP.Team)
	local index, giverCF, mob, group, req, mobClean

	if level >= 1 and level <= 9 then
		if team == "Marines" then
			index, group, mob, mobClean = 1, "MarineQuest", "Trainee", "Trainee"
			giverCF = CFrame.new(-2709.67944, 24.5206585, 2104.24585)
		else
			index, group, mob, mobClean = 1, "BanditQuest1", "Bandit", "Bandit"
			giverCF = CFrame.new(1059.99731, 16.9222069, 1549.28162)
		end
		req = 1
		return { Index = index, GiverCF = giverCF, Mob = mob, Group = group, LevelReq = req, MobClean = mobClean }
	end

	if level >= 210 and level <= 249 then
		return {
			Index = 2, Group = "PrisonerQuest",
			Mob = "Dangerous Prisoner", MobClean = "Dangerous Prisoner",
			LevelReq = 210, GiverCF = CFrame.new(5308.93115, 1.65517521, 475.120514),
		}
	end

	-- Closest matching quest giver by level from the live GuideModule data
	req = 0
	for npcPart, data in pairs(GuideModule.Data.NPCList) do
		for i, lvl in ipairs(data.Levels) do
			if level >= lvl and lvl > req then
				req = lvl
				index = (#data.Levels == 3 and i == 3) and 2 or i
				giverCF = typeof(npcPart) == "Instance" and npcPart.CFrame or nil
			end
		end
	end

	-- Cross-zone entrances inside Sea 1
	local root = GetRoot()
	if root and giverCF then
		local d = (giverCF.Position - root.Position).Magnitude
		if level >= 375 and level <= 449 and d > 3000 then
			Util.Remote("requestEntrance", Vector3.new(61163.85, 11.6797, 1819.7842))
		elseif level >= 450 and level <= 474 and d > 3000 then
			Util.Remote("requestEntrance", Vector3.new(-4607.8228, 872.5425, -1667.5569))
		elseif level >= 475 and level <= 624 and d > 5000 then
			Util.Remote("requestEntrance", Vector3.new(-7894.6177, 5547.1416, -380.2912))
		end
	end

	for groupName, list in pairs(QuestData) do
		if groupName ~= "CitizenQuest" then
			for i, q in pairs(list) do
				if q.LevelReq == req then
					group, index = groupName, i
					for taskKey in pairs(q.Task) do
						mob = taskKey
						mobClean = string.split(taskKey, " [Lv. " .. q.LevelReq .. "]")[1]
					end
				end
			end
		end
	end

	if group == "ImpelQuest" then
		group, index, mob, mobClean, req = "PrisonerQuest", 2, "Dangerous Prisoner", "Dangerous Prisoner", 210
		giverCF = CFrame.new(5310.60547, 0.350014925, 474.946594)
	elseif group == "Area2Quest" and index == 2 then
		index, mob, mobClean, req = 1, "Swan Pirate", "Swan Pirate", 775
	end

	if level >= 2500 and level <= 2524 then
		mob, mobClean = "Sun-kissed Warrior", "Sun-kissed Warriors"
	end

	return { Index = index, GiverCF = giverCF, Mob = mob, Group = group, LevelReq = req, MobClean = mobClean }
end

