-- Hostile NPC boats (Ghost Ship, FishBoat, pirate brigades) spawn inside the
-- Enemies folder as models with a VehicleSeat + Humanoid. Searching there
-- (not workspace.Boats) also guarantees we never match the player's own boat.
function Util.FindBoatEnemy(names, maxDist)
	local root = GetRoot()
	if not root then return nil end
	local set = Util.ToSet(names)
	local best, bestD2 = nil, maxDist and maxDist * maxDist or math.huge
	for _, mob in ipairs(EnemyList) do
		if EnemyMatch(mob.Name, set) then
			local seat = mob:FindFirstChild("VehicleSeat")
			local hum = mob:FindFirstChildOfClass("Humanoid") or mob:FindFirstChild("Humanoid")
			local alive = hum and ((hum:IsA("Humanoid") and hum.Health > 0)
				or (hum:IsA("NumberValue") and hum.Value > 0))
			if seat and alive then
				local d = seat.Position - root.Position
				local d2 = d.X * d.X + d.Y * d.Y + d.Z * d.Z
				if d2 < bestD2 then best, bestD2 = mob, d2 end
			end
		end
	end
	return best
end

-- Boat movement: BodyVelocity carrier + linear tween on the boat's PrimaryPart
