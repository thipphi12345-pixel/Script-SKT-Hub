	local main = Window.Items and Window.Items.MainFrame and Window.Items.MainFrame.Instance
	local UIS = Services.UserInputService
	if main then
		local grip = Instance.new("TextButton")
		grip.Name = "ResizeGrip"
		grip.Size = UDim2.new(0, 20, 0, 20)
		grip.Position = UDim2.new(1, -20, 1, -20)
		grip.BackgroundTransparency = 1
		grip.Text = ""
		grip.AutoButtonColor = false
		grip.ZIndex = 99999
		grip.Parent = main

		for i = 0, 2 do
			local line = Instance.new("Frame")
			line.Size = UDim2.new(0, 6 + i * 4, 0, 2)
			line.AnchorPoint = Vector2.new(1, 1)
			line.Position = UDim2.new(1, 1, 1, -i * 5 - 4)
			line.Rotation = -45
			line.BackgroundColor3 = ACCENT
			line.BorderSizePixel = 0
			line.ZIndex = 99999
			line.Parent = grip
		end

		local dragging, startMouse, startSize
		Conn(grip.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1
				or input.UserInputType == Enum.UserInputType.Touch then
				dragging = true
				startMouse = input.Position
				startSize = main.AbsoluteSize
				input.Changed:Connect(function()
					if input.UserInputState == Enum.UserInputState.End then
						dragging = false
					end
				end)
			end
		end))
		Conn(UIS.InputChanged:Connect(function(input)
			if not dragging then return end
			if input.UserInputType ~= Enum.UserInputType.MouseMovement
				and input.UserInputType ~= Enum.UserInputType.Touch then return end
			local delta = input.Position - startMouse
			local w = math.clamp(startSize.X + delta.X, 480, 1600)
			local h = math.clamp(startSize.Y + delta.Y, 360, 1200)
			main.Size = UDim2.new(0, w, 0, h)
		end))
	end
end

-- Ambient snowfall inside the menu window (toggle: SnowFX)
do
	local main = Window.Items and Window.Items.MainFrame and Window.Items.MainFrame.Instance
	if main then
		local layer = Instance.new("Frame")
		layer.Name = "SnowFX"
		layer.Size = UDim2.new(1, 0, 1, 0)
		layer.BackgroundTransparency = 1
		layer.ClipsDescendants = true
		layer.ZIndex = 2
		layer.Parent = main

		local rng = Random.new()
		local flakes = {}
		for i = 1, 45 do
			local size = rng:NextNumber(2, 5)
			local dot = Instance.new("Frame")
			dot.Size = UDim2.new(0, size, 0, size)
			dot.BackgroundColor3 = i % 4 == 0 and ACCENT or Color3.fromRGB(235, 245, 255)
			dot.BackgroundTransparency = rng:NextNumber(0.35, 0.8)
			dot.BorderSizePixel = 0
			dot.ZIndex = 2
			dot.Parent = layer
			local c = Instance.new("UICorner")
			c.CornerRadius = UDim.new(1, 0)
			c.Parent = dot
			flakes[i] = {
				dot = dot,
				x = rng:NextNumber(),
				y = rng:NextNumber(-1, 0) * 600,
				vy = rng:NextNumber(18, 55),
				ph = rng:NextNumber(0, math.pi * 2),
				amp = rng:NextNumber(6, 22),
				sw = rng:NextNumber(0.4, 1.2),
			}
		end

		local clock = 0
		Conn(RunService.Heartbeat:Connect(function(dt)
			clock = clock + dt
			layer.Visible = main.Visible and Cfg("SnowFX", true) == true
			if not layer.Visible then return end
			local W, H = layer.AbsoluteSize.X, layer.AbsoluteSize.Y
			if W <= 0 or H <= 0 then return end
			for _, f in ipairs(flakes) do
				f.y = f.y + f.vy * dt
				if f.y > H + 8 then
					f.y = -8
					f.x = rng:NextNumber()
				end
				f.dot.Position = UDim2.new(0, f.x * W + math.sin(clock * f.sw + f.ph) * f.amp, 0, f.y)
			end
		end))
	end
end

