-- Protect Boat: jitter the parked boat when a sea enemy is closing in
local BoatSafeCF = nil
function Feature.ProtectBoat()
	if Cfg("SummonPrehistoric") or Cfg("SummonMirage") or Cfg("SummonKitsune") then
		BoatSafeCF = nil
		return
	end
	local char, boat = GetChar(), Util.GetPlayerBoat()
	if not (char and Util.IsAlive(char) and boat and boat:FindFirstChild("VehicleSeat")) then return end
	local h = GetHuman()
	if not (h and not h.Sit) then
		BoatSafeCF = nil
		return
	end
	local threat = Util.FindBoatEnemy({ "PirateGrandBrigade", "PirateBrigade", "FishBoat" }, 9e9)
		or Farm:FindEnemy({ "Terrorshark", "Piranha", "Fish Crew Member", "Shark" }, 9e9)
	if not threat then
		local sb = GetSeaBeasts()
		local sb1 = sb and sb:FindFirstChild("SeaBeast1")
		if sb1 and sb1:FindFirstChild("HumanoidRootPart") then threat = true end
	end
	if threat then
		if not BoatSafeCF then BoatSafeCF = boat.VehicleSeat.CFrame end
		boat.VehicleSeat.CFrame = BoatSafeCF + Vector3.new(math.random(75, 100), math.random(75, 100), math.random(75, 100))
	elseif BoatSafeCF then
		boat.VehicleSeat.CFrame = BoatSafeCF
		BoatSafeCF = nil
	end
end

