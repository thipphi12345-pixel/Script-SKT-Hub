------------------------------------------------------------------------
-- [11] Noclip while any farm feature is enabled
------------------------------------------------------------------------
-- Re-asserts CanCollide = false on every character part each frame so the
-- game (or other scripts) can't re-enable collisions mid-farm and wedge the
-- character on trees/rocks/buildings. Restores original values on disable.
local NoClip = {
	_char = nil,
	_orig = {},      -- part -> original CanCollide
	_states = nil,   -- states we disabled on the humanoid
}

local SOFT_STATES = {
	Enum.HumanoidStateType.FallingDown,
	Enum.HumanoidStateType.Ragdoll,
	Enum.HumanoidStateType.GettingUp,
	Enum.HumanoidStateType.Climbing,
}

local function NoClipClear()
	for part, orig in pairs(NoClip._orig) do
		if part and part.Parent then
			part.CanCollide = orig[1]
			part.CanTouch = orig[2]
		end
	end
	NoClip._orig = {}

	local char = NoClip._char
	local h = char and char.Parent and char:FindFirstChildOfClass("Humanoid")
	if h and NoClip._states then
		for _, s in ipairs(NoClip._states) do
			pcall(h.SetStateEnabled, h, s, true)
		end
	end
	NoClip._states = nil
	NoClip._char = nil
end

Conn(RunService.Stepped:Connect(function()
	local want = Farm:AnyActive() or Cfg("Noclip", false)
	local char = GetChar()

	if not want or not char then
		if NoClip._char then NoClipClear() end
		return
	end

	if char ~= NoClip._char then
		NoClipClear()
		NoClip._char = char
		NoClip._orig = {}
		local h = char:FindFirstChildOfClass("Humanoid")
		if h then
			NoClip._states = {}
			for _, s in ipairs(SOFT_STATES) do
				if h:GetStateEnabled(s) then
					table.insert(NoClip._states, s)
					pcall(h.SetStateEnabled, h, s, false)
				end
			end
		end
	end

	-- Newly added parts (tools, accessories, welds) are picked up each frame.
	-- CanTouch is disabled only while a tween is in flight so portal / kill
	-- zones can't grab us mid-travel (they still fire for chests once we stop).
	local flying = Tween._ctrl ~= nil
	for _, d in ipairs(char:GetDescendants()) do
		if d:IsA("BasePart") then
			if NoClip._orig[d] == nil then
				NoClip._orig[d] = { d.CanCollide, d.CanTouch }
			end
			if d.CanCollide then d.CanCollide = false end
			local wantTouch = not flying and NoClip._orig[d][2]
			if d.CanTouch ~= wantTouch then d.CanTouch = wantTouch end
		end
	end

	-- Knockback movers the game inserts ("StunObjects") fight the tween and
	-- yank the character back mid-farm; clear them while noclip is active.
	local hrp = char:FindFirstChild("HumanoidRootPart")
	local stun = hrp and hrp:FindFirstChild("StunObjects")
	if stun then
		for _, o in ipairs(stun:GetChildren()) do o:Destroy() end
	end
end))

-- Sweep away stale tween carriers (abandoned mid-flight with no tween
-- playing). Must respect _holdUntil: the arrival hold pins the character
-- with the carrier while no tween is playing -- sweeping here used to
-- destroy it mid-hover, so gravity dropped the character until the farm
-- loop re-issued, over and over (the visible "keeps falling" loop).
task.spawn(function()
	while Alive() do
		task.wait(0.5)
		local c = Tween._ctrl
		if c and c._bv and c._bv.Parent
			and c._bv.Velocity.Magnitude < 0.1
			and not (c._tween and c._tween.PlaybackState == Enum.PlaybackState.Playing)
			and tick() > (c._holdUntil or 0) then
			Tween:Stop()
		end
	end
end)

