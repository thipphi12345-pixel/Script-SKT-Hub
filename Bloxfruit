local KeyMap = { Z = Enum.KeyCode.Z, X = Enum.KeyCode.X, C = Enum.KeyCode.C, V = Enum.KeyCode.V, F = Enum.KeyCode.F, Y = Enum.KeyCode.Y }
function Util.KeyPress(key, hold)
	local kc = type(key) == "string" and KeyMap[key] or key
	if not kc then return end
	VIM:SendKeyEvent(true, kc, false, game)
	if hold and hold > 0 then task.wait(hold) end
	VIM:SendKeyEvent(false, kc, false, game)
end

function Util.SkillReady(key)
	local c = GetChar()
	local tool = c and c:FindFirstChildOfClass("Tool")
	if not tool then return false end
	local skills = PlayerGui:FindFirstChild("Main") and PlayerGui.Main:FindFirstChild("Skills")
	local frame = skills and skills:FindFirstChild(tool.Name)
	if not frame then return false end
	for _, f in ipairs(frame:GetChildren()) do
		if f:IsA("Frame") and f.Name == key then
			local title = f:FindFirstChild("Title")
			return title ~= nil and title.TextColor3 == Color3.fromRGB(255, 255, 255)
		end
	end
	return false
end

function Util.UseSkills(skills)
	for _, k in ipairs(skills) do
		if Util.SkillReady(k) then Util.KeyPress(k, 0.1) end
	end
end

function Util.InteractPrompt(prompt)
	if not (prompt and prompt:IsA("ProximityPrompt")) then return end
	pcall(function()
		if fireproximityprompt then fireproximityprompt(prompt) return end
		prompt.MaxActivationDistance = math.max(prompt.MaxActivationDistance, 10)
		prompt:InputHoldBegin()
		task.wait(prompt.HoldDuration + 0.05)
		prompt:InputHoldEnd()
	end)
end

function Util.PromptNear(range)
	local root = GetRoot()
	if not root then return end
	for _, d in ipairs(workspace:GetDescendants()) do
		if d:IsA("ProximityPrompt") then
			local p = d.Parent
			local pos = p and (p:IsA("BasePart") and p.Position or p:IsA("Model") and p:GetPivot().Position)
			if pos and (pos - root.Position).Magnitude <= range then
				Util.InteractPrompt(d)
			end
		end
	end
end

function Util.ServerHop(maxPlayers)
	local browser = RS:FindFirstChild("__ServerBrowser")
	if not browser then Notify(BRAND, "ServerBrowser not found") return end

	pcall(function()
		PlayerGui.ServerBrowser.Frame.Filters.SearchRegion.TextBox.Text = "Singapore"
	end)

	for page = 1, 100 do
		local ok, res = pcall(browser.InvokeServer, browser, page)
		if not ok or type(res) ~= "table" then break end
		local empty = true
		for jobId, info in pairs(res) do
			empty = false
			local count = type(info) == "table" and (info.Count or math.huge) or tonumber(info) or math.huge
			local private = type(info) == "table" and tostring(info.Private) == "true"
			if jobId ~= game.JobId and count <= maxPlayers and not private then
				pcall(browser.InvokeServer, browser, "teleport", jobId)
				return
			end
		end
		if empty then break end
	end
	Notify(BRAND, "No suitable server found")
end

-- Inventory (via the game's ItemReplicationService client module) ------------
local ItemReplicationService = require(RS:WaitForChild("ItemReplicationService"))
local IRS_KEYS  = require(RS:WaitForChild("ItemReplicationService"):WaitForChild("KEYS"))
local ItemId    = require(RS:WaitForChild("Economy"):WaitForChild("ItemId"))
local ItemConfig = require(RS:WaitForChild("ItemConfig"))

local IDTYPE_MAP = {
	Moveset = "Melee",
	PhysicalMoveset = "Blox Fruit",
	Material = "Material",
	Accessory = "Accessory",
}

local InvCache = { t = 0, items = nil }
function Util.GetInventory()
	if tick() - InvCache.t < 1 and InvCache.items then return InvCache.items end
	local ok, items = pcall(function()
		return ItemReplicationService:GetItems(IRS_KEYS.QUANTITY)
	end)
	if not (ok and type(items) == "table") then return InvCache.items or {} end
	local out = {}
	for _, item in pairs(items) do
		local count = item.Value or 0
		if count > 0 then
			local itemId = item.ItemId
			local typ
			local okM, match = pcall(function() return ItemConfig.match(itemId) end)
			if okM and match then
				local okU, uw = pcall(function()
					if match.asNullable then return match:asNullable() end
					return match:unwrap()
				end)
				if okU and uw then
					local idx = uw.Index or uw.Data or uw
					typ = IDTYPE_MAP[idx.IdType or idx.Type]
				end
			end
			if typ then
				local name
				local okD, data = pcall(function() return ItemId.getDataFromId(itemId) end)
				if okD and data then
					local okU2, uw2 = pcall(function() return data:unwrap() end)
					if okU2 and uw2 then name = uw2.StorageKey end
				end
				table.insert(out, {
					Name = name or ("Item_" .. tostring(itemId)),
					Count = count,
					Type = typ,
					ItemId = itemId,
				})
			end
		end
	end
	InvCache.items = out
	InvCache.t = tick()
	return out
end

