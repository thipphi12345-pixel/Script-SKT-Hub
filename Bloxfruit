function Util.BoatTween(boat, cf, speed)
	if not (boat and boat.PrimaryPart and cf) then return end
	local pp = boat.PrimaryPart
	if not pp:FindFirstChild("SKT_Boat_BodyVelocity") then
		local bv = Instance.new("BodyVelocity")
		bv.Name = "SKT_Boat_BodyVelocity"
		bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
		bv.Velocity = Vector3.zero
		bv.Parent = pp
	end
	local dist = (pp.Position - cf.Position).Magnitude
	local tw = TweenService:Create(pp, TweenInfo.new(
		math.max(0.1, dist / (speed or 250)), Enum.EasingStyle.Linear, Enum.EasingDirection.Out),
		{ CFrame = cf })
	pcall(function() tw:Play() end)
end

